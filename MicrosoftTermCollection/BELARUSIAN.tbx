ermNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14496_67901_1573780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action statement in any computer language, most often in machine or assembly language. Most programs consist of two types of statements: declarations and instructions.</descrip></descripGrp><ntig><termGrp><term id="67901">instruction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573780">інструкцыя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14498_359990_2296206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query (SQL statement) that removes rows matching the criteria you specify from one or more tables.</descrip></descripGrp><ntig><termGrp><term id="359990">delete query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296206">запыт на выдаленне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14503_150387_1573611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Video images and sound stored in a digital format.</descrip></descripGrp><ntig><termGrp><term id="150387">digital video</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573611">лічбавае відэа</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14503_150387_1806258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Video images and sound stored in a digital format.</descrip></descripGrp><ntig><termGrp><term id="150387">digital video</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806258">DV</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14503_150388_1573611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Video images and sound stored in a digital format.</descrip></descripGrp><ntig><termGrp><term id="150388">DV</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573611">лічбавае відэа</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14503_150388_1806258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Video images and sound stored in a digital format.</descrip></descripGrp><ntig><termGrp><term id="150388">DV</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806258">DV</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14509_113733_1574120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical user interface control that is equipped with a small bar which slides along a visible line and is used to set a value along a range with a minimum and maximum.</descrip></descripGrp><ntig><termGrp><term id="113733">slider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574120">паўзунок</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14509_641191_1574120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical user interface control that is equipped with a small bar which slides along a visible line and is used to set a value along a range with a minimum and maximum.</descrip></descripGrp><ntig><termGrp><term id="641191">slider control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574120">паўзунок</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14511_2148_1573881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reduce a window to a button on the taskbar by clicking the Minimize button (leftmost button on the right side of the title bar) or by pressing ALT+SPACEBAR and then pressing N.</descrip></descripGrp><ntig><termGrp><term id="2148">minimize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573881">згарнуць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14513_96306_2741331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To run a set of instructions to retrieve specific data from the database, usually with multiple conditions. No list is displayed until you run the query.</descrip></descripGrp><ntig><termGrp><term id="96306">query</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2741331">выканаць запыт</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14523_360144_2296642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window that displays the SQL statement for the current query or that is used to create an SQL-specific query (union, pass-through, or data definition). When you create a query in Design view, Access constructs the SQL equivalent in SQL view.</descrip></descripGrp><ntig><termGrp><term id="360144">SQL view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296642">рэжым SQL</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14526_360146_2296616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that asks a question about the data stored in your tables and returns a result set in the form of a datasheet, without changing the data.</descrip></descripGrp><ntig><termGrp><term id="360146">select query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296616">запыт на выбарку</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14528_276550_1996260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single location in Windows where you can adjust mobile PC settings.</descrip></descripGrp><ntig><termGrp><term id="276550">Windows Mobility Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1996260">Цэнтр мабільнасці Windows</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14534_21247_1778350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains encoded information that is interpreted according to the application that created it. In general, a binary file can be edited only by the application in which it was created.</descrip></descripGrp><ntig><termGrp><term id="21247">binary file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1778350">двайковы файл</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14540_373951_1950005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive technology in Microsoft Excel or Access that can show dynamic views of the same data from a list or a database.</descrip></descripGrp><ntig><termGrp><term id="373951">Microsoft PivotTable</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1950005">зводная таблiца</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14540_373952_1950005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive technology in Microsoft Excel or Access that can show dynamic views of the same data from a list or a database.</descrip></descripGrp><ntig><termGrp><term id="373952">PivotTable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1950005">зводная таблiца</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14543_231973_1864424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Office Web Component that allows you to create a structure similar to an Excel PivotTable report. Users can view the PivotTable list in a Web browser and change its layout in a manner similar to an Excel PivotTable report.</descrip></descripGrp><ntig><termGrp><term id="231973">PivotTable list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864424">спiс зводнай таблiцы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14555_95472_2689570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To cue the user that the system is requesting input or action.</descrip></descripGrp><ntig><termGrp><term id="95472">prompt</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2689570">запытваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14562_318120_2296589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button on your pointing device that you use to display shortcut menus or other program-specific features.</descrip></descripGrp><ntig><termGrp><term id="318120">right mouse button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296589">правая кнопка мышы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14574_123914_1574195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Confidence in the reliability of an entity or service and the information that it provides.</descrip></descripGrp><ntig><termGrp><term id="123914">trust</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574195">давер</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14579_60118_1770056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user interface control that facilitates modification of an object's appearance, position, or behavior.</descrip></descripGrp><ntig><termGrp><term id="60118">handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1770056">маркер</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14584_358355_2296223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that ensures that a mobile device automatically retrieves new email from the Microsoft Exchange server. Direct Push uses a longstanding HTTPS connection that is maintained by the mobile device to push new email messages, Calendar, Contacts, and Tasks notifications from the server to the device.</descrip></descripGrp><ntig><termGrp><term id="358355">Direct Push</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296223">тэхналогія Direct Push</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14606_211370_1573640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date by which some task or action should be completed.</descrip></descripGrp><ntig><termGrp><term id="211370">due date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573640">тэрмін выканання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14609_183539_2463992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An artificial intelligence program that performs a task on a network as an agent for a user or another program.</descrip></descripGrp><ntig><termGrp><term id="183539">bot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2463992">бот</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14609_183540_2463992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An artificial intelligence program that performs a task on a network as an agent for a user or another program.</descrip></descripGrp><ntig><termGrp><term id="183540">robot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2463992">бот</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14610_25574_1573489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic element that appears similar to a physical button or keyboard key in the UI. A button is "pressed" by clicking on it with a mouse, by hitting ENTER or RETURN on the keyboard (if the button has the focus) or tapping by a finger.</descrip></descripGrp><ntig><termGrp><term id="25574">button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573489">кнопка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14611_123792_1769135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An automated tool that helps find and fix specific problems on your computer.</descrip></descripGrp><ntig><te