cripGrp><ntig><termGrp><term id="2405212">Windows Information Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2405669">Windows Information Protection</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4050_95643_1574006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard set of formats and procedures that enable computers to exchange information.</descrip></descripGrp><ntig><termGrp><term id="95643">protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574006">пратакол</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40502_2353112_2353531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that consumers can use to send feedback to the Windows team, to check for responses to that feedback, and to get news about the latest updates.</descrip></descripGrp><ntig><termGrp><term id="2353112">Windows Feedback Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2353531">Асяродак водгукаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40502_2353112_2353533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that consumers can use to send feedback to the Windows team, to check for responses to that feedback, and to get news about the latest updates.</descrip></descripGrp><ntig><termGrp><term id="2353112">Windows Feedback Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2353533">Асяродак водгукаў Windows</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40502_2353113_2353531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that consumers can use to send feedback to the Windows team, to check for responses to that feedback, and to get news about the latest updates.</descrip></descripGrp><ntig><termGrp><term id="2353113">Feedback Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2353531">Асяродак водгукаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40502_2353113_2353533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that consumers can use to send feedback to the Windows team, to check for responses to that feedback, and to get news about the latest updates.</descrip></descripGrp><ntig><termGrp><term id="2353113">Feedback Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2353533">Асяродак водгукаў Windows</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40503_2353114_2353529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of settings that admins can use to manage files and operating system settings on enterprise-owned devices.</descrip></descripGrp><ntig><termGrp><term id="2353114">enterprise control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2353529">карпаратыўны кантроль</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40504_2353123_2353532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The modern implementation of Windows PowerShell built on .NET Core. It includes a command-line shell, scripting language, and automation engine, providing IT administrators comprehensive control and automation of system administration tasks across multiple platforms.</descrip></descripGrp><ntig><termGrp><term id="2353123">PowerShell Core</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2353532">PowerShell Core</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40511_2353386_2354022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The group of add-ons for Office 2016 that includes one or more of the following: proofing tools, an LIP, a language pack, and/or a spellchecker.</descrip></descripGrp><ntig><termGrp><term id="2353386">Office 2016 Language Accessory Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2354022">Office 2016 Language Accessory Pack</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40521_2353984_2357920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A free feature that allows setting up online business meetings using work email. The feature is part of Skype for Business experience and has multiple online entry-points (e.g. Skype.com).</descrip></descripGrp><ntig><termGrp><term id="2353984">Skype Meetings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2357920">Сходы Skype</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40523_2354097_2355181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Big Data Analysis Generic Enabler reference implementation (GEri) intended to deploy means for analyzing both batch and stream data and get insights on such a data.</descrip></descripGrp><ntig><termGrp><term id="2354097">Cosmos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2355181">Cosmos</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40524_2354098_2355184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query expressed in the native SQL dialect of the database of choice.</descrip></descripGrp><ntig><termGrp><term id="2354098">native database query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2355184">уласны запыт базы дадзеных</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40524_2354098_2355185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query expressed in the native SQL dialect of the database of choice.</descrip></descripGrp><ntig><termGrp><term id="2354098">native database query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2355185">уласны запыт</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40524_2354101_2355184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query expressed in the native SQL dialect of the database of choice.</descrip></descripGrp><ntig><termGrp><term id="2354101">native query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2355184">уласны запыт базы дадзеных</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40524_2354101_2355185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query expressed in the native SQL dialect of the database of choice.</descrip></descripGrp><ntig><termGrp><term id="2354101">native query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2355185">уласны запыт</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40537_2354519_2357243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone app that helps customers transfer content from their Android phone to their Windows 10 Mobile phone. There are 2 instances of the app, one that you install on Android, and one that you install on Windows (phone only).​​</descrip></descripGrp><ntig><termGrp><term id="2354519">Move to Windows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2357243">Пераход на Windows</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40541_2354632_2687248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statistical measure of the reliability of an estimate, which calculates the margin of error.</descrip></descripGrp><ntig><termGrp><term id="2354632">confidence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2687248">пэўнасць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4055_21561_1573468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The smallest unit of information handled by a computer or device. One bit expresses a 1 or a 0 in a binary numeral, or a true or false logical condition. A group of 8 bits makes up a byte, which can represent many types of information, such as a letter of the alphabet, a decimal digit, or other character.</descrip></descripGrp><ntig><termGrp><term id="21561">bit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573468">біт</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4055_21562_1573468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The smallest unit of information handled by a computer or device. One bit expresses a 1 or a 0 in a binary numeral, or a true or false logical condition. A group of 8 bits makes up a byte, which can represent many types of information, such as a letter of the alphabet, a decimal digit, or other character.</descrip></descripGrp><ntig><termGrp><term id="21562">binary digit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573468">біт</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4059_124417_1864181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file (or component within another file) that contains Automation standard descriptions of exposed objects, properties, and methods.</descrip></descripGrp><ntig><termGrp><term id="124417">type library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864181">бібліятэка тыпаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="406_22638_2296107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portion of content within an email or Internet newsgroups, that follows the header and contains the content of the message.</descrip></descripGrp><ntig><termGrp><term id="22638">body</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296107">тэкст паведамлення</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40601_2357561_2357921"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Skype for Business PSTN Consumption billing enables customers to access PSTN features that are not available in the base PSTN Conferencing and PSTN Calling subscriptions, such as toll-free dial in for conferences, international dial out in conferences, and international dial out for PSTN Calling Domestic Plans</descrip></descripGrp><ntig><termGrp><term id="2357561">Skype for Business PSTN Consumption</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2357921">Skype для бізнесу — спажыванне PSTN</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40602_2357666_2359701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that provides step counts, workouts, sleep quality data and a web dashboard to give insights into physical activity benefits to the user’s overall health.</descrip></descripGrp><ntig><termGrp><term id="2357666">Microsoft Health</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2359701">Microsoft Health</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</ter