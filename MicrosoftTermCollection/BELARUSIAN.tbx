Tip that is larger and can contain more detailed information, including graphics.</descrip></descripGrp><ntig><termGrp><term id="347653">ScreenTip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296269">палепшаная ўсплывальная падказка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8556_76998_1806219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characterized by non-capital letters.</descrip></descripGrp><ntig><termGrp><term id="76998">lowercase</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806219">ніжні рэгістр</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8557_147009_2296544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information stored in the prologue of an XML document. This information is passed through the XML parser to any application that uses the XML document.</descrip></descripGrp><ntig><termGrp><term id="147009">processing instructions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296544">каманды апрацоўкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNo