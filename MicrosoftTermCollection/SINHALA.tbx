p></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2257350">Windows 10 Home Insider Preview</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38694_2254283_2257371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The prerelease build of Windows 10 for phones that was made available to Insiders.</descrip></descripGrp><ntig><termGrp><term id="2254283">Windows 10 Mobile Insider Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2257371">Windows 10 Mobile Insider Preview</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38695_2254284_2257382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The professional edition of Windows 10 Insider Preview released in April 2015 or later.</descrip></descripGrp><ntig><termGrp><term id="2254284">Windows 10 Pro Insider Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2257382">Windows 10 Pro Insider Preview</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38696_2254285_2257403"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The prerelease build of the next version of Windows, made available to customers in Spring 2015 or later.</descrip></descripGrp><ntig><termGrp><term id="2254285">Windows Insider Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2257403">Windows Insider Preview</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38698_2254352_2257220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of features that seamlessly adapt and optimize the user interface for different devices, modes of working, hardware, or platforms.</descrip></descripGrp><ntig><termGrp><term id="2254352">Continuum</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2257220">Continuum</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38699_2254353_2257226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The photo displayed at the top of an album, and used to represent the whole album when albums are shown in list view. It is also used to describe the representative photo in a stack (of near duplicate photos).</descrip></descripGrp><ntig><termGrp><term id="2254353">cover photo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2257226">කවරය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38699_2254353_2257253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The photo displayed at the top of an album, and used to represent the whole album when albums are shown in list view. It is also used to describe the representative photo in a stack (of near duplicate photos).</descrip></descripGrp><ntig><termGrp><term id="2254353">cover photo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2257253">කවර ඡායාරූපය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38699_2254354_2257226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The photo displayed at the top of an album, and used to represent the whole album when albums are shown in list view. It is also used to describe the representative photo in a stack (of near duplicate photos).</descrip></descripGrp><ntig><termGrp><term id="2254354">cover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2257226">කවරය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38699_2254354_2257253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The photo displayed at the top of an album, and used to represent the whole album when albums are shown in list view. It is also used to describe the representative photo in a stack (of near duplicate photos).</descrip></descripGrp><ntig><termGrp><term id="2254354">cover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2257253">කවර ඡායාරූපය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38700_2254359_2257265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The "app as a card" capability that retailers purchase from Microsoft and sell to consumers.</descrip></descripGrp><ntig><termGrp><term id="2254359">digital download code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2257265">ඩිජිටල් බාගැනුම් කේතය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38703_2254377_2257289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that can be used to play and record movies and TV shows.</descrip></descripGrp><ntig><termGrp><term id="2254377">Microsoft Movies &amp; TV</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2257289">Microsoft චිත්‍රපටි සහ TV</term><termNote type="geographicalUs