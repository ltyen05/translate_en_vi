te></termGrp></ntig></langSet></termEntry><termEntry id="7248_54777_635897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Marked with a flag.</descrip></descripGrp><ntig><termGrp><term id="54777">flagged</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635897">සලකුණු කළ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7250_143242_1368712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In 2-D line charts, lines that extend from the highest to the lowest value in each category. High-low lines are often used in stock charts.</descrip></descripGrp><ntig><termGrp><term id="143242">high-low lines</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368712">ඉහළ-පහළ රේඛා</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7253_298012_634696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any graphic you draw or insert, which can be changed and enhanced. Drawing objects include AutoShapes, curves, lines, and WordArt.</descrip></descripGrp><ntig><termGrp><term id="298012">drawing object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634696">චිත්‍රණ වස්තුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7257_55937_636032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prepare a disk for use by organizing its storage space into a collection of data "compartments", each of which can be located by the operating system so that data can be sorted and retrieved. When a previously used disk is formatted, any preexisting information on it is lost.</descrip></descripGrp><ntig><termGrp><term id="55937">format</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="636032">හැඩතල ගන්වන්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7258_147302_635136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram that is used to show foundation-based relationships.</descrip></descripGrp><ntig><termGrp><term id="147302">pyramid diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635136">පිරමිඩ රූ සටහන</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="726_116752_634846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Digital media that is delivered in a continuous flow across a network.</descrip></descripGrp><ntig><termGr