rmGrp></ntig></langSet></termEntry><termEntry id="12998_83320_634241"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that represents the result of an invalid calculation.</descrip></descripGrp><ntig><termGrp><term id="83320">NaN</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634241">අංකයක් නොවේ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12998_83321_634241"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that represents the result of an invalid calculation.</descrip></descripGrp><ntig><termGrp><term id="83321">not a number</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634241">අංකයක් නොවේ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13002_42491_634811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of writing new data to computer memory.</descrip></descripGrp><ntig><termGrp><term id="42491">data entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634811">දත්ත නිවේශනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13006_309435_634896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual indication that represents the current location being played within the selected media.</descrip></descripGrp><ntig><termGrp><term id="309435">playhead</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634896">ධාවන දර්ශකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13007_111882_634384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color that is mixed with black. A 10-percent shade is one part of the original color and nine parts black.</descrip></descripGrp><ntig><termGrp><term id="111882">shade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634384">අඳුරු කිරීම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13016_346958_635332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of partial control parents get over the accounts and devices of their children helping them supervise how their children behave online and letting them restrict what their children see.</descrip></descripGrp><ntig><termGrp><term id="346958">parental controls</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><