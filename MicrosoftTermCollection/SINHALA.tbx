descripGrp><descrip type="definition">A process of converting readable data (plaintext) into a coded form (ciphertext) to prevent it from being read by an unauthorized party.</descrip></descripGrp><ntig><termGrp><term id="1177">encryption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1370192">ගුප්ත කේතනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3366_1413164_1370192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of converting readable data (plaintext) into a coded form (ciphertext) to prevent it from being read by an unauthorized party.</descrip></descripGrp><ntig><termGrp><term id="1413164">encipherment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1370192">ගුප්ත කේතනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3366_694688_1370192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of converting readable data (plaintext) into a coded form (ciphertext) to prevent it from being read by an unauthorized party.</descrip></descripGrp><ntig><termGrp><term id="694688">data encryption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1370192">ගුප්ත කේතනය</term><termNote type="geographicalUsage">LKA</termNote