finition">The recognizer specific part of the shape trainer. Typically every recognizer claiming to support shape personalization must supply a Shape Client DLL. All the Microsoft Latin recognizers will all use the same Shape Client.</descrip></descripGrp><ntig><termGrp><term id="263078">Shape Client</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="636033">හැඩතල සේවාලාභියා</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8869_87023_634954"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network status that indicates a client is not connected to a server.</descrip></descripGrp><ntig><termGrp><term id="87023">offline</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634954">නොබැඳි</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8871_73980_635538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The { character.</descrip></descripGrp><ntig><termGrp><term id="73980">left brace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635538">වම් සඟල වරහන</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNo