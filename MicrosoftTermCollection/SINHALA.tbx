><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43169_2445827_2448633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The major Windows 10 update to be released in Spring 2017, focused on creativity, 3D and mixed reality, 4K gaming, game broadcasting, among other features for both consumer and enterprise audiences.</descrip></descripGrp><ntig><termGrp><term id="2445827">Windows 10 Creators Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2448633">Windows 10 නිර්මාපක යාවත්කාලීන</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43170_2445830_2448596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual environment in which a user's real surroundings are combined with virtual or holographic objects to create a customizable environment</descrip></descripGrp><ntig><termGrp><term id="2445830">mixed reality</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2448596">මිශ්‍ර යථාර්ථය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43170_2866240_2448596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual environment in which a user's real surroundings are combined with virtual or holographic objects to create a customizable environment</descrip></descripGrp><ntig><termGrp><term id="2866240">MR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2448596">මිශ්‍ර යථාර්ථය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43173_2445835_2449218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word view that displays text in one narrow column​​​ that has the same width as the Narrow view.</descrip></descripGrp><ntig><termGrp><term id="2445835">Single</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2449218">තනි</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43184_2446073_2448600"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A setting that adjusts the display to eliminate blue tones that may disrupt your ability to sleep at night.</descrip></descripGrp><ntig><termGrp><term id="2446073">night light</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2448600">රාත්‍රී ආලෝකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="432_107688_1462034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The timing and sequence of tasks within a project.</descrip></descripGrp><ntig><termGrp><term id="107688">schedule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1462034">කාර්ය සටහන</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43202_2447224_2568783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of similar feedback displayed in search results, instead of showing all the duplicate feedback.</descrip></descripGrp><ntig><termGrp><term id="2447224">collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2568783">එකතුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43205_2447227_2568786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the collection that contains the feedback you submitted.</descrip></descripGrp><ntig><termGrp><term id="2447227">My feedback</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2568786">මගේ ප්රතිචාරය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeec