lang="en-US"><descripGrp><descrip type="definition">An outlined container that displays a markup element, such as a comment or revision, in the margin of a document.</descrip></descripGrp><ntig><termGrp><term id="232818">balloon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635266">බැලුනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11398_232818_635899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An outlined container that displays a markup element, such as a comment or revision, in the margin of a document.</descrip></descripGrp><ntig><termGrp><term id="232818">balloon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635899">සලකුණු බැලුනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11398_322594_635266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An outlined container that displays a markup element, such as a comment or revision, in the margin of a document.</descrip></descripGrp><ntig><termGrp><term id="322594">markup balloon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635266">බැලුනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="g