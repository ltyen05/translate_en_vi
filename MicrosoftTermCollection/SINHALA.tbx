 xml:lang="en-US"><descripGrp><descrip type="definition">To combine products for sale as a lot. Frequently, operating system software and some widely used applications are bundled with a computer system for sale.</descrip></descripGrp><ntig><termGrp><term id="25017">bundle</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2485796">පොදිය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13592_25636_635290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The surface of a button where text or an image (typically indicating the button's function) may be displayed.</descrip></descripGrp><ntig><termGrp><term id="25636">button face</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635290">බොත්තම් මුහුණත</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13598_26923_1370318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that notifies a user that a call is coming in while the user is in a call.</descrip></descripGrp><ntig><termGrp><term id="26923">call waiting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1370318">ඇමතුම් පොරොත්තුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13604_34469_635572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The particular range of colors that a device or color model is able to produce.</descrip></descripGrp><ntig><termGrp><term id="34469">color gamut</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635572">වර්ණ සමස්තය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13604_660552_635572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The particular range of colors that a device or color model is able to produce.</descrip></descripGrp><ntig><termGrp><term id="660552">gamut</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635572">වර්ණ සමස්තය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13605_347939_635219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file or set of files that defines the data structure, appearance, and behavior of a form.</descrip></descripGrp><ntig><termGrp><term id="347939">form template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635219">පෝරම 