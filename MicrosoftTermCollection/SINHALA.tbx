>NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13159_34845_1801135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in each row of a database table that stores the data value for some attribute of the object modeled by the table.</descrip></descripGrp><ntig><termGrp><term id="34845">column</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1801135">තීරුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13166_262640_635708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A title animation in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="262640">Stretch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635708">විහිදුම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13169_525_1913031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The protection of information assets through the use of technology, processes, and training.</descrip></descripGrp><ntig><termGrp><term id="525">computer security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913031">පරිගණක ආරක්ෂණය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13173_89953_635123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The point at which one page ends and another begins.</descrip></descripGrp><ntig><termGrp><term id="89953">page break</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635123">පිටු කඩනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13177_6456_634933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The full Internet address of a page or other World Wide Web resource. The absolute URL includes a protocol, such as "http," network location, and optional path and file name — for example, http://example.microsoft.com/.</descrip></descripGrp><ntig><termGrp><term id="6456">absolute URL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634933">නිරපේක්ෂ URL</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13180_268854_1370313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method computers use to send and receive email messages. It allows you to access email without downloading it to your computer or device.</descrip></descripGrp><ntig><termGrp><term id="268854">Internet Message Access Protocol<