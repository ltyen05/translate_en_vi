="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14716_374693_1801164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field data type that can contain up to 65,535 characters.</descrip></descripGrp><ntig><termGrp><term id="374693">Memo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1801164">මෙමෝ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14719_232413_634616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window in an email program where you can preview an item without opening it.</descrip></descripGrp><ntig><termGrp><term id="232413">reading pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634616">කියවුම් කවුළුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14719_415470_634616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window in an email program where you can preview an item without opening it.</descrip></descripGrp><ntig><termGrp><term id="415470">Preview Pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634616">කියවුම් කවුළුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14721_427008_634777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation where the long dimension of a rectangular area (for example, screen, photo, or paper) is horizontal.</descrip></descripGrp><ntig><termGrp><term id="427008">landscape orientation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634777">තිරස්</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14721_73296_634777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation where the long dimension of a rectangular area (for example, screen, photo, or paper) is horizontal.</descrip></descripGrp><ntig><termGrp><term id="73296">landscape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634777">තිරස්</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14726_110688_1370335"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned to a specific inventory item to identify it and differentiate it from similar items with the same item number.</descrip></descripGrp><ntig><termGrp><term id="110688">serial number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1370335">අනුක්‍රමික අංකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14727_168754_1801185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical network connection between two entities such as a user or computer, that has a defined lifetime and associated state, and that might involve multiple physical connections.</descrip></descripGrp><ntig><termGrp><term id="168754">session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1801185">සැසිය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14733_31389_634797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To pick a command or an option from within a graphical user interface, as by clicking a button in a dialog box or pulling down a menu and then releasing the mouse button on one of its options.</descrip></descripGrp><ntig><termGrp><term id="31389">choose</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634797">තෝරන්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14738_124210_1913097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measure used in typesetting and desktop publishing, equal to one-twentieth of a printer's point, or 1/1440th of an inch.</descrip></descripGrp><ntig><termGrp><term id="124210">twip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913097">ට්වයිප්</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14761_143306_1368795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web page editor command that inserts a horizontal line onto a Web page.</descrip></descripGrp><ntig><termGrp><term id="143306">Horizontal Line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368795">තිරස්‍ රේඛාව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14763_141747_635565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that enables a user to sample the color of any pixel on a screen and apply that color to an object.</descrip></descripGrp><ntig><termGrp><term id="141747">eyedropper</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635565">වර්ණ ග්‍රාහකය</term