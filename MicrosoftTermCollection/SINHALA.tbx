_184195_1913204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Content has been hashed and verified as valid against the signature. The certificate used to verify the signature is “valid” in the sense that it has a relationship to a trusted certificate authority (and isn’t expired, etc.)</descrip></descripGrp><ntig><termGrp><term id="184195">Signed - verified</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913204">සංඥා කළ - තහවුරු කළ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16213_2167436_2195041"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hard plastic disc on a mouse that is perpendicular to the mouse surface. It is normally located between the left and right mouse buttons and is used for scrolling.</descrip></descripGrp><ntig><termGrp><term id="2167436">mouse wheel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2195041">මවුස් රෝදය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16213_534934_2195041"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hard plastic disc on a mouse that is perpendicular to the mouse surface. It is normally located between the left and right mouse buttons and is used for scrolling.</descrip></descripGrp><ntig><termGrp><term id="534934">scroll wheel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2195041">මවුස් රෝදය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1622_234771_634413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to Microsoft software which is published by Microsoft, properly licensed, and fully supported by Microsoft or a trusted partner.</descrip></descripGrp><ntig><termGrp><term id="234771">genuine</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634413">අව්‍යාජ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16223_237296_1462319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to select from a gallery of pre-defined formatting styles and apply them quickly to tables, text, charts, drawing objects and SmartArt graphics.</descrip></descripGrp><ntig><termGrp><term id="237296">Quick Styles</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1462319">කඩිනම් විලාස</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16225_232420_1368811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A secure email feature that lets you add sensitivity labels, such as Internal Use Only, to the message header. Security labels in your organization are controlled by security policies set up by your email administrator.</descrip></descripGrp><ntig><termGrp><term id="232420">security label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368811">ආරක්ෂණ‍ ලේබලය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16250_174770_1913197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rectangle with sizing handles that surrounds a selected object or objects.</descrip></descripGrp><ntig><termGrp><term id="174770">selection rectangle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913197">තෝරාගැනීම් ත්‍රිකෝණය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16250_645093_1913197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rectangle with sizing handles that surrounds a selected object or objects.</descrip></descripGrp><ntig><termGrp><term id="645093">selection box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913197">තෝරාගැනීම් ත්‍රිකෝණය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16263_10901_635200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To position objects or text relative to some point, such as the page margin.</descrip></descripGrp><ntig><termGrp><term id="10901">align</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635200">පෙළ ගස්වන්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16276_263115_1368812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a file format that allows for VBA code. Examples of file extensions for macro-enabled formats are .docm, .pptm, .xlsm.</descrip></descripGrp><ntig><termGrp><term id="263115">macro-enabled</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368812">නියොග එකලස් සබලිත</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16290_237379_635512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Office Server that provides a workflow for document review.</descrip></descripGrp><ntig><termGrp><term id="237379">Document Review</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635512">ලේඛ සමාලෝචනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="163_311257_635074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user preferences for the formatting of dates, currencies, numbers, and so on. The user locale is a per-user setting, and does not require the user to restart or to log on or log off the computer.</descrip></descripGrp><ntig><termGrp><term id="311257">user locale</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635074">පරිශීලක පෙදෙසිය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16315_140027_634813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that displays one complete record at a time. You can use data forms to add, change, locate, and delete records.</descrip></descripGrp><ntig><termGrp><term id="140027">data form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634813">දත්ත පෝරමය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16317_209984_635170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Media Player, a database that contains information about digital media files on a computer, a network drive, or the Internet.</descrip></descripGrp><ntig><termGrp><term id="209984">library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635170">පුස්තකාලය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16319_119343_1801191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One or more rows of cells commonly used to display numbers and other items for quick reference and analysis.</descrip></descripGrp><ntig><termGrp><term id="119343">table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1801191">වගුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16322_143641_1368813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cell in which each input value from a data table is substituted. Any cell on a worksheet can be the input cell. Although the input cell does not need to be part of the data table, the formulas in data tables must refer to the input cell.</descrip></descripGrp><ntig><termGrp><term id="143641">input cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368813">ආදාන කොටුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16327_163539_634558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The adjustment of the spacing between two characters to create the appearance of even spacing, fit text to a given space, and adjust line breaks.</descrip></descripGrp><ntig><termGrp><term id="163539">kerning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634558">කර්න් කිරීම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1633_262439_1370168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proposed standard digital rights management (DRM) markup language which enables users to specify rights and conditions associated with resources, such as digital content or Web services.</descrip></descripGrp><ntig><termGrp><term id="262439">XrML</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1370168">විතන්‍ය හිමිකම් සලකුණු බස</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1633_262439_634239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proposed standard digital rights management (DRM) markup language which enables users to specify rights and conditions associated with resources, such as digital content or Web services.</descrip></descripGrp><ntig><termGrp><term id="262439">XrML</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634239">XrML</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1633_262440_1370168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proposed standard digital rights management (DRM) markup language which enables users to specify rights and conditions associated with resources, such as digital content or Web services.</descrip></descripGrp><ntig><termGrp><term id="262440">extensible rights markup language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1370168">විතන්‍ය හිමිකම් සලකුණු බස</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1633_262440_634239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proposed standard digital rights management (DRM) markup language which enables users to specify rights and conditions associated with resources, such as digital content or Web services.</descrip></descripGrp><ntig><termGrp><term id="262440">extensible rights markup language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634239">XrML</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16337_117385_1368814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One character (or more) printed slightly below the baseline of surrounding text.</descrip></descripGrp><ntig><termGrp><term id="117385">subscript</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368814">යටිලකුණ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16338_210449_1913212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The core component of the Excel Server that includes the full Excel calculation functionality. It loads and saves Excel workbooks, queries and refreshes external data, calculates workbooks, and provides the calculated results to the caller.</descrip></descripGrp><ntig><termGrp><term id="210449">Excel Calculation Server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913212">Excel ගණනයකිරීම් සේවාදායකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16344_18758_635088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the context of processes or tasks that are part of an operating system or program, operating without interaction with the user while the user is working on another task.</descrip></descripGrp><ntig><termGrp><term id="18758">background</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635088">පසුබිම්</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16348_318717_1370353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To advance audio or video playback at a speed that is faster than normal.</descrip></descripGrp><ntig><termGrp><term id="318717">fast forward</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1370353">ශීඝ්‍රයෙන් ඉදිරියට</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16358_210492_634743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of attack that tries to trick users into revealing personal information, such as credit card numbers, bank accounts, or passwords, often using links to fake websites included in emails and chat messages.</descrip></descripGrp><ntig><termGrp><term id="210492">phishing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634743">තතුබෑම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16365_338551_634175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item provided and signed by the DCE security server that is both a proof of identity and a list of group memberships.</descrip></descripGrp><ntig><termGrp><term id="338551">privilege attribute certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634175">PAC</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16365_338551_635582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item provided and signed by the DCE security server that is both a proof of identity and a list of group memberships.</descrip></descripGrp><ntig><termGrp><term id="338551">privilege attribute certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635582">වරප්‍රසාද උපලක්ෂණ සහතිකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16365_338565_634175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item provided and signed by the DCE security server that is both a proof of identity and a list of group membe