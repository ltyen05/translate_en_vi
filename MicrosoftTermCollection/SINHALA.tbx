splay settings.</descrip></descripGrp><ntig><termGrp><term id="231981">workspace file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913236">වැඩඉඩ ගොනුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14300_66791_635363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To set a variable to an initial value.</descrip></descripGrp><ntig><termGrp><term id="66791">initialize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635363">මුලපුරන්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14303_346950_635669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Amusment, pleasure, or diversion.</descrip></descripGrp><ntig><termGrp><term id="346950">entertainment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635669">විනෝදාස්වාදනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14314_358367_1368787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendar item that includes reserved resou