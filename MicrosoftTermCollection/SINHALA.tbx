n a document.</descrip></descripGrp><ntig><termGrp><term id="1624319">reading indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913660">කියවීම් ස්ථාන දර්ශකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31805_1624320_1913659"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual effect in the navigation pane that shows users where they are in a document.</descrip></descripGrp><ntig><termGrp><term id="1624320">reading position indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913659">කියවීම් දර්ශකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31805_1624320_1913660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual effect in the navigation pane that shows users where they are in a document.</descrip></descripGrp><ntig><termGrp><term id="1624320">reading position indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913660">කියවීම් ස්ථාන දර්ශකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></nti