on.</descrip></descripGrp><ntig><termGrp><term id="1993382">prepopulation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1997110">ප්‍රතිජනගහනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34572_1993404_2010530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An IRS tax rule in the United States that requires notified payers to withhold a set percentage from payments made to payees who cannot be identified due to missing or incorrect taxpayer identification numbers on tax forms.</descrip></descripGrp><ntig><termGrp><term id="1993404">backup withholding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2010530">උපස්ථම්භ රැඳවීම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34573_1993405_2010531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An United States tax law designation given to any corporation that is a unique entity apart from and taxed separately from its owners.</descrip></descripGrp><ntig><termGrp><term id="1993405">C corporation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2010531">C සංස්ථාව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote>