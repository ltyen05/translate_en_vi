crip></descripGrp><ntig><termGrp><term id="214131">prepaid card code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1747612">සංකේතය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1310_214131_2352252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unique, 25-character code on a prepaid card that adds computer use time to your prepaid computer or that pays for your subscription.</descrip></descripGrp><ntig><termGrp><term id="214131">prepaid card code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2352252">සලාකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13121_359689_1368772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A OneNote item that has been marked with a note tag.</descrip></descripGrp><ntig><termGrp><term id="359689">tagged note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368772">ටැග් කළ සටහන</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13142_111591_635950"><langSe