crosoft Stream</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43695_2951284_2822979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft video streaming service that gives companies the ability to create a secure, encrypted video site, with custom channels, so that the entire company has access to videos any time from any location.</descrip></descripGrp><ntig><termGrp><term id="2951284">Stream (on SharePoint)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2822979">Stream</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43697_2466241_2517708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The customizable chat-based workspace in Office 365.</descrip></descripGrp><ntig><termGrp><term id="2466241">Microsoft Teams</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2517708">Microsoft Teams</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43697_2466241_2735983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The customizable chat-based workspace in Office 365.</descrip>