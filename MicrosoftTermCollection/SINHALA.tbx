escripGrp><descrip type="definition">An effect applied to the background of a design, image or video call where the background is obscured but the speaker's image remains clear.</descrip></descripGrp><ntig><termGrp><term id="2834194">blur</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2834500">අවිශද</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50047_2849656_2834500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect applied to the background of a design, image or video call where the background is obscured but the speaker's image remains clear.</descrip></descripGrp><ntig><termGrp><term id="2849656">background blur</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2834500">අවිශද</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5008_139790_1913122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A modal, custom pop-up form that asks users for additional information or to display a message.</descrip></descripGrp><ntig><termGrp><term id="139790">custom dialog box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913122">අභිමත සංවාද කොටුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50098_2834953_2837243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within Microsoft Outlook and Microsoft Teams that helps users quickly close the loop on an e-mail, either by sending a quick response or by taking a suggested action, such as scheduling a meeting, creating a task, sending a file etc.</descrip></descripGrp><ntig><termGrp><term id="2834953">Suggested Actions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837243">යෝජිත ක්‍රියා</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="501_140730_1913126"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The range of cells that you select to hold the summarized data in a consolidation. The destination area can be on the same worksheet as the source data or on a different worksheet. A worksheet can contain only one consolidation.</descrip></descripGrp><ntig><termGrp><term id="140730">destination area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913126">ගමනාන්ත ප්‍රදේශය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50105_2834963_2837242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 feature that detects when a reply-all or conversation mail storm is brewing in your mail service and temporarily blocks subsequent reply-alls to the thread while issuing a bounce back message (NDR) to the sender who is attempting to reply all. After a "cool down" period (e.g. 2 to 4 hours), the feature will remove the block and allow emails on the thread again (some exceptions can be made during the cool down).</descrip></descripGrp><ntig><termGrp><term id="2834963">Reply-All Storm Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837242">සියල්ලට-පිළිතුරු කැළඹුම් ආරක්ෂණය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50117_2835490_2837538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A regular telephone number meant for a single user to receive and place calls. User numbers can be assigned to any PSTN Calling user.</descrip></descripGrp><ntig><termGrp><term id="2835490">user number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837538">පරිශීලක අංකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50118_2835492_2837537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype telephone number that is used for audio conferencing, auto attendants, or a call queue</descrip></descripGrp><ntig><termGrp><term id="2835492">service number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837537">සේවා අංකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50122_2835501_2837531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Chat running during the meeting and related to the meeting topic.</descrip></descripGrp><ntig><termGrp><term id="2835501">meeting chat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837531">රැස්වීම කතාබහ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835509_2837524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835509">emergency location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837524">හදිසි අවස්ථා ස්ථානය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835509_2837526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835509">emergency location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837526">හදිසි අවස්ථා ප්‍රතිචාර ස්ථානය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835509_2837530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835509">emergency location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837530">ERL</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835527_2837524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835527">emergency response location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837524">හදිසි අවස්ථා ස්ථානය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835527_2837526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835527">emergency response location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837526">හදිසි අවස්ථා ප්‍රතිචාර ස්ථානය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835527_2837530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835527">emergency response location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837530">ERL</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835531_2837524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835531">ERL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837524">හදිසි අවස්ථා ස්ථානය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835531_2837526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835531">ERL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837526">හදිසි අවස්ථා ප්‍රතිචාර ස්ථානය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835531_2837530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835531">ERL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837530">ERL</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50125_2835510_2837523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--the physical or street address of a place of business for your organization that is used to route emergency calls to the appropriate dispatch authorities and to assist in locating the emergency caller.</descrip></descripGrp><ntig><termGrp><term id="2835510">emergency address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837523">හදිසි අවස්ථා ලිපිනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50127_2835544_2837528"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The public organizations whose job is to take quick action to deal with emergencies when they occur, especially the fire brigade, the police, and the ambulance service.</descrip></descripGrp><ntig><termGrp><term id="2835544">emergency services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837528">හදිසි අවස්ථා සේවා</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50128_2835552_2837529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function - when enabled, Teams retrieves policy and location information from the service and includes that information as part of the emergency call.</descrip></descripGrp><ntig><termGrp><term id="2835552">enhanced emergency services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837529">ඉහළ නැංවූ හදිසි අවස්ථා සේවා</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50132_2835563_2837522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies an emergency location.</descrip></descripGrp><ntig><termGrp><term id="2835563">Emergency Location Identification Number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837522">ELIN</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50132_2835563_2837525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies an emergency location.</descrip></descripGrp><ntig><termGrp><term id="2835563">Emergency Location Identification Number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837525">හදිසි අවස්ථා ස්ථාන හඳුනා ගැනීමේ අංකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50132_2835565_2837522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies an emergency location.</descrip></descripGrp><ntig><termGrp><term id="2835565">ELIN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837522">ELIN</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50132_2835565_2837525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies an emergency location.</descrip></descripGrp><ntig><termGrp><term id="2835565">ELIN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837525">හදිසි අවස්ථා ස්ථාන හඳුනා ගැනීමේ අංකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50134_2835567_2837521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that translates into the value of the emergency dial string.</descrip></descripGrp><ntig><termGrp><term id="2835567">dial mask</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837521">අංකන ආවරණය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50138_2835571_2837532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Typically a floor, building, wing, or office number. Place is associated with an emergency address to give a more exact location within a building.</descrip></descripGrp><ntig><termGrp><term id="2835571">place</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837532">තැන</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50139_2835572_2837536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An emergency address that is assigned to each Calling Plan user; it is sometimes referred to as a static emergency address or address of record.</descrip></descripGrp><ntig><termGrp><term id="2835572">registered address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2837536">ලියාපදිංචි ලිපිනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5015_358327_635020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of taking a single-table database and breaking it into a set of smaller, related tables, with each table focused on a single topic or grouping of information.</descrip></descripGrp><ntig><termGrp><term id="358327">normalization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635020">ප්‍රමතකරණය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50216_2841643_2843030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who handles a call to a business such as to fill service requests, place orders, or connect to another respondent or another call.</descrip></descripGrp><ntig><termGrp><term id="2841643">call agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2843030">නියෝජිතයා</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50216_2841643_2843034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who handles a call to a business such as to fill service requests, place orders, or connect to another respondent or another call.</descrip></descripGrp><ntig><termGrp><term id="2841643">call agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2843034">ඇමතුම් නියෝජිත</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50216_2841644_2843030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who handles a call to a business such as to fill service requests, place orders, or connect to another respondent or another call.</descrip></descripGrp><ntig><termGrp><term id="2841644">agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2843030">නියෝජිතයා</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50216_2841644_2843034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who handles a call to a business such as to fill service requests, place orders, or connect to another respondent or another call.</descrip></descripGrp><ntig><termGrp><term id="2841644">agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2843034">ඇමතුම් නියෝජිත</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50217_2841650_2843036"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a call queue, a method of sending calls to agents whereby routing of incoming calls is balanced so that each call agent gets the same number of calls from the queue.</descrip></descripGrp><ntig><termGrp><term id="2841650">round robin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2843036">වටකුරු අවිච්චියා</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50219_2841716_2843035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of the Microsoft Teams Admin Center that shows detailed information about the devices, networks, and connectivity related to the calls and meetings for each user in a Microsoft Teams or Skype for Business tenant account. It is displayed on the user's Call History tab.</descrip></descripGrp><ntig><termGrp><term id="2841716">Call Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2843035">ඇමතුම් විශ්ලේෂණ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50220_2841736_2843031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that gives insight into usage patterns and activity.</descrip></descripGrp><ntig><termGrp><term id="2841736">analytics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2843031">විශ්ලේෂණ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50221_2841755_2843032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft teams, name of a tab on the Manage teams dialog that displays team analytics.</descrip></descripGrp><ntig><termGrp><term id="2841755">Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2843032">විශ්ලේෂණ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50222_2841766_2843033"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a call queue, a method of sending calls to agents whereby the first call in the queue rings all call agents at the same time. The first call agent to pick up the call gets the call.</descrip></descripGrp><ntig><termGrp><term id="2841766">attendant routing</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2843033">සහායක මාර්ගගත කිරීම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50235_2842094_2845204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">During an active meeting, to invite more people to join the meeting by dialing their phone number.</descrip></descripGrp><ntig><termGrp><term id="2842094">dial out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2845204">පිටතට අංකනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50235_2842094_2845206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">During an active meeting, to invite more people to join the meeting by dialing their phone number.</descrip></descripGrp><ntig><termGrp><term id="2842094">dial out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2845206">පිටතට-අංකනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50235_2842095_2845204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">During an active meeting, to invite more people to join the meeting by dialing their phone number.</descrip></descripGrp><ntig><termGrp><term id="2842095">dial-out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2845204">පිටතට අංකනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50235_2842095_2845206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">During an active meeting, to invite more people to join the meeting by dialing their phone number.</descrip></descripGrp><ntig><termGrp><term id="2842095">dial-out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2845206">පිටතට-අංකනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50236_2842096_2845203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To join a conference call when the invited guest initiates the connection by phoning or by connecting through a computer with a conference ID or PIN. Contrast with dial out.</descrip></descripGrp><ntig><termGrp><term id="2842096">dial in</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2845203">ඇතුළට අංකනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50238_2842098_2845208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that automatically changes passwords after a certain time interval.</descrip></descripGrp><ntig><termGrp><term id="2842098">password rotation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2845208">මුරපද භ්‍රමණය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50240_2842100_2845209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A PowerPoint feature that allows the user to enter rehearsal mode and while speaking receive on-screen guidance about pacing, inclusive language, use of filler words, and culturally insensitive phrases. At the end of each rehearsal session, a detailed report with metrics for additional practice is provided.</descrip></descripGrp><ntig><termGrp><term id="2842100">Presenter Coach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2845209">ඉදිරිපත් කිරීමේ පුහුණුකරු</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50241_2842101_2845205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optional feature of Skype for Business Server that allows meeting attendees to join the audio portion of a meeting by calling in to the meeting from a phone.</descrip></descripGrp><ntig><termGrp><term id="2842101">dial-in conferencing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2845205">අතුළට අංකනය සම්මන්ත්‍රණය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50243_2842105_2845207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Property of a private team that shows up in search results and is included in suggestions in the team gallery.</descrip></descripGrp><ntig><termGrp><term id="2842105">discoverable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2845207">සොයා ගත හැකි</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5041_157347_2488981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To terminate the current action before it is complete.</descrip></descripGrp><ntig><termGrp><term id="157347">abandon</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2488981">අත්හරින්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5060_129154_634844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In relational database management systems, a logical table created through the specification of one or more relational operations on one or more tables. A view is equivalent to a divided relation in the relational model.</descrip></descripGrp><ntig><termGrp><term id="129154">view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634844">දසුන</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5069_160054_635561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for converting a color in one color space to another color space. Typically, this conversion is from YUV colors from a video source to RGB for display.</descrip></descripGrp><ntig><termGrp><term id="160054">color-space conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635561">වර්ණ අවකාශ පරිවර්තනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5069_210048_635561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for converting a color in one color space to another color space. Typically, this conversion is from YUV colors from a video source to RGB for display.</descrip></descripGrp><ntig><termGrp><term id="210048">color space conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635561">වර්ණ අවකාශ පරිවර්තනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5070_346942_635258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To provide or give.</descrip></descripGrp><ntig><termGrp><term id="346942">deliver</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635258">බාරදෙන්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5071_119170_1370221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character used to align lines and columns on screen and in print. Although a tab is visually indistinguishable from a series of blank spaces in most programs, the tab character and the space character are different to a computer. A tab is a single character and therefore can be added, deleted, or overtyped with a single keystroke.</descrip></descripGrp><ntig><termGrp><term id="119170">tab character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1370221">ටැබ් අනුලකුණ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5072_138277_635719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a shared file, information that is maintained about changes made in past editing sessions. The information includes the name of the person who made each change, when the change was made, and what data was changed.</descrip></descripGrp><ntig><termGrp><term id="138277">change history</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635719">වෙනස්කම් ඉතිහාසය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5077_1546384_634582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portion of a software window bounded by and separated from other portions by vertical or horizontal bars and having a separate function.</descrip></descripGrp><ntig><termGrp><term id="1546384">window pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634582">කවුළුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5077_90456_634582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portion of a software window bounded by and separated from other portions by vertical or horizontal bars and having a separate function.</descrip></descripGrp><ntig><termGrp><term id="90456">pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634582">කවුළුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5083_148996_1913183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shape in an organization chart that is placed below and connected to a superior (or manager) shape.</descrip></descripGrp><ntig><termGrp><term id="148996">subordinate shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913183">අප්‍රධාන හැඩය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5085_27452_1370222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An (API) that is provided as part of Microsoft Windows. CryptoAPI provides a set of functions that allow applications to encrypt or digitally sign data in a flexible manner while providing protection for the user's sensitive private key data. Actual cryptographic operations are performed by independent modules known as (CSPs).</descrip></descripGrp><ntig><termGrp><term id="27452">CAPI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1370222">ගුප්ත ලේඛන යෙදුම් ක්‍රමලේඛ අතුරුමුහුණත</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5085_27452_634070"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An (API) that is provided as part of Microsoft Windows. CryptoAPI provides a set of functions that allow applications to encrypt or digitally sign data in a flexible manner while providing protection for the user's sensitive private key data. Actual cryptographic operations are performed by independent modules known as (CSPs).</descrip></descripGrp><ntig><termGrp><term id="27452">CAPI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634070">CAPI</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5085_27452_635757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An (API) that is provided as part of Microsoft Windows. CryptoAPI provides a set of functions that allow applications to encrypt or digitally sign data in a flexible manner while providing protection for the user's sensitive private key data. Actual cryptographic operations are performed by independent modules known as (CSPs).</descrip></descripGrp><ntig><termGrp><term id="27452">CAPI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635757">සංකේතන API</term><termNote type="geographicalUsage">LKA</ter