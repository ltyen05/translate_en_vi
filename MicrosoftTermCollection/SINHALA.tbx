h">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913741">දිනදසුන් බැලීම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32263_1644654_1913742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual summary of the user's task list, which is displayed in a callout without switching to the Tasks module.</descrip></descripGrp><ntig><termGrp><term id="1644654">Tasks peek</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913742">කාර්‍යය දැක්ම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32264_1707462_1913819"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tab in the Backstage view where users can manage their identities and services, view licensing details, and link to account management features.</descrip></descripGrp><ntig><termGrp><term id="1707462">Account</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913819">ගිණුම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32265_1644676_1913744"><langSet xml