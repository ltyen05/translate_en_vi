termGrp></ntig></langSet></termEntry><termEntry id="31314_1598854_1649795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An indicator, such as a message, that informs users of events that are unrelated to their current activity, such as the number of new messages received while their computer is locked.</descrip></descripGrp><ntig><termGrp><term id="1598854">notification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1649795">දැනුම්දීම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31317_1598872_2280665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transient message that contains relevant, time-sensitive information and that provides quick access to the subject of that content in an app.</descrip></descripGrp><ntig><termGrp><term id="1598872">toast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2280665">දැනුම්දීම් බැනරය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31317_1642125_2280665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transient message that contains relevant, time-sensitive information and that provides quick access to the subject of that content in an app.</descrip></descripGrp><ntig><termGrp><term id="1642125">toast notification</term><termNote type="partOfSpeech">Noun</termNote><termNot