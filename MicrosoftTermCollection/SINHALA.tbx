714_746441_1913406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that replicates formatting from a source item — such as text in Word, a cell in Excel, a control in Access, or a shape in Publisher — to one or more target items.</descrip></descripGrp><ntig><termGrp><term id="746441">Format Painter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913406">හැඩතල සිත්තරා</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20723_1047661_1368887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of items, such as files and folders, assembled from various locations. The locations might be on your computer, an external hard drive, removable media, or someone else’s computer.</descrip></descripGrp><ntig><termGrp><term id="1047661">Windows library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368887">පුස්තකාලය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20723_746479_1368887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of items, such as files and folders, assembled from various locations. The locations might be on your computer, an external hard drive, removable media, or someone else’s computer.</descrip></descripGrp><ntig><termGrp><term id="746479">library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368887">පුස්තකාලය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20724_746483_1368888"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark an item so that it always appears in a specific place in the UI or in a list.</descrip></descripGrp><ntig><termGrp><term id="746483">pin</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368888">අමුණන්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20725_746484_1368889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove an item, such as a tile, library, movie, game, or app, from a given area of the UI, to make it inaccessible in that area.</descrip></descripGrp><ntig><termGrp><term id="746484">unpin</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368889">ගලවන්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20733_1509298_1520622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user with role-based permission who can change settings for apps, services, users, subscriptions, and/or devices.</descrip></descripGrp><ntig><termGrp><term id="1509298">admin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1520622">පරිපාලක</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20733_746527_1520622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user with role-based permission who can change settings for apps, services, users, subscriptions, and/or devices.</descrip></descripGrp><ntig><termGrp><term id="746527">administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1520622">පරිපාලක</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20734_746528_1520629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft account that manages a subscription.</descrip></descripGrp><ntig><termGrp><term id="746528">administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1520629">පරිපාලක</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20740_2589732_1520647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To come upon through action.</descrip></descripGrp><ntig><termGrp><term id="2589732">discover</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1520647">සොයන්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20740_746541_1520647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To come upon through action.</descrip></descripGrp><ntig><termGrp><term id="746541">find</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1520647">සොයන්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20749_1585924_2826845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of using a “machine” (in most cases computer software) to translate text from one human language to another.</descrip></descripGrp><ntig><termGrp><term id="1585924">automated translation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2826845">ස්වයංක්‍රීය පරිවර්තනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</t