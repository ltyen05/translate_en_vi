 column lists the index entries to generate from the text in the first column.</descrip></descripGrp><ntig><termGrp><term id="139149">concordance file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635980">සුසංගත ගොනුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15795_160318_635844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To assign a drive letter, port, or computer name to a shared resource so that you can use it.</descrip></descripGrp><ntig><termGrp><term id="160318">connect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635844">සබඳින්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15796_233422_635911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To automatically remove items to another folder periodically or delete them, based on the amount of time that they have been in the folder.</descrip></descripGrp><ntig><termGrp><term id="233422">AutoArchive</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635911">ස්වයං රක්ෂණය කරන්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote