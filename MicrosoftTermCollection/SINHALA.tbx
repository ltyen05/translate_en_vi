99413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process wherein data in memory or on disk is unintentionally changed, with its meaning thereby altered or obliterated.</descrip></descripGrp><ntig><termGrp><term id="40131">corruption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2699413">දත්ත සදොස් වීම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1565_116540_634904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To halt a process or action, typically without restoring the prior state.</descrip></descripGrp><ntig><termGrp><term id="116540">stop</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634904">නවතන්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15677_147745_634366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The order in which changes are propagated from replica to replica. Topology determines how quickly changes in another replica appear in your replica.</descrip></descripGrp><ntig><termGrp><term id="147745">replica set topology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634366">අනුරූ කුලක ස්ථලකය</term><termNote type="geographicalUsage">LKA</termNote>