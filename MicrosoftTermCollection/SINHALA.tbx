of their inbox at a specified date and time. It lets the user clear their inbox by postponing items that aren't urgent.</descrip></descripGrp><ntig><termGrp><term id="2329245">Schedule</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2331255">කාර්ය සටහන</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40081_2329246_2331242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark an email message or conversation such that it moves to the top of your inbox and is flagged at a specified date and time.</descrip></descripGrp><ntig><termGrp><term id="2329246">schedule</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2331242">කාර්ය සටහන</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40082_2329247_2329615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of enterprise-related hardware and software security features that, when configured together, will lock a device down so that it can only run trusted applications.​​​</descrip></descripGrp><ntig><termGrp><term id="2329247">Device Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2329615">Device Guard</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40082_2795844_2329615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of enterprise-related hardware and software security features that, when configured together, will lock a device down so that it can only run trusted applications.​​​</descrip></descripGrp><ntig><termGrp><term id="2795844">Microsoft Defender Device Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2329615">Device Guard</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40083_2329248_2333067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of Windows Store for Business where admins can sign policies and catalogs of approved software, including LOB apps, using enterprise-specific signing certificates.​</descrip></descripGrp><ntig><termGrp><term id="2329248">Device Guard signing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2333067">Device Guard අත්සන් කිරීම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40084_2329249_2333072"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category of fonts that make it easier for people with dyslexia to read.​</descrip></descripGrp><ntig><termGrp><term id="2329249">Fluent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2333072">Fluent</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40085_2329250_2340314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One to whom something is delegated.</descrip></descripGrp><ntig><termGrp><term id="2329250">assignee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2340314">පැවරුම්ලාභියා</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40086_2329251_2340332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to items marked with a star.</descrip></descripGrp><ntig><termGrp><term id="2329251">starred</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2340332">තරු සලකුණු කළ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40087_2329252_2340331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An indication for a priority in a list or other organizational structure.</descrip></descripGrp><ntig><termGrp><term id="2329252">star</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2340331">තරුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40091_2329597_2334552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email protection feature that detects messages with phish, spam, or malware that have already been delivered to your users' inboxes, and then renders the malicious content harmless.</descrip></descripGrp><ntig><termGrp><term id="2329597">zero-hour auto purge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2334552">ZAP</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40091_2329597_2334554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email protection feature that detects messages with phish, spam, or malware that have already been delivered to your users' inboxes, and then renders the malicious content harmless.</descrip></descripGrp><ntig><termGrp><term id="2329597">zero-hour auto purge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2334554">ශුන්‍ය-පැය ස්වයං පවිත්‍රකරණය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40091_2329598_2334552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email protection feature that detects messages with phish, spam, or malware that have already been delivered to your users' inboxes, and then renders the malicious content harmless.</descrip></descripGrp><ntig><termGrp><term id="2329598">ZAP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2334552">ZAP</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40091_2329598_2334554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email protection feature that detects messages with phish, spam, or malware that have already been delivered to your users' inboxes, and then renders the malicious content harmless.</descrip></descripGrp><ntig><termGrp><term id="2329598">ZAP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2334554">ශුන්‍ය-පැය ස්වයං පවිත්‍රකරණය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40092_2329599_2334548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of add-ins that transform pages from a variety of apps into sways.</descrip></descripGrp><ntig><termGrp><term id="2329599">Send to Sway</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2334548">Sway වෙත යවන්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40093_2329763_2334536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The blog platform on Docs.com where users can share their posts using Sway.</descrip></descripGrp><ntig><termGrp><term id="2329763">Journal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2334536">ජර්නලය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40107_2330211_2334528"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SharePoint authoring tool that allows users to create different types of SharePoint pages such as microsites, articles, and blogs.</descrip></descripGrp><ntig><termGrp><term id="2330211">authoring canvas</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2334528">කර්තෘත්ව කැන්වසය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40109_2330388_2334540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables customers to satisfy stringent SEC Rule 17a-4 record retention requirements with advanced administrative controls for archiving such as restricting changes to archiving policies and preventing such policies from being turned off or removed.</descrip></descripGrp><ntig><termGrp><term id="2330388">Preservation Lock</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2334540">සංරක්‍ෂණ අගුල</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40111_2330390_2333089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A generic reference to an organization's Windows Store for Business to offer specific content to their users, and for users to download approved content.</descrip></descripGrp><ntig><termGrp><term id="2330390">private store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2333089">පුද්ගලික ගබඩාව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40112_2330405_2333086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A map d