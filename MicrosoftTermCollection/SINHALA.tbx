><termGrp><term id="1709112">rotation lock button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1759900">කැරකැවීම අගුළු දැමීමේ බොත්තම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32879_1709128_1913820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Exchange mailbox that is associated with a SharePoint site, enabling users to access documents and email related to group projects through either Outlook or SharePoint.</descrip></descripGrp><ntig><termGrp><term id="1709128">site mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913820">අඩවි තැපැල් පෙට්ටිය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32884_1710098_1721872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An edition of Windows 8 Pro that contains Windows Media Center.</descrip></descripGrp><ntig><termGrp><term id="1710098">Windows 8 Pro with Media Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1721872">Media Center සහිත Windows 8 Pro</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32886_1713361_1913821"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Authenticated access that can be granted to external partners and clients to enable sharing of selected SharePoint Online content.</descrip></descripGrp><ntig><termGrp><term id="1713361">external access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913821">බාහිර පිවිසුම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32887_1713362_1913822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique link that provides external users anonymous access to selected documents stored in SharePoint Online, with no sign in required.</descrip></descripGrp><ntig><termGrp><term id="1713362">guest link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913822">ආගන්තුක සබැඳිය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32888_1713387_1954378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables rich visualizations for interactive data exploration, presentation and reporting in SharePoint and Excel.</descrip></descripGrp><ntig><termGrp><term id="1713387">Power View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1954378">Power View</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32893_1713523_1721873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The release candidate release of the Windows 8 operating system.</descrip></descripGrp><ntig><termGrp><term id="1713523">Windows 8 Release Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1721873">Windows 8 Release Preview</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32895_1713527_1748051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An automated proactive scan that triggers when NTFS detects a corruption. The scan is equivalent to the scan phase of chkdsk and finds and logs all corruptions to an internal file. This scan runs during maintenance hours, can be triggered from the Explorer, or manually run from a command line. When this scan is running in the background, some NTFS operations may be blocked.</descrip></descripGrp><ntig><termGrp><term id="1713527">Proactive Scanner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1748051">ප්‍රොඇක්ටිව් ස්කෑනරය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32896_1713528_1747957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A registry setting that allows the DHCP client to transmit more messages to the server to obtain an IP address when the PC is in connected standby mode. This setting can increase power consumption but can also help resolve IP address (IPv4 or IPv6) problems more quickly.</descrip></descripGrp><ntig><termGrp><term id="1713528">aggressive address acquisition retry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1747957">කඩිනම් ලිපිනය ලබාගැනීමේ නැවත උත්සාහය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32897_1713529_1747959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service within Remote Desktop Services responsible for aggregating RemoteApp programs and desktops that are published to end users from across the entire deployment. It ensure only users with appropriate rights can access published resources. The resources are used to display error messages that, for example, might say that the publishing service is unavailable. This can help the admin debug their deployment.</descrip></descripGrp><ntig><termGrp><term id="1713529">Central Publishing service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1747959">මධ්‍යම ප්‍රකාශන සේවාව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32899_1713532_1747968"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability to sign in to a PC by using a four-digit code.</descrip></descripGrp><ntig><termGrp><term id="1713532">PIN sign-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1747968">ඇතුල් වීමේ පින් අංකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3290_142330_1368652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color that that is currently selected for drawing or displaying text on the screen.</descrip></descripGrp><ntig><termGrp><term id="142330">foreground color</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368652">පෙරබිම් වර්ණය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32900_1713533_1748133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software setting that disables display rotation.</descrip></descripGrp><ntig><termGrp><term id="1713533">rotation lock</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1748133">කැරකෙන අගුළ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32908_1718119_1913824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instrumentation and logging platform that provides monitoring, reporting and log viewing capabilities for Office servers and services.</descrip></descripGrp><ntig><termGrp><term id="1718119">ULS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913824">ULS</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32908_1718119_1913830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instrumentation and logging platform that provides monitoring, reporting and log viewing capabilities for Office servers and services.</descrip></descripGrp><ntig><termGrp><term id="1718119">ULS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913830">අනුමත වාර්තාකරණ සේවාව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32908_1722438_1913824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instrumentation and logging platform that provides monitoring, reporting and log viewing capabilities for Office servers and services.</descrip></descripGrp><ntig><termGrp><term id="1722438">Unified Logging Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913824">ULS</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32908_1722438_1913830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instrumentation and logging platform that provides monitoring, reporting and log viewing capabilities for Office servers and services.</descrip></descripGrp><ntig><termGrp><term id="1722438">Unified Logging Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913830">අනුමත වාර්තාකරණ සේවාව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32909_1718122_1913825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application-hosting architecture that relies on cloud-based services. Application logic and data are typically hosted on a distributed set of services on the Internet, connected through web APIs, and authenticated with server-to-server authentication technologies such as OAuth.</descrip></descripGrp><ntig><termGrp><term id="1718122">Cloud App Model</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913825">ක්ලවුඩ් යෙදුම් මාදිලිය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32925_1718267_1913827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item that lets the user open a document using a different application than the one associated with the document type.</descrip></descripGrp><ntig><termGrp><term id="1718267">Open with</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913827">විවෘත කිරීම යොදාගනිමින්</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3293_83637_635770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On a Web page, a grouping of hyperlinks for getting around in that particular Web site.</descrip></descripGrp><ntig><termGrp><term id="83637">navigation bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635770">සංචාලන තීරුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32930_1719344_2801505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that shows how products are used including where, how often, with which other software and hardware. This data is used to identify user needs and experiences as well as potential marketing and product improvement opportunities over time. Partners and Microsoft can better understand what happens between planning, lab testing, sales data, and real world scenarios over time.</descrip></descripGrp><ntig><termGrp><term id="1719344">telemetry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2801505">දෝෂනිර්ණ දත්ත</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32930_1998703_2801505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that shows how products are used including where, how often, with which other software and hardware. This data is used to identify user needs and experiences as well as potential marketing and product improvement opportunities over time. Partners and Microsoft can better understand what happens between planning, lab testing, sales data, and real world scenarios over time.</descrip></descripGrp><ntig><termGrp><term id="1998703">telemetry data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2801505">දෝෂනිර්ණ දත්ත</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32930_2790091_2801505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that shows how products are used including where, how often, with which other software and hardware. This data is used to identify user needs and experiences as well as potential marketing and product improvement opportunities over time. Partners and Microsoft can better understand what happens between planning, lab testing, sales data, and real world scenarios over time.</descrip></descripGrp><ntig><termGrp><term id="2790091">diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2801505">දෝෂනිර්ණ දත්ත</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32934_1722196_1913829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that returns the first non-null expression from a list of arguments.</descrip></descripGrp><ntig><termGrp><term id="1722196">COALESCE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913829">COALESCE</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32994_2027122_2032497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app for Mac computers that creates a folder on the user's computer, downloads the contents of their OneDrive, and keeps the folder in sync with any file changes online and among additional computers.</descrip></descripGrp><ntig><termGrp><term id="2027122">OneDrive for Mac</term><termNote type="partOfSpeech">ProperNoun</