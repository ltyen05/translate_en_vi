CP</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6835_175156_635850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A PPP control protocol that negotiates link and PPP parameters to dynamically configure the data-link layer of a PPP connection.</descrip></descripGrp><ntig><termGrp><term id="175156">LCP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635850">සබැඳි පාලන ප්‍රොටොකෝලය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6841_139625_1913119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shape in an organization chart that is next to another shape that is connected to the same superior (or manager) shape.</descrip></descripGrp><ntig><termGrp><term id="139625">coworker shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913119">සහකාර හැඩය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6842_2656621_2657668"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A lightweight version of Outlook Web Access optimized for accessibility and compatibility with the widest array of browsers and operating systems.</