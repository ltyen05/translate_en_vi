<term id="588928">clustered bar chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913324">වෙන්කළ තීරු ප්‍රස්තාරය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16466_588929_1913325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pie chart with user-defined values extracted and combined into a second pie.</descrip></descripGrp><ntig><termGrp><term id="588929">pie of pie chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913325">වෘත්ත ප්‍රස්තාර කොටස</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16467_588930_1913326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pie chart with user-defined values extracted and combined into a stacked bar.</descrip></descripGrp><ntig><termGrp><term id="588930">bar of pie chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913326">වටප්‍රස්තාරයේ තීරුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16468_1485421_1913327"><langSet xml:lang=