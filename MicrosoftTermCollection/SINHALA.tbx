ම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5440_95667_1548222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a Web Parts connection, a server control that sends data to a consumer control. A provider can be a WebPart control or any type of server control, but must be designed to function as a provider. A provider must have a special callback method marked with a ConnectionProviderAttribute attribute in the source code. This method provides data to consumer controls in the form of an interface instance.</descrip></descripGrp><ntig><termGrp><term id="95667">provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1548222">සැපයුම්කරු</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5444_144872_1913157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An animated border that appears around a worksheet range that has been cut or copied. To cancel a moving border, press ESC.</descrip></descripGrp><ntig><termGrp><term id="144872">moving border</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913157">ගමන්කරන සීමාව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5452_25722_635236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of memory measurement that consists of eight bits.</descrip></descripGrp><ntig><termGrp><term id="25722">byte</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635236">බයිටය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5464_318426_634060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ' character (user-typed text).</descrip></descripGrp><ntig><termGrp><term id="318426">apostrophe</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634060">ASCII ලොප් ලකුණ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5464_318426_635527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ' character (user-typed text).</descrip></descripGrp><ntig><termGrp><term id="318426">apostrophe</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635527">ලොප් ලකුණ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5464_318427_634060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ' character (user-typed text).</descrip></descripGrp><ntig><termGrp><term id="318427">ASCII apostrophe</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634060">ASCII ලොප් ලකුණ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5464_318427_635527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ' character (user-typed text).</descrip></descripGrp><ntig><termGrp><term id="318427">ASCII apostrophe</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635527">ලොප් ලකුණ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5464_318430_634060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ' character (user-typed text).</descrip></descripGrp><ntig><termGrp><term id="318430">APOSTROPHE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634060">ASCII ලොප් ලකුණ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5464_318430_635527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ' character (user-typed text).</descrip></descripGrp><ntig><termGrp><term id="318430">APOSTROPHE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635527">ලොප් ලකුණ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5465_121255_634790"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of coordinated graphic elements applied to a document, Web page, or across all pages in a Web site.</descrip></descripGrp><ntig><termGrp><term id="121255">theme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634790">තේමාව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5469_177200_634853"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message sent to the user or administrator of a system where the recipient may be a human or an automated notification manager.</descrip></descripGrp><ntig><termGrp><term id="177200">notification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634853">දැනුම්දීම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5471_139235_634639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of formatting that is applied to cell contents, form controls, Outlook items or other data based on one or more logical conditions.</descrip></descripGrp><ntig><termGrp><term id="139235">conditional formatting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634639">කොන්දේසිගත හැඩතල ගැන්වීම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5474_142066_635573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for filtering records in a form, datasheet, or data access page in which you retrieve only records that contain the selected value.</descrip></descripGrp><ntig><termGrp><term id="142066">Filter By Selection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635573">වරණානුකූල පෙරහන</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5477_264641_635963"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fraction that is written vertically with the numerator on the top and the denominator below, with a horizontal fraction bar between them.</descrip></descripGrp><ntig><termGrp><term id="264641">stacked fraction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635963">සිරස්ව ලියූ භාගය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5483_88655_634562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number whose form indicates position in an ordered sequence of items, such as first, third, or twentieth.</descrip></descripGrp><ntig><termGrp><term id="88655">ordinal number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634562">ක්‍රමසංඛ්‍යාව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5487_26569_1370227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Broadly, any device that performs arithmetic operations on numbers. Sophisticated calculators can be programmed for certain functions and can store values in memory, but they differ from computers in several ways: they have a fixed set of commands, they do not recognize text, they cannot retrieve values stored in a data file, and they cannot find and use values generated by a program such as a spreadsheet.</descrip></descripGrp><ntig><termGrp><term id="26569">calculator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1370227">කැල්ක්‍යුලේ‍ටරය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5492_144959_1913159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Category labels in a chart that, based on worksheet data, are automatically displayed on more than one line in a hierarchy. For example, the heading Produce might appear above a row with headings Tofu, Apples, and Pears.</descrip></descripGrp><ntig><termGrp><term id="144959">multiple-level category labels</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913159">බහු -මට්ටම් ප්‍රවර්‍ග ලේබල</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5506_178166_1801129"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An implementation of Domain Name System (DNS) written and ported to most available versions of the UNIX operating system. The Internet Software Consortium maintains the BIND software.</descrip></descripGrp><ntig><termGrp><term id="178166">Berkeley Internet Name Domain</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1801129">BIND</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5506_178167_1801129"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An implementation of Domain Name System (DNS) written and ported to most available versions of the UNIX operating system. The Internet Software Consortium maintains the BIND software.</descrip></descripGrp><ntig><termGrp><term id="178167">BIND</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1801129">BIND</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5511_55836_636034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The overall layout or pattern of a document.</descrip></descripGrp><ntig><termGrp><term id="55836">format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="636034">හැඩතලය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5514_174436_1913195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who uses a computer that is not connected to a network. A local user is most likely someone using a computer at home.</descrip></descripGrp><ntig><termGrp><term id="174436">local user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913195">සාමාන්‍ය පරිශීලක</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5515_102469_1913079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication mechanism that allows computers to communicate with one another over a network. An RPC consists of a procedure identifier, parameters passed to the procedure, and a value returned to the caller (client computer) after the procedure has executed on the remote system (server computer).</descrip></descripGrp><ntig><termGrp><term id="102469">remote procedure call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913079">RPC</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5515_102470_1913079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication mechanism that allows computers to communicate with one another over a network. An RPC consists of a procedure identifier, parameters passed to the procedure, and a value returned to the caller (client computer) after the procedure has executed on the remote system (server computer).</descrip></descripGrp><ntig><termGrp><term id="102470">RPC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913079">RPC</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5518_269743_635777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard Windows control that combines text box and list box functions.</descrip></descripGrp><ntig><termGrp><term id="269743">combo box control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635777">සංයුක්ත කොටු පාලකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5518_269743_635778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard Windows control that combines text box and list box functions.</descrip></descripGrp><ntig><termGrp><term id="269743">combo box control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635778">සංයුක්ත කොටුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5518_35264_635777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard Windows control that combines text box and list box functions.</descrip></descripGrp><ntig><termGrp><term id="35264">combo box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635777">සංයුක්ත කොටු පාලකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5518_35264_635778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard Windows control that combines text box and list box functions.</descrip></descripGrp><ntig><termGrp><term id="35264">combo box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635778">සංයුක්ත කොටුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5519_129398_634294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a virtual memory system, the address the application uses to reference memory. The kernel and the memory management unit (MMU) translate this address into a physical address before the memory is actually read or written.</descrip></descripGrp><ntig><termGrp><term id="129398">virtual address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634294">අතාත්වික යොමුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5526_55989_1801149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The attributes of a cell in a spreadsheet, such as its being alphabetic or numeric, the number of digits, the use of commas, and the use of currency signs.</descrip></descripGrp><ntig><termGrp><term id="55989">format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="18011