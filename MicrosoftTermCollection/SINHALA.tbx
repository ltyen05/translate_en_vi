></termGrp></ntig></langSet></termEntry><termEntry id="22042_782589_1368994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that can respond to an applied stimulus by generating an electrical signal.</descrip></descripGrp><ntig><termGrp><term id="782589">electrical sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368994">විද්යුත් සංවේදකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22043_782590_1368995"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that is used for mechanical measurement of force, scale, pressure, strain, etc.</descrip></descripGrp><ntig><termGrp><term id="782590">mechanical sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368995">යාන්ත්‍රික සංවේදකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22044_782669_1368996"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that tracks environmental changes such as temperature, atmospheric pressure, humidity, wind speed and wind direction.</descrip></descripGrp><ntig><termGrp><term id="782669">environmental sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><n