<term id="550">cookie</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634619">කුකිය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27555_1381690_1520675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A website or service that a customer can connect to in order to share what they've been doing on other websites, see their friends and their updates from other services in Windows Live, or share their Windows Live activity on other websites.</descrip></descripGrp><ntig><termGrp><term id="1381690">service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1520675">සේවාව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27565_1382243_1520685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder someone using Windows Live Sync is synchronizing between computers.</descrip></descripGrp><ntig><termGrp><term id="1382243">synced folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1520685">සමමු ෆෝල්ඩරය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27578_1385957_1427454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to navigate directly to the webpage of the top-ranked search result when a search is performed in the address bar.</descrip></descripGrp><ntig><termGrp><term id="1385957">Address Bar Top Result</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1427454">ලිපින තීරු ඉහළම ප්‍රතිඵල</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27584_1387192_1747543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The return to a customer's account of funds that were used to purchase an item. This may occur as a result of a customer's contacting a bank to dispute a credit-card transaction.</descrip></descripGrp><ntig><termGrp><term id="1387192">chargeback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1747543">ගාස්තු නැවත ලබා දීම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27587_1387436_1427445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lists files downloaded from the Internet, shows the location of each downloaded file, and allows the user to pause downloads, open files, and take other actions.</descrip></descripGrp><ntig><termGrp><term id="1387436">Download Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1427445">බාගැනීම් කළමනාකරු</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27588_1387437_1427455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client-server program accessed over a network that uses a web browser as the interface for the end user.</descrip></descripGrp><ntig><termGrp><term id="1387437">web application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1427455">වෙබ් යෙදුම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27588_1406417_1427455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client-server program accessed over a network that uses a web browser as the interface for the end user.</descrip></descripGrp><ntig><termGrp><term id="1406417">web app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1427455">වෙබ් යෙදුම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27595_1387750_1913587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audience member who is not physically located in the same room as the presenter.</descrip></descripGrp><ntig><termGrp><term id="1387750">remote viewer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913587">දූර දක්වනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2762_134154_634981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of a word-processing program or a text-editing program to break lines of text automatically to stay within the page margins or window boundaries of a document without the user having to do so with carriage returns, as is typically necessary on a typewriter.</descrip></descripGrp><ntig><termGrp><term id="134154">word wrap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634981">පද එතුම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2762_134154_635199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of a word-processing program or a text-editing program to break lines of text automatically to stay within the page margins or window boundaries of a document without the user having to do so with carriage returns, as is typically necessary on a typewriter.</descrip></descripGrp><ntig><termGrp><term id="134154">word wrap</term><termNote type="partOfSpeech">Noun</termNote><ter