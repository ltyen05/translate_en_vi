<termEntry id="12578_58758_635417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button on the address bar that enables the user to navigate to the specified location (such as a folder path or web address).</descrip></descripGrp><ntig><termGrp><term id="58758">Go</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635417">යන්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12592_77991_1368766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person whose work or profession is management.</descrip></descripGrp><ntig><termGrp><term id="77991">manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368766">කළමනාකරු</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12607_170582_1370307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that installs or upgrades the Windows operating system.</descrip></descripGrp><ntig><termGrp><term id="170582">Windows Setup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1370307">Windows පිහිටුම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neu