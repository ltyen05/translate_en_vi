rmGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368890">සාමාන්‍ය පැන්සල</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20754_747357_1368891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that enables users to easily roll back their PC to an earlier good state while keeping their data safe.</descrip></descripGrp><ntig><termGrp><term id="747357">System Recovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368891">පද්ධති ප්‍රතිසාධනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2077_149214_1368639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view on a calendar that displays items such as meetings and events from left to right on a time scale and that can incorporate items from multiple calendars.</descrip></descripGrp><ntig><termGrp><term id="149214">timeline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368639">කාලරේඛාව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20781_747562_2843037"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a call queue, a method of sending calls to agents whereby incoming calls ring all call agents one by one, from the beginning of the call agent list. If an agent dismisses or does not pick up a call, the call will ring the next agent and will try all agents until it is picked up or times out.</descrip></descripGrp><ntig><termGrp><term id="747562">serial routing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2843037">අනුක්‍රමික මාර්ගගත කිරීම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20803_3193169_1368892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which multiple authors edit a shared document simultaneously, or collaborate effectively even when they are not online at the same time.</descrip></descripGrp><ntig><termGrp><term id="3193169">coauthoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368892">සම කර්තෘත්වය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20803_747620_1368892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which multiple authors edit a shared document simultaneously, or collaborate effectively even when they are not online at the same time.</descrip></descripGrp><ntig><termGrp><term id="747620">co-authoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368892">සම කර්තෘත්වය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20805_1043088_1462137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client-side cache for documents that are stored on Web servers. Documents are seamlessly replicated from this local cache, and uploaded to servers as required, enabling faster and more robust file access.</descrip></descripGrp><ntig><termGrp><term id="1043088">Office Document Cache</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1462137">Office ලේඛන පසුම්බිය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20805_747622_1462137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client-side cache for documents that are stored on Web servers. Documents are seamlessly replicated from this local cache, and uploaded to servers as required, enabling faster and more robust file access.</descrip></descripGrp><ntig><termGrp><term id="747622">Microsoft Office Document Cache</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1462137">Office ලේඛන පසුම්බිය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2081_30138_1368640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To modify the value of a property or attribute.</descrip></descripGrp><ntig><termGrp><term id="30138">change</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368640">වෙනස් කරන්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20839_747785_1368893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides access to gallery of frequently-used actions with the touch of a button. Users can customize the gallery to execute a combination of operations in one click.</descrip></descripGrp><ntig><termGrp><term id="747785">Quick Steps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368893">ඉක්මන් පියවර</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20840_747989_1462138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A frame that contains text, shapes, pictures, or other content. A slide is a digital equivalent to a traditional film slide.</descrip></descripGrp><ntig><termGrp><term id="747989">slide</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1462138">ස්ලියිඩය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20843_748066_2497450"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows tool used to capture a screen shot, or snip, of any object on the screen, and then annotate, save, or share the image.</descrip></descripGrp><ntig><termGrp><term id="748066">Snipping Tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2497450">කැපීමේ මෙවලම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20848_748169_1368894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark an email conversation so that all current and future messages in the conversation are automatically moved to the Deleted Items folder.</descrip></descripGrp><ntig><termGrp><term id="748169">ignore</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368894">නොතකන්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20849_748170_1368895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special control that shows pictures, names and titles of people who are attending a meeting, or who are the recipients of an email message.</descrip></descripGrp><ntig><termGrp><term id="748170">Attendee/Recipient List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1368895">පැමිණෙන්නන්/ලබන්නන් ලැයිස්තුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20851_1140414_2818469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of people who can answer calls on behalf of someone else.</descrip></descripGrp><ntig><termGrp><term id="1140414">team-call group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2818469">අනුරේඛනය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20854_748237_1913407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user's work day hours as specified in Microsoft Office Outlook by the day of the week and the start and end times.</descrip></descripGrp><ntig><termGrp><term id="748237">working hours</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913407">වැඩ කරන පැය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelect