Grp><term id="320423">multiplication sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634666">ගුණ කිරීමේ ලකුණ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3567_320424_634666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The × character.</descrip></descripGrp><ntig><termGrp><term id="320424">MULTIPLICATION SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634666">ගුණ කිරීමේ ලකුණ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3568_234787_1370198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file backup feature that performs scheduled incremental backups of data to the target media. It also allows the user to restore an individual file or a group of files.</descrip></descripGrp><ntig><termGrp><term id="234787">Windows Backup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1370198">Windows Backup</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35685_2052902_2071512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A licensing mode that enables Office 365 subscribers to access their account from different computers and that allows multiple users belonging to the same subscription to log in and use their account from the same computer.</descrip></descripGrp><ntig><termGrp><term id="2052902">shared computer activation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2071512">පරිගණකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35685_2488791_2071512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A licensing mode that enables Office 365 subscribers to access their account from different computers and that allows multiple users belonging to the same subscription to log in and use their account from the same computer.</descrip></descripGrp><ntig><termGrp><term id="2488791">SCA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2071512">පරිගණකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35686_2052903_2071511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email sent at a specified time to a user to remind them of an upcoming event. Users can create reminder emails for themselves for any event in their calendars and for all attendees (when users are also the organizers). The email contains all detail