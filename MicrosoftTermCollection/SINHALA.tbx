ote></termGrp></ntig></langSet></termEntry><termEntry id="5090_115534_635285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special control added to a window, typically adjacent to the scroll bar, that allows a user to split a window or adjust a window split.</descrip></descripGrp><ntig><termGrp><term id="115534">split box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635285">බෙදුම් කොටුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5103_312764_634970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Internet Explorer, a set of tabs you can store in your Favorites or as Home Page to reopen all tabs in the set in one go.</descrip></descripGrp><ntig><termGrp><term id="312764">tab set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634970">පටිති කුලකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5112_136266_634065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Windows multimedia file format for sound and videos that uses the Microsoft Resource Interchange File Format (RIFF) specification.</descrip></descripGrp><ntig><termGrp><term id="136266">Audio Video Interleaved</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="