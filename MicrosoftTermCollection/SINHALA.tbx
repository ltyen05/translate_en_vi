lect objects.</descrip></descripGrp><ntig><termGrp><term id="94558">primary mouse button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635604">වාම මූසික ‍බොත්තම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5644_73400_634142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data unit of 1024 bytes.</descrip></descripGrp><ntig><termGrp><term id="73400">KB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634142">KB</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5644_73400_634617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data unit of 1024 bytes.</descrip></descripGrp><ntig><termGrp><term id="73400">KB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634617">කිලෝබයිටය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5644_73402_634142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data unit of 1024 bytes.</descrip></descripGrp><ntig><termGrp><term id="73402">kilobyte</term><termNote t