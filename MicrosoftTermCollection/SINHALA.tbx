>NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19436_659694_2812291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that can contain one or more child objects.</descrip></descripGrp><ntig><termGrp><term id="659694">container</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2812291">බහාලුම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19436_763338_2812291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that can contain one or more child objects.</descrip></descripGrp><ntig><termGrp><term id="763338">container element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2812291">බහාලුම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1944_321903_634456"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an operation or feature that involves moving objects on the screen with a mouse, a similar input device or a eventually a finger.</descrip></descripGrp><ntig><termGrp><term id="321903">drag-and-drop</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634456">ඇද හෙළන්න</term><termNote type="geographicalUsage">LKA</termNote><