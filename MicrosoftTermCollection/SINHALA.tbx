am create new plans, organize and assign work, share files, discuss team activity, and get updates on progress.</descrip></descripGrp><ntig><termGrp><term id="2392508">Planner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2517709">Planner</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40618_2393978_2517709"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Project work management app that helps a team create new plans, organize and assign work, share files, discuss team activity, and get updates on progress.</descrip></descripGrp><ntig><termGrp><term id="2393978">Microsoft Planner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2517709">Planner</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40619_2357847_2366966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The drop-down menu that gives users the option of filtering messages in their inbox by “Unread” or “Flagged” items.</descrip></descripGrp><ntig><termGrp><term id="2357847">Quick Filters for message list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2366966">පණිවිඩ ලැයිස්තුව සඳහා යුහු පෙරහන්</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40620_2357848_2360948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that gives users the option of filtering messages in their inbox by “Unread” or “Flagged” items.</descrip></descripGrp><ntig><termGrp><term id="2357848">Quick Filters</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2360948">යුහු පෙරහන්</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40621_2357849_2360947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to tag emails by using # followed by a keyword within the message and that enables users to view all emails tagged with that keyword in their email account.</descrip></descripGrp><ntig><termGrp><term id="2357849">Hashtags</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2360947">හෑෂ්ටැග</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40632_2358041_2359328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category of apps or games that are selected based on downloads, usage, and r