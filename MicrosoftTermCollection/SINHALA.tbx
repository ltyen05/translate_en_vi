angSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway link that opens an email that allows users to report a violation of Sway’s terms of use.</descrip></descripGrp><ntig><termGrp><term id="2244888">Report a violation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2256494">උල්ලංඝනයක් වාර්තා කරන්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38627_2244890_2256450"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway menu that displays all of the available cards in a single panel.</descrip></descripGrp><ntig><termGrp><term id="2244890">Card gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2256450">කාඩ්පත ගැලරිය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38628_2244894_2256474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows users to create a hyperlink embedded in their sway.</descrip></descripGrp><ntig><termGrp><term id="2244894">Link</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2256474">සබැඳිය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><t