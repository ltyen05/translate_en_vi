t></termEntry><termEntry id="5728_25995_634632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that enables a broadband connection to the Internet by using cable television infrastructure. Access speeds vary greatly, with a maximum throughput of 10 megabits per second (Mbps).</descrip></descripGrp><ntig><termGrp><term id="25995">cable modem</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634632">කේබල් මෝඩමය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="573_231958_634634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of coordinates that a cell occupies on a worksheet. For example, the reference of the cell that appears at the intersection of column B and row 3 is B3.</descrip></descripGrp><ntig><termGrp><term id="231958">cell reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634634">කොටු යොමුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5731_155920_1913754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of preventing a denial of service attack by limiting the number of requests that can be made to a system.</descrip></descripGrp><ntig><termGrp><term id="155920">throttling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913754">ඉල්ලීම් අවකරණය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5731_1645777_1913754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of preventing a denial of service attack by limiting the number of requests that can be made to a system.</descrip></descripGrp><ntig><termGrp><term id="1645777">request throttling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913754">ඉල්ලීම් අවකරණය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5738_44359_635302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To eliminate text, a file, or part of a document with the intention of removing the information permanently.</descrip></descripGrp><ntig><termGrp><term id="44359">delete</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635302">මකන්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5743_128619_1913099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that converts analog images (for example, from a television or VCR) into digital images