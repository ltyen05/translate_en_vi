langSet xml:lang="en-US"><descripGrp><descrip type="definition">A detailed summary of one's academic and work history and experience, including information about research, publications, and/or academic or personal interests and achievements.</descrip></descripGrp><ntig><termGrp><term id="297966">curriculum vitae</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634090">CV</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14801_297966_634717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A detailed summary of one's academic and work history and experience, including information about research, publications, and/or academic or personal interests and achievements.</descrip></descripGrp><ntig><termGrp><term id="297966">curriculum vitae</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634717">ජීව දත්ත</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14801_297967_634090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A detailed summary of one's academic and work history and experience, including information about research, publications, and/or academic or personal interests and achievements.</descrip></descripGrp><ntig><termGrp><term id="297967">CV</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp