605166_2607903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that provides CRM functionality for small businesses.</descrip></descripGrp><ntig><termGrp><term id="2605166">Customer Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2607903">Customer Manager</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42469_2407531_2411536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The full-screen Word mode that puts a black background around the content and hides the ribbon and the status bar, and which shows the ribbon when the cursor is moved to the top of the screen.</descrip></descripGrp><ntig><termGrp><term id="2407531">Focus Mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2411536">නාභිගත ප්‍රකාරය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42470_2407565_2517707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 service for small businesses that includes customizable Web-based booking pages where customers can book appointments for services and that sends out email confirmations, reminders, updates, and cancelation notices to customers and employees.</descrip></descripGrp><ntig><termGrp><term id="2407565">Microsoft Bookings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2517707">Bookings</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42470_2462549_2517707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 service for small businesses that includes customizable Web-based booking pages where customers can book appointments for services and that sends out email confirmations, reminders, updates, and cancelation notices to customers and employees.</descrip></descripGrp><ntig><termGrp><term id="2462549">Bookings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2517707">Bookings</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42473_2407877_2411537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PowerPoint characteristic that enables Windows to auto-scale edit mode based on per-monitor DPI but gives PowerPoint control over slide show rendering so that Windows does not auto-scale it.</descrip></descripGrp><ntig><termGrp><term id="2407877">Mixed DPI mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2411537">මුසු DPI ප්‍රකාරය</term><termNote type="geographicalUsage">LKA</termNote><termNote typ