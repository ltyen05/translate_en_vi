lUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40026_2326216_2328668"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Exchange Online Protection that delivers an email without its attachments, scans the attachments for viruses, and then reattaches the attachments to the mail in the inbox.</descrip></descripGrp><ntig><termGrp><term id="2326216">Dynamic Email Delivery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2328668">ගතික ඊමේල් බෙදාහැරීම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40027_2326225_2334530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to collect Word, PowerPoint, Excel, Office Mix, and PDF documents as well as sways and publish them on the website, docs.com, where others can view, download or share them or comment on them.</descrip></descripGrp><ntig><termGrp><term id="2326225">Docs.com</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2334530">Docs.com</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40030_2327887_2641161"><langSet xml:lang="en-US"><descripGrp><descri