782_2157429_2183878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides unending stream of music based not on the user's library, but on an artist or song selected by the user.</descrip></descripGrp><ntig><termGrp><term id="2157429">Radio</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2183878">ගුවන් විදුලිය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37784_2157431_2195025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interval of time that it takes to complete a circuit in a race or exercise course, which the user can record with a stopwatch.</descrip></descripGrp><ntig><termGrp><term id="2157431">lap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2195025">උකුළ</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37785_2157432_2195106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The total amount of time up to a given point that the user marks while using the stopwatch. After marking a split, the stopwatch continues running in the background.</descrip></descripGrp><ntig><termGrp><term id="2157432">split</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term 