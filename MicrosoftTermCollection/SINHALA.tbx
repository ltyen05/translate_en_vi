</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13099_375945_1801174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A typographical unit of measure that is equal to one sixth of an inch.</descrip></descripGrp><ntig><termGrp><term id="375945">pica</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1801174">පිකා</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1310_169918_1747612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unique, 25-character code on a prepaid card that adds computer use time to your prepaid computer or that pays for your subscription.</descrip></descripGrp><ntig><termGrp><term id="169918">prepaid card number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1747612">සංකේතය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1310_169918_2352252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unique, 25-character code on a prepaid card that adds computer use time to your prepaid computer or that pays for your subscription.</descrip></descripGrp><ntig><termGrp><term id="169918">prepaid card number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2352252">සලා