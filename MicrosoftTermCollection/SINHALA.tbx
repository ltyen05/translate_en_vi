4_1627809_1683370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filtering feature that monitors downloaded apps for malware or unknown reputation.</descrip></descripGrp><ntig><termGrp><term id="1627809">Windows SmartScreen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1683370">Windows SmartScreen</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31295_1598405_1640056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows that includes a set of maintenance tasks that run automatically when the user's PC is idle.</descrip></descripGrp><ntig><termGrp><term id="1598405">Automatic Maintenance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1640056">ස්වයංක්‍රීය නඩත්තුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31296_1598406_1689216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of BitLocker that enables IT pros to encrypt a disk before a user begins to use it.</descrip></descripGrp><ntig><termGrp><term id="1598406">BitLocker encrypted installation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1689216">BitLocker සංකේතක ස්ථාපනය</