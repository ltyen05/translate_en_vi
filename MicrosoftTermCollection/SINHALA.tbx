ech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635067">පරිවර්තකය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11919_251777_1370296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file containing information that the user either requires or will find informative and that might not have been included in the documentation. Readme files are placed on disk in plain-text form (without extraneous or program-specific characters) so that they can be read easily be a variety of word processing programs.</descrip></descripGrp><ntig><termGrp><term id="251777">readme file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1370296">README ගොනුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11919_251777_1370297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file containing information that the user either requires or will find informative and that might not have been included in the documentation. Readme files are placed on disk in plain-text form (without extraneous or program-specific characters) so that they can be read easily be a variety of word processing programs.</descrip></descripGrp><ntig><termGrp><term id="251777">readme file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si