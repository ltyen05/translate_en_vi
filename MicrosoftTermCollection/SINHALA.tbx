<termEntry id="12133_460782_1913300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office feature that allows users to create professional looking information graphics quickly and easily.</descrip></descripGrp><ntig><termGrp><term id="460782">SmartArt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913300">SmartArt</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12133_545625_1913300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office feature that allows users to create professional looking information graphics quickly and easily.</descrip></descripGrp><ntig><termGrp><term id="545625">SmartArt graphics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913300">SmartArt</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12141_56316_1913060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Two arrows in shape of a cross, with two heads each pointing in opposite directions.</descrip></descripGrp><ntig><termGrp><term id="56316">four-headed arrow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913060">හිස්-හතරක් ඇති ඊතලය</term><termNote type="geographicalUsage">LKA</termNote><termNote typ