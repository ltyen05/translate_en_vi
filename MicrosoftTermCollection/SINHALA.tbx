ographicalUsage">LKA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15327_219610_1462098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The control panel for Office (including the Tools Options dialog).</descrip></descripGrp><ntig><termGrp><term id="219610">Resources</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1462098">සම්පත්</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15335_104365_635153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To copy files from a backup storage device to their normal location, especially if the files are being copied to replace files that were accidentally lost or deleted.</descrip></descripGrp><ntig><termGrp><term id="104365">restore</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635153">පිළිනගන්න</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1534_94749_634186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key on IBM PC and compatible keyboards that normally causes the computer to send a character-based “picture” of the screen contents to the printer.</descrip></descripGrp><ntig><termGrp><term id="94749">PRINT SCREEN key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634186">PRINT SCREEN යතුර</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15350_134128_634985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for creating and manipulating text-based documents.</descrip></descripGrp><ntig><termGrp><term id="134128">word processor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634985">පද සකසුව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15359_234913_634540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual experience of the premium Windows Vista editions. Windows Aero builds on the Basic and Standard user experiences to offer customers our best-designed, highest-performing desktop environment. A noticeable element of the new Windows Aero experience is the professional-looking, transparent glass design, which creates an open, lightweight environment but more importantly enables users to focus on their content rather than the interface.</descrip></descripGrp><ntig><termGrp><term id="234913">Aero</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634540">Aero</term><termNote type