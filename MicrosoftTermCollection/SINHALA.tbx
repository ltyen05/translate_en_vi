lang="en-US"><descripGrp><descrip type="definition">A type of CD-ROM that can be written (only once) on a CD recorder and read on a CD-ROM drive.</descrip></descripGrp><ntig><termGrp><term id="136564">CD-R</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="634078">CD-R</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2905_136564_635515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of CD-ROM that can be written (only once) on a CD recorder and read on a CD-ROM drive.</descrip></descripGrp><ntig><termGrp><term id="136564">CD-R</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635515">ලේඛ්‍ය සංගත තැටිය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2908_38136_635843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of hardware devices, software packages, or a computer itself to work with network devices or with other hardware devices, software packages, or a computer over a network connection.</descrip></descripGrp><ntig><termGrp><term id="38136">connectivity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635843">සබඳතාව</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</