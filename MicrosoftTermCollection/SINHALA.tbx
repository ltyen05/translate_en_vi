ion">A group of computers that work together to provide a common set of services and present a single-system image to clients for the purpose of enhancing availability and scalability.</descrip></descripGrp><ntig><termGrp><term id="1177077">cluster network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2765917">පොකුර</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10784_33222_2765917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of computers that work together to provide a common set of services and present a single-system image to clients for the purpose of enhancing availability and scalability.</descrip></descripGrp><ntig><termGrp><term id="33222">cluster</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2765917">පොකුර</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10797_135645_635696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enlarge a selected portion of a graphical image or document to fill a window or the screen.</descrip></descripGrp><ntig><termGrp><term id="135645">zoom</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635696">විශාල කරන්න</term><termNote type="geographicalUs