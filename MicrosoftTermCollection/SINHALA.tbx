ographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32287_1647731_1913758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack where a malicious website makes an HTTP request to a target website in such a way that the website thinks that the request is part of a legitimate user’s session.</descrip></descripGrp><ntig><termGrp><term id="1647731">cross-site request forgery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913758">CSRF</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32287_1647732_1913757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack where a malicious website makes an HTTP request to a target website in such a way that the website thinks that the request is part of a legitimate user’s session.</descrip></descripGrp><ntig><termGrp><term id="1647732">CSRF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="1913757">අඩවිය-හරහා ඉල්ලීම් තැනීම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32287_1647732_1913758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack where a malicious website makes an HTTP re