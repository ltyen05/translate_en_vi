ed online journal or column.</descrip></descripGrp><ntig><termGrp><term id="210479">blog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635728">වෙබ් ලොගය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14319_210480_635244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A frequently updated online journal or column.</descrip></descripGrp><ntig><termGrp><term id="210480">web log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635244">බ්ලොගය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14319_210480_635728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A frequently updated online journal or column.</descrip></descripGrp><ntig><termGrp><term id="210480">web log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="635728">වෙබ් ලොගය</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14319_308302_635244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A frequently updated online journal or column.</descr