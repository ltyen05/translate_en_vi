eech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45819_2579515_2582332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Intelligence about current or potential attacks that threaten an organization.</descrip></descripGrp><ntig><termGrp><term id="2579515">cyber threat intelligence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2582332">සයිබර් තර්ජන වැටැහීම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45819_2626583_2582332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Intelligence about current or potential attacks that threaten an organization.</descrip></descripGrp><ntig><termGrp><term id="2626583">cyber intelligence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="si-LK"><ntig><termGrp><term id="2582332">සයිබර් තර්ජන වැටැහීම</term><termNote type="geographicalUsage">LKA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45819_2813435_2582332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Intelligence about current or potential attacks that threaten an organization.</descrip></descripGrp><ntig><termGrp><term id="2813435">threat intelligence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet