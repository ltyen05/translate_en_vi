">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2273_54119_2540148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of moving files from one repository or source to another, usually via automated scripts or programs.</descrip></descripGrp><ntig><termGrp><term id="54119">file migration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540148">filoverføring</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22734_1054764_1453107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that shows all of the resources on a project and their work over time. This makes it easy to rearrange work, schedule new work, and manage a team's load.</descrip></descripGrp><ntig><termGrp><term id="1054764">Team Planner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1453107">Gruppeplanleggjar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22735_1054767_1207532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the application of tags to individual Outlook items to specify retention policy for that message, conversation or other item.</descrip></descripGrp><ntig><termGrp><term id="1054767">Retention Policy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207532">Oppbevaringspolicy</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22771_1054905_1797231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user interface implemented by a software application via a component of a web server, such as IIS.</descrip></descripGrp><ntig><termGrp><term id="1054905">web portal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1797231">nettportal</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22781_1054938_1522323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To permit someone else to perform an action.</descrip></descripGrp><ntig><termGrp><term id="1054938">allow</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1522323">tillate</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2279_26594_630230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of software that functions as an electronic calendar used for scheduling.</descrip></descripGrp><ntig><termGrp><term id="26594">calendar program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630230">kalenderprogram</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2279_26594_631571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of software that functions as an electronic calendar used for scheduling.</descrip></descripGrp><ntig><termGrp><term id="26594">calendar program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631571">kalender</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2279_294450_630230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of software that functions as an electronic calendar used for scheduling.</descrip></descripGrp><ntig><termGrp><term id="294450">calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630230">kalenderprogram</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2279_294450_631571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of software that functions as an electronic calendar used for scheduling.</descrip></descripGrp><ntig><termGrp><term id="294450">calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631571">kalender</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22823_1055132_1207533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The navigation button used to return to recently visited Web pages in Internet Explorer, Microsoft Edge, and other internet browsers.</descrip></descripGrp><ntig><termGrp><term id="1055132">Back</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207533">Tilbake</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22826_1055147_1795053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A staging area that contains representations of selected objects and attributes in a connected data source.</descrip></descripGrp><ntig><termGrp><term id="1055147">connector space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1795053">koplingsområde</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22828_1055149_1796741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data store that is used by ILM to contain the aggregated identity information from multiple connected data sources, providing a single global, integrated view of all combined objects.</descrip></descripGrp><ntig><termGrp><term id="1055149">metaverse</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1796741">metavers</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2285_109836_1980692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A join in which records from a table are combined with other records from the same table when there are matching values in the joined fields. A self-join can be an inner join or an outer join. In database diagrams, a self-join is called a reflexive relationship.</descrip></descripGrp><ntig><termGrp><term id="109836">self-join</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980692">eigenkopling</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22865_1055946_1207534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that describes the current location of a computer. The location is entered manually in Default Location, and can be used by programs to determine the location of a computer when a location sensor is unavailable.</descrip></descripGrp><ntig><termGrp><term id="1055946">default location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207534">standardplassering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22886_1056046_1797095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software system that retrieves information from a source data store and synchronizes (pushes) to a target data store. Examples of synchronization engines are the ILM 2007 and FIM 2010 synchronization engines, and the service that synchronizes data rows in the SQL Server Express database with objects in the Microsoft Office Outlook data store.</descrip></descripGrp><ntig><termGrp><term id="1056046">synchronization engine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1797095">synkroniseringsmotor</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22886_1056047_1797095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software system that retrieves information from a source data store and synchronizes (pushes) to a target data store. Examples of synchronization engines are the ILM 2007 and FIM 2010 synchronization engines, and the service that synchronizes data rows in the SQL Server Express database with objects in the Microsoft Office Outlook data store.</descrip></descripGrp><ntig><termGrp><term id="1056047">SyncEngine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1797095">synkroniseringsmotor</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22889_1056052_1796938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To refuse to accept a file or message.</descrip></descripGrp><ntig><termGrp><term id="1056052">reject</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1796938">avvise</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2290_103825_630778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Generally, any part of a computer system or network, such as a disk drive, printer, or memory, that can be allotted to a running program or a process.</descrip></descripGrp><ntig><termGrp><term id="103825">resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630778">ressurs</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22904_1056071_1795026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of components and services that enable users to access their Exchange mailboxes through the Outlook Web Access application.</descrip></descripGrp><ntig><termGrp><term id="1056071">Client Access server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1795026">klienttilgangstenar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2291_184207_1980841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The hierarchical HTML tag structure of an opened HTML document that appears in a task pane window.</descrip></descripGrp><ntig><termGrp><term id="184207">tag tree</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980841">kodetre</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22911_1056204_1207535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A term that can be added to a search to filter the results by a specific property (for example, by author). Relevant search filters appear under the search box in any open folder.</descrip></descripGrp><ntig><termGrp><term id="1056204">search filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207535">søkjefilter</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22919_1056243_1794943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of Internet Protocol subnets, usually used to connect a group of computers that are physically close to each other.</descrip></descripGrp><ntig><termGrp><term id="1056243">Active Directory site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1794943">Active Directory-område</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22926_1056255_1794934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of sign-in credentials (username and password) for an Active Directory account.</descrip></descripGrp><ntig><termGrp><term id="1056255">Active Directory credentials</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1794934">Active Directory-legitimasjon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22928_1056257_1794917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The identity of a user, which can be used to grant access to resources or authority to perform certain tasks.</descrip></descripGrp><ntig><termGrp><term id="1056257">Active Directory account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1794917">Active Directory-konto</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2293_79701_630636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rectangular bar displayed in an application's window, often at the top, from which menus can be selected by the user.</descrip></descripGrp><ntig><termGrp><term id="79701">menu bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630636">menyline</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22931_1056336_1207536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of corruption that affects the data in the Windows heap, such as damages caused by a buffer overrun, writing to a stray pointer or a double-free.</descrip></descripGrp><ntig><termGrp><term id="1056336">heap corruption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207536">heap-øydelegging</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22944_1056351_1207537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A soft keyboard that is displayed with a different set of settings by default (larger buttons, bigger size, etc.) when you launch the Tablet PC Input Panel with touch. This is to facilitate touch input.</descrip></descripGrp><ntig><termGrp><term id="1056351">touch keyboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207537">peiketastatur</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22951_1056450_1207538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A two-way device provided by a cable provider that enables some one-way digital CableCARD-based consumer electronic devices such as high-definition DVRs and Media Center PCs to access digital cable channels delivered using switched digital video.</descrip></descripGrp><ntig><termGrp><term id="1056450">tuning adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207538">tuningadapter</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22951_1056452_1207538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A two-way device provided by a cable provider that enables some one-way digital CableCARD-based consumer electronic devices such as high-definition DVRs and Media Center PCs to access digital cable channels delivered using switched digital video.</descrip></descripGrp><ntig><termGrp><term id="1056452">TA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207538">tuningadapter</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22975_1056711_1995293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small, affordable laptop that is designed to perform a limited number of tasks such as web browsing and email.</descrip></descripGrp><ntig><termGrp><term id="1056711">netbook</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1995293">nett-PC</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22975_1099729_1995293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small, affordable laptop that is designed to perform a limited number of tasks such as web browsing and email.</descrip></descripGrp><ntig><termGrp><term id="1099729">small notebook PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1995293">nett-PC</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2299_232415_631293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that appears at a specified interval before an appointment, meeting, or task that announces when the activity is set to occur.</descrip></descripGrp><ntig><termGrp><term id="232415">reminder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631293">påminning</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22992_1056886_1207539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A real-time, physical action applied to an object, in which multiple contact points are used simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1056886">multitouch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207539">fleirfinger-</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22992_1056887_1207539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A real-time, physical action applied to an object, in which multiple contact points are used simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1056887">multi-touch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207539">fleirfinger-</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2301_314116_631699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount that is the difference between the sum of debit entries and the sum of credit entries entered into an account during a financial period.</descrip></descripGrp><ntig><termGrp><term id="314116">account balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631699">saldo</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2301_616949_631699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount that is the difference between the sum of debit entries and the sum of credit entries entered into an account during a financial period.</descrip></descripGrp><ntig><termGrp><term id="616949">balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631699">saldo</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23043_1057319_1207540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used to write CD-ROMs. Because a disc can be written only once on these machines, they are used most commonly to create CD-ROMs for data archives or to produce CD-ROM masters that can be duplicated for mass distribution.</descrip></descripGrp><ntig><termGrp><term id="1057319">CD recorder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207540">CD-brennar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23043_1057320_1207540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used to write CD-ROMs. Because a disc can be written only once on these machines, they are used most commonly to create CD-ROMs for data archives or to produce CD-ROM masters that can be duplicated for mass distribution.</descrip></descripGrp><ntig><termGrp><term id="1057320">CD burner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207540">CD-brennar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2306_210486_1980913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The formal name for Word 12 file format. This format has an open, royalty-free specification, and is the technology licensed to external parties. This license is the subject in the messaging points where “Open, royalty-free license” is discussed.</descrip></descripGrp><ntig><termGrp><term id="210486">Word XML Format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980913">Word XML-format</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23092_1058116_1207541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that ensures that all components of a file are preserved, even if they are supported only by the rich client and not viewable in Web Companions.</descrip></descripGrp><ntig><termGrp><term id="1058116">Document Integrity</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207541">Dokumentintegritet</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2312_40249_228031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A signature of an existing signature and message or a signature of an existing signature. A countersignature is used to sign the encrypted hash of an existing signature or to time stamp a message.</descrip></descripGrp><ntig><termGrp><term id="40249">countersignature</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><