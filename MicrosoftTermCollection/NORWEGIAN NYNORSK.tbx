</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53255_3033556_3033613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in the Authenticator app and Edge that allows users to update their password on a website with one click.</descrip></descripGrp><ntig><termGrp><term id="3033556">easy update</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="3033613">enkel oppdatering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53256_3033563_3033608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The bundle of Teams Phone + Microsoft Teams Calling Plans.</descrip></descripGrp><ntig><termGrp><term id="3033563">Microsoft Teams Phone with Calling Plan</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="3033608">Microsoft Teams telefon med samtaleplan</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53257_3033564_3033605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The lightweight Android app that delivers the best of Outlook in a small download size and is optimized for low resource utilization (low-end devices).</descrip></descripGrp><ntig><ter