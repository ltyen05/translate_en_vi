ain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1797097">tertiært domene</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14295_207687_228073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The result of a one-way hash function that takes a variable-length input string and converts it to a fixed-length output string. This fixed-length output string is probabilistically unique for every different input string and thus can act as a fingerprint of a file. It can be used to determine whether a file was tampered with.</descrip></descripGrp><ntig><termGrp><term id="207687">cryptographic digest</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="228073">kryptografisk samandrag</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1430_174143_2545592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of recording an audit entry in the audit trail whenever certain events occur, such as services starting and stopping or users logging on and off and accessing resources.</descrip></descripGrp><ntig><termGrp><term id="174143">event logging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2545592">hendingslogging</term><termNote type=