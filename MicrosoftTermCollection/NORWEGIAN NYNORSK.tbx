31235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file and folder structure that contains the necessary files and/or configuration settings that control the preinstallation process and define the manufacturers' custom information.</descrip></descripGrp><ntig><termGrp><term id="211444">configuration set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631235">konfigurasjonssett</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11900_211445_631235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file and folder structure that contains the necessary files and/or configuration settings that control the preinstallation process and define the manufacturers' custom information.</descrip></descripGrp><ntig><termGrp><term id="211445">config set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631235">konfigurasjonssett</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11902_262727_631488"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that identifies people using computers near you so that you can use features and programs that use peer-to-peer technology.</descrip></descripGrp><ntig><termGrp><term id="262727">People Near Me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</te