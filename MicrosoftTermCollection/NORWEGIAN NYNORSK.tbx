fies as a bulk order is set by individual companies.</descrip></descripGrp><ntig><termGrp><term id="178508">bulk order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540275">storordre</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15386_154964_631098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A delay of the amount of time that elapses before a character begins repeating when you hold down a key.</descrip></descripGrp><ntig><termGrp><term id="154964">repeat delay</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631098">repetisjonsforseinking</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15394_179004_2540319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a record that has not received a rating.</descrip></descripGrp><ntig><termGrp><term id="179004">unrated</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540319">ikkje vurdert</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15396_148352_1207310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">E-mail accounts and folders that you can group and set common options for, such as whether to download headers or messages, size limits on downloaded messages, behavior online vs. offline, and time interval for connecting to the server.</descrip></descripGrp><ntig><termGrp><term id="148352">Send/Receive group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207310">gruppe for sending/mottak</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="154_543576_1207116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the Administrators group on the local server computer.</descrip></descripGrp><ntig><termGrp><term id="543576">server administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207116">tenaradministrator</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1541_216886_232072"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A binary representation of the objects and properties declared in an Extensible Application Markup Language (XAML) file.</descrip></descripGrp><ntig><termGrp><term id="216886">BAML</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet>