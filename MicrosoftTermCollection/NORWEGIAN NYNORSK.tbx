ly to the device.</descrip></descripGrp><ntig><termGrp><term id="2427919">Xbox One Stereo Headset</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2922194">Xbox One Stereo Headset</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42790_2427922_2922195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Brand name for the stereo headset adapter for Xbox One.</descrip></descripGrp><ntig><termGrp><term id="2427922">Xbox One Stereo Headset Adapter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2922195">Xbox One Stereo Headset-adapter</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42792_2427928_2918560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A community-created place for like-minded people to play, share, and communicate on Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="2427928">club</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2918560">klubb</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42793_2427931_2921368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online system to help like-minded people find each other, get into parties, and accomplish common goals in their favorite games on Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="2427931">Looking for Group</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921368">Leitar etter gruppe</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4281_88221_2480599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To explicitly decline to participate.</descrip></descripGrp><ntig><termGrp><term id="88221">opt out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2480599">velje bort</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4282_147657_1980798"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Placement of an element in the natural HTML flow of a document, but such that its position is offset from the preceding content.</descrip></descripGrp><ntig><termGrp><term id="147657">relative positioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980798">relativ plassering</term><termNote 