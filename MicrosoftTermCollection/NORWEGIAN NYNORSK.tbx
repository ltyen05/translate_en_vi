erm id="2368392">Outlook Mail and Calendar Accounts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2371674">Outlook E-post- og Kalender-kontoar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37885_2368392_2540494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The two Microsoft apps that allow users to send and receive mail, as well as manage events.</descrip></descripGrp><ntig><termGrp><term id="2368392">Outlook Mail and Calendar Accounts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540494">Outlook E-post og Outlook Kalender</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37887_2168872_2172128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI element in Outlook that shows options that allows users to broaden or narrow email searches.</descrip></descripGrp><ntig><termGrp><term id="2168872">Search refiner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2172128">Søkjepresisering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37889_2168877_2172123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of authentication mechanisms which includes authenticating users with both on-premises and cloud-hosted Office services, single sign-on authentication (including against third party identity providers) so that passwords are not sent directly to Office 365, and multi-factor authentication.</descrip></descripGrp><ntig><termGrp><term id="2168877">modern authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2172123">moderne godkjenning</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3789_90732_630706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of query that, when you run it, prompts for values (criteria) to use to select the records for the result set so that the same query can be used to retrieve different result sets.</descrip></descripGrp><ntig><termGrp><term id="90732">parameter query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630706">parameterspørjing</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37890_2168878_2323634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API that enables developers to create, read, update, and delete objects and relationships between them in an Office graph.</descrip></descripGrp><ntig><termGrp><term id="2168878">Office Graph API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2323634">Office Graph-API</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="379_102150_1522372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Not in the immediate vicinity, as a computer or other device located in another place (room, building, or city) and accessible through some type of cable or communications link.</descrip></descripGrp><ntig><termGrp><term id="102150">remote</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1522372">fjern</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="379_764630_1522372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Not in the immediate vicinity, as a computer or other device located in another place (room, building, or city) and accessible through some type of cable or communications link.</descrip></descripGrp><ntig><termGrp><term id="764630">distant</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1522372">fjern</term><termNote type="geographicalUsage">NOR<