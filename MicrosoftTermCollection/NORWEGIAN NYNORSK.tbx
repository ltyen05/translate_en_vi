Note type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50521_2860780_3020728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Shadow Stack security feature that prevents a class of vulnerabilities known as Return-Oriented Programming (ROP) and requires hardware in order to work.</descrip></descripGrp><ntig><termGrp><term id="2860780">hardware-enforced stack protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="3020728">HSP</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50521_3019770_2861409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Shadow Stack security feature that prevents a class of vulnerabilities known as Return-Oriented Programming (ROP) and requires hardware in order to work.</descrip></descripGrp><ntig><termGrp><term id="3019770">HSP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2861409">maskinvarehandheva vern av stakk</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50521_3019770_3020728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Shadow Stack security feature that prevents a class of vulnerabilities known as Return-Oriented Programming (ROP) and requires hardware in order to work.</descrip></descripGrp><ntig><termGrp