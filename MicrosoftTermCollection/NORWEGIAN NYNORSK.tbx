ged by few people to broadcast information out to a broad audience.</descrip></descripGrp><ntig><termGrp><term id="2608792">communication site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2610226">kommunikasjonsområde</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46330_2609539_2663814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that enables Cortana to take over your mouse pointer and literally show you how to change a setting when you ask her to "show me (how to do something)." She performs each step for you in a sequence of clicks needed to make a particular change in Windows Settings.</descrip></descripGrp><ntig><termGrp><term id="2609539">Cortana Show Me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2663814">Cortana Show Me</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46337_2609835_2785872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To plan an event for a specific time slot.</descrip></descripGrp><ntig><termGrp><term id="2609835">schedule</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2785872">planleggje</term><termNote type="geographicalUsage">NOR</termNote><termNo