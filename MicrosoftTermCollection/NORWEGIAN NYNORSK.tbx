ig><termGrp><term id="334551">caller ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2793678">oppringjaridentifikasjon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2065_80862_630641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An installation where only the necessary components are installed on a system.</descrip></descripGrp><ntig><termGrp><term id="80862">minimum installation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630641">minimumsinstallasjon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20653_730882_1780394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder that stores the user's graphics, e.g. digital pictures. Many graphic design and photo-editing programs use this location by default to open or save graphic files.</descrip></descripGrp><ntig><termGrp><term id="730882">Pictures</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1780394">Bilete</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig>