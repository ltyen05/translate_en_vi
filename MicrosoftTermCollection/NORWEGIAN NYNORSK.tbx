 xml:lang="en-US"><descripGrp><descrip type="definition">The desktop-only sync app for OneDrive that enables on-demand file sharing and navigation in File Explorer and that comes pre-installed on PCs.</descrip></descripGrp><ntig><termGrp><term id="2834959">Microsoft OneDrive sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2835796">Microsoft OneDrive-synkronisering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46344_2834960_2835795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The desktop-only sync app for OneDrive that enables on-demand file sharing and navigation in File Explorer and that comes pre-installed on PCs.</descrip></descripGrp><ntig><termGrp><term id="2834960">OneDrive sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2835795">OneDrive-synkronisering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46344_2834960_2835796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The desktop-only sync app for OneDrive that enables on-demand file sharing and navigation in File Explorer and that comes pre-installed on PCs.</descrip></descripGrp><ntig><termGrp><term id="2834960">OneDrive sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGr