<descrip type="definition">To enter information by means of the keyboard or other input method.</descrip></descripGrp><ntig><termGrp><term id="1088724">enter</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207558">skrive inn</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23621_1088739_1981342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that performs reverse number lookup on one-number calls and then routes the call over an IP connection to the public switched telephone network (PSTN) gateway that is nearest to the location of the destination phone number.</descrip></descripGrp><ntig><termGrp><term id="1088739">least-cost routing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981342">mest rimelege oppkopling</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23621_1088740_1981342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that performs reverse number lookup on one-number calls and then routes the call over an IP connection to the public switched telephone network (PSTN) gateway that is nearest to the location of the destination phone number.</descrip></descripGrp><ntig><termGrp><term id="1088740">LCR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></n