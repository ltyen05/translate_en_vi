t xml:lang="nn-NO"><ntig><termGrp><term id="1981230">fråværsmelding</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20857_748252_1794999"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An auto-reply text specified using Outlook's Automatic Replies or Out of Office Assistant.</descrip></descripGrp><ntig><termGrp><term id="748252">Out of Office message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1794999">automatisk svar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20857_748252_1981230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An auto-reply text specified using Outlook's Automatic Replies or Out of Office Assistant.</descrip></descripGrp><ntig><termGrp><term id="748252">Out of Office message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981230">fråværsmelding</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20858_748253_1981231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that merges public switched telephone network (PSTN) and Voice over IP (VoIP) conferences, which allows participants to dial in to a conference from anywhere as an authenticated user without having to be on the corporate network. Typically, a local number is provided to avoid long-distance fees.</descrip></descripGrp><ntig><termGrp><term id="748253">dial-in conferencing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981231">innringingskonferanse</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20859_748260_1981232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An internally or externally hosted service for users to host multiparty conferences from their computers.</descrip></descripGrp><ntig><termGrp><term id="748260">conferencing service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981232">konferanseteneste</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2086_107717_630788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A definition of the structure of a particular type of data, which includes a definition of the allowed attributes and allowed relationships with other objects.</descrip></descripGrp><ntig><termGrp><term id="107717">schema</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630788">skjema</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20861_748512_1207402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to apply custom or default markers to items (e.g. Outlook messages or OneNote content) in order to categorize information for easy retrieval and sorting.</descrip></descripGrp><ntig><termGrp><term id="748512">Tags</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207402">Merke</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20861_748512_1207403"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to apply custom or default markers to items (e.g. Outlook messages or OneNote content) in order to categorize information for easy retrieval and sorting.</descrip></descripGrp><ntig><termGrp><term id="748512">Tags</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207403">Kategoriar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20861_748513_1207402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to apply custom or default markers to items (e.g. Outlook messages or OneNote content) in order to categorize information for easy retrieval and sorting.</descrip></descripGrp><ntig><termGrp><term id="748513">Categories</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207402">Merke</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20861_748513_1207403"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to apply custom or default markers to items (e.g. Outlook messages or OneNote content) in order to categorize information for easy retrieval and sorting.</descrip></descripGrp><ntig><termGrp><term id="748513">Categories</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207403">Kategoriar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20867_2676671_2677850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows the user to fill cells with data that follows a pattern or that is based on data in other cells.</descrip></descripGrp><ntig><termGrp><term id="2676671">AutoFill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2677850">Autofyll</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20867_752822_2677850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows the user to fill cells with data that follows a pattern or that is based on data in other cells.</descrip></descripGrp><ntig><termGrp><term id="752822">Auto Fill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2677850">Autofyll</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2087_22056_1980636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page where there is no information displayed</descrip></descripGrp><ntig><termGrp><term id="22056">blank page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980636">tom side</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20874_757176_1981235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool used to turn on language-specific options for the languages one wants to use with a product.</descrip></descripGrp><ntig><termGrp><term id="757176">Language Settings tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981235">verktøy for språkinnstillingar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20883_759067_1797099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of creating and sending text messages between or to mobile phones and devices using the SMS protocol.</descrip></descripGrp><ntig><termGrp><term id="759067">text messaging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1797099">tekstmeldingar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20884_759071_1207404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any hardware or software that can detect events or environmental changes, such as your current location or the amount of light around your computer. For example, a notebook with a location sensor, such as a Global Positioning System (GPS) receiver, can determine your exact location. An ambient light sensor can detect when there is a change in lighting, and then a program can use that information to adjust the brightness of your screen.</descrip></descripGrp><ntig><termGrp><term id="759071">sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207404">sensor</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20888_759108_1207405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that includes an antenna, a radio receiver, and a processor for use with the worldwide GPS (Global Positioning System). A GPS receiver uses position and time information from four GPS satellites to calculate precise information about its current location, its speed of travel, and the current time.</descrip></descripGrp><ntig><termGrp><term id="759108">GPS receiver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207405">GPS-mottakar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20889_759109_1207406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that can detect the current location of your computer.</descrip></descripGrp><ntig><termGrp><term id="759109">location sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207406">plasseringssensor</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20894_759503_1207407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Technologies that measure and analyze physical and behavioral human characteristics, such as fingerprints, eye retinas and irises, voice patterns, facial patterns, hand measurements, typing patterns and signatures, to recognize or authenticate identity.</descrip></descripGrp><ntig><termGrp><term id="759503">biometrics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207407">biometri</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20907_759640_1207408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area within the Windows Control Panel that provides support for sensors such as enabling, disabling or uninstalling sensors and sensor-enabled applications, changing sensor settings, etc.</descrip></descripGrp><ntig><termGrp><term id="759640">Location and Other Sensors</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207408">Sensorar for plassering og anna</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20908_759641_1207409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A light sensor that tracks light in the surroundings and therefore the amount of backlight needed for the LCD screen to be adjusted accordingly.</descrip></descripGrp><ntig><termGrp><term id="759641">ambient light sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207409">omgivnadslyssensor</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2091_50057_630434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of information within a markup language that is defined by a tag, or a pair of tags surrounding some content, and includes any attributes defined within the initial tag.</descrip></descripGrp><ntig><termGrp><term id="50057">element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630434">element</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20910_759643_1207410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A package of market-specific content delivered in Windows for 20 target markets. A Local Pack contains market-customized themes (wallpapers, sound schemes, etc.) and locally flavored Internet Explorer favorites and RSS feeds.</descrip></descripGrp><ntig><termGrp><term id="759643">Local Pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207410">lokalpakke</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20915_759738_1207411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area within the Windows Control Panel that allows the user to designate his home coordinates or address for location-aware functionalities.</descrip></descripGrp><ntig><termGrp><term id="759738">Default Location</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207411">Standardplassering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20916_759739_1207412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An arrangement of search results ordered by relevance using a special search algorithm.</descrip></descripGrp><ntig><termGrp><term id="759739">top results</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207412">toppresultat</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20918_759888_1207413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A framework that provides a single point for IT professionals and OEMs to service and maintain Windows images offline through a scriptable command line utility and an easily extensible infrastructure.</descrip></descripGrp><ntig><termGrp><term id="759888">Deployment Image Servicing and Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="gramma