/termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1763609">Reknearkgransking</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32457_1680739_1763608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Office product that detects and categorizes changes between two spreadsheets to facilitate review and approval processes.</descrip></descripGrp><ntig><termGrp><term id="1680739">Spreadsheet Compare</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1763608">Reknearksamanlikning</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32458_1680740_1762649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Office product that detects and categorizes changes between two databases to facilitate review and approval processes.</descrip></descripGrp><ntig><termGrp><term id="1680740">Database Compare</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1762649">Databasesamanlikning</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32459_1680741_1762542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Office product that provides non-intrusive auditing of changes made to Excel spreadsheets and Access databases, and supports alerts, notifications and automatic workflows based on user activities such as macro or formula changes.</descrip></descripGrp><ntig><termGrp><term id="1680741">Audit and Control Management Server</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1762542">Tenar for revisjons- og kontrollhandsaming</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32464_1681335_1981555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Denotes the experience with Lync that can be scheduled, or ad-hoc. A Lync Meeting provides the ability to interact with people through video, audio, instant messaging, and content sharing.</descrip></descripGrp><ntig><termGrp><term id="1681335">Lync Meeting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981555">Lync-møte</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32466_1681337_1981556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Alerts to Lync users about the quality of the network, computer, camera, and lighting conditions.</descrip></descripGrp><ntig><termGrp><term id="1681337">video quality notifications</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981556">varsel om videokvalitet</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32468_1681339_1981557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that lets users create and share OneNote meeting notes in a Lync Meeting. Notes appear as docked in a Lync Meeting, with participant lists that can be updated in meeting notes for participants to see.</descrip></descripGrp><ntig><termGrp><term id="1681339">OneNote share</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981557">OneNote-deling</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32470_1681341_1981559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video preview for a Lync user that provides options to answer with video from within the notification.</descrip></descripGrp><ntig><termGrp><term id="1681341">personal preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981559">personleg førehandsvising</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32471_1681352_1686171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web browser component of Windows that provides a traditional and familiar browsing experience.</descrip></descripGrp><ntig><termGrp><term id="1681352">Internet Explorer for the desktop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1686171">Internet Explorer for PC</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32472_1681353_1686169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The touch-optimized, immersive web browser for Windows.</descrip></descripGrp><ntig><termGrp><term id="1681353">Internet Explorer 10</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1686169">Internet Explorer 10</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32485_1681572_1981560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of Lync Meeting host and presenter controls that optimizes for the type of meeting, size of audience, content, and/or video sources available to participants.</descrip></descripGrp><ntig><termGrp><term id="1681572">enhanced presenter controls</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981560">utvida kontrollar for konferansestyrar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32486_1681573_1981561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Denotes the Conversation window that handles escalations (peer-to-peer to conference) and scalable views that display people and content together inside a Lync Meeting.</descrip></descripGrp><ntig><termGrp><term id="1681573">Lync Meeting window</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981561">møtevindauge i Lync</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32488_1681575_1981562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of chat in which messages are posted to a chat room where they can be viewed and responded to in real time by multiple participants. Users can search for other rooms by name, member/owner, keywords, and content across groups from Lync.</descrip></descripGrp><ntig><termGrp><term id="1681575">persistent chat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981562">vedvarande chat</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32489_1681576_1981563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu bar that appears beside the picture area of a contact in the Lync Contacts list that shows the available communication modes: IM, Call, Video, and View card.</descrip></descripGrp><ntig><termGrp><term id="1681576">Quick Lync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981563">Lync-hurtigmeny</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3249_141555_2540230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A named attribute of a control, form, report, data access page, or section you use to respond to an associated event.</descrip></descripGrp><ntig><termGrp><term id="141555">event property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540230">hendingseigenskap</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32493_1681585_1981564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Gives Lync system administrators the ability to monitor pools, servers, and networks across data centers through the public Internet.</descrip></descripGrp><ntig><termGrp><term id="1681585">active monitoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSe