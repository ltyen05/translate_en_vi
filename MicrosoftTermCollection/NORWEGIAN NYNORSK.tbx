59_2864600"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A daily personalized email sent by Cortana to Office 365 users containing tasks and commitments made by the user, a summary of the user's meetings, and relevant documents for the user's day, all using information extracted from the user's Office 365 messages.</descrip></descripGrp><ntig><termGrp><term id="2864259">Cortana Briefing email</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2864600">orienterings-e-post frå Cortana</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50578_2864897_2865730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that protects sensitive information on disk and makes it inaccessible to attackers when the device is locked using encryption keys that are temporarily wiped from the device and only made available when the device is unlocked.</descrip></descripGrp><ntig><termGrp><term id="2864897">personal information encryption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2865730">kryptering av personleg informasjon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50578_2864898_2865730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that protects sensitive information on disk and makes it inaccessible to attackers when the device is locked using encryption keys that are temporarily wiped from the device and only made available when the device is unlocked.</descrip></descripGrp><ntig><termGrp><term id="2864898">Data Protection under Lock</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2865730">kryptering av personleg informasjon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50578_2864899_2865730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that protects sensitive information on disk and makes it inaccessible to attackers when the device is locked using encryption keys that are temporarily wiped from the device and only made available when the device is unlocked.</descrip></descripGrp><ntig><termGrp><term id="2864899">DPL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2865730">kryptering av personleg informasjon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50579_2864948_2865732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option in Microsoft Photos that allows the user to adjust the brightest part of a photo to be either darker or brighter.</descrip></descripGrp><ntig><termGrp><term id="2864948">Highlights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2865732">Høglys</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50591_2865796_2865969"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A headless app in the Microsoft Store that contains OpenGL and OpenCL API mapping layers on top of DirectX 12 that enable OpenCL and OpenGL apps to run with GPU acceleration in environments where there is no IHV OpenCL or OpenGL driver (for example, on Windows 10 ARM-based PCs).</descrip></descripGrp><ntig><termGrp><term id="2865796">OpenCL™ and OpenGL® Compatibility Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2865969">kompatibilitetspakke for OpenCL™ og OpenGL®</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5060_129154_630902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In relational database management systems, a logical table created through the specification of one or more relational operations on one or more tables. A view is equivalent to a divided relation in the relational model.</descrip></descripGrp><ntig><termGrp><term id="129154">view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630902">vising</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50604_2866253_2866616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who has high business impact or access to sensitive information, so they get additional mail flow or security monitoring.</descrip></descripGrp><ntig><termGrp><term id="2866253">priority user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2866616">prioritert brukar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50607_2866400_2866619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The search function in Microsoft Edge that lets users select text or images on web pages, then open the right-click context menu to search and view results in a sidebar to the right of the browser tab while keeping the current website visible.</descrip></descripGrp><ntig><termGrp><term id="2866400">sidebar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2866619">sidepanel</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50666_2867744_2868271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option in Microsoft Edge in which a customer can copy a URL and paste as a visual link, which provides a card with a key image and title, as well as additional information from the page where available.</descrip></descripGrp><ntig><termGrp><term id="2867744">web preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2868271">førehandsvising av nettside</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50670_2868303_2869997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web script that is placed on an openly accessible web server to allow an adversary to use the web server as a gateway into a network.</descrip></descripGrp><ntig><termGrp><term id="2868303">web shell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2869997">nettskal</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50672_2868545_2870949"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Two apps that are grouped together by the customer, so both apps open at the same time.​</descrip></descripGrp><ntig><termGrp><term id="2868545">app group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2870949">appgruppe</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50673_2868546_2870950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enlarge an app on a dual-screen device so that it goes across both screens.</descrip></descripGrp><ntig><termGrp><term id="2868546">maximize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2870950">maksimere</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50674_2868547_2870952"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reorient a dual-screen device that is folded in order to see the other screen.</descrip></descripGrp><ntig><termGrp><term id="2868547">flip</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2870952">vende</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50675_2868548_2870953"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move one screen of a dual-screen device backward.</descrip></descripGrp><ntig><termGrp><term id="2868548">fold</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2870953">brette</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50679_2868550_2870959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that has been designed specifically for dual-screen devices.</descrip></descripGrp><ntig><termGrp><term id="2868550">Dual-screen enhanced app</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2870959">app utforma for to skjermar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50681_2868552_2870961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The hinge that holds the two screens together on the Surface Duo dual-screen device.</descrip></descripGrp><ntig><termGrp><term id="2868552">Dynamic 360° Hinge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2870961">Dynamic 360° Hinge</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5069_160054_631123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for converting a color in one color space to another color space. Typically, this conversion is from YUV colors from a video source to RGB for display.</descrip></descripGrp><ntig><termGrp><term id="160054">color-space conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631123">fargeområdekonvertering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5069_210048_631123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for converting a color in one color space to another color space. Typically, this conversion is from YUV colors from a video source to RGB for display.</descrip></descripGrp><ntig><termGrp><term id="210048">color space conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631123">fargeområdekonvertering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5070_346942_631927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To provide or give.</descrip></descripGrp><ntig><termGrp><term id="346942">deliver</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631927">levere</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50705_2870079_2870511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office servicing option in which new features are made available for previewing before they are released in Current Channel.</descrip></descripGrp><ntig><termGrp><term id="2870079">Current Channel (Preview)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2870511">Oppdatert kanal (førehandsvising)</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50706_2870080_2870517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office servicing option in which new features are made available for installation once a month, on the 2nd Tuesday of the month.</descrip></descripGrp><ntig><termGrp><term id="2870080">Monthly Enterprise Channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2870517">Månadskanal for verksemder</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50707_2870081_2870521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office servicing option in which new features are made available for previewing four months before they are released in Semi-Annual Enterprise Channel.</descrip></descripGrp><ntig><termGrp><term id="2870081">Semi-Annual Enterprise Channel (Preview)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2870521">Halvårskanal for verksemder (førehandsvising)</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50708_2870082_2870519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office servicing option in which new features are made available for installation twice a year, on the 2nd Tuesday in January and July.</descrip></descripGrp><ntig><termGrp><term id="2870082">Semi-Annual Enterprise Channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2870519">Halvårskanal for verksemder</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5071_119170_630854"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character used to align lines and columns on screen and in print. Although a tab is visually indistinguishable from a series of blank spaces in most programs, the tab character and the space character are different to a computer. A tab is a single character and therefore can be added, deleted, or overtyped with a single keystroke.</descrip></descripGrp><ntig><termGrp><term id="119170">tab character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630854">tabulatorteikn</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50713_2870703_2871432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team type in Microsoft Teams for Education that allows teachers and students to collaborate on group projects, assignments, and more.</descrip></descripGrp><ntig><termGrp><term id="2870703">Class Team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2871432">klasse</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50713_2870703_2871434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team type in Microsoft Teams for Education that allows teachers and students to collaborate on group projects, assignments, and more.</descrip></descripGrp><ntig><termGrp><term id="2870703">Class Team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2871434">klasseteam</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50713_2870704_2871432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team type in Microsoft Teams for Education that allows teachers and students to collaborate on group projects, assignments, and more.</descrip></descripGrp><ntig><termGrp><term id="2870704">Class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2871432">klasse</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50713_2870704_2871434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team type in Microsoft Teams for Education that allows teachers and students to collaborate on group projects, assignments, and more.</descrip></descripGrp><ntig><termGrp><term id="2870704">Class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2871434">klasseteam</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50714_2870705_2871435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team type in Microsoft Teams for Education for groups of educators who meet regularly to share expertise and work collaboratively to improve teaching skills and the academic performance of students.</descrip></descripGrp><ntig><termGrp><term id="2870705">Professional Learning Community</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2871435">Profesjonelt læringsfellesskap</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50714_2870706_2871435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team type in Microsoft Teams for Education for groups of educators who meet regularly to share expertise and work collaboratively to improve teaching skills and the academic performance of students.</descrip></descripGrp><ntig><termGrp><term id="2870706">PLC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2871435">Profesjonelt læringsfellesskap</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50717_2870996_2871430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Descriptive phrasing to be used when an app or accessory is compatible with Windows.</descrip></descripGrp><ntig><termGrp><term id="2870996">works with Windows</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2871430">verkar saman med Windows</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5072_138277_630971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a shared file, information that is maintained about changes made in past editing sessions. The information includes the name of the person who made each change, when the change was made, and what data was changed.</descrip></descripGrp><ntig><termGrp><term id="138277">change history</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630971">endringslogg</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5074_307449_2732417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A normalized value assigned to an email message that indicates, based on the characteristics of the message, the likelihood that the message is spam and that is persisted with the message when the message is sent to other Exchange servers.</descrip></descripGrp><ntig><termGrp><term id="307449">spam confidence level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2732417">konfidensnivå for søppelpost</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5074_307468_2732417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A normalized value assigned to an email message that indicates, based on the characteristics of the message, the likelihood that the message is spam and that is persisted with the message when the message is sent to other Exchange servers.</descrip></descripGrp><ntig><termGrp><term id="307468">SCL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2732417">konfidensnivå for søppelpost</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50751_2871535_2873167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft tool designed to help developers discover, install, upgrade, remove, and configure their Windows tools.</descrip></descripGrp><ntig><termGrp><term id="2871535">Windows Package Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2873167">Pakkehandsaming for Windows</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50752_2871540_2873166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The command line that developers use to retrieve the specified window's unique ID, process ID, process name, or a list of its controls.</descrip></descripGrp><ntig><termGrp><term id="2871540">WinGet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2873166">WinGet</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50756_2873197_2873635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The release channel for early adopters and developers in which client builds are available to the subscriber early in the development cycle with the newest code, which is typically weekly or bi-weekly.</descrip></descripGrp><ntig><termGrp><term id="2873197">Beta Channel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2873635">Betakanal</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50760_2873210_2873637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique where adversaries position themselves between two or more networked devices and abuse features of common networking protocols that can determine the flow of network traffic to force a device to communicate through an adversary-controlled system so they can collect information or perform additional actions.</descrip></descripGrp><ntig><termGrp><term id="2873210">man-in-the-middle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2873637">mellommannbasert angrep</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50762_2873213_2873639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To work in one location (often at home) and communicate with a main office at a different location through a personal computer equipped with a modem and communications software.</descrip></descripGrp><ntig><termGrp><term id="2873213">work remotely</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2873639">jobbe heimefrå</term><termNote type="geographicalUsage">NOR</te