ons for a special purpose, such as customer service. The queue holds callers until an agent answers the call.</descrip></descripGrp><ntig><termGrp><term id="1365343">Response Group</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981477">responsgruppe</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2710_1508527_1453013"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The vertical reference line on a grid, chart, or graph that has horizontal and vertical dimensions.</descrip></descripGrp><ntig><termGrp><term id="1508527">y axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1453013">loddrett akse</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2710_3876_1453013"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The vertical reference line on a grid, chart, or graph that has horizontal and vertical dimensions.</descrip></descripGrp><ntig><termGrp><term id="3876">y-axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1453013">loddrett akse</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gr