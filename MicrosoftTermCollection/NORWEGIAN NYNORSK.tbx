angSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630368">Delete</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1285_143904_2540238"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A language used to interpret keystrokes from the keyboard, which can result in different characters appearing than what is printed on the physical keyboard.</descrip></descripGrp><ntig><termGrp><term id="143904">keyboard language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540238">tastaturspråk</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1286_584250_1453002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic map that can document procedures, analyze processes, indicate work or information flow, or track cost and efficiency.</descrip></descripGrp><ntig><termGrp><term id="584250">flowchart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1453002">flytskjema</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1287_62976_3042246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the HSB color model, one of the three characteristics used to describe a color. Hue is the attribute that most readily distinguishes one color from other colors. It depends on the frequency of a light wave in the visible spectrum.</descrip></descripGrp><ntig><termGrp><term id="62976">hue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="3042246">nyanse</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12871_316306_631719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To wait for incoming traffic, calls or connection requests on a port.</descrip></descripGrp><ntig><termGrp><term id="316306">listen</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631719">lytte</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12872_1790611_2020913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To be unresponsive.</descrip></descripGrp><ntig><termGrp><term id="1790611">stop responding</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2020913">slutte å reagere</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNo