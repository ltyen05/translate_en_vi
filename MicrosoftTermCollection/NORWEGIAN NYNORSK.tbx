e to allow multiple fingers touching the computer or device screen at the same time.</descrip></descripGrp><ntig><termGrp><term id="766861">multi-touch gesture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207426">fleirfingerinndata</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21092_1042217_1207427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A multi-touch gesture that consists of one or two fingers moving in the same direction, parallel to each other.</descrip></descripGrp><ntig><termGrp><term id="1042217">pan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207427">panorering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21092_766600_1207427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A multi-touch gesture that consists of one or two fingers moving in the same direction, parallel to each other.</descrip></descripGrp><ntig><termGrp><term id="766600">panning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207427">panorering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote