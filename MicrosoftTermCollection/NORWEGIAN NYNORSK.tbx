ook that when clicked will identify and display email where a user has been explicitly mentioned via the @ symbol in either the email subject or body.</descrip></descripGrp><ntig><termGrp><term id="2312644">Mentions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2328423">Omtalar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39851_2312649_2323654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove a flag.</descrip></descripGrp><ntig><termGrp><term id="2312649">unflag</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2323654">fjerne eit flagg</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39852_2312651_2323648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A badge for OneNote which when clicked lets users take notes quickly while using any app on the Android platform.</descrip></descripGrp><ntig><termGrp><term id="2312651">OneNote badge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2323648">OneNote-merke</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumbe