ch">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1206069">Windows Kontaktar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11999_233421_631316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory that you can use to store names, email addresses, fax numbers, and distribution lists.</descrip></descripGrp><ntig><termGrp><term id="233421">Address Book</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631316">Adressebok</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11999_347906_1206069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory that you can use to store names, email addresses, fax numbers, and distribution lists.</descrip></descripGrp><ntig><termGrp><term id="347906">Windows Contacts</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1206069">Windows Kontaktar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11999_347906_631316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory that you can use to store names, email addresses, fax numbers, and distribution lists.</descrip></descripGrp><ntig><termGrp><term id="347906">Windows Contacts</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631316">Adressebok</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12000_128178_630898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The consistent vertical positioning of text, graphics, and other objects.</descrip></descripGrp><ntig><termGrp><term id="128178">vertical alignment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630898">loddrett justering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12004_67530_630536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key on the keyboard, labeled "Insert" or "Ins", whose usual function is to toggle a program's editing setting between an insert mode and an overwrite mode, although it may perform different functions in different applications.</descrip></descripGrp><ntig><termGrp><term id="67530">INSERT key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630536">Insert</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12010_418615_1981028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Equipment, telephone or computer, used to place a call.</descrip></descripGrp><ntig><termGrp><term id="418615">calling device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981028">oppringingseining</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12018_17045_630163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The authentication protocol (such as CHAP, PAP, EAP etc.) used when authenticating access to resources on a network.</descrip></descripGrp><ntig><termGrp><term id="17045">authentication method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630163">godkjenningsmetode</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12018_262688_630163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The authentication protocol (such as CHAP, PAP, EAP etc.) used when authenticating access to resources on a network.</descrip></descripGrp><ntig><termGrp><term id="262688">auth method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote>