lang="en-US"><descripGrp><descrip type="definition">The blank space outside the printing area on a page.</descrip></descripGrp><ntig><termGrp><term id="322621">page margin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631859">sidemarg</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12253_78289_630625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The blank space outside the printing area on a page.</descrip></descripGrp><ntig><termGrp><term id="78289">margin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630625">marg</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12253_78289_631859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The blank space outside the printing area on a page.</descrip></descripGrp><ntig><termGrp><term id="78289">margin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631859">sidemarg</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12254_232850_1980957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special AutoText entry that stores multiple deletions. Microsoft Office Word appends one item to another until you paste the contents as a group in a new location in your document. You can also use the Microsoft Office Clipboard to get the same result.</descrip></descripGrp><ntig><termGrp><term id="232850">Spike</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980957">innsamlingslager</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12262_207702_228084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document designed to optimize viewing and readability. Flow documents dynamically adjust and reflow their content based on run-time variables such as the display area size, device resolution, and user preferences. A web page is a simple example of a flow document where the page content is dynamically formatted to fit the current window.</descrip></descripGrp><ntig><termGrp><term id="207702">flow document</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="228084">flytande dokument</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1227_318321_631761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optical disc format used to store video on standard compact discs developed by China Recording Standards Committee in co