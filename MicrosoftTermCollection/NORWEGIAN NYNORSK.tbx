"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action that Find Fast performs on an index, such as creating an index, or deleting or updating an existing index.</descrip></descripGrp><ntig><termGrp><term id="1508808">indexing task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540466">indekseringsoppgåve</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29461_1508809_1981538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that enhances the functionality of Microsoft Office 2002 and your Web browser by extending the functionality of a Web server to provide publishing, collaboration, and document management capabilities.</descrip></descripGrp><ntig><termGrp><term id="1508809">Microsoft Office Server Extensions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981538">utvidingar for Microsoft Office Server</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29462_1508810_1981539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar with buttons and options used to apply text formatting. To display the toolbar, point to Toolbars on the View menu, and then click Formatting.</descrip></descripGrp><ntig><termGrp><term id="1508810">Formatting toolbar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981539">formateringsverktøyline</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29463_1508811_2540679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window in the Microsoft Visual Basic Editor in which you write, display, and edit Visual Basic code. You can open as many Code windows as you have modules.</descrip></descripGrp><ntig><termGrp><term id="1508811">Code window</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540679">kodevindauge</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29464_1508812_1981540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Visual Basic identifier that's defined in the host application or by using the #Const compiler directive, and used by other compiler directives to determine when or if certain blocks of code are compiled.</descrip></descripGrp><ntig><termGrp><term id="1508812">conditional compiler constant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981540">vilkårsbunden kompilatorkonstant</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29465_1508813_1981541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Naskh script that enriches the display of Arabic text. This script uses object linking and embedding (OLE) to create and add objects to a document.</descrip></descripGrp><ntig><termGrp><term id="1508813">DecoType Naskh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981541">DecoType Naskh</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29466_1508814_1981542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Ruq'ah script that enriches the display of Arabic text. This script uses object linking and embedding (OLE) to create and add objects to a document.</descrip></descripGrp><ntig><termGrp><term id="1508814">DecoType Ruq'ah</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981542">DecoType Ruq'ah</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29468_1508817_2540467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window in the Visual Basic Editor in which you can run individual lines of Visual Basic code, usually for the purpose of debugging. In the Immediate window, expressions are evaluated immediately.</descrip></descripGrp><ntig><termGrp><term id="1508817">Immediate window</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540467">kommandovindauge</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29469_1508818_2540468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window in the Visual Basic Editor that automatically displays all of the declared variables, and their values, in the current procedure.</descrip></descripGrp><ntig><termGrp><term id="1508818">Locals window</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540468">Locals-vindauge</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29470_1508819_2540469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard bulletin board system. It contains the Microsoft Software Library (MSL), technical articles, device drivers, Help files, and other support files you can download from Microsoft.</descrip></descripGrp><ntig><termGrp><term id="1508819">Microsoft Download Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540469">Microsoft Download Service</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="g