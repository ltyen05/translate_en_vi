 sale.</descrip></descripGrp><ntig><termGrp><term id="178836">Product and Service Items list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540620">liste over produkt og tenester</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23513_1086437_1207551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To save the user's work on a continuous basis, so that it is not necessary to save manually.</descrip></descripGrp><ntig><termGrp><term id="1086437">automatically save</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207551">lagre automatisk</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23517_1086719_1207552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to see conflicting appointments directly from Mail view without having to switch to Calendar view. Makes it much easier for users to decide to accept or decline a meeting invite that conflicts with an existing meeting.</descrip></descripGrp><ntig><termGrp><term id="1086719">Calendar Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207552">Førehandsvising av kalender</term><termNote type="geographicalUsage">NOR</termNote><