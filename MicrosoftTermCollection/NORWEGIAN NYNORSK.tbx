ature that detects potential cases of discriminatory language and lack of inclusive language, and then offers suggestions to correct those issues.</descrip></descripGrp><ntig><termGrp><term id="2386263">Inclusive Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540511">Inkluderande språk</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42136_2386268_2540512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Editor feature that detects punctuation errors and then offers suggestions to help users to adhere to punctuation standards.</descrip></descripGrp><ntig><termGrp><term id="2386268">Punctuation Conventions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540512">Konvensjonar for teiknsetjing</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42137_2386269_2540513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Editor feature that detects potential issues with a user’s vocabulary choice and offers suggestions that help the user choose the right word in the appropriate context.</descrip></descripGrp><ntig><termGrp><term id="2386269">Vocabulary Choice</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langS