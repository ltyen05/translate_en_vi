term id="1796680">postbokssøk</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26522_1275648_1796794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The messaging system that an administrator runs on their own servers in their own company as compared to a messaging system that is run in the cloud (hosted).</descrip></descripGrp><ntig><termGrp><term id="1275648">on-premises messaging system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1796794">lokalt meldingssystem</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26524_1275651_1796910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account that can receive mail using the POP3 protocol.</descrip></descripGrp><ntig><termGrp><term id="1275651">POP-enabled account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1796910">POP-aktivert konto</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26525_1275652_1796919"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The email address that appears in the E-Mail Options section of the user's mailbox in the Web management interface for O