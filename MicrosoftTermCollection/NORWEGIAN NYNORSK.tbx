 id="33054_1743100_1981587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of client version rules that defines the actions to be taken when users try to log on with specific clients and client versions.</descrip></descripGrp><ntig><termGrp><term id="1743100">client version policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981587">klientversjonspolicy</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33055_1743112_1981588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A call that bypasses the Mediation Server.</descrip></descripGrp><ntig><termGrp><term id="1743112">bypass call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981588">samtale som omgår meklingstenaren</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33060_1743190_1763153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A utility that launches the appropriate Office application when a user tries to open an XML file.</descrip></descripGrp><ntig><termGrp><term id="1743190">Office XML Handler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1763153">XML-handsaming for Office</term><termNote type="geographicalUsage">NOR<