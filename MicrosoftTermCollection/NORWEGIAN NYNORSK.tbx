ce.</descrip></descripGrp><ntig><termGrp><term id="2899585">Large gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2899695">Stort galleri</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51508_2899586_2899693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view in Microsoft Teams that allows the user to see up to 9 video feeds at once.</descrip></descripGrp><ntig><termGrp><term id="2899586">Gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2899693">Galleri</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51509_2899587_2899696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A billing model wherein an associated payment method is charged automatically over set periods of time.</descrip></descripGrp><ntig><termGrp><term id="2899587">recurring billing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2899696">regelmessig fakturering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5151_228751_631271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A real-time communication session between two or more users, which can involve IM, video, or audio.</descrip></descripGrp><ntig><termGrp><term id="228751">conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631271">samtale</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51510_2899588_2899698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of all-in-one dedicated Teams devices featuring an ambient touchscreen and a hands-free experience powered by Cortana that brings together the user's favorite Teams features: chat, meetings, calls, calendar, and files into a single device, promoting human connection in the remote workplace.</descrip></descripGrp><ntig><termGrp><term id="2899588">Teams display</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2899698">Teams-vising</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51543_2900640_2900669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in Microsoft Teams that provides the user with analytics about teams that they are a member or owner of, including data about user and guest volume as well as messaging activity.</descrip></descripGrp><ntig><termGrp><term id="2900640">Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2900669">Insights</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51563_2901221_2901316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A third-party device (such as a camera, headset, phone, or room accessory) that has been certified via the Microsoft device Certification Program to provide a compatible experience when used with specific Microsoft software.</descrip></descripGrp><ntig><termGrp><term id="2901221">certified device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2901316">sertifisert eining</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51578_2901804_2901859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Feature (either built into Windows or available as the Windows Lookup app) to allow users to select a word or group of words and look up more information, definition or translation.</descrip></descripGrp><ntig><termGrp><term id="2901804">Lookup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2901859">Oppslag</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5158_154233_631096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An industry-standard Internet tunneling protocol that provides encapsulation for sending Point-to-Point Protocol (PPP) frames across packet-oriented media. For IP networks, L2TP traffic is sent as User Datagram Protocol (UDP) messages. In Microsoft operating systems, L2TP is used in conjunction with Internet Protocol security (IPSec) as a virtual private network (VPN) technology to provide remote access or router-to-router VPN connections. L2TP is described in RFC 2661.</descrip></descripGrp><ntig><termGrp><term id="154233">Layer Two Tunneling Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631096">Layer Two Tunneling Protocol</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5158_154233_631737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An industry-standard Internet tunneling protocol that provides encapsulation for sending Point-to-Point Protocol (PPP) frames across packet-oriented media. For IP networks, L2TP traffic is sent as User Datagram Protocol (UDP) messages. In Microsoft operating systems, L2TP is used in conjunction with Internet Protocol security (IPSec) as a virtual private network (VPN) technology to provide remote access or router-to-router VPN connections. L2TP is described in RFC 2661.</descrip></descripGrp><ntig><termGrp><term id="154233">Layer Two Tunneling Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631737">L2TP</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5158_318115_631096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An industry-standard Internet tunneling protocol that provides encapsulation for sending Point-to-Point Protocol (PPP) frames across packet-oriented media. For IP networks, L2TP traffic is sent as User Datagram Protocol (UDP) messages. In Microsoft operating systems, L2TP is used in conjunction with Internet Protocol security (IPSec) as a virtual private network (VPN) technology to provide remote access or router-to-router VPN connections. L2TP is described in RFC 2661.</descrip></descripGrp><ntig><termGrp><term id="318115">L2TP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631096">Layer Two Tunneling Protocol</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5158_318115_631737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An industry-standard Internet tunneling protocol that provides encapsulation for sending Point-to-Point Protocol (PPP) frames across packet-oriented media. For IP networks, L2TP traffic is sent as User Datagram Protocol (UDP) messages. In Microsoft operating systems, L2TP is used in conjunction with Internet Protocol security (IPSec) as a virtual private network (VPN) technology to provide remote access or router-to-router VPN connections. L2TP is described in RFC 2661.</descrip></descripGrp><ntig><termGrp><term id="318115">L2TP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631737">L2TP</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51586_2902141_2903115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style in Word that shows text with a dotted underline.</descrip></descripGrp><ntig><termGrp><term id="2902141">Smart Hyperlink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2903115">Smart hyperkopling</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51587_2902142_2903116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style in Word that shows text as blue with a blue underline.</descrip></descripGrp><ntig><termGrp><term id="2902142">SmartLink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2903116">Smartkopling</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51589_2902145_2903118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conceptual container that allows a company administrator to restrict the users and groups that an admin can manage to only those in a specific department, region, or any segment that their organization defines.</descrip></descripGrp><ntig><termGrp><term id="2902145">administrative unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2903118">administrativ eining</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51589_2910377_2903118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conceptual container that allows a company administrator to restrict the users and groups that an admin can manage to only those in a specific department, region, or any segment that their organization defines.</descrip></descripGrp><ntig><termGrp><term id="2910377">AU</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2903118">administrativ eining</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51593_2902151_2903125"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An isolated group within an organizational structure that has little to no interaction with other groups, often leading to a lack of collaboration and other negative outcomes.</descrip></descripGrp><ntig><termGrp><term id="2902151">silo</ter