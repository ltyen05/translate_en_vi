:lang="en-US"><descripGrp><descrip type="definition">The UI element that allows users to set permissions for an item or content so that is not made available to anyone else, thus making it private.</descrip></descripGrp><ntig><termGrp><term id="1347077">Just me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2525590">Berre meg</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26706_1347078_2525591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for the social activity stream that Windows Live programmatically displays in a collection. Items listed may originate within a Windows Live program, service, or landing page (Messenger, OneDrive, Windows Live Photos), or in third-party activities people connect to their profiles, such as Facebook.</descrip></descripGrp><ntig><termGrp><term id="1347078">Messenger social</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2525591">Messenger – sosialt</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26711_1375309_2525597"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Direct digital-to-digital conversion of one encoding to another. Converting is usually done to incompatible or obsolete data in order to convert it into a more suitable format.</descrip></descripGrp><ntig><termGrp><term id="1375309">converting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2525597">konvertering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26714_1347086_2016709"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a personal touch to something.</descrip></descripGrp><ntig><termGrp><term id="1347086">personalize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2016709">tilpasse</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26719_1347108_2525592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that provides one-click access to a subset of email messages based on specific criteria, which include: flagged (messages that the customer has designated as requiring follow-up), photos (messages that contain photos), and social updates (messages that originate from a social networking service such as Facebook).</descrip></descripGrp><ntig><termGrp><term id="1347108">quick view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2525592">hurtigvising</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26720_1347110_2834265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The webpage subheading for the view in Messenger that displays someone's friends and contacts that aren't friends but that can be interacted with in Messenger (those are often legacy entries).</descrip></descripGrp><ntig><termGrp><term id="1347110">friends</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2834265">vennar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2673_207681_228068"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A property that is defined by XAML. An attached property can be set on any object, not just on the type that defines the property or its accessors. The attached property provider must provide static Get(PropertyName) and Set(PropertyName) methods as accessors for these attached properties.</descrip></descripGrp><ntig><termGrp><term id="207681">attached property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="228068">vedlagd eigenskap</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26731_1354365_1981457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An equation written using a stylus on a Tablet PC.</descrip></descrip