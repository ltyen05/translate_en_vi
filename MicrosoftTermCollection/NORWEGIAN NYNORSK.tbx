ntig><termGrp><term id="1453117">SharePoint-liste</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23727_1088927_1981343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A site element that stores and displays a collection of data that team members and other site users can share.</descrip></descripGrp><ntig><termGrp><term id="1088927">list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981343">liste</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23766_1089518_2766796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer, either physical or virtual, capable of processing information to produce a desired result.</descrip></descripGrp><ntig><termGrp><term id="1089518">machine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2766796">maskin</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23766_1089518_2766797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer, either physical or virtual, capable of processing information to produce a desired result.</descrip></descripGrp><ntig><termGrp><term id="1089518">machine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2766797">datamaskin</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2378_17347_1794994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to, or characteristic of, a DNS server that hosts a primary or secondary copy of a DNS zone. When a DNS server is configured to host a zone, it is said to be authoritative for names within that zone.</descrip></descripGrp><ntig><termGrp><term id="17347">authoritative server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1794994">autoritativ tenar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="238_41773_1795147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Exchange 5.5 and earlier, a custom recipient is a user who is not hosted by Exchange. In Exchange 2003, such users can be added to Active Directory as contacts, Windows users, or users whose Windows accounts are disabled. In any case, they are mail-enabled, but not mailbox-enabled, because their mailboxes are hosted on another messaging system.</descrip></descripGrp><ntig><termGrp><term id="41773">custom recipient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1795147">eigendefinert mottakar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23804_1089882_2540407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifier that represents a specific user, application, computer, or other entity, enabling it to gain access to multiple resources, such as applications and network resources, without entering credentials multiple times. It also enables resources to validate requests from an entity.</descrip></descripGrp><ntig><termGrp><term id="1089882">claims-based identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540407">erklæringsbasert identitet</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23804_1509111_2540407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifier that represents a specific user, application, computer, or other entity, enabling it to gain access to multiple resources, such as applications and network resources, without entering credentials multiple times. It also enables resources to validate requests from an entity.</descrip></descripGrp><ntig><termGrp><term id="1509111">claims identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540407">erklæringsbasert identitet</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2382_231960_1980919"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of summarizing values in the data area of a PivotTable report by using the values in other cells in the data area. Use the Show data as list on the PivotTable Field dialog for a data field to create custom calculations.</descrip></descripGrp><ntig><termGrp><term id="231960">custom calculation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980919">eigendefinert utrekning</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23840_1091236_1207559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video clip that has been inserted into another file or Web page.</descrip></descripGrp><ntig><termGrp><term id="1091236">embedded video clip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207559">innebygd videoklipp</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23841_1091237_1207560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio clip that has been inserted into another file or Web page.</descrip></descripGrp><ntig><termGrp><term id="1091237">embedded audio clip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207560">innebygd lydklipp</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23864_1091326_1971571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard control that resembles a notebook and lets the user navigate different sections of information without leaving the current element on the screen.</descrip></descripGrp><ntig><termGrp><term id="1091326">tab control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1971571">kategorikontroll</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23864_1091326_2523725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard control that resembles a notebook and lets the user navigate different sections of information without leaving the current element on the screen.</descrip></descripGrp><ntig><termGrp><term id="1091326">tab control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2523725">fanekontroll</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23869_1091332_2818033"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In mathematics, an item that is multiplied in a multiplication problem; for example, 2 and 3 are factors in the problem 2 x 3. The prime factors of a number are a set of prime numbers that, when multiplied together, produce the number.</descrip></descripGrp><ntig><termGrp><term id="1091332">factor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2818033">faktor</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23871_1091334_1522137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ability to view data or navigate to or within a physical or virtual computer environment.</descrip></descripGrp><ntig><termGrp><term id="1091334">access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1522137">tilgang</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23872_1091335_1522333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account holder who is a family member, but not a parent, and who has limited use of the Internet. Children can view their own settings, but they can't change them.</descrip></descripGrp><ntig><termGrp><term id="1091335">child</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1522333">underordna</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23873_1091336_2952243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account holder who is a parent or a child.</descrip></descripGrp><ntig><termGrp><term id="1091336">family member</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2952243">familiemedlem</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23874_1091337_1522341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account holder who is the primary administrator (parent) and the family members they manage.</descrip></descripGrp><ntig><termGrp><term id="1091337">family</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1522341">familie</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23875_1091338_1207561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To combine thereby increasing the quantity or size of something.</descrip></descripGrp><ntig><termGrp><term id="1091338">add</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207561">leggje til</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23876_1091339_1522350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To adjust the action or aspects of a group of items, typically done more than once.</descrip></descripGrp><ntig><termGrp><term id="1091339">manage</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1522350">handsame</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2388_415516_1981016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A name assigned to a cell or group of cells.</descrip></descripGrp><ntig><termGrp><term id="415516">range name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981016">områdenamn</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="239_252121_1980972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A combination of list formatting options identified by a style name.</descrip></descripGrp><ntig><termGrp><term id="252121">list style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980972">listestil</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23915_1091980_2525572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The centralized Windows Live Help system.</descrip></descripGrp><ntig><termGrp><term id="1091980">Help Central</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2525572">Hjelp og støtte</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23916_1091985_2525573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Storage space provided over the Internet that's allotted to users for keeping digital information, such as photos or documents.</descrip></descripGrp><ntig><termGrp><term id="1091985">online storage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2525573">lagringsplass på nett</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23919_1092267_1375766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A “software-plus-services” platform and experience that enables PCs and other devices to “come alive” by making them aware of each other through the Internet, enabling individuals and organizations to manage, access, and share their files and applications seamlessly on the Web and across their world of devices.</descrip></descripGrp><ntig><termGrp><term id="1092267">Live Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1375766">Live Mesh</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23919_1379736_1375766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A “software-plus-services” platform and experience that enables PCs and other devices to “come alive” by making them aware of each other through the Internet, enabling individuals and organizations to manage, access, and share their files and applications seamlessly on the Web and across their world of devices.</descrip></descripGrp><ntig><termGrp><term id="1379736">Windows Live Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1375766">Live Mesh</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23935_1092702_2834264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that is to be searched for in a document or any collection of data.</descrip></descripGrp><ntig><termGrp><term id="1092702">search key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2834264">søkjenøkkel</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23957_1092760_2845571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In communications, a channel connecting two switching stations. A trunk usually carries a large number of calls at the same time.</descrip></descripGrp><ntig><termGrp><term id="1092760">trunk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2845571">sambandsline</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23957_1092760_2845572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In communications, a channel connecting two switching stations. A trunk usually carries a large number of calls at the same time.</descrip></descripGrp><ntig><termGrp><term id="1092760">trunk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2845572">talesambandsline</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></te