l:lang="nn-NO"><ntig><termGrp><term id="631552">visittkort</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12040_294405_631565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In 2-D stacked bar and column charts, a line that connects the data markers in a data series and is used to emphasize the difference in measurement between each series.</descrip></descripGrp><ntig><termGrp><term id="294405">series line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631565">serieline</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12049_180190_2543140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product or service that a company buys from a vendor and/or sells to a customer.</descrip></descripGrp><ntig><termGrp><term id="180190">item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2543140">vare</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1205_397999_1771071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contract that restricts disclosure of confidential information or proprietary knowledge.</descrip></descripGrp><ntig><termGrp><term id="397999">NDA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1771071">NDA</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1205_85315_1771071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contract that restricts disclosure of confidential information or proprietary knowledge.</descrip></descripGrp><ntig><termGrp><term id="85315">non-disclosure agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1771071">NDA</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12055_235062_631370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wizard that helps the user to adjust their speakers for the best sound by running automatic calibration tests for levels, delay, and frequency response.</descrip></descripGrp><ntig><termGrp><term id="235062">Speaker Calibration wizard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631370">Vegvisar for høgtalarkalibrering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12063_38186_2918567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In hardware, a coupler used to join cables or to join a cable to a device (for example, an RS-232-C connector used to join a modem cable to a computer). Most connector types are available in one of two genders--male or female. A male connector is characterized by one or more exposed pins; a female connector is characterized by one or more receptacles--sockets or jacks-- designed to accept the pins on the male connector.</descrip></descripGrp><ntig><termGrp><term id="38186">connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2918567">kontakt</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12065_235429_1538591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that summarizes the status of an account, including current balance and recent activities.</descrip></descripGrp><ntig><termGrp><term id="235429">statement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1538591">kontoutdrag</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12068_27187_630233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marketing program designed to accomplish a specific result, such as introducing a new product or increasing market share.</descrip></descripGrp><ntig><termGrp><term id="27187">campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630233">kampanje</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12068_27187_631893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marketing program designed to accomplish a specific result, such as introducing a new product or increasing market share.</descrip></descripGrp><ntig><termGrp><term id="27187">campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631893">marknadsføringskampanje</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12068_335551_630233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marketing program designed to accomplish a specific result, such as introducing a new product or increasing market share.</descrip></descripGrp><ntig><termGrp><term id="335551">marketing campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630233">kampanje</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEn