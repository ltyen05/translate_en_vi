en-US"><descripGrp><descrip type="definition">A detail about a file that helps identify it, such as a descriptive title, the author name, the subject, or a keyword that identifies topics or other important information in the file.</descrip></descripGrp><ntig><termGrp><term id="141997">file property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980755">fileigenskap</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14661_132278_1980716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web hosting and Internet service provider who manages the Web server hardware and software required to make a Web site available on the Internet.</descrip></descripGrp><ntig><termGrp><term id="132278">web presence provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980716">nettstadsleverandør</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14661_1508998_1980716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web hosting and Internet service provider who manages the Web server hardware and software required to make a Web site available on the Internet.</descrip></descripGrp><ntig><termGrp><term id="1508998">WPP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980716">nettstadsleverandør</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14677_258947_631430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Multimedia content in software, on CD-ROM, or on a Web site that purports to educate the user as well as entertain.</descrip></descripGrp><ntig><termGrp><term id="258947">edutainment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631430">underhaldande læring</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14678_370843_2543348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An HTML tag that appears in the HEAD portion of the Web page. META tags supply information about a page but do not affect its appearance. A standard META tag "generator" is used to indicate the content of a Web page.</descrip></descripGrp><ntig><termGrp><term id="370843">META tag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2543348">metakode</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14684_8743_630114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The window in which a user is currently working or directing input. An active window is typically at the top of the Z order and is distinguished by the color of its title bar.</descrip></descripGrp><ntig><termGrp><term id="8743">active window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630114">aktivt vindauge</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1469_307402_631641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool which enables users to automatically perform routine tasks on a chosen computer by monitoring whatever criteria the users choose to initiate the tasks (referred to as triggers) and then executing the tasks when the criteria is met.</descrip></descripGrp><ntig><termGrp><term id="307402">Task Scheduler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631641">Oppgåveplanlegging</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14695_374338_1980998"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field data type that can contain up to 255 characters or the number of characters specified by the Fieldsize property, whichever is less.</descrip></descripGrp><ntig><termGrp><term id="374338">Text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet