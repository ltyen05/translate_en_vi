Grp></ntig></langSet></termEntry><termEntry id="12540_55239_1980662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A temporary property of a user-interface object, such as a window, view, dialog box, or button, that permits the object to receive keyboard input from the user. The focus is usually conveyed through highlighting.</descrip></descripGrp><ntig><termGrp><term id="55239">focus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980662">fokus</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12544_76022_630603"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security group that can be granted rights and permissions only to resources on the computer on which the group is created. Local groups can have any user accounts that are local to the computer as members, as well as users, groups, and computers from a domain to which the computer belongs.</descrip></descripGrp><ntig><termGrp><term id="76022">local group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630603">lokal gruppe</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12547_155493_631100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technical document in the Microsoft Knowledge Base accessible through Microsoft.com.</descrip></descripGrp><ntig><termGrp><term id="155493">K