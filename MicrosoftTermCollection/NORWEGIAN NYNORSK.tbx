a search request that match the search criteria specified by the user.</descrip></descripGrp><ntig><termGrp><term id="558600">search results</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1797025">søkjeresultat</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8763_335523_2543482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item such as an appointment, business note, email message, file, or task that is linked to an Account, Business Contact, Opportunity, or Business Project.</descrip></descripGrp><ntig><termGrp><term id="335523">communication history item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2543482">kommunikasjonsloggelement</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8769_9149_1794949"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of an agreement that defines the business process that is used, your role, your partner's role, and the policies or parameters that are used in that relationship along with documentation, such as a list of business and legal terms.</descrip></descripGrp><ntig><termGrp><term id="9149">addendum</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1794949">tillegg</term>