/ntig></langSet></termEntry><termEntry id="45211_2579517_2582480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The readiness reporting feature that is used to scan devices and Office documents to determine their readiness to support the Click-to-Run version of Office.</descrip></descripGrp><ntig><termGrp><term id="2579517">Readiness Toolkit for Office add-ins and VBA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2582480">Readiness Toolkit for Office add-ins and VBA</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4523_146682_1980791"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to run a presentation over the Web. The presentation is saved in HTML format and can contain audio and video. It can also be recorded and saved to be viewed later.</descrip></descripGrp><ntig><termGrp><term id="146682">presentation broadcast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980791">presentasjonskringkasting</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4525_5939_1797026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The protocol that improves the security of data communication by using a combination of data encryption, digital certificates, and public key cryptography. SSL enables authentication and increases data integrity and privacy over networks. SSL does not provide authorization or nonrepudiation.</descrip></descripGrp><ntig><termGrp><term id="5939">Secure Sockets Layer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1797026">Secure Sockets Layer</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4525_5939_1797064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The protocol that improves the security of data communication by using a combination of data encryption, digital certificates, and public key cryptography. SSL enables authentication and increases data integrity and privacy over networks. SSL does not provide authorization or nonrepudiation.</descrip></descripGrp><ntig><termGrp><term id="5939">Secure Sockets Layer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1797064">SSL</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4525_5940_1797026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The protocol that improves the security of data communication by using a combination of data encryption, digital certificates, and public key cryptography. SSL enables authentication and increases data integrity and privacy over networks. SSL does not provide authorization or nonrepudiation.</descrip></descripGrp><ntig><termGrp><term id="5940">SSL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1797026">Secure Sockets Layer</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4525_5940_1797064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The protocol that improves the security of data communication by using a combination of data encryption, digital certificates, and public key cryptography. SSL enables authentication and increases data integrity and privacy over networks. SSL does not provide authorization or nonrepudiation.</descrip></descripGrp><ntig><termGrp><term id="5940">SSL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1797064">SSL</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45253_2555759_2922214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measurement used in traditional tabletop role-playing games and role-playing video games to quantify a player character's progression through the game. Experience points are awarded for the completion of quests, overcoming obstacles and opponents, and for successful role-playing.</descrip></descripGrp><ntig><termGrp><term id="2555759">XP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig>