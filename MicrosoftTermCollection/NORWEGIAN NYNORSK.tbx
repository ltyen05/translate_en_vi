angSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbolic value used instead of a real value which in this case is text.</descrip></descripGrp><ntig><termGrp><term id="121042">text placeholder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980706">tekstplasshaldar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7271_170000_631146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To verify that your software product is a legal copy and is installed in compliance with the Microsoft Software License Terms.</descrip></descripGrp><ntig><termGrp><term id="170000">activate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631146">aktivere</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7272_168137_2540264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way of binding to a directory where users can access only a limited area of the directory.</descrip></descripGrp><ntig><termGrp><term id="168137">anonymous binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540264">anonym binding</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="g