type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1953582">WNS</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31641_1635641_1953581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Windows for sending tile updates and notifications to users.</descrip></descripGrp><ntig><termGrp><term id="1635641">WNS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1953581">Windows Push Notification-teneste</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31641_1635641_1953582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Windows for sending tile updates and notifications to users.</descrip></descripGrp><ntig><termGrp><term id="1635641">WNS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1953582">WNS</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31642_1608220_1769239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An environment in which COM objects are activated using a fully qualified namespace and a class name within the namespace. Also refers to the set of APIs that is provided by the Windows Runtime.</descrip></descripGrp><ntig><termGrp><term id="1608220">Windows Runtime</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769239">Windows-køyretid</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31643_1608221_1769242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A library that provides infrastructure for the Windows Runtime; it can also be used to create a language projection to build Windows Runtime components in C++ and for app building.</descrip></descripGrp><ntig><termGrp><term id="1608221">Windows Runtime C++ Template Library</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769242">C++-malbibliotek for Windows-køyretid</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31643_1608221_1769251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A library that provides infrastructure for the Windows Runtime; it can also be used to create a language projection to build Windows Runtime components in C++ and for app building.</descrip></descripGrp><ntig><termGrp><term id="1608221">Windows Runtime C++ Template Library</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769251">WRL</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31643_1765090_1769242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A library that provides infrastructure for the Windows Runtime; it can also be used to create a language projection to build Windows Runtime components in C++ and for app building.</descrip></descripGrp><ntig><termGrp><term id="1765090">WRL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769242">C++-malbibliotek for Windows-køyretid</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31643_1765090_1769251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A library that provides infrastructure for the Windows Runtime; it can also be used to create a language projection to build Windows Runtime components in C++ and for app building.</descrip></descripGrp><ntig><termGrp><term id="1765090">WRL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769251">WRL</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31644_1608222_1769246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reusable software component that can be used in multiple applications, regardless of the programming languages in which the applications are written.</descrip></descripGrp><ntig><termGrp><term id="1608222">Windows Runtime component</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769246">komponent for Windows-køyretid</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31645_1608223_1769248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The APIs that developers can use to create the UI for their Windows app if they use a language other than JavaScript and/or if they have experience with XAML.</descrip></descripGrp><ntig><termGrp><term id="1608223">Windows.UI.Xaml</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769248">Windows.UI.Xaml</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31647_1608225_1763587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of checking a visual workflow to ensure that the shapes and connections are valid.</descrip></descripGrp><ntig><termGrp><term id="1608225">shape-level validation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1763587">validering på figurnivå</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31649_1608227_1763620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode of Word Automation Services in which requests are processed synchronously, rather than in batches.</descrip></descripGrp><ntig><termGrp><term id="1608227">synchronous conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1763620">synkronkonvertering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3165_19460_630179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of source code or programs developed on a more advanced system or compiler version to be executed or compiled by a less advanced (older) version.</descrip></descripGrp><ntig><termGrp><term id="19460">backward compatibility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630179">bakoverkompatibilitet</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31650_1608228_1763635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle that enables touch selection scenarios that are not possible or are difficult to accomplish with standard touch gestures alone.</descrip></descripGrp><ntig><termGrp><term id="1608228">touch selection handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1763635">berøringshandtak</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31651_1608229_1763643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Visio-based design surface that enables users to create and edit workflows visually by manipulating shapes that represent actions and conditions.</descrip></descripGrp><ntig><termGrp><term id="1608229">Visual Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1763643">Visuell utforming</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31654_1608230_1769258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Product Description Page that provides a composite view of all the details that a consumer needs to determine if they want to buy a particular app. This page typically includes the title, publisher name, language support, device support, price point, screen shots, ratings, and reviews.</descrip></descripGrp><ntig><termGrp><term id="1608230">app description</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769258">appskildring</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31655_1608231_1769353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A developer tool that installs Windows Store apps.</descrip></descripGrp><ntig><termGrp><term id="1608231">app installer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769353">appinstallasjonsprogram</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31657_1608233_1769355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A developer tool that is used to create localizable resources for an app.</descrip></descripGrp><ntig><termGrp><term id="1608233">app localizer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769355">applokaliserer</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31659_1608235_1645263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of a product in the store that appears to customers. To the end user, this is the name of the product.</descrip></descripGrp><ntig><termGrp><term id="1608235">app name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1645263">appnamn</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31660_1608236_1769356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains the app manifest, executable files, text and image resource files, and other files that make up the app for a single platform.</descrip></descripGrp><ntig><termGrp><term id="1608236">app package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769356">appakke</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31661_1608237_1769357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of adding a secure digital Authenticode signature to an app package before it is available in the Windows Store. The digital signature shows who signed the package, that the signer is recognized by the client as a trusted source, and that the content of the package was not changed after it was signed.</descrip></descripGrp><ntig><termGrp><term id="1608237">app package signing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769357">