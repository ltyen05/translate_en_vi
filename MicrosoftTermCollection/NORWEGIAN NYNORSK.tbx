ripGrp><descrip type="definition">Code used to restrict access, entered using a combination of controller button and trigger presses.</descrip></descripGrp><ntig><termGrp><term id="1991448">passcode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921436">passord</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34339_1991449_2921518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live account security feature in which Xbox sends a one-time code to a customer's preference of contact options (email, text message, or phone), allowing them to return the code to verify their identity.</descrip></descripGrp><ntig><termGrp><term id="1991449">security check</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921518">tryggleikskontroll</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34340_1991450_2921482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a transaction in which Microsoft Points are exchanged.</descrip></descripGrp><ntig><termGrp><term id="1991450">redeem</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921482">løyse inn</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34341_1991451_2921484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To extend an Xbox Live membership.</descrip></descripGrp><ntig><termGrp><term id="1991451">renew</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921484">fornye</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34342_1991452_2921718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Membership code that is purchased or won through offers, contests, events, and so on.</descrip></descripGrp><ntig><termGrp><term id="1991452">Xbox Live code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921718">Xbox Live-kode</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34344_1991454_2921721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Basic level of Xbox Live membership.</descrip></descripGrp><ntig><termGrp><term id="1991454">Xbox Live Free membership</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921721">gratismedlemskap på Xbox Live</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34345_1991455_2921348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The controller-free gaming experience from Xbox.</descrip></descripGrp><ntig><termGrp><term id="1991455">Kinect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921348">Kinect</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_1991456_2176352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="1991456">Kinect sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2176352">Kinect-sensor</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_1991456_2921519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="1991456">Kinect sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921519">sensor</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_2013412_2176352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="2013412">sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2176352">Kinect-sensor</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_2013412_2921519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="2013412">sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921519">sensor</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34347_1991457_2917198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The automatic angle adjustment function of the Kinect sensor.</descrip></descripGrp><ntig><termGrp><term id="1991457">auto-tilt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2917198">autovinkling</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34348_1991458_2920017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The infrared camera component of the Kinect sensor.</descrip></descripGrp><ntig><termGrp><term id="1991458">depth sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2920017">djupnesensor</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34349_1991459_2921634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The RGB camera component of the Kinect sensor.</descrip></descripGrp><ntig><termGrp><term id="1991459">video sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921634">videosensor</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34350_1991460_2920043"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The entire area that the sensor can "see," including walls, furniture, and other obstructions.</descrip></descripGrp><ntig><termGrp><term id="1991460">field of view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2920043">synsfelt</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34351_1991461_2921442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area within the Kinect sensor's field of view is able to detect a person or in which a player moves.</descrip></descripGrp><ntig><termGrp><term id="1991461">play space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921442">speleplass</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34352_1991462_2920035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Facial identification used by the sensor to recognize a player.</descrip></descripGrp><ntig><termGrp><term id="1991462">facial recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2920035">andletsattkjenning</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34353_1991463_2920080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A motion made by a player that's intended to be tracked by the sensor.</descrip></descripGrp><ntig><termGrp><term id="1991463">gesture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2920080">rørsle</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34354_1991464_2920084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In-game gesture that invokes the Kinect Guide.</descrip></descripGrp><ntig><termGrp><term id="1991464">guide gesture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2920084">guiderørsle</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34355_1991465_2921351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Biometric recognition of a player by the system, through the use of the Kinect sensor and software.</descrip></descripGrp><ntig><termGrp><term id="1991465">Kinect ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921351">Kinect-ID</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34356_1991466_2920086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual progress indicator that appears in the corner of the screen when a player performs the guide gesture. Because the icon is only visible when cued by the guide gesture, use only when necessary to specifically call out its functionality, as in an instructional demo, for example.</descrip></descripGrp><ntig><termGrp><term id="1991466">guide icon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2920086">guideikon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34357_1991467_2920092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The icon that appears when a player is detected in the play space, prompting a wave to engage with Kinect. Once engaged, a hand pointer appears, which serves as a mechanism for navigation and object manipulation.</descrip></descripGrp><ntig><termGrp><term id="1991467">hand icon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2920092">handikon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34358_1991468_2921413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The icon that is present when the Kinect microphone is available to accept voice commands.</descrip></descripGrp><ntig><termGrp><term id="1991468">microphone icon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921413">mikrofonikon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34359_1991469_2921544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Spoken input that's intended to be received and interpreted by the sensor as input.</descrip></descripGrp><ntig><termGrp><term id="1991469">speech</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921544">tale</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34360_1991470_2921606"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The detection and following of a person's movements by the sensor.</descrip></descripGrp><ntig><termGrp><term id="1991470">tracking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921606">sporing</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34361_1991471_2921638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Vocal input that's used by the sensor to identify a player.</descrip></descripGrp><ntig><termGrp><term id="1991471">voice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921638">stemme</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34362_1991472_2921639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The panel that appears in the Xbox Dashboard when the Kinect sensor recognizes the voice command "Xbox".</descrip></descripGrp><ntig><termGrp><term id="1991472">voice bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921639">talefelt</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34363_1991473_2921632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Video communication with another player on Xbox Live, using the Kinect sensor. Formerly video chat.</descrip></descripGrp><ntig><termGrp><term id="1991473">Video Kinect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921632">Video-Kinect</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34364_1991474_2921350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect based guide that appears over a game and allows for social interactions (friends, invites, chat, etc.).</descrip></descripGrp><ntig><termGrp><term id="1991474">Kinect Guide</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921350">Kinect-guide</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34365_1991475_2921354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect based troubleshooter that helps users with common problems related to the play space, lighting, speech/audio, setup, and hardware errors.</descrip></descripGrp><ntig><termGrp><term id="1991475">Kinect Tuner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921354">Kinect-feilsøking</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34366_1991476_2920057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Disc used for playing games.</descrip></descripGrp><ntig><termGrp><term id="1991476">game disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2920057">spelplate</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34367_1991477_2918565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a permanent attachment between a wireless controller and the console.</descrip></descripGrp><ntig><termGrp><term id="1991477">connect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2918565">kople til</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34368_1991478_2918571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When in vertical orientation, the stabilizers at the bottom of the console.</descrip></descripGrp><ntig><termGrp><term id="1991478">console feet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2918571">konsollføter</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34369_1991479_2918587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the USB ports on the front of the console that support the controllers and other USB devices such as cameras and audio players.</descrip></descripGrp><ntig><termGrp><term id="1991479">controller port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2918587">kontrollarport</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote typ