</termEntry><termEntry id="53050_3014894_3016616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram that is based on Six Sigma methodology.</descrip></descripGrp><ntig><termGrp><term id="3014894">Six Sigma flowchart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="3016616">Six Sigma-flytskjema</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53054_3017114_3017807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work model that involves a mixture of in-office and remote work.</descrip></descripGrp><ntig><termGrp><term id="3017114">hybrid work</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="3017807">hybridarbeid</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53055_3017115_3017826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option in Presenter Mode in which the content is displayed as one rectangle to the left and the video of the presenter is displayed in another rectangle to the right.</descrip></descripGrp><ntig><termGrp><term id="3017115">Side-by-side</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="3017826">Side om side</term><termNote type="geographicalUsage">NOR</termNote><t