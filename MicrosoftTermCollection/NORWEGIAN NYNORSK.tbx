p><descrip type="definition">A key on IBM PC and compatible keyboards that normally causes the computer to send a character-based “picture” of the screen contents to the printer.</descrip></descripGrp><ntig><termGrp><term id="94749">PRINT SCREEN key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630746">PrintScr</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15341_335525_2543483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section, located on the Business Contact Manager menu, that tracks interactions with customers by linking items to records.</descrip></descripGrp><ntig><termGrp><term id="335525">Communication History</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2543483">Kommunikasjonslogg</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15350_134128_630935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for creating and manipulating text-based documents.</descrip></descripGrp><ntig><termGrp><term id="134128">word processor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630935">teksthandsamingsprogram</term><termNote type="geographicalUsage">NOR</termNote><termNote