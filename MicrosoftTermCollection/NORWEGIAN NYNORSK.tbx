curity solution that segregates one portion of a network from another portion, allowing only authorized network traffic to pass through according to traffic filtering rules.</descrip></descripGrp><ntig><termGrp><term id="362568">security-edge gateway</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207153">brannmur</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2815_362568_2543355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security solution that segregates one portion of a network from another portion, allowing only authorized network traffic to pass through according to traffic filtering rules.</descrip></descripGrp><ntig><termGrp><term id="362568">security-edge gateway</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2543355">tryggleiksgateway</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28152_1468775_2076228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tax on products at each stage of their production based on the value added during that stage.</descrip></descripGrp><ntig><termGrp><term id="1468775">VAT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2076228">mva.</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28190_1468835_1981516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables you to manage Lync 2010 conversations and meetings that you have recorded. From within Lync Recording Manager, you can play or rename recordings, or create a video format to share with others.</descrip></descripGrp><ntig><termGrp><term id="1468835">Recording Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981516">Opptakshandsaming</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2820_206426_228061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Presentation Foundation, an event routing strategy where the event instance moves down the element tree (starting at the root of the visual tree and ending with the source). The names of events that use this routing strategy are prefixed with the word "Preview". These events have the same signature as their counterparts that use the bubbling event routing strategy.</descrip></descripGrp><ntig><termGrp><term id="206426">tunneling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="228061">tunnelering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28204_1475084_1981517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The upper limit in a permitted range of values.</descrip></descripGrp><ntig><termGrp><term id="1475084">upper bound</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981517">øvre grense</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2824_2685641_1206029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A listing of keywords and associated data that point to the location of more comprehensive information, such as files and records on a disk or record keys in a database.</descrip></descripGrp><ntig><termGrp><term id="2685641">search index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1206029">indeks</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2824_65752_1206029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A listing of keywords and associated data that point to the location of more comprehensive information, such as files and records on a disk or record keys in a database.</descrip></descripGrp><ntig><termGrp><term id="65752">index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1206029">indeks</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28240_1475143_1769375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An abstraction of a sequence of bytes, such as a file, an I/O device, an inter-process communication pipe, a TCP/IP socket, or a spooled print job. The relationship between streams and storages in a compound file is similar to that of files and folders.</descrip></descripGrp><ntig><termGrp><term id="1475143">stream</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769375">dataflyt</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28249_1475512_2540452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Name of the 26th letter in the Arabic alphabet. The sound is similar to that of the letter H in English.</descrip></descripGrp><ntig><termGrp><term id="1475512">haa</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540452">haa</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28254_1475553_2583414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifying number assigned to a shipment.</descrip></descripGrp><ntig><termGrp><term id="1475553">tracking number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2583414">sporingsnummer</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28256_1475559_2525603"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message or topic published on a blog, message board or Help board.</descrip></descripGrp><ntig><termGrp><term id="1475559">post</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2525603">innlegg</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28263_1475805_1522718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that a customer adds to their Windows Live account security information from which they can reset a forgotten password without providing further information.</descrip></descripGrp><ntig><termGrp><term id="1475805">trusted PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1522718">klarert PC</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singul