>The category of games that are optimized for Xbox One X console.</descrip></descripGrp><ntig><termGrp><term id="2569566">Xbox One X Enhanced</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2574681">Xbox One X-forbetra</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45579_2569567_2922198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The premium 4K gaming and entertainment console from Microsoft.</descrip></descripGrp><ntig><termGrp><term id="2569567">Xbox One X</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2922198">Xbox One X</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45581_2569585_2575536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft To-Do feature that enables a user to share a list with other users. All users will be able to add and complete to-dos in a shared list.</descrip></descripGrp><ntig><termGrp><term id="2569585">Sharing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2575536">Deling</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45582_2569597_2575537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft To-Do feature that enables a user to break down a to-do into smaller components of work or effort.</descrip></descripGrp><ntig><termGrp><term id="2569597">Steps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2575537">Trinn</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45583_2569598_2575214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The binding process where authentication is one-directional.</descrip></descripGrp><ntig><termGrp><term id="2569598">1-way binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2575214">einvegsbinding</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45584_2569599_2575219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The binding process where authentication goes both ways.</descrip></descripGrp><ntig><termGrp><term id="2569599">2-way binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2575219">tovegsbinding</term><termNote type="geographicalU