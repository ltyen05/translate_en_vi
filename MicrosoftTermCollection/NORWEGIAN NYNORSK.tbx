="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17816_650176_1207335"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A supplemental program with the filename extension .dll or .exe that extends the capabilities of a program by adding custom commands and specialized features.</descrip></descripGrp><ntig><termGrp><term id="650176">COM add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207335">COM-tillegg</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17816_650176_2540454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A supplemental program with the filename extension .dll or .exe that extends the capabilities of a program by adding custom commands and specialized features.</descrip></descripGrp><ntig><termGrp><term id="650176">COM add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540454">Component Object Model-tilleggsprogram</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17817_650177_2543315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view containing two views. The bottom pane view shows detailed information about the