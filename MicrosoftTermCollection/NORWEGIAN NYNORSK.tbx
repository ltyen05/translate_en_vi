 of goals, plans and measurement of success, that is managed and delivered in a coordinated way.</descrip></descripGrp><ntig><termGrp><term id="251783">program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1538580">program</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10498_168444_1796729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who can schedule meetings, send invitations, do all the sharing activities in a meeting, and admit participants from the lobby.</descrip></descripGrp><ntig><termGrp><term id="168444">Organizer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1796729">møtearrangør</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10498_168444_1980815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who can schedule meetings, send invitations, do all the sharing activities in a meeting, and admit participants from the lobby.</descrip></descripGrp><ntig><termGrp><term id="168444">Organizer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980815">arrangør</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Ma