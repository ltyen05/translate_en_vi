ultiple applications, files, pages, or websites, all available within a single window.​</descrip></descripGrp><ntig><termGrp><term id="150156">tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2076242">fane</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7065_1092501_2763971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proportion of the maximum capacity of a communication circuit that is in use.</descrip></descripGrp><ntig><termGrp><term id="1092501">line load</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2763971">belastning</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7065_75712_2763971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proportion of the maximum capacity of a communication circuit that is in use.</descrip></descripGrp><ntig><termGrp><term id="75712">load</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2763971">belastning</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7078_237301_631403"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables a user to capture all of the RSS feeds they subscribe to in a folder that automatically updates at specified intervals.</descrip></descripGrp><ntig><termGrp><term id="237301">RSS Subscriptions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631403">RSS-abonnement</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="708_168172_631140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the United States, the postal code assigned to all addresses.</descrip></descripGrp><ntig><termGrp><term id="168172">ZIP code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631140">postnummer</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7082_90171_630704"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard key (often labeled "PgUp") that is often used to move the cursor up to the top of the previous page or a specific number of lines. Its function may vary in different programs.</descrip></descripGrp><ntig><termGrp><term id="90171">PAGE UP key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630704">Page Up</term><termNote type="geographi