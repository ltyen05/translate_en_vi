:lang="nn-NO"><ntig><termGrp><term id="2539159">augekontroll</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44981_2531623_2921686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that presents data on who your players are and how they're engaging with Xbox features in your game. The reported statistics consider only the customers who are connected to Xbox Live, not all Xbox customers. The report only shows data if your game is published to Xbox or uses Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="2531623">Xbox analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921686">Xbox-analyse</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44982_2531624_2917222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to change their Xbox avatars, start fresh with brand new ones, or take pictures of their avatars to share with friends. Users can also export avatars as 3D models for 3D printing or for use in Paint 3D.</descrip></descripGrp><ntig><termGrp><term id="2531624">Xbox Avatars</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2917222">Avatarar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44982_2531624_2921693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to change their Xbox avatars, start fresh with brand new ones, or take pictures of their avatars to share with friends. Users can also export avatars as 3D models for 3D printing or for use in Paint 3D.</descrip></descripGrp><ntig><termGrp><term id="2531624">Xbox Avatars</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921693">Xbox Avatarar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44982_2531625_2917222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to change their Xbox avatars, start fresh with brand new ones, or take pictures of their avatars to share with friends. Users can also export avatars as 3D models for 3D printing or for use in Paint 3D.</descrip></descripGrp><ntig><termGrp><term id="2531625">Avatars</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2917222">Avatarar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44982_2531625_2921693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to change their Xbox