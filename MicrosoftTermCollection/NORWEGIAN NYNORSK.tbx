ich a given element is a child. Equivalent to a parent element.</descrip></descripGrp><ntig><termGrp><term id="206410">ancestor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="228037">overordna element</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10004_323599_631867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool in Windows Vista that restores the entire computer (OS, settings, and files).</descrip></descripGrp><ntig><termGrp><term id="323599">Complete PC Restore</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631867">Complete PC-gjenoppretting</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10006_155781_1206056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In DNS, a part of a DNS domain name that represents a node in the domain namespace tree.</descrip></descripGrp><ntig><termGrp><term id="155781">label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1206056">delnamn</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></lan