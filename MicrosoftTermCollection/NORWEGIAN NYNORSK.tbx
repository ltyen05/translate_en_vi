nant control. When sizing controls, selected controls are assigned the dimensions of the dominant control.</descrip></descripGrp><ntig><termGrp><term id="141137">dominant control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540226">dominant kontroll</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15921_140658_631001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains the styles in a presentation, including the type and size of bullets and fonts; placeholder sizes and positions; background design and fill; color schemes; and a slide master and optional title master.</descrip></descripGrp><ntig><termGrp><term id="140658">design template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631001">utformingsmal</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15924_151450_151452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To encrypt files with a key and add information such as the license acquisition URL.</descrip></descripGrp><ntig><termGrp><term id="151450">protect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="151452">verne</term><termNote type="geographicalUsage">NOR</termNote><termNote t