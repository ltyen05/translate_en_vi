pe="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23980_1093084_2540408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphics file format developed by CompuServe and used for transmitting raster images on the Internet. An image may contain up to 256 colors, including a transparent color. The size of the file depends on the number of colors actually used. The LZW compression method is used to reduce the file size still further.</descrip></descripGrp><ntig><termGrp><term id="1093084">GIF</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540408">GIF</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23980_1093085_2540408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphics file format developed by CompuServe and used for transmitting raster images on the Internet. An image may contain up to 256 colors, including a transparent color. The size of the file depends on the number of colors actually used. The LZW compression method is used to reduce the file size still further.</descrip></descripGrp><ntig><termGrp><term id="1093085">Graphics Interchange Format</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540408">GIF</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="240_761713_1207119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any temporary storage space used within or in conjunction with a computer, such as RAM or a USB flash drive.</descrip></descripGrp><ntig><termGrp><term id="761713">temporary memory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207119">minne</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="240_79535_1207119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any temporary storage space used within or in conjunction with a computer, such as RAM or a USB flash drive.</descrip></descripGrp><ntig><termGrp><term id="79535">memory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207119">minne</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2400_1030794_1814156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microcomputer designed for use by one person at a time. Personal computers do not need to share the processing, disk, and printer resources of another computer.</descrip></descripGrp><ntig><termGrp><term id="1030794">single-user computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1814156">PC</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2400_91272_1814156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microcomputer designed for use by one person at a time. Personal computers do not need to share the processing, disk, and printer resources of another computer.</descrip></descripGrp><ntig><termGrp><term id="91272">PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1814156">PC</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2400_91273_1814156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microcomputer designed for use by one person at a time. Personal computers do not need to share the processing, disk, and printer resources of another computer.</descrip></descripGrp><ntig><termGrp><term id="91273">personal computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1814156">PC</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24002_1093138_1997075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI or media segment that can display on top of or play concurrently with another UI or media segment.</descrip></descripGrp><ntig><termGrp><term id="1093138">overlay</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1997075">overlegg</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24016_1093171_2591700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A powerful stand-alone computer of the sort used in computer-aided design and other applications requiring a high-end, usually expensive, machine with considerable calculating or graphics capability.</descrip></descripGrp><ntig><termGrp><term id="1093171">workstation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2591700">arbeidsstasjon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24039_1097320_2638733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On retailer websites, a collection of desired products or items a customer saves to their user account for future reference.</descrip></descripGrp><ntig><termGrp><term id="1097320">wish list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2638733">ønskeliste</term><termNote type="geographicalUsage">NOR</termNo