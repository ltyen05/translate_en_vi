 telephone.</descrip></descripGrp><ntig><termGrp><term id="307423">Dial by Name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1795182">Ring opp etter namn</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7141_186050_2545782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The toll phone number for the conferencing service. In the Options dialog box, on the Account tab, this is one of the conferencing information settings needed for a user to join a conference.</descrip></descripGrp><ntig><termGrp><term id="186050">toll</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2545782">betalingsnummer</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7142_417424_1167503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A kit that can be purchased by an end-user to license or activate software.</descrip></descripGrp><ntig><termGrp><term id="417424">license kit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1167503">mediefritt lisenssett</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type=