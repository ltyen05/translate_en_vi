 left and right.</descrip></descripGrp><ntig><termGrp><term id="2244487">Panorama</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2253636">Panorama</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38603_2244846_2253593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that allows a user to click on an embedded image to see any of the following: a high resolution version of it, a link to where the image was found, as well as related images.</descrip></descripGrp><ntig><termGrp><term id="2244846">Detail view</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2253593">detaljvising</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38604_2244850_2525614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button on the Sway home page that allows the user to begin using sway.</descrip></descripGrp><ntig><termGrp><term id="2244850">Get Started!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2525614">Kom i gang!</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><t