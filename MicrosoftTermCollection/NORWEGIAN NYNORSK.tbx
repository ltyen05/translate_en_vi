efinition">To position objects or text relative to some point, such as the page margin.</descrip></descripGrp><ntig><termGrp><term id="10901">align</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630130">justere</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16268_148817_2540252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fundamental data type that holds characters, one character per 2 bytes. A fixed-length string can contain 1 to 64K characters; a variable-length string can contain 1 to 2 billion.</descrip></descripGrp><ntig><termGrp><term id="148817">String data type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540252">strengdatatype</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16276_263115_1207319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a file format that allows for VBA code. Examples of file extensions for macro-enabled formats are .docm, .pptm, .xlsm.</descrip></descripGrp><ntig><termGrp><term id="263115">macro-enabled</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207319">makroaktivert</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16290_237379_631406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Office Server that provides a workflow for document review.</descrip></descripGrp><ntig><termGrp><term id="237379">Document Review</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631406">Dokumentgjennomgang</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16293_207696_228078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of three methods used to describe how an animation transitions between values over its duration. This method produces a jump from one value to the next, without generating in-between values.</descrip></descripGrp><ntig><termGrp><term id="207696">discrete interpolation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="228078">diskret interpolering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16299_235387_2543296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request for a specified amount of an item to be pulled from inventory.</descrip></descripGrp><ntig><termGrp><term id="235387">requisition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2543296">rekvisisjon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16299_235387_2543298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request for a specified amount of an item to be pulled from inventory.</descrip></descripGrp><ntig><termGrp><term id="235387">requisition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2543298">delrekvisisjon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16299_235388_2543296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request for a specified amount of an item to be pulled from inventory.</descrip></descripGrp><ntig><termGrp><term id="235388">parts requisition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2543296">rekvisisjon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16299_235388_2543298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request for a specified amount of an item to be pulled from inventory.</descrip></descripGrp><ntig><termGrp><term id="235388">parts requisition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2543298">delrekvisisjon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="163_311257_1206017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user preferences for the formatting of dates, currencies, numbers, and so on. The user locale is a per-user setting, and does not require the user to restart or to log on or log off the computer.</descrip></descripGrp><ntig><termGrp><term id="311257">user locale</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1206017">språkvariant</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16315_140027_630990"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that displays one complete record at a time. You can use data forms to add, change, locate, and delete records.</descrip></descripGrp><ntig><termGrp><term id="140027">data form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630990">dataskjema</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16317_209984_631208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Media Player, a database that contains information about digital media files on a computer, a network drive, or the Internet.</descrip></descripGrp><ntig><termGrp><term id="209984">library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631208">bibliotek</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16319_119343_1980702"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One or more rows of cells commonly used to display numbers and other items for quick reference and analysis.</descrip></descripGrp><ntig><termGrp><term id="119343">table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980702">tabell</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16322_143641_1207320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cell in which each input value from a data table is substituted. Any cell on a worksheet can be the input cell. Although the input cell does not need to be part of the data table, the formulas in data tables must refer to the input cell.</descrip></descripGrp><ntig><termGrp><term id="143641">input cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207320">inndatacelle</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16327_163539_2540692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The adjustment of the spacing between two characters to create the appearance of even spacing, fit text to a given space, and adjust line breaks.</descrip></descripGrp><ntig><termGrp><term id="163539">kerning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540692">kerning</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16327_163539_631133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The adjustment of the spacing between two characters to create the appearance of even spacing, fit text to a given space, and adjust line breaks.</descrip></descripGrp><ntig><termGrp><term id="163539">kerning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631133">kniping</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1633_262439_631448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proposed standard digital rights management (DRM) markup language which enables users to specify rights and conditions associated with resources, such as digital content or Web services.</descrip></descripGrp><ntig><termGrp><term id="262439">XrML</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631448">XrML</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1633_262439_631449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proposed standard digital rights management (DRM) markup language which enables users to specify rights and conditions associated with resources, such as digital content or Web services.</descrip></descripGrp><ntig><termGrp><term id="262439">XrML</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631449">Extensible Rights Markup Language</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1633_262440_631448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proposed standard digital rights management (DRM) markup language which enables users to specify rights and conditions associated with resources, such as digital content or Web services.</descrip></descripGrp><ntig><termGrp><term id="262440">extensible rights markup language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631448">XrML</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1633_262440_631449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proposed standard digital rights management (DRM) markup language which enables users to specify rights and conditions associated with resources, such as digital content or Web services.</descrip></descripGrp><ntig><termGrp><term id="262440">extensible rights markup language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631449">Extensible Rights Markup Language</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16337_117385_1207321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One character (or more) printed slightly below the baseline of surrounding text.</descrip></descripGrp><ntig><termGrp><term id="117385">subscript</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207321">senka skrift</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16338_210449_1980900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The core component of the Excel Server that includes the full Excel calculation functionality. It loads and saves Excel workbooks, queries and refreshes external data, calculates workbooks, and provides the calculated results to the caller.</descrip></descripGrp><ntig><termGrp><term id="210449">Excel Calculation Server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980900">Utrekningstenar for Excel</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16344_18758_630173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the context of processes or tasks that are part of an operating system or program, operating without interaction with the user while the user is working on another task.</descrip></descripGrp><ntig><termGrp><term id="18758">background</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630173">bakgrunns-</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16348_318717_631782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To advance audio or video playback at a speed that is faster than normal.</descrip></descripGrp><ntig><termGrp><term id="318717">fast forward</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631782">spole framover</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16358_210492_631218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of attack that tries to trick users into revealing personal information, such as credit card numbers, bank accounts, or passwords, often using links to fake websites included in emails and chat messages.</descrip></descripGrp><ntig><termGrp><term id="210492">phishing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631218">phishing</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1636_178574_2540281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A date on which an opportunity is closed, either because it resulted in a sale or was unsuccessful.</descrip></descripGrp><ntig><termGrp><term id="178574">close date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540281">sluttdato</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16365_338551_631901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item provided and signed by the DCE security server that is both a proof of identity and a list of group memberships.</descrip></descripGrp><ntig><termGrp><term id="338551">privilege attribute certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631901">Privilege Attribute Certificate</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16365_338551_631904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item provided and signed by the DCE security server that is both a proof of identity and a list of group memberships.</descrip></descripGrp><ntig><termGrp><term id="338551">privilege attribute certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631904">PAC</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16365_338565_631901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item provided and signed by the DCE security server that is both a proof of identity and a list of group memberships.</descrip></descripGrp><ntig><termGrp><term id="338565">PAC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631901">Privilege Attribute Certificate</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16365_338565_631904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item provided and signed by the DCE security server that is both a proof of identity and a list of group memberships.</descrip></descripGrp><ntig><termGrp><term id="338565">PAC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631904">PAC</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1639_148511_1207131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A workbook that is configured to allow multiple users on a network to view and make changes at the same time. Each user who saves the workbook sees the changes that are made by other users.</descrip></descripGrp><ntig><termGrp><term id="148511">shared workbook</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1207131">delt arbeidsbok</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16414_583814_2576173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of an integrated development environment (IDE) that provides logical code elements that the user can select from a drop-down menu while coding.</descrip></descripGrp><ntig><termGrp><term id="583814">IntelliSense</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2576173">IntelliSense</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16438_584264_1981082"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column chart subtype that compares values across categories. The categories are organized horizontally, and values vertically, to emphasize variation over time.</descrip></descripGrp><ntig><termGrp><term id="584264">clustered column chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981082">gruppert ståande stolpediagram</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16439_584277_2479467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column chart subtype that compares the percentage that each value contributes to a total across categories.</descrip></descripGrp><ntig><termGrp><term id="584277">100% stacked column chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2479467">stabla stolpediagram med prosentfordeling</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</te