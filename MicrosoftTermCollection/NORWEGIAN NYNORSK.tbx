is defined by a set of dimensions and measures.</descrip></descripGrp><ntig><termGrp><term id="41272">cube</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631264">OLAP-kube</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15454_217336_232086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In mathematics and computer graphics, to alter the position, size, or nature of an object by moving it to another location (translation), making it larger or smaller (scaling), turning it (rotation), changing its description from one type of coordinate system to another, and so on.</descrip></descripGrp><ntig><termGrp><term id="217336">transform</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="232086">transformere</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15456_231959_1980918"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that's assigned a column orientation in a PivotTable report. Items associated with a column field are displayed as column labels.</descrip></descripGrp><ntig><termGrp><term id="231959">column field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980918">kolonnefelt</term><termNote type="ge