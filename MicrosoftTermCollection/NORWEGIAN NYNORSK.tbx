Entry id="27020_1362322_1981473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function of the Monitoring Server for collecting information such as when a user signs in or out; starts, joins, leaves, or ends a conference or IM session; transfers a file; or places or answers a VoIP call. CDR captures only usage data; it does not archive the content of any communication activity.</descrip></descripGrp><ntig><termGrp><term id="1362322">call detail recording</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981473">registrering av samtaleinformasjon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27020_1362322_1981474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function of the Monitoring Server for collecting information such as when a user signs in or out; starts, joins, leaves, or ends a conference or IM session; transfers a file; or places or answers a VoIP call. CDR captures only usage data; it does not archive the content of any communication activity.</descrip></descripGrp><ntig><termGrp><term id="1362322">call detail recording</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981474">CDR</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27020_1362323_1981473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function of the Monitoring Server for collecting information such as when a user signs in or out; starts, joins, leaves, or ends a conference or IM session; transfers a file; or places or answers a VoIP call. CDR captures only usage data; it does not archive the content of any communication activity.</descrip></descripGrp><ntig><termGrp><term id="1362323">CDR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981473">registrering av samtaleinformasjon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27020_1362323_1981474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function of the Monitoring Server for collecting information such as when a user signs in or out; starts, joins, leaves, or ends a conference or IM session; transfers a file; or places or answers a VoIP call. CDR captures only usage data; it does not archive the content of any communication activity.</descrip></descripGrp><ntig><termGrp><term id="1362323">CDR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981474">CDR</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27027_1362482_1981475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism for a MAPI client to initiate a quick shutdown of the client process, notifying all providers with which the client has an active MAPI session to save data and settings before th