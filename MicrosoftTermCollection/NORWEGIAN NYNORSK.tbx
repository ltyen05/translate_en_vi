t elapsed times for putting your computer on standby and for turning off your monitor and hard disk. You save these settings as a named power scheme.</descrip></descripGrp><ntig><termGrp><term id="94159">power scheme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2016712">straumoppsett</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16167_184359_1980843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of the dialog box in Lync and Office Communicator where a user can configure their connection settings to a server.</descrip></descripGrp><ntig><termGrp><term id="184359">Advanced Connection Settings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980843">Avanserte innstillingar for tilkopling</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16175_1508829_1981546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area at the left side in some dialog boxes, such as Save As, Open, and Insert Picture that contains shortcuts to various folders.</descrip></descripGrp><ntig><termGrp><term id="1508829">Places Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981546">stadsfelt</term><termNote 