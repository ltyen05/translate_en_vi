ig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769343">tweet</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25008_2060482_1769343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text-based post on Twitter.</descrip></descripGrp><ntig><termGrp><term id="2060482">tweet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769343">tweet</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2502_179897_228052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A node with subordinate node(s), called children.</descrip></descripGrp><ntig><termGrp><term id="179897">parent node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="228052">overordna node</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25060_1167275_1796930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item in the global address list that provides an easy way to send messages to a group of people. A public group can include any item from a global address list, including other public groups.</descrip></descripGrp><ntig><termGrp><