definition">To share a PowerPoint presentation, where only the PowerPoint document is shown and only the presenter can edit the content being presented.</descrip></descripGrp><ntig><termGrp><term id="1427142">present</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981502">presentere</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27743_1427146_1981503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An in-meeting vote conducted by a presenter.</descrip></descripGrp><ntig><termGrp><term id="1427146">poll</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981503">undersøking</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27751_1430080_1981504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of equations that are stacked vertically, and that can be aligned at a particular character if desired.</descrip></descripGrp><ntig><termGrp><term id="1430080">pile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981504">stabel</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27752_1430082_1981505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A space in a template where a user can type text or insert symbols.</descrip></descripGrp><ntig><termGrp><term id="1430082">slot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981505">felt</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27754_1430088_1981506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slot where the user can type text.</descrip></descripGrp><ntig><termGrp><term id="1430088">text slot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981506">tekstfelt</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2776_420864_1796801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A defined set of values that Microsoft Office Outlook uses to keep track of user accounts.</descrip></descripGrp><ntig><termGrp><term id="420864">Outlook profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1796801">Outlook-profil</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27766_1436100_1981507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presence status that indicates a person is in a meeting or is scheduled to be in a meeting, but their computer has been inactive for the idle time period setting.</descrip></descripGrp><ntig><termGrp><term id="1436100">Busy Inactive</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981507">oppteken/inaktiv</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27769_1447396_1981509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that indicates that a user has assigned this contact to the Blocked Contacts privacy relationship.</descrip></descripGrp><ntig><termGrp><term id="1447396">Blocked</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981509">blokkert</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27772_1448163_2653194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Rules by which one must agree to abide by in order to use a service. The accompanying Microsoft software includes computer software and may include associated media, printed materials, “online” or electronic documentation, and Internet-based services for use with a Microsoft software product (collectively, the “ADD-IN SOFTWARE”).</descrip></descripGrp><ntig><termGrp><term id="1448163">terms of service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2653194">vilkår for bruk</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27784_1462925_1981510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows a user to answer a call for another user or make calls on behalf of the other user.</descrip></descripGrp><ntig><termGrp><term id="1462925">call delegation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981510">samtaledelegering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27786_1463882_1981511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A site that is associated with one central site and contains at least a public switched telephone network (PSTN) gateway, and can include a Mediation Server. Or, a branch site could run a survivable branch appliance which makes the site more resistant if there are wide-area network failures.</descrip></descripGrp><ntig><termGrp><term id="1463882">branch site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981511">greinnettstad</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27787_1463884_1981512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature whereby a user can select an option to report a received call as malicious. By tracing the call, an administrator can then identify the call, the calling number, and the gateway or SIP trunk over which the call was received.</descrip></descripGrp><ntig><termGrp><term id="1463884">malicious call tracing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981512">sporing av useriøs oppringing</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27788_1463920_1981513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy that provides information to the Lync Server ExUM Routing application about where to route calls for users whose mailboxes are located on a hosted Exchange service.</descrip></descripGrp><ntig><termGrp><term id="1463920">hosted voice mail policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981513">policy for verstbasert telefonsvarar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry