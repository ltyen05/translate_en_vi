Entry><termEntry id="40430_2347754_2545725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service plan offer covering domestic calls as part of the PSTN Calling service in Office 365.</descrip></descripGrp><ntig><termGrp><term id="2347754">Skype for Business PSTN Domestic Calling</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2545725">PSTN-oppringing innanlands med Skype for Business</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40431_2347755_2545726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service plan offer covering international calls as part of the PSTN Calling service in Office 365.</descrip></descripGrp><ntig><termGrp><term id="2347755">Skype for Business PSTN International Calling</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2545726">PSTN-oppringing utanlands med Skype for Business</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40432_2347756_2545724"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service plan offer covering domestic and international calls as part of the PSTN Calling service in Office 365.</descrip></descripGrp><ntig><termGrp><term id="2347756">Skype for Business PSTN Domestic and International Calling</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2545724">PSTN-oppringing innanlands og utanlands med Skype for Business</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40436_2349281_2351322"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item showing hearts (number of likes) for a given chat message. The heart-feature refers to giving and removing hearts and is distinct from the Like-feature known from e.g. Facebook.</descrip></descripGrp><ntig><termGrp><term id="2349281">Show likes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2351322">Vis liker</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40438_2349283_2351324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item connected the heart-feature, whereby a participant can remove a "heart" from a chat message, indicating that the participant does not like a chat message. The heart-feature refers to giving and removing hearts and is distinct from the Like-feature known from e.g. Facebook.</descrip></descripGrp><ntig><termGrp><term id="2349283">Unlike</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2351324">Liker ikkje</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40439_2349284_2351318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount of money added to an account.</descrip></descripGrp><ntig><termGrp><term id="2349284">credit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2351318">kredit</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40440_2349285_2351319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item connected the heart-feature, whereby a participant can give a "heart" to a chat message, indicating that the participant likes a chat message. The heart-feature refers to giving and removing hearts and is distinct from the Like-feature known from e.g. Facebook.</descrip></descripGrp><ntig><termGrp><term id="2349285">Like</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2351319">Liker</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40441_2349286_2351321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of hearts showing how many particpant have liked a chat message. The heart-feature refers to giving and removing hearts and is distinct from the Like-feature known from e.g. Facebook.</descrip></descripGrp><ntig><termGrp><term id="2349286">Likes</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2351321">Liker</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40454_3113359_3137220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security service that provides a consolidated view into risk events and potential vulnerabilities affecting your organization’s identities.</descrip></descripGrp><ntig><termGrp><term id="3113359">Microsoft Entra ID Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="3137220">Microsoft Entra ID-vern</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40474_2350857_3025453"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A servicing release cadence to receive development builds. Each ring is defined by a different release frequency and level of stability.</descrip></descripGrp><ntig><termGrp><term id="2350857">ring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="3025453">ring</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNo