Grp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2377147">Mest spelte spel</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41956_2375040_2377146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for the apps that are played the most by Store customers.</descrip></descripGrp><ntig><termGrp><term id="2375040">Most played apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2377146">Mest spelte appar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41957_2375041_2377124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who informally represents their feature team by sharing their expertise with the community in activities such as listening and responding to customer feedback, contributing to community forums, blogging about tips and tricks, and more.</descrip></descripGrp><ntig><termGrp><term id="2375041">community champion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2377124">fellesskapsrepresentant</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41957_2751151_2377124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who informally represents their feature team by sharing their expertise with the community in activities such as listening and responding to customer feedback, contributing to community forums, blogging about tips and tricks, and more.</descrip></descripGrp><ntig><termGrp><term id="2751151">community champ</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2377124">fellesskapsrepresentant</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4196_213534_631252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of colors or levels of gray that can be displayed at one time. The amount or memory in the computer's graphics controller card controls the display. An 8-bit controller can display 256 colors or levels of gray; a 16-bit controller, 64,000 colors; and a 24-bit controller, 16.8 million colors.</descrip></descripGrp><ntig><termGrp><term id="213534">bit specification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631252">bitspesifikasjon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41961_2375458_3113620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The basic amount of the guaranteed ingress/egress of events sent to an Event Hub that can be dynamically scaled according to stream processing, to pay only for compute needs and handle jobs with gigabytes/sec of streamed data.</descrip></descripGrp><ntig><termGrp><term id="2375458">capacity unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="3113620">kapasitetseining</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41961_2766779_3113620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The basic amount of the guaranteed ingress/egress of events sent to an Event Hub that can be dynamically scaled according to stream processing, to pay only for compute needs and handle jobs with gigabytes/sec of streamed data.</descrip></descripGrp><ntig><termGrp><term id="2766779">CU</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="3113620">kapasitetseining</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4197_113668_630817"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A power-saving state that allows the computer or device to quickly resume full-power operation (typically within several seconds) when you want to start working again. All open documents and programs are saved to memory before the computer or device enters the low-power state.</descrip></descripGrp><ntig><termGrp><term id="113668">sleep</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630817">kvilemodus</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4197_312080_630817"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A power-saving state that allows the computer or device to quickly resume full-power operation (typically within several seconds) when you want to start working again. All open documents and programs are saved to memory before the computer or device enters the low-power state.</descrip></descripGrp><ntig><termGrp><term id="312080">sleep mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630817">kvilemodus</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41978_2375534_2377128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The nickname for Windows 10, version 1607​, used by marketing and executives in announcements about this update, but not in the product.​</descrip></descripGrp><ntig><termGrp><term id="2375534">Windows 10 Anniversary Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2377128">Jubileumsoppdatering av Windows 10</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41979_2375536_2686559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The StaffHub tab where users are able to view all of the shifts their manager has them scheduled for.</descrip></descripGrp><ntig><termGrp><term id="2375536">My Shifts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2686559">Mine skift</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41980_2375537_2540497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The StaffHub tab where users can view requested shift changes and time off requests.</descrip></descripGrp><ntig><termGrp><term id="2375537">Requests</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540497">Førespurnader</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41981_2375539_2686592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The StaffHub view that allows users to view the time they have requested off and the status of the time off requests.</descrip></descripGrp><ntig><termGrp><term id="2375539">Time off request</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:la