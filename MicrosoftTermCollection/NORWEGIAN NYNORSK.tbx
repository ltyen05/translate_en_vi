2016702"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To decompress, or pull out, files from a compressed form. When you extract a file, an uncompressed copy of the file is placed in the folder you specify. The original file remains in the compressed folder. Compressed files frequently have a .zip file name extension.</descrip></descripGrp><ntig><termGrp><term id="155717">extract</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2016702">pakke ut</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52360_2955572_2975554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Database Excel function that returns the average of selected database entries.</descrip></descripGrp><ntig><termGrp><term id="2955572">DAVERAGE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2975554">DAVERAGE</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52361_2955573_2975555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Date and time Excel function that converts a serial number to a day of the month.</descrip></descripGrp><ntig><termGrp><term id="2955573">DAY</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><nti