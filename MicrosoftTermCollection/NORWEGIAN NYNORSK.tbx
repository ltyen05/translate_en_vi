275659_1797061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which a user presses and holds a key on their mobile phone keypad to dial a specific phone number.</descrip></descripGrp><ntig><termGrp><term id="1275659">speed dialing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1797061">hurtigoppringing</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26530_1275661_1795244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The settings, related to the domain, a user needs to configure to get messaging up and running.</descrip></descripGrp><ntig><termGrp><term id="1275661">domain settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1795244">domeneinnstillingar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26531_1275663_1981438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transfer a call to a holding point instead of holding the call at the phone device.</descrip></descripGrp><ntig><termGrp><term id="1275663">park</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981438">parkere</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><te