at facilitates the capture of photos and videos by using the PC.</descrip></descripGrp><ntig><termGrp><term id="1606498">Camera</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1647284">Windows Kamera</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31550_1606499_1647194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To touch an item with two or more fingers and then spread the fingers apart.</descrip></descripGrp><ntig><termGrp><term id="1606499">stretch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1647194">strekke ut</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31552_1606530_1769030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A library that developers can use in their applications throughout the new Windows user interface.</descrip></descripGrp><ntig><termGrp><term id="1606530">Animation Library</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769030">animasjonsbibliotek</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31561_1606698_1769044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of COM interfaces that a device companion app can use to send requests, to a specialized device, synchronously or asynchronously.</descrip></descripGrp><ntig><termGrp><term id="1606698">Device Access API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769044">API for einingstilgang</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31562_1606699_1769066"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A new Windows user interface surface used to elicit an immediate response from the user. Until the user responds, the screen behind the dialog is dimmed and touch events are blocked from passing to the app's canvas.</descrip></descripGrp><ntig><termGrp><term id="1606699">message dialog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769066">meldingsdialogboks</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31569_1606709_1769054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A grouped and ordered list of HTML blocks in ListView.</descrip></descripGrp><ntig><termGrp><term id="1606709">Grouped Grid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769054">Gruppert rutenett</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31572_1606713_1762626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of linking contacts that represent the same person. This enables you to view information from multiple contacts in a single contact card.</descrip></descripGrp><ntig><termGrp><term id="1606713">contact linking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1762626">kontaktkopling</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31574_1606715_1762941"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task pane that provides functionality for formatting objects.</descrip></descripGrp><ntig><termGrp><term id="1606715">Format Object task pane</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1762941">oppgåveruta Formater objekt</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31576_1606717_1769057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A native API that, when an app gets input, tells the app what kind of hardware it came from.</descrip></descripGrp><ntig><termGrp><term id="1606717">Input Source Identification API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769057">API for kildeidentifikasjon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31577_1606718_1769059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The direct manipulation (e.g. a gesture and inertia) of an element.</descrip></descripGrp><ntig><termGrp><term id="1606718">interaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769059">samhandling</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3158_122297_1980710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subject of a dynamic data exchange (DDE) conversation between two applications.</descrip></descripGrp><ntig><termGrp><term id="122297">topic</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980710">emne</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31582_1606723_1793796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows UI control that enables easy creation and management of a data collection using web-based technologies.</descrip></descripGrp><ntig><termGrp><term id="1606723">ListView</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1793796">ListView</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31585_1606726_1645513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An indication that appears on the lock screen or a tile to inform the user of recent activity or updates, such as number of email messages received, since the PC was locked or the app was last viewed.</descrip></descripGrp><ntig><termGrp><term id="1606726">badge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1645513">indikator</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31592_1608135_1647032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that audibly reads the text on the screen aloud and describes some events to users.</descrip></descripGrp><ntig><termGrp><term id="1608135">Narrator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1647032">Skjermlesar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31599_1608161_1769079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interface that manages audio and video playback for Windows Store apps.</descrip></descripGrp><ntig><termGrp><term id="1608161">Playback Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769079">Avspelingshandsaming</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31601_1608163_1769085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An API that enables awareness of device proximity within an app. The simple physical gesture of tapping devices together can be used to login to Windows, launch applications, connect with other devices, and share content between devices -- all without the user needing to initiate any other action.</descrip></descripGrp><ntig><termGrp><term id="1608163">Proximity API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769085">Nærleiks-API</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31613_1608178_1769092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of loading apps that were not distributed via the Microsoft Store, usually for testing an app before it is ready for sale.</descrip></descripGrp><ntig><termGrp><term id="1608178">sideloading</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769092">sideinnlasting</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31614_1608179_1769170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An API that is part of the Windows 8 extensible platform for sending and receiving SMS text messages through a mobile broadband adapter or a cellphone connected to a PC.</descrip></descripGrp><ntig><termGrp><term id="1608179">SMS API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769170">SMS-API</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31615_1608180_1769198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location (both interval and non-interval) where the position of the content comes to rest after the user has completed their interaction.</descrip></descripGrp><ntig><termGrp><term id="1608180">snap point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769198">forankringspunkt</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31616_1608181_1769206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows 8 feature that enables content to look 3-dimensional by slightly offsetting two images so that the eye sees them as 3D.</descrip></descripGrp><ntig><termGrp><term id="1608181">Stereoscopic 3D</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769206">stereoskopisk 3D</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31617_1608182_1769217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A native API that allows apps that aren't Windows Store apps and that use timers to coalesce timer messages such that when the screen is off, timers continue to fire but the app wakes less often, thus saving battery life.</descrip></descripGrp><ntig><termGrp><term id="1608182">Timer Coalescence API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769217">API for tidtakargruppering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31618_1608183_1769220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A touch event for the Web and Windows Web applications. Web developers use touch DOM events to enable touch.</descrip></descripGrp><ntig><termGrp><term id="1608183">touch DOM event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769220">DOM-berøringshending</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31619_1608184_1769222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A native API for touch that allows a desktop app to send touch input to the screen (it already exists for mouse and keyboard). It simulates touch by sending messages that look like touch messages. It can be used to automate testing of a Windows Store app (larger company), and is used to support a class of devices.</descrip></descripGrp><ntig><termGrp><term id="1608184">Touch Injection API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769222">berøringsinnsettings-API</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31621_1608186_1763269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables single-click access to trend and contribution patterns within a PivotTable or PivotChart report.</descrip></descripGrp><ntig><termGrp><term id="1608186">Quick Explore</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1763269">Hurtigutforsking</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31622_1608188_1763625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">​A Web Part that combines a search list of projects in a site collection along with a timeline that shows how those projects relate to one another.</descrip></descripGrp><ntig><termGrp><term id="1608188">Team Work Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1763625">Senter for gruppearbeid</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31623_1608189_1763630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of variants on a single theme.</descrip></descripGrp><ntig><termGrp><term id="1608189">theme family</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1763630">temafamilie</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31625_1608191_1763631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the variations of a theme that make up a theme family.</descrip></descripGrp><ntig><termGrp><term id="1608191">theme variant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1763631">temavariant</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31636_1608213_1769226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of APIs that developers use to create UI for Windows by using JavaScript.</descrip></descripGrp><ntig><termGrp><term id="1608213">Windows Library for JavaScript</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769226">Windows-bibliotek for JavaScript</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31639_1608217_2043145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of performance monitoring tools used to produce in-depth performance profiles of both systems and applications.</descrip></descripGrp><ntig><termGrp><term id="1608217">Windows Performance Analyzer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2043145">Windows Performance Analyzer</term><termNote type="geographicalUsage">NOR</termNote><termNo