t></termEntry><termEntry id="577_361199_632008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tutorial outlining basic Windows features, workflow and information.</descrip></descripGrp><ntig><termGrp><term id="361199">Windows Basics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="632008">Grunnleggjande Windows</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5770_133968_630931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A local area network (LAN) that sends and receives data via radio, infrared optical signaling, or some other technology that does not require a physical connection between individual nodes and the hub. Wireless LANs are often used in office or factory settings where a user must carry a portable computer from place to place.</descrip></descripGrp><ntig><termGrp><term id="133968">wireless LAN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630931">trådlaust lokalnett</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5775_148897_631063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Editing that occurs within a structured document such as a well-formed XML document.</descrip></descripGrp><ntig><termGrp><term id="148897">structural editing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631063">strukturell redigering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="578_148201_1980802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the colors defined in a set of chosen colors. If you fill an object with a scheme color, the object's color changes whenever you choose another color scheme for that publication.</descrip></descripGrp><ntig><termGrp><term id="148201">scheme color</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980802">farge i fargeval</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5788_2731405_1796714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Exchange Mailbox assistant that applies and processes the message retention settings based on retention policies.</descrip></descripGrp><ntig><termGrp><term id="2731405">Managed Folder Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1796714">postboksassistent for administrerte mapper</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></t