">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48692_2754091_2758273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical letter sent to a person requesting a number to verify that he/she resides in the same area where he/she would like to purchase a number.</descrip></descripGrp><ntig><termGrp><term id="2754091">verification letter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2758273">stadfestingsbrev</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48693_2754106_2759878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disabled user object that can be used to represent and assign resources within Azure, Office 365, and Skype.</descrip></descripGrp><ntig><termGrp><term id="2754106">resource account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2759878">ressurskonto</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48694_2754396_2758267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kaizala chat feature that allows users to send confidential information in a one-to-one chat more securely by not allowing message content to be forwarded or copied, by blocking messages from showing up in notifications, and by automatically deleting them after they are read.</descrip></descripGrp><ntig><termGrp><term id="2754396">Secret Chat</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2758267">Hemmeleg chat</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48695_2754398_2758269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who has been invited by their group admin to download and join Kaizala, but who hasn't.</descrip></descripGrp><ntig><termGrp><term id="2754398">unregistered user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2758269">uregistrert brukar</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48697_2754411_2758261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Diagnostic Data Viewer setting that allows users to view Office diagnostic data from a different machine.</descrip></descripGrp><ntig><termGrp><term id="2754411">Remote Office diagnostic data viewing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2758261">Ekstern vising av Office-diagnosedata</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48698_2754414_2758256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of diagnostic data that is collected and sent to Microsoft about Office client software being used on computers running Windows that is used to keep Office secure and up-to-date, detect, diagnose and remediate problems, as well as to make product improvements.</descrip></descripGrp><ntig><termGrp><term id="2754414">Office diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2758256">Office-diagnosedata</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="487_146725_631044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The "one" side of two related tables in a one-to-many relationship. A primary table should have a primary key and each record should be unique.</descrip></descripGrp><ntig><termGrp><term id="146725">primary table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631044">primærtabell</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48703_2754422_2758259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Diagnostic Data Viewer setting that allows users to see what Office diagnostic data is being collected.</descrip></descripGrp><ntig><termGrp><term id="2754422">Office diagnostic data viewing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2758259">Vising av Office-diagnosedata</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48704_2754423_2758254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that consists of the IP address of the user's Windows machine and the port number that the DDV app is listening on.</descrip></descripGrp><ntig><termGrp><term id="2754423">Office connection string</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2758254">Office-tilkoplingsstreng</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48720_2754440_2758263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A minimum amount of diagnostic data necessary to help keep Office secure, up-to-date, and performing as expected on the device it’s installed on.</descrip></descripGrp><ntig><termGrp><term id="2754440">required diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2758263">nødvendige diagnosedata</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48721_2754441_2758197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office experience that provides some of its essential functionality through the use of cloud-based services. Connected experiences are Office experiences that download online content for use in Office (such as templates, images or new fonts) and/or analyze Office content (such as to provide editing suggestions or design recommendations).</descrip></descripGrp><ntig><termGrp><term id="2754441">connected experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2758197">tilkopla funksjon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48722_2754443_2758203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected experience that is not included in Office 365 ProPlus.</descrip></descripGrp><ntig><termGrp><term id="2754443">additional optional connected experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2758203">valfri tilkopla tilleggsfunksjon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48723_2754445_2758242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of data that enables the delivery of cloud-based connected experiences and that helps make those experiences secure and perform as expected.</descrip></descripGrp><ntig><termGrp><term id="2754445">necessary service data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2758242">nødvendige tenestedata</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48724_2754447_2758230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of necessary service data that consists of content users create using Office, such as text typed in a Word document.</descrip></descripGrp><ntig><termGrp><term id="2754447">customer content</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2758230">kundeinnhald</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48725_2754449_2758237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of necessary service data needed by a connected experience to perform its task, such as configuration information about the app.</descrip></descripGrp><ntig><termGrp><term id="2754449">functional data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2758237">funksjonsdata</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48726_2754450_2758268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of necessary service data needed to keep the service secure, up to date, and performing as expected and is strictly related to a connected experience.</descrip></descripGrp><ntig><termGrp><term id="2754450">service diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2758268">tenestediagnosedata</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48727_2754452_2758233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that needs to run and send data to Microsoft in order for Office to function properly.</descrip></descripGrp><ntig><termGrp><term id="2754452">essential service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2758233">viktig teneste</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48739_2755816_2759881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to technology that is designed to be used without touch.</descrip></descripGrp><ntig><termGrp><term id="2755816">hands-free</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2759881">handfri</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48741_2756423_2759533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of diagnostic data user can opt out of providing and that is used to make product improvements and provides enhanced information to help detect, diagnose, and remediate issues.</descrip></descripGrp><ntig><termGrp><term id="2756423">optional diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2759533">valfrie diagnosedata</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48742_2756424_2759539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of optional diagnostic data that indicates installed products and their version, install and uninstall status, software add-ins and their settings, and installed products and version installation status and updates readiness.</descrip></descripGrp><ntig><termGrp><term id="2756424">software setup and inventory data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2759539">data om programvareinstallasjon og -behaldning</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48743_2756425_2759538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The optional diagnostic data that indicates successful app function that individual features or aspects of the application have triggered, the functioning of Office accessibility features, and privacy obligations.</descrip></descripGrp><ntig><termGrp><term id="2756425">product and service usage data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2759538">data om produkt- og tenestebruk</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48744_2756426_2759535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of optional diagnostic data that indicates an unexpected application exit and the state of that application at the time, as well as poor response time or performance for different product use scenarios.</descrip></descripGrp><ntig><termGrp><term id="2756426">product and service performance data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2759535">data om produkt- og tenesteyting</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48745_2756428_2759517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of optional diagnostic data that indicates the connection state and key device settings, such as memory.</descrip></descripGrp><ntig><termGrp><term id="2756428">device connectivity and configuration data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2759517">data om einingstilkopling og -konfigurasjon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48746_2756498_2759516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of data that is owned by an organization rather than an individual.</descrip></descripGrp><ntig><termGrp><term id="2756498">company data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2759516">firmadata</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48749_2757085_2759518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint administrator for a satellite or the central location.</descrip></descripGrp><ntig><termGrp><term id="2757085">geo administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2759518">geografisk administrator</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48752_2757089_2759524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for OneDrive that includes Multi-Geo Capabilities.</descrip></descripGrp><ntig><termGrp><term id="2757089">OneDrive Multi-Geo</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2759524">OneDrive Multi-Geo</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48753_2757091_2759523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search in a multi-geo environment where queries can be sent to the index in each geo location and returned into a single result set.</descrip></descripGrp><ntig><termGrp><term id="2757091">multi-geo search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2759523">søk i fleire geografiske område</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48754_2757092_2759520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a feature that can be separately configurated for its geo location or is otherwise aware of its geo location.</descrip></descripGrp><ntig><termGrp><term id="2757092">multi-geo aware</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:la