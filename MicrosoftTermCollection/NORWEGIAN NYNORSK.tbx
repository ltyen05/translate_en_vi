ote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10114_115262_630825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to interpret vocal commands or convert spoken words into computer-readable text. Speech recognition programs enable you to control an application or enter text by speaking into a microphone, rather than by using a keyboard.</descrip></descripGrp><ntig><termGrp><term id="115262">speech recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630825">taleattkjenning</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10114_115263_630825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to interpret vocal commands or convert spoken words into computer-readable text. Speech recognition programs enable you to control an application or enter text by speaking into a microphone, rather than by using a keyboard.</descrip></descripGrp><ntig><termGrp><term id="115263">voice recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630825">taleattkjenning</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10127_38090_2371235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of hardware devices or software packages to transmit data between other devices or packages.</descrip></descripGrp><ntig><termGrp><term id="38090">connectivity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2371235">tilkopling</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10128_100700_630771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To update displayed information with current data.</descrip></descripGrp><ntig><termGrp><term id="100700">refresh</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630771">oppdatere</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10133_397206_1796925"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string value that is used to identify a named property within a given property set. Note that property names and property IDs are mutually exclusive.</descrip></descripGrp><ntig><termGrp><term id="397206">property name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1796925">eigenskapsnamn</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10136_206430_228064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard color space that enables various devices including cameras, scanners, displays, and printers to produce reasonably identical colors. scRGB is optimized for greater than 8 bits per channel with a gamma of 1.0, and white point and primaries identical to sRGB. The scRGB color space is based on sRGB but offers a larger color gamut and precision by encoding values over 1.0 (white) and under 0.0 (black) with more bits per channel.</descrip></descripGrp><ntig><termGrp><term id="206430">scRGB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="228064">scRGB</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10136_226562_228064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard color space that enables various devices including cameras, scanners, displays, and printers to produce reasonably identical colors. scRGB is optimized for greater than 8 bits per channel with a gamma of 1.0, and white point and primaries identical to sRGB. The scRGB color space is based on sRGB but offers a larger color gamut and precision by encoding values over 1.0 (white) and under 0.0 (black) with more bits per channel.</descrip></descripGrp><ntig><termGrp><term id="226562">sRGB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="228064">scRGB</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1014_522495_630689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software system that enables applications to interact with hardware and that manages software resources on a computer.</descrip></descripGrp><ntig><termGrp><term id="522495">OS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630689">operativsystem</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1014_87933_630689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software system that enables applications to interact with hardware and that manages software resources on a computer.</descrip></descripGrp><ntig><termGrp><term id="87933">operating system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630689">operativsystem</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10140_168764_1206060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A static image of a set of data, such as the records displayed as the result of a query.</descrip></descripGrp><ntig><termGrp><term id="168764">snapshot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1206060">augneblinksbilete</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10140_168764_631142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A static image of a set of data, such as the records displayed as the result of a query.</descrip></descripGrp><ntig><termGrp><term id="168764">snapshot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631142">skuggekopi</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10140_168765_1206060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A static image of a set of data, such as the records displayed as the result of a query.</descrip></descripGrp><ntig><termGrp><term id="168765">shadow copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1206060">augneblinksbilete</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10140_168765_631142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A static image of a set of data, such as the records displayed as the result of a query.</descrip></descripGrp><ntig><termGrp><term id="168765">shadow copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631142">skuggekopi</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10142_1166009_2567699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One segment of a pie chart.</descrip></descripGrp><ntig><termGrp><term id="1166009">wedge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2567699">sektor</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10142_207674_2567699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One segment of a pie chart.</descrip></descripGrp><ntig><termGrp><term id="207674">pie slice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2567699">sektor</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10153_101934_1538582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A build promoted for use or deployment. A release can be internal and used for further testing or external and released or deployed.</descrip></descripGrp><ntig><termGrp><term id="101934">release</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1538582">utgåve</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10156_207679_228066"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The top-level object that represents the application to the system. The system calls methods on this object when the application is loaded, before it is shut down, and throughout the lifetime of the application to notify it of system-wide events. The application object contains application-wide code and maintains state that can be accessed from multiple views.</descrip></descripGrp><ntig><termGrp><term id="207679">application object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="228066">programobjekt</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10158_217263_232080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an Extensible Markup Language (XML) document that is syntactically correct.</descrip></descripGrp><ntig><termGrp><term id="217263">well-formed</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="232080">korrekt utforma</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10161_17417_2410678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To grant a person, computer process, or device access to certain information, services or functionality.</descrip></descripGrp><ntig><termGrp><term id="17417">authorize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2410678">godkjenne</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10162_207685_228071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section in an Extensible Markup Language (XML) document, bracketed by [!CDATA[[ and ]]] characters. All data in this section, including markup tags, is treated as normal characters by the XML parser.</descrip></descripGrp><ntig><termGrp><term id="207685">CDATA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="228071">CDATA</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10172_207705_228087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that has a run time of O(n); that is, if the function operates on a collection of n items, the function might have to examine each item in the collection, performing up to n comparisons.</descrip></descripGrp><ntig><termGrp><term id="207705">linear time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="228087">lineær tid</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10179_143328_1980764"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar marked off in units of measure (such as inches) that is displayed across the top of the document window.</descrip></descripGrp><ntig><termGrp><term id="143328">horizontal ruler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980764">vassrett linjal</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1018_32207_630279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To press and release a mouse button once without moving the mouse, usually to select or deselect an item or to activate a program or program feature.</descrip></descripGrp><ntig><termGrp><term id="32207">click</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630279">klikke</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10180_131401_630921"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image that appears as the background to a document. Generally faded and transparent, so that text can be clearly read over it.</descrip></descripGrp><ntig><termGrp><term id="131401">watermark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630921">vassmerke</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10184_207709_228091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual stream that efficiently stores data objects that are much smaller than the normal sector size. Sectors in this virtual stream are typically 64 bytes in length compared with 512 bytes for normal sectors.</descrip></descripGrp><ntig><termGrp><term id="207709">mini stream</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="228091">ministraum</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10185_207712_228094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event instance that propagates through a tree of related elements rather than just targeting to a single element.</descrip></descripGrp><ntig><termGrp><term id="207712">routed event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="228094">ruta hending</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10186_126193_2300506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove oneself as a recipient on a mailing list.</descrip></descripGrp><ntig><termGrp><term id="126193">unsubscribe</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2300506">stoppe abonnement</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10188_42237_630355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A representation of concepts such as facts or instructions in a formalized manner, suitable for communication, interpretation or processing.</descrip></descripGrp><ntig><termGrp><term id="42237">data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630355">data</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10189_110172_1980693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that separates groups of controls (on a surface) or commands (on a menu).</descrip></descripGrp><ntig><termGrp><term id="110172">separator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980693">skiljeline</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10189_722343_1980693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that separates groups of controls (on a surface) or commands (on a menu).</descrip></descripGrp><ntig><termGrp><term id="722343">separator bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980693">skiljeline</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1019_36322_630310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree to which a computer, an attached device, a data file, or a program can work with or understand the same commands, formats, or language as another. True compatibility means that any operational differences are invisible to people and programs alike.</descrip></descripGrp><ntig><termGrp><term id="36322">compatibility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630310">kompatibilitet</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10190_122191_630877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A command button used in a toolbar (or status bar).</descrip></descripGrp><ntig><termGrp><term id="122191">toolbar button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630877">verktøylineknapp</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10195_185726_1980880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button in the Options dialog box, on the Phones tab, that the user clicks to enter his or her home phone number.</descrip></descripGrp><ntig><termGrp><term id="185726">Home Phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980880">Privattelefon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10206_718_232062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any technology used to protect the interests of owners of digital content and services (such as copyright owners). Typically, authorized recipients or users must acquire a license in order to use the content.</descrip></descripGrp><ntig><termGrp><term id="718">digital rights management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammat