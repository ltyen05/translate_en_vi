 in which paid ads are displayed among search results.</descrip></descripGrp><ntig><termGrp><term id="3031665">search advertising</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="3032663">søkjeannonsering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53214_3031666_3032664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ad that appears in search engine results and is used to place a brand's message at the critical moment when a user is actively looking for a brand or solution via keyword search.</descrip></descripGrp><ntig><termGrp><term id="3031666">search ad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="3032664">søkjeannonse</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53215_3031667_3032675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search ad that automatically target relevant search queries based on the content of your website, and is dynamically created to respond to these search queries.</descrip></descripGrp><ntig><termGrp><term id="3031667">dynamic search ad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="3032675">dynamisk søkjeannonse</term><termNote type="geographicalUsage">NOR</termNote><ter