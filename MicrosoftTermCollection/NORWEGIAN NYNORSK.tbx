53"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The action of pressing the stick downward.</descrip></descripGrp><ntig><termGrp><term id="1991497">click</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2918553">klikk</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34388_1991498_2918578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The wired controller cable.</descrip></descripGrp><ntig><termGrp><term id="1991498">controller cable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2918578">kontrollarleidning</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34389_1991499_2918566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button on both the wireless controller and the console used to make a permanent attachment between the controller and console.</descrip></descripGrp><ntig><termGrp><term id="1991499">connect button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2918566">tilkoplingsknapp</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">S