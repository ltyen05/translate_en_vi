orm a specific task, such as word processing, accounting, or data management.</descrip></descripGrp><ntig><termGrp><term id="95380">program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1522537">app</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7702_95380_630752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions that a computer or device uses to perform a specific task, such as word processing, accounting, or data management.</descrip></descripGrp><ntig><termGrp><term id="95380">program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630752">program</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7702_95381_1522537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions that a computer or device uses to perform a specific task, such as word processing, accounting, or data management.</descrip></descripGrp><ntig><termGrp><term id="95381">application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1522537">app</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="gr