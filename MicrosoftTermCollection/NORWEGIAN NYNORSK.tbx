n a network.</descrip></descripGrp><ntig><termGrp><term id="15941">asynchronous transfer mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630156">asynkron overføringsmodus</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5870_725947_630721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows x86-based computers to support more than 4 gigabytes (GB) of physical memory. Up to 64 GB of physical memory can be used as regular 4-kilobyte (KB) pages, and the number of bits that can be used by the kernel to address physical memory can be expanded from 32 to 36.</descrip></descripGrp><ntig><termGrp><term id="725947">physical address expansion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630721">fysisk adresseutviding</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5870_725947_630722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows x86-based computers to support more than 4 gigabytes (GB) of physical memory. Up to 64 GB of physical memory can be used as regular 4-kilobyte (KB) pages, and the number of bits that can be used by the kernel to address physical memory can be expanded from 32 to 36.</descrip></descripGrp><ntig><termGrp><term id="725947">physical address expansion</term><termNote type="partOfSpeech"