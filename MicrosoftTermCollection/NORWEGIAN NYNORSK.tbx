</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35685_2488791_2123550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A licensing mode that enables Office 365 subscribers to access their account from different computers and that allows multiple users belonging to the same subscription to log in and use their account from the same computer.</descrip></descripGrp><ntig><termGrp><term id="2488791">SCA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2123550">aktivering av delt datamaskin</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35686_2052903_2123549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email sent at a specified time to a user to remind them of an upcoming event. Users can create reminder emails for themselves for any event in their calendars and for all attendees (when users are also the organizers). The email contains all details of the event and optional notes that users might add.</descrip></descripGrp><ntig><termGrp><term id="2052903">email reminder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2123549">e-postpåminning</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></l