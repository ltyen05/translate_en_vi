re the Scroll Lock setting.</descrip></descripGrp><ntig><termGrp><term id="108242">SCROLL LOCK key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630790">Scroll Lock</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6894_318712_631778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statement that the text or program code contained within the item on which the notice appears is the intellectual property of Microsoft (or other entity).</descrip></descripGrp><ntig><termGrp><term id="318712">copyright notice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631778">opphavsrettserklæring</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6904_108595_1522698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To try to locate something (a file, a folder, a computer, a text).</descrip></descripGrp><ntig><termGrp><term id="108595">search</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1522698">søkje</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp><