></descripGrp><ntig><termGrp><term id="783225">touchscreen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2929941">berøringsskjerm</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31700_1612766_1647097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To purchase an app after downloading, installing and trying it out.</descrip></descripGrp><ntig><termGrp><term id="1612766">purchase after trial</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1647097">kjøpe etter prøveperiode</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31701_1612767_1647096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image uploaded by the developer that Microsoft can use as a part of promotion via Featured lists and/or marketing campaigns.</descrip></descripGrp><ntig><termGrp><term id="1612767">promotional image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1647096">reklamebilete</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31702_1612772_1769373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operating system process that closes apps that are not foreground apps to conserve system resources, enhance battery life, and remove the burden of app management, task management, or both, from the user. When the user switches back or re-launches the app, the app starts right where it left off.</descrip></descripGrp><ntig><termGrp><term id="1612772">Process Lifetime Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769373">PLM</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31702_1612772_1769374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operating system process that closes apps that are not foreground apps to conserve system resources, enhance battery life, and remove the burden of app management, task management, or both, from the user. When the user switches back or re-launches the app, the app starts right where it left off.</descrip></descripGrp><ntig><termGrp><term id="1612772">Process Lifetime Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1769374">Process Lifetime Management</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31702_1612774_1769373"><langSet xml:lang="en-US"><descripGrp><des