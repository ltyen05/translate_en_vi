t></termEntry><termEntry id="18942_651778_1453084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any one-dimensional (1-D) shape that can be glued between two shapes in a drawing to connect the shapes.</descrip></descripGrp><ntig><termGrp><term id="651778">connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1453084">kopling</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1895_186189_1980894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the presets for 3D rotation effects. When selected, specifies that the object will be rotated off-axis.</descrip></descripGrp><ntig><termGrp><term id="186189">off-axis</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980894">utanfor akse</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1896_335535_2543494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database that is shared out to other users. These users create their own local copies, which are periodically synchronized with the shared database.</descrip></descripGrp><ntig><termGrp><term id="335535">shared database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2543494"