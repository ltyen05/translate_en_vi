termEntry id="8445_418610_1981027"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The identity of the originator of an incoming call.</descrip></descripGrp><ntig><termGrp><term id="418610">caller ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981027">oppringar-ID</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8445_418610_2793677"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The identity of the originator of an incoming call.</descrip></descripGrp><ntig><termGrp><term id="418610">caller ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2793677">oppringjar-ID</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8464_307372_631636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A parameter in the Perlin Noise function which is used to scale the amount of force from the vector field that is applied to the images.</descrip></descripGrp><ntig><termGrp><term id="307372">turbulence force</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631636">turbulenskraft</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8465_207706_228088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Presentation Foundation, the tree containing all the elements and content that are directly created by an application and used for a user interface element. For the specified element, the logical tree is not a strict subset of its visual tree, because elements derived from the Visual base class might contain elements that are not derived from the Visual class. For example, the elements might contain a String, a TextElement, or any other common language runtime object.</descrip></descripGrp><ntig><termGrp><term id="207706">logical tree</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="228088">logisk tre</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8466_149730_2540257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default data type for variables that don't have type-declaration characters when a Deftype statement isn't in effect. A Variant can store numeric, string, date/time, Null, or Empty data.</descrip></descripGrp><ntig><termGrp><term id="149730">Variant data type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540257">datatypen Variant</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGr