ngSet xml:lang="en-US"><descripGrp><descrip type="definition">A linked object that could contain a virus or other threat.</descrip></descripGrp><ntig><termGrp><term id="2857917">unsafe linked object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2860335">usikkert kopla objekt</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50496_2858214_2860340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Office app for mobile devices that allows users to dictate and record their dictation in MSWord.</descrip></descripGrp><ntig><termGrp><term id="2858214">Word Dictation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2860340">Word-diktering</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50497_2858228_2866343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component-based document model for developers who create collaborative text editing apps that includes options for real-time sharing of edits within documents, shared editable templates, and rich content editing options.</descrip></descripGrp><ntig><termGrp><term id="2858228">Microsoft Fluid Framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2866343