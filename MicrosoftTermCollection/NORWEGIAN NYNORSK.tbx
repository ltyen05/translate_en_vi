ripGrp><descrip type="definition">The Skype for Business web app that allows users, even those without a Skype account, to join Skype meeting from their wed browser.</descrip></descripGrp><ntig><termGrp><term id="2219973">Skype for Business Web App</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2545728">Skype for Business Web App</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38338_2219974_2545729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A plug-in required for audio, video, and screen sharing during a Skype for Business Meeting</descrip></descripGrp><ntig><termGrp><term id="2219974">Skype for Business Web App Plug-in</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2545729">Plugin-modul for Skype for Business Web App</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38339_2219975_2545764"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optional feature of Skype for Business Online that enables users to make calls to, and receive calls from, the traditional network by using Skype for Business This feature is available to Voice Plan customers only, and administrators must sign in with a Skype-to-phone provider to get the feature.</descrip></descripGrp><ntig><termGrp><term id="2219975">Skype-to-phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2545764">Skype til telefon</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38348_2221503_2228220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button in Sway that allows users to emphasize or deemphasize content in relationship to other content.</descrip></descripGrp><ntig><termGrp><term id="2221503">Emphasize</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2228220">Framhev</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3837_319443_1796738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A MAPI message that holds the delivery information for a message.</descrip></descripGrp><ntig><termGrp><term id="319443">message transfer envelope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1796738">konvolutt for meldingsoverføring</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3837_319443_1796776"><langSet xml:lang="en-US"><de