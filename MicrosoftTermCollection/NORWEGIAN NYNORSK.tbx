termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51171_2887902_2889266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual visual effect displayed behind a video call/meeting participant's camera-captured image.</descrip></descripGrp><ntig><termGrp><term id="2887902">background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2889266">bakgrunn</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51171_2887902_2889267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual visual effect displayed behind a video call/meeting participant's camera-captured image.</descrip></descripGrp><ntig><termGrp><term id="2887902">background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2889267">bakgrunnseffekt</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51172_2887897_2889268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A meeting with a video stream of its participants.</descrip></descripGrp><ntig><termGrp><term id="2887897">video meeting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2889268">videomøte</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5119_319158_631814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The distance or period of time between a specified start point and a specified end point. For example, the length of an audio or video clip is usually measured in minutes and seconds.</descrip></descripGrp><ntig><termGrp><term id="319158">length</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631814">lengd</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="512_14369_1980632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of chart that displays the trend of values over time or categories. By displaying the sum of the plotted values, an area chart also shows the relationship of parts to a whole.</descrip></descripGrp><ntig><termGrp><term id="14369">area chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980632">arealdiagram</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5121_73528_1980674"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of symbolic resolution where a symbol is resolved to a specific software routine during program execution instead of during program compilation, enabling polymorphism in object-oriented programs.</descrip></descripGrp><ntig><termGrp><term id="73528">late binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980674">sein binding</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5121_73529_1980674"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of symbolic resolution where a symbol is resolved to a specific software routine during program execution instead of during program compilation, enabling polymorphism in object-oriented programs.</descrip></descripGrp><ntig><termGrp><term id="73529">dynamic binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1980674">sein binding</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5123_26059_630226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To store frequently used data values in a special memory subsystem for quick access.</descrip></descripGrp><ntig><termGrp><term id="26059">cache</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630226">hurtigbufre</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51236_2889600_2889808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that limits battery charging capacity to 50%, which slows the aging process and prolongs battery longevity.</descrip></descripGrp><ntig><termGrp><term id="2889600">Battery Limit Mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2889808">modus for avgrensa batterilading</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51237_2889601_2889810"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that helps protect a battery from the cumulative negative effects of consistent and recurrent use at high temperatures or high states of charge by monitoring battery conditions continuously and implementing a limited number of permanent reductions in charging voltage if these adverse conditions are detected.</descrip></descripGrp><ntig><termGrp><term id="2889601">Battery Lifespan Saver</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2889810">funksjon for forlenging av batteridriftstid</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5127_340084_631910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add new text, objects or cells without overwriting existing data.</descrip></descripGrp><ntig><termGrp><term id="340084">insert</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631910">setje inn</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5128_319431_631823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to characters that are evenly slanted to the right or in the direction of text flow.</descrip></descripGrp><ntig><termGrp><term id="319431">italic</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631823">kursiv</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5129_415567_1796921"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action or occurrence to which a program might respond. Examples include state changes, data transfers, key presses, and mouse movements.</descrip></descripGrp><ntig><termGrp><term id="415567">program event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1796921">programhending</term><termNote ty