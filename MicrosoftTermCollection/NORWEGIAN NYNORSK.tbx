n a television set is tuned to a channel over which no station is broadcasting.</descrip></descripGrp><ntig><termGrp><term id="132570">white noise</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921644">kvit støy</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12826_245065_631412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An inability to perform two or more activities because they have been scheduled to occur during the same time period and with the same resource or resources.</descrip></descripGrp><ntig><termGrp><term id="245065">conflict</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="631412">konflikt</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12827_27727_2529249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To record digital data in a file such as audio, video, or still images.</descrip></descripGrp><ntig><termGrp><term id="27727">capture</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2529249">ta opp</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelect