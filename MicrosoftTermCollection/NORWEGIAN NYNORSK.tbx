64917">Current Channel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2371555">Oppdatert kanal</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40477_2733044_2951633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The servicing option in which new feature upgrades are available for installation after first published by Microsoft, enabling long-term deployment of selected releases in low-change configurations. The minimum length of servicing lifetime is approximately 10 years.</descrip></descripGrp><ntig><termGrp><term id="2733044">Long Term Servicing Channel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2951633">LTSC</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40477_2733044_2953987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The servicing option in which new feature upgrades are available for installation after first published by Microsoft, enabling long-term deployment of selected releases in low-change configurations. The minimum length of servicing lifetime is approximately 10 years.</descrip></descripGrp><ntig><termGrp><term id="2733044">Long Term Servicing Channel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><