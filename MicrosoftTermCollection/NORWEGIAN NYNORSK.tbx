ig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="3114582">Insider</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46062_2595010_2885534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that allows passionate Xbox fans the opportunity to give Microsoft feedback on the latest Xbox One System updates, as well as features and games still in development on both the Xbox One console and Windows 10 PCs.</descrip></descripGrp><ntig><termGrp><term id="2595010">Xbox Insider Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2885534">Insider Program</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46062_2595010_2921716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that allows passionate Xbox fans the opportunity to give Microsoft feedback on the latest Xbox One System updates, as well as features and games still in development on both the Xbox One console and Windows 10 PCs.</descrip></descripGrp><ntig><termGrp><term id="2595010">Xbox Insider Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2921716">Xbox Insider Program</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</