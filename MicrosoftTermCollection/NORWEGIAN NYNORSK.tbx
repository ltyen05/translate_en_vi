<descrip type="definition">An event whose handler runs in the same processing thread as the action that raised the event. The action cannot continue until processing is complete for the event handler.</descrip></descripGrp><ntig><termGrp><term id="1098536">synchronous event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2540412">synkron hending</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24106_1098539_1981347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A synchronous event whose handler runs completely before the action that raised the event starts.</descrip></descripGrp><ntig><termGrp><term id="1098539">before event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981347">tidlegare-hending</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24106_1098540_1981347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A synchronous event whose handler runs completely before the action that raised the event starts.</descrip></descripGrp><ntig><termGrp><term id="1098540">pre-event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="1981347">tidlegare-hending</term><termNote type="geographicalUsage">NOR</termNote><termNote t