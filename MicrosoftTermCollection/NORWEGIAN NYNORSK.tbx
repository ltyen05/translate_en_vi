<termEntry id="3838_47370_630405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar that is attached to one edge of the program window. When you drag a toolbar below the program title bar or to the left, right, or bottom edge of the window, the toolbar snaps into place on the edge of the program window.</descrip></descripGrp><ntig><termGrp><term id="47370">docked toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="630405">forankra verktøyline</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3839_262444_2543341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photorealistic graphics file format designed for systems with a TARGA Truevision display adapter.</descrip></descripGrp><ntig><termGrp><term id="262444">TGA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><termGrp><term id="2543341">TGA</term><termNote type="geographicalUsage">NOR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3839_370703_2543341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photorealistic graphics file format designed for systems with a TARGA Truevision display adapter.</descrip></descripGrp><ntig><termGrp><term id="370703">Targa</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="nn-NO"><ntig><ter