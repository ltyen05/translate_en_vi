hich are part of the role-based access control (RBAC) permissions model in Exchange Server 2010.</descrip></descripGrp><ntig><termGrp><term id="1216616">administrator role group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962658">کردار گروپ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25779_1216616_1985463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A universal security group with administrative rights assigned to it. These administrative rights are specified by built-in management roles, which are part of the role-based access control (RBAC) permissions model in Exchange Server 2010.</descrip></descripGrp><ntig><termGrp><term id="1216616">administrator role group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1985463">منتظم کردار گروپ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25779_1230147_1962658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A universal security group with administrative rights assigned to it. These administrative rights are specified by built-in management roles, which are part of the role-based access control (RBAC) permissions model in Exchange Server 2010.</descrip></descripGrp><ntig><termGrp><term id="1230147">role group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumb