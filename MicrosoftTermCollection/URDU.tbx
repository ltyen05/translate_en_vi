with your PC by accessing and taking control of it over a remote connection.</descrip></descripGrp><ntig><termGrp><term id="2373342">Quick Assist</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3160993">Microsoft فوری مدد</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41921_3160521_2373690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app included in Windows that allows a trusted friend or support professional to help solve a problem with your PC by accessing and taking control of it over a remote connection.</descrip></descripGrp><ntig><termGrp><term id="3160521">Microsoft Quick Assist</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2373690">فوری مدد</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41921_3160521_3160993"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app included in Windows that allows a trusted friend or support professional to help solve a problem with your PC by accessing and taking control of it over a remote connection.</descrip></descripGrp><ntig><termGrp><term id="3160521">Microsoft Quick Assist</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3160993">Microsoft فوری مدد</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41931_2374260_2378023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Zoom feature that allows users to create a pictorial table of contents containing a collection of their Section Zooms and that can update if the presentation is edited.</descrip></descripGrp><ntig><termGrp><term id="2374260">Summary Zoom</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2378023">خلاصہ زوم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41932_2374261_2378022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Zoom feature that presents a preview of a slide in a presentation which auto-updates when the slide is updated and navigates users to that slide when they click on the preview</descrip></descripGrp><ntig><termGrp><term id="2374261">Slide Zoom</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2378022">سلائڈ زوم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41933_2374264_2378021"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Zoom feature that presents a preview of a section in a presentation which auto-updates when the section’s first slide is updated, navigates users to that section when they click on the preview, and returns them back to the Summary Zoom when they are done.</descrip></descripGrp><ntig><termGrp><term id="2374264">Section Zoom</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2378021">سیکشن زوم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41938_2374322_2511219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that teachers can use to provision student PCs for classroom use.​</descrip></descripGrp><ntig><termGrp><term id="2374322">Set up School PCs</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2511219">اسکول PC سیٹ اپ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41939_2374323_2511222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The education app used for secure, online assessments, such as exams. It doesn't allow test takers to access resources stored on their device or the internet; it prevents OS-level distractions; and it doesn't allow test-takers to share test content with other students.​</descrip></descripGrp><ntig><termGrp><term id="2374323">Take a Test</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2511222">ایک ٹیسٹ لیں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41946_2375030_2378117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for games that are rented most over time.</descrip></descripGrp><ntig><termGrp><term id="2375030">Most rented games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2378117">سب سے زیادہ کرایہ پر لی جانے والی گیمز</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41947_2375031_2378116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for apps that are rented most over time.</descrip></descripGrp><ntig><termGrp><term id="2375031">Most rented apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2378116">سب سے زیادہ کرایہ پر لی جانے والی ایپس</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41948_2375032_2378115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition"