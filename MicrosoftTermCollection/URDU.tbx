p><term id="128620">video capture card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934176">ویڈیو پکڑنے والا آلہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5743_128621_1934176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that converts analog images (for example, from a television or VCR) into digital images.</descrip></descripGrp><ntig><termGrp><term id="128621">video capture device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934176">ویڈیو پکڑنے والا آلہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5754_228518_402506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The difference between two values, such as the difference between estimated and actual expenses.</descrip></descripGrp><ntig><termGrp><term id="228518">variance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402506">تغیر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5759_235060_402604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Control Panel item that allows the user to view saved networks and reconnect to them.</descrip></descripGrp><ntig><termGrp><term id="235060">Saved networks</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402604">محفوظ شدہ نیٹ ورک</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5761_7364_1985454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone number that subscribers can dial to reach online services.</descrip></descripGrp><ntig><termGrp><term id="7364">access number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1985454">رسائی نمبر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5766_1606_2700044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 16-byte value generated from the unique identifier on a device, the current date and time, and a sequence number that is used to identify a particular device, component, user, or session.</descrip></descripGrp><ntig><termGrp><term id="1606">globally-unique identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2700044">ہمہ گیر منفرد شناخت کنندہ</term><termNote type="geographicalUsage">PAK</termNote><termNote t