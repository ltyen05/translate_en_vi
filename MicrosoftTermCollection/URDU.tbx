r"><ntig><termGrp><term id="401741">ان پٹ/ آؤٹ پٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2711_63131_401740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The complementary tasks of gathering and distributing data. Input is data that is acquired from a device or entered by the user through a device. Output is data that is sent to a device.</descrip></descripGrp><ntig><termGrp><term id="63131">input/output</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401740">I/O</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2711_63131_401741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The complementary tasks of gathering and distributing data. Input is data that is acquired from a device or entered by the user through a device. Output is data that is sent to a device.</descrip></descripGrp><ntig><termGrp><term id="63131">input/output</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401741">ان پٹ/ آؤٹ پٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27118_1365371_1934665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single document that is converted as part of a conversion.</descrip></descripGrp><ntig><termGrp><term id="1365371">conversion item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934665">تبدیلی آئٹم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27130_1365513_2344834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software component that intermediates requests from client software components and responses from service or server software components that respond to those requests.</descrip></descripGrp><ntig><termGrp><term id="1365513">proxy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2344834">پراکسی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27131_1365515_1520628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online action, such as updating a status message, publishing photos, or updating profile info.</descrip></descripGrp><ntig><termGrp><term id="1365515">activity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1520628">سرگرمی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27134_1367496_1934666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference to a table or subset of a table by the table name and column specifier instead of cell coordinates.</descrip></descripGrp><ntig><termGrp><term id="1367496">structured reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934666">ساختی حوالہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27137_1367505_2344824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A commercial message that consists of a visual component (text, rich media, etc.) and associated metadata (URLs, placement information, etc.).</descrip></descripGrp><ntig><termGrp><term id="1367505">ad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2344824">اشتہار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2716_145576_3041423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The quality that defines how much light passes through an object's pixels. If an object is 100 percent opaque, no light passes through it.</descrip></descripGrp><ntig><termGrp><term id="145576">opacity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3041423">‏‏دُھندلا پن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2720_102645_1216881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The creation of an image containing geometric models, using color and shading to give the image a realistic look. Usually part of a geometric modeling package such as a CAD program, rendering uses mathematics to describe the location of a light source in relation to the object and to calculate the way in which the light would create highlights, shading, and variations in color. The degree of realism can range from opaque, shaded polygons to images approximating photographs in their complexity.</descrip></descripGrp><ntig><termGrp><term id="102645">rendering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1216881">صورت آرائی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2727_261574_402675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides detailed Web site statistics and reports related to the subscriber's Web site.</descrip></descripGrp><ntig><termGrp><term id="261574">Site Reports</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402675">سائٹ رپورٹیں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27270_1368065_1934667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application service for storing and handling an organization's documents.</descrip></descripGrp><ntig><termGrp><term id="1368065">document management system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934667">دستاویز کا انتظامی نظام</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="273_108331_402019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard Windows control that supports scrolling.</descrip></descripGrp><ntig><termGrp><term id="108331">scroll bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402019">سکرول بار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27311_1370396_1521398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action considered to have social relevance and that might appear in an activity feed. For example, photo activity and status updates are considered to be socially relevant.</descrip></descripGrp><ntig><termGrp><term id="1370396">social update</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1521398">تازہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27311_1375269_1521398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action considered to have social relevance and that might appear in an activity feed. For example, photo activity and status updates are considered to be socially relevant.</descrip></descripGrp><ntig><termGrp><term id="1375269">update</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1521398">تازہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27346_1370438_2333787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fault that occurs when a page sought in the file system cache is not found and must be retrieved from disk.</descrip></descripGrp><ntig><termGrp><term id="1370438">hard fault</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2333787">سخت خطا</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27346_1370438_2333788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fault that occurs when a page sought i