Speech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50963_2879286_2879658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An inspection of devices, mailboxes, and other types of entities performed automatically in response to various detections, after which remediation actions might be taken on malicious and suspicious items found during the investigation.</descrip></descripGrp><ntig><termGrp><term id="2879286">automated investigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2879658">خودکار تفتیش</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50964_2879287_2879659"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A threat remediation mechanism that automatically applies various actions, such as file quarantine or deletion of persistence mechanism in the registry, based on the results of a corresponding automated investigation.</descrip></descripGrp><ntig><termGrp><term id="2879287">automatic remediation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2879659">خودکار اصلاح</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50965_2879288_2879657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query-based proactive threat hunting capability that provides flexible options for locating undetected breach activity as well as network assets that require attention.</descrip></descripGrp><ntig><termGrp><term id="2879288">advanced hunting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2879657">اعلیٰ درجے کی تلاش</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50966_2879289_2879661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository of reports about emerging threats, including specific incidents and campaigns, threat techniques, and vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="2879289">threat analytics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2879661">خطرہ کے تجزیات</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50967_2879290_2879660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A malware detonation service that customers can use to submit suspicious files for automated analysis.</descrip></descripGrp><ntig><termGrp><term id="2879290">deep analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2879660">گہری تجزیہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpe