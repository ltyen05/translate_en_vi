 and keeps them up to date.</descrip></descripGrp><ntig><termGrp><term id="3022587">Microsoft SDS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3023049">Microsoft اسکول کوائف کی ہم وقت سازی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44491_3022587_3023050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Education service that imports data about teachers, students, and classes from external student information systems into Office 365 and keeps them up to date.</descrip></descripGrp><ntig><termGrp><term id="3022587">Microsoft SDS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3023050">Microsoft SDS</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44491_3022587_3023053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Education service that imports data about teachers, students, and classes from external student information systems into Office 365 and keeps them up to date.</descrip></descripGrp><ntig><termGrp><term id="3022587">Microsoft SDS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3023053">SDS</term><termNote type="geographicalUsage">PAK</termNote><