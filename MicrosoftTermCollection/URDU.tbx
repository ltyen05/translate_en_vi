5"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule associated with an object to regulate which users can gain access to the object and in what manner and that are assigned or denied by the object's owner.</descrip></descripGrp><ntig><termGrp><term id="592341">permission</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1585245">اجازت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16495_592342_1962639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies a certain Internet application. For example, the default port number for the WWW service is 80.</descrip></descripGrp><ntig><termGrp><term id="592342">port number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962639">دہانہ نمبر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16496_592343_1988768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An apartment that consists of exactly one thread.</descrip></descripGrp><ntig><termGrp><term id="592343">single-threaded apartment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1988768">واحد ڈوری اپارٹمنٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partO