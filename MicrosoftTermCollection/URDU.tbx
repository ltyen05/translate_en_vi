umber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15055_116264_402063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The condition at a particular time of any of numerous elements of computing--a device, a communications channel, a network station, a program, a bit, or other element--used to report on or to control computer operations.</descrip></descripGrp><ntig><termGrp><term id="116264">state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402063">حالت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15055_116265_402063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The condition at a particular time of any of numerous elements of computing--a device, a communications channel, a network station, a program, a bit, or other element--used to report on or to control computer operations.</descrip></descripGrp><ntig><termGrp><term id="116265">status</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402063">حالت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15067_7086_305434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security mechanism that determines which operations a user, group, service, or computer is authorized to perform on a computer or on a particular object, such as a file, printer, registry subkey, or directory service object.</descrip></descripGrp><ntig><termGrp><term id="7086">access control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="305434">رسائی پر قابو</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15076_413296_1962483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Exchange Server 2007 server role that provides email storage and advanced scheduling services for Microsoft Office Outlook users. The Mailbox server role also includes public folders, which provide a foundation for workflow, document sharing, and other forms of collaboration.</descrip></descripGrp><ntig><termGrp><term id="413296">Mailbox server role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962483">میل باکس سرور کا رول</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15086_5913_401317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integrated proofing tool used to search on common words and display synonyms.</descrip></descripGrp><ntig><termGrp><term id="5913">thesaurus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401317">معجم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15088_140956_402239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that appears dimmed on a form or data access page. A disabled control cannot get the focus and will not respond to mouse clicks.</descrip></descripGrp><ntig><termGrp><term id="140956">disabled control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402239">نااہل شدہ کنٹرول</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1509_101960_402000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The likelihood of a computer system or device continuing to function over a given period of time and under specified conditions.</descrip></descripGrp><ntig><termGrp><term id="101960">reliability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402000">معتبری</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15094_347947_403199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control on a form that contains other controls in a table format and that repeats as needed. Users can insert multiple rows when filling out the form.</descrip></descripGrp><ntig><termGrp><term id="347947">repeating table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="403199">دہراتا ہوا جدول</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15098_322615_403097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web site based on the Document Workspace template that workspace members use for discussing, editing, and working together on a document.</descrip></descripGrp><ntig><termGrp><term id="322615">Document Workspace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="403097">دستاویز کام جگہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15098_322615_403252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web site based on the Document Workspace template that workspace members use for discussing, editing, and working together on a document.</descrip></descripGrp><ntig><termGrp><term id="322615">Document Workspace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="403252">دستاویز کام جگہ سائٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15098_361653_40309