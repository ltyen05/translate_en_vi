icalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402528">مطالعہ جھروکا</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14721_427008_401806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation where the long dimension of a rectangular area (for example, screen, photo, or paper) is horizontal.</descrip></descripGrp><ntig><termGrp><term id="427008">landscape orientation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401806">افقی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14721_73296_401806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation where the long dimension of a rectangular area (for example, screen, photo, or paper) is horizontal.</descrip></descripGrp><ntig><termGrp><term id="73296">landscape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401806">افقی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14726_110688_402029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned to a specific inventory item to identify it and differentiate it from similar items with the same item number.</descrip></descripGrp><ntig><termGrp><term id="110688">serial number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402029">سلسلہ نمبر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14727_168754_1799874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical network connection between two entities such as a user or computer, that has a defined lifetime and associated state, and that might involve multiple physical connections.</descrip></descripGrp><ntig><termGrp><term id="168754">session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1799874">سیشن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14733_31389_401500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To pick a command or an option from within a graphical user interface, as by clicking a button in a dialog box or pulling down a menu and then releasing the mouse button on one of its options.</descrip></descripGrp><ntig><termGrp><term id="31389">choose</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401500">انتخاب کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14738_124210_1934174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measure used in typesetting and desktop publishing, equal to one-twentieth of a printer's point, or 1/1440th of an inch.</descrip></descripGrp><ntig><termGrp><term id="124210">twip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934174">ٹویپ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14742_375721_380545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature available in Outlook 2007 and some mobile devices that automatically configures the clients for access to Exchange Server 2007. The client sends the user name and password information to the Exchange 2007 server. The Autodiscover Web service that is running on the Exchange Client Access server returns an XML file that contains configuration information, which is interpreted by the client. If the user is moved to a different server later, the client will automatically query the Autodiscover Web service again to update the client configuration.</descrip></descripGrp><ntig><termGrp><term id="375721">Autodiscover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="380545">خود کار دریافت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14749_397189_410063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process by which Exchange Server creates and updates the OAB. Administrators can define when the OAB generation process will run.</descrip></descripGrp><ntig><termGrp><term id="397189">offline address book generation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="410063">آف لائن پتہ نامہ کی تیاری</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14749_397189_410064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process by which Exchange Server creates and updates the OAB. Administrators can define when the OAB generation process will run.</descrip></descripGrp><ntig><termGrp><term id="397189">offline address book generation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="410064">OAB کی تخلیق</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14749_397190_410063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process by which Exchange Server creates and updates the OAB. Administrators can define when the OAB generation process will run.</descrip></descripGrp><ntig><termGrp><term id="397190">OAB generation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="410063">آف لائن پتہ نامہ کی تیاری</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14749_397190_410064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process by which Exchange Server creates and updates the OAB. Administrators can define when the OAB generation process will run.</descrip></descripGrp><ntig><termGrp><term id="397190">OAB generation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="410064">OAB کی تخلیق</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14755_375732_380535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An SMTP namespace for which Microsoft an Exchange Server organization sends and receives email.</descrip></descripGrp><ntig><termGrp><term id="375732">accepted domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="380535">قبول کردہ ڈومین</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14758_410849_1962645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The characteristics or properties that define how a property is used and interpreted. The group of properties that forms a property definition is stored in a dictionary.</descrip></descripGrp><ntig><termGrp><term id="410849">property definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962645">خصوصیات کی تعریف</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14761_143306_1217536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web page editor command that inserts a horizontal line onto a Web page.</descrip></descripGrp><ntig><termGrp><term id="143306">Horizontal Line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217536">افقی لائن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14763_141747_402248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that enables a user to sample the color of any pixel on a screen and apply that color to an object.</descrip></descripGrp><ntig><termGrp><term id="141747">eyedropper</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402248">مقطار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote 