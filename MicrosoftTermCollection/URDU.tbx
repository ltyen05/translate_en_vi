rmNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2440320">میڈیا تراش</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42997_2436365_3113697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud-based solution that enables organizations to control user access to apps and data in the cloud and on-premises, to ensure only authorized users have access.</descrip></descripGrp><ntig><termGrp><term id="2436365">Azure AD Identity Governance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3113697">Microsoft Entra ID انتظامیہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42997_2436368_3113697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud-based solution that enables organizations to control user access to apps and data in the cloud and on-premises, to ensure only authorized users have access.</descrip></descripGrp><ntig><termGrp><term id="2436368">Azure Active Directory Identity Governance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3113697">Microsoft Entra ID انتظامیہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</ter