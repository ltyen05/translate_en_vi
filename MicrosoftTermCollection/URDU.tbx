OfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2826816">خودکار ترجمہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20752_747355_1217630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pencil tool that works with texture and simulates a real life pencil in stroke.</descrip></descripGrp><ntig><termGrp><term id="747355">natural pencil</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217630">قدرتی پنسل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20754_747357_1217631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that enables users to easily roll back their PC to an earlier good state while keeping their data safe.</descrip></descripGrp><ntig><termGrp><term id="747357">System Recovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217631">نظام بازیافت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2077_149214_1217389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view on a calendar that displays items such as meetings and events from left to right on a time scale and that can incorporate items from multiple calendars.</descrip></descripGrp><ntig><termGrp><term id="149214">timeline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217389">وقت لائن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20781_747562_2842993"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a call queue, a method of sending calls to agents whereby incoming calls ring all call agents one by one, from the beginning of the call agent list. If an agent dismisses or does not pick up a call, the call will ring the next agent and will try all agents until it is picked up or times out.</descrip></descripGrp><ntig><termGrp><term id="747562">serial routing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2842993">سیریل راؤٹنگ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20803_3193169_1217632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which multiple authors edit a shared document simultaneously, or collaborate effectively even when they are not online at the same time.</descrip></descripGrp><ntig><termGrp><term id="3193169">coauthoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217632">معاون مصنفی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20803_3193169_3193250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which multiple authors edit a shared document simultaneously, or collaborate effectively even when they are not online at the same time.</descrip></descripGrp><ntig><termGrp><term id="3193169">coauthoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3193250">معاون مصنفی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20803_747620_1217632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which multiple authors edit a shared document simultaneously, or collaborate effectively even when they are not online at the same time.</descrip></descripGrp><ntig><termGrp><term id="747620">co-authoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217632">معاون مصنفی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20803_747620_3193250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which multiple authors edit a shared document simultaneously, or collaborate effectively even when they are not online at the same time.</descrip></descripGrp><ntig><termGrp><term id="747620">co-authoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3193250">معاون مصنفی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20805_1043088_1433993"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client-side cache for documents that are stored on Web servers. Documents are seamlessly replicated from this local cache, and uploaded to servers as required, enabling faster and more robust file access.</descrip></descripGrp><ntig><termGrp><term id="1043088">Office Document Cache</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433993">آفس دستاویز کیسہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20805_747622_1433993"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client-side cache for documents that are stored on Web servers. Documents are seamlessly replicated from this local cache, and uploaded to servers as required, enabling faster and more robust file access.</descrip></descripGrp><ntig><termGrp><term id="747622">Microsoft Office Document Cache</term><termNote type="partOfSpeech">ProperNoun</termNote><ter