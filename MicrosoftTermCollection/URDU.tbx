ech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433951">ماسٹر صفحہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14774_397165_409918"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which an administrator can manually move a clustered mailbox server between nodes in a cluster. A handoff should only be performed by using the Move-ClusteredMailboxServer cmdlet in the Exchange Management Shell.</descrip></descripGrp><ntig><termGrp><term id="397165">handoff</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="409918">تبادلہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14775_146423_1217537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A box with dotted borders in a slide layout that holds title and body text or objects such as charts, tables, and pictures.</descrip></descripGrp><ntig><termGrp><term id="146423">placeholder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217537">جگہ دار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry>