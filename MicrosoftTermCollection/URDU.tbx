Speech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217374">سرتحریر صف</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9648_233439_305463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio message played over the telephone to explain valid options to users.</descrip></descripGrp><ntig><termGrp><term id="233439">prompt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="305463">فوری</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="965_317875_402972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To display the subentries contained within a folder or outline view.</descrip></descripGrp><ntig><termGrp><term id="317875">expand</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402972">وسیع کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9651_138544_1934193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual cue to indicate which formatting will be applied when you double-click: a left-aligned, centered, or