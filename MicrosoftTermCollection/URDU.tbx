termGrp></ntig></langSet></termEntry><termEntry id="38439_2227183_2228637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Windows that allows a person to connect remotely to someone else's computer to help fix a problem.</descrip></descripGrp><ntig><termGrp><term id="2227183">Windows Remote Assistance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2228637">Windows بعید معانت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3844_234764_402580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Internet Explorer in Windows Vista that finds XML feeds on a webpage. User can view the feeds and subscribe to them.</descrip></descripGrp><ntig><termGrp><term id="234764">Feed Discovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402580">فیڈ بازیافت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38440_2227688_2315042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user's video library title, displayed in the " Quick links" section, for movies and TV shows.</descrip></descripGrp><ntig><termGrp><term id="2227688">Your movies &amp; TV</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lan