ntig><termGrp><term id="475234">owner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2488766">مالک</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3084_77397_1216885"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location where email is delivered.</descrip></descripGrp><ntig><termGrp><term id="77397">mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1216885">میل باکس</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30861_1555644_2769526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customer's agreement that provides access to services and where pricing and related terms are governed by the offer chosen for the subscription.</descrip></descripGrp><ntig><termGrp><term id="1555644">subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2769526">سبسکرپشن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3087_178259_2735869"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mobile, larger form-factor computing device small enough to fit in a coat pocket that uses the Microsoft Windows CE or Windows Mobile operating system.</descrip></descripGrp><ntig><termGrp><term id="178259">Pocket PC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2735869">پاکٹ PC</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30900_1567772_1934696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To track content, people, or entities by adding them to a list of things for which you would like to surface updates about changes and activities.</descrip></descripGrp><ntig><termGrp><term id="1567772">follow</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934696">پیروی کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30961_1579321_1587049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that enables management of Hotmail email, calendar, and contacts from within Outlook.</descrip></descripGrp><ntig><termGrp><term id="1579321">Outlook Connector Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1587049">Outlook Connector Pack</term><termNote type="geographicalUsage">PAK</termNote>