45538">touchtone dialing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962535">ٹچ ٹون ڈائلنگ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24652_1145538_1962686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of dialing that uses multiple-tone signaling. The user hears a series of tones (beeps) when dialing.</descrip></descripGrp><ntig><termGrp><term id="1145538">touchtone dialing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962686">ٹچ ٹون</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24652_1145539_1962535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of dialing that uses multiple-tone signaling. The user hears a series of tones (beeps) when dialing.</descrip></descripGrp><ntig><termGrp><term id="1145539">touchtone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962535">ٹچ ٹون ڈائلنگ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24652_1145539_1962686"><langSet xm