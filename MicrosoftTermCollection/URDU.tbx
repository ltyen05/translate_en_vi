type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401365">AA</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28773_1496239_1985461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The stage during the email migration when the migration service is actively provisioning new cloud-based mailboxes.</descrip></descripGrp><ntig><termGrp><term id="1496239">active mailbox migration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1985461">فعال میل باکس منتقلی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28774_1496240_1985462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An auditing record that records any action, based on a Windows PowerShell cmdlet, performed by an administrator. This can help the administrator troubleshoot configuration issues or identify the cause of security- or compliance-related problems.</descrip></descripGrp><ntig><termGrp><term id="1496240">administrator audit log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1985462">منتظم آڈیٹ لاگز</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28777_1496243_1962445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email migration process that provisions new cloud-based mailboxes and then migrates mailbox data to the cloud.</descrip></descripGrp><ntig><termGrp><term id="1496243">cutover migration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962445">مرحلہ وار منتقلی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28778_1496244_1962463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of message journaling in which the original unaltered message is included as an attachment in the journal report.</descrip></descripGrp><ntig><termGrp><term id="1496244">envelope journaling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962463">ای میل روداد کو محفوظ کرنا</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28779_1496245_1962594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template applied to the distribution group names in your Microsoft Exchange organization. Specifically, you can specify that a prefix, a suffix, or both be applied to all distribution group names. You can also block certain words from being used in the names.</descrip></descripGrp><ntig><termGrp><term id="1496245">group naming policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962594">گروپ کو نام دینے کی پالیسی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28780_1496246_1962604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In email migration, the stage when the mailboxes in the on-premises Exchange organization and the corresponding cloud-based mailboxes are synchronized every 24 hours, after the initial synchronization. This means that any new messages sent to the mailboxes on the Exchange server are copied to the corresponding cloud-based mailboxes. Incremental synchronization continues until the administrator completes the overall migration.</descrip></descripGrp><ntig><termGrp><term id="1496246">incremental synchronization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962604">اضافی ہم وقت سازی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28781_1496247_1962610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The message that is generated when a message matches a journal rule. The body of the journal report contains information from the original message such as the sender email address, message subject, message-ID, and recipient email addresses. The journal report also includes the original unaltered message as an attachment.</descrip></descripGrp><ntig><termGrp><term id="1496247">journal report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962610">روزنامچہ کے رپورٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28782_1496248_1962611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Exchange rule that is used to record the email messages sent to or from specific recipients.</descrip></descripGrp><ntig><termGrp><term id="1496248">journal rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962611">روزنامچہ کا قاعدہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28784_1496250_1962530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of email migration that migrates a subset of on-premises mailboxes to the cloud. This type of migration allows the admin to maintain coexistence between their on-premises and cloud-based email organizations.</descrip></descripGrp><ntig><termGrp><term id="1496250">staged migration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962530">مرحلہ وار منتقلی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28785_1496251_1962451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of saving only one copy of duplicate items in the search results</descrip></descripGrp><ntig><termGrp><term id="1496251">deduplication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962451">ڈی ڈیوپلیکیشن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28786_1496252_1962474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique user identifier that must not change for the user over the lifetime of the user being in the system.</descrip></descripGrp><ntig><termGrp><term id="1496252">immutable ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962474">بلا تبدیل ID</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2879_237829_2735833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An alpha-numeric identifier for a marketing campaign that is distinct from its name.</descrip></descripGrp><ntig><termGrp><term id="237829">campaign code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2735833">مہم کوڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="p