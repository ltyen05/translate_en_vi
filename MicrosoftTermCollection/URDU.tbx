87"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email protection feature that detects messages with phish, spam, or malware that have already been delivered to your users' inboxes, and then renders the malicious content harmless.</descrip></descripGrp><ntig><termGrp><term id="2329598">ZAP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2331987">ZAP</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40091_2329598_2331988"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email protection feature that detects messages with phish, spam, or malware that have already been delivered to your users' inboxes, and then renders the malicious content harmless.</descrip></descripGrp><ntig><termGrp><term id="2329598">ZAP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2331988">صفر گھنٹہ خودکار صفائی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40092_2329599_2331985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of add-ins that transform pages from a variety of apps into sways.</descrip></descripGrp><ntig><termGrp><term id="2329599">Send to Sway</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><l