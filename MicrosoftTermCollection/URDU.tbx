_397208_409955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An SMTP connector that is required for mail to flow between Exchange routing groups. When Exchange Server 2007 is installed in an existing Exchange Server 2003 and Exchange 2000 Server organization, the required routing group connector is created during setup.</descrip></descripGrp><ntig><termGrp><term id="397208">routing group connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="409955">متحدہ گروپ کا رابطہ کار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="808_264640_402739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fraction that is written on a downward angle: the diagonal fraction bar is placed down and to the right of the numerator, and the denominator is slightly down and to the right of the fraction bar.</descrip></descripGrp><ntig><termGrp><term id="264640">skewed fraction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402739">ترچھی کسر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8081_319170_403057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The § character.</descrip></descripGrp><ntig><termGrp><term id="319170">SECTION SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp>