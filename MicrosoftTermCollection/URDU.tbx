09385">AutoRecovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402459">خود بازیافت کار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14817_53118_409922"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a failover cluster or server cluster, the process of taking a clustered service or application offline on one node and bringing it back online on another node.</descrip></descripGrp><ntig><termGrp><term id="53118">failover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="409922">قیل اوور</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14821_234960_402597"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A lightweight and task-specific add-in program that integrates with applications to expose data at a glance.</descrip></descripGrp><ntig><termGrp><term id="234960">gadget</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402597">پرزہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14822_187314_2174761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of storage space available for storing and processing on a disc.</descrip></descripGrp><ntig><termGrp><term id="187314">disk space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2174761">ڈسک گنجائش</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14837_180397_2700624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that provides Web single-sign-on (SSO) technologies. AD FS provides SSO by securely sharing digital identity and entitlement rights across security and enterprise boundaries. AD FS supports the WS-Federation Passive Requestor Profile (WS-F PRP).</descrip></descripGrp><ntig><termGrp><term id="180397">Active Directory Federation Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2700624">Active Directory فیڈریشن خدمات</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14837_2273623_2700624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that provides Web single-sign-on (SSO) technologies. AD FS provides SSO by securely sharing digital identity and entitlement rights across security and enterprise boundaries. AD FS supports the WS-Federation Passive Requestor Profile (WS-F PRP).</descrip></descripGrp><ntig><termGrp><term id="2273623">Active Directory Federation Services (AD FS)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2700624">Active Directory فیڈریشن خدمات</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14837_312510_2700624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that provides Web single-sign-on (SSO) technologies. AD FS provides SSO by securely sharing digital identity and entitlement rights across security and enterprise boundaries. AD FS supports the WS-Federation Passive Requestor Profile (WS-F PRP).</descrip></descripGrp><ntig><termGrp><term id="312510">AD FS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2700624">Active Directory فیڈریشن خدمات</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14842_1208_1217538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A markup language for describing and exchanging structured data in a format that is independent of operating systems and applications. XML is a World Wide Web Consortium (W3C) specification and is a subset of Standard Generalized Markup Language (SGML).</descrip></descripGrp><ntig><termGrp><term id="1208">Extensible Markup Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></l