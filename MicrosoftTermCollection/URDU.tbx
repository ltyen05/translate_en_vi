escrip></descripGrp><ntig><termGrp><term id="76022">local group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401832">مقامی گروپ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12547_155493_402334"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technical document in the Microsoft Knowledge Base accessible through Microsoft.com.</descrip></descripGrp><ntig><termGrp><term id="155493">KB article</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402334">۔KB آرٹیکل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12548_139813_402220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user dictionary that contains a list of words not in the application dictionary that an author wants the spelling checker to accept as correct.</descrip></descripGrp><ntig><termGrp><term id="139813">custom dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402220">مخصوص لغت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12551_237304_402640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula syntax that allows the user to refer to list and pivot data in a friendlier way.</descrip></descripGrp><ntig><termGrp><term id="237304">Structured References</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402640">ساختی حوالہ جات</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12556_361560_1799825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A classification for grouping content by user-defined criteria such as page contents, file types, or a similar distinction.</descrip></descripGrp><ntig><termGrp><term id="361560">area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1799825">زمرہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12556_568110_1799825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A classification for grouping content by user-defined criteria such as page contents, file types, or a similar distinction.</descrip></descripGrp><ntig><termGrp><term id="568110">category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1799825">زمرہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">No