nition">The interface in Microsoft Edge that allows users to customize their browser's appearance, privacy &amp; security options, and other configuration options.</descrip></descripGrp><ntig><termGrp><term id="2873906">Settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2873924">سیٹنگز</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50778_2873907_2873925"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The video camera capture mode for in which users can take slow-motion videos.</descrip></descripGrp><ntig><termGrp><term id="2873907">Slow-mo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2873925">سلو موشن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50779_2873908_2873929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information stream in MS Launcher relating to the user's work profile that contains information from their calendar, tasks to be completed, notes, etc.</descrip></descripGrp><ntig><termGrp><term id="2873908">work feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2873929">ورک فیڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="gram