9326">Viva Learning</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51981_2926576_2927121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to convert the image to text with screenshare during a Microsoft Teams meeting (the ability for meeting attendees to digitize and interact with text and URLs on the Teams meeting stage).</descrip></descripGrp><ntig><termGrp><term id="2926576">screen share scanner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2927121">اسکرین شیئر اسکینر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51982_2926577_2927116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Teams service that simplifies the communications services acquisition and adoption process for business customers, providing the option to provision/deprovision phone numbers and (eventually) acquire/obtain capabilities from certified Carriers, all through the Teams Admin Center.</descrip></descripGrp><ntig><termGrp><term id="2926577">Operator Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2927116">آپریٹر کنیکٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51983_2926579_2927110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tab in Microsoft Teams that allows the user to create, manage, and share approval requests such as stakeholder authorizations, customer signatures, or manager acknowledgements.</descrip></descripGrp><ntig><termGrp><term id="2926579">Approvals</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2927110">منظوریاں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51984_2926583_2927112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Teams, the way to present in which only the shared content itself is shown.</descrip></descripGrp><ntig><termGrp><term id="2926583">Content only</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2927112">صرف مشمول</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51985_2926584_2927123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Teams, option in Presenter Mode in which the shared content is shown as a background to the video of the presenter.</descrip></descripGrp><ntig><termGrp><term id="2926584">Standout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><lan