oss multiple disks in a virtual disk or storage space.</descrip></descripGrp><ntig><termGrp><term id="1596717">layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1638719">ترتیب</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31098_1596717_1638899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The layout and general resiliency of data across multiple disks in a virtual disk or storage space.</descrip></descripGrp><ntig><termGrp><term id="1596717">layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1638899">ذخیرہ کاری ترتیب</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31099_1596718_1638845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the resiliency type for a volume that stripes data across physical disks with no resiliency in a Microsoft Storage Spaces storage pool.</descrip></descripGrp><ntig><termGrp><term id="1596718">simple</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1638845">سادہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber"