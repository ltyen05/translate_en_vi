rammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217467">ماہر ابتدائی ڈھانچا</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8120_375742_380555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that provides a programming interface for accessing Microsoft Exchange data through the Client Access server role by using Web services.</descrip></descripGrp><ntig><termGrp><term id="375742">Exchange Web Services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="380555">ویب خدمات کا تبادلہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8123_234529_402566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic that indicates follow-up action is required, or otherwise identifies an important item.</descrip></descripGrp><ntig><termGrp><term id="234529">flag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402566">پرچم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8125_359995_403234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that uses a minimum amount of data to display the general layout of a report.</descrip></descripGrp><ntig><termGrp><term id="359995">Layout Preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="403234">لے آؤٹ پیش منظر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8136_396927_409983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A World Wide Web Consortium specification that describes the structure of dynamic HTML and XML documents in a way that allows them to be manipulated through a Web browser.</descrip></descripGrp><ntig><termGrp><term id="396927">Document Object Model</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="409983">دستاویز کا نمونہ شئے</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8136_396927_409984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A World Wide Web Consortium specification that describes the structure of dynamic HTML and XML documents in a way that allows them to be manipulated through a Web browser.</descrip></descripGrp><ntig><termGrp><term id="396927">Document Object Model</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="409984">DOM</term><termNote type="geographicalUs