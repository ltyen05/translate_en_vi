e.</descrip></descripGrp><ntig><termGrp><term id="749381">alternative text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962411">تمام text</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12180_237293_1936631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to access Outlook data over the Internet without a VPN connection.</descrip></descripGrp><ntig><termGrp><term id="237293">Outlook Anywhere</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1936631">ہرجگہ Outlook</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12192_33928_401512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that is used to compress or decompress a digital media file.</descrip></descripGrp><ntig><termGrp><term id="33928">codec</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401512">کوڈیک</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12197_68819_401777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A modem constructed on an expansion card to be installed in one of the expansion slots inside a computer.</descrip></descripGrp><ntig><termGrp><term id="68819">internal modem</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401777">داخلی موڈیم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12208_234524_402565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Someone granted permission to access items or perform functions on another user's behalf.</descrip></descripGrp><ntig><termGrp><term id="234524">delegate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402565">انتداب کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12216_237378_402641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pane at the bottom of the Calendar module where tasks are displayed. Tasks that are completed on a particular day "stick" to the day and are shown as a record of what work was performed on that day. Tasks not completed roll over to the next day and accumulate until completed.</descrip></descripGrp><ntig><termGrp><term id="237378">Daily Task List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402641"