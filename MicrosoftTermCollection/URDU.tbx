</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217456">ای میل کردہ نوٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7246_116666_1217457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transfer into a store or storage location.</descrip></descripGrp><ntig><termGrp><term id="116666">store</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217457">ذخیرہ کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7248_54777_401693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Marked with a flag.</descrip></descripGrp><ntig><termGrp><term id="54777">flagged</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401693">پرچم دار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7250_143242_1217458"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In 2-D line charts, lines that extend from the highest to the lowest value in each category. High-low lines are often used in stock charts.</descrip></descripGrp><ntig><termGrp><term id="143242">high-low lines</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217458">اعلی پست لائنیں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7253_298012_402847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any graphic you draw or insert, which can be changed and enhanced. Drawing objects include AutoShapes, curves, lines, and WordArt.</descrip></descripGrp><ntig><termGrp><term id="298012">drawing object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402847">ڈرائنگ آبجیکٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7257_55937_401702"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prepare a disk for use by organizing its storage space into a collection of data "compartments", each of which can be located by the operating system so that data can be sorted and retrieved. When a previously used disk is formatted, any preexisting information on it is lost.</descrip></descripGrp><ntig><termGrp><term id="55937">format</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401702">وضع کريں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalG