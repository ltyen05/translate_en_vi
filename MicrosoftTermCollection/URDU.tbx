p></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401252">خفیہ کاری</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3367_297187_402836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software designed to provide access to a computer from a remote location. These programs are often installed by the computer owner or administrator, and are only a risk if unexpected.</descrip></descripGrp><ntig><termGrp><term id="297187">remote control software</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402836">بعید کنٹرول سافٹ ویئر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33697_1808999_2020457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To put your finger on a touchscreen and then swipe it quickly, lifting your finger off the screen, in the direction you want.</descrip></descripGrp><ntig><termGrp><term id="1808999">flick</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2020457">فلک کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33700_1809907_2078583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype feature that allows users to call directly from Skype to landlines and mobile phones.</descrip></descripGrp><ntig><termGrp><term id="1809907">call phones</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2078583">فونز پر کال کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33701_1809933_2078672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to store video clips.</descrip></descripGrp><ntig><termGrp><term id="1809933">video storage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2078672">ویڈیو ذخیرہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33702_1810821_2078659"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The document that covers how users may use Skype software, Skype products, and the Skype website.</descrip></descripGrp><ntig><termGrp><term id="1810821">Terms of Use</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2078659">قواعد استعمال</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></t