<termEntry id="18583_650937_1934443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone number format for dialing any call from any location or with a calling card.</descrip></descripGrp><ntig><termGrp><term id="650937">international format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934443">بین الاقوامی فارمیٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18585_650939_1217588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that connects fields between two tables and shows how the data is related. The type of join indicates which records are selected for the query's result set.</descrip></descripGrp><ntig><termGrp><term id="650939">join line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217588">جوڑ لائن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18587_650941_1217589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The special characters used to extend the joiner between two Arabic characters. Used to improve the appearance of justified text by visually lengthening words rather than increasing the spacing between words. Can also function like a hyphen.</descrip></descripGrp><ntig><termGrp><term id="650941">kashidas</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217589">کشیدہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18590_650944_1433967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Resolving resource conflicts or overallocations by delaying or splitting certain tasks. When Project levels a resource, its selected assignments are distributed and rescheduled.</descrip></descripGrp><ntig><termGrp><term id="650944">leveling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433967">سطح بندی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18594_650948_1217590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of cascading style sheet that exists in a separate file and is referenced throughout one or more Web pages.</descrip></descripGrp><ntig><termGrp><term id="650948">linked style sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217590">مربوط قرطاس طرز</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18598_650952_1934444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character, usually a comma or semicolon, that separates elements in a list.</descrip></descripGrp><ntig><termGrp><term id="650952">list-separator character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934444">فہرست عليحدہ کار حروف</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18601_650955_1934445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendar that is based on cycles of the moon phase.</descrip></descripGrp><ntig><termGrp><term id="650955">Lunar calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934445">قمری کیلنڈر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18604_650958_1934446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range in an XML list that has been linked to an element in an XML map.</descrip></descripGrp><ntig><termGrp><term id="650958">mapped range</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934446">معين حد</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18605_650959_1433968"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shape on a stencil that you use repeatedly to create drawings. When you drag a shape from a stencil onto the drawing page, the shape becomes an instance of that master.</descrip></descripGrp><ntig><termGrp><term id="650959">master shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433968">ماسٹر شکل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18614_650968_1934447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tone in a picture that is in the middle of the tonal range, between the lightest and darkest tones</descrip></descripGrp><ntig><termGrp><term id="650968">midtone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934447">مڈ ٹون</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1881_68580_401775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that enables a program to work with the user (the user interface, which can be a command-line interface, menu-driven, or a graphical user interface), with another program such as the operating system, or with the computer's hardware.</descrip></descripGrp><ntig><termGrp><term id="68580">interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401775">مواجہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1883_318780_403038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The = character.</descrip></descripGrp><ntig><termGrp><term id="318780">equal sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="403038">علامت مساوی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18831_651182_1934448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that does not have strong right-to-left or left-to-right language attributes.</descrip></descripGrp><ntig><termGrp><term id="651182">neutral character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934448">غیر جانب دار کریکٹر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18840_651191_1934449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file you create on your hard disk or a network share to store OLAP source data for a PivotTable or PivotChart report. Offline cube files allow you to keep working when you are not connected to the OLAP server.</descrip></descripGrp><ntig><termGrp><term id="651191">offline cube file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934449">آف لائن معکب مسل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1885_69963_1217386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability for two or more software applications to work together with little effort from the user.</descrip></descripGrp><ntig><termGrp><term id="69963">interoperability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217386">بین عمل کاریت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18851_651202_1433969"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The result of assigning more tasks to a resource than the resource can accomplish in the working time available.</descrip></descripGrp><ntig><termGrp><term id="651202">overallocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433969">کل محل وقوع</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18860_651211_1799862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Principles that guide developers as they assign responsibilities to software classes and design system behavior. They are most useful when creating collaboration diagrams where messages imply responsibility.</descrip></descripGrp><ntig><termGrp><term id="651211">patterns</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1799862">انداز</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18862_651213_1934450"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that you use to enter or display how much of a task has been completed. This value is expressed as the percentage of the task duration that has been completed.</descrip></descripGrp><ntig><termGrp><term id="651213">percent complete</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934450">فی صد مکمل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18865_651216_1217591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of a list, SharePoint document library, or Web Part Page that is available only to a particular user.</descrip></descripGrp><ntig><termGrp><term id="651216">personal view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217591">ذاتی منظر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18873_651224_1433970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A schedule of task start and finish dates and resource and cost data.</descrip></descripGrp><ntig><termGrp><term id="651224">plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433970">منصوبہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18876_651227_1934451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of projects within an organization that may share common management of scope, budget, or resources.</descrip></descripGrp><ntig><termGrp><term id="651227">portfolio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934451">منصوبوں کی فہرست</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18877_651228_1433972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Placing elements, such as text and graphics, on a page to let the page author control the exact location and layer order of a page element.</descrip></descripGrp><ntig><termGrp><term id="651228">positioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433972">پوزیشن کاری</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18878_651229_1934452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bookmark that Microsoft Word automatically sets in each document.</descrip></descripGrp><ntig><termGrp><term id="651229">predefined bookmark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934452">پیش وضافی نشانی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18891_651242_1433973"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of excellence, or the desired standards, in a product, process, or project.</descrip></descripGrp><ntig><termGrp><term id="651242">quality</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433973">معیار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18892_651243_1934453"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A default color category that is assigned to an item when you click the Categories column for the item in your Inbox or other table view. You set this color category from the Categorize menu.</descrip></descripGrp><ntig><termGrp><term id="651243">Quick Click category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934453">سریع کلک زمرہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18894_651245_1799844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move a task to a lower outline level [to the right] in the Task Name field. When you indent a task, it becomes a subtask of the nearest preceding task at a higher outline level.</descrip></descripGrp><ntig><termGrp><term id="651245">indent</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1799844">حاشیہ چھوڑِیں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18895_651246_1934454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task that occurs repeatedly during the course of a project. For example, you might define the weekly status meeting as a recurring task.</descrip></descripGrp><ntig><termGrp><term id="651246">recurring task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934454">مکرر کام</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18908_651259_1934455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Excel template (.xlt file) that includes one or more queries or PivotTable reports that are based on external data. When you save a report template, Excel saves the query definition but doesn't store the queried data in the template.</descrip></descripGrp><ntig><termGrp><term id="651259">report template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934455">رپورٹ سانچہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18909_651260_1217592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of reports that all contain similar information.</descrip></descripGrp><ntig><termGrp><term id="651260">report type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217592">رپورٹ قسم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18916_651267_1934456"><langSet xml:lang="en-US"><descripGrp><descrip type=