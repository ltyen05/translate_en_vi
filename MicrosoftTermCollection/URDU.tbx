rm id="2486334">بیس بورڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15383_81653_2486334"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary circuit board in a computer that contains most of the basic components of the system.</descrip></descripGrp><ntig><termGrp><term id="81653">motherboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2486334">بیس بورڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15383_81654_2486334"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary circuit board in a computer that contains most of the basic components of the system.</descrip></descripGrp><ntig><termGrp><term id="81654">system board</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2486334">بیس بورڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15384_178508_2344826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An order for a large quantity of products or services. The minimum quantity that qualifies as a bulk order is set by individual companies.</descrip></descripGrp><ntig><termGrp><term id="178508">bulk order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2344826">بلک ترتیب</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15386_154964_402332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A delay of the amount of time that elapses before a character begins repeating when you hold down a key.</descrip></descripGrp><ntig><termGrp><term id="154964">repeat delay</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402332">دہرائی تاخیر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15396_148352_1217547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">E-mail accounts and folders that you can group and set common options for, such as whether to download headers or messages, size limits on downloaded messages, behavior online vs. offline, and time interval for connecting to the server.</descrip></descripGrp><ntig><termGrp><term id="148352">Send/Receive group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217547">بھیج/ وصول گروپ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="154_543576_1217366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the Administrators group on the local server computer.</descrip></descripGrp><ntig><termGrp><term id="543576">server administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217366">سرور منتظم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1542_30264_401490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbol that carries meaning in language, such as a letter, number, punctuation mark, or emoticon.</descrip></descripGrp><ntig><termGrp><term id="30264">character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401490">کریکٹر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15424_65290_401757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Unable to be used together.</descrip></descripGrp><ntig><termGrp><term id="65290">incompatible</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401757">بے جوڑ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</ter