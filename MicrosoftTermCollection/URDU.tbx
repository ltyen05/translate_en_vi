2108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Learning Tools feature that translates the selected word or words into another language.​​</descrip></descripGrp><ntig><termGrp><term id="2427816">Translate</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2432108">ترجمہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42779_2427817_2432111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Learning Tools feature that predicts what words the user might want to use.​</descrip></descripGrp><ntig><termGrp><term id="2427817">Word Prediction</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2432111">لفظ پیش گوئی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42780_2427845_2432109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook add-in that provides a translated view of messages which preserves the format and layout of the original message​.​</descrip></descripGrp><ntig><termGrp><term id="2427845">Translator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2432109">مترجم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42780_2427845_2454865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook add-in that provides a translated view of messages which preserves the format and layout of the original message​.​</descrip></descripGrp><ntig><termGrp><term id="2427845">Translator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2454865">مترجم برائے Outlook</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42780_2450821_2432109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook add-in that provides a translated view of messages which preserves the format and layout of the original message​.​</descrip></descripGrp><ntig><termGrp><term id="2450821">Translator for Outlook</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2432109">مترجم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42780_2450821_2454865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook add-in that provides a translated view of messages which preserves the format and layout of the original message​.​</descrip></descripGrp><ntig><termGrp><t