 entity apart from and taxed separately from its owners.</descrip></descripGrp><ntig><termGrp><term id="1993405">C corporation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2006847">C کارپوریشن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34574_1993406_2006897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business that is owned by an individual but is not treated as a separate entity from the business owner for tax purposes.</descrip></descripGrp><ntig><termGrp><term id="1993406">disregarded entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2006897">نظر انداز کردہ ادارہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34575_1993407_2006912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual or entity that has no tax liability under US tax laws because they are not a citizen, resident alien, or an organization created or organized under the laws of the United States.</descrip></descripGrp><ntig><termGrp><term id="1993407">exempt payee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2006912">مستثنی وصول کنندہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">