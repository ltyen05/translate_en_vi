>A 9-digit number used to identify an entity (company or person) for tax reporting purposes in the U.S. There are several different types of tax identification numbers, such as employer identification number (EIN), Social Security number (SSN), individual taxpayer identification number (ITIN), and adopted taxpayer identification number (ATIN).</descrip></descripGrp><ntig><termGrp><term id="235105">taxpayer identification number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1931433">TID</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4218_235106_1931433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 9-digit number used to identify an entity (company or person) for tax reporting purposes in the U.S. There are several different types of tax identification numbers, such as employer identification number (EIN), Social Security number (SSN), individual taxpayer identification number (ITIN), and adopted taxpayer identification number (ATIN).</descrip></descripGrp><ntig><termGrp><term id="235106">TIN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1931433">TID</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4218_2630701_1931433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 9-digit number used to identify an entity (company or person) for tax reporting purposes in the U.S. There are several different types of tax identification numbers, such as employer identification number (EIN), Social Security number (SSN), individual taxpayer identification number (ITIN), and adopted taxpayer identification number (ATIN).</descrip></descripGrp><ntig><termGrp><term id="2630701">tax ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1931433">TID</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42205_2389315_2391985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To use or play a product for a short time for free, without having to purchase it.</descrip></descripGrp><ntig><termGrp><term id="2389315">preview</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2391985">جائزہ لیں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42206_2389316_2391986"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short display of a product for free without having to purchase it.</descrip></descripGrp><ntig><termGrp><term id="2389316">preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2391986">پیش منظر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">