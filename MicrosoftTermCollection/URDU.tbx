2542496">Component Update Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2544235">جزو کی تجدید کی خدمت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45074_2542517_2736094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud deployment solution that leverages the cloud to automate the configuration of new PCs including changing default start up screens without the need of IT assistance.</descrip></descripGrp><ntig><termGrp><term id="2542517">Windows Autopilot Deployment</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2736094">Windows Autopilot</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45074_2542517_2736143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud deployment solution that leverages the cloud to automate the configuration of new PCs including changing default start up screens without the need of IT assistance.</descrip></descripGrp><ntig><termGrp><term id="2542517">Windows Autopilot Deployment</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2736143">Windows Autopilot Deployment</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSp