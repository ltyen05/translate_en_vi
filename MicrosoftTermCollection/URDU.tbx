er operating system language version.</descrip></descripGrp><ntig><termGrp><term id="212211">Language for non-Unicode programs</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402483">غیر یونی کوڈ پروگراموں کے لیے زبان</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1082_27628_1216871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toggle key that, when on, shifts the alphabetic characters on the keyboard to uppercase.</descrip></descripGrp><ntig><termGrp><term id="27628">CAPS LOCK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1216871">CAPS LOCK۔کلید</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1082_27628_401464"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toggle key that, when on, shifts the alphabetic characters on the keyboard to uppercase.</descrip></descripGrp><ntig><termGrp><term id="27628">CAPS LOCK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401464">CAPS LOCK</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEnt