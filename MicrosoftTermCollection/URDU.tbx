 id="6302_1244829_1433919"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Web browser–based interface of Microsoft Office Project that project team members and stakeholders can use to access and update information stored in Microsoft Project Server, without having to install Microsoft Project on their computers.</descrip></descripGrp><ntig><termGrp><term id="1244829">Project Web App</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433919">Project Web ایپلی کیشن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6302_2667271_1433919"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Web browser–based interface of Microsoft Office Project that project team members and stakeholders can use to access and update information stored in Microsoft Project Server, without having to install Microsoft Project on their computers.</descrip></descripGrp><ntig><termGrp><term id="2667271">PWA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433919">Project Web ایپلی کیشن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6303_146012_402276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A combination of character and paragraph-formatting characteristics that are named and stored as a set.</descrip></descripGrp>