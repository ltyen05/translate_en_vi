crip></descripGrp><ntig><termGrp><term id="183941">Document Inspector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402415">دستاویز انسپکٹر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19188_652160_1934460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of PivotTable view that contains row fields.</descrip></descripGrp><ntig><termGrp><term id="652160">row area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934460">صف علاقہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19189_652161_1934461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The numbered gray area to the left of each row.</descrip></descripGrp><ntig><termGrp><term id="652161">row heading</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934461">صف سرخی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1919_46463_401623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A round, flat piece of nonmagnetic, shiny metal encased in a plastic coating, designed to be read from and written to by optical (laser) technology.</descrip></descripGrp><ntig><termGrp><term id="46463">disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401623">ڈسک</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19191_652163_1934462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An accessibility aid for people who are blind or have learning disabilities, such as dyslexia. These aids make on-screen information available as synthesized speech or a refreshable Braille display.</descrip></descripGrp><ntig><termGrp><term id="652163">screen review utility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934462">اسکرین جائزہ افادہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19196_652168_1934463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that is displayed in the series area of a chart and that contains series items. A series is a group of related data points.</descrip></descripGrp><ntig><termGrp><term id="652168">series field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934463">سلسلہ قطعہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19203_652175_1934464"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cell that has been linked to a non-repeating element in an XML map.</descrip></descripGrp><ntig><termGrp><term id="652175">single-mapped cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934464">واحد نقشہ شدہ سیل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19205_652177_1433977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change the dimensions of a shape by dragging one of its handles after it has been selected with the pointer tool.</descrip></descripGrp><ntig><termGrp><term id="652177">size</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433977">سائز دیں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19212_652184_1433978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small overlap that extends the shape of the upper of two differently colored, abutting objects. A spread extends beyond the area that it knocks out.</descrip></descripGrp><ntig><termGrp><term id="652184">spread</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433978">پھیلا ہوا</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19213_652185_1934465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Office Web Component that provides the interactive functionality of a spreadsheet on a Web page. You can enter data, add formulas and functions, apply filters, change formatting, and recalculate.</descrip></descripGrp><ntig><termGrp><term id="652185">Spreadsheet Component</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934465">گوشوارہ جزو</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19215_652187_1217593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default text font for worksheets. The standard font determines the default font for the Normal cell style.</descrip></descripGrp><ntig><termGrp><term id="652187">standard font</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217593">معیاری فانٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19219_652191_1433979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A date that you set [rather than the current date] for reporting the time, cost, or performance condition of a project.</descrip></descripGrp><ntig><termGrp><term id="652191">status date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433979">حالت تاریخ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19221_652193_1217594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A description of the status of a member's project work and related work.</descrip></descripGrp><ntig><termGrp><term id="652193">status report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217594">حالت رپورٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19229_652201_1433980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task that is made up of subtasks and summarizes those subtasks. Use outlining to create summary tasks. Project automatically determines summary task information [such as duration and cost] by using information from the subtasks.</descrip></descripGrp><ntig><termGrp><term id="652201">summary task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433980">ٹاسک خلاصہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19232_652204_1433981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An horizontal or vertical line that divides a diagram into partitions and which is used to arrange related parts of a process.</descrip></descripGrp><ntig><termGrp><term id="652204">swimlane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433981">سوم لین</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19234_652206_1799878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any application or process that you want to model. Examples of systems include a computer game, a process for assembling microchips, and a library information system.</descrip></descripGrp><ntig><termGrp><term id="652206">system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1799878">نظام</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19250_652222_1934466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of a set of major and minor fonts that is applied to a file. Theme fonts, theme colors, and theme effects compose a theme.</descrip></descripGrp><ntig><termGrp><term id="652222">theme font</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934466">خیالیہ کا فانٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19251_652223_1934467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of pane that presents the current scanned document as one or more small images.</descrip></descripGrp><ntig><termGrp><term id="652223">thumbnail pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934467">تصویر چہ جھروکا</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19254_652226_1433982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time period indicator at the top of the Gantt views, the Resource Graph view, the Task Usage view, and the Resource Usage view. You can customize it to show up to three tiers that can display various time units: top, middle, and bottom.</descrip></descripGrp><ntig><termGrp><term id="652226">timescale</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433982">وقت پیمانہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19258_652230_1934468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special row in a list or table that provides a selection of aggregate functions useful for working with numerical data.</descrip></descripGrp><ntig><termGrp><term id="652230">total row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934468">میزان صف</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19258_760167_1934468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special row in a list or table that provides a selection of aggregate functions useful for working with numerical data.</descrip></descripGrp><ntig><termGrp><term id="760167">totals row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934468">میزان صف</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19261_652233_1934469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An arrow that shows the relationship between the active cell and its related cells. Tracer arrows are blue when pointing from a cell that provides data to another cell, and red if a cell contains an error value, such as #DIV/0!.</descrip></descripGrp><ntig><termGrp><term id="652233">tracer arrow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934469">سراغ لگانے والا تیر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19264_652236_1934470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Optional text for a trendline, including either the regression equation or the R-squared value, or both. A trendline label can be formatted and moved; it cannot be sized.</descrip></descripGrp><ntig><termGrp><term id="652236">trendline label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934470">خط رجحان ليبل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19265_652237_1217595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder or file path on your computer or a location on your intranet from which it is safe to run code. Default trusted locations include the Templates, Addins, and Startup folders, and you can specify your own trusted locations.</descrip></descripGrp><ntig><termGrp><term id="652237">trusted location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217595">اعتمادی محل وقوع</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19266_652238_1934471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of software publisher certificates used to digitally sign code, such as macros. Because you explicitly trust the software publishers, their code is allowed to run on your computer without needing to prompt for permission.</descrip></descripGrp><ntig><termGrp><term id="652238">trusted publisher store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934471">بھروسے کے ناشر کا اسٹور</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19271_652243_1433983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The percentage of a work resource’s time that is assigned to a task.</descrip></descripGrp><ntig><termGrp><term id="652243">unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433983">یونٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19273_652245_1934472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In line charts with multiple data series, bars that indicate the difference between data points in the first and last series.</descrip></descripGrp><ntig><termGrp><term id="652245">up-down bars</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934472">اوپر-نیچے کا بار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19276_652248_1934473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart axis that displays scaled numerical values.</descrip></descripGrp><ntig><termGrp><term id="652248">value axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934473">قدر محور</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1928_90900_401938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To break input into smaller chunks so that a program can act upon the information.</descrip></descripGrp><ntig><termGrp><term id="90900">parse</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401938">پارس</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19280_652252_1217596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar displayed along the left side of a document window. You can use the vertical ruler to adjust the top and bottom page margins and the row height in tables.</descrip></descripGrp><ntig><termGrp><term id="652252">vertical ruler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217596">عمودی پیمانہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19285_652286_1217597"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendar in widespread use. It was introduced in 1582 A.D. as a revision to the Julian calendar.</descrip></descripGrp><ntig><termGrp><term id="652286">Gregorian calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217597">گرگیوری کیلنڈر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19291_652263_1217598"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML structure that consists of a start tag, an end tag, and the information between the tags. Elements can have attributes and can contain other elements.</descrip></descripGrp><ntig><termGrp><term id="652263">XML element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217598">XML عنصر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19295_652267_1934474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A switch (\#) or instruction that specifies how Microsoft Word will display the numeric result of a field.</descrip></descripGrp><ntig><termGrp><term id="652267">numeric picture switch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934474">عددی تصویر سوئچ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19296_652268_1934475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A switch (\*) or instruction that specifies the capitalization, numeral style, and character formatting that Microsoft Word uses in a field result.</descrip></descripGrp><ntig><termGrp><term id="652268">format switch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934475">وضع سوئچ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1930_46651_401626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used to store information.</descrip></descripGrp><ntig><termGrp><term id="46651">disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401626">ڈسک</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19300_652272_1217599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to information that shows what has actually occurred. For example, the actual start date for a task is the day that the task actually started.</descrip></descripGrp><ntig><termGrp><term id="652272">actual</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217599">اصل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19301_652273_1433984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The percentage of a resource's capacity that is designated for a specific assignment.</descrip></descripGrp><ntig><termGrp><term id="652273">allocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433984">تخصیص</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19302_652274_1799881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An allowed path from one state to another.</descrip></descripGrp><ntig><termGrp><term id="652274">transition</term><termNote 