1383">منسلکہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12459_184074_1217507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The propagation of properties via InfoPath forms from the underlying data into named properties in Outlook or SharePoint sites. Promoted properties are used to group, filter, and sort data, files, and folders.</descrip></descripGrp><ntig><termGrp><term id="184074">property promotion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217507">ترقی خاصیت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12465_397226_409993"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of an Active Directory user object that has mailbox attributes and the associated mailbox data that is stored in the mailbox database.</descrip></descripGrp><ntig><termGrp><term id="397226">mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="409993">میل باکس</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12476_228489_2005792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account number scheme that is recognized by banks internationally to facilitate credit transfers across national/regional borders.</descrip></descripGrp><ntig><termGrp><term id="228489">International Bank Account Number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2005792">IBAN</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12476_228490_2005792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account number scheme that is recognized by banks internationally to facilitate credit transfers across national/regional borders.</descrip></descripGrp><ntig><termGrp><term id="228490">IBAN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2005792">IBAN</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12477_308336_402895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of the window that displays a limited view of search results or other content.</descrip></descripGrp><ntig><termGrp><term id="308336">preview pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402895">پیش منظر جھروکا</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12483_149056_1433947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an organization chart, a shape that is placed above and connected to any other shape, such as an employee (subordinate or coworker shape) or assistant shape.</descrip></descripGrp><ntig><termGrp><term id="149056">superior shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433947">اعلی شکل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12486_317885_1934366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specific Office icon that is used within a group to launch a related dialog box.</descrip></descripGrp><ntig><termGrp><term id="317885">Dialog Box Launcher</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934366">مکالمہ خانہ چلت کار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1250_1162493_1217378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A grouping of dimension members or items from a data source that are named and treated as a single unit and can be referenced or reused multiple times.</descrip></descripGrp><ntig><termGrp><term id="1162493">set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber