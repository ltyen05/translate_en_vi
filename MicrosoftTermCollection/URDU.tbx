636">Skype کالز</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33729_1814258_2078638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A downloadable plugin for calling phone numbers directly from websites in a browser.</descrip></descripGrp><ntig><termGrp><term id="1814258">Skype Click to Call</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2078638">کال کرنے کیلئے Skype کلک</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3373_87656_401918"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an entity, such as a user, a file or a computer that is currently connected a server.</descrip></descripGrp><ntig><termGrp><term id="87656">online</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401918">آن لائن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33730_1814259_2078641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tab in the Skype desktop client for displaying a user's Facebook newsfeed and Skype mood messages.</descrip></descripGrp><ntig><termGrp><term id="1814259">Skype Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2078641">Skype ہوم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33731_1814260_2078642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web tool that businesses can use to allocate Skype Credit, features, and products to employees.</descrip></descripGrp><ntig><termGrp><term id="1814260">Skype Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2078642">Skype Manager</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33732_1814261_2078643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wrapper of Skype features offering instant, voice, video, and SMS messaging.</descrip></descripGrp><ntig><termGrp><term id="1814261">Skype messages</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2078643">Skype پیغامات</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33733_1814263_2078656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A picture taken with the webcam (during the call or any time).</descrip></descripGrp><ntig><termGrp><term id="1814263">video snapshot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2078656">سنیپ شاٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33733_1814263_2078671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A picture taken with the webcam (during the call or any time).</descrip></descripGrp><ntig><termGrp><term id="1814263">video snapshot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2078671">ویڈیو سنیپ شاٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33733_1814264_2078656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A picture taken with the webcam (during the call or any time).</descrip></descripGrp><ntig><termGrp><term id="1814264">snapshot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2078656">سنیپ شاٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSe