ple, Excel.Sheet or PowerPoint.Slide) that's used by the Windows registry to uniquely identify an object.</descrip></descripGrp><ntig><termGrp><term id="147050">programmatic identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934252">پراگ آئی ڈی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10349_147050_1934253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identifier in the form OLEServerName.ObjectName (for example, Excel.Sheet or PowerPoint.Slide) that's used by the Windows registry to uniquely identify an object.</descrip></descripGrp><ntig><termGrp><term id="147050">programmatic identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934253">ProgID</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10349_147051_1934252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identifier in the form OLEServerName.ObjectName (for example, Excel.Sheet or PowerPoint.Slide) that's used by the Windows registry to uniquely identify an object.</descrip></descripGrp><ntig><termGrp><term id="147051">ProgID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934252">پراگ آئی ڈی</term><termNote type="geographi