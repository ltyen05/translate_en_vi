Note><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38599_2244483_2255971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option that shows the set of fonts that can be applied to a sway.</descrip></descripGrp><ntig><termGrp><term id="2244483">Font choices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2255971">فانٹ نتخابات</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="386_93737_1707107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware- or software-based interface used to transfer information between a computer and other devices. Hardware ports are physical connections that are visible on the outside of the computer. Software ports are the numbered gateways in programs that software programs use to exchange information.</descrip></descripGrp><ntig><termGrp><term id="93737">port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1707107">پورٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38600_2244485_2255956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Design feature that allows users to save particular Designs, Styles, or Structures for easy use or access later.</descrip></descripGrp><ntig><termGrp><term id="2244485">Favorites</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2255956">پسندیدہ چیزیں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38601_2244486_2256093"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The navigation layout that presents content in a single column on the page and that allows user to navigate from top to bottom.​​</descrip></descripGrp><ntig><termGrp><term id="2244486">Vertical</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2256093">عمودی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38602_2244487_2256025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Structure that places content along the horizontal axis and allows users to navigate through it from left and right.</descrip></descripGrp><ntig><termGrp><term id="2244487">Panorama</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2256025">پیش نگاہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38603_2244846_2255940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that allows a user to click on an embedded image to see any of the following: a high resolution version of it, a link to where the image was found, as well as related images.</descrip></descripGrp><ntig><termGrp><term id="2244846">Detail view</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2255940">تفصیلی منظر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38605_2244852_2255906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows users to create a bulleted list out of their text.</descrip></descripGrp><ntig><termGrp><term id="2244852">Bulleted list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2255906">شق دار فہرست</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38625_2244876_2255991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows users to create a numbered list out of their text.</descrip></descripGrp><ntig><termGrp><term id="2244876">Numbered list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2255991">نمبری فہرست</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38626_2244888_2256034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway link that opens an email that allows users to report a violation of Sway’s terms of use.</descrip></descripGrp><ntig><termGrp><term id="2244888">Report a violation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2256034">ایک خلاف ورزى کی رپورٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38627_2244890_2255915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway menu that displays all of the available cards in a single panel.</descrip></descripGrp><ntig><termGrp><term id="2244890">Card gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2255915">کارڈ گیلری</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38628_2244894_2255989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows users to create a hyperlink embedded in their sway.</descrip></descripGrp><ntig><termGrp><term id="2244894">Link</term><termNote typ