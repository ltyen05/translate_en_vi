 فارم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53237_3033416_3033431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application for ARDK users that hosts the system UI, including the application launcher, dock, and task bar.</descrip></descripGrp><ntig><termGrp><term id="3033416">ARDK Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3033431">ARDK ہوم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53238_3033417_3033426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application for ARDK users to calibrate their eyes for the eye tracker.</descrip></descripGrp><ntig><termGrp><term id="3033417">ARDK Eye Calibration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3033426">ARDK آنکھ کیلیبریشن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53246_3033423_3033428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone application that allows users to submit feedback from their Samsung phone about a problem with their ARDK head-mounted display.</descrip></descripGrp><ntig>