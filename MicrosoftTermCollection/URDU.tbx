cond.</descrip></descripGrp><ntig><termGrp><term id="20603">baud rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401412">بوڈ شرح</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46617_2623853_2625388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move an email into a user's inbox from quarantine.</descrip></descripGrp><ntig><termGrp><term id="2623853">release</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2625388">ریلیز کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46618_2623854_2625614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cyber attack where an intruder engages with the targeted system to gather information about vulnerabilities or steal login information.</descrip></descripGrp><ntig><termGrp><term id="2623854">reconnaissance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2625614">جاسوسی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46620_2623856_2624182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack where an attacker attempts to log in into all accounts across a specific domain using only one password, thus avoiding being locked out of any one account.</descrip></descripGrp><ntig><termGrp><term id="2623856">password spray attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2624182">پاس ورڈ اسپرے حملہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46620_2623856_2624187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack where an attacker attempts to log in into all accounts across a specific domain using only one password, thus avoiding being locked out of any one account.</descrip></descripGrp><ntig><termGrp><term id="2623856">password spray attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2624187">معکوس بروٹ فورس حملہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46620_2623857_2624182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack where an attacker attempts to log in into all accounts across a specific domain using only one password, thus avoiding being locked out of any one account.</descrip></descripGrp><ntig><termGrp><term id="2623857">reverse brute-force attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="gra