><langSet xml:lang="ur"><ntig><termGrp><term id="1934356">Excel کیوب افعال</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14974_84430_401895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On a local area network (LAN), a drive that other computers on the network can connect to. A network drive allows people to access shared files and folders.</descrip></descripGrp><ntig><termGrp><term id="84430">network drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401895">نیٹ ورک ڈرائیو</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14984_141508_1934212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type consisting of a sequence of named values given in a particular order.</descrip></descripGrp><ntig><termGrp><term id="141508">enumerated data type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934212">نمبر یافتہ کوائف قسم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14984_2676681_1934212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type consisting of a sequence of named values given in a particular order.</descrip></descripGrp><ntig><termGrp><term id="2676681">enum type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934212">نمبر یافتہ کوائف قسم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14988_397197_410008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A replication that combines the asynchronous log shipping and replay features built into Exchange 2007 with the failover and management features provided by a failover cluster that is created with the Microsoft Windows Cluster service.</descrip></descripGrp><ntig><termGrp><term id="397197">cluster continuous replication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="410008">کلسٹر کی لگا تار تجدید</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14988_746537_410008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A replication that combines the asynchronous log shipping and replay features built into Exchange 2007 with the failover and management features provided by a failover cluster that is created with the Microsoft Windows Cluster service.</descrip></descripGrp><ntig><termGrp><term id="746537">CCR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="410008">کلسٹر کی لگا تار تجدید</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14990_10614_401352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An on-screen box, in a graphical user interface, that is used to deliver a message or warning.</descrip></descripGrp><ntig><termGrp><term id="10614">alert box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401352">انتباہ خانہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14994_397171_410028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A replication that uses a single server and built-in technology to create and maintain a copy of a storage group on a second set of disks that are connected to the same server as the primary storage group. LCR provides asynchronous log shipping, log replay, and a quick manual switch to a copy of the data.</descrip></descripGrp><ntig><termGrp><term id="397171">local continuous replication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="410028">مقامی لگا تار تجدید</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14994_741948_410028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A replication that uses a single server and built-in technology to create and maintain a copy of a storage group on a second set of disks that are connected to the same server as the primary storage group. LCR provides asynchronous log shipping, log replay, and a quick manual switch to a copy of the data.</descrip></descripGrp><ntig><termGrp><term id="741948">LCR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="410028">مقامی لگا تار تجدید</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14999_397227_401867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hidden section of an email message. From the time a message is first created, information about it is added to the message header, including technical details, such as who created the message and the software used to compose it.</descrip></descripGrp><ntig><termGrp><term id="397227">P2 header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401867">پیغام سرخی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14999_397227_409930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hidden section of an email message. From the time a message is first created, information about it is added to the message header, including technical details, such as who created the message and the software used to compose it.</descrip></descripGrp><ntig><termGrp><term id="397227">P2 header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="409930">P2 عنوان</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14999_80016_401867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hidden section of an email message. From the time a message is first created, information about it is added to the message header, including technical details, such as who created the message and the software used to compose it.</descrip></descripGrp><ntig><termGrp><term id="80016">message header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401867">پیغام سرخی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14999_80016_409930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hidden section of an email message. From the time a message is first created, information about it is added to the message header, including technical details, such as who created the message and the software used to compose it.</descrip></descripGrp><ntig><termGrp><term id="80016">message header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="409930">P2 عنوان</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15_2161198_409973"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical grouping of managed folders. When a managed folder mailbox policy is applied to a user’s mailbox, all the managed folders that are linked to the policy are deployed in a single operation, thereby making the deployment of messaging records management (MRM) easier.</descrip></descripGrp><ntig><termGrp><term id="2161198">UM mailbox policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="409973">منظم فولڈر میل باکس پالیسی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15_397203_409973"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical grouping of managed folders. When a managed folder mailbox policy is applied to a user’s mailbox, all the managed folders that are linked to the policy are deployed in a single operation, thereby making the deployment of messaging records management (MRM) easier.</descrip></descripGrp><ntig><termGrp><term id="397203">managed folder mailbox policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="409973">منظم فولڈر میل باکس پالیسی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSele