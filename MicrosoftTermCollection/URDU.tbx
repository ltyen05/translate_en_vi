in transit to detect attempts at modification. WEP offers both 40-bit and 128-bit hardware-based encryption options.</descrip></descripGrp><ntig><termGrp><term id="269345">WEP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402781">WEP</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2105_545690_1934394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that shows text formatting and a simplified page layout.</descrip></descripGrp><ntig><termGrp><term id="545690">draft view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934394">مسودہ منظر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21053_766415_1217658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disk image provided for use in repairing or reinstalling an installation of Windows.</descrip></descripGrp><ntig><termGrp><term id="766415">recovery image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217658">نقش بازیافت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet>