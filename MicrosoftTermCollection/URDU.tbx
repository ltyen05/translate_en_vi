termGrp></ntig></langSet></termEntry><termEntry id="52796_3000148_3000309"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Set of settings accessible directly from the right corner of the Windows 11 taskbar (e.g. brightness, Wi-Fi, Bluetooth, etc.).</descrip></descripGrp><ntig><termGrp><term id="3000148">quick settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3000309">فوری ترتیبات</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52797_3000149_3000310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Refreshed version of the Segoe UI font redesigned as a variable font to improve readability and scalability for Windows 11.</descrip></descripGrp><ntig><termGrp><term id="3000149">Segoe UI Variable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3000310">Segoe UI متغیر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52798_3000151_3000301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service, powered by Azure, that enables presence and shared experiences from anywhere – on any device – through mixed reality applications; the app for Hololens that lets people connect, share, and collaborate in mixed reality that runs on that service.</descrip></descripGrp><ntig><termGrp><term id="3000151">Microsoft Mesh</term><termNote type="partO