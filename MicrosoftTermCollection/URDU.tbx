بوط اکاؤنٹس</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24914_1165826_1962596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bubble that appears when a user clicks in a field or on a control in the user interface. The Help bubble contains information that helps the user know what to do.</descrip></descripGrp><ntig><termGrp><term id="1165826">Help bubble</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962596">امدادی بلبلہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24915_1165827_1962601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule that is defined by an end-user using Outlook or Outlook Web App. When a message that meets the conditions of the rule is sent or received, the rule triggers an action that is performed automatically.</descrip></descripGrp><ntig><termGrp><term id="1165827">Inbox rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962601">ان باکس کا قاعدہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24917_1165829_1962627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A company that provides text messaging services.</descrip></descripGrp><ntig><termGrp><term id="1165829">mobile service provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962627">موبائل خدمت مہيا کار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24919_1165832_1934602"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slider control where the maximum and minimum values of the range can be modified.</descrip></descripGrp><ntig><termGrp><term id="1165832">multi-stop slider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934602">کثیر سٹاپ سلائیڈر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2492_397154_410056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that resides in a folder that uses an event sink. The item provides the store with information that includes what events will trigger the sink, the name of the sink, and options such as restrictions for when the event will fire.</descrip></descripGrp><ntig><termGrp><term id="397154">event registration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="410056">واقعے کا اندارج</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24928_1165905_1934604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that contains galleries where the user can create, store, and find reusable pieces of content, including AutoText, document properties, fields and building blocks.</descrip></descripGrp><ntig><termGrp><term id="1165905">Quick Parts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934604">سريع حصے</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24931_1165919_1521374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To set again with a different value.</descrip></descripGrp><ntig><termGrp><term id="1165919">reset</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1521374">پھر سیٹ کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24935_1165946_1521375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To obtain a new password when the old one is forgotten or expired.</descrip></descripGrp><ntig><termGrp><term id="1165946">reset</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1521375">پھر سیٹ کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2495_47034_410057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fully qualified unique name, used to identify an object in a directory, that specifies the complete path to the object through the hierarchy of directory containers.</descrip></descripGrp><ntig><termGrp><term id="47034">distinguished name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="410057">بدلا ہوا نام</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24966_1166067_1962477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intermediary between a software publisher and a certification authority (CA). The local registration authority can, for example, verify a publisher's credentials before sending them to the CA.</descrip></descripGrp><ntig><termGrp><term id="1166067">local registration authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962477">مقامی رجسٹرکاری مجازیت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24966_1166067_1962478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intermediary between a software publisher and a certification authority (CA). The local registration authority can, for example, verify a publisher's credentials before sending them to the CA.</descrip></descripGrp><ntig><termGrp><term id="1166067">local registration authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962478">LRA</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24966_1166080_1962477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intermediary between a software publisher and a certification authority (CA). The local registration authority can, for example, verify a publisher's credentials before sending them to the CA.</descrip></descripGrp><ntig><termGrp><term id="1166080">LRA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962477">مقامی رجسٹرکاری مجازیت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24966_1166080_1962478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intermediary between a software publisher and a certification authority (CA). The local registration authority can, for example, verify a publisher's credentials before sending them to the CA.</descrip></descripGrp><ntig><termGrp><term id="1166080">LRA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962478">LRA</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24987_1166123_1934605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A defined point in a workflow that is entered when specified conditions are met.</descrip></descripGrp><ntig><termGrp><term id="1166123">workflow stage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934605">کام فلو سٹیج</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25_42999_1216856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In communications, the portion of a Data Terminal Equipment (DTE) device that sends data.</descrip></descripGrp><ntig><termGrp><term id="42999">data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1216856">کوائف ماخذ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2500_81423_1962628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who reviews content in certain online newsgroups, mailing lists, and forums in order to decide if they are appropriate or not, editing or deleting the ones that aren’t prior to them being they are made public.</descrip></descripGrp><ntig><termGrp><term id="81423">moderator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962628">منتظم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25004_1167216_2261396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that uses speech recognition to enable you to interact with your computer or other devices by voice. You can dictate documents and emails in mainstream applications, and use voice commands to start and switch between applications, control the operating system and even fill out forms on the web.</descrip></descripGrp><ntig><termGrp><term id="1167216">Windows Speech Recognition</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2261396">Windows گفتگو شناس</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25008_1765219_1769769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text-based post on Twitter.</descrip></descripGrp><ntig><termGrp><term id="1765219">Tweet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1769769">ٹویٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25008_2060482_1769769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text-based post on Twitter.</descrip></descripGrp><ntig><termGrp><term id="2060482">tweet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1769769">ٹویٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2502_179897_402402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A node with subordinate node(s), called children.</descrip></descripGrp><ntig><termGrp><term id="179897">parent node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402402">جدی نوڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2503_397207_410029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combined data from an Office Outlook user's Safe Senders List, Safe Recipients List, Blocked Senders List, and external contacts, that is stored in Outlook and in the Exchange mailbox.</descrip></descripGrp><ntig><termGrp><term id="397207">safe list collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="410029">محفوظ فہرست کا ذخیرہ کرنا</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25060_1167275_1934606"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item in the global address list that provides an easy way to send messages to a group of people. A public group can include any item from a global address list, including other public groups.</descrip></descripGrp><ntig><termGrp><term id="1167275">public group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934606">عوامی گروپ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25061_1167276_2927119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process used to try to locate the name of a person, from a directory or other information store, based on a telephone number.</descrip></descripGrp><ntig><termGrp><term id="1167276">reverse number lookup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2927119">ریورس نمبر لک اپ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25061_1167277_2927119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process used to try to locate the name of a person, from a directory or other information store, based on a telephone number.</descrip></descripGrp><ntig><termGrp><term id="1167277">RNL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2927119">ریورس نمبر لک اپ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25064_1167283_1962420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A voice message that's played to callers to let them know that the person they called is away for an extended period of time and unavailable to answer the phone. It can be customized by the user. It's different from the voice mail greeting that's played when the recipient is away for a short period of time.</descrip></descripGrp><ntig><termGrp><term id="1167283">away greeting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962420">دور گریٹنگ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25074_1190063_1934624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An add-in for Microsoft Excel that you can build with any compiler that supports building DLLs (dynamic link libraries).</descrip></descripGrp><ntig><termGrp><term id="1190063">XLL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934624">XLL</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25093_1167388_3064672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The admin center where administrator can manage their SharePoint Online service, including creating and deleting site collections, managing user accounts and storage quota, and specifying service settings.</descrip></descripGrp><ntig><termGrp><term id="1167388">SharePoint Online Administration Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3064672">SharePoint ایڈمن سینٹر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25093_1167388_3064675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The admin center where administrator can manage their SharePoint Online service, including creating and deleting site collections, managing user accounts and storage quota, and specifying service settings.</descrip></descripGrp><ntig><termGrp><term id="1167388">SharePoint Online Administration Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3064675">SharePoint آن لائن ایڈمنسٹریشن سینٹر</term><termNote type