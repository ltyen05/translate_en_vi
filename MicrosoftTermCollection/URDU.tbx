ound images for the Windows lock screen and/or the Windows desktop, with hotspots overlaying linking to information about the image, in-product marketing, experiences, or tips and tricks.</descrip></descripGrp><ntig><termGrp><term id="2884921">spotlight collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2885040">توجہ کے مرکز کا مجموعہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51108_2885547_2886367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To stream the content of a user's device screen or a separate window to the screens of other users' devices, so these users could remotely see the screen of the user who shares it.</descrip></descripGrp><ntig><termGrp><term id="2885547">share</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2886367">اشتراک کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51109_2885548_2886365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that helps users be more productive at work, such as Office apps.</descrip></descripGrp><ntig><termGrp><term id="2885548">productivity app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2886365">بارآوری ایپ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51113_2886072_2886098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The United States holiday celebrated on June 14 that commemorates the adoption of the flag of the United States.</descrip></descripGrp><ntig><termGrp><term id="2886072">Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2886098">یوم پرچم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51114_2886073_2886099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Croatian national holiday celebrated on May 30 to commemorate the constitution of the first modern multi-party Croatian Parliament.</descrip></descripGrp><ntig><termGrp><term id="2886073">Statehood Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2886099">یوم تشکیل ریاست</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5112_136266_402180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Windows multimedia file format for sound and videos that uses the Microsoft Resource Interchange File Format (RIFF) specification.</descrip></descripGrp><ntig><termGrp><term id="136266">Audio Video Interleaved</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402180">آڈیو وڈیو باہم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5112_136266_402181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Windows multimedia file format for sound and videos that uses the Microsoft Resource Interchange File Format (RIFF) specification.</descrip></descripGrp><ntig><termGrp><term id="136266">Audio Video Interleaved</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402181">AVI</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5112_136267_402180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Windows multimedia file format for sound and videos that uses the Microsoft Resource Interchange File Format (RIFF) specification.</descrip></descripGrp><ntig><termGrp><term id="136267">AVI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402180">آڈیو وڈیو باہم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></