Grp><term id="402370">پیش کمپوز کریکٹر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21381_1102876_1217705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that displays a definition or translation of a word or piece of text in a ScreenTip when the pointer is moved over the selection.</descrip></descripGrp><ntig><termGrp><term id="1102876">Mini Translator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217705">خرد مترجم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21402_775135_2371758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A radio network that provides coverage for cellular telephone communications.</descrip></descripGrp><ntig><termGrp><term id="775135">cellular network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2371758">موبائل نیٹ ورک</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21402_775136_2371758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A radio network that provides coverage for cellular telephone communications.</descrip></descripGrp><ntig><termGrp><term id="775136">cellular</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2371758">موبائل نیٹ ورک</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21407_776107_1217706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To copy driver binaries, install services, and add registry keys for one or more drivers from a driver package onto a system, without the context of a specific device. A system can be booted from reflected drivers, however full device installation may still be required in order to enable full driver functionality.</descrip></descripGrp><ntig><termGrp><term id="776107">reflect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217706">منعکس کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21417_777441_1217707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that enables users to share pictures, music, videos, documents, and printers with other people on a home network.</descrip></descripGrp><ntig><termGrp><term id="777441">Windows HomeGroup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217707">HomeGroup</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21417_779020_1217707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that enables users to share pictures, music, videos, documents, and printers with other people on a home network.</descrip></descripGrp><ntig><termGrp><term id="779020">HomeGroup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217707">HomeGroup</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21430_3007378_3007929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to draw an irregular line, such as a circle or a triangle, around an object that you want to capture.</descrip></descripGrp><ntig><termGrp><term id="3007378">Free-form mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3007929">فارم سے پاک موڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21430_777464_3007929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to draw an irregular line, such as a circle or a triangle, around an object that you want to capture.</descrip></descripGrp><ntig><termGrp><term id="777464">Free-form Snip</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3007929">فارم سے پاک موڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21431_3007379_3007930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to capture the entire screen, similar to pressing PRINT SCREEN.</descrip></descripGrp><ntig><termGrp><term id="3007379">Full-screen mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3007930">پوری اسکرین موڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21431_777465_3007930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to capture the entire screen, similar to pressing PRINT SCREEN.</descrip></descripGrp><ntig><termGrp><term id="777465">Full-screen Snip</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3007930">پوری اسکرین موڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21438_3007380_3007932"><langSet xml: