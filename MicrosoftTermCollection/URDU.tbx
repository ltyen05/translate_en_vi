="definition">The record of an Edge Transport server that has been subscribed to an Exchange organization and to which the Microsoft Exchange EdgeSync service propagates recipient and configuration data. The Microsoft Exchange EdgeSync service relies on Edge Subscriptions. Also, Edge Subscription is the process that is required to establish an Edge Subscription for a given Edge Transport server.</descrip></descripGrp><ntig><termGrp><term id="397146">Edge Subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="409948">حتمی صارفیت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12626_1088729_1934582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having values separated from each other by tabs.</descrip></descripGrp><ntig><termGrp><term id="1088729">tab-delimited</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934582">جدول تحدیدی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12626_119220_1934582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having values separated from each other by tabs.</descrip></descripGrp><ntig><termGrp><term id="119220">tab delimited</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><nt