rface قلم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38897_2262104_2263977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature which enables printing from a Windows mobile device.</descrip></descripGrp><ntig><termGrp><term id="2262104">mobile printing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2263977">موبائل پرنٹنگ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3891_397160_409923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To split a message for routing purposes to deliver to multiple recipients.</descrip></descripGrp><ntig><termGrp><term id="397160">fan out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="409923">فہرست تقسیم میں توسیع</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38912_2263092_2263979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Music Store subscription-based account.</descrip></descripGrp><ntig><termGrp><term id="2263092">Music Pass</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2263979">Music Pass</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38922_2263480_2290563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pie chart that is used to visualize hierarchical data, depicted by concentric circles.</descrip></descripGrp><ntig><termGrp><term id="2263480">sunburst chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2290563">سنب برسٹ چارٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38923_2263486_2290564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that displays hierarchical data as a set of nested rectangles.</descrip></descripGrp><ntig><termGrp><term id="2263486">treemap chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2290564">ٹری میپ چارٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38973_2264865_2265268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that provides consumers and businesses with hassle-free Internet access at the most popular Wi-Fi locations around the world, such as hotels chains, airports, conference centers and over 15 million places worldwide.</descrip></descripGrp><ntig><termGrp><term id="2264865">Microsoft Wi-Fi</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2265268">Microsoft وائی-فائی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38975_2264866_2265267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The hidden utility that works in the background to connect Windows features to a 3rd party service.</descrip></descripGrp><ntig><termGrp><term id="2264866">App connector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2265267">ایپ کنکٹر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38980_2267302_2270943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of REST APIs that allows app developers unified access to entities and relationships from Microsoft and Office 365 services.</descrip></descripGrp><ntig><termGrp><term id="2267302">Microsoft Graph</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2270943">Microsoft Graph</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38994_2267490_2427735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected set of episodes or events that run under the same title, usually within the course of one year.</descrip></descripGrp><ntig><termGrp><term id="2267490">season</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2427735">موسم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38995_2267556_2344244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default text in the sign-in page prompting the user to enter the credentials to access Microsoft cloud services.</descrip></descripGrp><ntig><termGrp><term id="2267556">Sign in with your work or school account</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2344244">اپنے جائے کار يا اسکول اکاؤنٹ کے ساتھ سائن ان کريں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="390_18288_1217370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Referring to anything that is ready for immediate use by a user or application.</descrip></descripGrp><ntig><termGrp><term id="18288">available</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217370">دستیاب</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39011_2321515_2323773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Music, a highly personalized form of auto-playlist (rules-based playlist) that is created by Microsoft for the customer, drawing music from the customer's music collection, and, if the customer has an active music pass, may also include songs from our music catalog.</descrip></descripGrp><ntig><termGrp><term id="2321515">mixtape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2323773">مرکب ٹیپ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39012_2268334_2269434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Cellular data that customers can buy from the Windows Store to connect to their Windows device.</descrip></descripGrp><ntig><termGrp><term id="2268334">paid cellular data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2269434">بامعاوضہ موبائل ڈیٹا</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><t