er">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2488769">ملاقات لاگ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44262_2486900_2488768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A record of a call</descrip></descripGrp><ntig><termGrp><term id="2486900">call log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2488768">کال لاگ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4427_297178_402831"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that changes browser settings, such as the home page, without adequate consent.</descrip></descripGrp><ntig><termGrp><term id="297178">browser modifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402831">براؤزر ترمیم کار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44283_2488671_2493857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Outlook Customer Manager where the most important deals and information on those deals are displayed.</descrip></descripGrp><ntig><termGrp><term id="2488671">Focused</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2493857">مرکوز</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44290_2488792_2493851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field in Outlook Customer Manager that holds the negotiable amount the provider will receive for a deal and which is finalized once the deal is closed.</descrip></descripGrp><ntig><termGrp><term id="2488792">Deal amount</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2493851">معاملہ کی رقم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44291_2488793_2493853"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field in Outlook Customer Manager that records the number of deals that did not go through as well as their sum.</descrip></descripGrp><ntig><termGrp><term id="2488793">Deals lost</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2493853">ناکام معاملات</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44292_2488794_2493854"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field in Outlook Customer Manager that records the number of deals that were accepted and completed as well as their sum.</descrip></descripGrp><ntig><termGrp><term id="2488794">Deals won</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2493854">کامیاب معاملات</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44293_2488795_2493852"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field in Outlook Customer Manager that records the number of deals have not been finalized (won or lost), as well as their sum.</descrip></descripGrp><ntig><termGrp><term id="2488795">Deals active</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2493852">زیر عمل معاملات</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44329_2489211_2590081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application available on devices you manage with Intune which is used to access company data to perform common tasks like enrolling devices, installing apps, and locating information for assistance from your IT department.</descrip></descripGrp><ntig><termGrp><term id="2489211">Intune Company Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2590081">Intune Company Portal</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44329_2489211_2590145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application available on devices you manage with Intune which is used to access company data to perform common tasks like enrolling devices, installing apps, and locating information for assistance from your IT department.</descrip></descripGrp><ntig><termGrp><term id="2489211">Intune Company Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2590145">Company Portal</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44329_2490036_2590081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application available on devices you manage with Intune which is used to access company data to perform common tasks like enrolling devices, installing apps, and locating information for assistance from your IT department.</descrip></descripGrp><ntig><termGrp><term id="2490036">Company Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2590081">Intune Company Portal</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44329_2490036_2590145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application available on devices you manage with Intune which is used to access company data to perform common tasks like enrolling devices, installing apps, and locating information for assistance from your IT department.</descrip></descripGrp><ntig><termGrp><term id="2490036">Company Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2590145">Company Portal</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44349_2490693_2499697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to select a later time to automatically deliver emails and where said emails are stored in the Drafts folder until the time selected for sending.​</descrip></descripGrp><ntig><termGrp><term id="2490693">Send Later</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2499697">بعد ازاں بھيجيں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44350_2490694_2502203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that Excel returns when a formula returns an array of values and one or more of the cells it would spill to already has content.</descrip></descripGrp><ntig><termGrp><term id="2490694">#NOSPILL!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2502203">#NOSPILL!</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44351_2490695_2499699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that Excel returns when a function tried to connect to a network resource or a remote service but failed.​​</descrip></descripGrp><ntig><termGrp><term id="2490695">#CONNECT!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2499699">#CONNECT!</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44352_2490696_2502202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel cell capability that allows a cell to place array values in neighboring blank cells.</descrip></descripGrp><ntig><termGrp><term id="2490696">Spill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2502202">اسپِل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</te