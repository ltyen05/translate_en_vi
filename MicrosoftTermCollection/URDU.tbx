ripGrp><ntig><termGrp><term id="652425">network diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433988">نیٹ ورک ڈایا گرام</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19325_652427_1217601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text that you enter by using a keyboard or that your Tablet PC converts from handwriting or speech.</descrip></descripGrp><ntig><termGrp><term id="652427">typed text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217601">ٹائپ شدہ متن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19329_652432_1433989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that displays resource information. Resource views include the Resource Sheet, the Resource Graph, the Resource Usage, and the resource forms views.</descrip></descripGrp><ntig><termGrp><term id="652432">resource view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433989">وسیلہ منظر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></la