ripGrp><descrip type="definition">A return code that begins with E_ or DB_E_ and indicates that the method failed completely and was unable to do any useful work. Usually indicates a programming error.</descrip></descripGrp><ntig><termGrp><term id="318141">error code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402988">نقص کوڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11362_232517_1934333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual shape that contains default formatting properties for new shapes. Each presentation contains one default shape.</descrip></descripGrp><ntig><termGrp><term id="232517">default shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934333">طے شدہ شکل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11363_359696_403229"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree to which a product or service executes its specified function.</descrip></descripGrp><ntig><termGrp><term id="359696">performance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="403229">کارکردگی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNo