">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2378119">نئی گیمز</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41954_2375038_2378118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for apps that were recently added to the Store.</descrip></descripGrp><ntig><termGrp><term id="2375038">New apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2378118">نئی ایپس</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41955_2375039_2378112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for the games that are played the most by Store customers.</descrip></descripGrp><ntig><termGrp><term id="2375039">Most played games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2378112">سب سے زیادہ کھیلی جانے والی گیمز</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41956_2375040_2378111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for the apps that are played the most by Store customers.</descrip></descripGrp><ntig><termGrp><term id="2375040">Most played apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2378111">سب سے زیادہ چلائی جانے والی ایپس</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41957_2375041_2378120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who informally represents their feature team by sharing their expertise with the community in activities such as listening and responding to customer feedback, contributing to community forums, blogging about tips and tricks, and more.</descrip></descripGrp><ntig><termGrp><term id="2375041">community champion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2378120">کمیونٹی چیمپیئن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41957_2751151_2378120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who informally represents their feature team by sharing their expertise with the community in activities such as listening and responding to customer feedback, contributing to community forums, blogging about tips and tricks, and more.</descrip></descripGrp><ntig><termGrp><term id="2751151">community champ</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2378120">کمیونٹی چیمپیئن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4196_213534_402489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of colors or levels of gray that can be displayed at one time. The amount or memory in the computer's graphics controller card controls the display. An 8-bit controller can display 256 colors or levels of gray; a 16-bit controller, 64,000 colors; and a 24-bit controller, 16.8 million colors.</descrip></descripGrp><ntig><termGrp><term id="213534">bit specification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402489">بٹ تخصیص</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41961_2375458_3113160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The basic amount of the guaranteed ingress/egress of events sent to an Event Hub that can be dynamically scaled according to stream processing, to pay only for compute needs and handle jobs with gigabytes/sec of streamed data.</descrip></descripGrp><ntig><termGrp><term id="2375458">capacity unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3113160">گنجائش کی یونٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41961_2766779_3113160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The basic amount of the guaranteed ingress/egress of events sent to an Event Hub that can be dynamically scaled according to stream processing, to pay only for compute needs and handle jobs with gigabytes/sec of streamed data.</descrip></descripGrp><ntig><termGrp><term id="2766779">CU</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3113160">گنجائش کی یونٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4197_113668_402045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A power-saving state that allows the computer or device to quickly resume full-power operation (typically within several seconds) when you want to start working again. All open documents and programs are saved to memory before the computer or device enters the low-power state.</descrip></descripGrp><ntig><termGrp><term id="113668">sleep</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402045">سلیپ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4197_113668_402930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A power-saving state that allows the computer or device to quickly resume full-power operation (typically within several seconds) when you want to start working again. All open documents and programs are saved to memory before the computer or device enters the low-power state.</descrip></descripGrp><ntig><termGrp><term id="113668">sleep</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402930">سلیپ موڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4197_312080_402045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A power-saving state that allows the computer or device to quickly resume full-power operation (typically within several seconds) when you want to start working again. All open documents and programs are saved to memory before the computer or device enters the low-power state.</descrip></descripGrp><ntig><termGrp><term id="312080">sleep mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402045">سلیپ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4197_312080_402930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A power-saving state that allows the computer or device to quickly resume full-power operation (typically within several seconds) when you want to start working again. All open documents and programs are saved to memory before the computer or device enters the low-power state.</descrip></descripGrp><ntig><termGrp><term id="312080">sleep mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402930">سلیپ موڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41978_2375534_2378123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The nickname for Windows 10, version 1607​, used by marketing and executives in announcements about this update, but not in the product.​</descrip></descripGrp><ntig><termGrp><term id="2375534">Windows 10 Anniversary Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2378123">Windows 10 سالگرہ تازہ کاری</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42013_2376461_2380717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The grouping of similar apps together on the taskbar.</descrip></descripGrp><ntig><termGrp><term id="2376461">glomming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2380717">گچھا بنانا</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42014_2376761_2383544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ribbon tab that gives users a set of options for editing graphics in their PowerPoint slides, Word documents, and Excel documents.</descrip></descripGrp><ntig><termGrp><term id="2376761">Graphics Tools</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2383544">گرافک ٹولز</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42015_2376763_2383535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to replace a graphic with a different one.</descrip></descripGrp><ntig><termGrp><term id="2376763">Change Graphic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2383535">گرافک تبدیلی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42016_2376766_2383548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to undo accumulated changes to a graphic.</descrip></descripGrp><ntig><termGrp><term id="2376766">Reset Graphic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2383548">ری سیٹ گرافک</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender"