Grp><term id="2029640">کلائنٹ رسائی قاعدہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3535_397220_410050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Anti-spam functionality that is enabled on computers that have the Edge Transport server role installed to block messages according to characteristics of the sender. The Sender Reputation agent continuously monitors senders and their past Simple Mail Transfer Protocol (SMTP) interactions, such as the amount of spam and messages that are not spam that a sender has sent, and relies on persisted data about the sender to determine what action, if any, to take on an inbound message.</descrip></descripGrp><ntig><termGrp><term id="397220">sender reputation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="410050">مرسل کی شناخت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3537_232842_1217410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A global template that you can use for any type of document. You can modify this template to change the default document formatting or content.</descrip></descripGrp><ntig><termGrp><term id="232842">Normal template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217410">عام سانچا</term><termNote type="geographicalUsage">PAK</termNote><termNote type="pa