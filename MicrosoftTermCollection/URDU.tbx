ig></langSet></termEntry><termEntry id="4918_234579_402570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gallery for text and graphics, such as a standard contract clause, that can be used multiple times in one or more documents. Each selection of text or graphics is recorded as an AutoText entry and assigned a unique name. It is visible in Quick Parts and the Building Blocks Organizer.</descrip></descripGrp><ntig><termGrp><term id="234579">AutoText</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402570">تیار متن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4919_207657_1799847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search feature associated with folders and programs that begins to display results as soon as a keyword is entered. When you enter text, files in the current view are automatically filtered to show only those that match what you typed.</descrip></descripGrp><ntig><termGrp><term id="207657">Quick Search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1799847">فورى تلاش</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4919_207657_402440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search feature associated with folders and programs that begins to display results as soon as a keyword is ent