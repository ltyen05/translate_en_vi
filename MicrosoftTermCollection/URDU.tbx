">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25782_2603788_2605758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system mailbox in which copies of the mailbox search results are stored.</descrip></descripGrp><ntig><termGrp><term id="2603788">discovery system mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2605758">eDiscovery میل باکس</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25782_2604808_1985484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system mailbox in which copies of the mailbox search results are stored.</descrip></descripGrp><ntig><termGrp><term id="2604808">eDiscovery mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1985484">ڈسکوری میل باکس</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25782_2604808_2605758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system mailbox in which copies of the mailbox search results are stored.</descrip></descripGrp><ntig><termGrp><term id="2604808">eDiscovery mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lan