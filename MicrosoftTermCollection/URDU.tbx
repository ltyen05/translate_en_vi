ang="ur"><ntig><termGrp><term id="402308">وین ڈایا گرام</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11795_147980_1799870"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to keyboard settings, document views, user interface objects, languages, etc. for which text is displayed in a right-to-left direction.</descrip></descripGrp><ntig><termGrp><term id="147980">right-to-left</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1799870">RTL</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11795_147980_402291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to keyboard settings, document views, user interface objects, languages, etc. for which text is displayed in a right-to-left direction.</descrip></descripGrp><ntig><termGrp><term id="147980">right-to-left</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402291">دائیں سے بائیں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11795_661874_1799870"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to keyboard settings, document views, user interface objects, languages, etc. for which text is displayed in a right-to-left direction.</descrip></descripGrp><ntig><termGrp><term id="661874">RTL</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1799870">RTL</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11795_661874_402291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to keyboard settings, document views, user interface objects, languages, etc. for which text is displayed in a right-to-left direction.</descrip></descripGrp><ntig><termGrp><term id="661874">RTL</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402291">دائیں سے بائیں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11797_149448_1217502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that includes the name of the person who originally sent a task request plus the names of everyone who received the task request, reassigned the task to someone else, or chose to keep an updated copy of the task in their task list.</descrip></descripGrp><ntig><termGrp><term id="149448">update list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217502">تازہ فہرست</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11798_106558_2105910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line printed above, below, or to the side of some element, either to set that item off from the remainder of the page or to improve the look of the page. Footnotes, for example, often appear below a short rule that sets them off from the main text on the page. The thickness of a rule is typically measured in points. (A point is approximately 1/72 inch.)</descrip></descripGrp><ntig><termGrp><term id="106558">rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2105910">قاعدہ سطر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11798_2085540_2105910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line printed above, below, or to the side of some element, either to set that item off from the remainder of the page or to improve the look of the page. Footnotes, for example, often appear below a short rule that sets them off from the main text on the page. The thickness of a rule is typically measured in points. (A point is approximately 1/72 inch.)</descrip></descripGrp><ntig><termGrp><term id="2085540">rule line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2105910">قاعدہ سطر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11799_234773_402582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows deletion of the files created during hibernation.</descrip></descripGrp><ntig><termGrp><term id="234773">Hibernation File Cleaner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402582">خفتہ کاری مسل صفاکار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1180_89323_1217377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To extend over and cover a part of something.</descrip></descripGrp><ntig><termGrp><term id="89323">overlap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217377">برتحریر کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11800_118815_1638935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information about a computer that's derived from the System Information program.</descrip></descripGrp><ntig><termGrp><term id="118815">system info</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1638935">نظام کی معلومات</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11803_89506_2304722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A role that controls how permissions are set and can grant permissions to others.</descrip></descripGrp><ntig><termGrp><term id="89506">owner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2304722">مالک</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11804_118547_402078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of entities working together to accomplish a task.</descrip></descripGrp><ntig><termGrp><term id="118547">system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402078">نظام</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11805_121970_1934172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The slide that stores information from the design template pertaining to styles on title slides, including placeholder sizes and positions, background design, and color schemes.</descrip></descripGrp><ntig><termGrp><term id="121970">title master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934172">عنوان ماسٹر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1181_144723_1934235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Margins of the left page are a mirror image of those of the right page. That is, the inside margins are the same width, and the outside margins are the same width.</descrip></descripGrp><ntig><termGrp><term id="144723">mirror margins</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934235">آئینہ حاشیے</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11810_210490_402455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A networking standard that uses cables to provide network access. Ethernet is the most widely installed technology for connecting computers.</descrip></descripGrp><ntig><termGrp><term id="210490">Ethernet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402455">ایتھرنیٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11820_125350_402116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character-encoding standard developed by the Unicode Consortium that represents almost all of the written languages of the world. The Unicode character repertoire has multiple representation forms, including UTF-8, UTF-16, and UTF-32. Most Windows interfaces use the UTF-16 form.</descrip></descripGrp><ntig><termGrp><term id="125350">Unicode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402116">یونی کوڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11821_77656_401849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of display that uses a liquid compound having a polar molecular structure, sandwiched between two transparent electrodes. When an electric field is applied, the molecules align with the field, forming a crystalline arrangement that polarizes the light passing through it. A polarized filter laminated over the electrodes blocks polarized light. In this way, a grid of electrodes can selectively "turn on" a cell, or a pixel, containing the liquid crystal material, turning it dark.</descrip></descripGrp><ntig><termGrp><term id="77656">LCD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401849">LCD</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11821_77656_401850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of display that uses a liquid compound having a polar molecular structure, sandwiched between two transparent electrodes. When an electric field is applied, the molecules align with the field, forming a crystalline arrangement that polarizes the light passing through it. A polarized filter laminated over the electrodes blocks polarized light. In this way, a grid of electrodes can selectively "turn on" a cell, or a pixel, containing the liquid crystal material, turning it dark.</descrip></descripGrp><ntig><termGrp><term id="77656">LCD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401850">مائع بلور ڈسپلے</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11821_77658_401849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of display that uses a liquid compound having a polar molecular structure, sandwiched between two transparent electrodes. When an electric field is applied, the molecules align with the field, forming a crystalline arrangement that polarizes the light passing through it. A polarized filter laminated over the electrodes blocks polarized light. In this way, a grid of electrodes can selectively "turn on" a cell, or a pixel, containing the liquid crystal material, turning it dark.</descrip></descripGrp><ntig><termGrp><term id="77658">liquid crystal display</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401849">LCD</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11821_77658_401850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of display that uses a liquid compound having a polar molecular structure, sandwiched between two transparent electrodes. When an electric field is applied, the molecules align with the field, forming a crystalline arrangement that polarizes the light passing through it. A polarized filter laminated over the electrodes blocks polarized light. In this way, a grid of electrodes can selectively "turn on" a cell, or a pixel, containing the liquid crystal material, turning it dark.</descrip></descripGrp><ntig><termGrp><term id="77658">liquid crystal display</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401850">مائع بلور ڈسپلے</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1183_346957_403179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that cannot be found or recovered.</descrip></descripGrp><ntig><termGrp><term id="346957">lost data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="403179">ضائع کوائف</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11832_231956_402512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference to a range that spans two or more worksheets in a workbook.</descrip></descripGrp><ntig><termGrp><term id="231956">3-D reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402512">۔3D حوالہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11847_23740_401434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location in a program at which execution is halted so that a programmer can examine the program's status, the contents of variables, and so on.</descrip></descripGrp><ntig><termGrp><term id="23740">breakpoint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401434">توڑ مقام</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11859_1468785_2005579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique bank registration number that a bank uses to identify itself.</descrip></descripGrp><ntig><termGrp><term id="1468785">transit number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2005579">بینک کوڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11859_1468785_2005610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique bank registration number that a bank uses to identify itself.</descrip></descripGrp><ntig><termGrp><term id="1468785">transit number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2005610">بینک ٹرانزٹ نمبر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11859_1993199_2005579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique bank registration number that a bank uses to identify itself.</descrip></descripGrp><ntig><termGrp><term id="1993199">bank transit number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2005579">بینک کوڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11859_1993199_2005610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique bank registration number that a bank uses to identify itself.</descrip></descripGrp><ntig><termGrp><term id="1993199">bank transit number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2005610">بینک ٹرانزٹ نمبر</term><termNote type="geographicalU