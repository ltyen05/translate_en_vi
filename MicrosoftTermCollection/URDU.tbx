><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2338120">چَیٹ دریچہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40078_2329180_2338119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of chat messages sent by the user or received from their contacts or groups.</descrip></descripGrp><ntig><termGrp><term id="2329180">chat history</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2338119">چَیٹ سابقات</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40080_2329245_2331439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that lets a user hide an email message from their inbox, setting it to return to the top of their inbox at a specified date and time. It lets the user clear their inbox by postponing items that aren't urgent.</descrip></descripGrp><ntig><termGrp><term id="2329245">Schedule</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2331439">میقات بندی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40081_2329246_2331438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark an email message or conversation such that it moves to the top of your inbox and is flagged at a specified date and time.</descrip></descripGrp><ntig><termGrp><term id="2329246">schedule</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2331438">میقات بندی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40082_2329247_2329624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of enterprise-related hardware and software security features that, when configured together, will lock a device down so that it can only run trusted applications.​​​</descrip></descripGrp><ntig><termGrp><term id="2329247">Device Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2329624">Device Guard</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40082_2329247_3084913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of enterprise-related hardware and software security features that, when configured together, will lock a device down so that it can only run trusted applications.​​​</descrip></descripGrp><ntig><termGrp><term id="2329247">Device Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNo