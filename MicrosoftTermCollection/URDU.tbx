.</descrip></descripGrp><ntig><termGrp><term id="359992">external table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="403233">بیرونی جدول</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11141_79960_1934146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The content that is delivered in an email message.</descrip></descripGrp><ntig><termGrp><term id="79960">message body</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934146">پیغام کی تفصیل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11146_210474_1934300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The digital signature functionality including Digital Signatures, electronic signatures, Mark As Final and Electronic Postmarks.</descrip></descripGrp><ntig><termGrp><term id="210474">Signing Services for Office</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934300">Office کے لئے دستخط کرنے کى خدمات</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1