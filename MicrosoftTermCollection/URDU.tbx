ripGrp><descrip type="definition">The ink effect in the color of rose gold.</descrip></descripGrp><ntig><termGrp><term id="2556942">rose gold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2557683">روز گولڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45292_2556943_2557672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ink effect that resembles the color and texture of lava.</descrip></descripGrp><ntig><termGrp><term id="2556943">lava</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2557672">لاوا</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45294_2556950_2557670"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature applied to an object on the screen to change its visual appearance often to cause a certain reaction.</descrip></descripGrp><ntig><termGrp><term id="2556950">effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2557670">اثر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></lang