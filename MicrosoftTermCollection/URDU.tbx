</descripGrp><ntig><termGrp><term id="125493">web address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217539">URL</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14888_125493_1521406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An address that uniquely identifies a location on the Internet. A URL is usually preceded by http://, as in http://www.microsoft.com. A URL can contain more detail, such as the name of a page of hypertext, often with the file name extension .html or .htm.</descrip></descripGrp><ntig><termGrp><term id="125493">web address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1521406">ویب پتا</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14889_87410_401916"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that supports the OLE protocol for object linking and embedding.</descrip></descripGrp><ntig><termGrp><term id="87410">OLE object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401916">آبجیکٹ OLE</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14893_397167_409992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filtering list that is used by the Connection Filter agent in Exchange Server 2007. IP addresses on the IP Allow list are considered "safe" and are exempted from processing by other anti-spam agents.</descrip></descripGrp><ntig><termGrp><term id="397167">IP Allow list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="409992">IP اجازتی فہرست</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14895_397169_409962"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A third-party hardware device or product that connects a legacy PBX to a LAN. An IP/VoIP gateway translates or converts TDM or telephony circuit-switched protocols to packet switched protocols that can be used on a VoIP-based network.</descrip></descripGrp><ntig><termGrp><term id="397169">IP/VoIP gateway</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="409962">IP/VoIP  گیٹ وے</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14897_231964_402516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In statistical or scientific data, a bar that shows the potential error or degree of uncertainty relative to each data marker in a series.</