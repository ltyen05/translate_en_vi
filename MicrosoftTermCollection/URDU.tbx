ingular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401971">پوسٹ کوڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14148_140884_1216932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A combination of a digital certificate and a public and private encryption key set.</descrip></descripGrp><ntig><termGrp><term id="140884">Digital ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1216932">ڈیجیٹل شناخت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14148_140884_402237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A combination of a digital certificate and a public and private encryption key set.</descrip></descripGrp><ntig><termGrp><term id="140884">Digital ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402237">عددی شناخت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1415_64659_401750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The processes involved in the capture, storage, display, and printing of graphical images.</descrip></descripGrp><ntig><termGrp><term id="64659">imaging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401750">نقش کاری</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14155_233476_305467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of artificially delaying server responses for specific SMTP communication patterns that indicate high volumes of spam or other unwelcome email messages. The intent is to slow down the communication process for such email traffic so that the cost of sending spam increases for the person or organization who is sending the email.</descrip></descripGrp><ntig><termGrp><term id="233476">tarpitting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="305467">تاخیر کنندہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14178_1511499_2766625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of text entered by a user that is displayed to contacts.</descrip></descripGrp><ntig><termGrp><term id="1511499">personal note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2766625">ذاتی نوٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14178_502941_2766625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of text entered by a user that is displayed to contacts.</descrip></descripGrp><ntig><termGrp><term id="502941">note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2766625">ذاتی نوٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1418_35626_401534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window that mimics an old MS-DOS display for typing command-line instructions.</descrip></descripGrp><ntig><termGrp><term id="35626">command prompt window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401534">حکم لقمیہ دریچہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14189_233405_1217526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The list or table that's used to create a PivotTable or PivotChart report. Source data can be taken from an Excel list or range, an external database or cube, or another PivotTable report.</descrip></descripGrp><ntig><termGrp><term id="233405">source data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217526">ماخذ کوائف</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14194_45889_2278292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a digital signature to a macro or file.</descrip></descripGrp><ntig><termGrp><term id="45889">digitally sign</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2278292">عددی دستخط کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14195_67346_401763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A peripheral device whose purpose is to allow the user to provide input to a computer system. Examples of input devices are keyboards, mice, joysticks, and styluses.</descrip></descripGrp><ntig><termGrp><term id="67346">input device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401763">ان پٹ آلہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14199_12503_305440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A non-validated user who is not recognized by the server, and who can only access published folders and address lists.</descrip></descripGrp><ntig><