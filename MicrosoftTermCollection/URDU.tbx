maticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2398127">زوم کے ٹولز</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42303_2393982_2398123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dropdown menu that allows users to add or modify the border of their Summary Zoom, Slide Zoom, or Section Zoom.</descrip></descripGrp><ntig><termGrp><term id="2393982">Zoom Border</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2398123">زوم بارڈر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42304_2393983_2398125"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Zoom ribbon group where users can change the image, reset layout, enable/disable transition in their Summary Zoom, Slide Zoom, or Section Zoom, and return to Zoom.</descrip></descripGrp><ntig><termGrp><term id="2393983">Zoom Options</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2398125">زوم کے اختیارات</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42326_2394553_2396805"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">After a build update, to load an app with domain data (such as data from a database, from the network, or from a file system), during the download process. Before this step, the app cannot be used.</descrip></descripGrp><ntig><termGrp><term id="2394553">hydrate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2396805">آبیدہ کرنا</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4233_30878_1217416"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To verify, test or control by comparison or examination.</descrip></descripGrp><ntig><termGrp><term id="30878">check</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217416">پڑتال کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42351_2396187_2396810"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Hello feature gives business customers the fastest and most secure way to sign-in to Windows devices, apps and services. It uses your face, fingerprint or companion device to recognize you instantly, no password needed.</descrip></descripGrp><ntig><termGrp><term id="2396187">Windows Hello for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2396810">Windows Hello برائے کاروبار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42352_2396192_2396801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The gaming category where you can get clothing, weapons, tools or other useful items you can add to your game avatar.</descrip></descripGrp><ntig><termGrp><term id="2396192">Avatar items</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2396801">اوتار اشیاء</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42353_2396193_2396803"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The game category with games that allow you to use your phone to interact with Xbox. You can browse and type on Xbox live using your phone instead of the controller.</descrip></descripGrp><ntig><termGrp><term id="2396193">Companion</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2396803">ساتھی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42354_2396194_2396809"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app category that offers utility apps which allow you to change settings and test network connections.</descrip></descripGrp><ntig><termGrp><term id="2396194">Tools</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2396809">ٹولز</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42355_2396195_2396806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The game category that offers massively multiplayer online role-playing games. The users can choose a certain character and fight against other users on a map.</descrip></descripGrp><ntig><termGrp><term id="2396195">Multi-player online battle arena</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2396806">ملٹی پلیئر آن لائن میدان جنگ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4236_16880_1985465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process an operating system uses to detect and record security-related events, such as an attempt to create, to access, or to delete objects such as files and directories. The records of such events are stored in a file known as a security log, whose contents are available only to those with the proper clearance.</descrip></descripGrp><ntig><termGrp><term id="16880">auditing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1985465">آڈیٹنگ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42378_2396738_2405952"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office service that allows users to publish documents to Docs.com with one click from Word, Excel, PowerPoint, and Sway while retaining the original formatting and animation of the document.</descrip></descripGrp><ntig><termGrp><term id="2396738">Publish to Docs.com</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2405952">Docs.com پر شائع کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42385_2397315_3037462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure workflow automation service designed to automate repetitive and time-consuming tasks by setting up a connection to access web services, files, or cloud-based data and put them to work.</descrip></descripGrp><ntig><termGrp><term id="2397315">Microsoft Flow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3037462">Power Automate</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNu