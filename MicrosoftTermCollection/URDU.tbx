icalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40083_2329248_2333784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of Windows Store for Business where admins can sign policies and catalogs of approved software, including LOB apps, using enterprise-specific signing certificates.​</descrip></descripGrp><ntig><termGrp><term id="2329248">Device Guard signing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2333784">Device Guard کے دستخط</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40084_2329249_2333786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category of fonts that make it easier for people with dyslexia to read.​</descrip></descripGrp><ntig><termGrp><term id="2329249">Fluent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2333786">Fluent</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40085_2329250_2339939"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One to whom something is delegated.</descrip></descripGrp><ntig><termGrp><term id="2329250">assignee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2339939">مفوض الیہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40086_2329251_2339954"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to items marked with a star.</descrip></descripGrp><ntig><termGrp><term id="2329251">starred</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2339954">ستارہ زدہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40087_2329252_2339953"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An indication for a priority in a list or other organizational structure.</descrip></descripGrp><ntig><termGrp><term id="2329252">star</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2339953">ستارہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40090_2329299_2338134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A game or an app name to play on a class notebook</descrip></descripGrp><ntig><termGrp><term id="2329299">Mystery Skype</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><te