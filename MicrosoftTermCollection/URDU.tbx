="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401575">علامت سکّہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13405_94512_401972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One or more fields that uniquely identify each record in a table.</descrip></descripGrp><ntig><termGrp><term id="94512">primary key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401972">بنیادی کلید</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13407_121010_1934168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The way text is displayed in a document, how it behaves and breaks according to settings.</descrip></descripGrp><ntig><termGrp><term id="121010">text flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934168">متن بہاؤ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13408_299899_402850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Words or phrases that convey hatred or contempt or is intended to intimidate or cause harm to a group of people based on race, religion