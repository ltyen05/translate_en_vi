p><descrip type="definition">Placement of an element in the natural HTML flow of a document, but such that its position is offset from the preceding content.</descrip></descripGrp><ntig><termGrp><term id="147658">inline positioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934257">متعلقہ حالت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42822_2428420_2769001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual personification created by a player to represent them in social spaces in an app.</descrip></descripGrp><ntig><termGrp><term id="2428420">avatar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2769001">اوتار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42828_2428470_2432107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Learning Tools feature that allows users to change letter, word, line, and column spacing to reduce visual crowding.</descrip></descripGrp><ntig><termGrp><term id="2428470">Text Spacing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2432107">متنی فاصلہ بندی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><te