next to kanji characters. The kana characters indicate the correct pronunciation of the word written in kanji.</descrip></descripGrp><ntig><termGrp><term id="214868">furigana</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402493">فیوری گانا</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11999_233421_402552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory that you can use to store names, email addresses, fax numbers, and distribution lists.</descrip></descripGrp><ntig><termGrp><term id="233421">Address Book</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402552">پتہ جات</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11999_233421_403190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory that you can use to store names, email addresses, fax numbers, and distribution lists.</descrip></descripGrp><ntig><termGrp><term id="233421">Address Book</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="403190">Windows روابط</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammat