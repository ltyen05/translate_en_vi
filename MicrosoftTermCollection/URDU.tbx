Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401845">ڈاک ترسیل لیبل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9110_316263_402958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A label that is printed with a recipient's address and is used to mail or ship an item.</descrip></descripGrp><ntig><termGrp><term id="316263">shipping label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402958">شپنگ لیبل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9110_77456_401845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A label that is printed with a recipient's address and is used to mail or ship an item.</descrip></descripGrp><ntig><termGrp><term id="77456">mailing label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401845">ڈاک ترسیل لیبل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9110_77456_402958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A label that is printed with a recipient's address and is used to mail or ship an item.</descrip></descripGrp><ntig><termGrp><term id="77456">mailing label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402958">شپنگ لیبل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9120_234575_402568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The basic element that holds information in Outlook (similar to a file in other programs). Items include email messages, appointments, contacts, tasks, journal entries, notes, posted items, and documents.</descrip></descripGrp><ntig><termGrp><term id="234575">item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402568">شے</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9120_234575_403257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The basic element that holds information in Outlook (similar to a file in other programs). Items include email messages, appointments, contacts, tasks, journal entries, notes, posted items, and documents.</descrip></descripGrp><ntig><termGrp><term id="234575">item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="403257">۔Outlook شے</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><term