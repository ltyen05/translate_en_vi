 are displayed.</descrip></descripGrp><ntig><termGrp><term id="185833">View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3013383">منظر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9204_494727_2769291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI container that docks to a pane, can be part of a panel group, and is represented by a tab.</descrip></descripGrp><ntig><termGrp><term id="494727">panel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2769291">پینل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9206_85254_1934147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A space that is used to prevent multiple words from breaking if they fall at the end of a line.</descrip></descripGrp><ntig><termGrp><term id="85254">nonbreaking space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934147">مسلسل وقفہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9219_88069_1217476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain controller that has been assigned one or more special roles in an Active Directory domain.</descrip></descripGrp><ntig><termGrp><term id="88069">operations master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217476">ماہر عوامل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="922_1177130_401542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process for removing redundant data from a digital media file or stream to reduce its size or the bandwidth used.</descrip></descripGrp><ntig><termGrp><term id="1177130">data compaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401542">سکڑاؤ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="922_37103_401542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process for removing redundant data from a digital media file or stream to reduce its size or the bandwidth used.</descrip></descripGrp><ntig><termGrp><term id="37103">compression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401542">سکڑاؤ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9221_141157_1934210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fundamental data type that holds double-precision floating-point numbers. It's stored as a 64-bit number ranging in value from approximately -1.797E308 to -4.940E-324 (negative), from 4.94E-324 to 1.797E308 (positive), and 0.</descrip></descripGrp><ntig><termGrp><term id="141157">Double data type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934210">دہری کوائف قسم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9238_116710_402067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A precompiled collection of SQL statements and optional control-of-flow statements stored under a name and processed as a unit. They are stored in an SQL database and can be run with one call from an application.</descrip></descripGrp><ntig><termGrp><term id="116710">stored procedure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402067">ذخیرہ طریق</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9239_145825_1217477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A worksheet view that displays the areas to be printed and the locations of page breaks. The area to be printed is displayed in white, automatic page breaks appear as dashed lines, and manual page breaks appear as solid lines.</descrip></descripGrp><ntig><termGrp><term id="145825">page break preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217477">صفحہ توڑ منظر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9241_558509_1217478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of software functionality designed to solve a specific problem or to provide a new functionality to the user.</descrip></descripGrp><ntig><termGrp><term id="558509">feature</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217478">فیچر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9242_143427_402256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that stores hyperlink addresses.</descrip></descripGrp><ntig><termGrp><term id="143427">hyperlink field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402256">بالا ربط قطعہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9248_268851_402763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Files that are used to help detect harmful or unwanted software and to prevent it from installing or running on your computer.</descrip></descripGrp><ntig><termGrp><term id="268851">definitions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402763">تعریفیں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9255_298014_1216927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button on the message toolbar that compares the names in the To, Cc, and Bcc boxes against the names in the Address Book and against those contact folders that you've specified as Outlook Address Books.</descrip></descripGrp><ntig><termGrp><term id="298014">Check Names</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1216927">نام پڑتال کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9259_397168_409967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filtering list that is used by the Connection Filter agent in Exchange Server 2007. IP addresses on the IP Block list are considered spam. Messages originating from an IP address that is on the IP Block list are stopped from entering the Exchange organization.</descrip></descripGrp><ntig><termGrp><term id="397168">IP Block list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="409967">IP ممنوعہ فہرست</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9260_321121_403076"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user interface element that provides users with a quick and easy way to navigate across a large group of opened Web pages by providing the user with a visual representation of all of the opened thumbnails. Through this visualization, the user can easily spot and select a desired thumbnail.</descrip></descripGrp><ntig><termGrp><term id="321121">Quick Tabs</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="403076">سریع جدول</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9273_144584_402264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A "document that contains a set of separate files or subdocuments.</descrip></descripGrp><ntig><termGrp><term id="144584">master document</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402264">ماسٹر دستاویز</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9275_237771_402645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of column that displays the results of mathematical or logical operations or expressions instead of stored data.</descrip></descripGrp><ntig><termGrp><term id="237771">calculated column</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402645">متعین کالم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9278_318317_402999"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio CD that contains both audio and other multimedia content.</descrip></descripGrp><ntig><termGrp><term id="318317">enhanced audio CD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402999">توسیعی آڈیو CD</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="928_177550_1962544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Server 2003 technology that supports creation of single point-in-time shadow copies - also known as snapshots - of single or multiple volumes without impacting file server performance. Volume Shadow Copy Service also supports backups of open files.</descrip></descripGrp><ntig><termGrp><term id="177550">Volume Shadow Copy Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962544">VSS</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="928_177550_361345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Server 2003 technology that supports creation of single point-in-time shadow copies - also known as snapshots - of single or multiple volumes without impacting file server performance. Volume Shadow Copy Service also supports backups of open files.</descrip></descripGrp><ntig><termGrp><term id="177550">Volume Shadow Copy Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="361345">حجم کی تمثیلی نقل کی سروس</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="928_177551_1962544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Server 2003 technology that supports creation of single point-in-time shadow copies - also known as snapshots - of single or multiple volumes without impacting file server performance. Volume Shadow Copy Service also supports backups of open files.</descrip></descripGrp><ntig><termGrp><term id="177551">VSS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962544">VSS</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="928_177551_361345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Server 2003 technology that supports creation of single point-in-time shadow copies - also known as snapshots - of single or multiple volumes without impacting file server performance. Volume Shadow Copy Service also supports backups of open files.</descrip></descripGrp><ntig><termGrp><term id="177551">VSS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="361345">حجم کی تمثیلی نقل کی سروس</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9284_21852_401426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The speed at which binary digits are transmitted.</descrip></descripGrp><ntig><termGrp><term id="21852">bit rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401426">بٹ شرح</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9284_21853_401426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The speed at which binary digits are transmitted.</descrip></descripGrp><ntig><termGrp><term id="21853">bitrate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401426">بٹ شرح</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9295_93713_1638763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change a program in order to be able to run it on a different platform.</descrip></descripGrp><ntig><termGrp><term id="93713">port</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1638763">ںقل پذیر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9299_237015_402626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to set up your computer so that when you insert a device or media, it will play automatically and you won't have to select your preferences every time.</descrip></descripGrp><ntig><termGrp><term id="237015">AutoPlay</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402626">خود چلائیں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="93_148267_2724940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page where users can search for other pages on the Internet or intranet and then go to the searched for page.</descrip></descripGrp><ntig><termGrp><term id="148267">search page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2724940">تلاش صفحہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9304_85837_1217479"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list in which each item or block of text is preceded by a number.</descrip></descripGrp><ntig><termGrp><term id="85837">numbered list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217479">نمبری فہرست</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9305_232851_402543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document area that contains a range of text distinct from other areas of text in a document. For example, if a document includes body text, footnotes, and headers, it contains a main text story, footnotes story, and headers story.</descrip></descripGrp><ntig><termGrp><term id="232851">story</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402543">سٹوری</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9308_397142_409933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication method that prompts the user for a user name and a password, also called credentials, which are hashed with other data before being transmitted over the network. Digest authentication is available only on domains that have domain controllers that are running Microsoft Windows Server operating systems.</descrip></descripGrp><ntig><termGrp><term id="397142">Digest authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="409933">صارف کی تصدیق</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="931_91234_1962636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A private telephone network in an organization. Individual telephone numbers or extension numbers are supported, and calls are automatically routed to them. Users can call each other using extensions. They can also place calls to outside numbers.</descrip></descripGrp><ntig><termGrp><term id="91234">PBX</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962636">PBX</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="931_91235_1962636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A private telephone network in an organization. Individual telephone numbers or extension numbers are supported, and calls are automatically routed to them. Users can call each other using extensions. They can also place calls to outside numbers.</descrip></descripGrp><ntig><termGrp><term id="91235">Private Branch Exchange</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962636">PBX</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9314_294464_402811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Personal configurations of a program or operating system.</descrip></descripGrp><ntig><termGrp><term id="294464">personal settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402811">ذاتی سیٹنگیں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9320_318777_401666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The – character, based on the width of an uppercase N and used primarily as a connecting element, especially with numbers.</descrip></descripGrp><ntig><termGrp><term id="318777">EN DASH</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401666">این ربط</t