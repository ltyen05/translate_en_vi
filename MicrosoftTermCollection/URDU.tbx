ers to link an item in a SharePoint task list to other items in the site that are related to it.</descrip></descripGrp><ntig><termGrp><term id="1636502">Related Items</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934794">متعلقہ اشیاء</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32130_1636617_1662370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transfer of a copy of a file from a remote device to a requesting device by means of a modem or network.</descrip></descripGrp><ntig><termGrp><term id="1636617">download</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1662370">ڈاؤن لوڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32130_1636617_2078680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transfer of a copy of a file from a remote device to a requesting device by means of a modem or network.</descrip></descripGrp><ntig><termGrp><term id="1636617">download</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2078680">ڈاؤن لوڈ کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNot