Speech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2452347">خاندان اختیارات</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43296_2451804_2452348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Windows Defender app that contains​ Windows Firewall and other network settings.​​</descrip></descripGrp><ntig><termGrp><term id="2451804">Firewall &amp; network protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2452348">فائر وال &amp; نیٹ ورک تحفظ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43297_2451805_2452349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Windows Defender app that contains all functionalities related to antivirus and threat protection.​​</descrip></descripGrp><ntig><termGrp><term id="2451805">Virus &amp; threat protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2452349">وائرس &amp; خطرات سے تحفظ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><