y id="7702_95381_401980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions that a computer or device uses to perform a specific task, such as word processing, accounting, or data management.</descrip></descripGrp><ntig><termGrp><term id="95381">application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401980">پروگرام</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7702_95381_401981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions that a computer or device uses to perform a specific task, such as word processing, accounting, or data management.</descrip></descripGrp><ntig><termGrp><term id="95381">application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401981">ایپلی کیشن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7703_145418_1934243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The file on your hard disk that contains offline folders. The offline folder file has an .ost extension. You can create it automatically when you set up Outlook, or when you first make a folder available offline.</descrip></descripGrp><ntig><termGrp><term id="145418">offline folder file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934243">آف لائن گوشہ مسل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7712_130661_1216922"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of storage on a hard disk. A volume is formatted by using a file system, such as NTFS, and has a drive letter assigned to it. A single hard disk can have multiple volumes. Some volumes can span multiple hard disks.</descrip></descripGrp><ntig><termGrp><term id="130661">volume</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1216922">والیوم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7719_175788_1217464"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle (often, a tall, thin rectangle) that appears on a rebar or command band. By touching and dragging a gripper bar with a stylus or mouse, a user can reposition or resize a rebar or command band.</descrip></descripGrp><ntig><termGrp><term id="175788">gripper bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217464">گرپر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7719_770797_1217464"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle (often, a tall, thin rectangle) that appears on a rebar or command band. By touching and dragging a gripper bar with a stylus or mouse, a user can reposition or resize a rebar or command band.</descrip></descripGrp><ntig><termGrp><term id="770797">gripper</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217464">گرپر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7735_1136138_402974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of UI controls that appear in context when an object is selected and contain actions that act upon the object.</descrip></descripGrp><ntig><termGrp><term id="1136138">mini-toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402974">منی ٹول بار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7735_317879_402974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of UI controls that appear in context when an object is selected and contain actions that act upon the object.</descrip></descripGrp><ntig><termGrp><term id="317879">Mini toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402974">منی ٹول بار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7738_50933_2174766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tag that closes an element: &lt;/&gt;. An end tag follows the syntax &lt;/Name&gt;, where Name matches the element name declared in the start tag.</descrip></descripGrp><ntig><termGrp><term id="50933">end tag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2174766">اختتامی ٹیگ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="774_397170_409940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compliance-focused agent that is configured to journal email messages that are sent or received by departments or individuals in an Exchange Server 2007 organization, to and from recipients outside the organization, or both for use in the organization's email retention or archival strategy.</descrip></descripGrp><ntig><termGrp><term id="397170">journaling agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="409940">فہرست کار ایجنٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7749_294442_1216923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of related fields (columns) of information treated as a unit and arranged in a horizontal line in a table or spreadsheet.</descrip></descripGrp><ntig><termGrp><term id="294442">row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1216923">ریکارڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7749_294442_402804"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of related fields (columns) of information treated as a unit and arranged in a horizontal line in a table or spreadsheet.</descrip></descripGrp><ntig><termGrp><term id="294442">row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402804">صف</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7749_99659_1216923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of related fields (columns) of information treated as a unit and arranged in a horizontal line in a table or spreadsheet.</descrip></descripGrp><ntig><termGrp><term id="99659">record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1216923">ریکارڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNot