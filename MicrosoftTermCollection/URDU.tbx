rip type="definition">A computational proof that Outlook applies to outgoing messages to help recipient messaging systems distinguish legitimate email from junk email.</descrip></descripGrp><ntig><termGrp><term id="375738">Outlook E-Mail Postmark</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2655667">Outlook ای میل پوسٹ مارک</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10963_306412_402871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item in Internet Explorer that turns on the tool for Tablet PC users that allows the user to move the content of the page up and down, like a mouse scroll wheel.</descrip></descripGrp><ntig><termGrp><term id="306412">Panning Hand</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402871">جھروکا دست</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10964_169207_402377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reverse changes.</descrip></descripGrp><ntig><termGrp><term id="169207">roll back</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402377">واپس پلٹائیں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</te