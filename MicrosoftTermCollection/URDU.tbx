rip type="definition">An Office feature that allows users to create professional looking information graphics quickly and easily.</descrip></descripGrp><ntig><termGrp><term id="460782">SmartArt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934385">SmartArt</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12133_545625_1934385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office feature that allows users to create professional looking information graphics quickly and easily.</descrip></descripGrp><ntig><termGrp><term id="545625">SmartArt graphics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934385">SmartArt</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12141_56316_1934137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Two arrows in shape of a cross, with two heads each pointing in opposite directions.</descrip></descripGrp><ntig><termGrp><term id="56316">four-headed arrow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934137">چہار کونہ تیر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termN