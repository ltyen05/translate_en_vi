/ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402917">DC</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1850_232861_1934350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Office Word document that contains hyperlinks to another location. You can use hyperlinks to go to another location in the same document or to another file on your hard disk, your network, an intranet, or the Internet.</descrip></descripGrp><ntig><termGrp><term id="232861">Word publication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934350">Word کی اشاعت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18517_2199065_1934441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A picture that is stored within a document rather than being linked to a source file outside of the document.</descrip></descripGrp><ntig><termGrp><term id="2199065">embedded image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934441">شامل تصویر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18517_650871_1934441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A picture that is stored within a document rather than being linked to a source file outside of the document.</descrip></descripGrp><ntig><termGrp><term id="650871">embedded picture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934441">شامل تصویر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18523_650877_1217576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An address similar to a URL that provides network access to an event, such as a live broadcast. Attendees go to this address to view the event from their computers.</descrip></descripGrp><ntig><termGrp><term id="650877">event address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217576">وقوعہ پتہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18525_650879_1799842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text string that unambiguously refers to a hardware or software component under a certain context and can be used to access the data in that component.</descrip></descripGrp><ntig><termGrp><term id="650879">identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1799842">شناخت کنندہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18529_650883_1217577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that is stored outside of the application that is currently in use.</descrip></descripGrp><ntig><termGrp><term id="650883">external data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217577">بیرونی کوائف</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18530_650884_1217578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range of data that is brought into a worksheet but that originates outside of Excel, such as in a database or text file.</descrip></descripGrp><ntig><termGrp><term id="650884">external data range</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217578">بیرونی کوائف حد</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18535_650889_1934442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pane located on top of the Navigation Pane that has copies of your Inbox, Sent Items, and so on. You can add, remove, and arrange folders in this pane. Collapse or expand the pane by clicking the arrow in the Favorite Folders header.</descrip></descripGrp><ntig><termGrp><term id="650889">Favorite Folders</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934442">پسندیدہ گوشے</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18536_650890_1217579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that identifies a field in a PivotTable or PivotChart report. You can drag the field buttons to change the layout of the report, or click the arrows next to the buttons to change the level of detail displayed in the report.</descrip></descripGrp><ntig><termGrp><term id="650890">field button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217579">قطعہ بٹن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18538_650892_1217580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of PivotTable or PivotChart view that contains filter fields.</descrip></descripGrp><ntig><termGrp><term id="650892">filter area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217580">فلٹر علاقہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18539_650893_1217581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field in the filter area that you can use to filter data displayed in PivotTable or PivotChart view. Filter fields perform the same functions as page fields in Microsoft Excel PivotTable reports.</descrip></descripGrp><ntig><termGrp><term id="650893">filter field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217581">فلٹر قطعہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18542_650896_1433966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date that a project or task is scheduled to be completed. This date is based on the task's start date, duration, calendars, predecessor dates, task dependencies, and constraints.</descrip></descripGrp><ntig><termGrp><term id="650896">finish date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1433966">تاریخ تکمیل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18549_650903_1217582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Internet Web page or intranet page that is associated with an Outlook folder. If a page has been associated with the folder and the option is set, the Web page appears in the Outlook window whenever you select the folder.</descrip></descripGrp><ntig><termGrp><term id="650903">folder home page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217582">فولڈر ابتدائی صفحہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1855_307383_1216879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of validating software with the manufacturer. Activation confirms the genuine status of a product and that the product key has not been compromised. It establishes a relationship between the software’s product key and a particular installation of that software on a device.</descrip></descripGrp><ntig><termGrp><term id="307383">activation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1216879">فعالیت</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18551_650905_1217583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location on a computer's hard drive to store a local copy of a form to improve performance when opening a form subsequent times.</descrip></descripGrp><ntig><termGrp><term id="650905">forms cache</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217583">فارم کیسہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18558_650912_1217584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method to find a specific value for a cell by adjusting the value of one other cell. When goal seeking, Excel varies the value in a cell that you specify until a formula that's dependent on that cell returns the result you want.</descrip></descripGrp><ntig><termGrp><term id="650912">goal seek</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217584">ہدف تلاش</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18559_650913_1799841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rank or category assigned to a material resource that denotes functional use but not level of quality. A low-grade resource is not necessarily a low-quality resource.</descrip></descripGrp><ntig><termGrp><term id="650913">grade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1799841">گریڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1856_52994_1934134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Expressed as n! (n factorial), the result of multiplying the successive integers from 1 through n; n! equals n x (n - 1) x (n - 2) x ... x 1.</descrip></descripGrp><ntig><termGrp><term id="52994">factorial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934134">عامل دار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18560_650914_1217585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The faint vertical and horizontal lines that appear in the drawing window when the grid is turned on. You can use grid lines to help position shapes precisely.</descrip></descripGrp><ntig><termGrp><term id="650914">grid lines</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217585">گرڈ لائنیں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18561_650915_1217586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The point that defines the layout of grid lines on the drawing page. A vertical grid line and a horizontal grid line pass through the grid origin, and all other grid lines are drawn at specified intervals from these reference lines.</descrip></descripGrp><ntig><termGrp><term id="650915">grid origin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217586">گرڈ اصل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128261_402131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128261">vertical bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402131">عمودی بار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128261_402132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128261">vertical bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402132">پائپ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128262_402131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128262">VERTICAL LINE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402131">عمودی بار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="