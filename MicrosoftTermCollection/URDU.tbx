ermGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934490">وضع پینٹر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20723_1047661_1217627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of items, such as files and folders, assembled from various locations. The locations might be on your computer, an external hard drive, removable media, or someone else’s computer.</descrip></descripGrp><ntig><termGrp><term id="1047661">Windows library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217627">لائبریری</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20723_746479_1217627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of items, such as files and folders, assembled from various locations. The locations might be on your computer, an external hard drive, removable media, or someone else’s computer.</descrip></descripGrp><ntig><termGrp><term id="746479">library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217627">لائبریری</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20724_746483_1217628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark an item so that it always appears in a specific place in the UI or in a list.</descrip></descripGrp><ntig><termGrp><term id="746483">pin</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217628">پن کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20725_746484_1217629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove an item, such as a tile, library, movie, game, or app, from a given area of the UI, to make it inaccessible in that area.</descrip></descripGrp><ntig><termGrp><term id="746484">unpin</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1217629">ان پن کریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20733_1509298_1521412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user with role-based permission who can change settings for apps, services, users, subscriptions, and/or devices.</descrip></descripGrp><ntig><termGrp><term id="1509298">admin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1521412">منتظم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">No