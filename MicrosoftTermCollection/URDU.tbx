pGrp><ntig><termGrp><term id="319158">length</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="403054">لمبا‎ئی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="512_14369_1799812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of chart that displays the trend of values over time or categories. By displaying the sum of the plotted values, an area chart also shows the relationship of parts to a whole.</descrip></descripGrp><ntig><termGrp><term id="14369">area chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1799812">علاقہ چارٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5121_73528_1934144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of symbolic resolution where a symbol is resolved to a specific software routine during program execution instead of during program compilation, enabling polymorphism in object-oriented programs.</descrip></descripGrp><ntig><termGrp><term id="73528">late binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934144">متاخر جلد بندی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5121_73529_1934144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of symbolic resolution where a symbol is resolved to a specific software routine during program execution instead of during program compilation, enabling polymorphism in object-oriented programs.</descrip></descripGrp><ntig><termGrp><term id="73529">dynamic binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1934144">متاخر جلد بندی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5123_26059_401451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To store frequently used data values in a special memory subsystem for quick access.</descrip></descripGrp><ntig><termGrp><term id="26059">cache</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401451">کیسہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51236_2889600_2890536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that limits battery charging capacity to 50%, which slows the aging process and prolongs battery longevity.</descrip></descripGrp><ntig><termGrp><term id="2889600">Battery Limit Mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2890536">بیٹری حد موڈ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51237_2889601_2890537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that helps protect a battery from the cumulative negative effects of consistent and recurrent use at high temperatures or high states of charge by monitoring battery conditions continuously and implementing a limited number of permanent reductions in charging voltage if these adverse conditions are detected.</descrip></descripGrp><ntig><termGrp><term id="2889601">Battery Lifespan Saver</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2890537">بیٹری لائف سپان سیور</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5127_340084_1216909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add new text, objects or cells without overwriting existing data.</descrip></descripGrp><ntig><termGrp><term id="340084">insert</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1216909">شامل</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5128_319431_403063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to characters that are evenly slanted to the right or in the direction of text flow.</descrip></descripGrp><ntig><termGrp><term id="319431">italic</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="403063">اٹالک</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5129_415567_1962644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action or occurrence to which a program might respond. Examples include state changes, data transfers, key presses, and mouse movements.</descrip></descripGrp><ntig><termGrp><term id="415567">program event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962644">پروگرام وقوعہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5129_415567_401675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action or occurrence to which a program might respond. Examples include state changes, data transfers, key presses, and mouse movements.</descrip></descripGrp><ntig><termGrp><term id="415567">program event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401675">وقوعہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5129_51961_1962644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action or occurrence to which a program might respond. Examples include state changes, data transfers, key presses, and mouse movements.</descrip></descripGrp><ntig><termGrp><term id="51961">event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="1962644">پروگرام وقوعہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5129_51961_401675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action or occurrence to which a program might respond. Examples include state changes, data transfers, key presses, and mouse movements.</descrip></descripGrp><ntig><termGrp><term id="51961">event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="401675">وقوعہ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51301_2891089_2891362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Slovenian national holiday celebrated on June 25 to commemorate Slovenia's declaration of independence from Yugoslavia in 1991.</descrip></descripGrp><ntig><termGrp><term id="2891089">Statehood Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2891362">یوم تشکیل ریاست</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51302_2891211_2891364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The national holiday in Bosnia and Herzegovina celebrated on November 25 to commemorate the day in 1943 on which ZAVNOBiH, the Anti-Fascist Council of Bosnia and Herzegovina, adopted a resolution to declare the country/region an equal community of Muslims, Serbs, and Croats.</descrip></descripGrp><ntig><termGrp><term id="2891211">Statehood Day (Bosnia and Herzegovina)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2891364">یوم تشکیل ریاست (بوسنیا اور ہرزیگوینا)</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51303_2891233_2891314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Czech national holiday celebrated on September 28 to commemorate the day in 935 on which St. Wenceslas, patron of the Czech state, was murdered by his brother.</descrip></descripGrp><ntig><termGrp><term id="2891233">Czech Statehood Day (St. Wenceslas Day)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2891314">یوم تشکیل ریاست چیک (یوم سینٹ وینس لاس)‏</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51304_2891239_2891317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Argentinian national holiday celebrated on June 20 to commemorate the Argentine flag and its creator, Manuel Belgrano.</descrip></descripGrp><ntig><termGrp><term id="2891239">Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2891317">یوم پرچم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51305_2891254_2891352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The supplementary holiday day that may be granted during years in which Argentina's Flag Day occurs on a Tuesday or a Thursday and is used to create a four-day weekend.</descrip></descripGrp><ntig><termGrp><term id="2891254">Flag Day (bridge)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2891352">یوم پرچم (برج)</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51306_2891255_2891319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Mexican national holiday celebrated on February 24 to commemorate past and current flags of Mexico.</descrip></descripGrp><ntig><termGrp><term id="2891255">Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2891319">یوم پرچم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51307_2891256_2891320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The national holiday in Poland celebrated on May 2 to commemorate the raising of the Polish flag over the Victory Column at the end of the Battle of Berlin in 1945.</descrip></descripGrp><ntig><termGrp><term id="2891256">Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2891320">یوم پرچم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51308_2891257_2891358"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azerbaijan national holiday celebrated on November 9 to commemorate the adoption of the Flag of Azerbaijan on November 9, 1918.</descrip></descripGrp><ntig><termGrp><term id="2891257">National Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2891358">قومی یوم پرچم</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51309_2891258_2891365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The day on which the Azerbaijan National Flag Day is celebrated if the official holiday itself falls on a weekend.</descrip></descripGrp><ntig><termGrp><term id="2891258">National Flag Day (Observed)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2891365">یوم تشکیل ریاست (منایا جاتا ہے)</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5131_159863_402355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of detecting and splitting video content into separate clips. Clips are created by Windows Movie Maker when there is a significant change from one frame to another.</descrip></descripGrp><ntig><termGrp><term id="159863">clip creation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="402355">تراشہ تخلیق</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51323_2892217_2893214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prevent a UI element such as an error, notification, button, or a visual feature such as line numbers or page margins, from appearing to the end user.</descrip></descripGrp><ntig><termGrp><term id="2892217">suppress</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2893214">وقفہ دینا</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51330_2893119_2893215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Implies that the artifact (object or activity) or some of its characteristics deviate from what is considered ‘normal’; typically a statistical outlier.</descrip></descripGrp><ntig><termGrp><term id="2893119">anomalous</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2893215">متضاد</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51331_2893120_2893217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number calculated to let the customer know how vulnerable devices in their organization are.</descrip></descripGrp><ntig><termGrp><term id="2893120">exposure score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2893217">ایکسپوژر اسکور</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51338_2893964_2893983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft 365 Teams background effect that is limited only to uploading the user's own images.</descrip></descripGrp><ntig><termGrp><term id="2893964">custom background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2893983">مخصوص پس منظر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51339_2893965_2893984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox Live matchmaking service that groups players based on user information and the request for any users who want to play together.</descrip></descripGrp><ntig><termGrp><term id="2893965">SmartMatch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2893984">SmartMatch</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51341_2894028_2894111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">​The next iteration of the Authenticator app in which users can save and automatically fill passwords, addresses, and payment info on mobile devices and computers (via browser extension).</descrip></descripGrp><ntig><termGrp><term id="2894028">Microsoft Autofill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2894111">Microsoft خودکار بھریں</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51343_2894031_2894110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of the Windows Clock app that allows the user to set a timer for a period of focus time.</descrip></descripGrp><ntig><termGrp><term id="2894031">Focus sessions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2894110">فوکس سیشنز</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51347_2894037_2894112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The possibility for a person to input text in Windows with their voice (aka dictation).</descrip></descripGrp><ntig><termGrp><term id="2894037">voice typing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2894112">وائس ٹائپنگ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51349_2894217_2894494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The international holiday celebrated on March 8 that honors women and is commemorated in various ways around the world, including as a public holiday, a day of protest, or as a celebration of womanhood.</descrip></descripGrp><ntig><termGrp><term id="2894217">International Women's Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2894494">عالمی یوم خواتین</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51350_2894218_2894495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Vietnamese public holiday celebrated on April 30 to commemorate the day in 1975 when North Vietnamese and Việt Cộng forces captured Saigon (now Ho Chi Minh City), signaling the end of the Vietnam War and the beginning of the reunification process.</descrip></descripGrp><ntig><termGrp><term id="2894218">Reunification Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2894495">یوم ری یونیفکیشن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51351_2894219_2894496"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The day on which the Vietnamese holiday Reunification Day is celebrated if the official holiday itself falls on a weekend.</descrip></descripGrp><ntig><termGrp><term id="2894219">Reunification Day (Observed)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2894496">یوم ری یونیفکیشن (منایا جاتا ہے)</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51352_2894246_2895204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account from a social identity provider, such as Facebook or Google.</descrip></descripGrp><ntig><termGrp><term id="2894246">social account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2895204">سوشل اکاؤنٹ</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51364_2894612_3024720"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transport layer network protocol based on User Datagram Protocol (UDP), which can improve the performance of web applications that currently use TCP.</descrip></descripGrp><ntig><termGrp><term id="2894612">QUIC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="3024720">QUIC</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51369_2894964_2895167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool that allows customers to compare their EOP policies settings against Microsoft's recommended settings for EOP and Office 365 ATP security.</descrip></descripGrp><ntig><termGrp><term id="2894964">Configuration Analyzer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2895167">تشکیل تجزیہ نگار</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51379_2895318_2895880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application of high quality touchscreen controls to games designed to be played with a controller or mouse/keyboard.</descrip></descripGrp><ntig><termGrp><term id="2895318">touch adaptation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2895880">ٹچ اڈاپٹیشن</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51380_2895330_2895878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of grouping players for game matchmaking purposes together based on information provided by the title or stored in user statistics, or based on the user's preferences, or based on quality of service.</descrip></descripGrp><ntig><termGrp><term id="2895330">hopper</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2895878">ہوپر</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51405_2896240_2897238"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication process that sends an SMS message to the phone number provided by the user.</descrip></descripGrp><ntig><termGrp><term id="2896240">SMS verification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2897238">SMS توثیق</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51406_2896246_2897239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cookie that is used to connect user's activity on websites to the user's social media profile so the ads and content that the users see on websites and social media will better reflect their interests.</descrip></descripGrp><ntig><termGrp><term id="2896246">social media cookie</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ur"><ntig><termGrp><term id="2897239">سوشل میڈیا کوکی</term><termNote type="geographicalUsage">PAK</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51429_2897500_2898018"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To pin or lock an individual video feed for all attendees in a Teams meeting regardless of who is currently talking.</descrip></d