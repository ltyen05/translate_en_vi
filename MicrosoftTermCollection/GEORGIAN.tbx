"ka"><ntig><termGrp><term id="3014363">არასწორი კონფიგურაცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53003_3012998_3014367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to create a child email address or a disposable email address based on your standard email address, adding a "+"  suffix to the local part of your email address.</descrip></descripGrp><ntig><termGrp><term id="3012998">plus addressing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014367">დამატებითი მისამართი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53003_3012998_3014369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to create a child email address or a disposable email address based on your standard email address, adding a "+"  suffix to the local part of your email address.</descrip></descripGrp><ntig><termGrp><term id="3012998">plus addressing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014369">ქვემისამართი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53003_3012999_3014367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to create a child email address or a disposable email address based on your standard email address, adding a "+"  suffix to the local part of your email address.</descrip></descripGrp><ntig><termGrp><term id="3012999">subaddressing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014367">დამატებითი მისამართი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53003_3012999_3014369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to create a child email address or a disposable email address based on your standard email address, adding a "+"  suffix to the local part of your email address.</descrip></descripGrp><ntig><termGrp><term id="3012999">subaddressing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014369">ქვემისამართი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53004_3013001_3014358"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that integrates various Microsoft 365 applications with third-party software defined network (SD-WAN) solutions in order to optimize and improve your network connectivity to Microsoft service endpoints.</descrip></descripGrp><ntig><termGrp><term id="3013001">informed network routing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014358">ინფორმირებული ქსელის მარშრუტიზაცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53005_3013002_3014350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of settings in anti-spam policies in Exchange Online Protection that enable Microsoft 365 administrators to mark messages as spam based on specific message properties.</descrip></descripGrp><ntig><termGrp><term id="3013002">Advanced Spam Filter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014350">სპამის გაუმჯობესებული ფილტრი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53005_3013002_3014351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of settings in anti-spam policies in Exchange Online Protection that enable Microsoft 365 administrators to mark messages as spam based on specific message properties.</descrip></descripGrp><ntig><termGrp><term id="3013002">Advanced Spam Filter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014351">ASF</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="