protects your device by providing startup and runtime protections that the operating system can validate and report on.</descrip></descripGrp><ntig><termGrp><term id="2615085">System Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2618507">სისტემის დაცვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46479_2615093_2618510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The remote attestation service that checks the health of Windows 10-based devices to allow or deny access to networks, apps, or services, based on whether devices prove to be healthy.</descrip></descripGrp><ntig><termGrp><term id="2615093">Windows Health Attestation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2618510">მდგომარეობის შემმოწმებელი Windows-ის სერვისი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46481_2615123_2618505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Windows Defender Security Center that helps customers keep their devices refreshed and up to date with the latest version of Windows 10. Device health advisor monitors the device and provides information and recommendations in a Health report to address common issues with storage capacity, device drivers, battery life, or Windows Update.</descrip></descripGrp><ntig><termGrp><term id="2615123">Device performance &amp; health</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2618505">მოწყობილობის მუშაობა და მდგომარეობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4649_50166_1888859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A typographical unit of measure that is equal in width to the point size of a particular font. For many fonts, this is equal to the width of a capital M, from which the em space takes its name.</descrip></descripGrp><ntig><termGrp><term id="50166">em space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1888859">გრძელი შორისი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46505_2618212_2619643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tenant that consists of a central location and one or more satellite geo locations.</descrip></descripGrp><ntig><termGrp><term id="2618212">Multi-Geo tenant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2619643">რამდენიმე რეგიონიანი კლიენტი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46511_2618261_2619642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The single web portal where Microsoft 365 admins can manage user accounts and settings for each of the Microsoft 365 services they subscribe to.</descrip></descripGrp><ntig><termGrp><term id="2618261">Microsoft 365 admin center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2619642">Microsoft 365-ის ადმინისტრირების ცენტრი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46511_2690503_2619642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The single web portal where Microsoft 365 admins can manage user accounts and settings for each of the Microsoft 365 services they subscribe to.</descrip></descripGrp><ntig><termGrp><term id="2690503">Admin Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2619642">Microsoft 365-ის ადმინისტრირების ცენტრი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46512_2618262_2619644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Immersive Reader feature that shows a picture when you click on a word.</descrip></descripGrp><ntig><termGrp><term id="2618262">Picture Dictionary</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2619644">დასურათებული ლექსიკონი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46514_2618265_2619714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel mode where a user can move to the next nonblank cell in the same column or row as the active cell.</descrip></descripGrp><ntig><termGrp><term id="2618265">End mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2619714">დასრულების რეჟიმი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4652_236971_507396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software that was installed on the system without user's consent.</descrip></descripGrp><ntig><termGrp><term id="236971">unwanted software</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507396">არასასურველი პროგრამები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46533_2619438_2621511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Windows Defender Security Center that helps protect devices running Windows 10 by checking web content that Microsoft Store apps use.​</descrip></descripGrp><ntig><termGrp><term id="2619438">App protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2621511">აპისგან დაცვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46534_2619566_2621512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Windows Defender Security Center that helps protect devices running Windows 10 from malicious websites and downloads.​​</descrip></descripGrp><ntig><termGrp><term id="2619566">Web protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2621512">ინტერნეტში დაცვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46539_2619581_2916850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that lets users choose which buttons perform which actions on Xbox Wireless Controllers.</descrip></descripGrp><ntig><termGrp><term id="2619581">Xbox Accessories</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916850">Xbox-ის აქსესუარები</term>