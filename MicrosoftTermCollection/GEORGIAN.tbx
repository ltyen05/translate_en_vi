Grp><descrip type="definition">A list of group calendars that the user has joined.</descrip></descripGrp><ntig><termGrp><term id="2823695">joined groups</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2826884">ჯგუფების წევრობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49927_2824967_2829260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The order in which screen readers read the slide contents.</descrip></descripGrp><ntig><termGrp><term id="2824967">reading order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2829260">წაკითხვის თანმიმდევრობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49928_2825758_2829253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Translation option in Outlook that automatically translates messages that are received in languages other than the default language.</descrip></descripGrp><ntig><termGrp><term id="2825758">Always translate</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2829253">ყოველთვის თარგმნე</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNo