OfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506173">უკუთავსებადობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31650_1608228_1889445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle that enables touch selection scenarios that are not possible or are difficult to accomplish with standard touch gestures alone.</descrip></descripGrp><ntig><termGrp><term id="1608228">touch selection handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889445">სენსორული არჩევის მარკერი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31651_1608229_1889446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Visio-based design surface that enables users to create and edit workflows visually by manipulating shapes that represent actions and conditions.</descrip></descripGrp><ntig><termGrp><term id="1608229">Visual Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889446">ვიზუალური დიზაინერი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><t