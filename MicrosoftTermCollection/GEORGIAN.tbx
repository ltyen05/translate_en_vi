ammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1223907">თვისების ველები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7204_2066257_2079144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification for sharing items, such as calendars, documents or folders, with others.</descrip></descripGrp><ntig><termGrp><term id="2066257">invitation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2079144">მოსაწვევი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7204_2066257_2079149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification for sharing items, such as calendars, documents or folders, with others.</descrip></descripGrp><ntig><termGrp><term id="2066257">invitation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2079149">გაზიარების მოსაწვევი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7204_234808_2079144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification for sharing items, such as calendars, documents or folders, with others.</