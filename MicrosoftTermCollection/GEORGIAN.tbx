Speech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50283_2844097_2849941"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft cybersecurity team that works with customers globally to identify risks and provide reactive incident response and proactive security investigation services.</descrip></descripGrp><ntig><termGrp><term id="2844097">DART</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2849941">Microsoft-ის აღმოჩენისა და რეაგირების გუნდი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50284_2844098_2849949"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team of specialists who respond to an incident, emergency, etc.</descrip></descripGrp><ntig><termGrp><term id="2844098">response team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2849949">რეაგირების გუნდი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50285_2844099_2848303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in the Microsoft Teams admin center that allows administrators to run reports in order to get insights into how users in the organization are using Teams.</descrip></descripGrp><ntig><