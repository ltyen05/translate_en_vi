n</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1650_13978_2916532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any computer game designed to mimic the style of a coin-operated arcade game, such as games marketed for the home computer.</descrip></descripGrp><ntig><termGrp><term id="13978">arcade game</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916532">arcade თამაში</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16504_592353_1889146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that shows a three dimensional surface that connects a set of data points. As in a topographic map, colors and patterns indicate areas that are in the same range of values.</descrip></descripGrp><ntig><termGrp><term id="592353">surface chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889146">ზედაპირული დიაგრამა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16505_592354_2765832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a resource in a failover cluster or server cluster that is in the process of being brought online or offline.</descrip></descripGrp><ntig><termGrp><term id="592354">pending</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2765832">ლოდინი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16506_592355_1889147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A surface chart subtype that provides a view of the surface chart from above, with colors representing specific ranges of values.</descrip></descripGrp><ntig><termGrp><term id="592355">contour chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889147">კონტურული დიაგრამა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16507_592356_1889148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contour chart displayed without color.</descrip></descripGrp><ntig><termGrp><term id="592356">wireframe contour chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889148">უფერული კონტურული დიაგრამა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16508_2909978_1889149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that displays data in rings, where each ring represents a data series.</descrip></descripGrp><ntig><termGrp><term id="2909978">donut</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889149">წრიული დიაგრამა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16508_592357_1889149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that displays data in rings, where each ring represents a data series.</descrip></descripGrp><ntig><termGrp><term id="592357">doughnut chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889149">წრიული დიაგრამა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16511_592360_2299592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A doughnut chart that displays the contribution of each value to a total while emphasizing individual values, by showing each slice of the doughnut as "pulled out," or separate, from the whole.</descrip></descripGrp><ntig><termGrp><term id="592360">exploded doughnut chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2299592">დაყოფილი დონატისებური დიაგრამა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16513_592362_1889150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A best-fit curved trendline that is used when the rate of change in the data increases or decreases quickly and then levels out.</descrip></descripGrp><ntig><termGrp><term id="592362">logarithmic trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889150">ლოგარითმული ტრენდის ხაზი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16514_592363_1889151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A curved trendline that is used when data fluctuates.</descrip></descripGrp><ntig><termGrp><term id="592363">polynomial trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889151">პოლინომიალური ტრენდის ხაზი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16516_592365_1889152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A curved trendline that is used with data sets that compare measurements that increase at a specific rate.</descrip></descripGrp><ntig><termGrp><term id="592365">power trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889152">გაძლიერებული ტრენდის ხაზი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16518_592368_1889153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A curved trendline that is used when data values rise or fall at constantly increasing rates.</descrip></descripGrp><ntig><termGrp><term id="592368">exponential trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889153">ტრენდის ექსპონენციური ხაზი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16519_592369_1889154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trendline that smoothes out fluctuations in data to show a pattern or trend more clearly.</descrip></descripGrp><ntig><termGrp><term id="592369">moving average trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889154">მოძრაობის ტრენდის საშუალო ხაზი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16525_592375_2699225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user whose account resides in an account partner organization and who can access federated applications that reside in a resource partner organization. In the context of Office 365, a federated user is one that is sourced (mastered, authenticated, created, and managed) in an organization’s on-premises Active Directory. The on-premises Active Directory has a trust relationship with the cloud that allows authenticated Active Directory users to access cloud resources (or “services,” such a SharePoint Online, Exchange Online, etc).</descrip></descripGrp><ntig><termGrp><term id="592375">federated user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2699225">ფედერალური მომხმარებელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1654_234919_507372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wizard that allows third-party developers to achieve the same look in their dialog boxes as Aero.</descrip></descripGrp><ntig><termGrp><term id="234919">Aero Wizard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507372">Aero-ს ოსტატი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16543_592397_2699210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For BitLocker Drive Encryption, a combination of one or more of the following elements, identified by a globally unique identifier (GUID): personal identification number (PIN), recovery password, recovery key, startup key, and Trusted Platform Module (TPM).</descrip></descripGrp><ntig><termGrp><term id="592397">authentication method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2699210">ავთენტიფიკაციის მეთოდი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16577_592433_1463484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To ensure that all data sources that are used by a KPI or scorecard are available.</descrip></descripGrp><ntig><termGrp><term id="592433">validate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1463484">შემოწმება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16584_592444_2592180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory name, used in an address, that corresponds to a physical directory on the server.</descrip></descripGrp><ntig><termGrp><term id="592444">virtual directory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2592180">ვირტუალური კატალოგი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16594_592578_2182629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service or feature that renders the audio content of a television or video program as text on the screen. These captions are usually visible only if decoded or activated.</descrip></descripGrp><ntig><termGrp><term id="592578">closed captioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2182629">დახურული წარწერები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16607_592811_1224029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric or other designation appended to a product name to identify a particular release.​</descrip></descripGrp><ntig><termGrp><term id="592811">version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224029">ვერსია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16609_592813_1224031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect applied to a graphical object that typically reduces the difference between the outline of the object and the graphical area next to it.</descrip></descripGrp><ntig><termGrp><term id="592813">blur</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224031">გაბუნდოვნება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16647_594141_1990470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that provides encryption for sensitive data, such as passwords, in applications.</descrip></descripGrp><ntig><termGrp><term id="594141">encryption provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1990470">დაშიფვრის პროვაიდერი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16658_600620_1889155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The round button in the lower left-hand corner of the Windows screen that allows the user to click and display the Start menu.</descrip></descripGrp><ntig><termGrp><term id="600620">Start button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889155">დაწყების ღილაკი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16665_601385_2625737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack by a malicious user or malicious software on a computer or operating system to find a secret password or a symmetric encryption key by guessing passwords or keys until the correct password or key is discovered.</descrip></descripGrp><ntig><termGrp><term id="601385">key search attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2625737">ბრუტალური ძალით შეტევა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16665_601385_2625741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack by a malicious user or malicious software on a computer or operating system to find a secret password or a symmetric encryption key by guessing passwords or keys until the correct password or key is discovered.</descrip></descripGrp><ntig><termGrp><term id="601385">key search attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2625741">შერჩევის მეთოდით შეტევა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16665_601386_2625737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack by a malicious user or malicious software on a computer or operating system to find a secret password or a symmetric encryption key by guessing passwords or keys until the correct password or key is discovered.</descrip></descripGrp><ntig><termGrp><term id="601386">brute force attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2625737">ბრუტალური ძალით შეტევა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16665_601386_2625741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack by a malicious user or malicious software on a computer or operating system to find a secret password or a symmetric encryption key by guessing passwords or keys until the correct password or key is discovered.</descrip></descripGrp><ntig><termGrp><term id="601386">brute force attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2625741">შერჩევის მეთოდით შეტევა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1668_147156_507055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A grouping of properties presented as a tabbed page of a property sheet.</descrip></descripGrp><ntig><termGrp><term id="147156">property page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507055">თვისებათა გვერდი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16697_601660_1698035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft site that provides a comprehensive listing of updates that can be distributed over a corporate network.</descrip></descripGrp><ntig><termGrp><term id="601660">Microsoft Update Catalog</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1698035">Microsoft Update-ის კატალოგი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16701_607526_1543858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of something that is consumed over a period of time.</descrip></descripGrp><ntig><termGrp><term id="607526">usage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1543858">გამოყენება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16775_1049762_1754713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Remote Desktop Services that enables the user to access a program remotely through Remote Desktop Services but have it appear as if it is running on the user's local computer. Users can run RemoteApp programs side by side with their local programs.</descrip></descripGrp><ntig><termGrp><term id="1049762">RemoteApp</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGr