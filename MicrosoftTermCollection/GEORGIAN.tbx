ang="en-US"><descripGrp><descrip type="definition">The number of hours the person spent sending and reading email.</descrip></descripGrp><ntig><termGrp><term id="2858268">email hours</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2860659">ელფოსტაზე დახარჯული საათები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50500_2858270_2860674"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The lack of opposition between work and other life roles. It is the state of equilibrium in which demands of personal life, professional life, and family life are equal.</descrip></descripGrp><ntig><termGrp><term id="2858270">work-life balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2860674">მუშაობა-ცხოვრების ბალანსი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50501_2858273_2860669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a manager, or to a meeting involving a manager, "skip-level" refers to the employee's manager's manager, sometimes referred to as "second line manager". A skip-level manager is the manager of the employee's manager. A skip-level meeting is a meeting between an employee and the manager of his or her manager.</descrip></descripGrp><ntig><termGrp><term id="2858273">skip-level</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2860669">ზედა დონის</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50502_2858291_2860658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collective name for character images with multiple poses, emotions and props.</descrip></descripGrp><ntig><termGrp><term id="2858291">cutout people</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2860658">ადამიანის ფიგურები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50507_2860396_3051207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function in Office apps for mobile phones that allows users to make content (text, buttons, etc.) larger.</descrip></descripGrp><ntig><termGrp><term id="2860396">large content viewer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3051207">დიდი შიგთავსის მნახველი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50508_2860488_2861205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to import their financial transactions into Excel so they can view and organize their finances in one place and obtain personalized insights.</descrip></descripGrp><ntig><termGrp><term id="2860488">Money in Excel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2861205">ფული Excel-ში</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50509_2860564_2861207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft marketing campaign to promote The Art of Teamwork [50467], a framework, toolkit, and digital curriculum to equip our customers with the tools to practice the five key dynamics to successful teamwork.</descrip></descripGrp><ntig><termGrp><term id="2860564">The Art of Teamwork Campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2861207">გუნდური მუშაობის ხელოვნება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50510_2860565_2861206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Collaboration between members of a group organized around a common responsibility, interest, or objective.</descrip></descripGrp><ntig><termGrp><term id="2860565">teamwork</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2861206">გუნდური მუშაობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50512_2860581_2861209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to enter into situations that involve risk and emotional exposure.</descrip></descripGrp><ntig><termGrp><term id="2860581">vulnerability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2861209">მოწყვლადობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50513_2860582_2861208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feeling that ensues from knowing you can be vulnerable with someone without being put down or hurt.</descrip></descripGrp><ntig><termGrp><term id="2860582">trust</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2861208">ნდობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50515_2860603_2862044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Function in Office applications that allows users to select stock images.</descrip></descripGrp><ntig><termGrp><term id="2860603">content picker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2862044">შიგთავსის ამრჩევი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50516_2860604_2862046"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of PowerPoint slides, often with supporting notes, that can be shared as a stand-alone document.</descrip></descripGrp><ntig><termGrp><term id="2860604">slide deck</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2862046">კოლექცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50516_2860604_2862050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of PowerPoint slides, often with supporting notes, that can be shared as a stand-alone document.</descrip></descripGrp><ntig><termGrp><term id="2860604">slide deck</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2862050">სლაიდების კოლექცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50516_2860605_2862046"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of PowerPoint slides, often with supporting notes, that can be shared as a stand-alone document.</descrip></descripGrp><ntig><termGrp><term id="2860605">deck</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2862046">კოლექცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50516_2860605_2862050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of PowerPoint slides, often with supporting notes, that can be shared as a stand-alone document.</descrip></descripGrp><ntig><termGrp><term id="2860605">deck</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2862050">სლაიდების კოლექცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50517_2860606_2862049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pane that shows the objects that have been inserted into an Office document.</descrip></descripGrp><ntig><termGrp><term id="2860606">Selection Pane</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2862049">არჩევანის პანელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50518_2860607_2862047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to edit text by drawing on the screen with a digital pen or with a finger.</descrip></descripGrp><ntig><termGrp><term id="2860607">intelligent pen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2862047">ჭკვიანი კალამი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50519_2860771_2862045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of machine learning capabilities that enable users to create models that process structured and unstructured documents to extract information, and classify and automatically tag content.</descrip></descripGrp><ntig><termGrp><term id="2860771">content understanding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2862045">შიგთავსის აღქმა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50521_2860780_2861582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Shadow Stack security feature that prevents a class of vulnerabilities known as Return-Oriented Programming (ROP) and requires hardware in order to work.</descrip></descripGrp><ntig><termGrp><term id="2860780">hardware-enforced stack protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2861582">აპარატურით უზრუნველყოფილი ჯგუფური დაცვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50521_2860780_3020695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Shadow Stack security feature that prevents a class of vulnerabilities known as Return-Oriented Programming (ROP) and requires hardware in order to work.</descrip></descripGrp><ntig><termGrp><term id="2860780">hardware-enforced stack protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3020695">HSP</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50521_3019770_2861582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Shadow Stack security feature that prevents a class of vulnerabilities known as Return-Oriented Programming (ROP) and requires hardware in order to work.</descrip></descripGrp><ntig><termGrp><term id="3019770">HSP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2861582">აპარატურით უზრუნველყოფილი ჯგუფური დაცვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50521_3019770_3020695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Shadow Stack security feature that prevents a class of vulnerabilities known as Return-Oriented Programming (ROP) and requires hardware in order to work.</descrip></descripGrp><ntig><termGrp><term id="3019770">HSP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3020695">HSP</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50539_2862041_2862630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web-hosted technology product such as file storage, webmail, search engines, and calendar management.</descrip></descripGrp><ntig><termGrp><term id="2862041">service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2862630">სერვისი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50540_2862042_2862629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft web-hosted technology product such as Bing, MSN, OneDrive, Outlook.com, Devices, and Profile, all of which are accessed via a Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2862042">Microsoft Service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2862629">Microsoft-ის სერვისი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50541_2862043_2862631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cryptographic algorithm used to create a hash value with 64 hexadecimal characters, or the hash value itself.</descrip></descripGrp><ntig><termGrp><term id="2862043">SHA-256</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2862631">SHA-256</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50543_2862396_2863095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The personalized information stream feature of Microsoft Launcher that includes news, events from the user's calendar, photos, notes, contacts, recently-launched apps, and more.</descrip></descripGrp><ntig><termGrp><term id="2862396">feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2863095">არხი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50544_2862397_2863097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Launcher page consisting of a card that has been pinned to the Home screen providing a full-screen experience to card users with all filters and sorting preserved as of the moment the page was pinned.</descrip></descripGrp><ntig><termGrp><term id="2862397">pinned page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2863097">ჩამაგრებული გვერდი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50547_2862401_2863096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Edge that notifies users whenever a password that they have saved through the browser has been identified as compromised.</descrip></descripGrp><ntig><termGrp><term id="2862401">Password Monitor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2863096">პაროლების მონიტორინგი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50548_2862405_2863098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Edge feature that allows users to select, copy, and paste content that they find across the Web while maintaining the source site's formatting, spacing, and text so the copy looks like the original.</descrip></descripGrp><ntig><termGrp><term id="2862405">Smart copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:la