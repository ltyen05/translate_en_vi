 target relevant search queries based on the content of your website, and is dynamically created to respond to these search queries.</descrip></descripGrp><ntig><termGrp><term id="3031668">DSA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3032227">DSA</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53215_3031668_3032228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search ad that automatically target relevant search queries based on the content of your website, and is dynamically created to respond to these search queries.</descrip></descripGrp><ntig><termGrp><term id="3031668">DSA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3032228">დინამიკური საძიებო რეკლამა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53216_3031669_3032231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search ad that allows you to set multiple ad headlines and ad descriptions within a single ad.</descrip></descripGrp><ntig><termGrp><term id="3031669">responsive search ad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3032231">საპასუხო საძიებო რეკლამა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53217_3031670_3032232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search ad that contains images and videos.</descrip></descripGrp><ntig><termGrp><term id="3031670">rich search ad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3032232">საძიებო რეკლამა მდიდარი გაფორმებით</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53219_3031672_3032229"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combined search and audience advertising marketplace made up of Bing, MSN, Outlook, Edge, and partner sites.</descrip></descripGrp><ntig><termGrp><term id="3031672">Microsoft Search Network</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3032229">Microsoft-ის საძიებო ქსელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53220_3031831_3032851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy template that helps detect cross-country or cross-region data transfers, identify the amount and types of personal data being transferred, and take actions to remediate risks, such as applying additional encryption or restricting access for the data being transferred.</descrip></descripGrp><ntig><termGrp><term id="3031831">cross-border transfers</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3032851">საზღვარზე გადაცემები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53221_3031832_3032850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transfer of personal data across a geographic border (such as country or regional borders).</descrip></descripGrp><ntig><termGrp><term id="3031832">cross-border transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3032850">საზღვარზე გადაცემა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53222_3031833_3032853"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy template that helps detect personal data with external, excessive, and idle access and trigger remediation actions including sending notifications to the data or site owners to remove unnecessary accesses.</descrip></descripGrp><ntig><termGrp><term id="3031833">data overexposure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3032853">მონაცემებზე ჭარბი ზემოქმედება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53223_3031834_3032852"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy template that helps detect personal data that has not been used for more than 90 days and trigger remediation actions, including sending notifications to data owners to apply retention labels or disposing of the information immediately.</descrip></descripGrp><ntig><termGrp><term id="3031834">data minimization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3032852">მონაცემთა მინიმიზაცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53224_3031835_3032848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The metered service that enables licensed M365 commercial, consumer, and education users to use Office Online to view, edit, and coauthor documents stored on cloud storage providers other than SharePoint or OneDrive.</descrip></descripGrp><ntig><termGrp><term id="3031835">Coauthoring</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3032848">თანაავტორობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53225_3053615_3053764"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cross-industry experience 