/langSet></termEntry><termEntry id="14511_2148_506039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reduce a window to a button on the taskbar by clicking the Minimize button (leftmost button on the right side of the title bar) or by pressing ALT+SPACEBAR and then pressing N.</descrip></descripGrp><ntig><termGrp><term id="2148">minimize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506039">ჩაკეცვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14523_360144_508017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window that displays the SQL statement for the current query or that is used to create an SQL-specific query (union, pass-through, or data definition). When you create a query in Design view, Access constructs the SQL equivalent in SQL view.</descrip></descripGrp><ntig><termGrp><term id="360144">SQL view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="508017">SQL ხედი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14526_360146_508019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that asks a question about the data stored in your tables and returns a result set in the form of a datasheet, without changing the data.</descrip></descripGrp><ntig><termGrp><term id="360146">select query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="508019">ამორჩევის მოთხოვნა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14528_276550_1996692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single location in Windows where you can adjust mobile PC settings.</descrip></descripGrp><ntig><termGrp><term id="276550">Windows Mobility Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1996692">Windows მობილობის ცენტრი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14534_21247_506188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains encoded information that is interpreted according to the application that created it. In general, a binary file can be edited only by the application in which it was created.</descrip></descripGrp><ntig><termGrp><term id="21247">binary file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506188">ორობითი ფაილი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14540_373951_1936974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive technology in Microsoft Excel or Access that can show dynamic views of the same data from a list or a database.</descrip></descripGrp><ntig><termGrp><term id="373951">Microsoft PivotTable</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1936974">კრებსითი ცხრილი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14540_373952_1936974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive technology in Microsoft Excel or Access that can show dynamic views of the same data from a list or a database.</descrip></descripGrp><ntig><termGrp><term id="373952">PivotTable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1936974">კრებსითი ცხრილი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14543_231973_2072298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Office Web Component that allows you to create a structure similar to an Excel PivotTable report. Users can view the PivotTable list in a Web browser and change its layout in a manner similar to an Excel PivotTable report.</descrip></descripGrp><ntig><termGrp><term id="231973">PivotTable list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="