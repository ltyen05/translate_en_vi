 Store განათლებისთვის</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4441_48513_506419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard Windows control that combines the characteristics of a text box with a drop-down list box.</descrip></descripGrp><ntig><termGrp><term id="48513">drop-down combo box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506419">ჩამოშლადი კომბო-სია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44418_2501250_2503026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card that displays information about a person such as their picture and contact information.</descrip></descripGrp><ntig><termGrp><term id="2501250">profile card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2503026">პროფილის ბარათი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44418_2501250_2878080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card that displays information about a person such as their picture and contact information.</descrip></descripGrp><ntig><termGrp><term id="2501250">prof