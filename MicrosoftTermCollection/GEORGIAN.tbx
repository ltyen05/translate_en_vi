">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53713_3057907_3058467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of attack that involves sending text messages disguised as trustworthy communications from well-known businesses. The name is a combination of the words “SMS” and “phishing”.</descrip></descripGrp><ntig><termGrp><term id="3057907">smishing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3058467">სმიშინგი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53714_3120734_3121549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that enables ISVs to build across the Microsoft Cloud, publish, and grow in the commercial marketplace.</descrip></descripGrp><ntig><termGrp><term id="3120734">ISV Success</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3121549">ISV წარმატება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53715_3057909_3058469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Philanthropies program that provides technology grants and discounts to nonprofit organizations all over th