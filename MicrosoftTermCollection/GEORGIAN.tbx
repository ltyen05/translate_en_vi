crip type="definition">A group of open tabs, including applications, files, pages, or websites, which can be saved together and re-opened together when you want to continue with that set of tabs.</descrip></descripGrp><ntig><termGrp><term id="2612186">set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2612726">ნაკრები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46375_2612854_2924264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A date when Microsoft will no longer provide updates to a feature release of a product, such that a customer needs to upgrade to a new feature release to continue receiving support from Microsoft.</descrip></descripGrp><ntig><termGrp><term id="2612854">end of service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2924264">სერვისის დასასრული</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46375_2878237_2924264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A date when Microsoft will no longer provide updates to a feature release of a product, such that a customer needs to upgrade to a new feature release to continue receiving support from Microsoft.</descrip></descripGrp><ntig><termGrp><term id="2878237">EOL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</ter