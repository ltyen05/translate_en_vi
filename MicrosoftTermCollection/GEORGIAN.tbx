rets the commands sent by a printer driver and converts them to a raster or bitmap grid to mark the paper or film.</descrip></descripGrp><ntig><termGrp><term id="98937">RIP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1798033">RIP</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1216_1505033_3114984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A central repository that stores operations data for long periods of time and is a core component of business intelligence.</descrip></descripGrp><ntig><termGrp><term id="1505033">data warehouse database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3114984">მონაცემთა საწყობი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1216_43204_3114984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A central repository that stores operations data for long periods of time and is a core component of business intelligence.</descrip></descripGrp><ntig><termGrp><term id="43204">data warehouse</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3114984">მონაცემთა საწყობი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="gr