xml:lang="en-US"><descripGrp><descrip type="definition">A set of characteristics that define any business-related item, such as a customer, a company, or a business process. Each profile is an individual instance of a profile definition.</descrip></descripGrp><ntig><termGrp><term id="209878">profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2344446">პროფილი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10349_147050_1888980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identifier in the form OLEServerName.ObjectName (for example, Excel.Sheet or PowerPoint.Slide) that's used by the Windows registry to uniquely identify an object.</descrip></descripGrp><ntig><termGrp><term id="147050">programmatic identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1888980">პროგრამული იდენტიფიკატორი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10349_147050_1888981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identifier in the form OLEServerName.ObjectName (for example, Excel.Sheet or PowerPoint.Slide) that's used by the Windows registry to uniquely identify an object.</descrip></descripGrp><ntig><termGrp><term id="147050">programmatic identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singula