ercase.</descrip></descripGrp><ntig><termGrp><term id="27628">CAPS LOCK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1223235">CAPS LOCK კლავიში</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1082_27628_506233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toggle key that, when on, shifts the alphabetic characters on the keyboard to uppercase.</descrip></descripGrp><ntig><termGrp><term id="27628">CAPS LOCK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506233">CAPS LOCK</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1082_27629_1223235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toggle key that, when on, shifts the alphabetic characters on the keyboard to uppercase.</descrip></descripGrp><ntig><termGrp><term id="27629">CAPS LOCK key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1223235">CAPS LOCK კლავიში</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1082_27629_506233"><langSet x