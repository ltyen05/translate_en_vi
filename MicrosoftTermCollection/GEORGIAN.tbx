thout having to purchase it.</descrip></descripGrp><ntig><termGrp><term id="2389316">preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2391785">გადახედვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42207_2389317_2391782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of being charged money for a particular service.</descrip></descripGrp><ntig><termGrp><term id="2389317">billing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2391782">ბილინგი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42208_2389319_2391783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of charging money for a particular service and generating invoices.</descrip></descripGrp><ntig><termGrp><term id="2389319">billing and invoicing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2391783">ბილინგი და ინვოისი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4221_118391_506846"><langSet xml:lang="en-US"><descripGrp><descrip t