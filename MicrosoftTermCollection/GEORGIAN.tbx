ption (the source subscription) is replaced by a new subscription, both owned by the same billing account, along a preconfigured conversion path. The source subscription is canceled and the destination subscription is the new subscription.</descrip></descripGrp><ntig><termGrp><term id="1703344">conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1745120">გარდაქმნა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32770_1703345_1745123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A new subscription that is created as a result of a conversion or a merge.</descrip></descripGrp><ntig><termGrp><term id="1703345">destination subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1745123">მიზნობრივი გამოწერა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32770_1703345_2351421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A new subscription that is created as a result of a conversion or a merge.</descrip></descripGrp><ntig><termGrp><term id="1703345">destination subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2351421">სასურველი გამოწერა</term><termNote type="geographicalUsage">GEO</termNote><termN