scripGrp><descrip type="definition">The category name for a group of features that enable collaboration with external users in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="2930015">Microsoft Teams Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3060343">Teams-ის შიგთავსი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52046_3059193_2931419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category name for a group of features that enable collaboration with external users in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="3059193">Teams Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2931419">Microsoft Teams-ით დაკავშირება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52046_3059193_3060343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category name for a group of features that enable collaboration with external users in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="3059193">Teams Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3060343">Teams-ის შიგთავსი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52048_2930017_2931421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Office perpetual for Consumer and SMB that includes the traditional suite of classic apps such as Word, Excel, PowerPoint, and other apps, sold as a one-time purchase without any major feature updates.</descrip></descripGrp><ntig><termGrp><term id="2930017">Office 2021</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2931421">Office 2021</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52049_2930018_2931423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that allows customers to configure operator dial-in phone numbers on a Microsoft Audio Conferencing bridge and provides customers the ability to maintain their existing operator contracts and relationships as they migrate to the cloud, diversify their PSTN infrastructure to include multiple operators, expand dial-in coverage and enterprise-grade reliability and support.</descrip></descripGrp><ntig><termGrp><term id="2930018">Operator Connect Conferencing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2931423">კონფერენცია Operator Connect-ით</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52050_2930019_2931416"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of the Exchange Server software that a customer can run on-premises, for which Microsoft provides ongoing support and updates for as long as the subscription is current/valid.</descrip></descripGrp><ntig><termGrp><term id="2930019">Microsoft Exchange Server Subscription Edition</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2931416">Microsoft Exchange Server-ის გამოსაწერი გამოცემა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52051_2930020_2931415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Teams, the feature that moves all video feeds to the top of the meeting window, allowing more natural eye contact with meeting attendees.</descrip></descripGrp><ntig><termGrp><term id="2930020">Gallery at top</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2931415">გალერეა თავში</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52052_2930022_2931429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option in Presenter Mode in which the content is shown as a visual aid above the presenter's shoulder, like a television reporter.</descrip></descripGrp><ntig><termGrp><term id="2930022">Reporter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2931429">მომხსენებელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52054_2930025_2931417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that enables IT managed secure control and customization by allowing customers to bring consistent organizational experiences and have enhanced control and management across the organization.</descrip></descripGrp><ntig><termGrp><term id="2930025">Microsoft Teams Advanced Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2931417">Microsoft Teams-ის გაფართოებული მართვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52055_2930026_2931424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PowerPoint experience with features exclusive to Microsoft Teams, in which users can see their notes, upcoming slides, audience member videos and chat, and more.</descrip></descripGrp><ntig><termGrp><term id="2930026">PowerPoint Live</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2931424">PowerPoint Live</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52057_2930028_2931414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability that makes it easy to plan and schedule quality, feature, and driver updates through powerful, cloud-based controls and leverages cloud capabilities to protect commercial customers from update-related issues through automatic pilot rings, ML-based issue detection, and tenant monitoring.</descrip></descripGrp><ntig><termGrp><term id="2930028">deployment service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2931414">გაფართოებული დაყენების სერვისი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52067_2931691_2932820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of Windows to adapt the way your colors render based on the type of content you consume and/or the environment you are in (dark vs bright, or an environment of a specific color - e.g. a coffee shop with green walls or a theatre with a predominance of red).</descrip></descripGrp><ntig><termGrp><term id="2931691">adaptive color</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2932820">ადაპტირებადი ფერი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52069_2932124_2935687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2021 version of Microsoft Office Project Standard that utilizes the LTSC servicing model.</descrip></descripGrp><ntig><termGrp><term id="2932124">Microsoft Office LTSC Project Standard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2935687">სტანდარტული Microsoft Office LTSC Project</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52069_2932124_2935688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2021 version of Microsoft Office Project Standard that utilizes the LTSC servicing model.</descrip></descripGrp><ntig><termGrp><term id="2932124">Microsoft Office LTSC Project Standard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2935688">სტანდარტული Microsoft Office LTSC Project 2021</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52069_2932124_2935696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2021 version of Microsoft Office Project Standard that utilizes the LTSC servicing model.</descrip></descripGrp><ntig><termGrp><term id="2932124">Microsoft Office LTSC Project Standard</term><termNote type="partO