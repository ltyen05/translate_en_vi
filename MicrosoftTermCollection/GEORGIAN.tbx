Note><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10928_359996_508011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A table, query, form, report, macro, or module that remains in the replica or Design Master where it was created. Neither the object nor changes to the object are copied to other members in the replica set.</descrip></descripGrp><ntig><termGrp><term id="359996">local object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="508011">ლოკალური ობიექტი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10934_237291_507412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that applies a read-only state to a document inside client applications.</descrip></descripGrp><ntig><termGrp><term id="237291">Mark as Final</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507412">მონიშვნა საბოლოოდ</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10935_54757_506461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To associate a flag with a message or other item.</descrip></descripGrp><ntig><termGrp><term id="54757">flag</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506461">დანიშვნა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10945_139125_1888925"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software program that reduces a file's size for storage on a disk. If a compressed file is too large to fit onto a single disk, the compression utility copies it onto multiple disks.</descrip></descripGrp><ntig><termGrp><term id="139125">compression utility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1888925">კომპრესიის უტილიტა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10947_320488_506553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Erroneous or unrecognizable because of a flaw in reasoning or an error in input. Invalid results, for example, might occur if the logic in a program is faulty.</descrip></descripGrp><ntig><termGrp><term id="320488">not valid</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506553">არასწორი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10947_70460_506553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Erroneous or unrecognizable because of a flaw in reasoning or an error in input. Invalid results, for example, might occur if the logic in a program is faulty.</descrip></descripGrp><ntig><termGrp><term id="70460">invalid</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506553">არასწორი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10950_375738_1889101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computational proof that Outlook applies to outgoing messages to help recipient messaging systems distinguish legitimate email from junk email.</descrip></descripGrp><ntig><termGrp><term id="375738">Outlook E-Mail Postmark</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889101">Outlook E-Mail Postmark</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10963_306412_507647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item in Internet Explorer that turns on the tool for Tablet PC users that allows the user to move the content of the page up and down, like a mouse scroll wheel.</descrip></descripGrp><ntig><termGrp><term id="306412">Panning Hand</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507647">პანირების სახელური</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10964_169207_507149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reverse changes.</descrip></descripGrp><ntig><termGrp><term id="169207">roll back</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507149">ცვლილებების დაბრუნება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1097_347909_507967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user’s private information such as temporary files, history, passwords, web form entries, and cookies that captures Internet surfing and other online activities.</descrip></descripGrp><ntig><termGrp><term id="347909">browsing history</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507967">ნახვის ისტორია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10974_39994_506339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The © character. Normally included at the beginning of a copyright notice.</descrip></descripGrp><ntig><termGrp><term id="39994">copyright symbol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506339">საავტორო უფლებების სიმბოლო</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10976_232529_1889065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pane in normal view in which you type notes that you want to accompany a slide. You print these notes as notes pages or have them display when you save a presentation as a Web page.</descrip></descripGrp><ntig><termGrp><term id="232529">notes pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889065">შენიშვნათა პანელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10982_117719_506844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The activities and actions performed by customer service representatives to assist customers.</descrip></descripGrp><ntig><termGrp><term id="117719">support</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506844">მხარდაჭერა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</term