lNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3012556">Microsoft Viva Insights Capacity</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52989_3012675_3012892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of the Calculator app that allows the user to store a figure for use in future calculations.</descrip></descripGrp><ntig><termGrp><term id="3012675">Memory</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3012892">მეხსიერება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52990_3012676_3014335"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Teams feature that allows a user to draw on and annotate an object on the screen.</descrip></descripGrp><ntig><termGrp><term id="3012676">Annotate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014335">ანოტირება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52991_3012677_3014338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link in Teams that allows a user to access information about a meeting.</descrip></descripGrp><ntig><termGrp><term id="3012677">Info</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014338">ინფორმაცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52992_3012678_3014336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link in Teams that allows a user to access and add applications like Forms or PowerApps.</descrip></descripGrp><ntig><termGrp><term id="3012678">Apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014336">აპები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52993_3012679_3014340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The high-fidelity music mode in Teams that offers a richer sound experience when the user transmits music to listeners.</descrip></descripGrp><ntig><termGrp><term id="3012679">Music</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014340">მუსიკა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntr