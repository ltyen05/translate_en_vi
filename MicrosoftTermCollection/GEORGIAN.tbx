lNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11249_66343_506529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Light that is beyond red in the color spectrum. While the light is not visible to the human eye, infrared transmitters and receivers can send and receive infrared signals.</descrip></descripGrp><ntig><termGrp><term id="66343">infrared</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506529">ინფრაწითელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11249_66344_506529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Light that is beyond red in the color spectrum. While the light is not visible to the human eye, infrared transmitters and receivers can send and receive infrared signals.</descrip></descripGrp><ntig><termGrp><term id="66344">IR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506529">ინფრაწითელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11251_209886_507215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Someone who visits a Web site and purposefully supplies personal information, such as name, address, and phone number.</descrip></descripGrp><ntig><termGrp><term id="209886">registered user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="gramma