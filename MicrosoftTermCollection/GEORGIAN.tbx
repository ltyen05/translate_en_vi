ntig><termGrp><term id="506889">დეინსტალაცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10265_234076_507331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that brings up an international list that allows users to block emails from those domains.</descrip></descripGrp><ntig><termGrp><term id="234076">Blocked Top-Level Domain List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507331">დაბლოკილ ზედა დონის დომენთა სია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10268_169412_507150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To do over again.</descrip></descripGrp><ntig><termGrp><term id="169412">redo</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507150">გამეორება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10273_297181_507610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A peer-to-peer file sharing client used to connect to file sharing networks in order to download or share files.</descrip></descripGrp><ntig><termGrp><term id="297181">file sharing program</term>