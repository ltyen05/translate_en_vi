Entry><termEntry id="52735_2956715_2996893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The largest positive integer that is a factor/divisor of each of a given set of integers.</descrip></descripGrp><ntig><termGrp><term id="2956715">greatest common factor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2996893">უდიდესი საერთო გამყოფი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52736_2956716_2996907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of a number or expression, a number which, when raised to a specified power, yields the specified number or expression.</descrip></descripGrp><ntig><termGrp><term id="2956716">root</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2996907">ფესვი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52737_2956717_2996914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An expression consisting of three terms.</descrip></descripGrp><ntig><termGrp><term id="2956717">trinomial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2996914">სამწევრი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammat