">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5274_168784_507148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To go back to a previous state by reversing the effects of one or more commands.</descrip></descripGrp><ntig><termGrp><term id="168784">undo</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507148">მოქმედების დაბრუნება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52741_2956721_2996905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solution that is a rational number, that is any number that can be represented in the form of p/q where q=/=0.</descrip></descripGrp><ntig><termGrp><term id="2956721">rational solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2996905">რაციონალური ამონახსნი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52742_2956722_2996887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scalar value that is a function of the entries of a square matrix.</descrip></descripGrp><ntig><termGrp><term id="2956722">determinant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2996887">დეტერმინანტი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52743_2956723_2996896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statement that of two quantities one is specifically less than or greater than another.</descrip></descripGrp><ntig><termGrp><term id="2956723">inequality</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2996896">უტოლობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52744_2956724_2996913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The replacement of the variables in an algebraic expression by their values in terms of another set of variables.</descrip></descripGrp><ntig><termGrp><term id="2956724">transformation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2996913">გარდაქმნა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52745_2956725_2996886"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The derived function of a function.</descrip></descripGrp><ntig><termGrp><term id="2956725">derivative</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2996886">წარმოებული</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52746_2956726_2996899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The coordinate of the point at which a curve intersects an axis.</descrip></descripGrp><ntig><termGrp><term id="2956726">intercept</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2996899">ღერძთან გადაკვეთის წერტილი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52747_2956727_2996885"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a right triangle, the reciprocal of the sine of an angle.</descrip></descripGrp><ntig><termGrp><term id="2956727">cosecant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2996885">კოსეკანსი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52748_2956728_2996889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disjunction which is true if only one, but not both, o