</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3006472">Xbox-ის ქსელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34328_1991438_2916531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Games and other applications that are served and run directly from the Xbox Live service, typically with an additional fee to play.</descrip></descripGrp><ntig><termGrp><term id="1991438">Arcade</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916531">Arcade</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34329_1991439_2916653"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Games that are created by the Xbox community and downloaded from the Xbox Live service, typically with a fee to play the full game.</descrip></descripGrp><ntig><termGrp><term id="1991439">Indie Games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916653">ინდი თამაშები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34330_1991440_2916873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of Xbox Live that caters to a particular style of gameplay. Four zones exist: pro, recreation, family, and underground.</descrip></descripGrp><ntig><termGrp><term id="1991440">Xbox Live Gamer Zone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916873">Xbox Live Gamer Zone</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34331_1991441_2916878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of players on Xbox Live that can play games and chat together.</descrip></descripGrp><ntig><termGrp><term id="1991441">Xbox Live Party</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916878">Xbox Live წვეულება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34333_1991443_2916864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Brand name of the games offering from Xbox.</descrip></descripGrp><ntig><termGrp><term id="1991443">Xbox Games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916864">Xbox-ის თამაშები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34335_1991445_2916902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for Windows 8, Windows Phone, and other portable devices that connects phones, PCs, and tablets with your Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="1991445">Xbox SmartGlass</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916902">Xbox SmartGlass</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34335_1991445_2916903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for Windows 8, Windows Phone, and other portable devices that connects phones, PCs, and tablets with your Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="1991445">Xbox SmartGlass</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916903">Xbox SmartGlass Companion</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34335_2432221_2916902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for Windows 8, Windows Phone, and other portable devices that connects phones, PCs, and tablets with your Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="2432221">Xbox SmartGlass Companion</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916902">Xbox SmartGlass</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34335_2432221_2916903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for Windows 8, Windows Phone, and other portable devices that connects phones, PCs, and tablets with your Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="2432221">Xbox SmartGlass Companion</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916903">Xbox SmartGlass Companion</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34337_1991447_2916682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live account.</descrip></descripGrp><ntig><termGrp><term id="1991447">membership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916682">წევრობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34338_1991448_2916707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Code used to restrict access, entered using a combination of controller button and trigger presses.</descrip></descripGrp><ntig><termGrp><term id="1991448">passcode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916707">პაროლ-კოდი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34339_1991449_2916762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live account security feature in which Xbox sends a one-time code to a customer's preference of contact options (email, text message, or phone), allowing them to return the code to verify their identity.</descrip></descripGrp><ntig><termGrp><term id="1991449">security check</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916762">უსაფრთხოების შემოწმება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34340_1991450_2916740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a transaction in which Microsoft Points are exchanged.</descrip></descripGrp><ntig><termGrp><term id="1991450">redeem</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916740">გამოყენება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34341_1991451_2916741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To extend an Xbox Live membership.</descrip></descripGrp><ntig><termGrp><term id="1991451">renew</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916741">განახლება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34342_1991452_2916869"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Membership code that is purchased or won through offers, contests, events, and so on.</descrip></descripGrp><ntig><termGrp><term id="1991452">Xbox Live code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916869">Xbox Live კოდი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34344_1991454_2916872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Basic level of Xbox Live membership.</descrip></descripGrp><ntig><termGrp><term id="1991454">Xbox Live Free membership</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916872">Xbox Live-ის უფასო წევრობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34345_1991455_2916660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The controller-free gaming experience from Xbox.</descrip></descripGrp><ntig><termGrp><term id="1991455">Kinect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916660">Kinect</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_1991456_2191364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="1991456">Kinect sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2191364">Kinect-ის სენსორი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_1991456_2916763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="1991456">Kinect sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916763">სენსორი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_2013412_2191364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="2013412">sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2191364">Kinect-ის სენსორი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_2013412_2916763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="2013412">sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916763">სენსორი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34347_1991457_2916536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The automatic angle adjustment function of the Kinect sensor.</descrip></descripGrp><ntig><termGrp><term id="1991457">auto-tilt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916536">ავტომატური დახრა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34348_1991458_2916587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The infrared camera component of the Kinect sensor.</descrip></descripGrp><ntig><termGrp><term id="1991458">depth sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916587">სიღრმის სენსორი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34349_1991459_2916812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The RGB camera component of the Kinect sensor.</descrip></descripGrp><ntig><termGrp><term id="1991459">video sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916812">ვიდეო სენსორი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34350_1991460_2916609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The entire area that the sensor can "see," including walls, furniture, and other obstructions.</descrip></descripGrp><ntig><termGrp><term id="1991460">field of view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916609">ხედვის არე</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34351_1991461_2916713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area within the Kinect sensor's field of view is able to detect a person or in which a player moves.</descrip></descripGrp><ntig><termGrp><term id="1991461">play space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916713">სათამაშო სივრცე</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34352_1991462_2916603"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Facial identification used by the sensor to recognize a player.</descrip></descripGrp><ntig><termGrp><term id="1991462">facial recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916603">სახის ამოცნობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34353_1991463_2916632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A motion made by a player that's intended to be tracked by the sensor.</descrip></descripGrp><ntig><termGrp><term id="1991463">gesture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916632">ჟესტი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34354_1991464_2916636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In-game gesture that invokes the Kinect Guide.</descrip></descripGrp><ntig><termGrp><term id="1991464">guide gesture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916636">სახელმძღვანელო ჟესტი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34355_1991465_2916663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Biometric recognition of a player by the system, through the use of the Kinect sensor and software.</descrip></descripGrp><ntig><termGrp><term id="1991465">Kinect ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916663">Kinect ID</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34356_1991466_2916637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual progress indicator that appears in the corner of the screen when a player performs the guide gesture. Because the icon is only visible when cued by the guide gesture, use only when necessary to specifically call out its functionality, as in an instructional demo, for example.</descrip></descripGrp><ntig><termGrp><term id="1991466">guide icon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916637">სახელმძღვანელო ნიშანი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34357_1991467_2916638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The icon that appears when a player is detected in the play space, prompting a wave to engage with Kinect. Once engaged, a hand pointer appears, which serves as a mechanism for navigation and object manipulation.</descrip></descripGrp><ntig><termGrp><term id="1991467">hand icon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916638">ხელის ხატულა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34358_1991468_2916686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The icon that is present when the Kinect microphone is available to accept voice commands.</descrip></descripGrp><ntig><termGrp><term id="1991468">microphone icon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916686">მიკროფონის ხატულა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34359_1991469_2916779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Spoken input that's intended to be received and interpreted by the sensor as input.</descrip></descripGrp><ntig><termGrp><term id="1991469">speech</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916779">მეტყველება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34360_1991470_2916790"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The detection and following of a person's movements by the sensor.</descrip></descripGrp><ntig><termGrp><term id="1991470">tracking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916790">თვალის დევნება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34361_1991471_2916815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Vocal input that's used by the sensor to identify a player.</descrip></descripGrp><ntig><termGrp><term id="1991471">voice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916815">ხმა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34362_1991472_2916816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The panel that appears in the Xbox Dashboard when the Kinect sensor recognizes the voice command "Xbox".</descrip></descripGrp><ntig><termGrp><term id="1991472">voice bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916816">ხმის ზოლი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34363_1991473_2916810"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Video communication with another player on Xbox Live, using the Kinect sensor. Formerly video chat.</descrip></descripGrp><ntig><termGrp><term id="1991473">Video Kinect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916810">Video Kinect</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34364_1991474_2916662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect based guide that appears over a game and allows for social interactions (friends, invites, chat, etc.).</descrip></descripGrp><ntig><termGrp><term id="1991474">Kinect Guide</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916662">Kinect-ის სახელმძღვანელო</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34365_1991475_2916666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect based troubleshooter that helps users with common problems related to the play space, lighting, speech/audio, setup, and hardware errors.</descrip></descripGrp><ntig><termGrp><term id="1991475">Kinect Tuner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916666">Kinect-ის დამყენებელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34366_1991476_2916618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Disc used for playing games.</descrip></descripGrp><ntig><termGrp><term id="1991476">game disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916618">თამაშების დისკი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34367_1991477_2916574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a permanent attachment between a wireless controller and the console.</descrip></descripGrp><ntig><termGrp><term id="1991477">connect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916574">დაკავშირება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34368_1991478_2916577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When in vertical orientation, the stabilizers at the bottom of the console.</descrip></descripGrp><ntig><termGrp><term id="1991478">console feet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916577">კონსოლის ფეხები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34369_1991479_2916579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the USB ports on the front of the console that support the controllers and other USB devices such as cameras and audio players.</descrip></descripGrp><ntig><termGrp><term id="1991479">controller port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916579">კონტროლერის პორტი</term><termNote type="geographicalUsage">