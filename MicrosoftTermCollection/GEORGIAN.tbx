n-US"><descripGrp><descrip type="definition">The portion of data distribution that is determined to be more or less than some critical value. For example, the far left and far right areas of a bell curve.</descrip></descripGrp><ntig><termGrp><term id="1162904">tail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889334">დაბოლოება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24869_1162906_1883887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test in which the null hypothesis is rejected if the value of the test statistic falls into either tail of the probability distribution (i.e. is either less than a first critical value or greater than a second critical value).</descrip></descripGrp><ntig><termGrp><term id="1162906">two-tailed test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1883887">ორმხრივი ტესტი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24869_1176836_1883887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test in which the null hypothesis is rejected if the value of the test statistic falls into either tail of the probability distribution (i.e. is either less than a first critical value or greater than a second critical value).</descrip></descripGrp><ntig><termGrp><term id="1176836">two-sided test</term><termNote type=