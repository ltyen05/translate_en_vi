 type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2431597">ტექსტის ზომა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42863_2430760_2431598"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to change letter, word, line, and column spacing to reduce visual crowding.</descrip></descripGrp><ntig><termGrp><term id="2430760">text spacing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2431598">ტექსტის დაშორება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42864_2430761_2431595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that reads text in an application to the user.​</descrip></descripGrp><ntig><termGrp><term id="2430761">read aloud</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2431595">ხმით წაკითხვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42865_2430762_2431596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that separates the syllables of each word with a dot, making content more easily readable for some people.</descrip></descripGrp><ntig><termGrp><term id="2430762">syllables</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2431596">მარცვლები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42878_2430908_2433679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that analyzes editing notations made with ink and makes the corresponding changes to the document.</descrip></descripGrp><ntig><termGrp><term id="2430908">Ink Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2433679">ხელნაწერის რედაქტირება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4288_346910_1223251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To join or link.</descrip></descripGrp><ntig><termGrp><term id="346910">connect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1223251">დაკავშირება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42885_2432491_2435393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that allows users to use ink to highlight content using their mouse, finger, or an inking tool, and whose ink resembles a traditional highlighter.</descrip></descripGrp><ntig><termGrp><term id="2432491">highlighter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2435393">მომნიშნავი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42886_2432492_2435392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To create, highlight, or erase content using ink.</descrip></descripGrp><ntig><termGrp><term id="2432492">draw</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2435392">ხატვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42887_2432493_2435395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that allows users to use ink to draw using their mouse, finger, or an inking tool, and whose ink resembles pencil graphite.</descrip></descripGrp><ntig><termGrp><term id="2432493">pencil</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2435395">ფანქარი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42888_2432494_2435394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that allows users to use ink to draw using their mouse, finger, or an inking tool, and whose ink resembles traditional pen ink.</descrip></descripGrp><ntig><termGrp><term id="2432494">pen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2435394">კალამი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42889_2432495_2435398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that is activated when clicked once, and when clicked a second time, opens a menu that allows the user to modify the mode of the selected tool.</descrip></descripGrp><ntig><termGrp><term id="2432495">secondary action button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2435398">მეორადი მოქმედების ღილაკი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42890_2432497_2435399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that is opened via a secondary action button and that gives users one or more options for changing the mode of the selected tool.</descrip></descripGrp><ntig><termGrp><term id="2432497">secondary action menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2435399">მეორადი მოქმედების მენიუ</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42891_2432499_2435397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An in-ribbon container that holds a collection of buttons and where the user can add additional buttons, reorganize buttons, and scroll through them when they are not all visible within the container.</descrip></descripGrp><ntig><termGrp><term id="2432499">scrollable button group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2435397">ცოცია ღილაკების ჯგუფი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42895_2433212_2435396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The contextual ribbon tab that appears when users select a picture.​</descrip></descripGrp><ntig><termGrp><term id="2433212">Picture</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2435396">სურათი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42900_2433217_2435792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Literally, "without stroke"; describes any typeface in which the characters have no serifs (the short lines or ornaments at the upper and lower ends of the strokes.) A sans serif typeface usually possesses a more straightforward, geometric appearance than a typeface with serifs and typically lacks the contrast between thick and thin strokes found in serif faces.</descrip></descripGrp><ntig><termGrp><term id="2433217">sans serif</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2435792">ნაჭდევის გარეშე</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4293_37521_506313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state of an expression or a variable (for example, when a result can be either true or false, or equal or not equal).</descrip></descripGrp><ntig><termGrp><term id="37521">condition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506313">პირობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4296_309439_1223252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A World Wide Web version of Windows Client Help.</descrip></descripGrp><ntig><termGrp><term id="309439">Windows Assistance Online</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1223252">Windows Assistance-ის ონლაინ ვერსია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4296_309440_1223252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A World Wide Web version of Windows Client Help.</descrip></descripGrp><ntig><termGrp><term id="309440">WOA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1223252">Windows Assistance-ის ონლაინ ვერსია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4297_317462_507743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The « character.</descrip></descripGrp><ntig><termGrp><term id="317462">opening chevron</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507743">გახსნის შევრონი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42971_2435051_2438541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having a layout that groups objects two-dimensionally.</descrip></descripGrp><ntig><termGrp><term id="2435051">bending</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2438541">მოხრილი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42972_2435052_2438543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic that shows a progression of steps in a task, process, or workflow.</descrip></descripGrp><ntig><termGrp><term id="2435052">bending process</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2438543">მოხრის პროცესი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42973_2435053_2438542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic type that shows a series of pictures that wrap around in the confines of a box.</descrip></descripGrp><ntig><termGrp><term id="2435053">bending picture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2438542">მოხრილი სურათი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42974_2435055_2438544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to act on events such as travel reservations and package deliveries captured from email and receive reminders for them.</descrip></descripGrp><ntig><termGrp><term id="2435055">Events from Email</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2438544">მოვლენები ელფოსტიდან</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42991_2436154_2440069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud service that uses machine learning.</descrip></descripGrp><ntig><termGrp><term id="2436154">intelligent service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2440069">ჭკვიანი სერვისი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42992_2436155_2440072"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word Mobile feature that opens a preview window of the scrolling destination page when the user taps on the Thumb Scroll and that only updates the main view once the user lets go.​</descrip></descripGrp><ntig><termGrp><term id="2436155">Scroll Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2440072">ცოციათი გადახედვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42993_2436156_2596101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism to set up clients to the cloud service.</descrip></descripGrp><ntig><termGrp><term id="2436156">onboarding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2596101">გაწევრიანება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42994_2436157_2596100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism to remove clients from the cloud service.</descrip></descripGrp><ntig><termGrp><term id="2436157">offboarding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2596100">გარიცხვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42995_2436354_2440067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows Office users wanting to use a third-party app or plug in within Office to provide their credentials or permission so that the app within Office can perform actions on their behalf. ​</descrip></descripGrp><ntig><termGrp><term id="2436354">App to App sign in</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2440067">აპიდან აპზე შესვლა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42996_2436355_2440071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to trim the start and end of a video file by specifying the location to start playing and the location to end playing.</descrip></descripGrp><ntig><termGrp><term id="2436355">Media Trim</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2440071">მედია მონტაჟი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42997_2436365_3113857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud-based solution that enables organizations to control user access to apps and data in the cloud and on-premises, to ensure only authorized users have access.</descrip></descripGrp><ntig><termGrp><term id="2436365">Azure AD Identity Governance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3113857">Microsoft Entra ID-ის მართვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><ter