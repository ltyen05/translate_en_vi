xml:lang="en-US"><descripGrp><descrip type="definition">An application that parses code and markup in a page to help ensure that only trusted code and markup is run on a computer, server farm, or server cluster.</descrip></descripGrp><ntig><termGrp><term id="1508552">safe mode parser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889413">უსაფრთხო რეჟიმის ანალიზატორი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29440_1508555_1889414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Help window that contains a Help topic.</descrip></descripGrp><ntig><termGrp><term id="1508555">topic pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889414">თემის სარკმელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29442_1508557_1889415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that identifies which assemblies and types are allowed to run on Web Parts pages in a server farm. The list is stored in the web.config file for the server farm.</descrip></descripGrp><ntig><termGrp><term id="1508557">SafeControl list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889415">უსაფრთხოების კონტროლის სია</term>