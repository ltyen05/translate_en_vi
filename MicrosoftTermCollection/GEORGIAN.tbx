rmNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2526982">მესამე მხარის კოდი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44823_2524057_2575986"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware accessory that allows you to take action in mixed reality. It tracks a precise position in space, allowing for fine-grained interaction with digital objects. When using a Windows Mixed Reality immersive headset, the motion controller is the primary way to take action.</descrip></descripGrp><ntig><termGrp><term id="2524057">motion controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2575986">მოძრაობის მმართველი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44823_2524057_2575988"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware accessory that allows you to take action in mixed reality. It tracks a precise position in space, allowing for fine-grained interaction with digital objects. When using a Windows Mixed Reality immersive headset, the motion controller is the primary way to take action.</descrip></descripGrp><ntig><termGrp><term id="2524057">motion controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2575988">Windows Mixed Reality-ს მოძრაობის მმართველი</term><termNote type="geographi