.</descrip></descripGrp><ntig><termGrp><term id="2329250">assignee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2342852">დავალების მიმღები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40086_2329251_2342863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to items marked with a star.</descrip></descripGrp><ntig><termGrp><term id="2329251">starred</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2342863">ვარსკვლავით მონიშნული</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40087_2329252_2342862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An indication for a priority in a list or other organizational structure.</descrip></descripGrp><ntig><termGrp><term id="2329252">star</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2342862">ვარსკვლავი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40090_2329299_2338476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A ga