abase that stores search feature settings which include but are not limited to query rules and the search schema.</descrip></descripGrp><ntig><termGrp><term id="2072312">search settings database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2085401">ძიების პარამეტრების მონაცემთა ბაზა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36807_2072313_2085400"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to record on-screen activity, and embeds the video automatically in PowerPoint.</descrip></descripGrp><ntig><termGrp><term id="2072313">Screen Recording</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2085400">ეკრანის ჩაწერა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36824_2077814_2103961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Skype software application that uses the non-desktop user interface introduced with Windows 8.</descrip></descripGrp><ntig><termGrp><term id="2077814">Skype for modern Windows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2103961">Skype თანამედროვე Windows-ისთვის</term><termNote type="geographicalUsage">GEO</termNote><term