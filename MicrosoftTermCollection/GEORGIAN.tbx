maticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2605283">სანიშნის შექმნა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23585_1088690_2605283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark an object to find and return to it again.</descrip></descripGrp><ntig><termGrp><term id="1088690">add a bookmark</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2605283">სანიშნის შექმნა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23585_1088691_2605283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark an object to find and return to it again.</descrip></descripGrp><ntig><termGrp><term id="1088691">add a favorite</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2605283">სანიშნის შექმნა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23598_1088662_1522267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tag used to identify a person in a photo.</descrip></descripGrp><ntig><termGrp><term id="1088662">people tag</term><termNote type="part