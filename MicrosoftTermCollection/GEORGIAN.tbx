n">The feature that enables users to use a pinch gesture to zoom in and out of the Photos view.</descrip></descripGrp><ntig><termGrp><term id="2747295">Super Zoom</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2750617">სუპერ ზომა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4859_295625_507596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A letter that serves to introduce accompanying documents to the recipient. Often refers to a letter sent with a resume when applying for a job.</descrip></descripGrp><ntig><termGrp><term id="295625">cover letter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507596">მოტივაციის წერილი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48599_2749761_2927360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An external user who gets invited into an organization for access to specific resources, but signs in using an ID from a different organization.</descrip></descripGrp><ntig><termGrp><term id="2749761">guest</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2927360">სტუმარი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Nou