><termEntry id="21053_766415_1224130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disk image provided for use in repairing or reinstalling an installation of Windows.</descrip></descripGrp><ntig><termGrp><term id="766415">recovery image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224130">აღდგენის იმიჯი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21089_766591_1224131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recognition feature that helps increase input speed and reduce effort by providing users with word completion and next word prediction alternates as the user is writing/typing.</descrip></descripGrp><ntig><termGrp><term id="766591">text prediction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224131">ტექსტის შეთავაზება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21091_766598_1224132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extension of the conventional touch input feature to allow multiple fingers touching the computer or device screen at the same time.</descrip></descripGrp><ntig><termGrp><term id="766598">multi-touch input</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang=