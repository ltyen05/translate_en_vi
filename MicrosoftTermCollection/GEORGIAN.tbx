g><termGrp><term id="1636440">result source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889524">შედეგების წყარო</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29149_1506722_2320979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container for items that are deleted. Items in this container are visible to users with the appropriate permissions and to site collection administrators.</descrip></descripGrp><ntig><termGrp><term id="1506722">first-stage Recycle Bin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2320979">პირველი დონის ურნა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29193_1644672_1889563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part that renders named objects or named items in a workbook, such as tables, charts, slicers or a named range of cells.</descrip></descripGrp><ntig><termGrp><term id="1644672">named item view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889563">სახელდარქმეული ელემენტის ხედი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gramma