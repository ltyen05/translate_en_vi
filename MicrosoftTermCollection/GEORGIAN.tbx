 reminder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2064983">დაბადების დღის შეხსენება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33621_1805615_1988066"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category of items that is personalized for the current user.</descrip></descripGrp><ntig><termGrp><term id="1805615">Picks for you</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1988066">თქვენთვის არჩეული</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33623_1805617_2065015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A traditional phone, which has a wired connection (as opposed to a mobile phone).</descrip></descripGrp><ntig><termGrp><term id="1805617">landline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2065015">სტაციონარული ტელეფონები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33624_1805618_2065017"><langSet xml:lang="en-US"><descripGrp><descrip type="definit