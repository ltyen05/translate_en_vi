hanges</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2661518">ბოლოდროინდელი ცვლილებები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47241_2660318_2661520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual effect applied to an SVG image or object in an SVG image.</descrip></descripGrp><ntig><termGrp><term id="2660318">SVG filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2661520">SVG ფილტრი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47243_2660321_2661515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SVG filter that displaces the geometry of an image.</descrip></descripGrp><ntig><termGrp><term id="2660321">Displacement Map</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2661515">განლაგების რუკა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47244_2660322_2661517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SVG filter that layers an offset copy of an image on top of another so that the images can be layered.</descrip></descripGrp><ntig><termGrp><term id="2660322">Offset</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2661517">ოფსეტი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47245_2660323_2661519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SVG filter that creates a bright spot of lighting in the image, creating a stark contrast between the lit and unlit parts.</descrip></descripGrp><ntig><termGrp><term id="2660323">Specular Light</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2661519">არეკლილი შუქი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47246_2660324_2661514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SGV filter that adds light that is reflected in many directions, which produces a more uniform lighting effect with a smooth transition from lit to unlit parts.</descrip></descripGrp><ntig><termGrp><term id="2660324">Diffuse Lighting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2661514">გაბნეული განათება</term><termNote type="geographicalUsage">GEO</t