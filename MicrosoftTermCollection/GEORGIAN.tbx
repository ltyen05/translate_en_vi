"><ntig><termGrp><term id="506509">დეფისი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15888_62684_3041820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color model used in some graphics programs to define a color by three values: Hue, the color itself; Saturation, the purity of the color; and Value, the lightness or darkness of a color.</descrip></descripGrp><ntig><termGrp><term id="62684">HSV</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3041820">HSV</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15888_757192_3041820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color model used in some graphics programs to define a color by three values: Hue, the color itself; Saturation, the purity of the color; and Value, the lightness or darkness of a color.</descrip></descripGrp><ntig><termGrp><term id="757192">hue-saturation-value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3041820">HSV</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15904_138795_506979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range of colors in which each color gradually blends into the next one. For example, a blue ramp gradually blends hues of blue from pure black to pure blue.</descrip></descripGrp><ntig><termGrp><term id="138795">color ramp</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506979">ფერთა გრადაცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15921_140658_507005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains the styles in a presentation, including the type and size of bullets and fonts; placeholder sizes and positions; background design and fill; color schemes; and a slide master and optional title master.</descrip></descripGrp><ntig><termGrp><term id="140658">design template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507005">დიზაინის შაბლონი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15926_234817_507362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item on the Control Panel that provides user a comprehensive view over all roamed content, as well as ability to check on the synchronization progress of individual items.</descrip></descripGrp><ntig><termGrp><term id="234817">Sync Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></t