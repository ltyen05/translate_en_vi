type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3115304">Python ბიბლიოთეკა Excel-ში</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5483_88655_506696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number whose form indicates position in an ordered sequence of items, such as first, third, or twentieth.</descrip></descripGrp><ntig><termGrp><term id="88655">ordinal number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506696">რიგობითი რიცხვი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54832_3115260_3122414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 Copilot capability that delivers relevant, actionable responses to prompts.</descrip></descripGrp><ntig><termGrp><term id="3115260">Semantic Index for Copilot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3122414">Copilot-ის სემანტიკური ინდექსი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54833_3115363_3118029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software extension that augments the capabilities of AI systems, enabling them to interact with APIs from other software and services to retrieve real-time information, incorporate company and other business data, and perform new types of computations.</descrip></descripGrp><ntig><termGrp><term id="3115363">plugin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3118029">დანამატი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5487_26569_506223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Broadly, any device that performs arithmetic operations on numbers. Sophisticated calculators can be programmed for certain functions and can store values in memory, but they differ from computers in several ways: they have a fixed set of commands, they do not recognize text, they cannot retrieve values stored in a data file, and they cannot find and use values generated by a program such as a spreadsheet.</descrip></descripGrp><ntig><termGrp><term id="26569">calculator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506223">კალკულატორი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5492_144959_1888967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Category labels in a chart that, based on worksheet data, are automatically displayed on more than one line in a hierarchy. For example, the heading Produce might appear above a row with headings Tofu, Apples, and Pears.</descrip></descripGrp><ntig><termGrp><term id="144959">multiple-level category labels</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1888967">მრავალი დონის კატეგორიის იარლიყები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54958_3116446_3116970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The geographically defined boundary consisting of the countries in the European Union (EU) and the European Free Trade Association (EFTA) within which Microsoft has committed to store and process customer data for its major commercial enterprise online services.</descrip></descripGrp><ntig><termGrp><term id="3116446">EU Data Boundary</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3116970">ევროკავშირის მონაცემთა საზღვარი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54959_3116447_3116967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To instruct, train, or guide.</descrip></descripGrp><ntig><termGrp><term id="3116447">coach</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term 