Grp><term id="1991543">attributes</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916534">ატრიბუტები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34434_1991544_2916599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Estimates of the results of your physical activity, including calories burned, time spent playing, and physical intensity of movements.</descrip></descripGrp><ntig><termGrp><term id="1991544">exercise stats</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916599">ვარჯიშის სტატისტიკა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34435_1991545_2916611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of game that supports the monitoring and recording of exercise stats from a fitness tracking device worn by a player.</descrip></descripGrp><ntig><termGrp><term id="1991545">fitness tracking game</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916611">ფიტნესის აღმრიცხავი თამაში</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34436_1991546_2916610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of device worn during exercise that estimates your exercise stats based on your level of physical activity.</descrip></descripGrp><ntig><termGrp><term id="1991546">fitness tracking device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916610">ფიტნესის აღმრიცხავი მოწყობილობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34437_1991547_2916782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A legal notice that describes the properties of the system.</descrip></descripGrp><ntig><termGrp><term id="1991547">system information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916782">სისტემის ინფორმაცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34438_1991548_2916785"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A legal notice that establishes the terms under which service is provided.</descrip></descripGrp><ntig><termGrp><term id="1991548">terms of use</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916785">გამოყენების პირობები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34439_1991549_2916776"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that applications must display when unable to establish a connection to a required non-Xbox Live server or web service.</descrip></descripGrp><ntig><termGrp><term id="1991549">Sorry, [video service name/web service name] isn't available right now. Please try again later. For more information, go to www.xbox.com/status.</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916776">ვწუხვართ, [ვიდეო სერვისის სახელი / ვებ-სერვისის სახელი] ამ მომენტისთვის მიუწვდომელია. გთხოვთ, მოგვიანებით ისევ სცადოთ. დამატებითი ინფორმაციისთვის იხილეთ www.xbox.com/status.</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3444_14266_506137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move selected items to another location for long term storage.</descrip></descripGrp><ntig><termGrp><term id="14266">archive</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506137">დაარქივება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34440_1991550_2916788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that applications must display when Xbox privacy and online settings prevent the sharing of video status.</descrip></descripGrp><ntig><termGrp><term id="1991550">The Video and Music Status setting for [gamertag1, gamertag2, gamertag3, gamertags4] is set to allow apps to show titles of videos you watch in your Xbox Live online status.</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916788">ვიდეოსა და მუსიკის სტატუსის პარამეტრები [gamertag1, gamertag2, gamertag3, gamertags4]-თვის დაყენებულია ისე, რომ აპლიკაციებისთვის დაშვებული იმ ვიდეოების სახელების ჩვენება, რომლებსაც უყურებთ Xbox Live-ის ონლაინ-სტატუსში.</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34441_1991551_2919943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that applications must display if they will serve third-party advertising and cannot contractually guarantee that they will meet the Xbox Creative Acceptance Policy (CAP) for advertising content. The need for this disclaimer will be determined contractually prior to certification, and the inability to comply should be indicated during application submission. Talk to your Developer Account Manager for additional details.</descrip></descripGrp><ntig><termGrp><term id="1991551">All content in this Application, including advertising content, is provided by [video service name].</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2919943">ამ აპლიკაციის მთელი შიგთავსია, სარეკლამო შიგთავსის ჩათვლით, მომწოდებელია [ვიდეო სერვისის სახელი].</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34442_1991552_2916787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that game titles must display when unable to establish a connection to a required non-Xbox Live server or web service. This message also applies to Xbox games on Windows Phone.</descrip></descripGrp><ntig><termGrp><term id="1991552">The [game name] service is not available. Please try again later.</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916787">[თამაშის სახელი] სერვისი მიუწვდომელია. გთხოვთ, მოგვიანებით ისევ სცადოთ.</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34443_1991553_2922298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live Arcade menu item.</descrip></descripGrp><ntig><termGrp><term id="1991553">leaderboards</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2922298">სარეიტინგო დაფები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34444_1991554_2922292"><langSet xml:lang="en-US"><descripGrp><des