:lang="en-US"><descripGrp><descrip type="definition">The set of authentication methods (NTLM, Kerberos, and Negotiate) used to provide transport-level security.</descrip></descripGrp><ntig><termGrp><term id="2296363">Integrated Windows Authentication</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507490">NTLM</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9610_2296364_507490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of authentication methods (NTLM, Kerberos, and Negotiate) used to provide transport-level security.</descrip></descripGrp><ntig><termGrp><term id="2296364">IWA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507490">NTLM</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9610_262690_507490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of authentication methods (NTLM, Kerberos, and Negotiate) used to provide transport-level security.</descrip></descripGrp><ntig><termGrp><term id="262690">NTLM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507490">NTLM</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNou