</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3715_39383_506332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key that, when pressed in combination with another key, gives the other key an alternative meaning.</descrip></descripGrp><ntig><termGrp><term id="39383">Control key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506332">CTRL კლავიში</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3715_39385_506330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key that, when pressed in combination with another key, gives the other key an alternative meaning.</descrip></descripGrp><ntig><termGrp><term id="39385">CTRL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506330">კონტროლის კლავიში</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3715_39385_506331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key that, when pressed in combination with another key, gives the other key an alternative meaning.</descrip></descripGrp><ntig><termGrp><term id="39385">CTRL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506331">CTRL</term><termNote type="geographicalUsage">GEO</termNote><t