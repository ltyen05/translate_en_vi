><ntig><termGrp><term id="1883892">დანართის გადახედვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9160_187435_1543844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page that presents a categorical view of select Help content that the user can browse. Depending on the edition, multiple How Do I pages might be available for use.</descrip></descripGrp><ntig><termGrp><term id="187435">How do I</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1543844">როგორ გავაკეთო</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9169_32178_506272"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A font display technology that dramatically improves font display resolution so that letters on the computer screen appear smooth, not jagged. ClearType dramatically improves the readability of text on color LCD monitors with a digital interface, such as those found in laptops and high-quality flat-panel desktop displays.</descrip></descripGrp><ntig><termGrp><term id="32178">ClearType</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506272">ClearType</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="917_264897_507523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that enables users to send and receive business card information digitally and shares data storage with Outlook.</descrip></descripGrp><ntig><termGrp><term id="264897">Microsoft Office InterConnect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507523">Microsoft Office InterConnect</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9201_185833_3014348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common menu item that enables the user to select how the contents of the current program are displayed.</descrip></descripGrp><ntig><termGrp><term id="185833">View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014348">ხედი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9204_494727_2855411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI container that docks to a pane, can be part of a panel group, and is represented by a tab.</descrip></descripGrp><ntig><termGrp><term id="494727">panel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2855411">პანელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9206_85254_1888877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A space that is used to prevent multiple words from breaking if they fall at the end of a line.</descrip></descripGrp><ntig><termGrp><term id="85254">nonbreaking space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1888877">უწყვეტი შორისი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9219_88069_1223932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain controller that has been assigned one or more special roles in an Active Directory domain.</descrip></descripGrp><ntig><termGrp><term id="88069">operations master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1223932">operations master კონტროლერი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="922_1177130_506311"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process for removing redundant data from a digital media file or stream to reduce its size or the bandwidth used.</descrip></descripGrp><ntig><termGrp><term id="1177130">data compaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506311">შეკუმშვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="922_37103_506311"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process for removing redundant data from a digital media file or stream to reduce its size or the bandwidth used.</descrip></descripGrp><ntig><termGrp><term id="37103">compression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506311">შეკუმშვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9221_141157_1888938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fundamental data type that holds double-precision floating-point numbers. It's stored as a 64-bit number ranging in value from approximately -1.797E308 to -4.940E-324 (negative), from 4.94E-324 to 1.797E308 (positive), and 0.</descrip></descripGrp><ntig><termGrp><term id="141157">Double data type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1888938">ორმაგი მონაცემების ტიპი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9238_116710_506838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A precompiled collection of SQL statements and optional control-of-flow statements stored under a name and processed as a unit. They are stored in an SQL database and can be run with one call from an application.</descrip></descripGrp><ntig><termGrp><term id="116710">stored procedure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506838">ჩაწერილი პროცედურა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9239_145825_1223933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A worksheet view that displays the areas to be printed and the locations of page breaks. The area to be printed is displayed in white, automatic page breaks appear as dashed lines, and manual page breaks appear as solid lines.</descrip></descripGrp><ntig><termGrp><term id="145825">page break preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1223933">გვერდის წყვეტის გადახედვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9241_558509_1223934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of software functionality designed to solve a specific problem or to provide a new functionality to the user.</descrip></descripGrp><ntig><termGrp><term id="558509">feature</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1223934">ფუნქცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9242_143427_507027"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that stores hyperlink addresses.</descrip></descripGrp><ntig><termGrp><term id="143427">hyperlink field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507027">ბმულის ველი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9248_268851_507539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Files that are used to help detect harmful or unwanted software and to prevent it from installing or running on your computer.</descrip></descripGrp><ntig><termGrp><term id="268851">definitions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507539">განსაზღვრებები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9255_298014_507625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button on the message toolbar that compares the names in the To, Cc, and Bcc boxes against the names in the Address Book and against those contact folders that you've specified as Outlook Address Books.</descrip></descripGrp><ntig><termGrp><term id="298014">Check Names</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507625">სახელების შემოწმება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9260_321121_507852"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user interface element that provides users with a quick and easy way to navigate across a large group of opened Web pages by providing the user with a visual representation of all of the opened thumbnails. Through this visualization, the user can easily spot and select a desired thumbnail.</descrip></descripGrp><ntig><termGrp><term id="321121">Quick Tabs</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507852">სწრაფი ჩანართები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9273_144584_507035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A "document that contains a set of separate files or subdocuments.</descrip></descripGrp><ntig><termGrp><term id="144584">master document</term><termNote type="partOfSpeech">Noun</termNote><termNote type="g