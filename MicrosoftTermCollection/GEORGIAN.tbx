hin a graphical user interface that when clicked remains "down" (appearing to be pressed) until it is clicked again.</descrip></descripGrp><ntig><termGrp><term id="149234">toggle button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2770352">გადართვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11305_149234_507073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An on/off control within a graphical user interface that when clicked remains "down" (appearing to be pressed) until it is clicked again.</descrip></descripGrp><ntig><termGrp><term id="149234">toggle button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507073">გადამრთველი ღილაკი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11305_2766794_2770352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An on/off control within a graphical user interface that when clicked remains "down" (appearing to be pressed) until it is clicked again.</descrip></descripGrp><ntig><termGrp><term id="2766794">toggle switch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2770352">გადართვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech