</ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3032857">სკოლის მონაცემთა სინქრონიზაცია (კლასიკური)</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53227_3031838_3032856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The device marketplace in the Microsoft Teams Admin Center that drives discovery and adoption of Teams devices from Teams Admin Center marketplace.</descrip></descripGrp><ntig><termGrp><term id="3031838">Microsoft Teams device store</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3032856">Microsoft Teams-ის მოწყობილობის საცავი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53235_3033414_3034060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The simulator for ARDK head-mounted displays that runs on Windows PCs and requires a physical + connected Samsung phone.</descrip></descripGrp><ntig><termGrp><term id="3033414">ARDK Simulator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3034060">ARDK-ის სიმულატორი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53236_3033415_3034059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application for ARDK users that provides the software platform for ARDK features like hand tracking and eye tracking.</descrip></descripGrp><ntig><termGrp><term id="3033415">ARDK Platform</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3034059">ARDK-ის პლატფორმა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53237_3033416_3034058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application for ARDK users that hosts the system UI, including the application launcher, dock, and task bar.</descrip></descripGrp><ntig><termGrp><term id="3033416">ARDK Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3034058">ARDK-ის საწყისი გვერდი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53238_3033417_3034056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application for ARDK users to calibrate their eyes for the eye tracker.</descrip></descripGrp><ntig><termGrp><term id="3033417">ARDK Eye Calibration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3034056">ARDK-ის თვალის დაკალიბრება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53246_3033423_3034057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone application that allows users to submit feedback from their Samsung phone about a problem with their ARDK head-mounted display.</descrip></descripGrp><ntig><termGrp><term id="3033423">ARDK Feedback</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3034057">ARDK-ში გამოხმაურება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53247_3033521_3036025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UK bank holiday celebrated on June 3, 2022 to commemorate the 70th anniversary of Queen Elizabeth II's accession to the throne.</descrip></descripGrp><ntig><termGrp><term id="3033521">Platinum Jubilee Bank Holiday</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3036025">პლატინის საიუბილეო საყოველთაო დღესასწაული</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5325_145206_507038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To minimize the duplication of information in a relational database through effective table d