Entry id="56464_3173993_3174596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option available in Designer that makes an image or photograph look like a flat illustration, with clean lines, bold color palettes, and absence of gradients, shadows, or textures.</descrip></descripGrp><ntig><termGrp><term id="3173993">flat illustration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3174596">ბრტყელი ილუსტრაცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56466_3173995_3174594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option available in Designer that makes an image or photograph look like a whimsical doodle expressed through wandering lines and shapes, exuding spontaneity and intricacy.</descrip></descripGrp><ntig><termGrp><term id="3173995">doodle art</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3174594">ნახატების ხელოვნება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56467_3173996_3174597"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option available in Designer that makes an image or photograph look like folk art with a modern twist, combining hints of cultural traditions, heritages, and beliefs, with vibrant colors, patterns, and motifs.</descrip></descripGrp><ntig><termGrp><