ure that surfaces suggestions to modify repetitive patterns within a document.</descrip></descripGrp><ntig><termGrp><term id="2655585">Flash Edit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2657078">რედაქტირების შეთავაზება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47163_2655663_2657079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cross-Office feature that intelligently surfaces feature and design recommendations based on an individual user’s actions and content.</descrip></descripGrp><ntig><termGrp><term id="2655663">Ideas</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2657079">იდეები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47202_2657122_2658401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A functionality that allows users to perform actions on an email directly from their message list.</descrip></descripGrp><ntig><termGrp><term id="2657122">quick action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2658401">სწრაფი მოქმედება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatic