grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22373_1043951_2699220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of adding a digital signature to source code and applications published on the Internet. Code signing is intended to provide a level of security and trust to Internet software distribution.</descrip></descripGrp><ntig><termGrp><term id="1043951">code signing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2699220">კოდის ხელმოწერა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22388_1044098_1522290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To apply a marker to content or items (like photos or text) to identify certain types of information.</descrip></descripGrp><ntig><termGrp><term id="1044098">tag</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1522290">იარლიყის დადება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22433_1044556_1770559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A COM-based multimedia platform and infrastructure for digital media in Microsoft Windows. It focuses on content protection, audio and video quality, and interoperability for digital rights management (DRM).</descrip></descripGrp><ntig><termGrp><term id="1044556">Microsoft