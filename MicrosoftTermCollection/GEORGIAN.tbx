ig><termGrp><term id="3160600">Discover</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3161531">Discover არხი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56210_3160601_3161537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams app that allows users to create, view, and edit contacts.</descrip></descripGrp><ntig><termGrp><term id="3160601">People</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3161537">ხალხი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56221_3161267_3164784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2024 version of Microsoft Office Home and Business.</descrip></descripGrp><ntig><termGrp><term id="3161267">Microsoft Office Home and Business 2024</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3164784">სახლისა და ბიზნესის Microsoft Office 2024</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56222_3161268_3164783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2024 version of Microsoft Office designed for home.</descrip></descripGrp><ntig><termGrp><term id="3161268">Microsoft Office Home 2024</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3164783">სახლის Microsoft Office 2024</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56224_3161604_3162778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within the inline editing canvas of Designer in Copilot where you can select an object and AI highlights the color to make the object pop and then mutes the color of the rest of the image.</descrip></descripGrp><ntig><termGrp><term id="3161604">color pop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3162778">კაშკაშა ფერი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56225_3161605_3162782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Pixel art images are built using pixels as the only building blocks.</descrip></descripGrp><ntig><termGrp><term id="3161605">pixel art</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3162782">პიქსელის ხელოვნება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56226_3161606_3162785"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that makes an image or photograph look like a watercolor painting.</descrip></descripGrp><ntig><termGrp><term id="3161606">watercolor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3162785">აკვარელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56227_3161607_3162776"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Block print technique involves carving a design into wood or linoleum and using that block to print the design onto paper or fabric.</descrip></descripGrp><ntig><termGrp><term id="3161607">block print</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3162776">ბლოკპრინტი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56228_3161608_3162784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Steampunk images often combine elements of the Victorian era with futuristic technology, including gears, cogs, brass, and steam-powered machinery.</descrip></descripGrp><ntig><termGrp><term id="3161608">steampunk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3162784">ორთქლის პანკი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56229_3161609_3162777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Claymation images use movable clay characters and are often seen in children's films and cartoons.</descrip></descripGrp><ntig><termGrp><term id="3161609">claymation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3162777">თიხის ანიმაცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56230_3161610_3162774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Art deco images often blends modernity and luxury, creating a glamorous style.</descrip></descripGrp><ntig><termGrp><term id="3161610">art deco</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3162774">არტ-დეკო</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56231_3161611_3162779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Low poly images use a limited number of polygons to represent shapes and are characterized by their simplicity and geometric shapes.</descrip></descripGrp><ntig><termGrp><term id="3161611">low poly</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3162779">დაბალპოლიგონალური</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56232_3161612_3162781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Origami style is characterized by its minimalism, geometric shapes and creativity.</descrip></descripGrp><ntig><termGrp><term id="3161612">origami</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3162781">ორიგამი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56233_3161613_3162783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to take 1-2 images/photos and select a style or type a prompt and have your images combined and reimagined, generating an image with a new style.</descrip></descripGrp><ntig><termGrp><term id="3161613">restyle image</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3162783">ნახატის სტილის შეცვლა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56242_3161706_3166242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-powered feature that determines and selects the optimized view of each person in a meeting room by comparing multiple video sources, such as laptop and room cameras, and selecting the best video view.</descrip></descripGrp><ntig><termGrp><term id="3161706">automatic camera switching​</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3166242">კამერის ავტომატური გადართვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56243_3161707_3162478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The AI-powered service in Microsoft Viva that helps individuals track and grow their key job skills, and helps organizations grow and manage talent.</descrip></descripGrp><ntig><termGrp><term id="3161707">Skills in Viva</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber