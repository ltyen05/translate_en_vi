04762_2323177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables Office365 users to recognize a colleague by sending praise to them and their managers.</descrip></descripGrp><ntig><termGrp><term id="2304762">Praise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2323177">მადლობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39558_2305081_2785745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a record of transactions or activities that take place on a computer system.</descrip></descripGrp><ntig><termGrp><term id="2305081">log</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2785745">ჩანაწერის გაკეთება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39561_2305122_2329634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sliding panel menu, used to navigate between major modules of an application, that remains hidden until invoked by the user.</descrip></descripGrp><ntig><termGrp><term id="2305122">navigation drawer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2329634">ნავიგაციის პანელი</term><termNote type="geographicalUsage">GEO</termNote><t