9560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual summary of appointment or meeting information, which is displayed in a callout without opening the item.</descrip></descripGrp><ntig><termGrp><term id="1644639">calendar item peek</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889560">კალენდრის ელემენტების მაჩვენებელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32262_1644650_1889561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual summary of the user's daily schedule, which is displayed in a callout without switching to the Calendar module.</descrip></descripGrp><ntig><termGrp><term id="1644650">Calendar peek</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889561">კალენდრის მაჩვენებელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32263_1644654_1889562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual summary of the user's task list, which is displayed in a callout without switching to the Tasks module.</descrip></descripGrp><ntig><termGrp><term id="1644654">Tasks peek</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889562">დავალებების მაჩვენებელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32264_1707462_1889642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tab in the Backstage view where users can manage their identities and services, view licensing details, and link to account management features.</descrip></descripGrp><ntig><termGrp><term id="1707462">Account</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889642">ანგარიში</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32265_1644676_1889564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part that performs a search using a customizable query and presents the results in a custom view.</descrip></descripGrp><ntig><termGrp><term id="1644676">Content Search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1889564">შიგთავსის ძიება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32266_1644677_1889565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-level view in Visual Designer that shows the stages of a SharePoint workflow, rather than individual actions or conditions.</descrip><