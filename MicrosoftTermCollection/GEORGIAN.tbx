ech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6753_268842_507535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A temporary network used for sharing files or an Internet connection. In an ad hoc network, computers and devices are connected directly to each other instead of to a hub or router.</descrip></descripGrp><ntig><termGrp><term id="268842">ad hoc network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507535">ad-hoc ქსელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6753_268842_507536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A temporary network used for sharing files or an Internet connection. In an ad hoc network, computers and devices are connected directly to each other instead of to a hub or router.</descrip></descripGrp><ntig><termGrp><term id="268842">ad hoc network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507536">ერთთანრიგიანი ქსელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6753_268843_507535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A temporary network used for sharing files or an Internet connection. In an ad hoc network, computers and de