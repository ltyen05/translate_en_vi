ies connection requests to IEEE 802.3 wired Ethernet networks or IEEE 802.11 wireless networks.</descrip></descripGrp><ntig><termGrp><term id="266837">802.1X</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507532">802.1X</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3556_266837_507533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Institute of Electrical and Electronics Engineers (IEEE) standard that defines port-based network access control which either allows or denies connection requests to IEEE 802.3 wired Ethernet networks or IEEE 802.11 wireless networks.</descrip></descripGrp><ntig><termGrp><term id="266837">802.1X</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507533">IEEE 802.1x უსაფრთხოების სტანდარტი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3556_266838_507385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Institute of Electrical and Electronics Engineers (IEEE) standard that defines port-based network access control which either allows or denies connection requests to IEEE 802.3 wired Ethernet networks or IEEE 802.11 wireless networks.</descrip></descripGrp><ntig><termGrp><term id="266838">IEEE 802.1X security standard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</te