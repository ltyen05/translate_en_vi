></termGrp></ntig></langSet></termEntry><termEntry id="12872_1790611_2021493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To be unresponsive.</descrip></descripGrp><ntig><termGrp><term id="1790611">stop responding</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2021493">რეაგირების შეწყვეტა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12874_276553_1223309"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool for accessing right-click menus and targeting small pieces of the interface using touch input.</descrip></descripGrp><ntig><termGrp><term id="276553">touch pointer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1223309">შეყვანის სენსორი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12884_1939_1223973"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application of the Standard Generalized Markup Language that uses tags to mark elements, such as text and graphics, in a document to indicate how Web browsers should display these elements to the user and should respond to user actions.</descrip></descripGrp><ntig><termGrp><term id="1939">HTML</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><ter