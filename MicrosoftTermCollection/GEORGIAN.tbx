blish their Windows Live account. This separation allows users to disclose or conceal personal information as they choose.</descrip></descripGrp><ntig><termGrp><term id="763878">profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1522272">Windows Live პროფილი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21015_2392175_3104294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email address to which password reset information can be sent if a customer forgets the password portion of their Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2392175">alternate email address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3104294">ალტერნატიული ელფოსტა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21015_3103949_3104294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email address to which password reset information can be sent if a customer forgets the password portion of their Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="3103949">alternate email</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3104294">ალტერნატიული ელფოსტა</term><termNote type="geographicalUs