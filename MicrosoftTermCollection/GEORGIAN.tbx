</langSet></termEntry><termEntry id="22492_1045783_1224230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A troubleshooter that performs common maintenance tasks in Windows, such as cleaning up unused files and shortcuts.</descrip></descripGrp><ntig><termGrp><term id="1045783">Maintenance troubleshooter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224230">სისტემაზე ზრუნვის პრობლემათა გადაჭრა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22493_1045790_1224231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A troubleshooter that helps find and fix problems about hardware and devices.</descrip></descripGrp><ntig><termGrp><term id="1045790">Hardware and Devices troubleshooter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224231">აპარატურის და მოწყობილობის პრობლემათა გადაჭრა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2250_527637_1802631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a process, tool, etc. that is enabled by Windows Live.</descrip></descripGrp><ntig><termGrp><term id="527637">powered by Windows Live</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term i