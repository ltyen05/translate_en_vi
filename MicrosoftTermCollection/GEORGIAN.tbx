OUBLE QUOTATION MARK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507825">შემოსილი ბრჭყალის გახსნა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43879_2473454_2480433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Holograms app that allows the user to input text and have that text become a hologram that they can place in their space. User inputs text to make a holographic label.</descrip></descripGrp><ntig><termGrp><term id="2473454">holographic label maker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2480433">ჰოლოგრაფიული წარწერის შემქმნელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43880_2473560_2480435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Microsoft HoloLens hardware and software released for developers.</descrip></descripGrp><ntig><termGrp><term id="2473560">Microsoft HoloLens Development Edition</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2480435">Microsoft HoloLens Development Edition</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><t