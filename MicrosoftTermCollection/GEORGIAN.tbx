რელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38866_2259535_2262637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The variable default lock screen image that shows beautiful images on lock combined with hotspots containing fun facts, Windows tips/trick, and more. Users can switch from this default lock screen to a personal picture.</descrip></descripGrp><ntig><termGrp><term id="2259535">Windows spotlight</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2262637">Windows პროჟექტორი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38879_2259611_2435791"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a shortcut to an application or part of an application or contact by fixing its tile to the Start screen (the full screen view of Start) or Start menu.</descrip></descripGrp><ntig><termGrp><term id="2259611">pin to Start</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2435791">დაწყებაში ჩამაგრება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3888_25223_506209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication line used for data transfer among the components of a computer system.</descrip></descripGrp><ntig><termGrp><term id="25223">bus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506209">სალტე</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38880_2259632_2262626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Windows Store for Business and Education Store, to get apps and other digital goods into the hands of employees or students.</descrip></descripGrp><ntig><termGrp><term id="2259632">distribute</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2262626">დისტრიბუცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38882_2259634_2262628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets customers extend their gaming experience across multiple devices, play with other users, and show off scores and achievements.</descrip></descripGrp><ntig><termGrp><term id="2259634">game hub</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2262628">თამაშების ცენტრი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38883_2259635_2262629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default browser in Windows 10, which provides a more interoperable, reliable, and discoverable experience with advanced features including the ability to annotate on web pages, a distraction-free reading experience, and integration of Cortana. Also available on iOS and Android.</descrip></descripGrp><ntig><termGrp><term id="2259635">Microsoft Edge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2262629">Microsoft Edge</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38884_2259636_2262631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The source location of files that are stored on OneDrive and not synced to the local device. This is different from other OneDrive files (just called "OneDrive"), where a copy is synced and stored locally as well as in the cloud.</descrip></descripGrp><ntig><termGrp><term id="2259636">OneDrive (cloud only)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2262631">OneDrive (მხოლოდ ღრუბლოვანი)</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38885_2259637_2262632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user role within Windows Store for Business that allows the user to acquire apps from Windows Store for Business on behalf of his company.</descrip></descripGrp><ntig><termGrp><term id="2259637">purchaser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2262632">შემსყიდველი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38886_2259638_2262633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of a set of photos that displays them one at a time, sequentially.</descrip></descripGrp><ntig><termGrp><term id="2259638">slideshow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2262633">სლაიდ-შოუ</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38887_2259809_2262630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section in the Settings app for Windows 10 desktop, containing network and Internet settings.</descrip></descripGrp><ntig><termGrp><term id="2259809">Network &amp; Internet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2262630">ქსელი და ინტერნეტი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">