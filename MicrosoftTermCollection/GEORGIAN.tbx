on goes both ways.</descrip></descripGrp><ntig><termGrp><term id="2569599">2-way binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2574709">2-ნაირი მიბმა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45585_2569600_2574716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove association from two or more pieces of information.</descrip></descripGrp><ntig><termGrp><term id="2569600">unbind</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2574716">დაშლა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45586_2569602_2582994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft-owned company that has created the world's largest professional network on the Internet.</descrip></descripGrp><ntig><termGrp><term id="2569602">LinkedIn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2582994">LinkedIn</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45587_2569603_2577457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect that makes an image appear as if drawn with a pencil.</descrip></descripGrp><ntig><termGrp><term id="2569603">pencil effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2577457">ფანქრის ეფექტი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45589_2570254_2913858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app in Office 365 Education SKUs that provides data aggregation, analytics, dashboards, and reporting to education personas (Students, Teachers, Parents, System Administrator, and IT).</descrip></descripGrp><ntig><termGrp><term id="2570254">Microsoft Education Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2913858">საგანმანათლებლო ანალიტიკა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45589_2570254_2913870"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app in Office 365 Education SKUs that provides data aggregation, analytics, dashboards, and reporting to education personas (Students, Teachers, Parents, System Administrator, and IT).</descrip></descripGrp><ntig><termGrp><term id="2570254">Microsoft Education Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote>