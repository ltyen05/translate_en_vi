</ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1655946">CryptoAPI 2.0</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30512_1516655_1655940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension that indicates where the certificate revocation list for a CA can be retrieved. It can contain none, one, or many HTTP, file, or LDAP URLs.</descrip></descripGrp><ntig><termGrp><term id="1516655">certificate revocation list distribution point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1655940">CDP</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30512_1516655_1655942"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension that indicates where the certificate revocation list for a CA can be retrieved. It can contain none, one, or many HTTP, file, or LDAP URLs.</descrip></descripGrp><ntig><termGrp><term id="1516655">certificate revocation list distribution point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1655942">სერთიფიკატის გაუქმების სიის გავრცელების წერტილი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30512_1516656_1655940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension that indicates where the certificate revocation list for a CA can be retrieved. It can contain none, one, or many HTTP, file, or LDAP URLs.</descrip></descripGrp><ntig><termGrp><term id="1516656">CDP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1655940">CDP</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30512_1516656_1655942"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension that indicates where the certificate revocation list for a CA can be retrieved. It can contain none, one, or many HTTP, file, or LDAP URLs.</descrip></descripGrp><ntig><termGrp><term id="1516656">CDP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1655942">სერთიფიკატის გაუქმების სიის გავრცელების წერტილი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30513_1516657_1655965"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a public key infrastructure hierarchy, the certification authority that that issues certificates to users and computers.</descrip></descripGrp><ntig><termGrp><term id="1516657">issuing certification authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1655965">გამცემი CA</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30513_1516657_1655966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a public key infrastructure hierarchy, the certification authority that that issues certificates to users and computers.</descrip></descripGrp><ntig><termGrp><term id="1516657">issuing certification authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1655966">გამცემი სერთიფიცირების ცენტრი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30513_1516658_1655965"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a public key infrastructure hierarchy, the certification authority that that issues certificates to users and computers.</descrip></descripGrp><ntig><termGrp><term id="1516658">issuing CA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1655965">გამცემი CA</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30513_1516658_1655966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a public key infrastructure hierarchy, the certification authority that that issues certificates to users and computers.</descrip></descripGrp><ntig><termGrp><term id="1516658">issuing CA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1655966">გამცემი სერთიფიცირების ცენტრი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30517_1516667_1656017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A configuration mode for the Certificate Enrollment Web Service in which it will only process renewal requests.</descrip></descripGrp><ntig><termGrp><term id="1516667">renewal only mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1656017">მხოლოდ განახლების რეჟიმი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30520_1516672_1656065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hexadecimal string that contains the SHA-1 hash of the certificate.</descrip></descripGrp><ntig><termGrp><term id="1516672">thumbprint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1656065">ანაბეჭდი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30553_1517506_1698039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Server Manager and Event Viewer, the urgency of an event or error condition, system fault, failure, or action by either the system or the user. Severity can be any of four industry-standard values: Information, Warning, Error, or Critical. These values are defined in the Event Viewer Help.</descrip></descripGrp><ntig><termGrp><term id="1517506">severity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1698039">სიმწვავე</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3056_1738272_506031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that acts as a source of information or signals. The host computer provides services, such as news, mail, or data, to computers that connect to it. The term can refer to almost any kind of computer, from a centralized mainframe that is a host to its terminals, to a server that is host to its clients, to a desktop PC that is host to its devices, such as printers and scanners.</descrip></descripGrp><ntig><termGrp><term id="1738272">host computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506031">საკვანძო კომპიუტერი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3056_1770_506031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that acts as a source of information or signals. The host computer provides services, such as news, mail, or data, to computers that connect to it. The term can refer to almost any kind of computer, from a centralized mainframe that is a host to its terminals, to a server that is host to its clients, to a desktop PC that is host to its devices, such as printers and scanners.</descrip></descripGrp><ntig><termGrp><term id="1770">host</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506031">საკვანძო კომპიუტერი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3058_71776_506559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pointing device used mainly but not exclusively for computer games. A joystick has a base, on which control buttons can be mounted, and a vertical stem, which the user can move in any direction to control the movement of an object on the screen.</descrip></descripGrp><ntig><termGrp><term id="71776">joystick</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506559">ჯოისტიკი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30589_1517629_1655941"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that builds one or more certificate paths. The certificate paths may or may not trace up to a self-signed or root certificate.</descrip></descripGrp><ntig><termGrp><term id="1517629">certificate chaining</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1655941">სერთიფიკატის ჯაჭვი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30590_1517630_1655913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension used by the certificate chaining engine to determine what certificate was used to sign a presented certificate. The AKI can contain the issuer name, serial number, public key information, or no information at all. By matching the information in a certificate’s AKI extension to a CA certificate’s Subject Key Identifier (SKI) extension, a certificate chain can be built.</descrip></descripGrp><ntig><termGrp><term id="1517630">Authority Key Identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1655913">AKI</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30590_1517630_1655924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension used by the certificate chaining engine to determine what certificate was used to sign a presented certificate. The AKI can contain the issuer name, serial number, public key information, or no information at all. By matching the information in a certificate’s AKI extension to a CA certificate’s Subject Key Identifier (SKI) extension, a certificate chain can be built.</descrip></descripGrp><ntig><termGrp><term id="1517630">Authority Key Identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1655924">სერთიფიცირების ცენტრის გასაღების იდენტიფიკატორი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30590_1517631_1655913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension used by the certificate chaining engine to determine what certificate was used to sign a presented certificate. The AKI can contain the issuer name, serial number, public key information, or no information at all. By matching the information in a certificate’s AKI extension to a CA certificate’s Subject Key Identifier (SKI) extension, a certificate chain can be built.</descrip></descripGrp><ntig><termGrp><term id="1517631">AKI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1655913">AKI</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30590_1517631_1655924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension used by the certificate chaining engine to determine what certificate was used to sign a presented certificate. The AKI can contain the issuer name, serial number, public key information, or no information at all. By matching the information in a certificate’s AKI extension to a CA certificate’s Subject Key Identifier (SKI) extension, a certificate chain can be built.</descrip></descripGrp><ntig><termGrp><term id="1517631">AKI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1655924">სერთიფიცირების ცენტრის გასაღების იდენტიფიკატორი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3060_87569_506686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In reference to one or more computers, connected to a network.</descrip></descripGrp><ntig><termGrp><term id="87569">online</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506686">ონლაინი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3061_147916_1888987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark that shows where a deletion, insertion, or other editing change has been made in a document.</descrip></descripGrp><ntig><termGrp><term id="147916">revision mark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1888987">ცვლილების ნიშანი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3065_142836_507023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that transforms a picture stored in one file format to another format so that it can be displayed in a specific graphics program.</descrip></descripGrp><ntig><termGrp><term id="142836">graphic filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507023">გრაფიკული ფილტრი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3065_142836_507024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that transforms a picture stored in one file format to another format so that it can be displayed in a specific graphics program.</descrip></descripGrp><ntig><termGrp><term id="142836">graphic filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507024">გრაფიკების ფილტრი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3065_142837_507023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that transforms a picture stored in one file format to another format so that it can be displayed in a specific graphics program.</descrip></descri