te></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224080">ექსპოზიციის მარეგულირებელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19729_1309629_1883897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When a ribbon is divided into multiple views, any one of the views. Every tab contains functionally related commands and other controls that are organized in groups. Typically, ribbon tabs are labeled.</descrip></descripGrp><ntig><termGrp><term id="1309629">ribbon tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1883897">ლენტის ჩანართი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1975_73133_506573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A designation used to conduct sorting or searching operations.</descrip></descripGrp><ntig><termGrp><term id="73133">keyword</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506573">საკვანძო სიტყვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19767_674770_2855424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rating unit, e.g. assigning a "one-star rating" to an image.</descrip></descripGrp><ntig><termGrp><term id="674770">star</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2855424">ვარსკვლავი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1978_45320_506375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enter numbers on a device, such as telephone or mobile, in order to make a phone call.</descrip></descripGrp><ntig><termGrp><term id="45320">dial</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506375">დარეკვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19780_2466458_2469395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The audio effect ​that creates the perception that there are many more sources of sound then are currently present. This is a well-known and industry term for the technique of creating a surround sound experience for users listening to audio with regular stereo headphones.</descrip></descripGrp><ntig><termGrp><term id="2466458">virtual surround sound</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2469395">ვირტუალური გარემოს ხმა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpee