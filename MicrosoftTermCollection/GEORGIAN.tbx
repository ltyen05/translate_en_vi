 of attackers.</descrip></descripGrp><ntig><termGrp><term id="3013004">extended detection and response</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014355">გაფართოებული გამოვლენა და რეაგირება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53006_3013004_3014372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cybersecurity approach defined by industry analysts and designed to deliver intelligent, automated, and integrated security across domains to help defenders connect seemingly disparate alerts and get ahead of attackers.</descrip></descripGrp><ntig><termGrp><term id="3013004">extended detection and response</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014372">XDR</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53006_3013005_3014355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cybersecurity approach defined by industry analysts and designed to deliver intelligent, automated, and integrated security across domains to help defenders connect seemingly disparate alerts and get ahead of attackers.</descrip></descripGrp><ntig><termGrp><term id="3013005">XDR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014355">გაფართოებული გამოვლენა და რეაგირება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53006_3013005_3014372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cybersecurity approach defined by industry analysts and designed to deliver intelligent, automated, and integrated security across domains to help defenders connect seemingly disparate alerts and get ahead of attackers.</descrip></descripGrp><ntig><termGrp><term id="3013005">XDR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014372">XDR</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53007_3013006_3014356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common user identity for authentication and authorization to all resources, regardless of location.</descrip></descripGrp><ntig><termGrp><term id="3013006">hybrid identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014356">ჰიბრიდული იდენტობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53008_3013008_3014362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram used to visually organize information, showing relationships among pieces of the whole.</descrip></descripGrp><ntig><termGrp><term id="3013008">mind map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014362">ორგანიზების რუკა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53009_3013009_3014352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prevent a person's identity from being connected with information pertaining to him/her.</descrip></descripGrp><ntig><termGrp><term id="3013009">de-identify</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014352">დეიდენტიფიცირება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53010_3013010_3014353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A constraint on the algorithms used to publish aggregate information about a statistical database which limits the privacy impact on individuals whose information is in the database.</descrip></descripGrp><ntig><termGrp><term id="3013010">differential privacy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3014353">დიფერენციალური კონფიდენციალურობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5303_76437_2998845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In mathematics, the power to which a base must be raised to equal a given number. For example, for the base 10, the logarithm of 16 is (approximately) 1.2041 because 101.2041 equals (approximately) 16. Both natural logarithms (to the base e, which is approximately 2.71828) and common logarithms (to the base 10) are used in programming. Languages such as C and Basic include functions for calculating natural logarithms.</descrip></descripGrp><ntig><termGrp><term id="76437">logarithm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2998845">ლოგარითმი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53031_3014789_3059644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure offering that supports Azure Virtual Desktop on Azure Stack HCI.</descrip></descripGrp><ntig><termGrp><term id="3014789">Azure Virtual Desktop on Azure Stack HCI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3059644">Azure Virtual Desktop - Azure Stack HCI</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53031_3014789_3059648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure offering that supports Azure Virtual Desktop on Azure Stack HCI.</descrip></descripGrp><ntig><termGrp><term id="3014789">Azure Virtual Desktop on Azure Stack HCI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3059648">Virtual Desktop on Azure Stack HCI</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53031_3014793_3059644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure offering that supports Azure Virtual Desktop on Azure Stack HCI.</descrip></descripGrp><ntig><termGrp><term id="3014793">Virtual Desktop on Azure Stack HCI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3059644">Azure Virtual Desktop - Azure Stack HCI</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53031_3014793_3059648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure offering that supports Azure Virtual Desktop on Azure Stack HCI.</descrip></descripGrp><ntig><termGrp><term id="3014793">Virtual Desktop on Azure Stack HCI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3059648">Virtual Desktop on Azure Stack HCI</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53033_3014851_3016766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Teams feature (available in the Store) that allows users to create workflows.</descrip></descripGrp><ntig><termGrp><term id="3014851">Workflows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3016766">სამუშაო პროცესები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53034_3014860_3088252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advanced endpoint security solution optimized for small- and medium-sized businesses.</descrip></descripGrp><ntig><termGrp><term id="3014860">Microsoft Defender for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3088252">Microsoft Defender ბიზნესისთვის</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53034_3014860_3179559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advanced endpoint security solution optimized for small- and medium-sized businesses.</descrip></descripGrp><ntig><termGrp><term id="3014860">Microsoft Defender for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3179559">Defender ბიზნესისთვის</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53034_3178799_3088252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advanced endpoint security solution optimized for small- and medium-sized businesses.</descrip></descripGrp><ntig><termGrp><term id="3178799">Defender for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3088252">Microsoft Defender ბიზნესისთვის</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53034_3178799_3179559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advanced endpoint security solution optimized for small- and medium-sized businesses.</descrip></descripGrp><ntig><termGrp><term id="3178799">Defender for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3179559">Defender ბიზნესისთვის</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53035_3014861_3016757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program for nonprofit organizations with the goal of enhancing their security protections and capacity that will include notification in the event of a nation-state attack or compromise and free security assessments to help them understand and action their security vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="3014861">Security Program for Nonprofits</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3016757">არაკომერციული ორგანიზაციების უსაფრთხოების პროგრამა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53036_3014863_3016731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collaborative web-app (MetaOS-based) which lets Office.com users convert Word/Excel/PowerPoint documents to PDF format.</descrip></descripGrp><ntig><termGrp><term id="3014863">PDF Tools</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3016731">PDF-ის ხელსაწყოები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53037_3014864_3016632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A paid feature within the Microsoft 365 admin center that enables admins to do fast, at-scale point-in-time restore across OneDrive, SharePoint, and Exchange in Microsoft 365, beyond our default retention limits.</descrip></descripGrp><ntig><termGrp><term id="3014864">enhanced restore</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3016632">ოპტიმალური აღდგენა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53038_3014879_3016754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Teams that provides different experiences for attendees and presenters when joining an event/meeting. Attendees will see a waiting screen and will stay on that screen till presenters activate the event/meeting. Presenters will join the meeting in a separate space where they can prepare together before the event goes live for attendees.</descrip></descripGrp><ntig><termGrp><term id="3014879">green room</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3016754">მწვანე ოთახი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53039_3014880_3016631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The first party eCDN solution that alleviates limited corporate network downlink bandwidth to deliver high-quality video streaming and broadcasting for large audiences of employees.</descrip></descripGrp><ntig><termGrp><term id="3014880">eCDN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3016631">eCDN</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5304_232831_1223880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An add-in that stores macros, AutoText entries, and custom toolbar, menu, and shortcut key settings that you can use while you work with documents based on any template. By default, the Normal template is a global template.</descrip></descripGrp><ntig><termGrp><term id="232831">global template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1223880">გლობალური შაბლონი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53040_3014881_3016765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within Microsoft Teams Admin Center that provides a comprehensive integrated view of Microsoft Teams Rooms (MTR) together with its related devices and connected peripherals to provide reports on room health, utilization and compliance.</descrip></descripGrp><ntig><termGrp><term id="3014881">workspace management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3016765">სამუშაო სივრცის მართვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53041_3014882_3016732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PowerPoint feature that helps make your presentations more impactful through the recording of narrated videos.</descrip></descripGrp><ntig><termGrp><term id="3014882">recording studio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3016732">ჩამწერი სტუდიო</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53042_3014883_3016634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability that allows customers to see all the feedback they’ve provided about Microsoft 365 and Windows products and services, the status of that feedback, and any official responses from Microsoft about the feedback. Users can also participate in community discussion with other users by upvoting and commenting.</descrip></descripGrp><ntig><termGrp><term id="3014883">feedback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3016634">გამოხმაურება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53043_3014884_3016630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The experience designed in PowerPoint and delivered in Microsoft Teams that helps you create inclusive and engaging presentations by providing a PowerPoint user full access to seamlessly integrate and personalize their camera feed directly into their presentation prior to joining a meeting.</descrip></descripGrp><ntig><termGrp><term id="3014884">cameo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3016630">cameo</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53044_3014885_3016733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows organizations to provide secure, trusted, and auditable remote assistance for work related apps and endpoints to workers on the frontline and/or in hybrid work environments.</descrip></descripGrp><ntig><termGrp><term id="3014885">Remote Help</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3016733">დისტანციური დახმარება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53044_3014885_3161535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows organizations to provide secure, trusted, and auditable remote assistance for work related apps and endpoints to workers on the frontline and/or in hybrid work environments.</descrip></descripGrp><ntig><termGrp><term id="3014885">Remote Help</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><t