><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53718_3057912_3058465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft Teams, a one-touch experience for joining third-party online meetings.</descrip></descripGrp><ntig><termGrp><term id="3057912">one-touch join</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3058465">ერთი შეხებით გაწევრიანება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53719_3057913_3058459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in the Microsoft Teams calls app that allows users to combine calls together.</descrip></descripGrp><ntig><termGrp><term id="3057913">call merge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3058459">ზარების გაერთიანება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53720_3057914_3058462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams feature that allows users to seamlessly move their calls between different devices, such as from the laptop to a mobile phone and vice-versa, without any interruption in call service or quality.</descrip></descripGrp><ntig><termGrp><term id="3057914">endpoint transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3058462">საბოლოო პუნქტში გადაცემა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53721_3057915_3058466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conversation method that uses a button to switch a device from the voice transmission mode to the voice reception mode.</descrip></descripGrp><ntig><termGrp><term id="3057915">push-to-talk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3058466">დააჭირეთ სასაუბროდ</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53721_3057916_3058466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conversation method that uses a button to switch a device from the voice transmission mode to the voice reception mode.</descrip></descripGrp><ntig><termGrp><term id="3057916">push to talk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3058466">დააჭირეთ სასაუბროდ</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></te