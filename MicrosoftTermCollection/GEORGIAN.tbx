O</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26735_1354369_1990468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is meant to run on a desktop or laptop computer.</descrip></descripGrp><ntig><termGrp><term id="1354369">desktop application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1990468">სამაგიდე კომპიუტერის პროგრამა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26735_1505030_1990468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is meant to run on a desktop or laptop computer.</descrip></descripGrp><ntig><termGrp><term id="1505030">desktop app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1990468">სამაგიდე კომპიუტერის პროგრამა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26735_1986256_1990468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is meant to run on a desktop or laptop computer.</descrip></descripGrp><ntig><termGrp><term id="1986256">desktop program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig><