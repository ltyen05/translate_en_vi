term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1223810">სათაო მწკრივი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="965_317875_507748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To display the subentries contained within a folder or outline view.</descrip></descripGrp><ntig><termGrp><term id="317875">expand</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507748">გაშლა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9651_138544_1888923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual cue to indicate which formatting will be applied when you double-click: a left-aligned, centered, or right-aligned tab stop; a left indent; or left or right text wrapping.</descrip></descripGrp><ntig><termGrp><term id="138544">Click and Type pointer shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1888923">დააწკაპუნეთ და ჩაწერეთ მიმთითებლის ფიგურა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="965