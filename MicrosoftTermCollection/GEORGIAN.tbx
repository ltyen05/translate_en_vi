 id="3706_146703_1888979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The calendar selected in the regional settings in Windows Control Panel, or the system calendar.</descrip></descripGrp><ntig><termGrp><term id="146703">primary calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1888979">ძირითადი კალენდარი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3711_359685_1373452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marker that can be associated with content or items, such as photos or text, to identify certain types of information, and that allows users to find, view, and sort marked content.</descrip></descripGrp><ntig><termGrp><term id="359685">note tag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1373452">იარლიყი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3711_359685_508003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marker that can be associated with content or items, such as photos or text, to identify certain types of information, and that allows users to find, view, and sort marked content.</descrip></descripGrp><ntig><termGrp><term id="359685">note tag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet