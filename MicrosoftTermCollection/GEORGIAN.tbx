ripGrp><ntig><termGrp><term id="1167260">external content type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1463460">ერთეული</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10048_1167260_1463461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object (such as a customer, item, or employee) that shares a set of defined attributes or characteristics, and that is used to manage rules for data.</descrip></descripGrp><ntig><termGrp><term id="1167260">external content type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1463461">გარე შიგთავსის ტიპი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10048_51300_1463460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object (such as a customer, item, or employee) that shares a set of defined attributes or characteristics, and that is used to manage rules for data.</descrip></descripGrp><ntig><termGrp><term id="51300">entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1463460">ერთეული</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gramma