partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506379">ციფრული</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14244_115576_1979214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a transmission appear to come from a user other than the user who performed the action.</descrip></descripGrp><ntig><termGrp><term id="115576">spoof</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1979214">შენიღბვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14246_343618_1223994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagramming capability that shows charts in three dimensions.</descrip></descripGrp><ntig><termGrp><term id="343618">3-D effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1223994">სამგანზომილებიანი ეფექტი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14256_72076_506561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To adjust horizontal spacing so that text is ali