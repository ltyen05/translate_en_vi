ch">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2736062">Windows Autopilot</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45074_2908351_2736112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud deployment solution that leverages the cloud to automate the configuration of new PCs including changing default start up screens without the need of IT assistance.</descrip></descripGrp><ntig><termGrp><term id="2908351">AutoPilot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2736112">Windows Autopilot Deployment</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45074_2908351_2908921"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud deployment solution that leverages the cloud to automate the configuration of new PCs including changing default start up screens without the need of IT assistance.</descrip></descripGrp><ntig><termGrp><term id="2908351">AutoPilot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2908921">Autopilot</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45078_2543137_2545170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows, an input panel where user can insert emojis and other expressive images or symbols. When using the en-US hardware keyboard to type, user can use SPACE+ : (colon) to input emoji in an easy and smart way. Rather than having to use the mouse, user can bring up the emoji panel and search or arrow key through the options. Eventually, this panel will include stickers and other expression objects.</descrip></descripGrp><ntig><termGrp><term id="2543137">emoji panel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2545170">სიცილაკების დაფა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45086_2911839_2912547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A worker who serves as the first point of contact between companies, their customers, products, suppliers and the market and who often directly impact the customer experience and the delivery and development of products and services.</descrip></descripGrp><ntig><termGrp><term id="2911839">frontline worker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2912547">პირველი რიგის თანამშრომელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45100_2544667_2546103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to use a digital pen and make the strokes appear in pencil texture.</descrip></descripGrp><ntig><termGrp><term id="2544667">Digital Pencil</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2546103">ციფრული ფანქარი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45101_2544668_2546105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ink type that looks like pencil strokes.</descrip></descripGrp><ntig><termGrp><term id="2544668">pencil texture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2546105">ფანქრის ტექსტურა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45113_2546253_2549254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft solutions framework that brings together Office 365, Windows 10 and Enterprise Mobility + Security.</descrip></descripGrp><ntig><termGrp><term id="2546253">Microsoft 365</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2549254">Microsoft 365</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45114_2547316_2916863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conversation window that displays transcribed voice text in a game session.</descrip></descripGrp><ntig><termGrp><term id="2547316">Xbox game speech window</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916863">Xbox-ის თამაშის სასაუბრო ფანჯარა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45118_2547320_2549986"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section in the Xbox Store where developers participating in the Xbox Live Creators Program publish their games directly. The collection offers exciting and diverse games that are fun to pick up and play.</descrip></descripGrp><ntig><termGrp><term id="2547320">Creators Collection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2549986">შემქმნელთა კოლექცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45119_2547322_2916871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that opens Xbox Live to all developers allowing them to rapidly and directly publish their games on Xbox One or Windows 10 through a short and simplified certification process.</descrip></descripGrp><ntig><termGrp><term id="2547322">Xbox Live Creators Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916871">Xbox Live Creators Program</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45119_3110283_2916871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that opens Xbox Live to all developers allowing them to rapidly and directly publish their games on Xbox One or Windows 10 through a short and simplified certification process.</descrip></descripGrp><ntig><termGrp><term id="3110283">Creators Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2916871">Xbox Live Creators Program</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45119_3145078_2916871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that opens Xbox Live to all developers allowing them to rapidly and directly publish their games on Xbox One or Windows 10 through a short and simplified certification process.</descrip></descripGrp><ntig><termGrp><term id="3145078">Xbox Creators Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term