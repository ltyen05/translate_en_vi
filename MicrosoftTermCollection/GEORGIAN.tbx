5992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office service that allows users to publish documents to Docs.com with one click from Word, Excel, PowerPoint, and Sway while retaining the original formatting and animation of the document.</descrip></descripGrp><ntig><termGrp><term id="2396738">Publish to Docs.com</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2405992">Docs.com საიტზე გამოქვეყნება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42385_2397315_3037438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure workflow automation service designed to automate repetitive and time-consuming tasks by setting up a connection to access web services, files, or cloud-based data and put them to work.</descrip></descripGrp><ntig><termGrp><term id="2397315">Microsoft Flow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3037438">Power Automate</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42385_2701608_3037438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure workflow automation service designed to automate repetitive and time-consuming tasks by setting up a connection to access web services, files, or cloud-based data and put them to work.</descrip></descripGrp><ntig><termGrp><t