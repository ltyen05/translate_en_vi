term id="1797983">ბიტი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40694_2360413_2364827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A movie or TV show that can be watched instantly and in high definition.</descrip></descripGrp><ntig><termGrp><term id="2360413">instant-on HD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2364827">მყისიერი ჩართვა მაღალი გარჩევადობით</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40697_2360416_2364831"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for the music albums that are on sale in the Movie Store.</descrip></descripGrp><ntig><termGrp><term id="2360416">Music deals</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2364831">მუსიკის დეტალები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40698_2360417_2364833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category in Windows Store music section that shows the user's music in Groove Music app.</descrip></descripGrp><ntig><termGrp><term id="2360417">My music</term><termNote type="partOfSpeec