="ka"><ntig><termGrp><term id="2855415">დასწრება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="699_68675_1798006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In object-oriented programming, a language that lets a program or object written in one language communicate with another program written in an unknown language. An IDL is used to define interfaces between client and server programs. For example, an IDL can provide interfaces to remote CORBA objects.</descrip></descripGrp><ntig><termGrp><term id="68675">interface definition language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1798006">IDL</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="699_731998_1798006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In object-oriented programming, a language that lets a program or object written in one language communicate with another program written in an unknown language. An IDL is used to define interfaces between client and server programs. For example, an IDL can provide interfaces to remote CORBA objects.</descrip></descripGrp><ntig><termGrp><term id="731998">IDL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1798006">IDL</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNo