type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3030824">მორგებული განლაგება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53195_3030413_3030823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of two or more open apps or windows that can be minimized and restored in a snapped layout.</descrip></descripGrp><ntig><termGrp><term id="3030413">snap group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3030823">მორგებული ჯგუფი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53196_3030414_3030822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that appears after a user has snapped a window but still has a lot of available space on their screen and displays all other open windows as thumbnails, allowing the user to choose which other window they want to occupy the available space.</descrip></descripGrp><ntig><termGrp><term id="3030414">Snap Assist</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3030822">მორგების ასისტენტი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></t