</termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2378461">ზოგადი მდებარეობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41856_2374312_2378460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location that you can set for your device that can be used by Windows, apps, and services when an exact location isn't available, such as on a desktop PC without GPS.​ ​</descrip></descripGrp><ntig><termGrp><term id="2374312">default location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2378460">ნაგულისხმევი მდებარეობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41878_2897507_2954974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unified security platform for preventative protection, post-breach detection, automated investigation, and response.</descrip></descripGrp><ntig><termGrp><term id="2897507">Microsoft Defender for Endpoint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2954974">MDE</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41878_2897507_3088253"><langSet xml:lang="en-US"><de