that allows the user to superimpose a dot over a presentation and control its position with the mouse. The appearance of the dot is similar to that of a traditional laser pointer, and it is broadcast to all presentation viewers and can be recorded into video (Save to Video).</descrip></descripGrp><ntig><termGrp><term id="767590">Laser Pointer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224157">ლაზერული მაჩვენებელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21265_767631_1224158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that initiates an email response addressed to all of the recipients on the To or Cc lines of the original message.</descrip></descripGrp><ntig><termGrp><term id="767631">Reply to All</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224158">პასუხი ყველას</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21265_767632_1224158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that initiates an email response addressed to all of the recipients on the To or Cc lines of the original message.</descrip></descripGrp><ntig><termGrp><term id="767632">Reply All</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224158">პასუხი ყველას</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21277_768421_3051240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mode of Windows Photo Viewer which consists of a top level window displaying one photograph at a time, with navigation controls.</descrip></descripGrp><ntig><termGrp><term id="768421">Photo Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3051240">ფოტოების მნახველი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21278_768422_1224160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode of Windows Photo Viewer which displays full-screen slide shows for photos.</descrip></descripGrp><ntig><termGrp><term id="768422">Slideshow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224160">სლაიდ-შოუ</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21290_768424_1224161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recordable media (such as CD-RW) to which you can only write once without reformatting.</descrip></descripGrp><ntig><termGrp><term id="768424">single session-only disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224161">ერთსესიიანი დისკი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21291_768440_1224162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recordable media to which you can write several times without reformatting.</descrip></descripGrp><ntig><termGrp><term id="768440">multi session-capable disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224162">დისკი მრავალი სესიის შესაძლებლობით</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21299_768624_1224163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that is added to the Microsoft Office Compatibility Pack to open Word, Excel, and PowerPoint binary format files and securely convert them to the Office 2007 file formats.</descrip></descripGrp><ntig><termGrp><term id="768624">Microsoft Office Isolated Conversion Environment</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224163">MOICE</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21299_768625_1224163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that is added to the Microsoft Office Compatibility Pack to open Word, Excel, and PowerPoint binary format files and securely convert them to the Office 2007 file formats.</descrip></descripGrp><ntig><termGrp><term id="768625">MOICE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224163">MOICE</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21300_1054681_1224164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that makes Outlook auto-complete lists available through the default Exchange mailbox.</descrip></descripGrp><ntig><termGrp><term id="1054681">Suggested Contacts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224164">შეთავაზებული კონტაქტები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21301_769458_1224165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common credential store and interface that is used to save and manage user credentials, such as user names and passwords, so you can easily log on to Web sites and connect to other resources, such as computers.</descrip></descripGrp><ntig><termGrp><term id="769458">Credential Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224165">სტატუსთა მმართველი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21302_769460_1224166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of credentials that users can create, store and manage in Credential Manager.</descrip></descripGrp><ntig><termGrp><term id="769460">vault</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224166">სეიფი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21303_769462_1224167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of vault that contains Web passwords and secure notes that you can place on a USB flash drive and use on another computer.</descrip></descripGrp><ntig><termGrp><term id="769462">personal vault</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224167">პირადი სეიფი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2132_125577_506888"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a device, to remove the corresponding device drivers from the hard disk and physically remove the device from the computer.</descrip></descripGrp><ntig><termGrp><term id="125577">uninstall</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506888">დეინსტალაცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21322_769845_1463522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control in a form that consists of an actionable image. At run time the user can click the image to run rules or actions similar to a button.</descrip></descripGrp><ntig><termGrp><term id="769845">picture button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1463522">ნახატის ღილაკი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21329_769992_2855413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To forward a piece of data from one part of a program to another.</descrip></descripGrp><ntig><termGrp><term id="769992">pass</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2855413">გადაცემა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21334_2675561_2402749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that creates sticky notes that can be shared between devices, that cloud sync, that are stored on Exchange, and that provide contextual reminders and actions that can be performed based on the content.</descrip></descripGrp><ntig><termGrp><term id="2675561">Microsoft Sticky Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2402749">ჩანიშვნები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21334_2675561_2676792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that creates sticky notes that can be shared between devices, that cloud sync, that are stored on Exchange, and that provide contextual reminders and actions that can be performed based on the content.</descrip></descripGrp><ntig><termGrp><term id="2675561">Microsoft Sticky Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2676792">Microsoft-ის ჩანიშვნები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21334_770408_2402749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that creates sticky notes that can be shared between devices, that cloud sync, that are stored on Exchange, and that provide contextual reminders and actions that can be performed based on the content.</descrip></descripGrp><ntig><termGrp><term id="770408">Sticky Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2402749">ჩანიშვნები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21334_770408_2676792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that creates sticky notes that can be shared between devices, that cloud sync, that are stored on Exchange, and that provide contextual reminders and actions that can be performed based on the content.</descrip></descripGrp><ntig><termGrp><term id="770408">Sticky Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2676792">Microsoft-ის ჩანიშვნები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21335_770428_2411926"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual piece of content that resembles a physical sticky note, is displayed across multiple apps and platforms, and that is created using Sticky Notes.</descrip></descripGrp><ntig><termGrp><term id="770428">sticky note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2411926">ჩანიშვნა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21348_771258_3045471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To continue movement, as with the cursor or a search operation, to the beginning or to a new starting point rather than stopping when the end of a series is reached. For example, the screen cursor might wrap around to the first column of the next line rather than stopping when it reaches the last column of the current line. Likewise, a program starting a search or replace operation in the middle of a document might be instructed to wrap around to the beginning rather than stop when it reaches the end of the document.</descrip></descripGrp><ntig><termGrp><term id="771258">wrap around</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3045471">ყველგან შესრულება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21353_1177078_1224168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables presenters in the rich client to broadcast a slide show to remote viewers watching in a Web browser. Throughout the presentation, the remote attendees will see the current slide being shown by the presenter.</descrip></descripGrp><ntig><termGrp><term id="1177078">PowerPoint Broadcast Slide Show</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224168">სლაიდ-შოუს მაუწყებლობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21353_772635_1224168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables presenters in the rich client to broadcast a slide show to remote viewers watching in a Web browser. Throughout the presentation, the remote attendees will see the current slide being shown by the presenter.</descrip></descripGrp><ntig><termGrp><term id="772635">Broadcast Slide Show</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224168">სლაიდ-შოუს მაუწყებლობა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21354_1075942_1224169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A labeled group of consecutive slides that helps the user navigate and organize presentations.</descrip></descripGrp><ntig><termGrp><term id="1075942">presentation section</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224169">სექცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21354_1075942_1224170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A labeled group of consecutive slides that helps the user navigate and organize presentations.</descrip></descripGrp><ntig><termGrp><term id="1075942">presentation section</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224170">პრეზენტაციის სექცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21354_772636_1224169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A labeled group of consecutive slides that helps the user navigate and organize presentations.</descrip></descripGrp><ntig><termGrp><term id="772636">section</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224169">სექცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21354_772636_1224170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A labeled group of consecutive slides that helps the user navigate and organize presentations.</descrip></descripGrp><ntig><termGrp><term id="772636">section</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224170">პრეზენტაციის სექცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21355_773106_1224171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to insert the contents of an open window or a screen clipping into the current document without the need to utilize external applications.</descrip></descripGrp><ntig><termGrp><term id="773106">Insert Screen Shot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224171">ეკრანის ანაბეჭდის ჩასმა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21358_773112_1224172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that makes automatic versions of user documents during each autosave operation and allows the user to revert to previous copies of the document with ease.</descrip></descripGrp><ntig><termGrp><term id="773112">Office Auto-Revisions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1224172">Office-ის ავტორევიზიები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termE