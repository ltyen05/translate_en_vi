p><descrip type="definition">A data type that will provide support for storing binary files within an Access database. More similar to the SharePoint concept of attachments than the current OLE object fields in Access. The data will be stored as a raw blob within the database.</descrip></descripGrp><ntig><termGrp><term id="210899">Attachment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1797976">დანართი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22183_1030868_2231362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Institute of Electrical and Electronics Engineers (IEEE) 802.11 wireless network in which Service Set Identifier (SSID) suppression is enabled.</descrip></descripGrp><ntig><termGrp><term id="1030868">non-broadcast network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2231362">დამალული ქსელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22183_1030869_2231362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Institute of Electrical and Electronics Engineers (IEEE) 802.11 wireless network in which Service Set Identifier (SSID) suppression is enabled.</descrip></descripGrp><ntig><termGrp><term id="1030869">hidden network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNot