 content and connecting consumer electronic devices.</descrip></descripGrp><ntig><termGrp><term id="258953">high-density multichip interconnect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1223959">მაღალგანზომილებიანი მულტიმედია ინტერფეისი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11734_258953_507445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital interface specification for delivering digital content and connecting consumer electronic devices.</descrip></descripGrp><ntig><termGrp><term id="258953">high-density multichip interconnect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507445">HDMI</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11734_258956_1223959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital interface specification for delivering digital content and connecting consumer electronic devices.</descrip></descripGrp><ntig><termGrp><term id="258956">HDMI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1223959">მაღალგანზომილებიანი მულტიმედია ინტერფეისი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammat