 capabilities.</descrip></descripGrp><ntig><termGrp><term id="3079376">intelligent recap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3080528">ინტელექტუალური შეჯამება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54021_3079377_3080532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Teams Premium feature that allows IT admins to create custom meeting types/templates for their organization.</descrip></descripGrp><ntig><termGrp><term id="3079377">meeting guides</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3080532">ონლაინ-კრების მითითებები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54022_3079520_3080524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of premium meeting protection capabilities in Teams Premium, to better contrast with basic meeting protections.</descrip></descripGrp><ntig><termGrp><term id="3079520">advanced meeting protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3080524">ონლაინ-კრების გაუმჯობესებული დაცვა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelecte