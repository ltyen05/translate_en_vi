cipal's secret key.</descrip></descripGrp><ntig><termGrp><term id="1506854">secret key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1587621">საიდუმლო გასაღები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="293_147704_1223805"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference to data stored in a document from another program.</descrip></descripGrp><ntig><termGrp><term id="147704">remote reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1223805">დისტანციური მითითება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2930_58202_506481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category for grouping or describing multimedia or games, such as music categorized as "classical" or "jazz".</descrip></descripGrp><ntig><termGrp><term id="58202">genre</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506481">ჟანრი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2939_7912_1888840"><langSet x