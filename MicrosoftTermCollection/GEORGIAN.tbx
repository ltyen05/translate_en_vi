tion (often at home) and communicating with a main office at a different location through a personal computer equipped with a modem and communications software.</descrip></descripGrp><ntig><termGrp><term id="1087966">teleworking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2873490">დისტანციური სამუშაო</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23562_1266981_2873490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of working in one location (often at home) and communicating with a main office at a different location through a personal computer equipped with a modem and communications software.</descrip></descripGrp><ntig><termGrp><term id="1266981">telecommuting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2873490">დისტანციური სამუშაო</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23562_2873212_2873490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of working in one location (often at home) and communicating with a main office at a different location through a personal computer equipped with a modem and communications software.</descrip></descripGrp><ntig><termGrp><term id="2873212">remote work</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><lang