ech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506640">მოდალური დიალოგური სარკმელი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3967_93870_506741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To submit content to an online forum for others to see.</descrip></descripGrp><ntig><termGrp><term id="93870">post</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506741">გადაგზავნა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39692_2308052_2309766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark or piece of information that you can add to a map, save, and share with others.</descrip></descripGrp><ntig><termGrp><term id="2308052">note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2309766">რუკის ანოტაცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39692_2308052_2309767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark or piece of information that you can add to a map, save, and share with others.</descrip></descripGrp><ntig><termGrp><term id="2308052">note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2309767">ანოტაცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39692_2308053_2309766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark or piece of information that you can add to a map, save, and share with others.</descrip></descripGrp><ntig><termGrp><term id="2308053">map note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2309766">რუკის ანოტაცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39692_2308053_2309767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark or piece of information that you can add to a map, save, and share with others.</descrip></descripGrp><ntig><termGrp><term id="2308053">map note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2309767">ანოტაცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3972_44091_506361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that is automatically used by a program when the user does not specify an alternative and are built into a program when a value or option must be assumed for the program to function.</descrip></descripGrp><ntig><termGrp><term id="44091">default</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506361">ნაგულისხმევი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39791_2309123_2574714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An iterative and incremental agile software development methodology for managing product development defining "a flexible, holistic product development strategy where a development team works as a unit to reach a common goal", challenges assumptions of the "traditional, sequential approach" to product development, and enabling teams to self-organize by encouraging physical co-location or close online collaboration of all team members, as well as daily face-to-face communication among all team members and disciplines in the project.</descrip></descripGrp><ntig><termGrp><term id="2309123">Scrum</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2574714">Scrum</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39791_2309123_2857404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An iterative and incremental agile software development methodology for managing product development defining "a flexible, holistic product development strategy where a development team works as a unit to reach a common goal", challenges assumptions of the "traditional, sequential approach" to product development, and enabling teams to self-organize by encouraging physical co-location or close online collaboration of all team members, as well as daily face-to-face communication among all team members and disciplines in the project.</descrip></descripGrp><ntig><termGrp><term id="2309123">Scrum</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2857404">მარჯვე Scrum</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39791_2856027_2574714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An iterative and incremental agile software development methodology for managing product development defining "a flexible, holistic product development strategy where a development team works as a unit to reach a common goal", challenges assumptions of the "traditional, sequential approach" to product development, and enabling teams to self-organize by encouraging physical co-location or close online collaboration of all team members, as well as daily face-to-face communication among all team members and disciplines in the project.</descrip></descripGrp><ntig><termGrp><term id="2856027">Agile Scrum</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2574714">Scrum</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39791_2856027_2857404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An iterative and incremental agile software development methodology for managing product development defining "a flexible, holistic product development strategy where a development team works as a unit to reach a common goal", challenges assumptions of the "traditional, sequential approach" to product development, and enabling teams to self-organize by encouraging physical co-location or close online collaboration of all team members, as well as daily face-to-face communication among all team members and disciplines in the project.</descrip></descripGrp><ntig><termGrp><term id="2856027">Agile Scrum</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2857404">მარჯვე Scrum</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3980_37784_506318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To acknowledge an action or the value of some data (e.g. password) by definite assurance.</descrip></descripGrp><ntig><termGrp><term id="37784">confirm</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506318">დასტური</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39847_2310171_2335732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office service that uses the Microsoft Graph to give personalized insight to users around content and people based on who they interact with in their company and what content their colleagues are viewing, restricted by permissions.</descrip></descripGrp><ntig><termGrp><term id="2310171">Delve</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2335732">Delve</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39847_2407977_2335732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office service that uses the Microsoft Graph to give personalized insight to users around content and people based on who they interact with in their company and what content their colleagues are viewing, restricted by permissions.</descrip></descripGrp><ntig><termGrp><term id="2407977">Microsoft Delve</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2335732">Delve</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3985_113531_506815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle that supports sizing an object.</descrip></descripGrp><ntig><termGrp><term id="113531">sizing handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506815">ზომის ცვლის სახელური</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39850_2312644_2334656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI element in Outlook that when clicked will identify and display email where a user has been explicitly mentioned via the @ symbol in either the email subject or body.</descrip></descripGrp><ntig><termGrp><term id="2312644">Mentions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2334656">ხსენება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39853_2312652_2329633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of going to different places on the Internet, on a particular Web site, in a database, etc. in order to find what you want.</descrip></descripGrp><ntig><termGrp><term id="2312652">navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2329633">ნავიგაცია</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39856_2312654_2361009"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to sort and display email based on predefined criteria.</descrip></descripGrp><ntig><termGrp><term id="2312654">Quick Filter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2361009">სწრაფი ფილტრები შეტყობინებების სიისთვის</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39856_2357846_2361009"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to sort and display email based on predefined criteria.</descrip></descripGrp><ntig><termGrp><term id="2357846">Quick Filters for message list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2361009">სწრაფი ფილტრები შეტყობინებების სიისთვის</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39857_2312655_2357323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that intelligently presorts email across all email accounts.</descrip></descripGrp><ntig><termGrp><term id="2312655">Focused Inbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2357323">ფოკუსირებული შემოსულები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39864_2322624_2326118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The wireless personal area network technology, launched in 2010 and marketed as Bluetooth Smart, used for transmitting data over distances as much as 100 meters. Cost and power consumption are low while maintaining a communication range similar to Bluetooth BR/EDR, the other widely-used version of Bluetooth</descrip></descripGrp><ntig><termGrp><term id="2322624">Bluetooth Smart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2326118">Bluetooth Smart</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39866_2315181_2321649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Bluetooth Low Energy device that sends static information, such as location or ID, to devices within its area.</descrip></descripGrp><ntig><termGrp><term id="2315181">beacon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2321649">შუქურა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3987_141789_1888941"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A placeholder text that included the field character, field type, and instructions, and that that shows where specified information from a data source will appear such that the elements in a field that generate a field's result.</descrip></descripGrp><ntig><termGrp><term id="141789">field code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1888941">ველის კოდი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39877_2315966_2321655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature for maps of the interior of some public places, such as the businesses inside a mall, or the gates, businesses, and other services inside an airport.</descrip></descripGrp><ntig><termGrp><term id="2315966">venue map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2321655">ადგილის გეგმა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39878_2316274_2321653"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of apps or services made available in an enterprise to help with particular business and process needs.</descrip></descripGrp><ntig><termGrp><term id="2316274">line-of-business</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2321653">ბიზნეს</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39878_2316274_2321654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of apps or services made available in an enterprise to help with particular business and process needs.</descrip></descripGrp><ntig><termGrp><term id="2316274">line-of-business</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2321654">LOB</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39878_2316275_2321653"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of apps or services made available in an enterprise to help with particular business and process needs.</descrip></descripGrp><ntig><termGrp><term id="2316275">LOB</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2321653">ბიზნეს</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39878_2316275_2321654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of apps or services made available in an enterprise to help with particular business and process needs.</descrip></descripGrp><ntig><termGrp><term id="2316275">LOB</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2321654">LOB</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39880_2320100_2324021"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for PC and Surface Hub that helps you connect a phone or PC to the Surface Hub display, or to another PC. On Surface Hub, it also allows you to switch between devices that are connected to the Surface Hub.​</descrip></descripGrp><ntig><termGrp><term id="2320100">Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2324021">დაკავშირება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39882_2320437_2324022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for purchasing cellular data that is packaged with cellular enabled Dell devices that include a Microsoft SIM card.</descrip></descripGrp><ntig><termGrp><term id="2320437">Dell NetReady</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2324022">Dell NetReady</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39885_2320890_2330444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The task management and to-do list app that helps people capture their ideas, things to do and places to see.</descrip></descripGrp><ntig><termGrp><term id="2320890">Wunderlist</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2330444">Wunderlist</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39889_2321509_2324028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of TV shows that are in the top N% of ratings.</descrip></descripGrp><ntig><termGrp><term id="2321509">Top-rated TV shows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2324028">საუკეთესო რეიტინგის ტელეშოუები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39890_2321510_2324023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of items emphasized to the customer through placement on the site.</descrip></descripGrp><ntig><termGrp><term id="2321510">Featured collections</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2324023">შემოთავაზებული კოლექციები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39891_2321511_2324025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make your search results more relevant by excluding unwanted and extraneous items.</descrip></descripGrp><ntig><termGrp><term id="2321511">refine</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2324025">დაზუსტება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39892_2321518_2324024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows customers to temporarily connect to available free Wi-Fi hotspots in order to find and buy Wi-Fi services from the Windows Store.</descrip></descripGrp><ntig><termGrp><term id="2321518">paid Wi-Fi services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2324024">ფასიანი Wi-Fi სერვისები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39932_2323787_2334716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To create a sway.</descrip></descripGrp><ntig><termGrp><term id="2323787">sway</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2334716">sway-ს შექმნა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39933_2323799_2334652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets users link their inbox for one email account with an inbox for another account, so they can see the messages from both accounts in a single place.</descrip></descripGrp><ntig><termGrp><term id="2323799">Linked Inboxes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2334652">დაკავშირებული შემოსულები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39934_2323812_2334650"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The OneNote toolbar designed to help individuals with learning differences or who are looking for literacy assistance.</descrip></descripGrp><ntig><termGrp><term id="2323812">Learning Tools for OneNote</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2334650">OneNote-ი