function that returns the sample covariance, the average of the products deviations for each data point pair in two data sets.</descrip></descripGrp><ntig><termGrp><term id="2955556">COVARIANCE.S</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2964282">COVARIANCE.S</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52345_2955557_2964283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Compatibility/Statistical Excel function that returns the smallest value for which the cumulative binomial distribution is less than or equal to a criterion value.</descrip></descripGrp><ntig><termGrp><term id="2955557">CRITBINOM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2964283">CRITBINOM</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52346_2955558_2964284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Math and trigonometry Excel function that returns the cosecant of an angle.</descrip></descripGrp><ntig><termGrp><term id="2955558">CSC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2964284">CSC</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">