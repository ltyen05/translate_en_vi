escrip type="definition">A broadly released fix for a specific problem addressing a critical, non-security related bug.</descrip></descripGrp><ntig><termGrp><term id="4565">critical update</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1764657">კრიტიკული განახლება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6955_346953_507951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A malfunction of a physical component such as a disk head failure or memory error.</descrip></descripGrp><ntig><termGrp><term id="346953">hardware failure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507951">მოწყობილობის შეცდომა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6962_312045_507705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cell that is referred to by a formula in another cell. For example, if cell D10 contains the formula =B5, cell B5 is a precedent to cell D10.</descrip></descripGrp><ntig><termGrp><term id="312045">precedent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507705">პრეცედენტი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatical