articipate.</descrip></descripGrp><ntig><termGrp><term id="88221">opt out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2480437">უარყოფა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4282_147657_1888985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Placement of an element in the natural HTML flow of a document, but such that its position is offset from the preceding content.</descrip></descripGrp><ntig><termGrp><term id="147657">relative positioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1888985">შედარებითი პოზიციონირება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4282_147658_1888985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Placement of an element in the natural HTML flow of a document, but such that its position is offset from the preceding content.</descrip></descripGrp><ntig><termGrp><term id="147658">inline positioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1888985">შედარებითი პოზიციონირება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber