gular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506860">TCP/IP</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1379_120228_1223237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suite of networking protocols arranged in four layers, which are called the link layer, internet layer, transport layer, and application layer, and that includes IP in the internet layer and TCP in the transport layer.</descrip></descripGrp><ntig><termGrp><term id="120228">Transmission Control Protocol/Internet Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1223237">გადაცემის მართვის პროტოკოლი/ინტერნეტის პროტოკოლი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1379_120228_506860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suite of networking protocols arranged in four layers, which are called the link layer, internet layer, transport layer, and application layer, and that includes IP in the internet layer and TCP in the transport layer.</descrip></descripGrp><ntig><termGrp><term id="120228">Transmission Control Protocol/Internet Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506860">TCP/IP</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><t