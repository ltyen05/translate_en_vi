descripGrp><descrip type="definition">To change the size of an element on the screen.</descrip></descripGrp><ntig><termGrp><term id="103575">resize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1223950">ზომის შეცვლა</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10367_129177_506906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display of information from a given perspective or location.</descrip></descripGrp><ntig><termGrp><term id="129177">view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506906">ხედი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10380_156547_1522270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document describing a company's position on privacy, detailing what information it collects, with whom the data is shared, and how users can control the use of their personal information.</descrip></descripGrp><ntig><termGrp><term id="156547">privacy statement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1522270">კონფიდენციალურობის დებულება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10396_158410_507124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to, being, or characteristic of something that is not dependent on timing. Each application or command runs in the specified order, but the specified item does not wait for any previously started processes to finish before an application or command runs.</descrip></descripGrp><ntig><termGrp><term id="158410">asynchronous</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507124">ასინქრონული</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10396_2479304_507124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to, being, or characteristic of something that is not dependent on timing. Each application or command runs in the specified order, but the specified item does not wait for any previously started processes to finish before an application or command runs.</descrip></descripGrp><ntig><termGrp><term id="2479304">async</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507124">ასინქრონული</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="104_234833_507369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An organizational feature of Windows that displays a panel on the side of the desktop with shortcuts to mini-applications, also known as gadgets. The examples of such gadgets are local weather, a photo slideshow, a dictionary, news headlines, and a Windows Media Player control.</descrip></descripGrp><ntig><termGrp><term id="234833">Windows Sidebar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507369">Windows-ის გვერდითი ზოლი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10402_146400_1888976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text or some other element used in an application as an indicator that the user should enter in his or her own text.</descrip></descripGrp><ntig><termGrp><term id="146400">placeholder text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1888976">ჩანაცვლების ტექსტი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10414_270278_507563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that separates the numerator and denominator of a fraction.</descrip></descripGrp><ntig><termGrp><term id="270278">fraction bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507563">წილადი