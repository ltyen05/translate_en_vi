"><descripGrp><descrip type="definition">To assign a drive letter, port, or computer name to a shared resource so that you can use it.</descrip></descripGrp><ntig><termGrp><term id="160318">connect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507130">დაკავშირება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15796_233422_1936649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To automatically remove items to another folder periodically or delete them, based on the amount of time that they have been in the folder.</descrip></descripGrp><ntig><termGrp><term id="233422">AutoArchive</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1936649">ავტომატური არქივირება</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15804_346948_507948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Possessing improved, advanced, or more sophisticated features.</descrip></descripGrp><ntig><termGrp><term id="346948">enhanced</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507948">გაუმჯობესებული</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammatica