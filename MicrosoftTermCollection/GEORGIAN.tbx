Grp><term id="506885">ორგანზომილებიანი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1029_320452_507845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Existing in reference to two measures, such as height and width--for example, a two-dimensional model drawn with reference to an x-axis and a y-axis, or a two-dimensional array of numbers placed in rows and columns.</descrip></descripGrp><ntig><termGrp><term id="320452">2-D</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507845">2-გ</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10290_81930_1888876"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle that is displayed on some objects such as toolbars, tables, or on individual rows or columns, that allows the user to drag them to another location.</descrip></descripGrp><ntig><termGrp><term id="81930">move handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1888876">გადაადგილების მარკერი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10297_314121_507716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Work or information that provides support - possibly critical support-for a computing process but is not an intrinsic part of the operation or data. Overhead often adds to processing time but is generally necessary.</descrip></descripGrp><ntig><termGrp><term id="314121">overhead</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507716">ოვერჰედი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10299_85657_506671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area on the right side of the Windows taskbar. It contains shortcuts to programs and important status information.</descrip></descripGrp><ntig><termGrp><term id="85657">notification area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506671">შეტყობინების არე</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10299_85657_506672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area on the right side of the Windows taskbar. It contains shortcuts to programs and important status information.</descrip></descripGrp><ntig><termGrp><term id="85657">notification area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506672">სტატუსის არე</term><termN