tig><termGrp><term id="3055658">Microsoft Adoption Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3056293">Microsoft-ის დანერგვის ცენტრი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53688_3056784_3057293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The group within an organization that offers a specialized form of customer service in which the company focus on what is deemed to be best for the customer.</descrip></descripGrp><ntig><termGrp><term id="3056784">Customer Advocacy Group</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3057293">მომხმარებელთა დაცვის ჯგუფი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53689_3056785_3057290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A badge displayed on a profile image to identify a champion.</descrip></descripGrp><ntig><termGrp><term id="3056785">champion badge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="3057290">ჩემპიონის ნიშანი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gram