 id="50289_2844105_2849922"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A globally unique identifier (GUID) for the Azure Active Directory for a particular tenant.</descrip></descripGrp><ntig><termGrp><term id="2844105">directory ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2849922">დირექტორიის ID</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50290_2844110_2848305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 connected experience that connects apps — Wunderlist, Facebook and Evernote, and Meetup — to the Outlook calendar so that the user can see all tasks, events, notes, etc., from these apps in the calendar.</descrip></descripGrp><ntig><termGrp><term id="2844110">Calendar apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="2848305">კალენდრის აპები</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50291_2844113_2849932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 connected experience that allows users to subscribe to an external calendar within their Outlook calendar.</descrip></descripGrp><ntig><termGrp><term id="2844113">Interesting Calendars</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></la