></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507763">შეცდომის კოდი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10069_338533_507917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In printing, the process of eliminating white lines between colors by printing small areas of overlapping color where colors touch.</descrip></descripGrp><ntig><termGrp><term id="338533">trapping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="507917">ფერთა ნიშანი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10077_33192_506279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ) character.</descrip></descripGrp><ntig><termGrp><term id="33192">closing parenthesis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="506279">დახურვის ფრჩხილი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10086_263114_1798014"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a file format that does not allow for VBA code. Office 12 default file formats are macro-free. Examples of file extensions for macro-free formats are .docx, .pptx, .xlsx.</descrip></descripGrp><ntig><termGrp><term id="263114">macro-free</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1798014">მაკროების მხარდაჭერის გარეშე</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10089_227651_1463462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">As one aspect of a KPI, the desired level of performance with respect to a specific business goal or strategy. Actual values are evaluated against the target to determine KPI score and status.</descrip></descripGrp><ntig><termGrp><term id="227651">target</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1463462">მიზანი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10089_227652_1463462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">As one aspect of a KPI, the desired level of performance with respect to a specific business goal or strategy. Actual values are evaluated against the target to determine KPI score and status.</descrip></descripGrp><ntig><termGrp><term id="227652">target value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ka"><ntig><termGrp><term id="1463462">მიზანი</term><termNote type="geographicalUsage">GEO</termNote><termNote type="p