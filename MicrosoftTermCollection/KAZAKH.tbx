</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1954499">бақылаудан қорғану</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22190_1031206_1984921"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of IIS authentication in which IIS accepts client-certificates used to prove the client's identity. Using this form of authentication, IIS can optionally map a client certificate to a Windows user account by using an internal mapping table or Active Directory.</descrip></descripGrp><ntig><termGrp><term id="1031206">certificate authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1984921">сертификат аутентификациясы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22193_1031378_1250347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A command prompt that is run in a privileged administrator security context that allows actions that would normally be restricted. Without elevation, command prompts in Windows Client and Windows Server run in a restricted state.</descrip></descripGrp><ntig><termGrp><term id="1031378">elevated command prompt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250347">жоғары пәрмен енгізуге шақыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22202_1031390_2221204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The position at which a particular item can be found: either an addressed location or a uniquely identified location on a disk, tape, or similar medium.</descrip></descripGrp><ntig><termGrp><term id="1031390">storage location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221204">сақтау орны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2221_530760_2219685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A COM object that represents a data construct stored in a repository type library.</descrip></descripGrp><ntig><termGrp><term id="530760">repository object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2219685">репозиторий нысаны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22238_1032196_1376329"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Live service for event planning and invitations.</descrip></descripGrp><ntig><termGrp><term id="1032196">Windows Live Events</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1376329">Windows Live оқиғалары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2224_101694_2219258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The partial DNS domain name configured in individual resource records to locate and qualify the record within a zone. The relative name is joined to the front of the parent domain (domain of origin) for each resource record to form a fully qualified domain name (FQDN) within the zone. In DNS Manager, the relative name will correspond to fields that use record-specific name properties, such as the Host computer name field used in an address (A) resource record.</descrip></descripGrp><ntig><termGrp><term id="101694">relative name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2219258">салыстырмалы атау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22246_1034324_2055090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of feedback left by someone viewing content on a site.</descrip></descripGrp><ntig><termGrp><term id="1034324">comment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2055090">пікір</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22248_1034327_1250348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that belongs to a homegroup.</descrip></descripGrp><ntig><termGrp><term id="1034327">homegroup computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250348">үй тобының компьютері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22249_1034328_1250349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A troubleshooter that helps find and fix problems with viewing computers or shared files in a homegroup.</descrip></descripGrp><ntig><termGrp><term id="1034328">HomeGroup troubleshooter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250349">үй тобының ақауларды жою құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22259_1052661_1250350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To group together multiple windows of the same application under a single button on the taskbar’s taskband.</descrip></descripGrp><ntig><termGrp><term id="1052661">combine</term><term