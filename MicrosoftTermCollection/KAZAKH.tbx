ammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54665_3103948_3104111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows customers to cryptographically tie tokens to the device a user originally signed in from.</descrip></descripGrp><ntig><termGrp><term id="3103948">token protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3104111">токен қорғанысы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54666_3104302_3104345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability that quickly captures detailed steps for each process in your organization to help you better understand the opportunities to streamline your workflows. Process advisor includes both task mining and process mining capabilities.</descrip></descripGrp><ntig><termGrp><term id="3104302">process advisor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3104345">процесс кеңесшісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54667_3104366_3105190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container-like module that is used to organize the information or modules on a page by providing a collapsible drawer-like capability. An accordion module can be used on any page.</descrip></descripGrp><ntig><termGrp><term id="3104366">accordion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105190">аккордеон</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54668_3104367_3105191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Commerce module that is used to display and link to loyalty program information.</descrip></descripGrp><ntig><termGrp><term id="3104367">Account loyalty</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105191">Тіркелгі бейілділігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54669_3104368_3105192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A module that provides product information needed to make a purchase decision and allows the user to add the items to cart.</descrip></descripGrp><ntig><termGrp><term id="3104368">buy box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105192">сатып алу өрісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5467_375735_380589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism that helps reduce the volume of antivirus scanning that is required across an organization by stamping messages that have been scanned for viruses with metadata that indicates the version of the antivirus software that performed the scan and the result of that scan. This metadata, or "stamp," travels securely with the message as it is routed through different email servers within the organization and is used to determine whether subsequent additional virus scanning on the message can be bypassed.</descrip></descripGrp><ntig><termGrp><term id="375735">antivirus stamping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="380589">вирусқа қарсы таңбалау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54670_3104369_3105193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code-free style change that overrides any Dynamics 365 Commerce module's Cascading Style Sheets (CSS).</descrip></descripGrp><ntig><termGrp><term id="3104369">CSS override</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105193">CSS қайта анықтауы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54671_3104370_3105195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programmatically determined marker in your published pages that allows screen-reader users to understand where they are currently located in the webpage.</descrip></descripGrp><ntig><termGrp><term id="3104370">landmark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105195">бағдар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54672_3104371_3105196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card that entitles the card holder to participate in the loyalty programs that are assigned to the card.</descrip></descripGrp><ntig><termGrp><term id="3104371">loyalty card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105196">бейілділік картасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54673_3104372_3105198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned systematically to a new call center channel. Because call centers are created as operating units, users can link the call center channel to various Commerce features, such as assortments, catalogs, and specific modes of delivery.</descrip></descripGrp><ntig><termGrp><term id="3104372">operating unit number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105198">жұмыс бірлігінің нөмірі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54673_3104372_3105200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned systematically to a new call center channel. Because call centers are created as operating units, users can link the call center channel to various Commerce features, such as assortments, catalogs, and specific modes of delivery.</descrip></descripGrp><ntig><termGrp><term id="3104372">operating unit number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105200">OUN</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54673_3104389_3105198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned systematically to a new call center channel. Because call centers are created as operating units, users can link the call center channel to various Commerce features, such as assortments, catalogs, and specific modes of delivery.</descrip></descripGrp><ntig><termGrp><term id="3104389">OUN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105198">жұмыс бірлігінің нөмірі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54673_3104389_3105200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned systematically to a new call center channel. Because call centers are created as operating units, users can link the call center channel to various Commerce features, such as assortments, catalogs, and specific modes of delivery.</descrip></descripGrp><ntig><termGrp><term id="3104389">OUN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105200">OUN</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54674_3104373_3105199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that can be created and used to quickly place repeat orders.</descrip></descripGrp><ntig><termGrp><term id="3104373">order template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105199">тапсырыс үлгісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54675_3104374_3105201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extension that facilitates communication between Commerce (and associated components) and a payment service.</descrip></descripGrp><ntig><termGrp><term id="3104374">payment connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105201">төлем қосқышы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54676_3104375_3105202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page that provides detailed information about a product, and lets customers select product options such as a size, style, and color. A PDP should showcase all the product information that a customer requires to make a purchase decision.</descrip></descripGrp><ntig><termGrp><term id="3104375">PDP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105202">PDP</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54677_3104376_3105203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of rules that are joined by AND conditions. Users can also create multiple rule blocks that have OR conditions between them.</descrip></descripGrp><ntig><termGrp><term id="3104376">rule block</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105203">ереже блогы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54678_3104377_3105204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A profile that can be set up to manage identity management settings for site user logins.</descrip></descripGrp><ntig><termGrp><term id="3104377">site authentication profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105204">сайт аутентификациясы профилі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54679_3104378_3105205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolset that enables users to build templates, select themes, and select and configure modules for a website without writing any code.</descrip></descripGrp><ntig><termGrp><term id="3104378">site builder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105205">сайт құрастырушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54680_3104379_3105206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A module that lets users browse across multiple sites by providing an easy way to switch between sites and select their preferred shopping site when a business has different sites across markets, regions, and locales.</descrip></descripGrp><ntig><termGrp><term id="3104379">site picker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105206">сайт таңдау құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54681_3104380_3105207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programming element that lets a screen reader pass over navigation elements and ads on a Web site and go directly to the desired content.</descrip></descripGrp><ntig><termGrp><term id="3104380">skip link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105207">өткізіп жіберу сілтемесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54682_3104381_3105208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A module that is used to add space between sections on your page to allow for different layout and design options.</descrip></descripGrp><ntig><termGrp><term id="3104381">spacer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105208">бөлгіш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54683_3104548_3105942"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The add-on service made available as a Microsoft Dataverse solution that adds the ability to replicate Dataverse data to a Microsoft Azure SQL Database store in a customer-owned Microsoft Azure subscription.</descrip></descripGrp><ntig><termGrp><term id="3104548">Data Export</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105942">Деректерді экспорттау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54684_3104549_3105943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The asynchronous service that executes long-running operations independent of the main Microsoft Dataverse core operation.</descrip></descripGrp><ntig><termGrp><term id="3104549">Dynamics 365 Async Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105943">Dynamics 365 үндестірілмеген қызметі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54684_3104549_3105944"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The asynchronous service that executes long-running operations independent of the main Microsoft Dataverse core operation.</descrip></descripGrp><ntig><termGrp><term id="3104549">Dynamics 365 Async Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105944">Dynamics 365 үндестірілмеген өңдеу қызметі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54684_3104558_3105943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The asynchronous service that executes long-running operations independent of the main Microsoft Dataverse core operation.</descrip></descripGrp><ntig><termGrp><term id="3104558">Dynamics 365 Asynchronous Processing Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105943">Dynamics 365 үндестірілмеген қызметі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54684_3104558_3105944"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The asynchronous service that executes long-running operations independent of the main Microsoft Dataverse core operation.</descrip></descripGrp><ntig><termGrp><term id="3104558">Dynamics 365 Asynchronous Processing Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105944">Dynamics 365 үндестірілмеген өңдеу қызметі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54685_3104550_3105945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The event website that provides an online resource where people can read about your event and its speakers, create an account, register for the event, purchase passes, view their session schedule, and more.</descrip></descripGrp><ntig><termGrp><term id="3104550">Event Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105945">Оқиға порталы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54686_3104551_3105946"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that enables continuous replication of Common Data Service entity data to Azure Data Lake, which can then be used to run analytics, such as Power BI reporting, machine learning, data warehousing, or other downstream integration purposes. It simplifies the technical and administrative complexity of operationalizing entities for analytics and managing schema and data.</descrip></descripGrp><ntig><termGrp><term id="3104551">Export to Data Lake</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105946">Деректер көліне экспорттау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54687_3104552_3105947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The component that is used to display the SharePoint documents in Microsoft Dynamics 365.</descrip></descripGrp><ntig><termGrp><term id="3104552">Microsoft Dynamics 365 List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105947">Microsoft Dynamics 365 тізімі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54688_3104553_3105948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables professional developers to build code components that can be used across model-driven and canvas apps. Code components are reusable, metadata-driven, and solution-aware, so they can be easily packaged and moved across organizations to support multiple form factors.</descrip></descripGrp><ntig><termGrp><term id="3104553">Power Apps component framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3105948">Power Apps component framework</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54689_3104554_3105949"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power BI feature that allows users to easily embed interactive Power BI content in blog posts, websites, emails, or social media. They can also easily edit, update, refresh, or stop sharing their published visuals.</descrip></descripGrp><ntig><termGrp><term id="3104554">Publish to Web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></