</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2968970">COVAR</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52343_2955555_2968971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Statistical Excel function that returns covariance, the average of the products of paired deviations.</descrip></descripGrp><ntig><termGrp><term id="2955555">COVARIANCE.P</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2968971">COVARIANCE.P</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52344_2955556_2968972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Statistical Excel function that returns the sample covariance, the average of the products deviations for each data point pair in two data sets.</descrip></descripGrp><ntig><termGrp><term id="2955556">COVARIANCE.S</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2968972">COVARIANCE.S</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52345_2955557_2968973"><langS