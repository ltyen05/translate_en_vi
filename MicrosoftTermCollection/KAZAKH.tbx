ard keyboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627516">стандартты пернетақта</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7838_72879_626873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An input device that consists of individual keys and that is used to convey information from the user to a computer or data communication circuit.</descrip></descripGrp><ntig><termGrp><term id="72879">keyboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626873">пернетақта</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7838_72879_627516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An input device that consists of individual keys and that is used to convey information from the user to a computer or data communication circuit.</descrip></descripGrp><ntig><termGrp><term id="72879">keyboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627516">стандартты пернетақта</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7839_178240_625947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who sets up and maintains the systems and records related to authorized users of multi-user computer networks or operating systems.</descrip></descripGrp><ntig><termGrp><term id="178240">account manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="625947">тіркелгіні реттеуші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7840_130989_2223428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A processing cycle of the microprocessor during which it only waits for data from an input/output device or from memory. While a single wait state is not humanly perceptible, the cumulative effect of wait states is to slow system performance.</descrip></descripGrp><ntig><termGrp><term id="130989">wait state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2223428">күту күйі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7841_12156_1249211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A record of synthetic, successive still images that produce an illusion of movement when played back.</descrip></descripGrp><ntig><termGrp><term id="12156">animation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1249211">анимация</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7848_178297_2174663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of pages that can be operated on as a whole. Pages belonging to an allocation unit are tracked by Index Allocation Map (IAM) pages. An allocation unit consists of the IAM page chain and all pages marked allocated in that IAM page chain. An allocation unit can contain at most a single IAM chain, and an IAM chain must belong to one, and only one, allocation unit.</descrip></descripGrp><ntig><termGrp><term id="178297">allocation unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2174663">орналастыру блогы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7849_44761_626446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual design surface.</descrip></descripGrp><ntig><termGrp><term id="44761">designer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626446">құрастырушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7852_45965_626477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the state of a control in which normal functionality is not available to a user.</descrip></descripGrp><ntig><termGrp><term id="45965">dimmed</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626477">қол жеткізгісіз</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7852_45965_626482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the state of a control in which normal functionality is not available to a user.</descrip></descripGrp><ntig><termGrp><term id="45965">dimmed</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626482">ажыратылған</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7852_45966_626477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the state of a control in which normal functionality is not available to a user.</descrip></descripGrp><ntig><termGrp><term id="45966">unavailable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626477">қол жеткізгісіз</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7852_45966_626482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the state of a control in which normal functionality is not available to a user.</descrip></descripGrp><ntig><termGrp><term id="45966">unavailable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626482">ажыратылған</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7852_45967_626477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the state of a control in which normal functionality is not available to a user.</descrip></descripGrp><ntig><termGrp><term id="45967">disabled</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626477">қол жеткізгісіз</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7852_45967_626482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the state of a control in which normal functionality is not available to a user.</descrip></descripGrp><ntig><termGrp><term id="45967">disabled</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626482">ажыратылған</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7854_184016_615795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A label that refers to the email address of the person responsible for editorial content.</descrip></descripGrp><ntig><termGrp><term id="184016">managing editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615795">бас редактор</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7862_178325_2195874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical representation of a run-time connection to a data source.</descrip></descripGrp><ntig><termGrp><term id="178325">connection manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2195874">байланыс менеджері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7863_181181_2214298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A personalized workspace.</descrip></descripGrp><ntig><termGrp><term id="181181">My Reports</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2214298">Менің есептерім</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7864_342527_627432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical connection created between two hosts to exchange data.</descrip></descripGrp><ntig><termGrp><term id="342527">session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627432">сеанс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7869_78635_627003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The key used by the client and server for all session key generation. The master key is used to generate the client-read key, the client-write key, the server-read key, and the server-write key. Master keys can be exported as simple key BLOBs.</descrip></descripGrp><ntig><termGrp><term id="78635">master key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627003">басты кілт</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="787_181735_2219811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single database dimension joined to the fact table on a different foreign keys to produce multiple cube dimensions.</descrip></descripGrp><ntig><termGrp><term id="181735">role-playing dimension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2219811">рөлдік өлшем</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7874_7041_2289802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string of characters entered by a user to verify his or her identity to a network or to a local computer, device, or client, or to sign in to an account, app, and so on.</descrip></descripGrp><ntig><termGrp><term id="7041">access code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2289802">құпиясөз</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7874_7041_625932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string of characters entered by a user to verify his or her identity to a network or to a local computer, device, or client, or to sign in to an account, app, and so on.</descrip></descripGrp><ntig><termGrp><term id="7041">access code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="625932">қатынас коды</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7874_7042_2289802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string of characters entered by a user to verify his or her identity to a network or to a local computer, device, or client, or to sign in to an account, app, and so on.</descrip></descripGrp><ntig><termGrp><term id="7042">password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2289802">құпиясөз</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7874_7042_625932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string of characters entered by a user to verify his or her identity to a network or to a local computer, device, or client, or to sign in to an account, app, and so on.</descrip></descripGrp><ntig><termGrp><term id="7042">password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="625932">қатынас коды</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7875_307417_407529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows Outlook and mobile devices to automatically discover and connect to the correct Exchange server without requiring the user to know the Exchange server name or other details, even if the mailbox has been moved or a server has failed.</descrip></descripGrp><ntig><termGrp><term id="307417">AutoConnect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407529">Автоқосылу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7878_236973_627751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Parental Controls that allows users to block Web sites that they don't want to view.</descrip></descripGrp><ntig><termGrp><term id="236973">Web restrictions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627751">веб-шектеулер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="788_397211_407508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An international messaging standard that can be used by a variety of messaging systems. X.400 uses a strict addressing method that reflects a hierarchical environment. The use of X.400 has been largely supplanted by the combination of SMTP and MIME.</descrip></descripGrp><ntig><termGrp><term id="397211">X.400</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407508">X.400</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7885_48295_626532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move an item on the screen (1) by touching the item on a screen and then sliding the finger across the screen or (2) by pressing and holding down the left mouse button while moving the mouse.</descrip></descripGrp><ntig><termGrp><term id="48295">drag</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626532">апару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7890_1177068_3126927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of times an ad was clicked, divided by the number of times the ad was shown (impressions).</descrip></descripGrp><ntig><termGrp><term id="1177068">clickthrough rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3126927">сілтемелер бойынша өту жиілігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7890_1177069_3126927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of times an ad was clicked, divided by the number of times the ad 