o determine precedence and resolve conflicts.</descrip></descripGrp><ntig><termGrp><term id="695050">cascading style sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2105050">каскадты мәнерлер кестесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20114_699744_779497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contour that is tapered slightly at the beginning and end of the curve, resembling the shape of a turtle shell.</descrip></descripGrp><ntig><termGrp><term id="699744">turtle contour</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779497">"тасбақа" контуры</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20115_699745_779549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contour that slopes up gradually, peaks near the end of the curve, and then drops off.</descrip></descripGrp><ntig><termGrp><term id="699745">late-peak contour</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779549">кейінгі төбелі контур</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20116_699746_779592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contour that begins at its highest point, and then slopes downward.</descrip></descripGrp><ntig><termGrp><term id="699746">front-loaded contour</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779592">төмендеуші контур</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20118_699748_779527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contour that peaks near the beginning of the curve and then slopes downward more gradually.</descrip></descripGrp><ntig><termGrp><term id="699748">early-peak contour</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779527">алдыңғы төбелі контур</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20119_699749_779543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contour that contains two high points in the curve.</descrip></descripGrp><ntig><termGrp><term id="699749">double-peak contour</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779543">екі төбелі контур</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2012_357288_2814834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical control used to display text.</descrip></descripGrp><ntig><termGrp><term id="357288">label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2814834">белгі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2012_357288_615512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical control used to display text.</descrip></descripGrp><ntig><termGrp><term id="357288">label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615512">жазу белгі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20120_699750_779555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contour that follows the general shape of a bell curve.</descrip></descripGrp><ntig><termGrp><term id="699750">bell contour</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779555">қоңырау тәрізді контур</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20123_699780_2221507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of database storage that is roughly equivalent to a file group in SQL Server. Tablespaces allow storage and management of database objects within individual groups.</descrip></descripGrp><ntig><termGrp><term id="699780">tablespace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221507">кестелік кеңістік</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20125_700660_776461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Meeting an organization's various obligations, which may arise from laws, regulations, rules, and many other legal instruments, such as court judgments, litigation, and even contracts. Specific and important examples of these obligations include the Sarbanes-Oxley Act (SOX) and the California Law on Notice of Security Breach, formerly known as SB-1386. These regulatory obligations may be created by many sources, such as national and local governments and from industry-specific oversight groups, such as the Payment Card Industry Data Security Standards.</descrip></descripGrp><ntig><termGrp><term id="700660">compliance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="776461">талаптарға сәйкес келу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20126_700661_776462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Person responsible for ensuring that an organization complies with the various regulations and standards that are imposed by government and other regulatory bodies.</descrip></descripGrp><ntig><termGrp><term id="700661">compliance officer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="776462">талаптарға сәйкес келу жағадайларымен қамтамасыз ету жөніндегі жауапты тұлға</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20127_700662_1249267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of communications (email, IM, text messaging, voice mail, and so on) between two or more participants.</descrip></descripGrp><ntig><termGrp><term id="700662">conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1249267">сөйлесу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20127_700662_1713592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of communications (email, IM, text messaging, voice mail, and so on) between two or more participants.</descrip></descripGrp><ntig><term