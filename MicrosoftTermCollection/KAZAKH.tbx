ype="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33489_1785534_2105161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service update that is released to a group of users before it is made available to all of the users at your organization. Unlike a pilot, early update cannot be rolled back or cancelled.</descrip></descripGrp><ntig><termGrp><term id="1785534">early upgrade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2105161">ерте жаңарту</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3349_148490_2070224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Page regions reserved for content that you want to appear consistently on all your web pages. Shared borders usually contain link bars - hyperlinks to the other pages in the current web site.</descrip></descripGrp><ntig><termGrp><term id="148490">shared borders</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070224">ортақ жиектер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33495_1787151_1859865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows an Outlook user to limit the amount of email data that is synchronized locally in their offline Outlook Data File (.ost), based on the age of the items. This approach helps maximize Outlook performance on devices that have a very limited amount of local storage.</descrip></descripGrp><ntig><termGrp><term id="1787151">Sync Slider</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1859865">Синхрондау жүгірткісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33496_1787993_1859788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of resources for Microsoft Office software that provides support for features such as Help and proofing tools in a particular language or set of languages.</descrip></descripGrp><ntig><termGrp><term id="1787993">Microsoft Office Language Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1859788">Microsoft Office тіл жиынтығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33496_1787993_1859877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of resources for Microsoft Office software that provides support for features such as Help and proofing tools in a particular language or set of languages.</descrip></descripGrp><ntig><termGrp><term id="1787993">Microsoft Office Language Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><n