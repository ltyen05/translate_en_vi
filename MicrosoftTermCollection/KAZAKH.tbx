mpare</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626310">салыстыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6302_1244829_2670083"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Web browser–based interface of Microsoft Office Project that project team members and stakeholders can use to access and update information stored in Microsoft Project Server, without having to install Microsoft Project on their computers.</descrip></descripGrp><ntig><termGrp><term id="1244829">Project Web App</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2670083">PWA</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6302_2667271_2670083"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Web browser–based interface of Microsoft Office Project that project team members and stakeholders can use to access and update information stored in Microsoft Project Server, without having to install Microsoft Project on their computers.</descrip></descripGrp><ntig><termGrp><term id="2667271">PWA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2670083">PWA</term><termNote type="geographicalUsage">KAZ</termNot