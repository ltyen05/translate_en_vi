fSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2432565">Тақта белгісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42842_2429697_2433175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Office 365, Windows 10 Enterprise, and the Enterprise Mobility + Security suite.</descrip></descripGrp><ntig><termGrp><term id="2429697">Secure Productive Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2433175">Secure Productive Enterprise</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42845_2429854_3031305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure of attrition or loss.</descrip></descripGrp><ntig><termGrp><term id="2429854">churn rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3031305">жылыстау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42845_2909982_3031305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure of attrition or loss.</descrip></descripGrp><ntig><termGrp><term id="2909982">churn</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3031305">жылыстау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4285_175385_2093430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In DNS, a default Time to Live (TTL) value that is set in seconds and used with all resource records in a zone. This value is set in the start of authority (SOA) resource record for each zone. By default, the DNS server includes this value in query responses. It is used to inform recipients how long they can store and use resource records, which are provided in the query answer, before they must expire the stored records data. When TTL values are set for individual resource records, those values override the minimum TTL.</descrip></descripGrp><ntig><termGrp><term id="175385">minimum TTL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093430">ең аз TTL</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42859_2430605_2433173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ribbon button that inverts the colors of the text and background of an application.</descrip></descripGrp><ntig><termGrp><term id="2430605">Night mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2433173">Түнгі режим</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42862_2430759_2431624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that allows users to change text size for an entire document.</descrip></descripGrp><ntig><termGrp><term id="2430759">text size</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2431624">мәтін өлшемі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42863_2430760_2431625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to change letter, word, line, and column spacing to reduce visual crowding.</descrip></descripGrp><ntig><termGrp><term id="2430760">text spacing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2431625">аралықтар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42864_2430761_2431622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that reads text in an application to the user.​</descrip></descripGrp><ntig><termGrp><term id="2430761">read aloud</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2431622">дауыстап оқу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42865_2430762_2431623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that separates the syllables of each word with a dot, making content more easily readable for some people.</descrip></descripGrp><ntig><termGrp><term id="2430762">syllables</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2431623">буындар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42877_2430907_2459408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Visio feature that allows users to create data-driven diagrams using Visio templates by importing data and then specifying how the input data maps to the corresponding diagram.</descrip></descripGrp><ntig><termGrp><term id="2430907">Data Visualizer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2459408">Деректер визуализаторы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</t