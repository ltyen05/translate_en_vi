-US"><descripGrp><descrip type="definition">Pertaining to an entity, such as a user, a file or a computer that is currently connected a server.</descrip></descripGrp><ntig><termGrp><term id="87656">online</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627117">қосылған</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33730_1814259_2058564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tab in the Skype desktop client for displaying a user's Facebook newsfeed and Skype mood messages.</descrip></descripGrp><ntig><termGrp><term id="1814259">Skype Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2058564">Skype басты беті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33731_1814260_2058565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web tool that businesses can use to allocate Skype Credit, features, and products to employees.</descrip></descripGrp><ntig><termGrp><term id="1814260">Skype Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2058565">Skype Manager</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNot