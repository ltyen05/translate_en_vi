</langSet></termEntry><termEntry id="33487_1785153_2751341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud-computing model that allows users to develop, run, manage, and deploy applications within a cloud infrastructure, using supported technologies, without building and maintaining said infrastructure.</descrip></descripGrp><ntig><termGrp><term id="1785153">PaaS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2751341">PaaS</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33487_2748866_2751337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud-computing model that allows users to develop, run, manage, and deploy applications within a cloud infrastructure, using supported technologies, without building and maintaining said infrastructure.</descrip></descripGrp><ntig><termGrp><term id="2748866">platform-as-a-service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2751337">қызмет түріндегі платформа</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33487_2748866_2751341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud-computing model that allows users to develop, run, manage, and deploy applications within a cloud infrastructure, using supported technologies, without building and maintaining said infrastructure.