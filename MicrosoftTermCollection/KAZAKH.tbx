0614_2105147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Part of the existing Lync Web App IIS web component. Lets users optionally join meetings by using a mobile device.</descrip></descripGrp><ntig><termGrp><term id="1740614">Join Launcher</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2105147">қосылу агенті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33048_1743026_1764833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule that converts phone numbers to the local dialing format for interaction with private branch exchange (PBX) systems.</descrip></descripGrp><ntig><termGrp><term id="1743026">outbound translation rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1764833">шығыс қоңырауларды түрлендіру ережесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33048_1743026_2105148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule that converts phone numbers to the local dialing format for interaction with private branch exchange (PBX) systems.</descrip></descripGrp><ntig><termGrp><term id="1743026">outbound translation rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><t