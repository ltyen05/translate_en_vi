k"><ntig><termGrp><term id="615423">ереже</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13550_216566_626648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of conditions that hold back elements or modify the appearance of an existing list or data set in order to view a specific subset of the data.</descrip></descripGrp><ntig><termGrp><term id="216566">filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626648">сүзгі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13551_311012_1249255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area in the taskbar that shows icons for network connectivity, volume control, clock, and on laptops and Tablet computers, the battery.</descrip></descripGrp><ntig><termGrp><term id="311012">system control area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1249255">жүйенің басқару аумағы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13556_76489_2209843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An error, such as a faulty algorithm, that causes a program to produce incorrect results but does not prevent the program from running. Consequently, a logic error is often very difficult to find.</descrip></descripGrp><ntig><termGrp><term id="76489">logic error</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2209843">логикалық қате</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13561_174370_2101449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For Message Queuing, a property that specifies the cumulative limit for journal messages in a journal queue. The limit is based on cumulative journal message size. When a journal queue`s quota is reached, messages are no longer stored.</descrip></descripGrp><ntig><termGrp><term id="174370">journal quota</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101449">журнал квотасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13562_361562_639507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool used to categorize content into areas automatically.</descrip></descripGrp><ntig><termGrp><term id="361562">Topic Assistant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="639507">бөлімдер бойынша көмекші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13564_56172_1250172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To send a received content either modified or in its entirety, to a new recipient.</descrip></descripGrp><ntig><termGrp><term id="56172">forward</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250172">қайта жіберу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13567_530214_2194814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Provides instructions to hardware based on natural-language questions or commands.</descrip></descripGrp><ntig><termGrp><term id="530214">command relationship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2194814">пәрмен байланысы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13569_92850_627231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client program or control that receives digital media content streamed from a server or played from local files. Windows Media Player is an example of a player.</descrip></descripGrp><ntig><termGrp><term id="92850">player</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627231">ойнатқыш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13572_397152_407535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The task or process that the Microsoft Exchange EdgeSync service performs to propagate data from the Active Directory directory service to the subscribed Edge Transport server.</descrip></descripGrp><ntig><termGrp><term id="397152">EdgeSync synchronization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407535">EdgeSync қадамдастыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13575_210698_1030588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A period of time that an entire business is not available for service activities.</descrip></descripGrp><ntig><termGrp><term id="210698">business closure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030588">қызмет етпейтін күндер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13576_308346_2255319"><langSet xml:lang="en-US"><descripG