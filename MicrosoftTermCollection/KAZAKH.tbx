"><ntig><termGrp><term id="1990620">көп ағынды бөлім</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14970_237382_615666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Functions used to extract and display OLAP data (sets and values).</descrip></descripGrp><ntig><termGrp><term id="237382">Excel Cube Functions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615666">текшелермен жұмыс істейтін Excel функциялары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14974_84430_627081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On a local area network (LAN), a drive that other computers on the network can connect to. A network drive allows people to access shared files and folders.</descrip></descripGrp><ntig><termGrp><term id="84430">network drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627081">желілік дискі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14975_335533_638335"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that you can define to track information specific to your business.</descrip></descripGrp><ntig><termGrp><term id="335533">user-defined field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="638335">пайдаланушының өрісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14976_132530_1142667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a program or interface that allows creation and editing of web pages, text, or graphical user interfaces such that users can see what the end results will look like while the documents are being created.</descrip></descripGrp><ntig><termGrp><term id="132530">What You See Is What You Get</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1142667">толық сәйкестік күйі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14976_132530_1142668"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a program or interface that allows creation and editing of web pages, text, or graphical user interfaces such that users can see what the end results will look like while the documents are being created.</descrip></descripGrp><ntig><termGrp><term id="132530">What You See Is What You Get</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1142668">WYSIWYG күйі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14976_132531_1142667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a program or interface that allows creation and editing of web pages, text, or graphical user interfaces such that users can see what the end results will look like while the documents are being created.</descrip></descripGrp><ntig><termGrp><term id="132531">WYSIWYG</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1142667">толық сәйкестік күйі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14976_132531_1142668"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a program or interface that allows creation and editing of web pages, text, or graphical user interfaces such that users can see what the end results will look like while the documents are being created.</descrip></descripGrp><ntig><termGrp><term id="132531">WYSIWYG</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1142668">WYSIWYG күйі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14984_1415