finition">The service, powered by Azure, that enables presence and shared experiences from anywhere – on any device – through mixed reality applications; the app for Hololens that lets people connect, share, and collaborate in mixed reality that runs on that service.</descrip></descripGrp><ntig><termGrp><term id="3000152">Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3000553">Microsoft Mesh</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="528_67425_626805"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location where the user is currently directing input.</descrip></descripGrp><ntig><termGrp><term id="67425">input focus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626805">енгізу кезелімі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52810_3001101_3001905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Teams for Education that allows educators to quickly and easily communicate with their students’ parents and guardians.</descrip></descripGrp><ntig><termGrp><term id="3001101">Parents</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3001905">Ата-аналар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52811_3001102_3001892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Outlook that allows customers to book the time and means of transportation they need to travel between meetings or events, including options like walking, biking, driving, public transport, and even 3rd party resources like Lyft or Uber.</descrip></descripGrp><ntig><termGrp><term id="3001102">Commute</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3001892">Сапар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52812_3001103_3001898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Teams Rooms that provides users in the room with an enhanced meeting layout by bringing meeting information gathered from fluid components to the forefront of the screen and bringing the gallery to the bottom so people can meet face to face.</descrip></descripGrp><ntig><termGrp><term id="3001103">Front row</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3001898">Алдыңғы қатар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></l