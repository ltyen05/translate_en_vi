escripGrp><descrip type="definition">Text that is entered by drawing or writing on a screen, rather with a keyboard.</descrip></descripGrp><ntig><termGrp><term id="60255">handwriting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1906343">қолжазба</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6458_60255_2610740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text that is entered by drawing or writing on a screen, rather with a keyboard.</descrip></descripGrp><ntig><termGrp><term id="60255">handwriting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2610740">сандық қолжазба</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6460_66237_2093558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of settings that enable users to send, store, and receive email, and that define how to store and use addresses.</descrip></descripGrp><ntig><termGrp><term id="66237">information service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093558">ақпараттық қызмет</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6464_27901_1145122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A printed circuit board or adapter that can be plugged into a computer to provide added functionality or new capability. These cards provide specialized services, such as mouse support and modem capabilities, that are not built into the computer.</descrip></descripGrp><ntig><termGrp><term id="27901">card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1145122">карта</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6474_329880_626633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology allowing users to inject faults into an executable without requiring rebuilding the binary or modifying the source code; thus, providing a means of simulating errors and testing recovery.</descrip></descripGrp><ntig><termGrp><term id="329880">fault injection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626633">қателерді енгізу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6475_307228_615762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The heading for the last Mail Merge step, which allows the user to select how the merged publication or letters are produced.</descrip></descripGrp><ntig><termGrp><term id="307228">Complete the merge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615762">біріктіруді аяқтау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6477_413711_2396190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recording that is attached to your document.</descrip></descripGrp><ntig><termGrp><term id="413711">voice comment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2396190">дыбыстық комментарий</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6478_346951_626608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of scenarios that lead to a desired outcome by a customer segment.</descrip></descripGrp><ntig><termGrp><term id="346951">experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626608">әрекеттестік</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6479_397215_407651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains a record of the changes that were made to a database. All changes to the database are recorded in the transaction log files before they are written into the database files. If a database shuts down unexpectedly, unfinished transactions can be restored by replaying the transaction log files into the database.</descrip></descripGrp><ntig><termGrp><term id="397215">transaction log file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407651">өзгерістерді тіркеу файлы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="648_234820_1249148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that gives a general indication of the performance capability of your computer's hardware.</descrip></descripGrp><ntig><termGrp><term id="234820">system rating</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1249148">жүйені бағалау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6484_136942_2093560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A ready-made button that the user can insert into his/her presentation and define hyperlinks for.</descrip></descripGrp><ntig><termGrp><term id="136942">action button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093560">әрекет түймешігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6486_310254_627551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity at one end of a point-to-point LAN/WLAN segment that is requesting authenticated access to the network.</descrip></descripGrp><ntig><termGrp><term id="310254">supplicant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627551">сұрайтын құрылғы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6487_10412_2174603"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method that summarizes a group of values to return a single value.</descrip></descripGrp><ntig><termGrp><term id="10412">aggregation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2174603">аггрегация</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6489_557803_1030728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a relationship role, a relationship between a customer (account or contact) and an opportunity.</descrip></descripGrp><ntig><termGrp><term id="557803">opportunity relationship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030728">қарым-қатынас мүмкіндігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6490_183384_2176911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agreement between two owners to promote content in different places.</descrip></descripGrp><ntig><termGrp><term id="183384">affiliate marketing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2176911">аффилиат маркетингі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6502_315144_626884"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A word, symbol, or other group of characters used to identify a file, a storage medium, an element defined in a computer program, or a specific item in a document such as a spreadsheet or a chart.</descrip></descripGrp><ntig><termGrp><term id="315144">label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626884">белгі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6503_168869_2180153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database recovery mode that minimally logs bulk operations, such as index creation and bulk imports, while fully logging other transactions. Bulk-logged recovery increases performance for bulk operations, and is intended to be used an adjunct to the full recovery model.</descrip></descripGrp><ntig><termGrp><term id="168869">bulk-logged recovery model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2180153">толық емес протоколдаумен қалпына келтіру моделі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6505_33339_2190024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A B-tree-based index in which the logical order of the key values determines the physical order of the corresponding rows in a table.</descrip></descripGrp><ntig><termGrp><term id="33339">clustered index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2190024">кластерленген индекс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6506_1112929_2203938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of a system or device to be usable when it is needed. When expressed as a percentage, high availability is the actual service time divided by the required service time.</descr