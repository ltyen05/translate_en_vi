">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53152_3024532_3025249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Dynamics 365 Finance that allows finance managers to set up, manage billing schedules, invoice, recognize revenue, and renew contracts of recurring subscriptions. Subscription Billing makes compliance with ASC 606 and IFRS 15 easier with streamlined recurring revenue management tools.</descrip></descripGrp><ntig><termGrp><term id="3024532">subscription billing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3025249">жазылымға есеп-шот ұсыну</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53154_3024608_3025394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item of original video programming, such as the video content created by Microsoft technical experts for docs.microsoft.com.</descrip></descripGrp><ntig><termGrp><term id="3024608">show</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3025394">көрсету</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53156_3025516_3025869"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The augmented reality development kit, including both the hardware device and software platform, released to third-party developers under NDA.</descrip></descripGrp><ntig><termGrp><term id="3025516">ARDK</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3025869">ARDK</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53162_3025821_3026090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The intelligent optimization service that maximizes order fulfillment within the supply chain network.</descrip></descripGrp><ntig><termGrp><term id="3025821">Intelligent Fulfillment Optimization</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3026090">Интеллектуалды орындауды оңтайландыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53163_3025822_3026099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Power Automate flow that pulls messages at a regularly defined interval from an external service.</descrip></descripGrp><ntig><termGrp><term id="3025822">provider message puller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3026099">провайдер хабарын тарту құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber