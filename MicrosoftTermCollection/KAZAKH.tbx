n">A provider that monitors a source of events and notifies the event table when events occur.</descrip></descripGrp><ntig><termGrp><term id="182190">event provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202965">оқиғаларды жеткізуші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12055_235062_627498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wizard that helps the user to adjust their speakers for the best sound by running automatic calibration tests for levels, delay, and frequency response.</descrip></descripGrp><ntig><termGrp><term id="235062">Speaker Calibration wizard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627498">үндеткіштерді теңшеу шебері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12060_530274_2202530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of enabled policies for a target.</descrip></descripGrp><ntig><termGrp><term id="530274">effective policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202530">жарамды саясат</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12063_38186_2914121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In hardware, a coupler used to join cables or to join a cable to a device (for example, an RS-232-C connector used to join a modem cable to a computer). Most connector types are available in one of two genders--male or female. A male connector is characterized by one or more exposed pins; a female connector is characterized by one or more receptacles--sockets or jacks-- designed to accept the pins on the male connector.</descrip></descripGrp><ntig><termGrp><term id="38186">connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2914121">жалғағыш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12065_235429_1598548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that summarizes the status of an account, including current balance and recent activities.</descrip></descripGrp><ntig><termGrp><term id="235429">statement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1598548">мәлімдеме</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12067_169248_2221184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a restore operation, a file used during the undo phase to hold a "copy-on-write" pre-image of pages that are to be modified. The standby file allows reverting the undo pass to bring back the uncommitted transactions.</descrip></descripGrp><ntig><termGrp><term id="169248">standby file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221184">резервтік файл</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12068_27187_626193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marketing program designed to accomplish a specific result, such as introducing a new product or increasing market share.</descrip></descripGrp><ntig><termGrp><term id="27187">campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626193">науқан</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12068_27187_626996"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marketing program designed to accomplish a specific result, such as introducing a new product or increasing market share.</descrip></descripGrp><ntig><termGrp><term id="27187">campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626996">маркетингілік науқан</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12068_335551_626193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marketing program designed to accomplish a specific result, such as introducing a new product or increasing market share.</descrip></descripGrp><ntig><termGrp><term id="335551">marketing campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626193">науқан</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12068_335551_626996"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marketing program designed to accomplish a specific result, such as introducing a new product or increasing market share.</descrip></descripGrp><ntig><termGrp><term id="335551">marketing campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626996">маркетингілік науқан</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12069_150202_1771316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pairing of two or more actions that are performed together as a single action; the action succeeds or fails as a whole.</descrip></descripGrp><ntig><termGrp><term id="150202">transaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1771316">транзакция</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12070_233232_1142661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-entered value or value from a static source that does not change unless manually altered by the user.</descrip></descripGrp><ntig><termGrp><term id="233232">fixed value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1142661">тұрақты мән</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12079_559851_2223421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way to visually represent data in debug mode.</descrip></descripGrp><ntig><termGrp><term id="559851">visualizer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2223421">визуализатор</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12083_85887_2098715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity, such as a file, folder, shared folder, printer, or Active Directory object, described by a distinct, named set of attributes. For example, the attributes of a File object include its name, location, and size; the attributes of an Active Directory User object might include the user's first name, last name, and email address.</descrip></descripGrp><ntig><termGrp><term id="85887">object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098715">нысан</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12094_1049764_2731822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of servers that are in one location and that are networked together for the purpose of sharing workload.</descrip></descripGrp><ntig><termGrp><term id="1049764">remote desktop server farm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2731822">серверлер кластері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12094_1049764_639499"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of servers that are in one location and that are networked together for the purpose of sharing workload.</descrip></descripGrp><ntig><termGrp><term id="1049764">remote desktop server farm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><te