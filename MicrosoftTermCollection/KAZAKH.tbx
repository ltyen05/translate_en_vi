ripGrp><descrip type="definition">A measurable business consequence that a team is working towards.</descrip></descripGrp><ntig><termGrp><term id="3129859">result</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3166215">өлшем</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53357_3129860_3166215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measurable business consequence that a team is working towards.</descrip></descripGrp><ntig><termGrp><term id="3129860">metric</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3166215">өлшем</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53357_3129933_3166215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measurable business consequence that a team is working towards.</descrip></descripGrp><ntig><termGrp><term id="3129933">outcome</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3166215">өлшем</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53357_3165492_3166215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measurable business consequence that a team is working towards.</descrip></descripGrp><ntig><termGrp><term id="3165492">measure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3166215">өлшем</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53366_3041361_3041696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer game that is put into a window that can be moved around and resized depending on what the user wants, also allowing for other things (like the Game Bar, overlays, or notifications) to be displayed on top of the game.</descrip></descripGrp><ntig><termGrp><term id="3041361">windowed game</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3041696">терезедегі ойын</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53367_3041362_3041695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Gaming that utilizes a display format in which the game is put into a window that can be moved around and resized.</descrip></descripGrp><ntig><termGrp><term id="3041362">windowed gaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3041695">терезеде ойын ойнау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53368_3041363_3041694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Gaming that utilizes a display format in which the game/application is run in a window at full-screen size without a border, creating the experience of full-screen gaming while also allowing for other overlays on top of the game, similar to the windowed gaming experience.</descrip></descripGrp><ntig><termGrp><term id="3041363">borderless-windowed gaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3041694">жиексіз терезеде ойын ойнау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53370_3041605_3112148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft personalized feed website that is designed to make it easy to gather news and information content from premium publishers in one place.</descrip></descripGrp><ntig><termGrp><term id="3041605">Microsoft Start</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3112148">Microsoft Start</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry 