and TDMA, which allows eight simultaneous calls on the same radio frequency.</descrip></descripGrp><ntig><termGrp><term id="217332">Global System for Mobile Communications</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1839203">GSM</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7389_217333_1839203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital cellular phone technology (standard) first deployed in 1992. GSM uses narrowband TDMA, which allows eight simultaneous calls on the same radio frequency.</descrip></descripGrp><ntig><termGrp><term id="217333">GSM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1839203">GSM</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7391_530237_2200792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stream of data that is returned by an ADO.NET query.</descrip></descripGrp><ntig><termGrp><term id="530237">datareader</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2200792">datareader</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7392_169116_2214288"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of automating administration across multiple instances of SQL Server.</descrip></descripGrp><ntig><termGrp><term id="169116">multiserver administration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2214288">бірнеше серверді басқару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7395_46512_626485"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notice that warns that the manufacturer of the product limits liability in certain situations/uses.</descrip></descripGrp><ntig><termGrp><term id="46512">disclaimer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626485">қабылдамау хабарламасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7408_169136_2215344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A backup of all the data in the primary filegroup, every read-write filegroup, and any optionally specified files. A partial backup of a read-only database contains only the primary filegroup.</descrip></descripGrp><ntig><termGrp><term id="169136">partial backup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215344">толық емес резервтік көшірме</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7413_43971_2222773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To restore the contents of a compressed file to its original form.</descrip></descripGrp><ntig><termGrp><term id="43971">decompress</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2222773">қысылған файлды қалпына келтіру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7413_736800_2222773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To restore the contents of a compressed file to its original form.</descrip></descripGrp><ntig><termGrp><term id="736800">uncompress</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2222773">қысылған файлды қалпына келтіру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7415_40207_2093605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that is used on a Web page to count the number of times that the Web page was accessed.</descrip></descripGrp><ntig><termGrp><term id="40207">counter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093605">есептегіш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7416_73948_626919"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To align text along the left margin.</descrip></descripGrp><ntig><termGrp><term id="73948">left align</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626919">сол жақ шетпен туралау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7417_315143_626883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tag or string affixed to an item to provide identifying or descriptive information.</descrip></descripGrp><ntig><termGrp><term id="315143">label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626883">жапсырма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7421_184828_626838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To ask someone to engage in an instant conversation.</descrip></descripGrp><ntig><termGrp><term id="184828">invite</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626838">шақыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7424_173128_2093606"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to processes where data must be delivered within certain time constraints. Multimedia streams require an isochronous transport mechanism to ensure that data is delivered as fast as it is displayed, and to ensure that the audio is synchronized with the video.</descrip></descripGrp><ntig><termGrp><term id="173128">isochronous</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093606">изохронды</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7430_237835_2093607"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shape on a stencil that you use repeatedly to create drawings.</descrip></descripGrp><ntig><termGrp><term id="237835">master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093607">үлгі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7431_169302_2212519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data written by a backup operation to a backup device used by a media set. In a media set with only a single device, only one media family exists. In a striped media set, multiple media families exist. If the striped media set is unmirrored, each device corresponds to a family. A mirrored media set contains from two to four identical copies of each media family (called mirrors). Appending backups to a media set extends its media families.</descrip></descripGrp><ntig><termGrp><term id="169302">media family</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2212519">тасымалдаушылар тобы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7432_51249_626589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The key that is used at the end of a line or command to instruct the computer to process the command or text. In word processing programs, the Enter key is used at the end of a paragraph. Also called: Return key.</descrip></descripGrp><ntig><termGrp><term id="51249">ENTER key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626589">ENTER пернесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7435_169352_2215345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A restore of only a portion of a database consisting of its primary filegroup and one or more secondary filegroups. The other filegroups remain permanently offline, though they can be restored later.</descrip></descripGrp><ntig><termGrp><term id="169352">partial database restore</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215345">дерекқорды жартылай қалпына келтіру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7436_481871_2219162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The statistical process of predicting one or more continuous variables, such as profit or loss, based on other attributes in the dataset.</descrip></descripGrp><ntig><termGrp><term id="481871">regression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2219162">регрессия</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7437_1167269_1167901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An specific occurrence of an external content type.</descrip></descripGrp><ntig><termGrp><term id="1167269">external item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1167901">сыртқы элемент</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7438_530776_2220602"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A replication in which data is distributed exactly as it appears at a specific moment in time and does not monitor for updates to the data.</descrip></descripGrp><ntig><termGrp><term id="530776">snapshot replication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2220602">сурет репликациясы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7443_33751_626270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A table that relates the character codes (code point values) used by a program to keys on the keyboard or to characters on the display. This provides support for character sets and keyboard layouts for different countries or regions.</descrip></descripGrp><ntig><termGrp><term id="33751">code page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626270">кодтік бет</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7447_233440_639510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file where a user can create or modify information without affecting data that is located on the server. A client-side copy of the files in the repository that you want to work in.</descrip></descripGrp><ntig><termGrp><term id="233440">workspace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="639510">жұмыс кеңістігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7450_269324_626679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Engaging in fraud or deceptive.</descrip></descripGrp><ntig><termGrp><term id="269324">fraudulent</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626679">алдамшылық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7457_21819_1713578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric value intended for a bit-by-bit value comparison with other numeric values, typically to flag options in parameter or return values. Usually this comparison is done with bitwise logical operators, such as And and Or in Visual Basic, &amp;&amp; and || in C++.</descrip></descripGrp><ntig><termGrp><term id="21819">bit mask</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1713578">биттер бүркеніші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7457_21820_1713578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric value intended for a bit-by-bit value comparison with other numeric values, typically to flag options in parameter or return values. Usually this comparison is done with bitwise logical operators, such as And and Or in Visual Basic, &amp;&amp; and || in C++.</descrip></descripGrp><ntig><termGrp><term id="21820">bitmask</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1713578">биттер бүркеніші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="746_316258_627285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text or symbols indicating that a computer program is waiting for input from the user.</descrip></descripGrp><ntig><termGrp><term id="316258">prompt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627285">шақыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7467_148839_615576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text character that sets apart a string embedded within a string.</descrip></descripGrp><ntig><termGrp><term id="148839">string delimiter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615576">жол бөлгіш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7473_293545_615775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of an application window that enables the users to perform additional tasks.</descrip></descripGrp><ntig><termGrp><term id="293545">task pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615775">тапсырмалар аймағы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7474_210454_615616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status of a feature to exempt items on SPS from being subject to the policy set on the site.</descrip></descripGrp><ntig><termGrp><term id="210454">hold status</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615616">ұстап тұру күйі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7475_114856_2093608"><langSet xml:lang="en