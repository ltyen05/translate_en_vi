iency type for a volume that stripes data and parity information across physical disks in a Microsoft Storage Spaces storage pool.</descrip></descripGrp><ntig><termGrp><term id="1596721">parity</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1655106">жұптық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31102_1596722_1655165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that enables administration of storage subsystems through a common management API.</descrip></descripGrp><ntig><termGrp><term id="1596722">storage provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1655165">сақтау жеткізушісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31103_1596723_1655164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of physical disks that can be managed together.</descrip></descripGrp><ntig><termGrp><term id="1596723">storage pool</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1655164">сақтау пулы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Sing