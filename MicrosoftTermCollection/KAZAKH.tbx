 type="definition">A Flipgrid view that automatically plays videos as the user scrolls.</descrip></descripGrp><ntig><termGrp><term id="2817597">Glance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2821470">"Қысқаша шолу" көрінісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49841_2817599_2821478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Flipgrid, a dedicated space shared by a teacher and his or her students, where teachers can pose questions, called "topics," and the students can post video responses that appear in a tiled grid display.</descrip></descripGrp><ntig><termGrp><term id="2817599">Grid</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2821478">тор</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49842_2817594_2821503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Flipgrid, one of a set of pre-defined visuals, symbols, including emojis, that users can select to indicate their reaction to a video, topic, or other input.</descrip></descripGrp><ntig><termGrp><term id="2817594">Reaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2821503">реакция</term><termNote type="geographicalUsage">KAZ</