ig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2475124">ұнатпау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42631_2414544_2776788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A duplicate copy of a volume, share, or repository in a version control system.</descrip></descripGrp><ntig><termGrp><term id="2414544">clone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2776788">клон</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42632_2414547_2697301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A provider of cloud computing services.</descrip></descripGrp><ntig><termGrp><term id="2414547">cloud service provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2697301">бұлттық қызмет провайдері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42632_2685175_2697301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A provider of cloud computing services.</descrip></descripGrp><ntig><termGrp><term id="2685175">cloud provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="gramma