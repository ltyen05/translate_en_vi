ig><termGrp><term id="2763714">confidence threshold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2769486">сенімділік шегі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48804_2763715_2769490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Shift campaign tagline that is meant to highlight the simplicity and ease of updating devices to modern desktops and to moving on-premises solutions to a cloud experience.</descrip></descripGrp><ntig><termGrp><term id="2763715">Now is the time to shift</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2769490">Бұлттық технологияларға өтетін кез келді</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48809_2764350_2770032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A brief patient description that may include up to four fields that is meant to help quickly identify a specific patient.</descrip></descripGrp><ntig><termGrp><term id="2764350">patient header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2770032">емделуші тақырыбы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4888_181862_2220601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transaction isolation level in which each read operation performed by a transaction returns all data as it existed at the start of the transaction. Because a snapshot transaction does not use locks to protect read operations, it will not block other transactions from modifying any data read by the snapshot transaction.</descrip></descripGrp><ntig><termGrp><term id="181862">snapshot isolation level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2220601">суретті оқшаулау деңгейі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48890_2765048_2813688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability that allows you to prepare data at scale iteratively without any coding required via Spark execution.</descrip></descripGrp><ntig><termGrp><term id="2765048">wrangling data flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2813688">деректер ағынын дайындау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48905_2765592_2770023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application that accepts PSTN call