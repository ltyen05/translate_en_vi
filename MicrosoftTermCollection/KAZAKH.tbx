xml:lang="en-US"><descripGrp><descrip type="definition">The set of Sway features that are driven by an intelligence platform and that makes suggestions on how to edit, use, or add content based on what’s in the user’s sway.</descrip></descripGrp><ntig><termGrp><term id="2276526">Suggested</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2281437">Ұсыныстар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39213_2276529_2281393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint site that allows users to publish a collection of responsive pages with embedded document references and organize them with a cover page and permissions.</descrip></descripGrp><ntig><termGrp><term id="2276529">microsite</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2281393">микросайт</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39214_2276647_2665020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specific package that is made available to a selected set of end users. Often used to validate functionality or behavior before the product official release.</descrip></descripGrp><ntig><termGrp><term id="2276647">flight</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></la