></langSet></termEntry><termEntry id="7016_184182_615810"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The hierarchical HTML tag structure of an opened HTML document that appears in a window docked beneath the quick tag selector.</descrip></descripGrp><ntig><termGrp><term id="184182">Quick Tag Tree</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615810">жедел тегтер тармағы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7019_138120_2093588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical control that enables a user to provide input to an application.</descrip></descripGrp><ntig><termGrp><term id="138120">button control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093588">"Түймешік" басқару элементі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7020_157216_757839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To configure or create a user, tenant, or other account and enable it with access to one or more services; to perform operations on and apply backend configurations to a device to get it ready for use or ready for a new service; to perform backend operations to get a security service ready for use.</descrip></descripGrp><ntig><termGrp><term id="157216">provision</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="757839">дайындау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7021_188051_776551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows PowerShell, the operating environment in which each command in a pipeline is executed.</descrip></descripGrp><ntig><termGrp><term id="188051">runspace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="776551">орындау кеңістігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7026_45000_1249204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove from association with something.</descrip></descripGrp><ntig><termGrp><term id="45000">detach</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1249204">алып тастау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7027_104571_1158460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, a code that is used to report the outcome of a procedure or to influence subsequent events when a routine or process terminates (returns) and passes control of the system to another routine. Return codes can, for example, indicate whether an operation was successful or not and can thus be used to determine what is to be done next.</descrip></descripGrp><ntig><termGrp><term id="104571">return code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1158460">аяқтау коды</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7028_181492_2218802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A relationship between a dimension and a measure group in which the dimension is coupled to the measure group through another dimension.</descrip></descripGrp><ntig><termGrp><term id="181492">reference dimension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2218802">сілтемелік өлшем</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7029_397153_407627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource mailbox that is assigned to a non-location-specific resource such as a laptop projector, microphone, or company car. Equipment mailboxes can be included as resources in meeting requests, providing a simple and efficient way to utilize resources for an organization.</descrip></descripGrp><ntig><termGrp><term id="397153">equipment mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407627">жабдықтың пошта жәшігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7030_1132703_1660660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pocket-sized wireless electronic device that uses radio signals to record incoming phone numbers or short text messages. Some pagers allow users to send messages as well.</descrip></descripGrp><ntig><termGrp><term id="1132703">alphanumeric pager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1660660">пейджер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7030_663647_1660660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pocket-sized wireless electronic device that uses radio signals to record incoming phone numbers or short text messages. Some pagers allow users to send messages as well.</descrip></descripGrp><ntig><termGrp><term id="663647">beeper</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1660660">пейджер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig><