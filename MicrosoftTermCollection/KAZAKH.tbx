 id="387515">voicemail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407518">дауыстық пошта</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25374_1173446_1587690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To send an instant message.</descrip></descripGrp><ntig><termGrp><term id="1173446">IM</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1587690">жедел хабар жіберу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25374_1266974_1587690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To send an instant message.</descrip></descripGrp><ntig><termGrp><term id="1266974">instant message</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1587690">жедел хабар жіберу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2538_31910_2183519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name used to refer to a class module. If the class module is a form or report module, the class name is prefaced with the type of module. For example, the class name for a module associated with a form called OrderForm would be Form_OrderForm, while one associated with a report called OrderReport would be Report_OrderReport.</descrip></descripGrp><ntig><termGrp><term id="31910">class name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2183519">класс атауы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2540_564317_1030731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An alphanumeric identifier that is used to determine whether a record is unique. Each matchcode is derived from the data in selected fields in a record.</descrip></descripGrp><ntig><termGrp><term id="564317">matchcode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030731">іздеу коды</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25402_1176598_1764744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In typography, a single character created from two joined letters that replaces the two separate letters.</descrip></descripGrp><ntig><termGrp><term id="1176598">ligature</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1764744">лигатура</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2541_177258_2070189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any input provided by the administrator during the recovery process, such as the recovery destination, schedule for recovery, and overwrite options.</descrip></descripGrp><ntig><termGrp><term id="177258">recovery option</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070189">қалпына келтіру параметрі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2542_82590_1771367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of selecting nonadjacent and adjacent files and objects.</descrip></descripGrp><ntig><termGrp><term id="82590">multiple selection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1771367">бірнеше элементті таңдау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25422_1176687_1490932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2010 edition of the suite of Microsoft productivity software that supports common business tasks, including word processing, email, presentations, and data management and analysis, designed for home and students.</descrip></descripGrp><ntig><termGrp><term id="1176687">Microsoft Office Home and Student 2010</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1490932">Үйге және оқуға арналған Microsoft Office 2010</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25422_1230089_1490932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2010 edition of the suite of Microsoft productivity software that supports common business tasks, including word processing, email, presentations, and data management and analysis, designed for home and students.</descrip></descripGrp><ntig><termGrp><term id="1230089">Office Home and Student 2010</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1490932">Үйге және оқуға арналған Microsoft Office 2010</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25447_1606736_1674519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A free online service that enables Office users to share presentations with people who view them on the web.</descrip></descripGrp><ntig><termGrp><term id="1606736">Office Presentation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674519">Office көрсетілім қызметі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2545_174969_2070190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A driver that meets the criteria of the Windows Logo Program. For performance and stability, Microsoft strongly recommends that you use only signed drivers for new or updated drivers.</descrip></descripGrp><ntig><termGrp><term id="174969">signed driver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070190">қол қойылған драйвер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2547_45334_626458"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sound emitted by the receiver of a telephone that indicates that a number can be dialed.</descrip></descripGrp><ntig><termGrp><term id="45334">dial tone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626458">желі дыбысы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="255_53387_719903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of computer hardware or software to ensure data integrity when hardware failures occur. Fault-tolerant features appear in many server operating systems and include mirrored volumes, RAID-5 volumes, and server clusters.</descrip></descripGrp><ntig><termGrp><term id="53387">fault tolerance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="719903">бұзылу төзімділігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2550_9793_625990"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode of setup that allows network administrators to silently deploy to client computers.</descrip></descripGrp><ntig><termGrp><term id="9793">administrative setup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="625990">әкімші орнатпасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2550_9794_625990"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode of setup that allows network administrators to silently deploy to client computers.</descrip></descripGrp><ntig><termGrp><term id="9794">administrator setup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="625990">әкімші орнатпасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote t