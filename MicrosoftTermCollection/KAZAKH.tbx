ructions.</descrip></descripGrp><ntig><termGrp><term id="2067029">turn-by-turn</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2080741">навиг. нұсқауы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35724_2067030_2080696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera option that enables users to capture moving subjects by snapping multiple photos on shutter press and allowing the user to pick the best one or just accept the photo recommended by the software.</descrip></descripGrp><ntig><termGrp><term id="2067030">burst mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2080696">үздіксіз режим</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35725_2067031_2080759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone's LED light used during video capture to help exposure in dark conditions.</descrip></descripGrp><ntig><termGrp><term id="2067031">video light</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2080759">бейне жарығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNot