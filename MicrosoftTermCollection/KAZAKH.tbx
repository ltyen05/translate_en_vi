tig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3081313">Microsoft Viva Goals</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53263_3036101_3036806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool that gives Microsoft 365 customers visibility into the carbon emissions their organization generates by using Microsoft 365 cloud services, as well as estimates of emissions averted by migrating certain applications from on-prem to the cloud.</descrip></descripGrp><ntig><termGrp><term id="3036101">Emissions Impact Dashboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3036806">Сәулелену әсерінің тақтасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5328_95109_2217325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, an instruction that causes a procedure to be executed. A procedure call can be located in another procedure or in the main body of the program.</descrip></descripGrp><ntig><termGrp><term id="95109">procedure call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2217325">процедураны шақыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53281_3036616_3036738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The quarterly threat intelligence brief on cyber threat intelligence that is created and published by the PR team every 2-3 months, focused on journalists as the primary audience.</descrip></descripGrp><ntig><termGrp><term id="3036616">Microsoft Security Cyber Signals</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3036738">Microsoft Security Cyber Signals</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53282_3036617_3036655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security thought leadership website experience that hosts the Microsoft Security Cyber Signals report as well as other related and high impact cyber threat intelligence content (other threat intel reports, blog posts, podcasts, videos etc.), focused on security decision makers as the primary audience.</descrip></descripGrp><ntig><termGrp><term id="3036617">Microsoft Security Insider</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3036655">Microsoft Security Insider</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53286_3037467_3037813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that [DUMMY DEFINITION].</descrip></descripGrp><ntig><termGrp><term id="3037467">ISOMITTED</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3037813">ISOMITTED</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53287_3037468_3037817"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that [DUMMY DEFINITION].</descrip></descripGrp><ntig><termGrp><term id="3037468">SCAN</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3037817">SCAN</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53288_3037469_3037816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that [DUMMY DEFINITION].</descrip></descripGrp><ntig><termGrp><term id="3037469">REDUCE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3037816">REDUCE</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53289_3038216_3038295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that allows a user to insert an image into a cell.</descrip></descripGrp><ntig><termGrp><term id="3038216">IMAGE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3038295">IMAGE</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5330_33370_2190068"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The grouping of multiple servers in a way that allows them to appear to be a single unit to client computers on a network. Clustering is a means of increasing network capacity, providing live backup in case one of the servers fails, and improving data security.</descrip></descripGrp><ntig><termGrp><term id="33370">clustering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2190068">кластерлеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53322_3038890_3039384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Security solutions, encryption, and other technologies, as well as policies and processes, used to secure information and information systems.</descrip></descripGrp><ntig><termGrp><term id="3038890">information protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3039384">мәлімет қорғау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5333_318785_626717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ≥ character.</descrip></descripGrp><ntig><termGrp><term id="318785">greater than or equal to sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626717">үлкендік немесе тендік белгісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5333_59384_626717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ≥ character.</descrip></descripGrp><ntig><termGrp><term id="59384">GREATER-THAN OR EQUAL TO</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626717">үлкендік немесе тендік белгісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53336_3038931_3039390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The overall strategy for managing information at an organization.</descrip></descripGrp><ntig><termGrp><term id="3038931">information governance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp>