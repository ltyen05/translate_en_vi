 that is designed to manage privileged identities and their access rights.</descrip></descripGrp><ntig><termGrp><term id="2425496">Azure AD Privileged Identity Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2425811">Azure Active Directory Privileged Identity Management</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38996_2425496_2425812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The technology that is designed to manage privileged identities and their access rights.</descrip></descripGrp><ntig><termGrp><term id="2425496">Azure AD Privileged Identity Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2425812">Azure AD Privileged Identity Management</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38997_2267576_2267871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of access permission to sensitive resources, such as AD DS management console, a sensitive SP site or sensitive file-share.</descrip></descripGrp><ntig><termGrp><term id="2267576">privileged role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2267871">артықшылығы бар рөл</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38998_2267577_2267847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user, who can inherit the access permissions of a certain role, after performing all necessarily authNZ activities.</descrip></descripGrp><ntig><termGrp><term id="2267577">assigned user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2267847">тағайындалған пайдаланушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38999_2267578_2267829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act when an assigned user successfully receives the access rights of a privileged role.</descrip></descripGrp><ntig><termGrp><term id="2267578">activation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2267829">активация</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="390_18288_2430684"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Referring to anything that is ready for immediate use by a user or application.</descrip></descripGrp><ntig><termGrp><term id="18288">available</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2430684">қолжетімді</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39000_2267579_2267841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication or authorization gate that the an assigned user has to complete in order to activate a role.</descrip></descripGrp><ntig><termGrp><term id="2267579">activation gate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2267841">активация қақпасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39001_2267580_2267886"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user, who administers all of the privileged access management systems and is able to define PIM roles, and candidates.</descrip></descripGrp><ntig><termGrp><term id="2267580">security administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2267886">қауіпсіздік әкімшісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39002_2267582_2267875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user, who can define the assigned users for a privileged role and gates for activation.</descrip></descripGrp><ntig><termGrp><term id="2267582">role owner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2267875">рөл иесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39003_2267586_2267850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To withdraw from the role access rights and return back to the normal state of no access rights of this role.</descrip></descripGrp><ntig><termGrp><term id="2267586">deactivate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2267850">ажырату</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39009_2268249_2268374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service underlying the process of reconciling a user's credentials that define the user's access to a given service or application from an Active Directory directory service and keep them up-to-date automatically.</descrip></descripGrp><ntig><termGrp><term id="2268249">Identity synchronization</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2268374">Куәліктерді синхрондау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39011_2321515_2324108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Music, a highly personalized form of auto-playlist (rules-based playlist) that is created by Microsoft for the customer, drawing music from the customer's music collection, and, if the customer has an active music pass, may also include songs from our music catalog.</descrip></descripGrp><ntig><termGrp><term id="2321515">mixtape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2324108">микстейп</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39012_2268334_2269660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Cellular data that customers can buy from the Windows Store to connect to their Windows device.</descrip></descripGrp><ntig><termGrp><term id="2268334">paid cellular data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2269660">төленген ұялы деректер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39013_2268335_2269661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Wi-Fi data or cellular data network that customers can connect to by buying minutes from the Windows Store.</descrip></descripGrp><ntig><termGrp><term id="2268335">paid data network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2269661">төленген дерек желісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39015_2268349_2269663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area in the Music app where recently played songs/albums and service-generated mixes are aggregated.</descrip></descripGrp><ntig><termGrp><term id="2268349">quick play</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2269663">жылдам ойнату</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3902_139982_1250055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presentation within a presentation in which you group slides in an existing presentation so that you can show that section of the presentation to a particular audience.</descrip></descripGrp><ntig><termGrp><term id="139982">custom show</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250055">арнайы көрсету</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3906_30558_626234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distance between characters in a line of text.</descrip></descripGrp><ntig><termGrp><term id="30558">character spacing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626234">таңба аралығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39063_2269425_2281407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2016 edition of Microsoft Office available to students who attend an educational institution.</descrip></descripGrp><ntig><termGrp><term id="2269425">Office Professional Academic 2016</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2281407">Office Professional Academic 2016</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39063_2482683_2281407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2016 edition of Microsoft Office available to students who attend an educational institution.</descrip></descripGrp><ntig><termGrp><term id="2482683">Office Professional Academic 2016 for PC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2281407">Office Professional Academic 2016</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39074_2269904_2604142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that resides in persistent storage on physical media, in any digital format. This includes files on magnetic or optical media, archived data, and data backups.</descrip></descripGrp><ntig><termGrp><term id="2269904">data at rest</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2604142">белсенді емес деректер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39077_2270185_2270949"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The preview of Power BI Desktop, the dedicated report authoring tool for the Power BI service.</descrip></descripGrp><ntig><termGrp><term id="2270185">Power BI Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2270949">Power BI құрастырушысы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39078_2270188_2350993"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client agent that enables Power BI to connect to on-premises SQL Server Analysis Services instances.</descrip></descripGrp><ntig><termGrp><term id="2270188">Analysis Services Connector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2350993">Analysis Services Connector</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39079_2270271_2281370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook folder where low priority messages are moved either via the Clutter filter or by the user, based on individual user preferences.</descrip></descripGrp><ntig><termGrp><term id="2270271">Clutter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2281370">Қажетсіз</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3909_7248_407585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows-based computers, a 32-bit value (a bitmask) that specifies the permissions that are assigned in an access control entry (ACE). An access mask is also part of the access request when an object is opened. The access mask in the request is compared to the access mask in each ACE to determine whether or not to grant the request.</descrip></descripGrp><ntig><termGrp><term id="7248">access mask</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407585">қатынау бүркеншігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39094_2270444_2338944"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range of statistical and analytical techniques from modeling, machine learning, and data mining that analyze current and historical data to forecast future trends or events.</descrip></descripGrp><ntig><termGrp><term id="2270444">predictive analytics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2338944">болжамды аналитика</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39097_2270759_2277137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2016 edition of the Microsoft relational database management system.</descrip></descripGrp><ntig><termGrp><term id="2270759">Access 2016</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2277137">Access 2016 (қазақша нұсқасы)</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39098_2270799_22