/ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2201502">жеткізу модулі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9788_149588_2093959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom object defined by the user.</descrip></descripGrp><ntig><termGrp><term id="149588">user-defined object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093959">пайдаланушы анықтайтын нысан</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9789_158215_625997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The company placing, and often paying for, a promotional message, or advertisement.</descrip></descripGrp><ntig><termGrp><term id="158215">advertiser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="625997">жарнама беруші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9794_180555_2174639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-defined data type based on one of the SQL Server system data types that can specify a certain data type, length, and nullability.</descrip></descripGrp><ntig><termGrp><te