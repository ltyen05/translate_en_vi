nder">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40227_2339683_2345814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The slide transition in PowerPoint that smoothly animates objects across slides.</descrip></descripGrp><ntig><termGrp><term id="2339683">Morph</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2345814">Түрлендіру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40236_2340522_2417283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature to protect sensitive data stored in Azure SQL Database or SQL Server databases, allowing clients to encrypt this data inside client applications and never reveal the encryption keys to the database engine, thus providing a separation between those who own the data and those who manage it.</descrip></descripGrp><ntig><termGrp><term id="2340522">Always Encrypted</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2417283">Always Encrypted</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40237_2340528_2342772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SSIS component that allows the OLE DB Provider for SSIS to consume output of an SSIS package as a tabular result set by creating a linked server that uses the OLE DB Provider for SSIS and then running a SQL query on the linked server to display data returned by the SSIS package.</descrip></descripGrp><ntig><termGrp><term id="2340528">Data Streaming Destination</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2342772">Деректердің ағындық берілуін тағайындау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40238_2340529_2342773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that extracts log messages collected from different sources and writes them into a single file.</descrip></descripGrp><ntig><termGrp><term id="2340529">direct log consumer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2342773">журналды тікелей өңдегіш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40238_2600603_2342773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that extracts log messages collected from different sources and writes them into a single file.</descrip></descripGrp><ntig><termGrp><term id="2600603">DLC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2342773">журналды тікелей өңдегіш</term><termN