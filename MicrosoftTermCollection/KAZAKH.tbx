="definition">A window that shows a hierarchical view of a document and updates to reflect the current drawing hierarchy as items (such as shapes or pages) are added or deleted.</descrip></descripGrp><ntig><termGrp><term id="237933">Drawing Explorer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093592">құжаттар арасында жетектеуші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7115_1177131_1250101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bit string that is used in conjunction with an encryption algorithm to encrypt and decrypt data.</descrip></descripGrp><ntig><termGrp><term id="1177131">data encryption key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250101">шифрлау кілті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7115_1177131_2201125"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bit string that is used in conjunction with an encryption algorithm to encrypt and decrypt data.</descrip></descripGrp><ntig><termGrp><term id="1177131">data encryption key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2201125">DEK</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSp