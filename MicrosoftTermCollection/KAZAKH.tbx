operNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250226">DAO</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17845_650205_2101736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the window that displays the result set of your query.</descrip></descripGrp><ntig><termGrp><term id="650205">data pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101736">деректер аумағы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17846_650206_2101737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Charts And Graphs template, a control handle on the Line Graph shape that you can drag to change the values in the graph.</descrip></descripGrp><ntig><termGrp><term id="650206">data point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101737">деректер нүктесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17848_650208_2101738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of creating two or more special copies (replicas) of an Access database. Replicas can be synchronized, changes made to data in one replica, or design changes made in the Design Master, are sent to other replicas.</descrip></descripGrp><ntig><termGrp><term id="650208">database replication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101738">дерекқор репликациясы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17849_650209_2101739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An exchange of information between processes that represent discrete packets of data that flow into and out of processes.</descrip></descripGrp><ntig><termGrp><term id="650209">dataflow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101739">деректер ағымы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17849_674637_2101739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An exchange of information between processes that represent discrete packets of data that flow into and out of processes.</descrip></descripGrp><ntig><termGrp><term id="674637">data flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101739">деректер ағымы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17850_650210_2101740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool for functional analysis that shows the general flow of information through a system or program.</descrip></descripGrp><ntig><termGrp><term id="650210">dataflow diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101740">деректер ағымы диаграммасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17850_674639_2101740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool for functional analysis that shows the general flow of information through a system or program.</descrip></descripGrp><ntig><termGrp><term id="674639">data flow diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101740">деректер ағымы диаграммасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17851_650211_2101741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that is used to separate the day, month, and year when date values are formatted. The characters are determined by system settings or by the Format function.</descrip></descripGrp><ntig><termGrp><term id="650211">date separator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101741">күн бөлу таңбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17852_650212_2101742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an activity diagram, a guard condition that indicates different possible transitions from an action state. If one of these transitions leads to another decision, that decision is represented with the traditional diamond shape.</descrip></descripGrp><ntig><termGrp><term id="650212">decision</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101742">шешім</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17853_650213_2101743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default property setting of a control type. You customize a control type before you create two or more similar controls to avoid customizing each control individually.</descrip></descripGrp><ntig><termGrp><term id="650213">default control style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101743">әдепкі бойынша басқару элементінің мәнері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17854_650214_1250227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The font that a program uses by default to display text.</descrip></descripGrp><ntig><termGrp><term id="650214">default font</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250227">әдепкі қаріп</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17855_650215_2101744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A property that you can set for a control so that each time a new control of that type is created, this property will have the same value.</descrip></descripGrp><ntig><termGrp><term id="650215">default property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101744">әдепкі бойынша сипаты</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17856_650216_2101745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A setting associated with a particular user role. Users who are not assigned to an existing role are automatically assigned to the role that is specified as the default.</descrip></descripGrp><ntig><termGrp><term id="650216">default role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101745">әдепкі бойынша рөлі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17857_650217_2101746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unit of measure used to display a value if no units of measure are explicitly specified.</descrip></descripGrp><ntig><termGrp><term id="650217">default unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101746">әдепкі бойынша өлшем бірлігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17858_650218_2101747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a statechart or activity diagram, an event that must be postponed for later use while another activity is under way. You can show a deferred event for a state by including the event among the state's internal transitions.</descrip></descripGrp><ntig><termGrp><term id="650218">deferred event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101747">кейінге қалдырылған оқиға</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17859_650219_2101748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of time between the scheduled start of a task and the time when work should actually begin on the task.</descrip></descripGrp><ntig><termGrp><term id="650219">delay</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101748">кідіріс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1786_107270_2220071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character encoding in which each character is represented by 1 byte. Single byte character sets are mathematically limited to 256 characters.</descrip></descripGrp><ntig><termGrp><term id="107270">SBCS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2220071">SBCS</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1786_107270_2220319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character encoding in which each character is represented by 1 byte. Single byte character sets are mathematically limited to 256 characters.</descrip></descripGrp><ntig><termGrp><term id="107270">SBCS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2220319">бір байтты таңбалар жиынтығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1786_107271_2220071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character encoding in which each character is represented by 1 byte. Single byte character sets are mathematically limited to 256 characters.</descrip></descripGrp><ntig><termGrp><term id="107271">single-byte character set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2220071">SBCS</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1786_107271_2220319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character encoding in which each character is represented by 1 byte. Single byte character sets are mathematically limited to 256 characters.</descrip></descripGrp><ntig><termGrp><term id="107271">single-byte character set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2220319">бір байтты таңбалар жиынтығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17860_650220_2101749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An element, such as an attribute or association, that can be calculated or derived from other information. For example, an age attribute for the class Person can be derived if you know the Person's date of birth.</descrip></descripGrp><ntig><termGrp><term id="650220">derived element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101749">туынды элемент</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17861_650221_2101750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The grid that you use to design a query or filter in query Design view or in the Advanced Filter/Sort window. For queries, this grid was formerly known as the QBE grid.</descrip></descripGrp><ntig><termGrp><term id="650221">design grid</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101750">бланк</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17862_650222_2101751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a collaboration diagram, a marker used to indicate object roles and association roles, or links, that are destroyed during the operation.</descrip></descripGrp><ntig><termGrp><term id="650222">destruction marker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101751">жою маркері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17863_650223_2101752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of PivotTable view that contains detail and total fields.</descrip></descripGrp><ntig><termGrp><term id="650223">detail area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101752">деректер аумағы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17864_650224_2101753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text label on a generalization path that indicates the name of a partition of the general class that the more specific class is in. The default discriminator is an empty string.</descrip></descripGrp><ntig><termGrp><term id="650224">discriminator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101753">дискриминатор</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17865_650225_2101754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web site component that enables users to participate in topics of discussion by posting and replying to comments.</descrip></descripGrp><ntig><termGrp><term id="650225">discussion board</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101754">талқылау тақтасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17866_650226_2101755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A remark or topic of discussion that is associated with a Web page or Microsoft Office file and is stored on a discussion server.</descrip></descripGrp><ntig><termGrp><term id="650226">discussion comment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101755">талқылау түсініктемесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17867_650227_2101756"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Produced with the use of dithering.</descrip></descripGrp><ntig><termGrp><term id="650227">dithered</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101756">бұлыңғыр</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17868_650228_2101757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Characteristic of a number stored in twice the amount (two words; typically 8 bytes) of computer memory that is required for storing a less precise (single-precision) number. Commonly handled by a computer in floating-point form.</descrip></descripGrp><ntig><termGrp><term id="650228">double-precision</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101757">қос нақтылық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17869_650229_2103824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Visio file with a .vsd extension that contains a drawing.</descrip></descripGrp><ntig><termGrp><term id="650229">drawing file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2103824">сызба файлы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1787_529986_2174616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wrapper that encapsulates a COM object within another COM object.</descrip></descripGrp><ntig><termGrp><term id="529986">aggregation wrapper</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2174616">біріктіруші қабық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17870_650230_2103825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ratio of distance on the printed page to distances in the real world. For example, a drawing scale of 1 cm = 1 m means that 1 centimeter on the printed page represents 1 meter in the real world.</descrip></descripGrp><ntig><termGrp><term id="650230">drawing scale</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2103825">сызба масштабы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17871_650231_2103826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Visio file (template) with a .vst extension that opens with the stencils, styles, and settings you need to create a particular type of drawing.</descrip></descripGrp><ntig><termGrp><term id="650231">drawing type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2103826">сызба түрі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17872_650232_2103827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The resource whose assignment to a task determines the finish date of the task.</descrip></descripGrp><ntig><termGrp><term id="650232">driving resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2103827">жүргізуші ресурс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17873_650233_2103828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of field whose content is expressed as a duration of time. Examples include the Work, Duration, and Delay fields. A duration field includes the duration unit, such as hour, day, or week.</descrip></descripGrp><ntig><termGrp><term id="650233">duration field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2103828">ұзақтық өрісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17874_650234_2103829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard format used by CAD programs (such as Autodesk AutoCAD) to store drawing files.</descrip></descripGrp><ntig><termGrp><term id="650234">DWG</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2103829">DWG</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17875_650235_2103830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The earliest date that a task could possibly be completed, based on early finish dates of predecessor and successor tasks, other constraints, and any leveling delay.</descrip></descripGrp><ntig><termGrp><term id="650235">early finish date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2103830">ерте аяқталу күні</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17876_650236_2103831"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure of the cost of work performed up to the status date or current date. Earned value uses your original cost estimates saved with a baseline and your actual work to date to show whether the actual costs incurred are on budget.</descrip></descripGrp><ntig><termGrp><term id="650236">earned value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2103831">игерілген көлем</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17877_650237_2103832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of Access updating or repainting the screen while a macro is running.</descrip></descripGrp><ntig><termGrp><term id="650237">echo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2103832">экранға шығару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17878_650238_2103833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default method of scheduling in Project; the duration of a task shortens or lengthens as resources are added or removed from a task, while the amount of effort necessary to complete a task remains unchanged.</descrip></descripGrp><ntig><termGrp><term id="650238">effort-driven scheduling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2103833">еңбек шығынын басқарудың кестесін жасау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17879_650239_2103834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of time that a task will take to finish, based on a 24-hour day and a 7-day week, including holidays and other nonworking days. For example: emin = elapsed minute, ehr = elapsed hour, eday = elapsed day, ewk = elapsed week.</descrip></descripGrp><ntig><termGrp><term id="650239">elapsed duration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2103834">астрономиялық ұзақтық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1788_530273_2202179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process that detects and/or attempts to correct software failure or loss of data integrity within a relational database management system (RDBMS).</descrip></descripGrp><ntig><termGrp><term id="530273">dynamic recovery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202179">динамикалық қалпына келтіру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1789_114199_1839334"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To delay an item, such as a reminder, an alarm, or a recommendation, by a specified time.</descrip></descripGrp><ntig><termGrp><term id="114199">snooze</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1839334">кейінге қалдыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="179_559846_2209878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the SQL system there are two typical types of threads: - short thread: it is a process that use the resources for a short time and - long thread: it is a process that use the resources for a long time. long parsing: is the analysis of the threads that lived for a long time Note: the definition of short/long is based on the system calculation/statistic for each process.</descrip></descripGrp><ntig><termGrp><term id="559846">long parsing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2209878">ұзақ талдау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1794_264894_615742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that addresses, from a Strategic Business Development perspective, the general activities that a company goes through to determine their business growth strategy. The roadmap includes understanding market position, evaluating trade-offs between mergers/acquisitions and internal development, evaluating M&amp;A candidates and placing valuation on target companies.</descrip></descripGrp><ntig><termGrp><term id="264894">Strategic Merger or Acquisition Evaluation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615742">стратегиялық қосылуды немесе сіңіруді бағалау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1796_27342_2180717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column or set of columns that have a unique value for each row in a table.</descrip></descripGrp><ntig><termGrp><term id="27342">candidate key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2180717">ықтимал кілт</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1799_535212_2208355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that represents the improvement that a mining model provides when compared against a random guess, and measures the change in terms of a lift score.</descrip></descripGrp><ntig><termGrp><term id="535212">lift chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2208355">болжамдар дәлдігі диаграммасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1800_124931_2070156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operator that takes only one operand, for example, the increment (++) operator.</descrip></descripGrp><ntig><termGrp><term id="124931">unary operator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070156">унарлы оператор</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1801_111907_779606"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make resources, such as folders, printers, files, photos, available to others.</descrip></descripGrp><ntig><termGrp><term id="111907">share</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779606">ортақ пайдалану</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1802_293191_627346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that reacts or responds to requests or events.</descrip></descripGrp><ntig><termGrp><term id="293191">responder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627346">жауапшы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1806_45199_2070157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file format designed to ensure that bitmap graphics created using one application can be loaded and displayed in another application exactly the way they appeared in the originating application.</descrip></descripGrp><ntig><termGrp><term id="45199">device independent bitmap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070157">Құрылғыдан тәуелсіз нүктелік кескін</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1806_45200_2070157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file format designed to ensure that bitmap graphics created using one application can be loaded and displayed in another application exactly the way they appeared in the originating application.</descrip></descripGrp><ntig><termGrp><term id="45200">DIB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070157">Құрылғыдан тәуелсіз нүктелік кескін</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1808_180960_2205539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">UI element consisting of a report toolbar and other navigation elements used to work with a report.</descrip></descripGrp><ntig><termGrp><term id="180960">HTML Viewer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2205539">HTML қарап шығу құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1809_149352_615590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control you place on a form or report to contain an unbound object.</descrip></descripGrp><ntig><termGrp><term id="149352">unbound object frame</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615590">нысанның бос жақтауы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1815_535229_2215336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary mechanism for securing the Publisher. It contains a list of logins, accounts, and groups that are granted access to the publication.</descrip></descripGrp><ntig><termGrp><term id="535229">publication access list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215336">PAL</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1815_535229_2218195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary mechanism for securing the Publisher. It contains a list of logins, accounts, and groups that are granted access to the publication.</descrip></descripGrp><ntig><termGrp><term id="535229">publication access list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2218195">жарияланымға қол жеткізу тізімі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1815_535230_2215336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary mechanism for securing the Publisher. It contains a list of logins, accounts, and groups that are granted access to the publication.</descrip></descripGrp><ntig><termGrp><term id="535230">PAL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215336">PAL</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1815_535230_2218195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary mechanism for securing the Publisher. It contains a list of logins, accounts, and groups that are granted access to the publication.</descrip></descripGrp><ntig><termGrp><term id="535230">PAL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2218195">жарияланымға қол жеткізу тізімі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1819_143381_2070158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A path containing a document with hyperlinks that is used as the root of the hyperlinks in the document.</descrip></descripGrp><ntig><termGrp><term id="143381">hyperlink base</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070158">Гиперсілтеме базасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1820_76908_626971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To execute a group of statements repeatedly.</descrip></descripGrp><ntig><termGrp><term id="76908">loop</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626971">тұйықталу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1821_4592_1250025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change a system or a data file to make it more current.</descrip></descripGrp><ntig><termGrp><term id="4592">update</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250025">жаңарту</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1825_2484838_626415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual value plotted in a chart and represented together with other data points by bars, columns, lines, pie or doughnut slices, dots, and various other shapes called data markers. Data markers of the same color constitute a data series.</descrip></descripGrp><ntig><termGrp><term id="2484838">series data point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><la