p></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070215">жаңалықтар арнасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3179_85019_2070215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Deliveries, exchanges, or distributions of newsgroup articles to and from news servers. Newsfeeds are accomplished through cooperating news servers, which communicate via NNTP through network connections.</descrip></descripGrp><ntig><termGrp><term id="85019">news feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070215">жаңалықтар арнасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31790_1623960_1674170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A crawl that operates on a continuous basis to scan and index new and modified content from a source.</descrip></descripGrp><ntig><termGrp><term id="1623960">continuous crawl</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674170">Үздіксіз тексеріп шығу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31793_1623963_1674211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instance of Excel that has minimal UI and that enables a user to insert or edit chart data within the context of a non-Excel Office document.</descrip></descripGrp><ntig><termGrp><term id="1623963">Data Grid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674211">Деректер кестесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31794_1623978_1674265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The categories of assignments for a given class, along with a percentage value that indicates how much each category weighs into the overall grade. Other factors, such as class participation, may also be considered.</descrip></descripGrp><ntig><termGrp><term id="1623978">evaluation criteria</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674265">бағалау шарттары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31795_1623979_1674293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of refining a search for information by filtering on individual properties or facets of the items being searched.</descrip></descripGrp><ntig><termGrp><term id="1623979">faceted navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674293">дәл өту</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31796_1623980_1674305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Comments about a completed assignment that an educator makes during review and grading and that are available to the student once the grade is posted.</descrip></descripGrp><ntig><termGrp><term id="1623980">feedback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674305">пікір</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31799_1624313_1674356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A JavaScript API that provides simple and consistent programmatic access to Office documents and applications across Office client environments through common as well as application-specific data types, objects, functions and events.</descrip></descripGrp><ntig><termGrp><term id="1624313">JavaScript API for Office</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674356">Office жүйесіне арналған JavaScript API</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31800_1624314_1674360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of learning that addresses a portion of the content for a class and may include assignments, materials, and other lessons.</descrip></descripGrp><ntig><termGrp><term id="1624314">lesson</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674360">сабақ</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31800_2686115_1674360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of learning that addresses a portion of the content for a class and may include assignments, materials, and other lessons.</descrip></descripGrp><ntig><termGrp><term id="2686115">unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674360">сабақ</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31801_1624315_1674364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A layout that is updated in real time as an object on the page is moved, resized, or rotated, enabling the user to preview the end result before the action is completed.</descrip></descripGrp><ntig><termGrp><term id="1624315">live layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674364">тікелей орнату</t