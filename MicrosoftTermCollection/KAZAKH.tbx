<termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2204151">гистограмма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13244_530811_2223386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool for data removal.</descrip></descripGrp><ntig><termGrp><term id="530811">vacuumer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2223386">тазалағыш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13246_264638_615720"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that allows users to add/remove/organize the list of bibliographic information for the document</descrip></descripGrp><ntig><termGrp><term id="264638">Source Manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615720">көздерді реттеуші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13247_210455_615617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system for organizing sites on a server. Each server can have more than one IIS instance, and each IIS instance can have more than one top-level site.</descrip></descripGrp><ntig><termGrp><term id="210455">IIS instance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615617">IIS данасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13249_396919_407569"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Functionality available on Receive connectors and Send connectors on the Exchange Server 2007 Edge Transport server that lets email administrators modify the SMTP addresses of senders and recipients on messages that enter and leave an Exchange organization. Address rewriting lets an organization present a consistent appearance to external recipients of messages from the organization.</descrip></descripGrp><ntig><termGrp><term id="396919">address rewriting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407569">мекенжайды қайта жазу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1325_2520267_1091126"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft SQL Server used to import, export, and transform data from different data sources.</descrip></descripGrp><ntig><termGrp><term id="2520267">Integration Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1091126">SQL Server интеграциялау қызметтері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1325_2599649_1091126"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft SQL Server used to import, export, and transform data from different data sources.</descrip></descripGrp><ntig><termGrp><term id="2599649">MSSQL Integration Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1091126">SQL Server интеграциялау қызметтері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1325_418572_1091126"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft SQL Server used to import, export, and transform data from different data sources.</descrip></descripGrp><ntig><termGrp><term id="418572">SQL Server Integration Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1091126">SQL Server интеграциялау қызметтері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1325_418573_1091126"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft SQL Server used to import, export, and transform data from different data sources.</descrip></descripGrp><ntig><termGrp><term id="418573">SSIS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1091126">SQL Server интеграциялау қызметтері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13255_89155_2098789"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any peripheral which purpose is to convey information from a computer to a user in the form of text, images, sounds or other.</descrip></descripGrp><ntig><termGrp><term id="89155">output device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098789">шығару құрылғысы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13257_559855_2180178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The business logic handler framework allows you to write a managed code assembly that is called during the merge synchronization process.</descrip></descripGrp><ntig><termGrp><term id="559855">business logic handler framework</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2180178">бизнес-логика өңдеушісінің платформасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13258_71190_2098790"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small software program written in the Java language, a programming language that is used primarily on the World Wide Web. A Java applet is located within an HTML document and can be used to add to animation, music, page updates, and so on.</descrip></descripGrp><ntig><termGrp><term id="71190">Java applet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098790">Javа бағдарламасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13259_264864_615735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of time a resource has available to work at any given point in time. Actual Capacity is equal to Capacity minus resource calendar exceptions (e.g. offsite training, morale events, jury duty) and previously scheduled committed work (Project task assignments with type = committed). This is the most valuable measure for scheduling a resource.</descrip></descripGrp><ntig><termGrp><term id="264864">Actual Capacity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615735">нақты қатынау мүмкіндігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13262_181636_2219606"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Web-based report management application used to manage content and operations on a report server instance.</descrip></descripGrp><ntig><termGrp><term id="181636">Report Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2219606">есептер менеджері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13265_132802_627188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard character that can be used to represent one or many characters when conducting a query.</descrip></descripGrp><ntig><termGrp><term id="132802">wildcard character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627188">қойылмалы таңба</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13265_132803_627188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard character that can be used to represent one or many characters when conducting a query.</descrip></descripGrp><ntig><termGrp><term id="132803">wildcard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627188">қойылмалы таңба</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13265_257449_627188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard character that can be used to represent one or many characters when conducting a query.</descrip></descripGrp><ntig><termGrp><term id="257449">pattern-matching character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627188">қойылмалы таңба</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13266_264865_615736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount of time a resource can work based on its project calendar.</descrip></descripGrp><ntig><termGrp><term id="264865">base capacity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615736">негізгі қатынау мүмкіндігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13268_180471_2219159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of 128 leaf level pages in logical order in a single file. Used to identify areas of a file that are fragmented.</descrip></descripGrp><ntig><termGrp><term id="180471">region</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2219159">аумақ</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13272_264866_615717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount of time a resource can work based on its project calendar minus standard exceptions such as holidays and planned vacations.</descrip></descripGrp><ntig><termGrp><term id="264866">capacity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615717">қатынау мүмкіндігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13276_559843_2201773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scheduled job that runs under SQL Server Agent. After all Subscribers have received a transaction, the agent removes the transaction from the distribution database. It also cleans up snapshot files from the file system after entries corresponding to those files have been removed from the distribution database.</descrip></descripGrp><ntig><termGrp><term id="559843">distribution cleanup agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2201773">тарату тазалау агенті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13278_24768_2180073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action of copying a large set of data.</descrip></descripGrp><ntig><termGrp><term id="24768">bulk copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2180073">жаппай көшіру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13283_264880_615714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that addresses, from a Finance &amp; Accounting view, the general activities that define a typical effort to prepare an Annual Financial Report. Includes activities focused on obtaining the necessary information from multiple departments, to working with other departments (e.g., Legal and Public Relations) to ensure all required information is presented accurately, and up through the printing and distribution process.</descrip></descripGrp><ntig><termGrp><term id="264880">Annual Report Preparation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615714">жылдық есеп дайындау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13284_232490_1746683"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of a number of products for sale as one unit.</descrip></descripGrp><ntig><termGrp><term id="232490">bundle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1746683">жинақ</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13288_264886_615732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that outlines the various considerations you might need in order to plan a marketing campaign in your organization. Planning a marketing campaign begins with understanding you position in the marketplace and ends with collecting data and analyzing campaign effectiveness.</descrip></descripGrp><ntig><termGrp><term id="264886">Marketing Campaign Planning</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615732">маркетингілік науқанды жоспарлау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13289_134217_2098791"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text of a WordArt object.</descrip></descripGrp><ntig><termGrp><term id="134217">WordArt text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098791">WordArt мәтіні</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13290_168878_2194844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A restore of a full database backup, the most recent differential database backup (if any), and the log backups (if any) taken since the full database backup.</descrip></descripGrp><ntig><termGrp><term id="168878">complete database restore</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2194844">дерекқорды толығымен қалпына келтіру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13291_2045175_2064673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A language selected by the user for viewing menus, dialog boxes, messages, and Help files. If none is selected, the system-preferred language is displayed.</descrip></descripGrp><ntig><termGrp><term id="2045175">preferred language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2064673">таңдаулы тіл</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13291_2045175_2064682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A language selected by the user for viewing menus, dialog boxes, messages, and Help files. If none is selected, the system-preferred language is displayed.</descrip></descrip