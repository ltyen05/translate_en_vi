ens that allows users to view and place holograms in their physical or virtual environment.</descrip></descripGrp><ntig><termGrp><term id="2459834">Holograms</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2461638">Голограммалар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43422_2459834_2484235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app in Windows Mixed Reality and on HoloLens that allows users to view and place holograms in their physical or virtual environment.</descrip></descripGrp><ntig><termGrp><term id="2459834">Holograms</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2484235">Microsoft голограммалары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43422_2481629_2461638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app in Windows Mixed Reality and on HoloLens that allows users to view and place holograms in their physical or virtual environment.</descrip></descripGrp><ntig><termGrp><term id="2481629">Microsoft Holograms</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2461638">Голограммалар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="par