S"><descripGrp><descrip type="definition">A user-set measurement of the minimal level of similarity required for two files to be considered as near-duplicates.</descrip></descripGrp><ntig><termGrp><term id="2446341">similarity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2451303">ұқсастық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43198_2447210_2451252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of emails which can be traced to a single original email through a sequence of replies.</descrip></descripGrp><ntig><termGrp><term id="2447210">email thread</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2451252">хаттар тізбегі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43199_2447217_2451257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery feature that groups emails together into email threads so that review volume is reduced.</descrip></descripGrp><ntig><termGrp><term id="2447217">Email Threads</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2451257">хаттар тізбелері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Prope