create an input form on the page. Each block is preconfigured with the required collection of fields, and is ready for use. When creating a page, designers will typically choose from a limited selection of existing blocks, while managers or administrators will typically create new blocks only occasionally.</descrip></descripGrp><ntig><termGrp><term id="2501474">field block</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2517081">өрістер топтамасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44431_2550466_2552037"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that enables the users to view, organize, edit and share all of their photos and videos from multiple sources, and tell stories with them by making them into new videos. It replaces the default Photos app in Windows 10.</descrip></descripGrp><ntig><termGrp><term id="2550466">Photos &amp; Videos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2552037">Фотосуреттер және бейнелер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44449_2502392_2805906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-release version of a service or a feature that are made available to customers for evaluation purposes and at reduced or different service terms.</descrip></descripGrp><ntig><termGrp><term id="2502392">preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2805906">алдын ала қарау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44449_2502392_2912816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-release version of a service or a feature that are made available to customers for evaluation purposes and at reduced or different service terms.</descrip></descripGrp><ntig><termGrp><term id="2502392">preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2912816">алдын ала қарау нұсқасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44459_2502425_2516746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shortcut to a website, document, photo, or other file that can be included in a map.</descrip></descripGrp><ntig><termGrp><term id="2502425">geo pin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2516746">географиялық қадауыш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44460_2502426_2516747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web page that operates on a Dynamics 365 server and is created by a Dynamics 365 customer to support their marketing initiatives.</descrip></descripGrp><ntig><termGrp><term id="2502426">marketing page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2516747">маркетинг беті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44461_2502427_2516748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team that owns records and has security roles assigned to the team. The team’s privileges are defined by these security roles. In addition to privileges provided by the team’s security roles, users have the privileges defined by their individual security roles and by the roles from other teams in which they are members. A team has full access rights on the records that the team owns.</descrip></descripGrp><ntig><termGrp><term id="2502427">owning team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2516748">иеленуші топ</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44462_2502428_2516741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team that doesn’t own records and doesn’t have security roles assigned to it. The users have privileges defined by their individual security roles and by the roles from other teams in which they are members. The records are shared with an access team and the team members are granted access rights on the records, such as Read, Write, or Append.</descrip></descripGrp><ntig><termGrp><term id="2502428">access team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2516741">қатынасушы топ</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44463_2502429_2516749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transient message that provides quick access to a company privacy policy or to its privacy statement.</descrip></descripGrp><ntig><termGrp><term id="2502429">privacy banner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2516749">құпиялылық баннері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44464_2502430_2516750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A competency grouping method for conference breakouts.</descrip></descripGrp><ntig><termGrp><term id="2502430">session track</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2516750">сессиялық курс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44465_2502431_2516751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database record that matches a (human) speaker to a specific session from a specific event where they will be speaking. It assigns a speaker to a session.</descrip></descripGrp><ntig><termGrp><term id="2502431">speaker engagement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2516751">баяндамашының сұхбаты</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44466_2502432_2516753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A prospect that is contacted by phone. Tele prospecting is the practice of generating interest for a product or service over the phone. The purpose of tele prospecting is to further qualify the lead to determine if a hand off to sales is necessary.</descrip></descripGrp><ntig><termGrp><term id="2502432">tele prospect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2516753">телефон соғылатын әлеуетті тұтынушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44467_2502433_2516754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication feature that automatically creates a webinar on the Lync or Skype for Business server and generates a hypertext link that you can send to contacts to enable them to join online.</descrip></descripGrp><ntig><termGrp><term id="2502433">webinar provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2516754">вебинарды ұйымдастыру құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44469_2502845_2516752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customer journey component tile that enables a marketer to separate out a percentage or number of contacts into different branches of the journey.</descrip></descripGrp><ntig><termGrp><term id="2502845">splitter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2516752">тармақтағыш құрал</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44477_2502881_2504717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card that displays information about a group, such as email address, group description and other shared information.</descrip></descripGrp><ntig><termGrp><term id="2502881">group card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2504717">топ картасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44478_2502884_2504726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of data, such as contact details, and information that describes a person and what he/she is working on.</descrip></descripGrp><ntig><termGrp><term id="2502884">profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2504726">профиль</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44479_2502886_2505618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A broad group of users through which updates to the OneDrive sync client are released.</descrip></descripGrp><ntig><termGrp><term id="2502886">update ring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2505618">жаңарту тобы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44485_2502932_2503744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The package of computer fonts that supports both Arabic script and the Latin alphabet.</descrip></descripGrp><ntig><termGrp><term id="2502932">Dubai Font</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2503744">Dubai Font</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44486_2502933_2503746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft framework that allows application developers to supply assistive technology tools with semantic metadata for text and UI element properties, and whose metadata can be used by text-to-speech (TTS) engines.</descrip></descripGrp><ntig><termGrp><term id="2502933">SayAs</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2503746">SayAs</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44487_2502935_2505619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Advanced Threat Protection feature that uses Safe links to disable malicious links in user emails and Safe attachment to disable malicious attached files in user emails.</descrip></descripGrp><ntig><termGrp><term id="2502935">URL detonation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2505619">URL мекенжайларын өшіру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSel