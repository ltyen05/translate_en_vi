hat camera movement has on images in videos.</descrip></descripGrp><ntig><termGrp><term id="1673865">stabilization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1680562">тұрақтану</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32405_1674922_1680555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique that increases sharpness and fidelity by compensating for some effects that camera movement has on images in videos.</descrip></descripGrp><ntig><termGrp><term id="1674922">image stabilization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1680555">кескін тұрақтануы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32405_1674922_1680562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique that increases sharpness and fidelity by compensating for some effects that camera movement has on images in videos.</descrip></descripGrp><ntig><termGrp><term id="1674922">image stabilization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1680562">тұрақтану</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32406_1673920_1680556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that enables users to communicate and collaborate with people online and access their conversations, photos, documents, contacts, appointments, settings, and services across PC, phone, and other devices.</descrip></descripGrp><ntig><termGrp><term id="1673920">Live</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1680556">Live</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32415_1676150_1684980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user action that is counted and analyzed by the recommendations algorithm in the Analytics Service.</descrip></descripGrp><ntig><termGrp><term id="1676150">usage event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1684980">пайдалану оқиғасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32417_1676974_1764743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A metadata navigation control that enables users to limit the items displayed in a list or library to those that match selected values.</descrip></descripGrp><ntig><termGrp><term id="1676974">Key Filters</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1764743">Негізгі cүзгілер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3242_161308_2432703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directed relationship between two objects, such as components, objects, or features. For example, if feature A depends on feature B, B is a dependency of A.</descrip></descripGrp><ntig><termGrp><term id="161308">dependency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2432703">тәуелділік</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32431_1678780_1684970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows for preservation of content documents, pages, and messages in Exchange and SharePoint so that when they are modified or deleted, the original version can still be accessed for electronic discovery and other legal purposes.</descrip></descripGrp><ntig><termGrp><term id="1678780">In-Place Hold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1684970">Орнында сақтау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32432_1678824_1682269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual interface where users enter a passcode, use a certain button combination or perform a certain gesture in order to activate the full functionality of a device.</descrip></descripGrp><ntig><termGrp><term id="1678824">lock screen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1682269">құлыптау экраны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32434_1679570_1682270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that allows users to upload email messages, email folders, and contacts from an email account on their PC to the cloud to facilitate access from multiple devices.</descrip></descripGrp><ntig><termGrp><term id="1679570">Mail Migration add-on</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1682270">Mail Migration қосымша құрылғысы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32435_1679576_1697400"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image stabilization technique used to remove wobbled distortions from a video captured with a rolling shutter camera that's exposed to large accelerations or 