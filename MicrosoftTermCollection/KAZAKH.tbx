grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6962_312045_627257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cell that is referred to by a formula in another cell. For example, if cell D10 contains the formula =B5, cell B5 is a precedent to cell D10.</descrip></descripGrp><ntig><termGrp><term id="312045">precedent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627257">әсер етуші ұяшық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6965_182134_2201728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that joins horizontally partitioned data from a set of member tables across more than one server, making the data appear as if from one table.</descrip></descripGrp><ntig><termGrp><term id="182134">distributed partitioned view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2201728">бөлінген секциялы көрініс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6966_181762_2219865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Report scripting tool.</descrip></descripGrp><ntig><termGrp><term id="181762">rs utility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp