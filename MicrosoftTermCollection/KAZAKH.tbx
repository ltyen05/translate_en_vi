erm id="1208">Extensible Markup Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615392">XML</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14842_1209_615392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A markup language for describing and exchanging structured data in a format that is independent of operating systems and applications. XML is a World Wide Web Consortium (W3C) specification and is a subset of Standard Generalized Markup Language (SGML).</descrip></descripGrp><ntig><termGrp><term id="1209">XML</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615392">XML</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14843_318774_626517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The $ character.</descrip></descripGrp><ntig><termGrp><term id="318774">dollar sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626517">доллар таңбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14843_318775_626517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The $ character.</descrip></descripGrp><ntig><termGrp><term id="318775">DOLLAR SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626517">доллар таңбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14845_157682_625946"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows security feature that locks a user account if a number of failed logon attempts occur within a specified amount of time, based on security policy lockout settings. Locked accounts cannot log on.</descrip></descripGrp><ntig><termGrp><term id="157682">account lockout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="625946">тіркелгі құрсаулау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14846_237282_615653"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows an end-user to collect data via E-mail using Access, Outlook, and InfoPath.</descrip></descripGrp><ntig><termGrp><term id="237282">Collect Data Through E-mail</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615653">электрондық пошта арқылы дерек жинау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14847_211833_1030594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of text labels describing the role accounts and contacts play with opportunities as well as other accounts and contacts.</descrip></descripGrp><ntig><termGrp><term id="211833">relationship role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030594">қарым-қатынастар рөлі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14848_253634_1249262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line or row of characters used to lead the eye from a data label to a data point, or from a callout to the appropriate part of an illustration.</descrip></descripGrp><ntig><termGrp><term id="253634">leader line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1249262">көрсеткіш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14848_253634_1490871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line or row of characters used to lead the eye from a data label to a data point, or from a callout to the appropriate part of an illustration.</descrip></de