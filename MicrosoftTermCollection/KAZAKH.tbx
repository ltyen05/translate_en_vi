="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2997928">кіші мүше</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52758_2956738_2997910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way of representing repeated multiplications of the same number by writing the number as a base with the number of repeats written as a small number to its upper right.</descrip></descripGrp><ntig><termGrp><term id="2956738">exponential form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2997910">экспоненциалдық пішін</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52759_2956739_2997919"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mathematical root expressed with a radical sign, generally a square root or cube root.</descrip></descripGrp><ntig><termGrp><term id="2956739">radical form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2997919">түбір</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52760_2956740_2997916"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability that gives the user instantaneous access to a device by using a remote shell connection, granting them the power to do in-depth investigative work and take immediate response actions to promptly contain identified threats in real time.</descrip></descripGrp><ntig><termGrp><term id="2956740">Live Response</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2997916">Нақты уақытта жауап беру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52773_2997773_2997814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Information Excel function that returns TRUE if the value is any error value.</descrip></descripGrp><ntig><termGrp><term id="2997773">ISERROR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2997814">ISERROR</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52774_2997860_2999109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Edge that allows the user to keep track of their ideas on the web by adding pages, images, links, or text to a nameable collection that can be saved and synced across signed-in devices.</descrip></descripGrp><ntig><termGrp><term id="2997860">Collections</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNo