A process that performs reverse number lookup on one-number calls and then routes the call over an IP connection to the public switched telephone network (PSTN) gateway that is nearest to the location of the destination phone number.</descrip></descripGrp><ntig><termGrp><term id="1088740">LCR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1362644">LCR</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23621_1088740_1362645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that performs reverse number lookup on one-number calls and then routes the call over an IP connection to the public switched telephone network (PSTN) gateway that is nearest to the location of the destination phone number.</descrip></descripGrp><ntig><termGrp><term id="1088740">LCR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1362645">Төмен құн бойынша бағыттау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2363_95503_627287"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attribute of an object that is used to define its state, appearance, or value.</descrip></descripGrp><ntig><termGrp><term id="95503">property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627287">сипат</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2364_181054_2209804"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A provider that logs package information at run time. Integration Services includes a variety of log providers that make it possible to capture events during package execution. Logs are created and stored in formats such as XML, text, database, or in the Windows event log.</descrip></descripGrp><ntig><termGrp><term id="181054">log provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2209804">тіркеуші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23657_1088805_2105069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computer systems, a reduction in level of performance or service. Degradation in microcomputer performance is indicated by slow response times or frequent pauses for disk access because memory is insufficient to hold an entire program plus the data the program is using.</descrip></descripGrp><ntig><termGrp><term id="1088805">degradation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2105069">төмендеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2366_52839_2433159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of adding depth to a two-dimensional shape to create a three-dimensional object.</descrip></descripGrp><ntig><termGrp><term id="52839">extrusion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2433159">үш өлшемдік әсер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2368_530232_2200478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The language used for accessing, querying, updating, and managing data in relational database systems.</descrip></descripGrp><ntig><termGrp><term id="530232">database language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2200478">дерекқор тілі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23687_1088837_1145219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specific part or function in an application or architecture. For example, a Web server, a database server, or a client.</descrip></descripGrp><ntig><termGrp><term id="1088837">role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1145219">рөл</term><te