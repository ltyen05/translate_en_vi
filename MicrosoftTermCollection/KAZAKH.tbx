Set><langSet xml:lang="kk"><ntig><termGrp><term id="2176815">жабдықтық жеделдету</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3744_54147_2070242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of letters, numbers, and allowable symbols assigned to a file to distinguish it from all other files in a particular directory on a disk. A file name is the label under which a computer user saves and requests a block of information.</descrip></descripGrp><ntig><termGrp><term id="54147">file name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070242">файл атауы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37447_2137613_2354391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version 10 of the Windows operating system that runs on PCs and tablets.</descrip></descripGrp><ntig><termGrp><term id="2137613">Windows 10</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2354391">Windows 10</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37451_2137967_2365563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container in Resource Manager that holds related resources for an application. The resource group can include all of the resources for an application, or only those resources that are logically grouped together.</descrip></descripGrp><ntig><termGrp><term id="2137967">resource group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2365563">ресурстар тобы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37463_2138009_2802442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication mechanism to configure access control based on role claims contained in the authentication token.</descrip></descripGrp><ntig><termGrp><term id="2138009">role-based access control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2802442">рөлдер негізінде қатынасу рұқсаттарын басқару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37463_2138010_2802442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication mechanism to configure access control based on role claims contained in the authentication token.</descrip></descripGrp><ntig><termGrp><term id="2138010">RBAC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2802442">рөлдер негізінде қатынасу рұқсаттарын басқару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37465_2138907_2176932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The result of projecting an image onto a cylinder.</descrip></descripGrp><ntig><termGrp><term id="2138907">cylindrical projection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2176932">күбіше түріндегі проекция</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37466_2138908_2177355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The result of projecting an image onto a flat surface.</descrip></descripGrp><ntig><termGrp><term id="2138908">planar projection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2177355">жазықтық проекция</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37467_2138909_2177375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The result of projecting an image onto a sphere.</descrip></descripGrp><ntig><termGrp><term id="2138909">spherical projection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2177375">сфералы проекция</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37468_2138910_2177369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The resulting 3D mesh containing color information.</descrip></descripGrp><ntig><termGrp><term id="2138910">scan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2177369">сканерлеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37469_2138911_2177342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To close a hole in a 3D model with a patching surface or plane.</descrip></descripGrp><ntig><termGrp><term id="2138911">patch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2177342">түзету</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37470_2138912_2177360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode in which the user can manipulate a 3D object by rotating it.</descrip></descripGrp><ntig><termGrp><term id="2138912">rotate mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2177360">айналдыру режимі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37471_2138913_2177365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode in which the user can manipulate a 3D object by increasing or decreasing its scale.</descrip></descripGrp><ntig><termGrp><term id="2138913">scale mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2177365">масштабтау режимі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37472_2138914_2177340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode in which the user can manipulate a 3D object by moving it.</descrip></descripGrp><ntig><termGrp><term id="2138914">move mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2177340">жылжыту режимі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37474_2139114_2152773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database that stores search settings which include, but are not limited to search topology settings.</descrip></descripGrp><ntig><termGrp><term id="2139114">search administration database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2152773">іздеуді басқару дерекқоры</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37475_2139115_2152723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The webpage that displays all the apps that a particular user has a license to and that is scoped to the individual user.</descrip></descripGrp><ntig><termGrp><term id="2139115">My apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2152723">Менің бағдарламаларым</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37476_2139116_2152767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu option in the Office 365 Compliance Center that allows users to search mail, files, and sites, specifying criteria on groups, people, or locations, and then take compliance actions on the results.</descrip></descripGrp><ntig><termGrp><term id="2139116">Search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2152767">Іздеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37477_2139117_2152765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button in the History pane used to restore the current document to an earlier version</descrip></descripGrp><ntig><termGrp><term id="2139117">Restore this version</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2152765">Осы нұсқаны қалпына келтіру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37478_2139118_2152759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway view that allows the user to see what the Sway would look and behave like to anyone else reading it by switching from the edit view to the reading view.</descrip></descripGrp><ntig><termGrp><term id="2139118">Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2152759">Алдын ала қарау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37479_2139119_2152795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that allows users to edit, add, reorder, delete, and structure their Sway content.</descrip></descripGrp><ntig><termGrp><term id="2139119">Storyline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2152795">Сюжет</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37480_2139120_2152705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of different visualization patterns and interactions for content shown in Sway.</descrip></descripGrp><ntig><termGrp><term id="2139120">card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2152705">карта</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37481_2139121_2152392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway card that allows the user to select one or more pieces or types of content and change what is selected into a heading.</descrip></descripGrp><ntig><termGrp><term id="2139121">Header</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2152392">Тақырып</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37482_2139122_2152785"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway card that shows individual pieces of content sequentially, allowing forward and backward navigation one piece of content at a time.</descrip></descripGrp><ntig><termGrp><term id="2139122">Slideshow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2152785">Слайд-шоу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37483_2139123_2152789"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway group card that shows individual pieces of content sequentially, as a skeuomorphic stack.</descrip></descripGrp><ntig><termGrp><term id="2139123">Stack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2152789">Бума</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37484_2139125_2152385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button in Sway that allows for the addition of Headers, Text and Media from the Web or local device, and Layout options at the indicated location.</descrip></descripGrp><ntig><termGrp><term id="2139125">Add content</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2152385">Мазмұн қосу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37485_2139126_2152393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway option button under “Add Content” that allows users to select an office document and import it into Sway.</descrip></descripGrp><ntig><termGrp><term id="2139126">Import Document</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2152393">Құжатты импорттау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37486_2139127_2152799"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu option in Sway under the “Add Content” button that analyzes the user’s Sway to suggest useful content that can be browsed or added as desired.</descrip></descripGrp><ntig><termGrp><term id="2139127">Suggested Content</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2152799">Ұсынылған мазмұн</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3749_380753_1030611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A holding container for work items. Members of a queue must be of the same work item class (for example, only incidents).</descrip></descripGrp><ntig><termGrp><term id="380753">queue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030611">кезек тізімі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37525_2139445_2354915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu option in Sway under the “Add Content” button that allows users to upload images, Word documents, or PowerPoint presentations from their computer or mobile device into their Sway.</descrip></descripGrp><ntig><termGrp><term id="2139445">Upload Content</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2354915">Контентті жүктеп салу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37527_2139460_2152782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows users to share a sway with other Sway users via social media or Docs.com, add additional authors to a sway, or generate the HTML embed code for a sway.</descrip></descripGrp><ntig><termGrp><term id="2139460">Share</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2152782">Бөлісу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37528_2139461_2152391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows the user to change a set of cards into a group of cards.</descrip></descripGrp><ntig><termGrp><term id="2139461">Group</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2152391">Топ</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37529_2139462_2152387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area on a card that allows a user to make the card’s image a background when clicked on.</descrip></descripGrp><ntig><termGrp><term id="2139462">Background</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2152387">Фон</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3753_503131_1331121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item that removes a group and its contacts from the user's Contacts list.</descrip></descripGrp><ntig><termGrp><term id="503131">Delete Group</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSe