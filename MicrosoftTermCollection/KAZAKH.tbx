ition">The menu option that displays the folders available in a user's mailbox.</descrip></descripGrp><ntig><termGrp><term id="142219">Folder List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="638237">қалталар тізімі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10713_335530_1161646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder that stores items deleted by the user.</descrip></descripGrp><ntig><termGrp><term id="335530">Deleted Items folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1161646">Жойылғандар қалтасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10717_396920_407641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agent on the Receive connector and Send connector on a computer that has the Edge Transport server role installed, which lets email administrators modify the addresses of senders and recipients on messages that enter and leave an Exchange Server 2007 organization.</descrip></descripGrp><ntig><termGrp><term id="396920">Address Rewriting agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407641">Мекенжайды қайта жазу бағдарламасы</term><termNote type="geogra