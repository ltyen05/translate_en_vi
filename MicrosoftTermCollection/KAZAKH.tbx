Discovery, based on how pertinent the file is to a particular case, and that is based on training.</descrip></descripGrp><ntig><termGrp><term id="2445823">relevance score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2450286">релеванттылық бағасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43166_2445824_2449788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to convert an image of writing to editable digital ink.</descrip></descripGrp><ntig><termGrp><term id="2445824">ink grab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2449788">қолжазбаны алу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43167_2453892_2449790"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature which allows you to stay connected and quickly interact and share with the people you care about most.</descrip></descripGrp><ntig><termGrp><term id="2453892">My People</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2449790">Жақын адамдар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</ter