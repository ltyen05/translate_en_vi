ech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2752644">құрылғылар тобы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48607_2750242_2752657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An inclusive set of people and data being managed in the Microsoft 365 admin center.</descrip></descripGrp><ntig><termGrp><term id="2750242">organization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2752657">ұйым</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48607_2750243_2752657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An inclusive set of people and data being managed in the Microsoft 365 admin center.</descrip></descripGrp><ntig><termGrp><term id="2750243">org</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2752657">ұйым</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48608_2750244_2752661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to anything that is applicable to an entire organization.</descrip></descripGrp><ntig><termGrp><term id="2750244">organization-wide</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2752661">ұйым шеңберіндегі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48608_2750245_2752661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to anything that is applicable to an entire organization.</descrip></descripGrp><ntig><termGrp><term id="2750245">org-wide</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2752661">ұйым шеңберіндегі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48609_2754104_2757760"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Phone System add-on feature that allows organizations to create a customized call with the ability to create a customized greeting, multiple call queues, as well the ability to automatically put calls on hold, search for the next available call agent, and play music while callers are in their queues.</descrip></descripGrp><ntig><termGrp><term id="2754104">Cloud call queue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2757760">бұлттық қоңыраулар кезегі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48621_2751548_2752650"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template for a sensitive information type used for classifying documents for transport rules, the prevention of oversharing information, and the creation of Data Loss Protection policies.</descrip></descripGrp><ntig><termGrp><term id="2751548">document fingerprint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2752650">құжаттың цифрлық таңбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48622_2751549_2752640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document fingerprint that is based off the body of a message.</descrip></descripGrp><ntig><termGrp><term id="2751549">body fingerprint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2752640">негізгі мәтіннің цифрлық таңбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48623_2751550_2752647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 compliance center view where content is stored while waiting for a disposition review.</descrip></descripGr