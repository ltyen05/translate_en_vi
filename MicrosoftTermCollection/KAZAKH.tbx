d="3701_530431_2203597"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">As a SELECT statement, a query that searches for words, phrases, or multiple forms of a word or phrase in the character-based columns (of char, varchar, text, ntext, nchar, or nvarchar data types). The SELECT statement returns those rows meeting the search criteria.</descrip></descripGrp><ntig><termGrp><term id="530431">full-text query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2203597">толық мәтіндік сұрау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37010_2106169_2172291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An expression in some scripting language describing how a value is to be transformed in flowing from an attribute of an entry in one directory to an attribute of an entry in another.</descrip></descripGrp><ntig><termGrp><term id="2106169">Custom expression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2172291">Реттелетін өрнек</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37011_2106171_2172303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A property of which the value for an entry in one directory can be expected to match the value of a given property of the corresponding entry in another directory.</descrip></descripGrp><ntig><termGrp><term id="2106171">Joining property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2172303">Біріктіру сипаты</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37012_2106172_2172304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user experience by which a user is presumably able to easily configure an object of interest.</descrip></descripGrp><ntig><termGrp><term id="2106172">Quick Start</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2172304">Жылдам бастау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37012_2618247_2172304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user experience by which a user is presumably able to easily configure an object of interest.</descrip></descripGrp><ntig><termGrp><term id="2618247">Quickstart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2172304">Жылдам бастау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37013_2106173_2172308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Provisioning of users from a human resource management system into a directory</descrip></descripGrp><ntig><termGrp><term id="2106173">User Import</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2172308">Пайдаланушыларды импорттау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37014_2106175_2172309"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The assignment of access privileges and system resources to users, frequently automated to reduce ongoing support costs and force compliance with security policies.</descrip></descripGrp><ntig><termGrp><term id="2106175">User Provisioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2172309">Пайдаланушыларды дайындау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37015_2106176_2172283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to automatically create user identities as well as maintain and remove user identities as status or roles change.</descrip></descripGrp><ntig><termGrp><term id="2106176">Automatic Provisioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2172283">Автоматты түрде дайындау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37016_2106177_2172307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of testing connectivity with a directory or application</descrip></descripGrp><ntig><termGrp><term id="2106177">Test connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2172307">Байланысты тексеру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37017_2844863_2569119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft 365 Apps for business (formerly Office 365 Business) is a small business-level subscription offering that includes Office applications (e.g., Outlook, Word, Excel, PowerPoint, Access (PC only), Publisher (PC only) and cloud file storage and sharing (OneDrive).</descrip></descripGrp><ntig><termGrp><term id="2844863">Microsoft 365 Apps for business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2569119">Office 365 бизнес</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37017_2844863_2849816"><langSet xml:lang="en-US"><descr