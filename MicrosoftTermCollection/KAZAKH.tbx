ected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11759_307436_407580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mechanism used to help a caller differentiate between users with names that match the touch-tone or speech input.</descrip></descripGrp><ntig><termGrp><term id="307436">Matched Name Selection Method</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407580">Сәйкес атауларды таңдау әдісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11765_2795839_2800497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft's antimalware solution that provides next generation protection for desktops, portable computers, and servers.</descrip></descripGrp><ntig><termGrp><term id="2795839">Microsoft Defender Antivirus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2800497">Microsoft Defender антивирусы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11765_2795839_3179296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft's antimalware solution that provides next generation protection for desktops, portable computers, and servers.</descrip></descripGrp><ntig><termGrp><term id="2795839">Microsoft Defender Antivirus</term><termNot