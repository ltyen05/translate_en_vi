type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1988071">кіру ақпараты</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12369_1981671_626381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that includes identification and proof of identification that is used to gain access to local and network resources.</descrip></descripGrp><ntig><termGrp><term id="1981671">sign-in information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626381">тіркелгі деректері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12369_2749763_1988071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that includes identification and proof of identification that is used to gain access to local and network resources.</descrip></descripGrp><ntig><termGrp><term id="2749763">credential</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1988071">кіру ақпараты</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12369_2749763_626381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that includes identification and proof of identification that is used to gain access to local and network resources.</descrip></descripGrp><ntig><termGrp><term id="2749763">credential</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626381">тіркелгі деректері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12369_606_1988071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that includes identification and proof of identification that is used to gain access to local and network resources.</descrip></descripGrp><ntig><termGrp><term id="606">credentials</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1988071">кіру ақпараты</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12369_606_626381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that includes identification and proof of identification that is used to gain access to local and network resources.</descrip></descripGrp><ntig><termGrp><term id="606">credentials</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626381">тіркелгі деректері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12370_17867_626080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The technology that is based on the Component Object Model (COM) that enables interoperability among ActiveX components, including OLE components. Formerly referred to as OLE Automation.</descrip></descripGrp><ntig><termGrp><term id="17867">Automation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626080">автоматтандыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12381_121120_627611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that consists of advanced text wrap functionality, allowing the user to select from various styles to specify how text flows around objects or graphics in a document.</descrip></descripGrp><ntig><termGrp><term id="121120">text wrapping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627611">мәтін тасымалдау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12382_34696_626282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The three-dimensional space that is defined by a set of coordinates for representing color on devices such as monitors, scanners, and printers. For example, in the LAB color space, the colors are defined in terms of their luminance or whiteness (L), redness-greenness (A), and yellowness-blueness (B); the HVC system uses hue (H), value (V), and chroma (C). The two most common color space models are RGB and YUV.</descrip></descripGrp><ntig><termGrp><term id="34696">color space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626282">түстер кеңістігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12382_34697_626282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The three-dimensional space that is defined by a set of coordinates for representing color on devices such as monitors, scanners, and printers. For example, in the LAB color space, the colors are defined in terms of their luminance or whiteness (L), redness-greenness (A), and yellowness-blueness (B); the HVC system uses hue (H), value (V), and chroma (C). The two most common color space models are RGB and YUV.</descrip></descripGrp><ntig><termGrp><term id="34697">color space model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626282">түстер кеңістігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12384_187399_2098735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code access security (CAS) state assigned to managed assemblies. The level of trust granted to an application or Web service affects its ability to use system resources while executing. Assemblies that have full trust can access any resource that is subject to operating system security, and all privileged operations are supported.</descrip></descripGrp><ntig><termGrp><term id="187399">full trust</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098735">толық сенім</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12386_46887_2098736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 32-bit integer that identifies a property set.</descrip></descripGrp><ntig><termGrp><term id="46887">dispatch ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098736">өңдеу идентификаторы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12387_262437_626408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encryption algorithm that uses a 56-bit key and maps a 64-bit input block to a 64-bit output block. The key appears to be a 64-bit key, but one bit in each of the eight bytes is used for odd parity, resulting in 56 bits of usable key.</descrip></descripGrp><ntig><termGrp><term id="262437">Data Encryption Standard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626408">DES</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12387_262438_626408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encryption algorithm that uses a 56-bit key and maps a 64-bit input block to a 64-bit output block. The key appears to be a 64-bit key, but one bit in each of the eight bytes is used for odd parity, resulting in 56 bits of usable key.</descrip></descripGrp><ntig><termGrp><term id="262438">DES</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626408">DES</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1239_25547_1981738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The indication that the phone is busy.</descrip></descripGrp><ntig><termGrp><term id="25547">busy signal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1981738">бос емес сигналы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="124_53143_626627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The inability of a computer system or related device to operate reliably or to operate at all.</descrip></descripGrp><ntig><termGrp><term id="53143">failure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626627">қате</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1240_76592_2209856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operator that manipulates binary values at the bit level. In some programming languages, logical operators are identical to Boolean operators, which manipulate true and false values.</descrip></descripGrp><ntig><termGrp><term id="76592">logical operator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2209856">логикалық оператор</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12400_52903_2418944"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In geometry and computer graphics, one side of a solid object, such as a cube.</descrip></descripGrp><ntig><termGrp><term id="52903">face</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2418944">бет</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12405_184041_1778934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode that enables the user to move a document by dragging it. Panning mode is available when a Word document is displayed on a preview pane.</descrip></descripGrp><ntig><termGrp><term id="184041">panning mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1778934">панорамалау режимі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12406_24448_2180069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The size of the area of memory reserved for temporary storage of data.</descrip></descripGrp><ntig><termGrp><term id="24448">buffer size</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2180069">буфер өлшемі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12407_475177_1030661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field for the confirmation status used to categorize how firmly a service activity has been scheduled.</descrip></descripGrp><ntig><termGrp><term id="475177">Show Time As</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030661">Уақытты көрсету тәсілі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12409_331761_615079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A suite of Microsoft productivity software that supports common business tasks, including word processing, email, presentations, and data management and analysis.</descrip></descripGrp><ntig><termGrp><term id="331761">Microsoft® Office Small Business 2007</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615079">Microsoft® Office Small Business 2007 (қазақша нұсқасы)</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1241_31081_407634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calculated value that is used to test data for the presence of errors that can occur when data is transmitted or when it is written to disk. The checksum is calculated for a given chunk of data by sequentially combining all the bytes of data with a series of arithmetic or logical operations. After the data is transmitted or stored, a new checksum is calculated in the same way using the (possibly faulty) transmitted or stored data. If the two checksums do not match, an error has occurred, and the data should be transmitted or stored again. Checksums cannot detect all errors, and they cannot be used to correct erroneous data.</descrip></descripGrp><ntig><termGrp><term id="31081">checksum</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407634">тексеру қорытындысы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12410_2332_1031802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a message sent in real time through a network to a private chat area.</descrip></descripGrp><ntig><termGrp><term id="2332">instant messaging</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1031802">лездік хабарлармен алмасу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12410_2333_1031802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a message sent in real time through a network to a private chat area.</descrip></descripGrp><ntig><termGrp><term id="2333">IM</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1031802">лездік хабарлармен алмасу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12412_1056070_1490899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendaring feature that automatically manages resources. Resource requests are automatically accepted or denied depending on availability and policies.</descrip></descripGrp><ntig><termGrp><term id="1056070">Booking Attendant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1490899">Ресурстар тіркеуші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12412_307447_1490899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendaring feature that automatically manages resources. Resource requests are automatically accepted or denied depending on availability and policies.</descrip></descripGrp><ntig><termGrp><term id="307447">Resource Booking Attendant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1490899">Ресурстар тіркеуші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12413_1484549_2098737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of ad click that follows a hyperlink to another Web site, or a page or frame within the initial Web site.</descrip></descripGrp><ntig><termGrp><term id="1484549">click-through</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098737">жарнамалық хабарландыруды таңдау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12413_32342_2098737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of ad click that follows a hyperlink to another Web site, or a page or frame within the initial Web site.</descrip></descripGrp><ntig><termGrp><term id="32342">clickthrough</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098737">жарнамалық хабарландыруды таңдау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12414_237907_2098738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of block diagram that contains 3-D geometric shapes, directional lines, and a vanishing point for changing depth and perspective. Use for functional decomposition, hierarchical, and data structure diagrams.</descrip></descripGrp><ntig><termGrp><term id="237907">block diagram with perspective</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098738">үш өлшемді блок диаграмма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12419_237283_615656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An enhanced spell-check feature that looks at words before or after the word in question to assess proper usage. This allows the software to flag correctly-spelled words as 'wrong' if the usage appears to be incorrect.</descrip></descripGrp><ntig><termGrp><term id="237283">Contextual Spelling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615656">емлені мәтінмәндік тексеру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12427_252659_2389179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A possible entry point to an asset that could be used by an adversary to adversely affect that asset.</descrip></descripGrp><ntig><termGrp><term id="252659">threat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2389179">қауіп</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12430_143663_2098739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A format that consists of literal display characters (such as parentheses, periods, and hyphens) and mask characters that specify where data is to be entered as well as what kind of data and how many characters are allowed.</descrip></descripGrp><ntig><termGrp><term id="143663">input mask</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098739">енгізу маскасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12432_380748_1030609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A schedulable appointment to provide a service to a customer. A service activity uses one or more resources to perform a service at a specific time and place.</descrip></descripGrp><ntig><termGrp><term id="380748">service activity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030609">қызмет әрекеті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12434_231840_615357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove unread markers from specified elements in the workspace.</descrip></descripGrp><ntig><termGrp><term id="231840">mark read</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615357">оқылған деп белгілеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12439_316643_627392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optical device found in scanners and fax machines that moves across the subject being scanned, converts light and dark areas to electrical signals, and sends those signals to the scanning system for processing.</descrip></descripGrp><ntig><termGrp><term id="316643">scan head</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627392">мәтіналушы бас</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1244_128141_2070129"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned by a software developer to identify a particular program at a particular stage, before and after public release. Successive public releases of a program are assigned increasingly higher numbers. Version numbers usually include decimal fractions. Major changes are usually marked by a change in the whole number, whereas for minor changes only the number after the decimal point increases.</descrip></descripGrp><ntig><termGrp><term id="128141">version number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070129">Нұсқа нөмірі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12441_181925_2221491"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Role assignment that applies to the site as a whole.</descrip></descripGrp><ntig><termGrp><term id="181925">system role assignment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221491">жүйелік рөл