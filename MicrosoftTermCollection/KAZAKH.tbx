><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2878724">OSS</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50664_2867742_2878725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that is made available under a license that grants all users access to the source code to the software (rather than just the binary code) and grants some rights to modify the source code and rights to distribute such modifications.</descrip></descripGrp><ntig><termGrp><term id="2867742">open-source software</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2878725">бастапқы коды ашық бағдарламалық құрал</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50665_2867743_2878726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dedicated device in which certain features of the device are restricted.</descrip></descripGrp><ntig><termGrp><term id="2867743">kiosk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2878726">киоск</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50666_2867744_2867845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option in Microsoft Edge in which a customer can copy a URL and paste as a visual link, which provides a card with a key image and title, as well as additional information from the page where available.</descrip></descripGrp><ntig><termGrp><term id="2867744">web preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2867845">вебте алдын ала қарау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50667_2867745_2878727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability that provides insights about potential threats using deep collection and analysis to prevent users from being compromised by malicious files and URLs.</descrip></descripGrp><ntig><termGrp><term id="2867745">detonation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2878727">детонация</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50670_2868303_2868582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web script that is placed on an openly accessible web server to allow an adversary to use the web server as a gateway into a network.</descrip></descripGrp><ntig><termGrp><term id="2868303">web shell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2868582">веб-шелл</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50671_2868399_2884730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An employee, usually with no formal training or educational background in computer science, who works on the frontlines of an organization and develop creative solutions to improve business operations with user-friendly technology.</descrip></descripGrp><ntig><termGrp><term id="2868399">citizen developer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2884730">әуесқой әзірлеуші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50672_2868545_2870987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Two apps that are grouped together by the customer, so both apps open at the same time.​</descrip></descripGrp><ntig><termGrp><term id="2868545">app group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2870987">бағдарлама тобы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50673_2868546_2870993"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enlarge an app on a dual-screen device so that it goes across both screens.</descrip></descripGrp><ntig><termGrp><term id="2868546">maximize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2870993">барынша үлкейту</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50674_2868547_2870991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reorient a dual-screen device that is folded in order to see the other screen.</descrip></descripGrp><ntig><termGrp><term id="2868547">flip</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2870991">аудару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50675_2868548_2870992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move one screen of a dual-screen device backward.</descrip></descripGrp><ntig><termGrp><term id="2868548">fold</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2870992">бүктеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50679_2868550_2870988"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that has been designed specifically for dual-screen devices.</descrip></descripGrp><ntig><termGrp><term id="2868550">Dual-screen enhanced app</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2870988">Екі экранды жақсартылған қолданба</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50681_2868552_2870989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The hinge that holds the two screens together on the Surface Duo dual-screen device.</descrip></descripGrp><ntig><termGrp><term id="2868552">Dynamic 360° Hinge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2870989">Dynamic 360° Hinge</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50682_2868553_2868815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft incentive program designed to reward eligible partners for driving incremental Office 365 and Azure growth along with adherence to tracked management metric KPIs.</descrip></descripGrp><ntig><termGrp><term id="2868553">Accelerated Growth Incentives</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2868815">Accelerated Growth Incentives</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50683_2868554_2868858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft program designed to reward partners for driving consumption of Microsoft Azure services that have been purchased via EA, CASA/EES, MOSA, OSPA, and OSSA.</descrip></descripGrp><ntig><termGrp><term id="2868554">Azure Incentives</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2868858">Azure Incentives</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50684_2868555_2868901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft initiative designed to give solution providers an opportunity to earn supplemental revenue when they assist end customers with software selection and implementation of Microsoft Dynamics CRM.</descrip></descripGrp><ntig><termGrp><term id="2868555">Certified Software Advisor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2868901">Certified Software Advisor</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50684_2898928_2868901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft initiative designed to give solution providers an opportunity to earn supplemental revenue when they assist end customers with software selection and implementation of Microsoft Dynamics CRM.</descrip></descripGrp><ntig><termGrp><term id="2898928">CSA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2868901">Certified Software Advisor</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50685_2868556_2868945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft incentive program designed to reward Commercial Distributor partners for driving Open License and Office FPP/ESD revenue through resellers.</descrip></descripGrp><ntig><termGrp><term id="2868556">Commercial Distributor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2868945">Commercial Distributor</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50686_2868557_2868997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft incentive program designed to reward and support CSP direct bill partners for driving the activation and enablement of customers with Microsoft-based Online Services.</descrip></descripGrp><ntig><termGrp><term id="2868557">CSP Direct Bill Partner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2868997">CSP Direct Bill Partner</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50687_2868558_2869087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft incentive program for Cloud Solution Provider (CSP) partners that engage with a two-tier provider, commonly a distributor or hoster, who maintains the relationship with Microsoft and provides additional functions and services that the partner does not.</descrip></descripGrp><ntig><termGrp><term id="2868558">CSP Indirect Provider</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2869087">CSP Indirect Provider</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50688_2868559_2869172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft incentive program for Cloud Solution Provider (CSP) resellers that are engaged by indirect CSP partners, who maintain the relationship with Microsoft, and who provide additional functions and services that the indirect CSP partner does not.</descrip></descripGrp><ntig><termGrp><term id="2868559">CSP Indirect Reseller</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2869172">CSP Indirect Reseller</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50689_2868560_2869357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft incentive program designed to reward LSPs for securing and maintaining annuity relationships with Enterprise customers.</descrip></descripGrp><ntig><termGrp><term id="2868560">Enterprise Incentives</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2869357">Enterprise Incentives</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5069_160054_626283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for converting a color in one color space to another color space. Typically, this conversion is from YUV colors from a video source to RGB for display.</descrip></descripGrp><ntig><termGrp><term id="160054">color-space conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626283">түстік кеңістікті өзгерту</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5069_210048_626283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for converting a color in one color space to another color space. Typically, this conversion is from YUV colors from a video source to RGB for display.</descrip></descripGrp><ntig><termGrp><term id="210048">color space conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626283">түстік кеңістікті өзгерту</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50690_2868561_2869399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft incentive program designed to reward eligible partners for driving Open License and Academic revenue, specifically for strategic workload solutions.</descrip></descripGrp><ntig><termGrp><term id="2868561">Managed Reseller</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2869399">Managed Reseller</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50691_2868562_2869441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft program designed to reward and support partners for driving the activation and enablement of customers with Azure services.</descrip></descripGrp><ntig><termGrp><term id="2868562">Microsoft Commerce Incentives</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plur