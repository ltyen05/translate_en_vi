 Web, rather than as an ink-on-paper magazine.</descrip></descripGrp><ntig><termGrp><term id="879">web magazine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2600764">электрондық журнал</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="800_879_2600765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An electronic publication distributed primarily through the World Wide Web, rather than as an ink-on-paper magazine.</descrip></descripGrp><ntig><termGrp><term id="879">web magazine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2600765">журнал</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8005_534987_2197945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The return of a different type of cursor than the user had declared.</descrip></descripGrp><ntig><termGrp><term id="534987">implicit cursor conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2197945">курсордың бұзылуы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></ter