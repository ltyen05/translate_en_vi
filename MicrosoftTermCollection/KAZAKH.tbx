termNote></termGrp></ntig></langSet></termEntry><termEntry id="44651_2513850_2738187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The extension that enables access to data across Office 365 services and Azure Active Directory through Microsoft Graph.</descrip></descripGrp><ntig><termGrp><term id="2513850">Microsoft Office 365 Connected Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2738187">Microsoft Office 365 қосылған қызметтері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44660_2514598_2518331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The website that allows developers to experiment with using OAuth2 with Outlook APIs.</descrip></descripGrp><ntig><termGrp><term id="2514598">OAuth Sandbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2518331">OAuth сынақ ортасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44661_2514599_2518328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The website that allows developers to edit the JSON definition of an actionable message card and immediately see the rendered result.</descrip></descripGrp><ntig><termGrp><term id="2514599">Card Playground</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2518328">Карта кодын интерактивті іске қосу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44662_2514600_2518329"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The website that allows developers to edit the JSON definition of a connector card and see the rendered result.</descrip></descripGrp><ntig><termGrp><term id="2514600">Connectors Sandbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2518329">Коннекторлар сынақ ортасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44663_2514602_2518327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API which surfaces functionality to access and change a user’s automatic replies settings.</descrip></descripGrp><ntig><termGrp><term id="2514602">Automatic Replies Settings API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2518327">Автоматты жауаптар параметрлеріне арналған API</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44664_2514606_2518330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API which uses people’s calendars and other constraints to find a good time for those people to meet.</descrip></descripGrp><ntig><termGrp><term id="2514606">Find Meeting Times API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2518330">Жиналыс уақыттарын іздеуге арналған API</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44665_2514607_2518350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API which surfaces functionality to create, get, update, and delete a user’s tasks.</descrip></descripGrp><ntig><termGrp><term id="2514607">Tasks API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2518350">Тапсырмаларға арналған API</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44666_2514608_2518348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API which surfaces functionality to manipulate and send messages, attachments, events, and folders.</descrip></descripGrp><ntig><termGrp><term id="2514608">Office 365 Mail API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2518348">Office 365 поштасына арналған API</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44668_2515502_2518463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The setting (toggle) on account.microsoft.com/family that, when switched on, requires children to get adult permission for the things they buy in the Windows and Xbox stores — except for what they get with gift cards or money in their Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2515502">Ask a parent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2518463">Ата-анадан сұрау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44669_2515503_2518464"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of Microsoft Defender Advanced Threat Protection, which helps protect the data in the specified folder locations from modification by suspicious or malicious apps.</descrip></descripGrp><ntig><termGrp><term id="2515503">controlled folder access</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2518464">қалтаға арналған бақыланатын қатынасу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44670_2515507_2518465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Groove Music that allows the sound in specified frequency bands to be amplified or reduced, in order to adjust the quality and character of the sound.​</descrip></descripGrp><ntig><termGrp><term id="2515507">equalizer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2518465">эквалайзер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44671_2515527_2518472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of people who uses or shares a common language or dialect and contributes to language-related activities for Windows features.</descrip></descripGrp><ntig><termGrp><term id="2515527">Language Community</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2518472">Тіл қауымдастығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44672_2515529_2518473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section in the Feedback Hub app where users can organize language-related activities for their Language community.</descrip></descripGrp><ntig><termGrp><term id="2515529">Language Community tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></la