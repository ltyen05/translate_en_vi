e type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13579_392123_395670"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft web browser.</descrip></descripGrp><ntig><termGrp><term id="392123">Windows Internet Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="395670">Internet Explorer</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1358_294446_638227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove an association or connection.</descrip></descripGrp><ntig><termGrp><term id="294446">drop</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="638227">жою</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13583_156037_1615262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Seven principles agreed to by the United States and the European Union for the transfer of PII from the European Union to the United States, which a company must adhere to if it registers for Safe Harbor. The seven principles are categorized into the following subjects: (1) Notice; (2) Choice; (3) Access; (4) Onward Transfer; (5) Security; (6) Data Integrity; and (7) Enforcement.</descrip></descripGrp><ntig><termGrp><term id="156037">Safe Harbor Principles</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1615262">Safe Harbor келісімінің қағидалары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13586_323480_2364335"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft technology designed to help enterprise customers control and protect critical digital information by offering easy-to-use, flexible, and persistent policy expression and enforcement.</descrip></descripGrp><ntig><termGrp><term id="323480">Active Directory Rights Management Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2364335">Active Directory Rights Management Services</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13586_323480_2364336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft technology designed to help enterprise customers control and protect critical digital information by offering easy-to-use, flexible, and persistent policy expression and enforcement.</descrip></descripGrp><ntig><termGrp><term id="323480">Active Directory Rights Management Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2364336">AD RMS</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13586_323482_2364335"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft technology designed to help enterprise customers control and protect critical digital information by offering easy-to-use, flexible, and persistent policy expression and enforcement.</descrip></descripGrp><ntig><termGrp><term id="323482">AD RMS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2364335">Active Directory Rights Management Services</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13586_323482_2364336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft technology designed to help enterprise customers control and protect critical digital information by offering easy-to-use, flexible, and persistent policy expression and enforcement.</descrip></descripGrp><ntig><termGrp><term id="323482">AD RMS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2364336">AD RMS</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13587_25017_2486246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To combine products for sale as a lot. Frequently, operating system software and some widely used applications are bundled with a computer system for sale.</descrip></descripGrp><ntig><termGrp><term id="25017">bundle</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2486246">жинау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13592_25636_626178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The surface of a button where text or an image (typically indicating the button's function) may be displayed.</descrip></descripGrp><ntig><termGrp><term id="25636">button face</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626178">түймешік беті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13594_503136_1320147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The presence status that indicates a user hasn't used his/her mouse, keyboard, computer, mobile phone, or communications device for a specified time.</descrip></descripGrp><ntig><termGrp><term id="503136">Inactive</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1320147">Белсенді емес</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13598_26923_626192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that notifies a user that a call is coming in while the user is in a call.</descrip></descripGrp><ntig><termGrp><term id="26923">call waiting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626192">қоңырауды күту</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13599_181257_2215342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A published report that accepts input values through parameters.</descrip></descripGrp><ntig><termGrp><term id="181257">parameterized report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215342">параметрленген есеп</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="136_557698_1030699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system job that detects duplicate records for one entity.</descrip></descripGrp><ntig><termGrp><term id="557698">Bulk Duplicate Detection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030699">Қайталама жазбаларды жаппай жою</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1360_358369_362312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encoding mechanism that converts binary data into printable ASCII characters so that the data can be included in the message body without violating SMTP conventions.</descrip></descripGrp><ntig><termGrp><term id="358369">UUENCODE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="362312">ЮЮКОД</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13600_237376_1144938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of exporting objects such as resources, templates, and galleries from a source system and importing them to a destination system. A common application is moving data from a development server to a production server.</descrip></descripGrp><ntig><termGrp><term id="237376">content deployment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1144938">мазмұнды орналастыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13604_34469_626277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The particular range of colors that a device or color model is able to produce.</descrip></descripGrp><ntig><termGrp><term id="34469">color gamut</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626277">түсті бояғыштар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13604_660552_626277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The particular range of colors that a device or color model is able to produce.</descrip></descripGrp><ntig><termGrp><term id="660552">gamut</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626277">түсті бояғыштар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13605_347939_615399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file or set of files that defines the data structure, appearance, and behavior of a form.</descrip></descripGrp><ntig><termGrp><term id="347939">form template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615399">пішін үлгісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1361_104351_2219734"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A multi-phase process that copies all the data and log pages from a specified backup to a specified database (the data-copy phase) and rolls forward all the transactions that are logged in the backup (the redo phase). At this point, by default, a restore rolls back any incomplete transactions (the undo phase), which completes the recovery of the database and makes it available to users.</descrip></descripGrp><ntig><termGrp><term id="104351">restore</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2219734">қалпына келтіру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13611_187814_2717366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To restructure code to make it easier to understand and to maintain, while preserving its functionality.</descrip></descripGrp><ntig><termGrp><term id="187814">refactor</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2717366">рефакторинг</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13614_97245_1839299"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Electromagnetic waves longer than about 0.3 mm (frequencies lower than about 1 THz). Radio is used to transmit a wide variety of signals, using various frequency ranges and types of modulation, such as AM and FM broadcasts, microwave relays, and television broadcasts.</descrip></descripGrp><ntig><termGrp><term id="97245">radio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1839299">радио</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13617_182098_2201527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data flow component that loads data into a data store.</descrip></descripGrp><ntig><termGrp><term id="182098">destination adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2201527">деректерді жүктеу адаптері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1362_360135_615545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that summarizes and analyzes data in a datasheet or form. You can use different levels of detail or organize data by dragging the fields and items, or by showing and hiding items in the drop-down lists for the fields.</descrip></descripGrp><ntig><termGrp><term id="360135">PivotTable view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><te