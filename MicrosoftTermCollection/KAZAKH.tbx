angSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Project that includes only basic features such as templates, scheduling, and easy report creation.</descrip></descripGrp><ntig><termGrp><term id="2499977">Project Standard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2501585">Стандартты Project</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44383_2499978_2501584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The on-premises solution of Project that includes all the Project Standard features and that also includes the ability to call or message team members inside Project and to allocate tasks and resources via drag and drop.</descrip></descripGrp><ntig><termGrp><term id="2499978">Project Professional</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2501584">Кәсіпқойларға арналған Project</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44384_2499979_2501587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Visio that includes basic feature such as starter diagrams.</descrip></descripGrp><ntig><termGrp><term id="2499979">Visio Standard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></lan