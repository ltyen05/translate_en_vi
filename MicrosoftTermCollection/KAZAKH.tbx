<descripGrp><descrip type="definition">Data source connection information that is encapsulated in an item. Can be managed as an item in the report server folder namespace.</descrip></descripGrp><ntig><termGrp><term id="181844">shared data source item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2220261">ортақ деректер көзінің элементі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32470_1681341_2105118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video preview for a Lync user that provides options to answer with video from within the notification.</descrip></descripGrp><ntig><termGrp><term id="1681341">personal preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2105118">жеке алдын ала қарап шығу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32471_1681352_1688300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web browser component of Windows that provides a traditional and familiar browsing experience.</descrip></descripGrp><ntig><termGrp><term id="1681352">Internet Explorer for the desktop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1688300">Жұмыс үстеліне арналған Internet Explorer</term><t