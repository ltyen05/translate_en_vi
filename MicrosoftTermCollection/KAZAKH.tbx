crip type="definition">A pictorial graphic such as a digital photograph or illustration.</descrip></descripGrp><ntig><termGrp><term id="64520">image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615303">сурет</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1294_64520_626466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pictorial graphic such as a digital photograph or illustration.</descrip></descripGrp><ntig><termGrp><term id="64520">image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626466">сандық сурет</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12942_94098_2915698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that turns a device off and on.</descrip></descripGrp><ntig><termGrp><term id="94098">power button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2915698">іске қосу түймешігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12943_234576_626857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item in the Journal folder that acts as a shortcut to an activity that has been recorded.</descrip></descripGrp><ntig><termGrp><term id="234576">journal entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626857">жұрнал жазбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12948_182890_1305847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compilation of the different measurements that a product is available in. A unit group contains the base unit in which a product is available, for example, a two-liter. It then lists all the different increments that this base unit is packaged in for sale, such as an individual two-liter bottle or a case of 6 two-liter bottles, and also indicates which measurement is the primary unit.</descrip></descripGrp><ntig><termGrp><term id="182890">unit group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1305847">бірлік тобы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1295_418604_2221191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A relational database structure in which data is maintained in a single fact table at the center of the schema with additional dimension data stored in dimension tables. Each dimension table is directly related to and usually joined to the fact table by a key column.</descrip></descripGrp><ntig><termGrp><term id="418604">star schema</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221191">жұлдыз схемасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12951_210502_779552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gatherer plug-in that is responsible for indexing the anchor text. Anchor text is an important feature in the ranking of the search results in v3.</descrip></descripGrp><ntig><termGrp><term id="210502">anchor plugin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779552">кілт сөз анықтаудың қосылатын модулі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12954_134044_1250162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search technology used to separate text into individual words.</descrip></descripGrp><ntig><termGrp><term id="134044">word breaker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250162">сөз бөлгіш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12958_1060966_1250163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To activate something making it available for use.</descrip></descripGrp><ntig><termGrp><term id="1060966">turn on</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250163">қосу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12958_50552_1250163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To activate something making it available for use.</descrip></descripGrp><ntig><termGrp><term id="50552">enable</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250163">қосу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1296_101769_2070135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A URL that does not contain any protocol information and whose domain and some or all directory names are omitted, leaving some or no directories followed by the document name and extension.</descrip></descripGrp><ntig><termGrp><term id="101769">relative URL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070135">қатысты URL мекенжайы</term><termNote type="geographicalUsage">KAZ</termNote><termN