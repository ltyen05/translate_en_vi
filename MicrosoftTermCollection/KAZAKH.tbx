<descrip type="definition">A traditional phone, which has a wired connection (as opposed to a mobile phone).</descrip></descripGrp><ntig><termGrp><term id="1805617">landline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2058535">сымды телефон</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33624_1805618_2058537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables sharing video with other users live over the Internet.</descrip></descripGrp><ntig><termGrp><term id="1805618">live streaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2058537">тікелей бөлісу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33625_1805619_2058538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of information supplied by the user that appears in the mood panel beside the user's Skype Name for other users to see.</descrip></descripGrp><ntig><termGrp><term id="1805619">mood message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2058538">көңіл күй туралы хабар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNo