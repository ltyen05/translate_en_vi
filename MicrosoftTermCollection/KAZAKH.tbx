 type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43243_2447290_3128138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that you select to accept the contents of the dialog.</descrip></descripGrp><ntig><termGrp><term id="2447290">OK</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3128138">Жарайды</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43243_3128054_3128138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that you select to accept the contents of the dialog.</descrip></descripGrp><ntig><termGrp><term id="3128054">OK</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3128138">Жарайды</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43257_2450114_2453709"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A target error margin for recall that is used to estimate number of additional files necessary needed for review.</descrip></descripGrp><ntig><termGrp><term id="2450114">assessment target</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2453709">бағалау мақсаты</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43258_2450131_2453724"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A percentage of files that need to be reviewed, which can be defined by the user of Advanced eDiscovery.</descrip></descripGrp><ntig><termGrp><term id="2450131">cut-off point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2453724">шекті нүкте</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43259_2450137_2453726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery view where detailed interim cumulative results can be viewed after each Relevance training cycle.</descrip></descripGrp><ntig><termGrp><term id="2450137">Detailed Results</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2453726">Толық нәтижелер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43261_2450561_2452185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process where an expert labels each file and issue within a sample as relevant, not relevant, or an item that should be skipped as part of Advanced eDiscovery Relevance training.</descrip></descripGrp><ntig><termGrp><term id="2450561">tagging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2452185">белгілеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43262_2450562_2453747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery panel where users can tag files and issues as relevant, not relevant, or where they can choose to skip it.</descrip></descripGrp><ntig><termGrp><term id="2450562">Tagging panel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2453747">Белгілеу тақтасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43263_2450563_2453748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A margin of error for the recall value that is used to estimate the number of files that need to be reviewed by Advanced eDiscovery.</descrip></descripGrp><ntig><termGrp><term id="2450563">target error margin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2453748">мақсатты қателік шегі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43264_2450798_2453713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery mode that allows users to process new file loads after other file loads were already started, see a comparison of the loads, and decide if they want to merge the new loads with the existing ones or split them.</descrip></descripGrp><ntig><termGrp><term id="2450798">Catch-up</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2453713">Толықтыра өңдеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43265_2450799_2453735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery option that allows users to continue Relevance training, treating new loads and old loads like the same set of files.</descrip></descripGrp><ntig><termGrp><term id="2450799">Merge loads</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2453735">Файлдар жинағын біріктіру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43266_2450800_2453746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery option that allows users to perform Relevance training on new file loads separately from old file loads.</descrip></descripGrp><ntig><termGrp><term id="2450800">Split loads</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2453746">Файлдар жинағын бөлу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43267_2450801_2453743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery mode that allows users to incorporate a new load with existing loads using Catch-up and which triggers any new necessary Relevance training.</descrip></descripGrp><ntig><termGrp><term id="2450801">Rolling loads</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2453743">файлдар жинағын қосу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43268_2450802_2453732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery feature that allows users to select a set of parameters that will determine which files are exported in a batch.</descrip></descripGrp><ntig><termGrp><term id="2450802">Export batch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2453732">Экспорт жиынтығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43269_2450812_2453737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that is in its original file type.</descrip></descripGrp><ntig><termGrp><term id="2450812">native file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2453737">негізгі файл</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43270_2450813_2453741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phase in e-discovery where native files are prepared to be loaded into a document review platform, metadata is extracted from files, and data culling techniques are employed.</descrip></descripGrp><ntig><termGrp><term id="2450813">processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2453741">өңдеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43271_2450814_2453141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery metadata type that identifies whether file is a document, email or an attachment.</descrip></descripGrp><ntig><termGrp><term id="2450814">Doc_type</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote 