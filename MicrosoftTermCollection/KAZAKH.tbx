er">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626985">пошталық жапсырма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9110_316263_627446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A label that is printed with a recipient's address and is used to mail or ship an item.</descrip></descripGrp><ntig><termGrp><term id="316263">shipping label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627446">жеткізіп беру мекенжайы көрсетілген жапсырма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9110_77456_626985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A label that is printed with a recipient's address and is used to mail or ship an item.</descrip></descripGrp><ntig><termGrp><term id="77456">mailing label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626985">пошталық жапсырма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9110_77456_627446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A label that is printed with a recipient's address and is used to mail or s