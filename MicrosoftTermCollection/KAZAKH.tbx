mEntry id="50474_2857356_2858445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of sharing link that allows recipients to access the file or folder without authenticating.</descrip></descripGrp><ntig><termGrp><term id="2857356">guest access link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2858445">анонимді қатынасу сілтемесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50474_2857356_2858447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of sharing link that allows recipients to access the file or folder without authenticating.</descrip></descripGrp><ntig><termGrp><term id="2857356">guest access link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2858447">қонақ ретінде қатынасу сілтемесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50475_2857362_2858503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The shared sense of belonging that builds cohesion within a defined team, helping teammates to work as one.</descrip></descripGrp><ntig><termGrp><term id="2857362">collective identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2858503">ұжымдық сана</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50476_2857364_2858429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to take into account not just yourself and your teammates, but also the context that surrounds you.</descrip></descripGrp><ntig><termGrp><term id="2857364">situational awareness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2858429">жағдаятты хабардарлық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50477_2857366_2858492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to sense the emotions of others and recognize the impact that one’s actions may have on others.</descrip></descripGrp><ntig><termGrp><term id="2857366">co-awareness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2858492">бірлесе хабардар болу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50478_2857368_2858510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The productive force that emerges when a team harnesses their differences, as a result of nurturing and balancing the other key team dynamics: team purpose, collective identity, awareness, inclusion, trust and vulnerability.</descrip></descripGrp><ntig><termGrp><term id="2857368">constructive tension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2858510">сындарлы шиеленіс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50479_2857369_2858457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The joint understanding of self and others that enables teams to navigate interpersonal dynamics and foster team cohesion.</descrip></descripGrp><ntig><termGrp><term id="2857369">awareness and inclusion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2858457">хабардар болу және қосу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50480_2857376_2858444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">UI label for inserting an Anyone link.</descrip></descripGrp><ntig><termGrp><term id="2857376">Anyone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2858444">Кез келген пайдаланушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></l