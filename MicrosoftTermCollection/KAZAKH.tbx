ible bounding box that contains the notes that you type or paste on a page.</descrip></descripGrp><ntig><termGrp><term id="1087288">note container</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1131581">жазбаларға арналған контейнер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2354_237934_2070183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window that shows a hierarchical view of the masters and styles.</descrip></descripGrp><ntig><termGrp><term id="237934">Master Explorer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070183">Негізгі жетектеуші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23540_1087646_1091095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based serialization format used by SharePoint-based servers to represent Access Services database applications. It includes database properties, queries, forms, reports, and macros.</descrip></descripGrp><ntig><termGrp><term id="1087646">Application XML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1091095">AXL</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type=