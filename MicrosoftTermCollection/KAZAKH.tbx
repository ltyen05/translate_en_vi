<descrip type="definition">A group of related Service Broker conversations. Messages in the same conversation group can only be processed by one service program at a time.</descrip></descripGrp><ntig><termGrp><term id="180749">conversation group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2197519">хабарлар тобы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53220_3031831_3032558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy template that helps detect cross-country or cross-region data transfers, identify the amount and types of personal data being transferred, and take actions to remediate risks, such as applying additional encryption or restricting access for the data being transferred.</descrip></descripGrp><ntig><termGrp><term id="3031831">cross-border transfers</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3032558">трансшекаралық тасымалдаулар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53221_3031832_3032557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transfer of personal data across a geographic border (such as country or regional borders).</descrip></descripGrp><ntig><termGrp><term id="3031832">cross-border transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3032557">трансшекаралық тасымалдау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53222_3031833_3032517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy template that helps detect personal data with external, excessive, and idle access and trigger remediation actions including sending notifications to the data or site owners to remove unnecessary accesses.</descrip></descripGrp><ntig><termGrp><term id="3031833">data overexposure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3032517">деректердің шамадан тыс таралуы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53223_3031834_3032545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy template that helps detect personal data that has not been used for more than 90 days and trigger remediation actions, including sending notifications to data owners to apply retention labels or disposing of the information immediately.</descrip></descripGrp><ntig><termGrp><term id="3031834">data minimization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3032545">деректерді азайту</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53224_3031835_3032555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The metered service that enables licensed M365 commercial, consumer, and education users to use Office Online to view, edit, and coauthor documents stored on cloud storage providers other than SharePoint or OneDrive.</descrip></descripGrp><ntig><termGrp><term id="3031835">Coauthoring</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3032555">Бірлескен авторлық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53225_3053615_3053710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cross-industry experience app in Microsoft Teams that provides seamless scheduling, analytics, and premium experiences for business-to-customer meetings, bringing together current virtual appointment experiences into one single entry point.</descrip></descripGrp><ntig><termGrp><term id="3053615">Virtual Appointments</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3053710">Виртуалды кездесулер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53225_3153774_3053710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cross-industry experience app in Microsoft Teams that provides seamless scheduling, analytics, and premium experiences for business-to-customer meetings, bringing together current virtual appointment experiences into one single entry point.</descrip></descripGrp><ntig><termGrp><term id="3153774">Virtual Appts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3053710">Виртуалды кездесулер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53226_3031837_3032549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The legacy version of School Data Sync.</descrip></descripGrp><ntig><termGrp><term id="3031837">School Data Sync (classic)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3032549">Оқу орны деректерін синхрондау (классикалық)</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53227_3031838_3032493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The device marketplace in the Microsoft Teams Admin Center that drives discovery and adoption of Teams devices from Teams Admin Center marketplace.</descrip></descripGrp><ntig><termGrp><term id="3031838">Microsoft Teams device store</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3032493">Microsoft Teams құрылғылар дүкені</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53235_3033414_3033626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The simulator for ARDK head-mounted displays that runs on Windows PCs and requires a physical + connected Samsung phone.</descrip></descripGrp><ntig><termGrp><term id="3033414">ARDK Simulator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3033626">ARDK симуляторы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53236_3033415_3033617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application for ARDK users that provides the software platform for ARDK features like hand tracking and eye tracking.</descrip></descripGrp><ntig><termGrp><term id="3033415">ARDK Platform</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3033617">ARDK платформасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53237_3033416_3033633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application for ARDK users that hosts the system UI, including the application launcher, dock, and task bar.</descrip></descripGrp><ntig><termGrp><term id="3033416">ARDK Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3033633">ARDK басты беті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53238_3033417_3033668"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application for ARDK users to calibrate their eyes for the eye tracker.</descrip></descripGrp><ntig><termGrp><term id="3033417">ARDK Eye Calibration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3033668">ARDK көз калибрлеуі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53246_3033423_3033630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone application that allows users to submit feedback from their Samsung phone about a problem with their ARDK head-mounted display.</descrip></descripGrp><ntig><termGrp><term id="3033423">ARDK Feedback</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3033630">ARDK кері байланысы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53247_3033521_3034427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UK bank holiday celebrated on June 3, 2022 to commemorate the 70th anniversary of Queen Elizabeth II's accession to the throne.</descrip></descripGrp><ntig><termGrp><term id="3033521">Platinum Jubilee Bank Holiday</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3034427">Платина мерейтойына қатысты банк демалысы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53248_3033522_3033890"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The solution that enables enterprises to easily converge employees with relevant skills necessary to resolve complex cases. It is a structured approach to have a set of SMEs work together to bring a resolution to a complex customer issue.</descrip></descripGrp><ntig><termGrp><term id="3033522">Intelligent swarming</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3033890">Интеллектуалды топтастыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53249_3033523_3033891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of bringing in a team of SMEs from across the organization and working with them to solve complex customer issues.</descrip></descripGrp><ntig><termGrp><term id="3033523">swarm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3033891">топтама</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5325_145206_1249193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To minimize the duplication of information in a relational database through effective table design.</descrip></descripGrp><ntig><termGrp><term id="145206">normalize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1249193">нормалдау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53251_3033532_3034429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Canadian holiday (colloquially known as Orange Shirt Day) celebrated on September 30 to recognize the legacy of the Canadian Indian residential school system.</descrip></descripGrp><ntig><termGrp><term id="3033532">National Day for Truth and Reconciliation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3034429">Ұлттық шындық пен татуласу күні</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53252_3033536_3034410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The US federal holiday celebrated on June 19 to commemorate the emancipation of African-American slaves, celebrated on the anniversary of June 19, 1865, the date of the announcement of General Order No. 3 by Union Army general Gordon Granger proclaiming freedom for slaves in Texas, the last state of the Confederacy with institutional slavery.</descrip></descripGrp><ntig><termGrp><term id="3033536">Juneteenth</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3034410">Азат ету күні</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53254_3033546_3034414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The day on which the US holiday Juneteenth is celebrated if the official holiday itself falls on a weekend.</descrip></descripGrp><ntig><termGrp><term id="3033546">Juneteenth (Observed)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3034414">Азат ету күні (ауыстырылған)</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53255_3033556_3034417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in the Authenticator app and Edge that allows users to upda