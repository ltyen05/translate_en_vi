calNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250359">бір рангілі желі түйіні</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22360_1043932_1374175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To apply a skin to an existing user interface.</descrip></descripGrp><ntig><termGrp><term id="1043932">skin</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1374175">көрініс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22364_1043935_1765039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A streaming technology that quickly installs Office over the Internet, internal networks, local file systems, or from offline media.</descrip></descripGrp><ntig><termGrp><term id="1043935">Click-to-Run</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1765039">Басу және жұмысқа кірісу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22364_1146100_1765039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A streaming technology that quickly installs Office over the Internet, internal networks, local file systems, or from offline media.</descrip></descripGrp><ntig><termGrp><term id="1146100">Click-to-Run technology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1765039">Басу және жұмысқа кірісу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22377_1043959_2707572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of caching the pages of a Web site on geographically dispersed servers to enable faster delivery of Web pages. When a page is requested at a URL that is content-delivery enabled, the content-delivery network routes the user's request to a cache server closer to the user. Content delivery frequently is used for high-traffic Web sites or for specific high-traffic events.</descrip></descripGrp><ntig><termGrp><term id="1043959">content delivery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2707572">контентті кэштеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22377_1177098_2707572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of caching the pages of a Web site on geographically dispersed servers to enable faster delivery of Web pages. When a page is requested at a URL that is content-delivery enabled, the content-delivery network routes the user's request to a cache server closer to the user. Content delivery frequently is used for high-traffic Web sites or for specific high-traffic events.</descrip></descripGrp><ntig><termGrp><term id="1177098">content caching</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2707572">контентті кэштеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22377_1177099_2707572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of caching the pages of a Web site on geographically dispersed servers to enable faster delivery of Web pages. When a page is requested at a URL that is content-delivery enabled, the content-delivery network routes the user's request to a cache server closer to the user. Content delivery frequently is used for high-traffic Web sites or for specific high-traffic events.</descrip></descripGrp><ntig><termGrp><term id="1177099">content distribution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2707572">контентті кэштеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2238_184055_1490890"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram that shows the relationship of items in a list. It is primarily used when the items are sequential in nature.</descrip></descripGrp><ntig><termGrp><term id="184055">process diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1490890">процесс диаграммасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22388_1044098_2074138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To apply a marker to content or items (like photos or text) to identify certain types of information.</descrip></descripGrp><ntig><termGrp><term id="1044098">tag</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2074138">тег қою</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22397_1044372_2202929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of dealing with errors (or exceptions) as they arise during the running of a program. Some programming languages, such as C++, Ada, and Eiffel, have features that aid in error handling.</descrip></descripGrp><ntig><termGrp><term id="1044372">error handling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202929">қателерді өңдеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="224_371976_615285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of combining information from a data source with a template to create pages that display multiple records per page.</descrip></descripGrp><ntig><termGrp><term id="371976">catalog merge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615285">каталогқа біріктіру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22413_1044412_2206504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of assigning initial values to variables and data structures in a program.</descrip></descripGrp><ntig><termGrp><term id="1044412">initialization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2206504">инициализация</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22419_1044455_1984902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authoritative source for an attribute value that can flow its value to other destination directories and systems.</descrip></descripGrp><ntig><termGrp><term id="1044455">attribute flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1984902">атрибут ағыны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOf