unsubscribe link.</descrip></descripGrp><ntig><termGrp><term id="2482814">marketing email</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2498367">маркетингтік электрондық хабар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44178_2482815_2498366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of logical rules for adjusting the score of a lead being nurtured by a marketing campaign.</descrip></descripGrp><ntig><termGrp><term id="2482815">lead scoring model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2498366">ықтимал тұтынушыны балдық бағалау моделі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44179_2482820_2498371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display window that shows users a variety of relevant data-driven insights and news from their contacts' interactions on social media.</descrip></descripGrp><ntig><termGrp><term id="2482820">social pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2498371">әлеуметтік желі тақтасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44180_2482821_2498372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field where you enter information about a marketing campaign used to attract or generate a lead.</descrip></descripGrp><ntig><termGrp><term id="2482821">Source Campaign</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2498372">Науқан туралы бастапқы құжат</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4419_315149_626595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value or condition that is not consistent with the true, specified, or expected value or condition.</descrip></descripGrp><ntig><termGrp><term id="315149">error</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626595">қате</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44190_2482906_2486546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to put their contacts into groups in order to allocate time between those groups.</descrip></descripGrp><ntig><termGrp><term id="2482906">My important groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2486546">Маңызды топтар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44192_2483085_2768054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer technology that identifies where human faces are present in a digital image or a video frame, without identifying any specific faces. This technology can be used to identify images or an area of one image that is relatively important because it contains a face (e.g. this might be used to auto-select the area to crop for a profile photo.)</descrip></descripGrp><ntig><termGrp><term id="2483085">face detection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2768054">адамдарды анықтау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44192_2766791_2768054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer technology that identifies where human faces are present in a digital image or a video frame, without identifying any specific faces. This technology can be used to identify images or an area of one image that is relatively important because it contains a face (e.g. this might be used to auto-select the area to crop for a profile photo.)</descrip></descripGrp><ntig><termGrp><term id="2766791">people detection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2768054">адамдарды анықтау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44194_2483156_2486247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A socket allowing computer memory (RAM) to be inserted into the computer.</descrip></descripGrp><ntig><termGrp><term id="2483156">memory slot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2486247">жад ұясы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44196_2483498_2499292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extension to the Windows Insider Program to include engagement for enterprises and SMEs through dedicated forums, blogs and events, regular surveys with IT professionals, as well as extensive documentation to support their organizations deploy Insider builds.</descrip></descripGrp><ntig><termGrp><term id="2483498">Windows Insider Program for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2499292">Бизнеске арналған Insider</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44196_2483498_2499294"><langSet xml:lang="en-US"><descripGr