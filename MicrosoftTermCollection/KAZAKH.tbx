/termGrp></ntig></langSet></termEntry><termEntry id="53433_3044721_3113215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository of data in its original, untransformed state that also provides management tools used to clean, transform, and govern the data.</descrip></descripGrp><ntig><termGrp><term id="3044721">data lakehouse</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3113215">"қойма және дерек көлі" гибридті шешімі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53433_3044721_3178456"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository of data in its original, untransformed state that also provides management tools used to clean, transform, and govern the data.</descrip></descripGrp><ntig><termGrp><term id="3044721">data lakehouse</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3178456">қойма және дерек көлі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53433_3177662_3113215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository of data in its original, untransformed state that also provides management tools used to clean, transform, and govern the data.</descrip></descripGrp><ntig><termGrp><term id="3177662">lakehouse</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatic