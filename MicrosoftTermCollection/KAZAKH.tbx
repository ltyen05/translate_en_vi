ermNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55152_3126499_3126552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that can identify types of files and specific information in them after someone labels the files and provides explanations.</descrip></descripGrp><ntig><termGrp><term id="3126499">unstructured document processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3126552">құрылымдалмаған құжатты өңдеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55153_3126500_3126550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of services that capture, transform, and process data from documents.</descrip></descripGrp><ntig><termGrp><term id="3126500">intelligent document processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3126550">интеллектуалдық құжатты өңдеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55154_3126501_3126547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security solution designed to safeguard end-to-end communication and collaboration for organizations using Microsoft tools like Teams and Outlook.</descrip></descripGrp><ntig><termGrp><term id="3126501">Microsoft Defender for Collaboration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3126547">Әрекеттестікке арналған Defender</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55154_3126501_3126551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security solution designed to safeguard end-to-end communication and collaboration for organizations using Microsoft tools like Teams and Outlook.</descrip></descripGrp><ntig><termGrp><term id="3126501">Microsoft Defender for Collaboration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3126551">Әрекеттестікке арналған Microsoft Defender</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55154_3126502_3126547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security solution designed to safeguard end-to-end communication and collaboration for organizations using Microsoft tools like Teams and Outlook.</descrip></descripGrp><ntig><termGrp><term id="3126502">Defender for Collaboration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3126547">Әрекеттестікке арналған Defender</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55154_3126502_3126551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security solution designed to safeguard end-to-end communication and collaboration for organizations using Microsoft tools like Teams and Outlook.</descrip></descripGrp><ntig><termGrp><term id="3126502">Defender for Collaboration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3126551">Әрекеттестікке арналған Microsoft Defender</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55155_3126610_3126926"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-powered model used in Dynamics 365 Marketing that provides users with a feedback loop to gain a comprehensive view of the effectiveness of their real-time marketing tactics in driving key business outcomes, empowering them to optimize their marketing mix by learning from tactics that worked well and improving or dropping tactics that didn’t.</descrip></descripGrp><ntig><termGrp><term id="3126610">attribution model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3126926">атрибуция үлгісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55156_3126611_3126928"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hub to manage consent and compliance in Dynamics 365 Marketing. Compliance profiles govern how consent is captured and enforced, as well as store information such as company address, the preference management experience, and related configuration.</descrip></descripGrp><ntig><termGrp><term id="3126611">compliance profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3126928">сәйкестік профилі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55157_3126612_3126929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Dynamics 365 Marketing that helps users analyze event data through a broad overview of the event planning activities and results from all their events, and event records for one event to see results and analytics that relate to that event only.</descrip></descripGrp><ntig><termGrp><term id="3126612">event analytics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3126929">оқиғалар аналитикасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55158_3126613_3126930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets users set a limit on the number of messages their customers receive in a given amount of time through a particular channel in real-time marketing journeys.</descrip></descripGrp><ntig><termGrp><term id="3126613">frequency cap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3126930">жиіліктің ең жоғарғы шегі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55159_3126614_3126931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template available in Dynamics 365 Marketing to quickly create a new customer journey or reuse an existing customer journey structure as a starting point for future campaigns.</descrip></descripGrp><ntig><termGrp><term id="3126614">journey template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3126931">өзара қатынас топтамасының үлгісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5516_103458_2093494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard character that has a special meaning to a program and, as a result, normally cannot be used in assigning names to files, documents, and other user-generated tools, such as macros. Characters commonly reserved for special uses include the asterisk (*), forward slash (/), backslash (\), question mark (?), and vertical bar (|).</descrip></descripGrp><ntig><termGrp><term id="103458">reserved character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093494">резервтелген таңба</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55160_3126615_3126932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in Dynamics 365 Marketing that allows users to define key customer milestones, measure them over time, and assess the contribution and effectiveness of their journeys, channels, and marketing assets in driving customers to the milestones.</descrip></descripGrp><ntig><termGrp><term id="3126615">marketing effectiveness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3126932">маркетинг өнімділігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55161_3126616_3126933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An inbound communication channel that allows your customers to register for newsletters, ask for quotations, etc. The form is defined by a set of input fields arranged into a form layout.</descrip></descripGrp><ntig><termGrp><term id="3126616">marketing form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3126933">маркетинг пішіні</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55162_3126617_3126934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A center in real-time marketing that allows users to provide customers with branded experiences to sign up for communications and fine-tune their preferences to ensure they receive the right communications.</descrip></descripGrp><ntig><termGrp><term id="3126617">preference center</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3126934">жеке қалаулар орталығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55163_3126618_3126935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that is visibly present at the event, and features a sponsor's logo or message. These typically include small freebies given away to event attendees, but could also be some type of infrastructure or facility provided to event-goers.</descrip></descripGrp><ntig><termGrp><term id="3126618">sponsorable article</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3126935">демеушілік қолдау көрсетілетін элемент</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55164_3126700_3127438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dedicated Microsoft Edge experience built for work that enables admins in organizations to give their users a productive and secure work browser across managed and unmanaged devices.</descrip></descripGrp><ntig><termGrp><term id="3126700">Microsoft Edge for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3127438">Бизнеске арналған Microsoft Edge</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55165_3126701_3127435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The directory service that provides authentication, authorization, and password management for Microsoft Windows networks.</descrip></descripGrp><ntig><termGrp><term id="3126701">Microsoft Entra Domain Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3127435">Microsoft Entra домен қызметтері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55165_3126701_3127437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The directory service that provides authentication, authorization, and password management for Microsoft Windows networks.</descrip></descripGrp><ntig><termGrp><term id="3126701">Microsoft Entra Domain Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3127437">Домен қызметтері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55165_3126702_3127435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The directory service that provides authentication, authorization, and password management for Microsoft Windows networks.</descrip></descripGrp><ntig><termGrp><term id="3126702">Domain Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3127435">Microsoft Entra домен қызметтері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55165_3126702_3127437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The directory service that provides authentication, authorization, and password management for Microsoft Windows networks.</descrip></descripGrp><ntig><termGrp><term id="3126702">Domain Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3127437">Домен қызметтері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55166_3126703_3127444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows service responsible for managing updates in the background, handling downloads, installations, and the maintenance of updates on the user's computer.</descrip></descripGrp><ntig><termGrp><term id="3126703">Update Orchestrator Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3127444">Жаңартулардың ұйымдастырушы қызметі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55167_3127754_3128137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams add-on license that allows offices to designate devices as shared devices, including common area phones, Teams displays for hot-desks, and Teams panels for meeting spaces.</descrip></descripGrp><ntig><termGrp><term id="3127754">Microsoft Teams Shared Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3128137">Microsoft Teams ортақ құрылғылары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55167_3127754_3128139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams add-on license that allows offices to designate devices as shared devices, including common area phones, Teams displays for hot-desks, and Teams panels for meeting spaces.</descrip></descripGrp><ntig><termGrp><term id="3127754">Microsoft Teams Shared Devices</term><te