ip type="definition">A logical grouping of servers.</descrip></descripGrp><ntig><termGrp><term id="294441">array</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2712605">массив</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13208_144335_615521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of related macros that are stored together under a single macro name. The collection is often referred to simply as a macro.</descrip></descripGrp><ntig><termGrp><term id="144335">macro group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615521">макростар тобы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13209_364397_2098786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft set of services that provides the basics required to create a Web site, including free hosting, Web site statistics, personalized domain name, and email addresses.</descrip></descripGrp><ntig><termGrp><term id="364397">Microsoft® Office Live Basics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098786">Microsoft® Office Live Basics</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Pro