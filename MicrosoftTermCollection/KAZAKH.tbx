"grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2682086">бөлімше пішіні</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17789_650149_2101696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shape in a PivotDiagram, positioned along the connector between a parent PivotDiagram node and the children of that node.</descrip></descripGrp><ntig><termGrp><term id="650149">Breakdown</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101696">бөлікше</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17789_650149_2682086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shape in a PivotDiagram, positioned along the connector between a parent PivotDiagram node and the children of that node.</descrip></descripGrp><ntig><termGrp><term id="650149">Breakdown</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2682086">бөлімше пішіні</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1779_530773_2220294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report showing the execution plan for an SQL statement.</descrip></descripGrp><ntig><termGrp><term id="530773">showplan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2220294">showplan</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17790_650150_2101697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A resource that captures the maximum capacity for a project to consume money, work, or material units for a project. Budgets can only be applied at the project level by assigning a budget resource to the project summary task.</descrip></descripGrp><ntig><termGrp><term id="650150">budget resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101697">бюджеттік ресурс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17791_650151_2101698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that is available by default in an application; it is not created by the user.</descrip></descripGrp><ntig><termGrp><term id="650151">built-in menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101698">ендірілген мәзір</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17792_650152_1250219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The formatting attributes that are available by default in an application's style list.</descrip></descripGrp><ntig><termGrp><term id="650152">built-in style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250219">бекітілген мәнер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17793_650153_2101699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Project view that displays a project's tasks in a calendar format.</descrip></descripGrp><ntig><termGrp><term id="650153">calendar view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101699">күнтізбе көрінісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17794_650154_2101700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a statechart or activity diagram, an indication that an object has received a call for an operation. A CallEvent is defined using the following format: event-name (comma-separated-parameter-list)</descrip></descripGrp><ntig><termGrp><term id="650154">CallEvent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</ter