lNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1490451">контактілерді реттеушінің құралдар тақтасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8020_210457_615619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The type of handwritten or voice-dictated value being entered in an input control on the TabletPC, for example, Number, Date or Currency. This allows for better and faster recognition by the TabletPC recognizer.</descrip></descripGrp><ntig><termGrp><term id="210457">input scope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615619">енгізілетін дерек көлемі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8025_264860_615713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Time devoted to non-work activities. Out-of-office time.</descrip></descripGrp><ntig><termGrp><term id="264860">Non-Working Time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615713">жұмыстан тыс уақыт</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8025_658449_615713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Time devoted to non-work activities. Out-of-office time.</descrip></descripGrp><ntig><termGrp><term id="658449">nonworking time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615713">жұмыстан тыс уақыт</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="803_44794_626447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The work area on a computer screen that simulates the top of an actual desk. The desktop contains the Recycle Bin and other icons (shortcuts to programs, files, folders, and various types of documents such as letters, reports, or pictures) that you can arrange on the electronic desktop just as you would arrange real objects on top of a desk.</descrip></descripGrp><ntig><termGrp><term id="44794">desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626447">жұмыс үстелі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8030_37385_2093873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To join sequentially (for example, to combine the two strings "hello" and "there" into the single string "hello there").</descrip></descripGrp><ntig><termGrp><term id="37385">concatenate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093873">біріктіру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8032_180659_2184265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subscription to a merge publication that uses the priority value of the Publisher for conflict detection and resolution.</descrip></descripGrp><ntig><termGrp><term id="180659">client subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2184265">клиент жазылымы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8032_180659_2209766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subscription to a merge publication that uses the priority value of the Publisher for conflict detection and resolution.</descrip></descripGrp><ntig><termGrp><term id="180659">client subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2209766">жергілікті жазылым</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8032_535213_2184265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subscription to a merge publication that uses the priority value of the Publisher for conflict detection and resolution.</descrip></descripGrp><ntig><termGrp><term id="535213">local subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2184265">клиент жазылымы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8032_535213_2209766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subscription to a merge publication that uses the priority value of the Publisher for conflict detection and resolution.</descrip></descripGrp><ntig><termGrp><term id="535213">local subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2209766">жергілікті жазылым</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8035_180210_638270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location for storing opportunity information, including information that is entered on the Opportunity form, linked records, and history items.</descrip></descripGrp><ntig><termGrp><term id="180210">Opportunity Record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="638270">мүмкіндік жазбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8036_116444_627529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A horizontal window at the bottom of a parent window in which an application can display various kinds of status information. The status bar can be divided into parts to display more than one type of information.</descrip></descripGrp><ntig><termGrp><term id="116444">status bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627529">күй жолағы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8039_2194641_2093874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To navigate through levels of data starting from the most summarized (up) to the most detailed (down).</descrip></descripGrp><ntig><termGrp><term id="2194641">drilldown</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093874">толығырақ мәліметтерге өту</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8039_48402_2093874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To navigate through levels of data starting from the most summarized (up) to the most detailed (down).</descrip></descripGrp><ntig><termGrp><term id="48402">drill down</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093874">толығырақ мәліметтерге өту</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8040_149410_615591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that uses the UNION operator to combine the results of two or more select queries.</descrip></descripGrp><ntig><termGrp><term id="149410">union query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615591">бірігуді сұрау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8043_94462_1145201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In word processors and other applications, the feature that formats a document for printing but displays it on the video monitor rather than sending it directly to the printer.</descrip></descripGrp><ntig><termGrp><term id="94462">preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1145201">алдын ала қарап алу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8045_535370_2218239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subscription created and administered at the Subscriber. The Distribution Agent or Merge Agent for the subscription runs at the Subscriber.</descrip></descripGrp><ntig><termGrp><term id="535370">pull subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2218239">сұрау бойынша жазылым</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8047_307454_2093875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication method that requires three authentication methods, which may include something the user provides, such as certificates; something the user knows, such as user names, passwords, or pass phrases; physical attributes, such as a thumbprint; and personal attributes, such as a personal signature.</descrip></descripGrp><ntig><termGrp><term id="307454">three-factor authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093875">үш факторлы аутентификация</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8051_109321_1158461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows-based computers, an account (such as a user, security group, device, or computer) that can be granted or denied access to resources.</descrip></descripGrp><ntig><termGrp><term id="109321">security principal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1158461">әкімші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8051_109321_407505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows-based computers, an account (such as a user, security group, device, or computer) that can be granted or denied access to resources.</descrip></descripGrp><ntig><termGrp><term id="109321">security principal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407505">қауіпсіздік әкімшісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8051_109322_1158461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows-based computers, an account (such as a user, security group, device, or computer) that can be granted or denied access to resources.</descrip></descripGrp><ntig><termGrp><term id="109322">principal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1158461">әкімші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8051_109322_407505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows-based computers, an account (such as a user, security group, device, or computer) that can be granted or denied access to resources.</descrip></descripGrp><ntig><termGrp><term id="109322">principal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407505">қауіпсіздік әкімшісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8058_125224_626975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The _ character.</descrip></descripGrp><ntig><termGrp><term id="125224">underscore</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626975">астыңғы сызық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8058_319169_626975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The _ character.</descrip></descripGrp><ntig><termGrp><term id="319169">LOW LINE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626975">астыңғы сызық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8059_23162_2093876"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition, usually involving a hardware resource, that causes a computer to perform poorly.</descrip></descripGrp><ntig><termGrp><term id="23162">bottleneck</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093876">кедергі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8062_233026_2093877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The rate at which the currency of one country or region can be traded against that of another country or region.</descrip></descripGrp><ntig><termGrp><term id="233026">exchange rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093877">валюта бағамы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8063_530768_2220130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure that can be summed along one or more, but not all, dimensions in a cube.</descrip></descripGrp><ntig><termGrp><term id="530768">semiadditive measure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2220130">жартылай аддитивті өлшем</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><ter