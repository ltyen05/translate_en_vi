Note type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626565">жоғары нәтиже үшін сыйлық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="947_233127_2070115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agreement between a service provider and a customer that specifies the amount and type of service the provider will deliver.</descrip></descripGrp><ntig><termGrp><term id="233127">service agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070115">қызмет көрсету туралы келісім</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9476_143198_2093942"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form field that is invisible to a site visitor but supplies data to a form handler. When a form is submitted, hidden fields are passed to the form handler along with name-value pairs for each visible form field.</descrip></descripGrp><ntig><termGrp><term id="143198">Hidden field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093942">жасырын өріс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9478_138885_615463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The horizontal bar at the top of a column. You can click a column selector to select an entire column in the query design grid or the filter design grid.</descrip></descripGrp><ntig><termGrp><term id="138885">column selector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615463">бағанды бөлектеу түймешігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9479_98399_2093943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The conversion of vector graphics (images described in terms of mathematical elements, such as points and lines) to equivalent images composed of pixel patterns that can be stored and manipulated as sets of bits.</descrip></descripGrp><ntig><termGrp><term id="98399">rasterization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093943">растеризация</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9481_85612_2515225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, the set of symbols and formats used to describe the elements of programming, mathematics, or a scientific field. A language's syntax is defined in part by notation.</descrip></descripGrp><ntig><termGrp><term id="85612">notation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2515225">нотация</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9482_47210_2201869"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database instance that acts as a store for replication-specific data associated with one or more publishers.</descrip></descripGrp><ntig><termGrp><term id="47210">distributor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2201869">таратушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9483_55065_2418945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change the orientation of a selected object horizontally, vertically, or in both directions.</descrip></descripGrp><ntig><termGrp><term id="55065">flip</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2418945">аудару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9486_375944_615342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A horizontal or vertical layout guide t