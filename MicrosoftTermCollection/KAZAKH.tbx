><descrip type="definition">A digital micropayment and loyalty service that enables efficient micropayments and prepaid purchase for cash based consumers (including kids/teens, as well as emerging and developing markets), and provides a mechanism to directly reward loyal customers.</descrip></descripGrp><ntig><termGrp><term id="226559">Microsoft Points</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2913723">Microsoft Points ұпайлары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="729_235323_2372387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The branch of accounting concerned with identifying and evaluating the cost of producing a product.</descrip></descripGrp><ntig><termGrp><term id="235323">cost accounting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2372387">шығын есебі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7290_60173_615504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any token that a program can use to identify and access an object such as a device, a file, a window, or a dialog box.</descrip></descripGrp><ntig><termGrp><term id="60173">handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615504">дескриптор</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7294_370776_2093601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based specification for the exchange, editing, and delivery of 2-D vector graphics on the Web. An application of XML (Extensible Markup Language), VML uses XML tags and Cascading Style Sheets to create and place vector graphics, such as circles and squares, in an XML or HTML document, such as a Web page. These graphics, which are rendered in the native operating system, can include color and are editable in a variety of graphics programs.</descrip></descripGrp><ntig><termGrp><term id="370776">Vector Markup Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093601">VML тілі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7294_370777_2093601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based specification for the exchange, editing, and delivery of 2-D vector graphics on the Web. An application of XML (Extensible Markup Language), VML uses XML tags and Cascading Style Sheets to create and place vector graphics, such as circles and squares, in an XML or HTML document, such as a Web page. These graphics, which are rendered in the native operating system, can include color and are editable in a variety of graphics programs.</descrip></descripGrp><ntig><termGrp><term id="370777">VML</term><termNote type="partOfSpeech">Prop