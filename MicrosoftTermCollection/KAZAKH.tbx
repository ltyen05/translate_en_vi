ll and is a means of having concurrent calls on PBX.</descrip></descripGrp><ntig><termGrp><term id="1814023">calling channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2058516">арна</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33711_1814024_2058515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A path enabling one inbound or outbound call and is a means of having concurrent calls on PBX.</descrip></descripGrp><ntig><termGrp><term id="1814024">channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2058515">қоңырау шалу арнасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33711_1814024_2058516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A path enabling one inbound or outbound call and is a means of having concurrent calls on PBX.</descrip></descripGrp><ntig><termGrp><term id="1814024">channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2058516">арна</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSe