"definition">A name that appears as a text string near the end of a binary association. It indicates the role played by the class attached to the association end, so each end can have its own end name.</descrip></descripGrp><ntig><termGrp><term id="648718">end name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101663">аяқталудың атауы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17511_648719_2101663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A name that appears as a text string near the end of a binary association. It indicates the role played by the class attached to the association end, so each end can have its own end name.</descrip></descripGrp><ntig><termGrp><term id="648719">role name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101663">аяқталудың атауы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17512_648720_2101664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula that is stored in a cell of a shape instead of being inherited from a master or a style. A local formula overrides changes to the corresponding cell in the master of which the shape is an instance.</descrip></descripGrp><ntig><termGrp><term id="648720">local formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101664">жергілікті формула</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17512_648721_2101664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula that is stored in a cell of a shape instead of being inherited from a master or a style. A local formula overrides changes to the corresponding cell in the master of which the shape is an instance.</descrip></descripGrp><ntig><termGrp><term id="648721">local override</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101664">жергілікті формула</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17513_648724_1655176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To briefly press a UI element with your fingertip or stylus to perform an activity (such as choosing an action from a menu or opening an item). A "tap" is normally around 0.1 second in duration.</descrip></descripGrp><ntig><termGrp><term id="648724">tap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1655176">түрту</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17514_648726_720021"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An anti-spam agent that is enabled on computers that have the Microsoft Exchange Server 2007 Edge Transport server role installed.</descrip></descripGrp><ntig><termGrp><term id="648726">Connection Filter agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="720021">Қосылым сүзгісі агенті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17515_648977_2101665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The structure that describes an organization's hierarchy. The RBS code defines the hierarchical position that a resource holds in the organization.</descrip></descripGrp><ntig><termGrp><term id="648977">Resource Breakdown Structure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101665">RBS</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17515_648978_2101665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The structure that describes an organization's hierarchy. The RBS code defines the hierarchical position that a resource holds in the organization.</descrip></descripGrp><ntig><termGrp><term id="648978">RBS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101665">RBS</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17515_651774_2101665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The structure that describes an organization's hierarchy. The RBS code defines the hierarchical position that a resource holds in the organization.</descrip></descripGrp><ntig><termGrp><term id="651774">User Breakdown Structure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101665">RBS</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17516_648979_2101666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which you evaluate a probable outcome based on three scenarios: best-case, expected-case, and worst-case.</descrip></descripGrp><ntig><termGrp><term id="648979">PERT analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101666">PERT сараптамасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17516_648980_2101666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which you evaluate a probable outcome based on three scenarios: best-case, expected-case, and worst-case.</descrip></descripGrp><ntig><termGrp><term id="648980">Program, Evaluation and Review Technique analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101666">PERT сараптамасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17519_648986_2101668"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The earned value field that indicates how much of the task's budget should have been spent, given the actual duration of the task.</descrip></descripGrp><ntig><termGrp><term id="648986">BCWP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101668">BCWP</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17519_648987_2101668"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The earned value field that indicates how much of the task's budget should have been spent, given the actual duration of the task.</descrip></descripGrp><ntig><termGrp><term id="648987">budgeted cost of work performed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101668">BCWP</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17520_648988_2101669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The earned value field that shows how much of the budget should have been spent, in view of the baseline cost of the task, assignment, or resource. BCWS is calculated as the cumulative time-phased baseline costs up to the status date or today's date.</descrip></descripGrp><ntig><termGrp><term id="648988">budgeted cost of work scheduled</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101669">BCWS</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17520_648989_2101669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The earned value field that shows how much of the budget should have been spent, in view of the baseline cost of the task, assignment, or resource. BCWS is calculated as the cumulative time-phased baseline costs up to the status date or today's date.</descrip></descripGrp><ntig><termGrp><term id="648989">BCWS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101669">BCWS</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17525_649087_1250215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number from 0 to 1 that reveals how closely the estimated values for the trendline correspond to your actual data. A trendline is most reliable when its R-squared value is at or near 1.</descrip></descripGrp><ntig><termGrp><term id="649087">coefficient of determination</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250215">R-квадрат мәні</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17525_649088_1250215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number from 0 to 1 that reveals how closely the estimated values for the trendline correspond to your actual data. A trendline is most reliable when its R-squared value is at or near 1.</descrip></descripGrp><ntig><termGrp><term id="649088">R-squared value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250215">R-квадрат мәні</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17526_649095_2180163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of an application program that performs the required data processing of the business. It refers to the routines that perform the data entry, update, query and report processing, and more specifically to the processing that takes place behind the scenes rather than the presentation logic required to display the data on the screen.</descrip></descripGrp><ntig><termGrp><term id="649095">business logic</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2180163">бизнес-логика</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17528_649353_2101670"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The difference between the budgeted cost of work performed [BCWP] and the budgeted cost of work scheduled [BCWS]. This is calculated as follows: SV = Budgeted Cost of Work Performed - Budgeted Cost of Work Scheduled.</descrip></descripGrp><ntig><termGrp><term id="649353">schedule variance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101670">күнтізбелік жоспардан ауытқушылық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17528_649354_2101670"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The difference between the budgeted cost of work performed [BCWP] and the budgeted cost of work scheduled [BCWS]. This is calculated as follows: SV = Budgeted Cost of Work Performed - Budgeted Cost of Work Scheduled.</descrip></descripGrp><ntig><termGrp><term id="649354">SV</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101670">күнтізбелік жоспардан ауытқушылық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17529_649356_2101671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ratio of the work remaining to be done to funds remaining to be spent, as of the status date [BAC - BCWP]/[BAC - ACWP]. A TCPI value greater than one indicates a need for increased performance; less than one indicates performance can decrease.</descrip></descripGrp><ntig><termGrp><term id="649356">to complete performance index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101671">TCPI</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17529_649357_2101671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ratio of the work remaining to be done to funds remaining to be spent, as of the status date [BAC - BCWP]/[BAC - ACWP]. A TCPI value greater than one indicates a need for increased performance; less than one indicates performance can decrease.</descrip></descripGrp><ntig><termGrp><term id="649357">TCPI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101671">TCPI</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1753_28420_1145127"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In text processing, an indication of whether one or more alphabetic characters are capitalized (uppercase) or not (lowercase). A case-sensitive program or routine distinguishes between uppercase and lowercase letters and treats the word cat as totally distinct from either Cat or CAT. A case-sensitive program that also separates capitalized and lowercased words would list Arkansas before aardvark or antimony, even though its alphabetic position follows both lowercased words.</descrip></descripGrp><ntig><termGrp><term id="28420">case</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1145127">регистр</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17530_649578_1250216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A label that identifies the categories, values, or series in a chart.</descrip></descripGrp><ntig><termGrp><term id="649578">tick mark label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250216">бөлік белгісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17530_649579_1250216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A label that identifies the categories, values, or series in a chart.</descrip></descripGrp><ntig><termGrp><term id="649579">tick-mark label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250216">бөлік белгісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17531_649800_1250217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small line of measurement, similar to a division on a ruler, that intersects an axis.</descrip></descripGrp><ntig><termGrp><term id="649800">tick mark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250217">бөлік</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17532_649802_1250218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The developer of a macro that is trusted by you on your computer. The trusted publisher is identified by the certificate that they used to digitally sign the macro.</descrip></descripGrp><ntig><termGrp><term id="649802">trusted publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250218">сенімді көз</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17532_649803_1250218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The developer of a macro that is trusted by you on your computer. The trusted publisher is identified by the certificate that they used to digitally sign the macro.</descrip></descripGrp><ntig><termGrp><term id="649803">trusted source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250218">сенімді көз</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17533_649804_2101672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The earned value field that shows the difference between the budget at completion [BAC] and the estimate at completion [EAC]. In Project, the EAC is the Total Cost field, and the BAC is the Baseline Cost field.</descrip></descripGrp><ntig><termGrp><term id="649804">variance at completion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101672">VAC</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17533_649805_2101672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The earned value field that shows the difference between the budget at completion [BAC] and the estimate at completion [EAC]. In Project, the EAC is the Total Cost field, and the BAC is the Baseline Cost field.</descrip></descripGrp><ntig><termGrp><term id="649805">VAC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101672">VAC</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17534_649806_2101673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit used in the United States' measurement system, such as inches, feet, yards, and miles.</descrip></descripGrp><ntig><termGrp><term id="649806">US unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101673">АҚШ өлшем бірлігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17534_649807_2101673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit used in the United States' measurement system, such as inches, feet, yards, and miles.</descrip></descripGrp><ntig><termGrp><term id="649807">U.S. unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101673">АҚШ өлшем бірлігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1757_180650_2183495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A table that stores state information for a single application. An example is an event chronicle, which can store event data for use with scheduled subscriptions.</descrip></descripGrp><ntig><termGrp><term id="180650">chronicle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2183495">хроника</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1758_517980_2786146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server running Lync Server or Office Communications Server that mediates signaling and voice between the Enterprise Voice IP network and the public switched telephone network.</descrip></descripGrp><ntig><termGrp><term id="517980">Mediation Server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2786146">делдал сервер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="176_1136584_625967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data access interface that communicates with OLE DB-compliant data sources to connect to, retrieve, manipulate, and update data.</descrip></descripGrp><ntig><termGrp><term id="1136584">Active Data Object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="625967">ActiveX деректер нысандары</term><termNote type="geograp