definition">System-generated stored procedures that an application can call to submit events to the event table in the application database.</descrip></descripGrp><ntig><termGrp><term id="530398">event collection stored procedures</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202959">оқиғаларды жинаудың сақталған процедуралары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6129_237906_2093536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of diagram with block and raised block shapes used to brainstorm, plan, and communicate.</descrip></descripGrp><ntig><termGrp><term id="237906">block diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093536">блок-диаграмма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="613_363050_2070102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Web application that allows access to Project Portfolios through a Web browser.</descrip></descripGrp><ntig><termGrp><term id="363050">Microsoft® Office Project Portfolio Web Access</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070102">Microsoft® Office Project Portfolio Web Access</term><termNote type="geographi