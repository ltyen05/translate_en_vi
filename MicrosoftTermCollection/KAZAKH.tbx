-US"><descripGrp><descrip type="definition">A third-party software developer which may include an individual or an organization that independently creates computer software.</descrip></descripGrp><ntig><termGrp><term id="65580">ISV</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2750302">ISV</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8895_530738_2218769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The iterative process, used by data mining algorithm providers, of dividing data into groups until no more useful groups can be found.</descrip></descripGrp><ntig><termGrp><term id="530738">recursive partitioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2218769">рекурсивтік бөлу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8897_173723_2093917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The adapter that, when using multiple network adapters in each host of a Network Load Balancing cluster, handles the network traffic for cluster operations (the traffic for all hosts in the cluster). This adapter is programmed with the host's cluster IP address.</descrip></descripGrp><ntig><termGrp><term id="173723">cluster adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></