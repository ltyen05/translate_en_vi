ermNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35344_2026692_2027430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Logical rules composed of predicates and actions that enable administrators to perform actions, such as allow, block, or redirect client access traffic on the Exchange Server.</descrip></descripGrp><ntig><termGrp><term id="2026692">Client Access Rule</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2027430">Клиенттің кіру ережесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35345_2026693_2809504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Exchange Admin Center (EAC) that generates a dynamic log of commands made to a server at that given point of time. Administrators can view the log to check the UI behavior, analyze or troubleshoot commands, or even run custom scripts on a server.</descrip></descripGrp><ntig><termGrp><term id="2026693">Cmdlet Logging Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2809504">командлеттер журналын қарап шығу құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35346_2026694_2027429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A procedure in which adding a shape to the drawing canvas automatically also adds the shape's name as a text label.</descrip></descripGrp><ntig><termGrp><term id="2026694">auto-labelling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2027429">автобелгілеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3535_397220_2520773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Anti-spam functionality that is enabled on computers that have the Edge Transport server role installed to block messages according to characteristics of the sender. The Sender Reputation agent continuously monitors senders and their past Simple Mail Transfer Protocol (SMTP) interactions, such as the amount of spam and messages that are not spam that a sender has sent, and relies on persisted data about the sender to determine what action, if any, to take on an inbound message.</descrip></descripGrp><ntig><termGrp><term id="397220">sender reputation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2520773">жіберуші репутациясы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35351_2026819_2389182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of scaling back resource usage by blocking connectivity of clients that are adversely impacting the overall health of the system.</descrip></descripGrp><ntig><termGrp><term id="2026819">engine throttling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2389182">реттеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35351_2026820_2389182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of scaling back resource usage by blocking connectivity of clients that are adversely impacting the overall health of the system.</descrip></descripGrp><ntig><termGrp><term id="2026820">throttling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2389182">реттеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3537_232842_1250050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A global template that you can use for any type of document. You can modify this template to change the default document formatting or content.</descrip></descripGrp><ntig><termGrp><term id="232842">Normal template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250050">қалыпты үлгі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNo