te type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50235_2842094_2844945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">During an active meeting, to invite more people to join the meeting by dialing their phone number.</descrip></descripGrp><ntig><termGrp><term id="2842094">dial out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2844945">құрылғыға қоңырау соғу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50235_2842095_2844945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">During an active meeting, to invite more people to join the meeting by dialing their phone number.</descrip></descripGrp><ntig><termGrp><term id="2842095">dial-out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2844945">құрылғыға қоңырау соғу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50236_2842096_2844944"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To join a conference call when the invited guest initiates the connection by phoning or by connecting through a computer with a conference ID or PIN. Contrast with dial out.</descrip></descripGrp><ntig><termGrp><term id="2842096">dial in</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2844944">телефон арқылы қосылу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50237_2842097_2844308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula for finding any power of a binomial without multiplying at length. According to the theorem, it is possible to expand the polynomial (x + y)n into a polynomial sum expression.</descrip></descripGrp><ntig><termGrp><term id="2842097">binomial theorem</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2844308">Ньютон биномы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50238_2842098_2844955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that automatically changes passwords after a certain time interval.</descrip></descripGrp><ntig><termGrp><term id="2842098">password rotation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2844955">құпиясөзді автоматты түрде өзгерту</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50239_2842099_2844324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account that provides access to Office 365.</descrip></descripGrp><ntig><termGrp><term id="2842099">Office 365 account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2844324">Office 365 тіркелгісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50240_2842100_2844966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A PowerPoint feature that allows the user to enter rehearsal mode and while speaking receive on-screen guidance about pacing, inclusive language, use of filler words, and culturally insensitive phrases. At the end of each rehearsal session, a detailed report with metrics for additional practice is provided.</descrip></descripGrp><ntig><termGrp><term id="2842100">Presenter Coach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2844966">Баяндамашыға арналған нұсқаушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50241_2842101_2844946"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optional feature of Skype for Business Server that allows meeting attendees to join the audio portion of a meeting by calling in to the meeting from a phone.</descrip></descripGrp><ntig><termGrp><term id="2842101">dial-in conferencing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2844946">телефон арқылы қосылатын конференц-байланыс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50242_2842102_2844321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Microsoft Teams that lets users share their incoming calls with colleagues so that the colleagues can answer calls that occur while the user is unavailable.</descrip></descripGrp><ntig><termGrp><term id="2842102">group call pickup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2844321">топтық қоңырауды қабылдау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50243_2842105_2844317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Property of a private team that shows up in search results and is included in suggestions in the team gallery.</descrip></descripGrp><ntig><termGrp><term id="2842105">discoverable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2844317">анықталатын</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50244_2842106_2844316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of moving from physical to digital technologies in the workplace. An example is the adoption of cloud storage, which facilitates moving from physical offices to virtual ones.</descrip></descripGrp><ntig><termGrp><term id="2842106">digital workspace transformation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2844316">жұмыс кеңістігін цифрлық технологияларға өткізу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50245_2842107_2844319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view in Microsoft Project that lists project information (tasks and milestones) in a table-like layout.</descrip></descripGrp><ntig><termGrp><term id="2842107">Grid view</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2844319">"Тор" көрінісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50246_2842108_2844968"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view in Microsoft Project that shows the timeline of project activities and their dependencies.</descrip></descripGrp><ntig><termGrp><term id="2842108">Timeline view</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2844968">"Уақыт шкаласы" көрінісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50247_2842109_2844322"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program for security software providers that gives them early access to vulnerability information so that they can provide updated protections to customers faster.</descrip></descripGrp><ntig><termGrp><term id="2842109">Microsoft Active Protections Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2844322">MAPP</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50247_2842109_2844951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program for security software providers that gives them early access to vulnerability information so that they can provide updated protections to customers faster.</descrip></descripGrp><ntig><termGrp><term id="2842109">Microsoft Active Protections Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2844951">Microsoft Active Protections Program</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type