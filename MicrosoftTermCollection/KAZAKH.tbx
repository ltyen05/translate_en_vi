that enables touch selection scenarios that are not possible or are difficult to accomplish with standard touch gestures alone.</descrip></descripGrp><ntig><termGrp><term id="1608228">touch selection handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674876">сенсорлық таңдау маркері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31651_1608229_1674888"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Visio-based design surface that enables users to create and edit workflows visually by manipulating shapes that represent actions and conditions.</descrip></descripGrp><ntig><termGrp><term id="1608229">Visual Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674888">Көрнекі құрастырушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31659_1608235_1655033"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of a product in the store that appears to customers. To the end user, this is the name of the product.</descrip></descripGrp><ntig><termGrp><term id="1608235">app name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1655033">бағдарлама атауы</term><termNote type="geographicalUsage">KA