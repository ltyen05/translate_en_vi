rip></descripGrp><ntig><termGrp><term id="2427913">Xbox Elite Wireless Controller</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2556519">Xbox Elite сымсыз геймпады</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42788_2427916_2556522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Brand name for the Kinect adapter for the Xbox One S and PC.</descrip></descripGrp><ntig><termGrp><term id="2427916">Xbox Kinect Adapter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2556522">Xbox Kinect адаптері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42789_2427919_2556533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Brand name for the stereo headset for Xbox One. Using 'headset' is OK when referring generically to the device.</descrip></descripGrp><ntig><termGrp><term id="2427919">Xbox One Stereo Headset</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2556533">Xbox One стереогарнитурасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4279_181799_2220096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specially defined rowset that returns metadata about objects or functionality on an instance of SQL Server or Analysis Services. For example, the OLE DB schema rowset DBSCHEMA_COLUMNS describes columns in a table, while the Analysis Services schema rowset MDSCHEMA_MEASURES describes the measures in a cube.</descrip></descripGrp><ntig><termGrp><term id="181799">schema rowset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2220096">схеманың жолдар жиынтығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42790_2427922_2556534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Brand name for the stereo headset adapter for Xbox One.</descrip></descripGrp><ntig><termGrp><term id="2427922">Xbox One Stereo Headset Adapter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2556534">Xbox One стереогарнитурасының адаптері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42792_2427928_2556443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A community-created place for like-minded people to play, share, and communicate on Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="2427928">club</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2556443">клуб</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42793_2427931_2556474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online system to help like-minded people find each other, get into parties, and accomplish common goals in their favorite games on Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="2427931">Looking for Group</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2556474">Топты іздеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42799_2428105_2501463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solution part of the Cortana Intelligence Suite to capture and analyze untapped customer and prospect data, anticipate behavioral trends and deliver a personalized experience to customers to attract and keep them coming back.</descrip></descripGrp><ntig><termGrp><term id="2428105">Customer Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2501463">Customer Insights</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4280_307443_2070266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value between 1 and 8 that is assigned to a message based on its content and that reflects the likelihood that the message is phishing.</descrip></descripGrp><ntig><termGrp><term id="307443">phishing confidence level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070266">PCL</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4280_307443_2726833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value between 1 and 8 that is assigned to a message based on its content and that reflects the likelihood that the message is phishing.</descrip></descripGrp><ntig><termGrp><term id="307443">phishing confidence level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2726833">фишинг ықтималдығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4280_592553_2070266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value between 1 and 8 that is assigned to a message based on its content and that reflects the likelihood that the message is phishing.</descrip></descripGrp><ntig><termGrp><term id="592553">PCL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070266">PCL</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4280_592553_2726833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value between 1 and 8 that is assigned to a message based on its content and that reflects the likelihood that the message is phishing.</descrip></descripGrp><ntig><termGrp><term id="592553">PCL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2726833">фишинг ықтималдығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42806_2428403_2458785"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search type that returns search results sorted by relevance, in a single list.</descrip></descripGrp><ntig><termGrp><term id="2428403">relevance search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2458785">маңыздылығы бойынша іздеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42807_2428404_2458770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system for provisioning computer processing and data storage services in an on-demand manner through virtualization and made available over the Internet.</descrip></descripGrp><ntig><termGrp><term id="2428404">cloud provisioning system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2458770">бұлттық дайындау жүйесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4281_88221_2480830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To explicitly decline to participate.</descrip></descripGrp><ntig><termGrp><term id="88221">opt out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2480830">бас тарту</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42813_2428410_2458775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email message sent from Dynamics 365, which is able to report back to the system each time a reader interacts with it, including events such as: opened, clicked, downloaded, and replied to.</descrip></descripGrp><ntig><termGrp><term id="2428410">followed email</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2458775">қадағаланатын электрондық хабар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42814_2428411_2458787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email message received in a user's private Outlook/Exchange inbox, but later copied directly into Dynamics 365, where the message is shared with the sales team and associated with specific records.</descrip></descripGrp><ntig><termGrp><term id="2428411">tracked email</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2458787">бақыланатын электрондық хабар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42815_2428412_2458767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual "card" that provides an alert message to the user and includes relevant links and action buttons to act on that information. Cards are generated and prioritized with the most important shown first. The cards are shown many places in the UI, with all cards shown on top-level dashboards and filtered cards shown for specific records (just the cards that apply to that record).</descrip></descripGrp><ntig><termGrp><term id="2428412">action card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2458767">әрекет картасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42816_2428413_2458772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location of the file that's displayed to a user when the record it is in is similar to the record the user is currently viewing.</descrip></descripGrp><ntig><termGrp><term id="2428413">document location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2458772">құжат орны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42817_2428414_2458778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To follow an email message after sending it in order to see the number of views, replies, and the last activity associated with the email.</descrip></descripGrp><ntig><termGrp><term id="2428414">monitor</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2458778">бақылау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42818_2428415_2458774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action card that displays information about a followed message. For example, when a recipient opens an email message you're following, you can be notified to call that recipient.</descrip></descripGrp><ntig><termGrp><term id="2428415">email engagement card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2458774">электрондық хабармен өзара әрекеттестік картасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42819_2428416_2458781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that shows the activities of a recipient for a followed email message. You can see the number of views, replies, and the last activity associated with the message.</descrip></descripGrp><ntig><termGrp><term id="2428416">recipient activity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2458781">алушы әрекеті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4282_147657_2070267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Placement of an element in the natural HTML flow of a document, but such that its position is offset from the preceding content.</descrip></descripGrp><ntig><termGrp><term id="147657">relative positioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070267">қатысты орын</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4282_147658_2070267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Placement of an element in the natural HTML flow of a document, but such that its position is offset from the preceding content.</descrip></descripGrp><ntig><termGrp><term id="147658">inline positioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070267">қатысты орын</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42820_2428417_2458786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical user interface element in a guided task that explains or demonstrates how to progress an activity toward completion. A guided task is comprised of one step or a sequence of steps.</descrip></descripGrp><ntig><termGrp><term id="2428417">step</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2458786">қадам</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42821_2428418_2458777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A configurable sidebar or guided task within an application.</descrip></descripGrp><ntig><termGrp><term id="2428418">Learning Path control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2458777">Оқыту жолы басқару элементі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42822_2428420_2458769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual personification created by a player to represent them in social spaces in an app.</descrip></descripGrp><ntig><termGrp><term id="2428420">avatar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2458769">аватар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42823_2428422_2458776"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A display showing the list of top scoring players in a fantasy sales game or other competition.</descrip></descripGrp><ntig><termGrp><term id="2428422">leaderboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2458776">үздік ойыншылар тақтасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42824_2428423_2458779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An acknowledgment given to a player when they meet the conditions of a KPI in a game. Points add up to the player's score.</descrip></descripGrp><ntig><termGrp><term id="2428423">point</term><termNote type="pa