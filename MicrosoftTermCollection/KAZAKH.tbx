38175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To use a session to retrieve a file from a remote computer.</descrip></descripGrp><ntig><termGrp><term id="2735257">get</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2738175">алу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48378_2735258_2738145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To use a session to put a file in a remote computer.</descrip></descripGrp><ntig><termGrp><term id="2735258">drop</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2738145">жіберу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48379_2735259_2738202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyword that admins can add to a bookmark such that if it is used in a query, only that specific bookmark will display.</descrip></descripGrp><ntig><termGrp><term id="2735259">reserved keyword</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2738202">резервтелген кілтсөз</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gramma