ote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17421_645119_2101647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web server on a separate server computer. A remote host is connected to other servers by a network connection.</descrip></descripGrp><ntig><termGrp><term id="645119">remote host</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101647">қашықтағы торап</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17422_645120_2101648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Stored on a server or client computer that is configured to control access to content by using information rights management (IRM) technology.</descrip></descripGrp><ntig><termGrp><term id="645120">rights-managed</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101648">құқықтармен басқарылатын</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1743_343657_2070154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to see when people are working in a workspace, online, or offline</descrip></descripGrp><ntig><termGrp><term id="343657">presence awareness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNo