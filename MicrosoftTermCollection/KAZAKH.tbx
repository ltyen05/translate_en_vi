rks together full-time or part-time in order to execute the tasks necessary to meet customer requirements.</descrip></descripGrp><ntig><termGrp><term id="1805629">project team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2349240">жобалық топ</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33632_1805630_1859843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ratio of the budgeted cost of work performed to the budgeted cost of work scheduled.</descrip></descripGrp><ntig><termGrp><term id="1805630">schedule performance index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1859843">жоспардың орындалу көрсеткіші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33632_1805630_2349239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ratio of the budgeted cost of work performed to the budgeted cost of work scheduled.</descrip></descripGrp><ntig><termGrp><term id="1805630">schedule performance index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2349239">ЖОК</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNot