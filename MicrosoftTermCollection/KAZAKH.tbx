 in order to display fields as columns at the top of the report.</descrip></descripGrp><ntig><termGrp><term id="1788136">Columns</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1859757">Баған белгілері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33501_1788113_1859870"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode that enables presenters to select one person’s video feed so that every participant in the meeting sees that participant only.</descrip></descripGrp><ntig><termGrp><term id="1788113">Video Spotlight</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1859870">Нақты қатысушының бейнесін көрсету</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33503_1788117_1859823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that broadcasts user presence in a OneNote notebook and supports real-time synchronization for users who are editing the same page.</descrip></descripGrp><ntig><termGrp><term id="1788117">Notebook Presence</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1859823">Жазу кітапшасына қатысу</term><termNote type="geographicalUsage">KAZ</termNote><termNote