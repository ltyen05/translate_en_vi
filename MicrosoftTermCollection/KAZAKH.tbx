un</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6506_180951_2203938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of a system or device to be usable when it is needed. When expressed as a percentage, high availability is the actual service time divided by the required service time.</descrip></descripGrp><ntig><termGrp><term id="180951">high availability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2203938">жоғары қолжетімділік</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6506_2691570_2203938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of a system or device to be usable when it is needed. When expressed as a percentage, high availability is the actual service time divided by the required service time.</descrip></descripGrp><ntig><termGrp><term id="2691570">HA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2203938">жоғары қолжетімділік</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6507_130126_627720"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of measures to protect a machine from being infected by a virus.</descrip></descripGrp><ntig><termGrp><term id="130126">virus protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627720">вирустардан қорғану</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6513_45147_626452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any piece of equipment that can be attached physically or wirelessly to a network or computer, for example, printers, keyboards, external disk drives, or other peripheral equipment.</descrip></descripGrp><ntig><termGrp><term id="45147">device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626452">құрылғы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6514_397180_407540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Settings that are applied to the managed folders in users' mailboxes to control the retention and journaling of messages for messaging records management (MRM). Managed content settings define when messages that are no longer needed are to be removed or journaled (copied) to a separate storage location outside the mailbox.</descrip></descripGrp><ntig><termGrp><term id="397180">managed content settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407540">реттелетін мазмұн параметрлері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6516_50772_626581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of turning data into a stream of bits. Encoding is part of the serialization process that converts data into a stream of ones and zeros.</descrip></descripGrp><ntig><termGrp><term id="50772">encoding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626581">кодтау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6520_91124_615331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect created by simple, repeating designs such as vertical or horizontal lines.</descrip></descripGrp><ntig><termGrp><term id="91124">pattern</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615331">әшекей</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6522_530435_2203609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A lookup methodology that uses an approximate matching algorithm to locate similar data values in a reference table.</descrip></descripGrp><ntig><termGrp><term id="530435">fuzzy matching</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2203609">анық емес сәйкестік</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6525_37014_2194862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hard disk whose apparent capacity has been increased through the use of a compression utility, such as Stacker or Double Space.</descrip></descripGrp><ntig><termGrp><term id="37014">compressed drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2194862">қысылған диск</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6533_62030_1250094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A postal address at which a person is normally resident.</descrip></descripGrp><ntig><termGrp><term id="62030">home address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250094">үй мекенжайы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6538_360134_615543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that shows a graphical analysis of data in a datasheet or form. You can see different levels of detail or specify the layout by dragging fields and items or by showing and hiding items in the drop-down lists for the fields.</descrip></descripGrp><ntig><termGrp><term id="360134">PivotChart view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615543">жиынтық диаграмма көрінісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6540_8001_625959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Interactive or animated content used on the Internet. Active content includes ActiveX controls and web browser add-ons.</descrip></descripGrp><ntig><termGrp><term id="8001">active content</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="625959">белсенді мазмұн</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6542_415793_2093561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An adjustment made in the current fiscal period that corrects an error in accounting for an economic event that occurred in a prior fiscal period.</descrip></descripGrp><ntig><termGrp><term id="415793">prior period adjustment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093561">алдыңғы кезеңді түзету</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6547_530430_2203386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interface created to combine members of multiple interfaces.</descrip></descripGrp><ntig><termGrp><term id="530430">flattened interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2203386">тегіс интерфейс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6554_112160_2093562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The paper that a publication is printed on.</descrip></descripGrp><ntig><termGrp><term id="112160">sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093562">парақ</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6560_418622_757836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text indicating the topic of a conversation. It is entered by the user or generated by the computer based on conversation information. It is displayed in the conversation title bar or in an alert.</descrip></descripGrp><ntig><termGrp><term id="418622">conversation subject</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="757836">сөйлесім тақырыбы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6561_529995_2180910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The element of a case by which the case is referenced within a case set.</descrip></descripGrp><ntig><termGrp><term id="529995">case key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2180910">жағдай кілті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6563_123499_627654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure containing zero or more nodes that are linked together in a hierarchy. If any nodes are present, one node is the root; each node except the root is the child of one and only one other node, and each node has zero or more nodes as children.</descrip></descripGrp><ntig><termGrp><term id="123499">tree</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627654">тармақ</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6572_132143_2731826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network load balancing cluster of servers that support client Web site requests.</descrip></descripGrp><ntig><termGrp><term id="132143">web farm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2731826">веб-ферма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6572_364027_2731826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network load balancing cluster of servers that support client Web site requests.</descrip></descripGrp><ntig><termGrp><term id="364027">Web farm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2731826">веб-ферма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6573_5678_626039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compressed file.</descrip></descripGrp><ntig><termGrp><term id="5678">archive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626039">мұрағат</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6576_232820_626511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A vertical pane along the left edge of the document window that displays an outline of the document's headings, and enables the user to navigate to or manipulate different parts of the document.</descrip></descripGrp><ntig><termGrp><term id="232820">Document Map</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626511">құжат құрылымы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6578_45097_2201538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computing, being able to predict an outcome or to know in advance how data will be manipulated by a processing system. A deterministic simulation, for example, is one in which a certain input always produces the same output.</descrip></descripGrp><ntig><termGrp><term id="45097">deterministic</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2201538">детерминделген</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6579_232399_1145144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The small calendar that displays the current month in Calendar and that provides a quick and easy way to move appointments and to view other dates.</descrip></descripGrp><ntig><termGrp><term id="232399">Da