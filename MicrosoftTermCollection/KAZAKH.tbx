h">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2353546">Кері байланыс орталығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40502_2353113_2353548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that consumers can use to send feedback to the Windows team, to check for responses to that feedback, and to get news about the latest updates.</descrip></descripGrp><ntig><termGrp><term id="2353113">Feedback Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2353548">Windows кері байланыс орталығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40503_2353114_2353544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of settings that admins can use to manage files and operating system settings on enterprise-owned devices.</descrip></descripGrp><ntig><termGrp><term id="2353114">enterprise control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2353544">кәсіпорын басқаруы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40504_2353123_2353547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The modern implementation of Windows PowerShell built on .NET Core. It includes a command-line shell, scripting language, and automation engine, providing IT administrators comprehensive control and automation of system administration tasks across multiple platforms.</descrip></descripGrp><ntig><termGrp><term id="2353123">PowerShell Core</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2353547">PowerShell Core</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40505_2353124_2372399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The record of the financial consequences of accounting events in the subledger journal.</descrip></descripGrp><ntig><termGrp><term id="2353124">jounalization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2372399">журналға тіркеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40507_2353363_2372398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A knowledge article that's created within an organization and available only on the intranet for that organization.</descrip></descripGrp><ntig><termGrp><term id="2353363">internal article</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2372398">ішкі мақала</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40508_2353364_2372392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A knowledge article that's created in an organization and that's available on the Internet external to that organization.</descrip></descripGrp><ntig><termGrp><term id="2353364">external article</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2372392">сыртқы мақала</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4051_71727_2070255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entry to a company account to record a business transaction.</descrip></descripGrp><ntig><termGrp><term id="71727">journal entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070255">журнал жазбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40510_2353365_2372377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dashboard component that extracts actionable items from emails and displays them as cards.</descrip></descripGrp><ntig><termGrp><term id="2353365">Action Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2372377">Әрекеттер орталығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40511_2353386_2354062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The group of add-ons for Office 2016 that includes one or more of the following: proofing tools, an LIP, a language pack, and/or a spellchecker.</descrip></descripGrp><ntig><termGrp><term id="2353386">Office 2016 Language Accessory Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2354062">Office 2016 Language Accessory Pack</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40512_2353387_2372405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solution that's installed in Microsoft Dynamics CRM that you can use to run a project, including allocating resources and checking availability, setting work hours, and booking resources.</descrip></descripGrp><ntig><termGrp><term id="2353387">project service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2372405">жоба қызметі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40513_2353388_2372394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A CRM solution that you can use to manage field service, including routing and scheduling, work process automation, customer and partner communications capabilities, and reporting and business intelligence.</descrip></descripGrp><ntig><termGrp><term id="2353388">field service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2372394">өріс қызметі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40514_2353944_2354331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A methodology to query data residing in the computer’s random access memory.</descrip></descripGrp><ntig><termGrp><term id="2353944">in-memory analytics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2354331">жадтағы аналитика</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40515_2353945_2354338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A memory-optimized database engine integrated into the SQL Server engine, optimized for OLTP workloads accessing memory resident data to achieve significant improvements in performance and reduction in processing time.</descrip></descripGrp><ntig><termGrp><term id="2353945">in-memory OLTP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2354338">жадтағы OLTP</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40515_2599244_2354338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A memory-optimized database engine integrated into the SQL Server engine, optimized for OLTP workloads accessing memory resident data to achieve significant improvements in performance and reduction in processing time.</descrip></descripGrp><ntig><termGrp><term id="2599244">XTP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2354338">жадтағы OLTP</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40515_2599245_2354338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A memory-optimized database engine integrated into the SQL Server engine, optimized for OLTP workloads accessing memory resident data to achieve significant improvements in performance and reduction in processing time.</descrip></descripGrp><ntig><termGrp><term id="2599245">XTP engine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2354338">жадтағы OLTP</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40516_2353946_2354345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The diagnostic tool that helps troubleshoot Kerberos-related connectivity issues with SQL Server, SQL Server Reporting Services, and SQL Server Analysis Services.</descrip></descripGrp><ntig><termGrp><term id="2353946">Microsoft Kerberos Configuration Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2354345">Microsoft Kerberos конфигурация менеджері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40517_2353947_2354353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to run both analytics and OLTP workloads on the same database tables at the same time and eliminate the need for ETL and a data warehouse.</descrip></descripGrp><ntig><termGrp><term id="2353947">real-time operational analytics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2354353">нақты уақыттағы операциялық аналитика</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40517_2520278_2354353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to run both analytics and OLTP workloads on the same database tables at the same time and eliminate the need for ETL and a data warehouse.</descrip></descripGrp><ntig><termGrp><term id="2520278">operational analytics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2354353">нақты уақыттағы операциялық аналитика</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40518_2353948_2354325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The optional feature of the SQL Server Database Engine to execute scripts written in a supported language, such as R, from Transact-SQL.</descrip></descripGrp><ntig><termGrp><term id="2353948">Advanced Analytics Extensions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2354325">Тереңдетілген аналитика кеңейтімдері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40519_2353949_2354380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A satellite service in the BxLserver.exe process that starts the R runtime engine.</descrip></descripGrp><ntig><termGrp><term id="2353949">SQL Server Launchpad</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2354380">SQL Server іске қосу тақтасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40520_2353950_2354389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integrated set of easy-to-use graphical management tools for accessing, configuring, managing, administering, and developing all components of SQL Server.</descrip></descripGrp><ntig><termGrp><term id="2353950">SQL Server Management Tools</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2354389">SQL Server басқару құралдары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40521_2353984_2356027"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A free feature that allows setting up online business meetings using work email. The feature is part of Skype for Business experience and has multiple online entry-points (e.g. Skype.com).</descrip></descripGrp><ntig><termGrp><term id="2353984">Skype Meetings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2356027">Skype жиналыстары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4053_11478_626013"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard key that is used in conjunction with another key to produce some special feature or function and is typically marked with the letters Alt.</descrip></descripGrp><ntig><termGrp><term id="11478">ALT key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626013">ALT пернесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40537_2354519_2357249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone app that helps customers transfer content from their Android phone to their Windows 10 Mobile phone. There are 2 instances of the app, one that you install on Android, and one that you install on Windows (phone only).​​</descrip></descripGrp><ntig><termGrp><term id="2354519">Move to Windows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2357249">Windows жүйесіне жылжыту</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40541_2354632_2687268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statistical measure of the reliability of an estimate, which calculates the margin of error.</descrip></descripGrp><ntig><termGrp><term id="2354632">confidence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2687268">сенімділік</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4055_21561_626128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The smallest unit of information handled by a computer or device. One bit expresses a 1 or a 0 in a binary numeral, or a true or false logical condition. A group of 8 bits makes up a byte, which can represent many types of information, such as a letter of the alphabet, a decimal digit, or other character.</descrip></descripGrp><ntig><termGrp><term id="21561">bit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626128">бит</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4055_21562_626128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The smallest unit of information handled by a computer or device. One bit expresses a 1 or a 0 in a binary numeral, or a true or false logical condition. A group of 8 bits makes up a byte, which can represent many types of information, such as a letter of the alphabet, a decimal digit, or other character.</descrip></descripGrp><ntig><termGrp><term id="21562">binary digit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626128">бит</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40571_2355539_2429411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A profile that holds the email configuration information that allows CRM to communicate with Microsoft Exchange.</descrip></descripGrp><ntig><termGrp><term id="2355539">email server profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2429411">электрондық пошта серверінің профилі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4059_124417_2070256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file (or component within another file) that contains Automation standard descriptions of exposed objects, properties, and methods.</descrip></descripGrp><ntig><termGrp><term id="124417">type library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070256">Түрлер кітапханасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="406_22638_407591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portion of content within an email or Internet newsgroups, that follows the header and contains the content of the message.</descrip></descripGrp><ntig><termGrp><term id="22638">body</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407591">негізгі мәтін</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40601_2357561_2357915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Skype for Business PSTN Consumption billing enables customers to access PSTN features that are not available in the base PSTN Conferencing and PSTN Calling subscriptions, such as toll-free dial in for conferences, international dial out in conferences, and international dial out for PSTN Calling Domestic Plans</descrip></descripGrp><ntig><termGrp><term id="2357561">Skype for Business PSTN Consumption</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2357915">Бизнеске арналған Skype бағдарламасындағы PSTN бойынша тұтыну</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40602_2357666_2359738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that provides step counts, workouts, sleep quality data and a web dashboard to give insights into physical activity benefits to the user’s overall health.</descrip></descripGrp><ntig><termGrp><term id="2357666">Microsoft Health</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2359738">Microsoft Health</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40603_2357731_2359387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display technology that provides high-resolution display, touch and ink capabilities, wide-viewing angle, and more.</descrip></descripGrp><ntig><termGrp><term id="2357731">PixelSense</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2359387">PixelSense</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4061_359270_362285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed software component that monitors events and performance pertaining to a specific application component, and transmits observations to a host application for display, action, or reporting.</descrip></descripGrp><ntig><termGrp><term id="359270">agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="362285">Агент</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40618_2392508_2395566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Project work management app that 