rmNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627341">қайталау алдындағы кідіріс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15387_439103_2101536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An edition of a Microsoft enterprise-grade core search solution, designed to search content in common data repositories including file shares, Web sites, SharePoint sites, Microsoft Exchange Server Public Folders, and Lotus Notes databases.</descrip></descripGrp><ntig><termGrp><term id="439103">Microsoft® Office SharePoint® Server 2007 for Search (Enterprise Edition)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101536">Іздеуге арналған Microsoft® Office SharePoint® Server 2007 (Корпоративтік шығарылым)</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15393_184322_1145111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button on the 'Add a Person to the Call' dialog box that adds the call to the current conversation.</descrip></descripGrp><ntig><termGrp><term id="184322">Add</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1145111">Қосу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15394_179004_638334"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a record that has not received a rating.</descrip></descripGrp><ntig><termGrp><term id="179004">unrated</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="638334">бағаланбаған</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15396_148352_1250202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">E-mail accounts and folders that you can group and set common options for, such as whether to download headers or messages, size limits on downloaded messages, behavior online vs. offline, and time interval for connecting to the server.</descrip></descripGrp><ntig><termGrp><term id="148352">Send/Receive group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250202">жіберу/алу тобы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15399_446286_1030627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process whose execution can proceed independently or in the background. Other processes may be started before the asynchronous process has finished.</descrip></descripGrp><ntig><termGrp><term id="446286">system job</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030627">жүйелік тапсырма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="154_543576_1250007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the Administrators group on the local server computer.</descrip></descripGrp><ntig><termGrp><term id="543576">server administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250007">сервер әкімшісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15404_530228_2200031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A child member associated with a parent member in a parent-child hierarchy. A data member contains the data value for its parent member, rather than the aggregated value for the parent's children.</descrip></descripGrp><ntig><termGrp><term id="530228">data member</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2200031">деректер элементі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15406_460690_1030645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To initiate another response.</descrip></descripGrp><ntig><termGrp><term id="460690">override</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030645">алдын ала анықтау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15416_529992_2180270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mechanism of caching that determines when a cache row is outdated and must be refreshed.</descrip></descripGrp><ntig><termGrp><term id="529992">cache aging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2180270">кэш деректерінің ескіруі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15418_475193_1030666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of accounts contacts or leads who are identified through their demographics as people or businesses who might be the most receptive to a campaign. For example to introduce a new product you can create a marketing list of accounts that have previously purchased similar products and send them brochures about the new product.</descrip></descripGrp><ntig><termGrp><term id="475193">marketing list</term><termNote type="partOfSpeech">Noun</termNote><termNote ty