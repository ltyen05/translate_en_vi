<termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8441_370277_1660657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection between an element in a hypertext document, such as a word, phrase, symbol, or image, and a different element in the document or in another location, a webpage, file, or script.</descrip></descripGrp><ntig><termGrp><term id="370277">link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1660657">сілтеме</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8445_418610_1490842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The identity of the originator of an incoming call.</descrip></descripGrp><ntig><termGrp><term id="418610">caller ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1490842">қоңырау шалушы идентификаторы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8449_535389_2221196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter available for all types of replication that allows you to restrict the data replicated to a Subscriber based on a WHERE clause.</descrip></descripGrp><ntig><termGrp><term id="535389">static row filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221196">статикалық жол сүзгісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8450_181140_2213252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The algorithm that uses a linear regression decision tree approach to analyze time-related data, such as monthly sales data or yearly profits. The patterns it discovers can be used to predict values for future time steps.</descrip></descripGrp><ntig><termGrp><term id="181140">Microsoft Time Series algorithm</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2213252">Microsoft Time Series алгоритмі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8455_142705_2093890"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special custom menu bar that replaces the built-in menu bar in all windows in your application, except where you've specified a custom menu bar for a form or report.</descrip></descripGrp><ntig><termGrp><term id="142705">global menu bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093890">жалпы мәзір жолағы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8457_56244_2203576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cursor that cannot be scrolled; rows can be read only in sequence from the first row to the last row.</descrip></descripGrp><ntig><termGrp><term id="56244">forward-only cursor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2203576">тек алға жылжу курсоры</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8458_162885_2093891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that uses another message queuing system but, through a connector application, can exchange messages with computers that run Message Queuing.</descrip></descripGrp><ntig><termGrp><term id="162885">foreign computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093891">бөтен компьютер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8461_530247_2201501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The protocol for a delivery channel, such as Simple Mail Transfer Protocol (SMTP) or File.</descrip></descripGrp><ntig><termGrp><term id="530247">delivery channel type</term><termNo