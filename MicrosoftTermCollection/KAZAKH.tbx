 type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14577_418621_1377316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request for a conversation.</descrip></descripGrp><ntig><termGrp><term id="418621">conversation invitation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1377316">сөйлесуге шақыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14577_418621_757859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request for a conversation.</descrip></descripGrp><ntig><termGrp><term id="418621">conversation invitation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="757859">сөйлесімге шақыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14579_60118_615304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user interface control that facilitates modification of an object's appearance, position, or behavior.</descrip></descripGrp><ntig><termGrp><term id="60118">handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615304">таңбалауыш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote ty