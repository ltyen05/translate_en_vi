"627329">тіркелген сауда белгісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15810_233023_2101556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An allocation of part of the original value of a fixed asset to current income during a specific period. Depreciation represents the declining value of the fixed asset as a cost of the specified period.</descrip></descripGrp><ntig><termGrp><term id="233023">depreciation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101556">амортизация</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15811_63065_2101557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attribute in an HTML document that defines a link to another location within a document, a document on the Web, or an email address.</descrip></descripGrp><ntig><termGrp><term id="63065">hypertext reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101557">HREF</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15811_660542_2101557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attribute in an HTML document tha