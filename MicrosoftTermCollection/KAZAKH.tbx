iption which gives you, for a per-month fee, unlimited calls to a selected country/region; e.g. Unlimited Portugal.</descrip></descripGrp><ntig><termGrp><term id="1814673">Unlimited</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2058585">Шексіз</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33738_1814780_2058589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A free internet call between two Skype users seeing each other via webcam.</descrip></descripGrp><ntig><termGrp><term id="1814780">video call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2058589">бейне чат</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33738_1815075_2058589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A free internet call between two Skype users seeing each other via webcam.</descrip></descripGrp><ntig><termGrp><term id="1815075">video chat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2058589">бейне чат</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</term