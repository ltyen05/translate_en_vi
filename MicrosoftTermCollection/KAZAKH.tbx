et></termEntry><termEntry id="5444_144872_2093485"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An animated border that appears around a worksheet range that has been cut or copied. To cancel a moving border, press ESC.</descrip></descripGrp><ntig><termGrp><term id="144872">moving border</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093485">жылжымалы жиек</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5446_361814_2093486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On a local computer, a group whose members have the highest level of administrative access to the local computer.</descrip></descripGrp><ntig><termGrp><term id="361814">Administrators group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093486">"Әкімшілер" тобы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5447_475203_1030671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tab that presents the most basic information about an entity/record type or instance/record in the system.</descrip></descripGrp><ntig><termGrp><term id="475203">General</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030671">Жалпы мәліметтер</term><te