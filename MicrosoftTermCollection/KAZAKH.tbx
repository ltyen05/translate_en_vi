ection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030704">SQM деректерін жинақтау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37030_2106365_2107256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription for government organizations that need communication and collaboration tools and the ability to read and do lightweight editing of documents with the Office Online that is hosted in the commercial cloud environment.</descrip></descripGrp><ntig><termGrp><term id="2106365">Office 365 Enterprise E1 (Government Pricing)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2107256">Корпоративтік Office 365 E1 (Мемлекеттік мекемелерге арналған)</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37031_2106366_2107255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription that is the best plan for government organizations that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Online, and that is hosted in the commercial cloud environment.</descrip></descripGrp><ntig><termGrp><term id="2106366">Office 365 Enterprise E3 (Government Pricing)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2107255">Корпоративтік Office 365 E3 (Мемлекеттік мекемелерге арналған)</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37032_2106367_2107254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription, hosted in the commercial cloud environment, for government organizations that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Online and on-premises server rights to information protection and enterprise voice capabilities.</descrip></descripGrp><ntig><termGrp><term id="2106367">Office 365 Enterprise E4 (Government Pricing)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2107254">Корпоративтік Office 365 E4 (Мемлекеттік мекемелерге арналған)</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37033_2816013_2107253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription, hosted in the Government Community Cloud environment, for government organizations that need communication and collaboration tools and the ability to read and do lightweight editing of documents with the Office Online. It includes all the features of Exchange Online Government Plan 1 plus cloud file storage and sharing, online meetings and instant messaging, HD videoconferencing, intranet and team sites, and other services.</descrip></descripGrp><ntig><termGrp><term id="2816013">Office 365 Government G1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2107253">Мемлекеттік мекемелерге арналған Office 365 E1</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37033_2816013_2817512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription, hosted in the Government Community Cloud environment, for government organizations that need communication and collaboration tools and the ability to read and do lightweight editing of documents with the Office Online. It includes all the features of Exchange Online Government Plan 1 plus cloud file storage and sharing, online meetings and instant messaging, HD videoconferencing, intranet and team sites, and other services.</descrip></descripGrp><ntig><termGrp><term id="2816013">Office 365 Government G1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2817512">Мемлекеттік мекемелерге арналған Office 365 G1</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37034_2816014_2107252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription, hosted in the Government Community Cloud environment, that is the best plan for government organizations that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Online. It includes all the features of Office 365 Government Community G1 plus Office desktop applications, personalized search and discovery, self-service business intelligence, enterprise management of apps, eDiscovery tools, hosted voicemail with auto-attendant capabilities, and other services.</descrip></descripGrp><ntig><termGrp><term id="2816014">Office 365 Government G3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2107252">Мемлекеттік мекемелерге арналған Office 365 E3</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37034_2816014_2817513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription, hosted in the Government Community Cloud environment, that is the best plan for government organizations that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Online. It includes all the features of Office 365 Government Community G1 plus Office desktop applications, personalized search and discovery, self-service business intelligence, enterprise management of apps, eDiscovery tools, hosted voicemail with auto-attendant capabilities, and other services.</descrip></descripGrp><ntig><termGrp><term id="2816014">Office 365 Government G3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2817513">Мемлекеттік мекемелерге арналған Office 365 G3</term><termNote type="geographic