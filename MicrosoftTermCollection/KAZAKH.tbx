h">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2838898">Планшеттерге арналған Dynamics 365</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50177_2837913_2838902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 mobile app optimized for a larger tablet screen.</descrip></descripGrp><ntig><termGrp><term id="2837913">Dynamics 365 for tablets</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2838902">Планшеттерге арналған Microsoft Dynamics 365</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50178_2837903_2838903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud-based service that extends the power of Dynamics 365 for Customer Service to enable customers to instantly connect and engage with their customers via newly introduced channels: live chat and SMS.</descrip></descripGrp><ntig><termGrp><term id="2837903">Omnichannel Engagement Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2838903">Омниарналық байланыс хабы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50179_2837904_2838904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The add-in to Dynamics 365 Customer Service apps that extends the power of Dynamics 365 Customer Service to enable organizations to instantly connect and engage with their customers via channels like live chat and texting.</descrip></descripGrp><ntig><termGrp><term id="2837904">Omnichannel for Customer Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2838904">Customer Service омниарнасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50180_2837905_2838906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool that helps new customers get started with setting up Dynamics 365 Business Central. It creates and helps apply configuration packages using a toolset designed to speed up deployment times, improve quality of implementation, introduce a repeatable approach to implementations, and enable productivity by automating and simplifying recurring tasks.</descrip></descripGrp><ntig><termGrp><term id="2837905">RapidStart Services Implementer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2838906">RapidStart Services ендіру құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50181_2837906_2838907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The add-on capability for the Dynamics 365 Field Service application that enables users to automatically schedule work orders for the most appropriate resources, by optimizing bookings for the shortest travel time, available work hours, and many other constraints.</descrip></descripGrp><ntig><termGrp><term id="2837906">Resource Scheduling Optimization</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2838907">Resource Scheduling Optimization</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50182_2837907_2838908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that enable in-store activities by field sales personnel including: site visit planning, activity lists, checklists and surveys.</descrip></descripGrp><ntig><termGrp><term id="2837907">Retail Sales Execution</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2838908">Бөлшек сауда әрекеттері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50183_2837908_2838909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Dynamics 365 AI for Market Insights app that provides audience insights from interactions on Bing search.</descrip></descripGrp><ntig><termGrp><term id="2837908">Search Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2838909">Іздеу аналитикасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50184_2837909_2838910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service offered by Microsoft Social Engagement app that provides the ability to identify, compute, and project queries related to publicly available documents and posts.</descrip></descripGrp><ntig><termGrp><term id="2837909">Social Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2838910">Әлеуметтік талдау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50185_2837910_2838911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service offered by Microsoft Social Engagement app that provides the ability to listen to and monitor publicly available social communications across public and managed networks administered by third parties.</descrip></descripGrp><ntig><termGrp><term id="2837910">Social Media Monitoring</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2838911">Әлеуметтік желілерді бақылау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50187_2838775_2841559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An approach to machine translation that uses an artificial neural network to predict the likelihood of a sequence of words, typically modeling entire sentences in a single integrated model.</descrip></descripGrp><ntig><termGrp><term id="2838775">neural machine translation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2841559">NMT</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50187_2838775_2841853"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An approach to machine translation that uses an artificial neural network to predict the likelihood of a sequence of words, typically modeling entire sentences in a single integrated model.</descrip></descripGrp><ntig><termGrp><term id="2838775">neural machine translation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2841853">нейрондық машиналық аударма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50187_2839428_2841559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An approach to machine translation that uses an artificial neural network to predict the likelihood of a sequence of words, typically modeling entire sentences in a single integrated model.</descrip></descripGrp><ntig><termGrp><term id="2839428">NMT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2841559">NMT</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50187_2839428_2841853"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An approach to machine translation that uses an artificial neural network to predict the likelihood of a sequence of words, typically modeling entire sentences in a single integrated model.</descrip></descripGrp><ntig><termGrp><term id="2839428">NMT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2841853">нейрондық машиналық аударма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50188_2839431_2841487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Excel that records actions performed on an Excel sheet and saves them to a script. Henceforth, the actions can be performed automatically by running the script.</descrip></descripGrp><ntig><termGrp><term id="2839431">Action Recorder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2841487">Әрекеттерді жазу құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50189_2839432_2841552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Name of an Excel dialog used to start the the Action Recorder.</descrip></descripGrp><ntig><termGrp><term id="2839432">Record Actions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2841552">әрекеттерді жазу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5019_210901_1778443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode in which the default style settings defined in Page Options &gt; CSS tab will be not be used, but rather the styles defined in the Manage Styles task pane for the entire page or for individual items on a page will need to be applied by the user. The style application mode can also be set to auto.</descrip></descripGrp><ntig><termGrp><term id="210901">manual style application mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1778443">мәнерлерді қолмен қолдану режимі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50190_2839434_2841548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Name of a feature in Excel that allows users to edit scripts.</descrip></descripGrp><ntig><termGrp><term id="2839434">Code Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2841548">код өңдегіші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50192_2839466_2861326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Related to Microsoft integrated marketing campaigns that align the sales, marketing, and services teams of Microsoft and its partners to address a common customer need.</descrip></descripGrp><ntig><termGrp><term id="2839466">go-to-market</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2861326">нарыққа шығу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50194_2839796_2841527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool used to set a Yammer network to native mode, to address any network incompatibilities, to provide information on the quantity and usage of private unlisted groups in the network, and other functions.</descrip></descripGrp><ntig><termGrp><term id="2839796">Alignment Tool</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2841527">Туралау құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50195_2839821_2841526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that provides information about the quantity and usage of external groups, files previously uploaded in private messages, the activity of network guests, and other information a Yammer network.</descrip></descripGrp><ntig><termGrp><term id="2839821">Alignment Report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2841526">Туралау туралы есеп</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50196_2839890_2841602"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that shares the controller role with another entity to ensure GDPR compliance.</descrip></descripGrp><ntig><termGrp><term id="2839890">co-controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2841602">ортақ деректерді басқарушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50196_2839890_2841603"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that shares the controller role with another entity to ensure GDPR compliance.</descrip></descripGrp><ntig><termGrp><term id="2839890">co-controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2841603">деректерді бірлесіп басқарушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50196_2839891_2841602"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that shares the controller role with another entity to ensure GDPR compliance.</descrip></descripGrp><ntig><termGrp><term id="2839891">joint controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2841602">ортақ деректерді басқарушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50196_2839891_2841603"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that shares the controller role with another entity to ensure GDPR compliance.</descrip></descripGrp><ntig><termGrp><term id="2839891">joint controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2841603">деректерді бірлесіп басқарушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50197_2839915_2841554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The processing of personal data in such a manner that the personal data can no longer be attributed to a specific data subject without the use of additional information, provided that such additional information is kept separately and is subject to technical and organisational measures to ensure that the personal data are not attributed to an identified or identifiable natural person.</descrip></descripGrp><ntig><termGrp><term id="2839915">pseudonymisation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2841554">псевдонимизация</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50197_2839918_2841554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The processing of personal data in such a manner that the personal data can no longer be attributed to a specific data subject without the use of additional information, provided that such additional information is kept separately and is subject to technical and organisational measures to ensure that the personal data are not attributed to an identified or identifiable natural person.</descrip></descripGrp><ntig><termGrp><term id="2839918">pseudonymization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2841554">псевдонимизация</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Not