er">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674413">ең жоғары көрсеткіштер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31735_1675920_1684963"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view in which you can organize class materials into assignments and lessons.</descrip></descripGrp><ntig><termGrp><term id="1675920">Class Schedule</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1684963">Сабақ кестесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31736_1618203_1674558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To publish grades and feedback so that they are available to students.</descrip></descripGrp><ntig><termGrp><term id="1618203">post grades</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674558">бағаларды жариялау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31737_1618204_1674796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who is enrolled in a class.</descrip></descripGrp><ntig><termGrp><term id="1618204">student</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674796">оқушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31738_1618205_1674825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A summary of class information, such as the course name and description, a schedule of lessons and assignments, and evaluation criteria.</descrip></descripGrp><ntig><termGrp><term id="1618205">syllabus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674825">оқу бағдарламасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31739_1618206_1674847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text-based workflow editor that enables users to create and edit workflows by using declarative statements.</descrip></descripGrp><ntig><termGrp><term id="1618206">Text-Based Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674847">Мәтінге негізделген құрастырушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31740_1707155_1764821"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that displays an Office event log in Excel format and helps the user to find and resolve known compatibility issues for Office files and solutions.</descrip></descripGrp><ntig><termGrp><term id="1707155">Office Telemetry Log</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1764821">Office телеметрия журналы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31741_1618210_1674538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view that aggregates rich information about your contacts and makes it easy to initiate communication with them.</descrip></descripGrp><ntig><termGrp><term id="1618210">People</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674538">Адамдар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31752_1618539_1655110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A picture-based sign-in method that authenticates a user by checking gestures made on a picture of the user's own choosing.</descrip></descripGrp><ntig><termGrp><term id="1618539">picture password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1655110">суреттегі құпия сөз</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31754_1618541_1619955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To finalize a purchase on a Web site. For example, when customers shop on your Web site, they may select several items and save them in their shopping basket. When they have finished shopping, they click on a checkout link or graphical button that takes them to an online form where they enter their name, billing address, payment type, and shipping information.</descrip></descripGrp><ntig><termGrp><term id="1618541">check out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1619955">Есептесу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3176_397159_407494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The action that an Exchange Server 2007 transport rule takes if a disclaimer cannot be applied to an email message as, for example, when a message is encrypted.</descrip></descripGrp><ntig><termGrp><term id="397159">fallback action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407494">бастапқы күйге ауысу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><t