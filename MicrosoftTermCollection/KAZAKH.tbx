ype="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28148_1468770_2200471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A simple database administration tool that lets the user perform database operations such as creating new tables, querying and modifying existing data, and other database development functions.</descrip></descripGrp><ntig><termGrp><term id="1468770">Database Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2200471">Дерекқор жетектеушісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2815_1421_1161719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security solution that segregates one portion of a network from another portion, allowing only authorized network traffic to pass through according to traffic filtering rules.</descrip></descripGrp><ntig><termGrp><term id="1421">firewall</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1161719">брандмауэр</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2815_362568_1161719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security solution that segregates one portion of a network from another portion, allowing only authorized network traffic to pass through according to traffic filtering rules.</descrip></descripGrp><ntig><termGrp><term id="362568">security-edge gateway</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1161719">брандмауэр</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28151_1468773_2203118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high availability process in which an instance of an application or a service, running over one machine, can fail-over onto another machine in the failover cluster in the case the first one fails.</descrip></descripGrp><ntig><termGrp><term id="1468773">failover clustering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2203118">ақауларға төзімді кластерлер жасау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28152_1468775_2623115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tax on products at each stage of their production based on the value added during that stage.</descrip></descripGrp><ntig><termGrp><term id="1468775">VAT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2623115">ҚҚС</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28153_1468776_1791512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A geographic point or region.</descrip></descripGrp><ntig><termGrp><term id="1468776">location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1791512">орналасқан жері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28155_1468778_2207834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column whose contents uniquely identify every row in a table.</descrip></descripGrp><ntig><termGrp><term id="1468778">key column</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2207834">кілт бағаны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28158_1468781_2213207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stand-alone package, part of SQL Server 2008 R2 Feature Pack, that contains the components implementing the geometry, geography, and hierarchy id types in SQL Server.</descrip></descripGrp><ntig><termGrp><term id="1468781">Microsoft SQL Server System CLR Types</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2213207">Microsoft SQL Server System CLR Types</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28159_1468782_2215381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The directory from which messages are picked up.</descrip></descripGrp><ntig><termGrp><term id="1468782">Pickup folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215381">хабарлар алынатын қалта</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28168_1468792_2221304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The staging table the user wants to use to switch in their data. The staging table needs to be created before switching partitions with the Manage PartitionsWizard.</descrip></descripGrp><ntig><termGrp><term id="1468792">switch in table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221304">кіріс ауыстыру кестесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28169_1468793_2221305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The staging table the user wants to use for the partition to switch out of the current source table.</descrip></descripGrp><ntig><termGrp><term id="1468793">switch out table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221305">шығыс ауыстыру кестесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28171_1468795_2372386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value of an economic resource that is quantified in monetary units and that is measured using an accounting valuation principle.</descrip></descripGrp><ntig><termGrp><term id="1468795">cost</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2372386">құн</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28175_1468799_2203610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure that specifies the distance between data series that are displayed along distinct rows, as a result of clustering.</descrip></descripGrp><ntig><termGrp><term id="1468799">gap depth</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2203610">аралық тереңдігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28176_1468800_2204137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option or strategy specified for enforcement by the SQL Server query processor on SELECT, INSERT, UPDATE, or DELETE statements. The hint overrides any execution plan the query optimizer might select for a query.</descrip></descripGrp><ntig><termGrp><term id="1468800">hint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2204137">нұсқау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28178_1468802_2211425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that maps objects.</descrip></descripGrp><ntig><termGrp><term id="1468802">mapper</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2211425">салыстыру модулі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28179_1468803_2212543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula that calculates the average of the high and low prices.</descrip></descripGrp><ntig><termGrp><term id="1468803">median price formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2212543">орташа баға формуласы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28183_1468807_2216754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The depth of data points displayed in a 3D chart area.</descrip></descripGrp><ntig><termGrp><term id="1468807">point depth</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2216754">нүкте тереңдігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28184_1468808_2218384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hint that specifies that the indicated hints should be used throughout the query. Query hints affect all operators in the statement.</descrip></descripGrp><ntig><termGrp><term id="1468808">query hint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2218384">сұрау нұсқауы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28185_1468809_2221192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The angle of rotation, between 0 and 360, at which the scale will begin. The zero (0) position is located at the bottom of the gauge, and the start angle rotates clockwise. For example, a start angle of 90 degrees starts the scale at the 9 o'clock position.</descrip></descripGrp><ntig><termGrp><term id="1468809">start angle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221192">бастапқы бұрыш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28188_1468812_2223475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula that calculates the average of the high, low, and close prices, while giving extra weight to the close price.</descrip></descripGrp><ntig><termGrp><term id="1468812">weighted close formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2223475">өлшенген жабылу формуласы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="282_180546_1142636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A .NET managed data provider that provides access to multidimensional data sources, such as Microsoft SQL Server Analysis Services.</descrip></descripGrp><ntig><termGrp><term id="180546">ADOMD.NET</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1142636">ADOMD.NET</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="282_180546_1142637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A .NET managed data provider that provides access to multidimensional data sources, such as Microsoft SQL Server Analysis Services.</descrip></descripGrp><ntig><termGrp><term id="180546">ADOMD.NET</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1142637">ADO MultiDimensional.NET нысандары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="282_211811_1142636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A .NET managed data provider that provides access to multidimensional data sources, such as Microsoft SQL Server Analysis Services.</descrip></descripGrp><ntig><termGrp><term id="211811">ActiveX Data Objects MultiDimensional.NET</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1142636">ADOMD.NET</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="282_211811_1142637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A .NET managed data provider that provides access to multidimensional data sources, such as Microsoft SQL Server Analysis Services.</descrip></descripGrp><ntig><termGrp><term id="211811">ActiveX Data Objects MultiDimensional.NET</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1142637">ADO MultiDimensional.NET нысандары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2820_206426_627664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Presentation Foundation, an event routing strategy where the event instance moves down the element tree (starting at the root of the visual tree and ending with the source). The names of events that use this routing strategy are prefixed with the word "Preview". These events have the same signature as their counterparts that use the bubbling event routing strategy.</descrip></descripGrp><ntig><termGrp><term id="206426">tunneling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627664">оқиғалардың төменде жолын жоспарлау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28202_1475074_1615295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user account in a cloud service or other separate system that is synchronized with the local Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1475074">synced user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1615295">синхрондалған пайдаланушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28207_1475091_1614813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process in Microsoft Online Services that uses Active Directory Federation Services 2.0 and Microsoft Federation Gateway to securely represent identities in the cloud and tie those identities to corporate credentials (user name and password). Users can then use their corporate credentials to sign in once to access the services in Microsoft Online Services.</descrip></descripGrp><ntig><termGrp><term id="1475091">identity federation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1614813">сәйкестік федерациясы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2824_2685641_2687286"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A listing of keywords and associated data that point to the location of more comprehensive information, such as files and records on a disk or record keys in a database.</descrip></descripGrp><ntig><termGrp><term id="2685641">search index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2687286">іздеу индексі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2824_2685641_615508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A listing of keywords and associated data that point to the location of more comprehensive information, such as files and records on a disk or record keys in a database.</descrip></descripGrp><ntig><termGrp><term id="2685641">search index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615508">индекс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2824_65752_2687286"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A listing of keywords and associated data that point to the location of more comprehensive information, such as files and records on a disk or record keys in a database.</descrip></descripGrp><ntig><termGrp><term id="65752">index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2687286">іздеу индексі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2824_65752_615508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A listing of keywords and associated data that point to the location of more comprehensive information, such as files and records on a disk or record keys in a database.</descrip></descripGrp><ntig><termGrp><term id="65752">index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615508">индекс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28240_1475143_2221206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An abstraction of a sequence of bytes, such as a file, an I/O device, an inter-process communication pipe, a TCP/IP socket, or a spooled print job. The relationship between streams and storages in a compound file is similar to that of files and folders.</descrip></descripGrp><ntig><termGrp><term id="1475143">stream</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221206">ағын</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28249_1475512_2610741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Name of the 26th letter in the Arabic alphabet. The sound is similar to that of the letter H in English.</descrip></descripGrp><ntig><termGrp><term id="1475512">haa</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2610741">ха</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2825_530229_2200049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Analysis Services, a statement that performs mining tasks programmatically.</descrip></descripGrp><ntig><termGrp><term id="530229">data mining extension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2200049">деректерді интеллектуалды талдау кеңейтімі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2825_534972_2200049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Analysis Services, a statement that performs mining tasks programmatically.</descrip></descripGrp><ntig><termGrp><term id="534972">DMX</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2200049">деректерді интеллектуалды талдау кеңейтімі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28254_1475553_2585339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifying number assigned to a shipment.</descrip></descripGrp><ntig><termGrp><term id="1475553">tracking number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2585339">қадағалау нөмірі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2826_347942_615415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that is associated with another field so that their properties always match. If the properties in one field are changed, the properties in the other field are updated automatically.</descrip></descripGrp><ntig><termGrp><term id="347942">reference field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615415">эталондық өріс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28260_1475757_2105099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of users of Office 365 who have their sign-in priveleges blocked. It is also the name of a view in the users and groups section of Office 365.</descrip></descripGrp><ntig><termGrp><term id="1475757">sign-in blocked users</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2105099">қызметке кіруге тыйым салынған пайдаланушылар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28261_1475758_2105100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of users of Office 365 who have their sign-in privileges allowed. It is also the name of a view in the users and groups section of Office 365.</descrip></descripGrp><ntig><termGrp><term id="1475758">sign-in allowed users</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2105100">қызметке кіруге рұқсат берілген пайдаланушылар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2827_120447_2070198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A protocol that enables an Internet user to log on to and enter commands on a remote computer linked to the Internet, as if the user were using a text-based terminal directly attached to that computer. Telnet is part of the TCP/IP suite of protocols.</descrip></descripGrp><ntig><termGrp><term id="120447">Telnet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070198">Telnet</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28286_1479033_1655090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The public multinational corporation that develops, manufactures, licenses, and supports a wide range of products and services predominantly related to computing.</descrip></descripGrp><ntig><termGrp><term id="1479033">Microsoft</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1655090">Microsoft</term><