n expression. It includes a list of common expressions that you can select from to define the properties you want to target.</descrip></descripGrp><ntig><termGrp><term id="210509">Expression Builder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615493">өрнек құрастырғыш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11985_115735_627512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database query and programming language widely used for accessing, querying, updating, and managing data in relational database systems.</descrip></descripGrp><ntig><termGrp><term id="115735">SQL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627512">SQL</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11985_115735_627539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database query and programming language widely used for accessing, querying, updating, and managing data in relational database systems.</descrip></descripGrp><ntig><termGrp><term id="115735">SQL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627539">SQL тілі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11985_115736_627512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database query and programming language widely used for accessing, querying, updating, and managing data in relational database systems.</descrip></descripGrp><ntig><termGrp><term id="115736">Structured Query Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627512">SQL</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11985_115736_627539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database query and programming language widely used for accessing, querying, updating, and managing data in relational database systems.</descrip></descripGrp><ntig><termGrp><term id="115736">Structured Query Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627539">SQL тілі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11986_235257_2098711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A record - asset, liability, revenue, expense, or owner's equity - traditionally used for recording individual transactions in an accounting system.</descrip></descripGrp><ntig><termGrp><