та хабары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50572_2864259_2864619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A daily personalized email sent by Cortana to Office 365 users containing tasks and commitments made by the user, a summary of the user's meetings, and relevant documents for the user's day, all using information extracted from the user's Office 365 messages.</descrip></descripGrp><ntig><termGrp><term id="2864259">Cortana Briefing email</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2864619">Cortana тапсырмалар ақпары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50572_2864259_2864620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A daily personalized email sent by Cortana to Office 365 users containing tasks and commitments made by the user, a summary of the user's meetings, and relevant documents for the user's day, all using information extracted from the user's Office 365 messages.</descrip></descripGrp><ntig><termGrp><term id="2864259">Cortana Briefing email</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2864620">Cortana тапсырмалар ақпарының электрондық пошта хабары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50578_2864897_2865191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that protects sensitive information on disk and makes it inaccessible to attackers when the device is locked using encryption keys that are temporarily wiped from the device and only made available when the device is unlocked.</descrip></descripGrp><ntig><termGrp><term id="2864897">personal information encryption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2865191">жеке ақпаратты шифрлау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50578_2864898_2865191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that protects sensitive information on disk and makes it inaccessible to attackers when the device is locked using encryption keys that are temporarily wiped from the device and only made available when the device is unlocked.</descrip></descripGrp><ntig><termGrp><term id="2864898">Data Protection under Lock</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2865191">жеке ақпаратты шифрлау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50578_2864899_2865191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition