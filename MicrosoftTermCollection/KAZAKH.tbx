><langSet xml:lang="kk"><ntig><termGrp><term id="2674895">Microsoft Office 365</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37403_2865141_2865815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Excel from Office 365 that runs on the Mac operating system.</descrip></descripGrp><ntig><termGrp><term id="2865141">Excel for Microsoft 365 for Mac</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2865815">Mac құрылғысы үшін Microsoft 365 жүйесіне арналған Excel</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37405_2865134_2865821"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of PowerPoint from Office 365 that runs on the Mac operating system.</descrip></descripGrp><ntig><termGrp><term id="2865134">PowerPoint for Microsoft 365 for Mac</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2865821">Mac құрылғысы үшін Microsoft 365 жүйесіне арналған PowerPoint</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37406_2865130_2865825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Word from Office 365 that runs on the Mac operating system.</descrip></descripGrp><ntig><termGrp><term id="2865130">Word for Microsoft 365 for Mac</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2865825">Mac құрылғысы үшін Microsoft 365 жүйесіне арналған Word</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3741_17121_1490417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service provided by an operating system or underlying subsystem (like Microsoft Internet Information Services) that provides a means to authenticate users, typically using a user name and password. Part of the general security system, authentication services can also be offered at the application layer.</descrip></descripGrp><ntig><termGrp><term id="17121">authentication service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1490417">түпнұсқалық растама қызметі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37430_2123992_2172274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An assignment type meaning that the user or group has been granted access at the node in the resource hierarchy that the user is looking at (such as at a particular website or resource group).</descrip></descripGrp><ntig><termGrp><term id="2123992">Assigned</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2172274">Тағайындалған</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37431_2123996_2172301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An assignment type meaning that the user or group has been granted access at a parent node of the resource hierarchy.</descrip></descripGrp><ntig><termGrp><term id="2123996">Inherited</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2172301">Иеленген</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37432_2124002_2172278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The node in the resource hierarchy where access was granted.</descrip></descripGrp><ntig><termGrp><term id="2124002">Assigned At</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2172278">Қайда тағайындалған</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37433_2124006_2172279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The principal (user or group) to whom access has been assigned.</descrip></descripGrp><ntig><termGrp><term id="2124006">Assigned To</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2172279">Кімге тағайындалған</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37434_2124011_2172302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short description of the position held by an employee.</descrip></descripGrp><ntig><termGrp><term id="2124011">job title</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2172302">лауазым</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37435_2124012_2172305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The title of the column containing the source where the user was created, which can be from an Azure AD, synced from a local directory, or a Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2124012">Sourced From</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2172305">Қайда жасалған</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammati