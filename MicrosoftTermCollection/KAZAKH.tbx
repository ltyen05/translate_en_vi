d="640509">unprotect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101620">қорғаудан алу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17361_640510_2101621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of precision with which values will be rounded.</descrip></descripGrp><ntig><termGrp><term id="640510">rounding precision</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101621">дөңгелектеу дәлдігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17362_640511_2101622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The deviation from an exact value resulting from the use of rounding.</descrip></descripGrp><ntig><termGrp><term id="640511">rounding difference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101622">дөңгелектеу айырмасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17362_640512_2101622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The deviation from an exact value resulting from the use of rounding.</descrip></descripGrp><ntig><termGrp><term id="640512">rounding error</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101622">дөңгелектеу айырмасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17363_640513_2101623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To total amounts vertically. The resulting sum can be checked against a total obtained by cross-footing (adding amounts horizontally).</descrip></descripGrp><ntig><termGrp><term id="640513">foot</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101623">баған бойынша жиыны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17364_640514_2101624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add amounts across a row (horizontally). The resulting total can be checked against a total obtained by footing (adding amounts vertically).</descrip></descripGrp><ntig><termGrp><term id="640514">cross-foot</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101624">көлденеңінен қосындылау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17365_640515_2101625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A segment of a general ledger account code that corresponds to a category within the overall structure of the organization, such as location, division, department, area, task, project, or product.</descrip></descripGrp><ntig><termGrp><term id="640515">responsibility account code segment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101625">жауапкершілік сегменті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17365_640516_2101625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A segment of a general ledger account code that corresponds to a category within the overall structure of the organization, such as location, division, department, area, task, project, or product.</descrip></descripGrp><ntig><termGrp><term id="640516">responsibility segment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101625">жауапкершілік сегменті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17366_640517_2101626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A currency that can be used to convert between two other currencies for which there is no direct exchange rate table available. The triangulation currency must have available exchange rates with both of the currencies to be converted. The first currency can be converted into the common (triangulation) currency, and then the common currency can be converted into the second currency.</descrip></descripGrp><ntig><termGrp><term id="640517">triangulation currency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101626">триангуляция валютасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17367_640518_2101627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of three primary elements (row worksheet, column worksheet, and reporting tree) used to construct a report in Management Reporter.</descrip></descripGrp><ntig><termGrp><term id="640518">building block</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101627">үлгі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17368_640519_2101628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A structured set of files (row worksheets, column worksheets and reporting trees) that are combined to create a financial report.</descrip></descripGrp><ntig><termGrp><term id="640519">report library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101628">есеп кітапханасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17372_640684_2101629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual container that holds a particular category of items or data.</descrip></descripGrp><ntig><termGrp><term id="640684">bucket</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101629">контейнер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17373_640685_2101630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date at which something goes into effect or becomes applicable.</descrip></descripGrp><ntig><termGrp><term id="640685">effective date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101630">әсер ету күні</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17373_645361_2101630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date at which something goes into effect or becomes applicable.</descrip></descripGrp><ntig><termGrp><term id="645361">active date</term><termNote type="partOfSpeech">Noun</termNo