rip></descripGrp><ntig><termGrp><term id="1273485">A record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="776524">Мекенжай жазбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19804_686248_1614655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System that associates a specific IP address with a domain name. This is the record that contains the information that connects your domain name to your actual Web site content when people type your domain name into a browser.</descrip></descripGrp><ntig><termGrp><term id="686248">address record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1614655">А жазбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19804_686248_776524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System that associates a specific IP address with a domain name. This is the record that contains the information that connects your domain name to your actual Web site content when people type your domain name into a browser.</descrip></descripGrp><ntig><termGrp><term id="686248">address record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:l