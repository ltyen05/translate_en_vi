6_87435_2215309"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system for processing transactions as soon as the computer receives them and updating master files immediately in a database management system. OLTP is useful in financial record keeping and inventory tracking.</descrip></descripGrp><ntig><termGrp><term id="87435">OLTP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215309">OLTP</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10866_87436_2215309"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system for processing transactions as soon as the computer receives them and updating master files immediately in a database management system. OLTP is useful in financial record keeping and inventory tracking.</descrip></descripGrp><ntig><termGrp><term id="87436">online transaction processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215309">OLTP</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1087_231842_615359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server that manages the exchange of messages or information among different users.</descrip></descripGrp><ntig><termGrp><term id="231842">relay server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNo