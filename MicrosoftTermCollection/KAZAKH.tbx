ular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3016724">каркас диаграммасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53046_3014889_3016725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram for creating medium-fidelity mock-ups of software applications and websites.</descrip></descripGrp><ntig><termGrp><term id="3014889">wireframe</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3016725">каркас диаграмма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53049_3014893_3016711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram that is based on Information Technology Infrastructure Library (ITIL) standard.</descrip></descripGrp><ntig><termGrp><term id="3014893">ITIL diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3016711">ITIL диаграммасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53050_3014894_3016726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram that is based on Six Sigma methodology.</descrip></descripGrp><ntig><termGrp><term id="3014894">Six Sigma flowchart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3016726">Алты сигма блок-схемасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53054_3017114_3018303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work model that involves a mixture of in-office and remote work.</descrip></descripGrp><ntig><termGrp><term id="3017114">hybrid work</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3018303">гибридтік жұмыс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53055_3017115_3018315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option in Presenter Mode in which the content is displayed as one rectangle to the left and the video of the presenter is displayed in another rectangle to the right.</descrip></descripGrp><ntig><termGrp><term id="3017115">Side-by-side</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3018315">Қатарлас</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53056_3017116_3018276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The universal interactive canvas application that moves freely across applications, bringing human connection back into hybrid work to enable teams to think, plan, and create together.</descrip></descripGrp><ntig><termGrp><term id="3017116">Loop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3018276">Loop</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53056_3017116_3022834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The universal interactive canvas application that moves freely across applications, bringing human connection back into hybrid work to enable teams to think, plan, and create together.</descrip></descripGrp><ntig><termGrp><term id="3017116">Loop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3022834">Microsoft Loop</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53056_3022592_3018276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The universal interactive canvas application that moves freely across applications, bringing human connection back into hybrid work to enable teams to think, plan, and create together.</descrip></descripGrp><ntig><termGrp><term id="3022592">Microsoft Loop</term><termNote type="partOfSpeech">ProperN