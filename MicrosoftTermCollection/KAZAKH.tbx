cted</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627526">тұрақты</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45691_2575532_2588435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An UI element that allows users to adjust the display angle of an object on the screen.</descrip></descripGrp><ntig><termGrp><term id="2575532">angle indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2588435">бұрыш индикаторы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4571_37497_2195761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The apparently simultaneous execution of two or more routines or programs. Concurrent execution can be accomplished on a single process or by using time-sharing techniques, such as dividing programs into different tasks or threads of execution, or by using multiple processors.</descrip></descripGrp><ntig><termGrp><term id="37497">concurrent execution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2195761">параллель орындалу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4571_685413_2195761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The apparently simultaneous execution of two or more routines or programs. Concurrent execution can be accomplished on a single process or by using time-sharing techniques, such as dividing programs into different tasks or threads of execution, or by using multiple processors.</descrip></descripGrp><ntig><termGrp><term id="685413">parallel execution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2195761">параллель орындалу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45725_2577623_2625314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The free edition of SQL Server ideal for development and production for desktop, web, and small server applications.</descrip></descripGrp><ntig><termGrp><term id="2577623">SQL Server Express</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2625314">SQL Server Express</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45725_2577624_2625314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The free edition of SQL Server ideal for development and production for desktop, web, and small server applications.</descrip></descripGrp><ntig><termGrp><term id="2577624">Microsoft SQL Server Express</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2625314">SQL Server Express</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45737_2578905_2813687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web service that helps you search for addresses, places, business listings by name or category, and other geographic information.</descrip></descripGrp><ntig><termGrp><term id="2578905">Search service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2813687">Іздеу қызметі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4578_163050_2093452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A widely accepted set of accounting conventions, rules, and standards for United States companies.</descrip></descripGrp><ntig><termGrp><term id="163050">GAAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093452">GAAP</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4578_163051_2093452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A widely accepted set of accounting conventions, rules, and standards for United States companies.</descrip></descripGrp><ntig><termGrp><term id="163051">Generally Accepted Accounting Principles</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093452">GAAP</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45789_2579453_2581845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The extension for Cortana that connects users to custom services and solutions. Skills can be invoked on Cortana to perform certain actions, such as checking the user’s bank balance, reading a bed time story, or booking a cab with Uber.</descrip></descripGrp><ntig><termGrp><term id="2579453">Cortana skill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2581845">Cortana мүмкіндігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4579_181726_2219807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of task permissions associated with a role.</descrip></descripGrp><ntig><termGrp><term id="181726">role definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2219807">рөл анықтамасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45790_2579456_2581846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of policy settings that control updates for devices that use Windows 10. With these settings, information technology administrators decide when and which devices receive updates in their organization, and set different schedules for groups of devices. They can also pause updates for individual devices.</descrip></descripGrp><ntig><termGrp><term id="2579456">Windows Update for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2581846">Бизнеске арналған Windows Update</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45792_2579483_2814431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A segment for which both static and dynamic profiles are combined.</descrip></descripGrp><ntig><termGrp><term id="2579483">compound segment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2814431">құрамдас сегмент</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45793_2579484_2814432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A segment that is refreshed automatically. Dynamic segments are defined by rules and their contents change over time.</descrip></descripGrp><ntig><termGrp><term id="2579484">dynamic segment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2814432">динамикалық сегмент</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45794_2579485_2814430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A result of a business initiative.</descrip></descripGrp><ntig><termGrp><term id="2579485">business outcome</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2814430">іскерлік нәтиже</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45795_2579486_2814433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A classification that allows users to identify attribute profiles as A, B, or C for the prediction being generated and enables users to efficiently plan targeted follow-ups.</descrip></descripGrp><ntig><termGrp><term id="2579486">grade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2814433">санат</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45796_2579487_2814435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A match that indicates the prediction policy was not able to map the different data sources to the same entity, but the likelihood the match is accurate and relevant is high.</descrip></descripGrp><ntig><termGrp><term id="2579487">inferred match</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2814435">болжалды сәйкестік</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45797_2579488_2814436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card that displays information regarding the predictive matches for a given profile in a form similar to a visiting card, along with other insights.</descrip></descripGrp><ntig><termGrp><term id="2579488">info card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2814436">ақпарат карточкасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45798_2579489_2814437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A representation of an event or activity of relevance to a business.</descrip></descripGrp><ntig><termGrp><term id="2579489">interaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2814437">өзара әрекеттестік</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45799_2579490_2814439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limit against which other match values can be compared. Only matches with a score equal to or higher than this limit value will be displayed.</descrip></descripGrp><ntig><termGrp><term id="2579490">match threshold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2814439">сәйкестік шегі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45800_2579491_2814440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifier of the user who owns the Azure instance.</descrip></descripGrp><ntig><termGrp><term id="2579491">owning user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2814440">иеленуші пайдаланушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45801_2579492_2814441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A forecast of a value from a machine learning model.</descrip></descripGrp><ntig><termGrp><term id="2579492">prediction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2814441">болжам</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45802_2579493_2814442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attribute of a profile taken into account when generating predictions.</descrip></descripGrp><ntig><termGrp><term id="2579493">predictive grade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2814442">болжамды санат</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45803_2579494_2814443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A match made from a combination of data from multiple sources. Data coming from various sources often uses different fields to uniquely identify records and contains different values.</descrip></descripGrp><ntig><termGrp><term id="2579494">predictive match</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2814443">болжамды сәйкестік</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gramma