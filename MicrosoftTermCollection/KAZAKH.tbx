OfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2197927">ағымдағы уақытты арттыру оқиғасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2787_87141_2215308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An information model published by the Metadata Coalition (MDC) and widely supported by software vendors. The OIM is a formal description of metadata constructs organized by subject area.</descrip></descripGrp><ntig><termGrp><term id="87141">OIM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215308">OIM</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2787_87141_2215314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An information model published by the Metadata Coalition (MDC) and widely supported by software vendors. The OIM is a formal description of metadata constructs organized by subject area.</descrip></descripGrp><ntig><termGrp><term id="87141">OIM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215314">ашық ақпараттық модель</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2787_87142_2215308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An information model published by the Metadata Coalition (MDC) and widely supported by software vendors. The OIM is a formal description of metadata constructs organized by subject area.</descrip></descripGrp><ntig><termGrp><term id="87142">Open Information Model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215308">OIM</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2787_87142_2215314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An information model published by the Metadata Coalition (MDC) and widely supported by software vendors. The OIM is a formal description of metadata constructs organized by subject area.</descrip></descripGrp><ntig><termGrp><term id="87142">Open Information Model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215314">ашық ақпараттық модель</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27870_1467984_2174100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The root abstract class Adapter, which defines the handshake between the adapter and the StreamInsight server in the ENQUEUE interaction point. It provides all the required adapter services such as memory management, and exception handling.</descrip></descripGrp><ntig><termGrp><term id="1467984">adapter host</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2174100">адаптер торабы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27871_1467989_2178059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event stream that contains all the information needed to produce events. Either the information is an already instantiated data source, or the information is sufficient for the StreamInsight server to start the data source.</descrip></descripGrp><ntig><termGrp><term id="1467989">bound stream</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2178059">байланыстырылған ағын</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27875_1467996_2194851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the ability to form complex queries by using query components (objects or operators) as reusable building blocks. This is done by linking query components together or encapsulating query components within each other.</descrip></descripGrp><ntig><termGrp><term id="1467996">composable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2194851">құрастыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27876_1468000_2197545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window with a variable window size that moves along a timeline with each distinct event start time.</descrip></descripGrp><ntig><termGrp><term id="1468000">count window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2197545">сан терезесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27880_1468010_2202961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Event metadata that defines the event type.</descrip></descripGrp><ntig><termGrp><term id="1468010">event kind</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202961">оқиға түрі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27881_1468013_2202960"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portion of an event that defines the temporal properties of the event and the event kind. Temporal properties include a valid start time and end time associated with the event.</descrip></descripGrp><ntig><termGrp><term id="1468013">event header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202960">оқиға тақырыбы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27882_1468016_2202962"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The event metadata that defines the temporal characteristics (shape) of the event.</descrip></descripGrp><ntig><termGrp><term id="1468016">event model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202962">оқиға моделі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27884_1468019_2202964"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data portion of an event in which the data fields are defined as CLR (common language runtime) types. An event payload is a typed structure.</descrip></descripGrp><ntig><termGrp><term id="1468019">event payload</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202964">оқиғаның пайдалы деректері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27886_1468023_2200634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One in a pair of server instances that act as role-switching partners for a mirrored database.</descrip></descripGrp><ntig><termGrp><term id="1468023">database mirroring partner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2200634">айналық көрініске қатысушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27887_1468024_2206594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An adapter that accepts incoming event streams from external sources such as databases, files, ticker feeds, network ports, manufacturing devices and so on.</descrip></descripGrp><ntig><termGrp><term id="1468024">input adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2206594">кіріс адаптері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27888_1468025_2174929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A core component of an animation application and the central programmatic interface for managing (creating, scheduling, and controlling) animations.</descrip></descripGrp><ntig><termGrp><term id="1468025">animation manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2174929">анимация реттеушісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27889_1468027_2206731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The event kind used to signify the arrival of an event into the stream. The insert event type consists of metadata that defines the valid lifetime of the event and the payload (data) fields of the event.</descrip></descripGrp><ntig><termGrp><term id="1468027">insert event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2206731">кірістіру оқиғасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2789_115120_1145245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In relation to software, a description of the operating environment and proposed features of a new program.</descrip></descripGrp><ntig><termGrp><term id="115120">specification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1145245">сипаттама</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27890_1468030_2207630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The event model of an interval event.</descrip></descripGrp><ntig><termGrp><term id="1468030">interval event model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2207630">аралық оқиғалар моделі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27892_1468034_2203004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An explicit hierarchy used as the top level of a derived hierarchy structure.</descrip></descripGrp><ntig><termGrp><term id="1468034">explicit cap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2203004">анық шектеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27893_1468036_2203122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The server used if the connection to the partner server fails.</descrip></descripGrp><ntig><termGrp><term id="1468036">failover partner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2203122">ақау кезінде пайдаланылатын резервтік сервер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27894_1468037_2215320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An adapter that receives events processed by the server, transforms the events into a format expected by the output device (a database, text file, PDA, or other device), and emits the data to that device.</descrip></descripGrp><ntig><termGrp><term id="1468037">output adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215320">шығыс адаптері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27895_1468043_2216758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The event model of a point event.</descrip></descripGrp><ntig><termGrp><term id="1468043">point event model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2216758">нүктелік оқиғалар моделі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27897_1468051_2218363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of binding instances of input adapters and instances of output adapters to an instance of a query template.</descrip></descripGrp><ntig><termGrp><term id="1468051">query binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2218363">сұрауды байланыстыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27898_1468056_2218414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The fundamental unit of query composition. A query template defines the business logic required to continuously analyze and process events submitted to and emitted by the StreamInsight server.</descrip></descripGrp><ntig><termGrp><term id="1468056">query template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2218414">сұрау үлгісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="279_52338_2070080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document that provides an itemized summary and tracking of work-related expenses for reimbursement.</descrip></descripGrp><ntig><termGrp><term id="52338">expense report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070080">аванстық есеп</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27901_1468066_2219774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An internal event kind used to modify an existing insert event by modifying the end time of the event.</descrip></descripGrp><ntig><termGrp><term id="1468066">retract event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2219774">қайтарып алу оқиғасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27904_1468071_2220604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window that is defined according to the start and end times of the event in the stream, instead of a fixed grid along the timeline.</descrip></descripGrp><ntig><termGrp><term id="1468071">snapshot window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2220604">сурет терезесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27906_1468074_2220596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window of fixed length L that moves along a timeline according to the stream’s events. With every event on the timeline, a new window is created, starting at the event’s start time.</descrip></descripGrp><ntig><termGrp><term id="1468074">sliding window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2220596">жылжымалы терезе</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27907_1468075_2221112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set Transact-SQL system stored procedures to create traces on an instance of the SQL Server Database Engine.</descrip></descripGrp><ntig><termGrp><term id="1468075">SQL Trace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221112">SQL Server қадағалауы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27907_1468075_2221135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set Transact-SQL system stored procedures to create traces on an instance of the SQL Server Database Engine.</descrip></descripGrp><ntig><termGrp><term id="1468075">SQL Trace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221135">SQL қадағалауы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27907_1484848_2221112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set Transact-SQL system stored procedures to create traces on an instance of the SQL Server Database Engine.</descrip></descripGrp><ntig><termGrp><term id="1484848">SQL Server Trace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221112">SQL Server қадағалауы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27907_1484848_2221135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set Transact-SQL system stored procedures to create traces on an instance of the SQL Server Database Engine.</descrip></descripGrp><ntig><termGrp><term id="1484848">SQL Server Trace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221135">SQL қадағалауы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27913_1468083_2221188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instantiation of a query template that runs within the StreamInsight server performing continuous computation over the incoming events.</descrip></descripGrp><ntig><termGrp><term id="1468083">standing query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221188">тұрақты сұрау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27915_1468089_2221207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The structure or device that consumes the output of a query. Examples are an output adapter or another running query.</descrip></descripGrp><ntig><termGrp><term id="1468089">stream consumer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221207">ағынды алушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27918_1468094_2174875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line cap where the width of the cap is bigger than the width of the line.</descrip></descripGrp><ntig><termGrp><term id="1468094">anchor cap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2174875">маркер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27919_1468095_2222732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event for which the structure of the event payload provided by the source or consumed by the sink is known, and the input or output adapter is designed around this specific event structure.</descrip></descripGrp><ntig><termGrp><term id="1468095">typed event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2222732">типтелген оқиға</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gramma