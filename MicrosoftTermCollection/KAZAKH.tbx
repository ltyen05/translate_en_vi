">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="719904">Кластерлер қызметі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44522_2505239_2511330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within the Microsoft Rewards program, similar to the Punchcard experience within Xbox Live Rewards (which is transitioning into Microsoft Rewards). Users complete X, Y, and Z - things like daily quizzes, searches, and offers - to get a certain number of points.</descrip></descripGrp><ntig><termGrp><term id="2505239">punch card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2511330">перфокарта</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44523_2505253_2864116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To type @ before someone's name to get their attention in a message or conversation.</descrip></descripGrp><ntig><termGrp><term id="2505253">@mention</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2864116">@сілтеме жасау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44533_2505277_2511346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The romantic piano music track which customers can use as a soundtrack in movies that they create from photo and video content in the Photos app.​​</descrip></descripGrp><ntig><termGrp><term id="2505277">Together</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2511346">Бірге</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44536_2505315_2578616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a horizontal resolution of 3840 (or 4096) pixels and vertical resolution of 2160 pixels. Several 4K resolutions exist in the fields of digital television and digital cinematography.</descrip></descripGrp><ntig><termGrp><term id="2505315">4K</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2578616">4K</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44537_2505358_2505927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office Dictate button that allows users to override the Automatic Punctuation mode so that they can use voice commands (such as comma and period) to create punctuation in their document.</descrip></descripGrp><ntig><termGrp><term id="2505358">Manual Punctuation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2505927">Manual Punctuation</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44538_2505363_2505928"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office Dictate mode that interprets users' pauses as punctuation and adds them into the document.</descrip></descripGrp><ntig><termGrp><term id="2505363">Automatic Punctuation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2505928">Automatic Punctuation</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44546_2506467_2511328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A record of all purchases made by a user from an online store or portal.</descrip></descripGrp><ntig><termGrp><term id="2506467">order history</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2511328">тапсырыстар журналы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44547_2506496_2512570"><langSet xml:lang="en