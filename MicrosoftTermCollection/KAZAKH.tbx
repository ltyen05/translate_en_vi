ch">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2524066">OBJ</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44803_2521100_2524904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The framework that consists of a web part and a page that provides full support for client-side SharePoint development, easy integration with SharePoint data, and support for open source tooling so that developers can use their preferred tools and technologies.</descrip></descripGrp><ntig><termGrp><term id="2521100">SharePoint Framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2524904">SharePoint Framework</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44803_2521100_2674415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The framework that consists of a web part and a page that provides full support for client-side SharePoint development, easy integration with SharePoint data, and support for open source tooling so that developers can use their preferred tools and technologies.</descrip></descripGrp><ntig><termGrp><term id="2521100">SharePoint Framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2674415">SPFx</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44803_2673786_2524904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The framework that consists of a web part and a page that provides full support for client-side SharePoint development, easy integration with SharePoint data, and support for open source tooling so that developers can use their preferred tools and technologies.</descrip></descripGrp><ntig><termGrp><term id="2673786">SPFx</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2524904">SharePoint Framework</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44803_2673786_2674415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The framework that consists of a web part and a page that provides full support for client-side SharePoint development, easy integration with SharePoint data, and support for open source tooling so that developers can use their preferred tools and technologies.</descrip></descripGrp><ntig><termGrp><term id="2673786">SPFx</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2674415">SPFx</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44804_2521102_2524714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of benefits provided to developers for creating software on a particular platform after they register for membership, and which may include access to software and information not available to people who have not registered.</descrip></descripGrp><ntig><termGrp><term id="2521102">developer program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2524714">әзірлеушілерге арналған бағдарлама</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44805_2521104_2524903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The developer program for Microsoft Office that provides members access to trainings and office hours with Microsoft engineers, plus chances to win tickets to events.</descrip></descripGrp><ntig><termGrp><term id="2521104">Microsoft Office Developer Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2524903">Microsoft Office әзірлеушілеріне арналған бағдарлама</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44809_2521577_2523970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel add-in that finds functions needed to transform and format data when the user gives it examples of the desired output.</descrip></descripGrp><ntig><termGrp><term id="2521577">Transform Data by Example</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2523970">Transform Data by Example</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4481_1133582_1998136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that allows users to connect remotely to a computer and access programs, files, and network resources as though they were sitting at the computer.</descrip></descripGrp><ntig><termGrp><term id="1133582">RD</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1998136">Қашықтағы жұмыс үстелі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4481_543804_1998136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that allows users to connect remotely to a computer and access programs, files, and network resources as though they were sitting at the computer.</descrip></descripGrp><ntig><termGrp><term id="543804">Remote Desktop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1998136">Қашықтағы жұмыс үстелі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44810_2521581_2528705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A membership where admittance is based on rules, making it easy for administrators to manage large groups.</descrip></descripGrp><ntig><termGrp><term id="2521581">dynamic membership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2528705">динамикалық мүшелік</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44811_2521582_2528704"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group where membership is maintained by a set of rules created by an administrator.</descrip></descripGrp><ntig><termGrp><term id="2521582">dynamic group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2528704">динамикалық топ</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44814_2522595_2528706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sudden burst of light used to illuminate a dark scene so that features are visible in the captured image.</descrip></descripGrp><ntig><termGrp><term id="2522595">flash</term><termNote type="partOfSpeech">Noun</termNote><ter