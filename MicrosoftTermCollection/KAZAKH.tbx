аңа пән</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42734_2421841_2424500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that returns a string of options that control matching behavior of regular expressions.</descrip></descripGrp><ntig><termGrp><term id="2421841">REGEX.OPTIONS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2424500">REGEX.OPTIONS</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42737_2421846_2424258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that returns the index of the first cell matching a given pattern.</descrip></descripGrp><ntig><termGrp><term id="2421846">REGEX.MATCH</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2424258">REGEX.MATCH</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42738_2421847_2424260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that returns the index of the first character matching a given pattern within a cell.</descrip></descripGrp><ntig><termGrp><term id="2