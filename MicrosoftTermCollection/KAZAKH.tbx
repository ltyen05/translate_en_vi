cripGrp><ntig><termGrp><term id="687842">AutoConnect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093523">автоқосылу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5983_346955_626754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A place where one lives.</descrip></descripGrp><ntig><termGrp><term id="346955">home</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626754">үй</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="599_169342_2215306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A restore during which the database is offline.</descrip></descripGrp><ntig><termGrp><term id="169342">offline restore</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215306">дербес қалпына келтіру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5992_343644_2093524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file version that prohibits the viewer from making edits.</descrip></descripGrp><ntig><termGrp><term id="343644">fixed version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093524">өзгермейтін нұсқа</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5999_7470_2174032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure or group of structures created by the consumer that describes how row or parameter data from the data store is to be laid out in the consumer's data buffer, enabling providers to optimize access. An accessor is a collection of bindings.</descrip></descripGrp><ntig><termGrp><term id="7470">accessor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2174032">қатынасу әдісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6004_358356_362292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of Microsoft Exchange features that offers increased access to documents even when the documents are located on an internal network or the software required to view the documents is not installed on the client computer.</descrip></descripGrp><ntig><termGrp><term id="358356">Enhanced Document Availability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="362292">Жетілдірілген Құжатқа қол жеткізу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6013_139351_2196480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cryptographic key used to both encrypt and decrypt protected content during publishing and consumption.</descrip></descripGrp><ntig><termGrp><term id="139351">content key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2196480">контент кілті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6013_139351_2221307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cryptographic key used to both encrypt and decrypt protected content during publishing and consumption.</descrip></descripGrp><ntig><termGrp><term id="139351">content key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221307">симметриялы кілт</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6013_139352_2196480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cryptographic key used to both encrypt and decrypt protected content during publishing and consumption.</descrip></descripGrp><ntig><termGrp><term id="139352">symmetric key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2196480">контент кілті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6013_139352_2221307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cryptographic key used to both encrypt and decrypt protected content during publishing and consumption.</descrip></descripGrp><ntig><termGrp><term id="139352">symmetric key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221307">симметриялы кілт</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6014_181027_2209658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference in a cube to a dimension in a different cube (that is, a cube with a different data source view that exists in the same or a different Analysis Services database). A linked dimension can only be related to measure groups in the source cube, and can only be edited in the source database.</descrip></descripGrp><ntig><termGrp><term id="181027">linked dimension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2209658">байланысқан өлшем</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6015_397176_407530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of temporary queues that hold messages that are being delivered to a Mailbox server by using encrypted Exchange RPC. Mailbox delivery queues exist on Hub Transport servers only. A different mailbox delivery queue exists for each Mailbox server destination. The destination Mailbox server must exist in the same Active Directory directory service site as the Hub Transport server. Mailbox delivery queues are dynamically created as needed and are automatically removed.</descrip></descripGrp><ntig><termGrp><term id="397176">mailbox delivery queue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407530">пошта жеткізу кезегі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6017_186210_615796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of pages with the .master extension that define shared page elements and content place holders.</descrip></descripGrp><ntig><termGrp><term id="186210">Master Page Gallery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615796">басты беттер жиынтығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="602_534923_1131591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query syntax that defines a set of query operators that allow traversal, filter, and projection operations to be expressed in a direct, declarative way in any .NET-based programming language.</descrip></descripGrp><ntig><termGrp><term id="534923">LINQ</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1131591">LINQ</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="602_534924_1131591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query syntax that defines a set of query operators that allow traversal, filter, and projection operations to be expressed in a direct, declarative way in any .NET-based programming language.</descrip></descripGrp><ntig><termGrp><term id="534924">language-integrated query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1131591">LINQ</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6020_264878_615702"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of help files about a particular topic.</descrip></descripGrp><ntig><termGrp><term id="264878">Help Collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615702">анықтама бөлімдерінің жиынтығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6021_88790_2093525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of a mirrored volume or a RAID-5 volume that has failed due to a severe cause, such as a loss of power or a complete hard-disk head failure. When this happens, the fault-tolerant driver determines that it can no longer use the orphaned member and directs all new reads and writes to the remaining members of the fault-tolerant volume.</descrip></descripGrp><ntig><termGrp><term id="88790">orphan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093525">жоғалған элемент</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6023_530276_2202954"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A table that stores event state information.</descrip></descripGrp><ntig><termGrp><term id="530276">event chronicle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202954">оқиға хроникасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6025_169146_2215346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A partial backup that is differential relative to a single, previous partial backup (the base backup). For a read-only database, a partial differential backup contains only the primary filegroup.</descrip></descripGrp><ntig><termGrp><term id="169146">partial differential backup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215346">жартылай айырмалық резервтік көшірме</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6028_34557_2093526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way of defining color both for onscreen display and print. Colors can be described by using several different color models: HSV (hue, saturation, and value); CMY (cyan, magenta, and yellow); and RGB (red, green, and blue).</descrip></descripGrp><ntig><termGrp><term id="34557">color model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093526">түс моделі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6031_475227_1491499"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A privilege level that specifies the user has access to objects anywhere within the organization. The application refers to this level as Organization.</descrip></descripGrp><ntig><termGrp><term id="475227">Global</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1491499">Глобалдық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6032_178599_638212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that sells similar products or services and competes for the same customer segment.</descrip></descripGrp><ntig><termGrp><term id="178599">competitor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="638212">бәсекелес</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6033_319444_626556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area within the Control Panel that provides accessibility options and settings to help users interact more easily with the computer.</descrip></descripGrp><ntig><termGrp><term id="319444">Ease of Access Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626556">арнайы мүмкіндіктер орталығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6034_530240_2201065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The database the user is connected to immediately after logging in to SQL Server.</descrip></descripGrp><ntig><termGrp><term id="530240">default database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2201065">әдепкі дерекқор</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6036_211259_625923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu item that opens the About dialog box, which includes the copyright, licensing, and license terms for the product.</descrip></descripGrp><ntig><termGrp><term id="211259">About</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="625923">Бағдарлама туралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6038_137862_2093527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bit-by-bit comparison of identically positioned bits in two numeric expressions.</descrip></descripGrp><ntig><termGrp><term id="137862">bit-wise comparison</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093527">бит бойынша салыстыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote