</termEntry><termEntry id="12349_26421_626186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of temporarily storing recently accessed information in a special memory subsystem for quicker access.</descrip></descripGrp><ntig><termGrp><term id="26421">caching</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626186">кэштау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12350_439105_2098733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integrated system of Microsoft core desktop productivity tools, programs, servers, and services designed for information work.</descrip></descripGrp><ntig><termGrp><term id="439105">Microsoft® Office system</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098733">Microsoft® Office жүйесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12357_331774_615074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An edition of Microsoft presentation graphics software designed for home use that enables the creation of presentations and adding graphic effects like multimedia and special text.</descrip></descripGrp><ntig><termGrp><term id="331774">Microsoft® Office PowerPoint® 2007 (Home and Student version)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammatical