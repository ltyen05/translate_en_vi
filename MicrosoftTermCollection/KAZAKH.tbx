crip></descripGrp><ntig><termGrp><term id="3007399">snipping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3010457">қию</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52946_3007400_3010456"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process by which a user can capture a screen shot, or snip, of any object on the screen, and then annotate, save, or share the image.</descrip></descripGrp><ntig><termGrp><term id="3007400">screen snipping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3010456">экранды қию</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52946_3007400_3010457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process by which a user can capture a screen shot, or snip, of any object on the screen, and then annotate, save, or share the image.</descrip></descripGrp><ntig><termGrp><term id="3007400">screen snipping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3010457">қию</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52947_3007453_3007935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft Teams displays that​ allows hybrid workers to easily reserve a temporary workspace and access their personal Teams experience on a third-party device.</descrip></descripGrp><ntig><termGrp><term id="3007453">hot desking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3007935">бекітілмеген жұмыс орындары жүйесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52948_3007454_3094049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that listens to students read out loud and gives personalized, AI-infused coaching feedback on how to read better.</descrip></descripGrp><ntig><termGrp><term id="3007454">Reading Coach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3094049">Оқу нұсқаушысы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52949_3007455_3007940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The paid Teams standalone MSA-based SKU that will be available for both small businesses and consumers to purchase.</descrip></descripGrp><ntig><termGrp><term id="3007455">Microsoft Teams Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3007940">Microsoft Teams негіздері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52949_3007455_3122226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The paid Teams standalone MSA-based SKU that will be available for both small businesses and consumers to purchase.</descrip></descripGrp><ntig><termGrp><term id="3007455">Microsoft Teams Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3122226">Teams негіздері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52949_3121608_3007940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The paid Teams standalone MSA-based SKU that will be available for both small businesses and consumers to purchase.</descrip></descripGrp><ntig><termGrp><term id="3121608">Teams Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3007940">Microsoft Teams негіздері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52949_3121608_3122226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The paid Teams standalone MSA-based SKU that will be available for both small businesses and consumers to purchase.</descrip></descripGrp><ntig><termGrp><term id="3121608">Teams Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3122226">Teams негіздері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52950_3007456_3007962"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to publish full screen photo or short video content to their storyline, appearing in Viva Connections, Yammer, and elsewhere in Microsoft 365, allowing the user to express themselves, share their thoughts, or showcase an important moment or campaign to their followers or colleagues.</descrip></descripGrp><ntig><termGrp><term id="3007456">stories</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3007962">оқиғалар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52951_3007457_3007967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A personal space for users to post thoughts and share ideas that are not confined to a specific community or event, allowing users to share their expertise on any subject of their choosing, build their personal brand within the company, or promote ideas and events that apply to more than one community, or even the entire network.</descrip></descripGrp><ntig><termGrp><term id="3007457">storyline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3007967">сюжеттік желі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52952_3007458_3007911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An add-on with two associated SKUs that enables Microsoft 365 customers to store their Microsoft 365 user data at rest in their local geography at the tenant level​.</descrip></descripGrp><ntig><termGrp><term id="3007458">Advanced Data Residency Plan 1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3007911">Кеңейтілген деректер орналасу орнының 1-жоспары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52953_3007459_3007912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An add-on with two associated SKUs that enables Microsoft 365 customers to store their Microsoft 365 user data at rest in their local geography at the user account level​.</descrip></descripGrp><ntig><termGrp><term id="3007459">Advanced Data Residency Plan 2</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3007912">Кеңейтілген деректер орналасу орнының 2-жоспары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52954_3079521_3080196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that enables organizations to use a single SIM-enabled number for Teams Phone serving as desk phone number, mobile number and Teams number.</descrip></descripGrp><ntig><termGrp><term id="3079521">Microsoft Teams Phone Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3080196">Microsoft Teams мобильдік телефоны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52955_3007461_3007913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in the M365 Compliance Center used by customers to look up individuals as part of a Data Subject Access Request (DSAR), most commonly in response to a GDPR or CCPA data access request.</descrip></descripGrp><ntig><termGrp><term id="3007461">user data search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3007913">пайдаланушы деректерін іздеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52956_3007463_3007957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in PowerPoint and Microsoft Teams that leverages AI to help professionals, students, and even those who just want to practice a speech for a wedding or graduation by providing users with feedback on their pace, use of monotone pitch, use of filler words, grammar, lack of originality, use of sensitive phrases, and more while they rehearse their presentations.</descrip></descripGrp><ntig><termGrp><term id="3007463">Speaker coach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3007957">Баяндамашы нұсқаушысы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52957_3007464_3007917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tab in Microsoft Teams for Education that allows educators to view, grade, and return routine student work and allows students to view their assignments and routine grades.</descrip></descripGrp><ntig><termGrp><term id="3007464">Grades</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3007917">Бағалар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52960_3010666_3011476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Describes an object, such as a file or email, that has been inspected and found to not contain any harmful or potentially harmful content.</descrip></descripGrp><ntig><termGrp><term id="3010666">no threats found</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3011476">қауіптер табылған жоқ</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5297_107243_627386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To write data (typically a file) to a storage medium.</descrip></descripGrp><ntig><termGrp><term id="107243">save</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627386">сақтау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52979_3011592_3011816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view in PowerPoint that allows users to read notes, which are hidden from the presentation, when a user is recording a video of their PowerPoint presentation.</descrip></descripGrp><ntig><termGrp><term id="3011592">Teleprompter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3011816">Телесуфлер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termE