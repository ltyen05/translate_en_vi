ig><termGrp><term id="1362648">бірнеше кіру нүктесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26150_1265019_1362647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of a single user to sign in to a Lync Server or Office Communications Server server with multiple clients.</descrip></descripGrp><ntig><termGrp><term id="1265019">MPOP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1362647">MPOP</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26150_1265019_1362648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of a single user to sign in to a Lync Server or Office Communications Server server with multiple clients.</descrip></descripGrp><ntig><termGrp><term id="1265019">MPOP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1362648">бірнеше кіру нүктесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26155_1265256_2214437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the two appearance properties that can be applied to a radial gauge.</descrip></descripGrp><ntig><termGrp><term id="1265256">needle cap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2214437">көрсеткіш ұшы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26159_1266975_2202196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Routing that adjusts automatically to the current conditions of a network. Dynamic routing typically uses one of several dynamic-routing protocols such as Routing Information Protocol (RIP) and Border Gateway Protocol (BGP). Compare static routing.</descrip></descripGrp><ntig><termGrp><term id="1266975">dynamic routing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202196">динамикалық бағыттау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26159_1266976_2202196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Routing that adjusts automatically to the current conditions of a network. Dynamic routing typically uses one of several dynamic-routing protocols such as Routing Information Protocol (RIP) and Border Gateway Protocol (BGP). Compare static routing.</descrip></descripGrp><ntig><termGrp><term id="1266976">adaptive routing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202196">динамикалық бағыттау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26164_1268970_2222792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that saves the content of the pages in a database after they've been modified by uncommitted, rolled back transactions and before recovery restores them to their previous state. The undo file prevents the changes performed by uncommitted transactions from being lost.</descrip></descripGrp><ntig><termGrp><term id="1268970">undo file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2222792">қайтару файлы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26171_1269381_2202522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event whose event payload is valid for a given interval; however, only the start time is known upon arrival to the CEP server. The valid end time of the event is provided later in a separate edge event.</descrip></descripGrp><ntig><termGrp><term id="1269381">edge event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202522">шектес оқиға</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26172_1269385_2216757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event occurrence as of a single point in time. Only the start time is required for the event. The CEP server infers the valid end time by adding a tick (the smallest unit of time in the underlying time data type) to the start time to set the valid time interval for the event. Point events are valid only for this single instant of time.</descrip></descripGrp><ntig><termGrp><term id="1269385">point event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2216757">нүктелік оқиға</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26173_1269391_2205445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of window in which consecutive windows "hop" forward in time by a fixed period. The window is defined by two time spans: the period P and the window length L. For every P time unit a new window of size L is created.</descrip></descripGrp><ntig><termGrp><term id="1269391">hopping window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2205445">секіретін терезе</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26174_1269396_2221699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hopping window whose hop size is equal to the window size.</descrip></descripGrp><ntig><termGrp><term id="1269396">tumbling window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221699">аударылатын терезе</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26175_1269405_2220609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software module or routine that modifies the events (data) into a format expected by the output device, and emits the data to that device.</descrip></descripGrp><ntig><termGrp><term id="1269405">software transformer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2220609">бағдарламалық түрлендіргіш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26188_1269682_2207625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event whose payload is valid for a given period of time. The metadata of the interval event requires that both the start and end time of the interval be provided in the event metadata. Interval events are valid only for this specific interval.</descrip></descripGrp><ntig><termGrp><term id="1269682">interval event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2207625">аралық оқиғасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2619_145778_615328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To print an element of one color over one of another color without removing, or knocking out, the material underneath.</descrip></descripGrp><ntig><termGrp><term id="145778">overprint</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615328">үстінен басу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26190_1270181_2223429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The total time taken by a computer to complete a task which is the sum of CPU time, I/O time, and the communication channel delay.</descrip></descripGrp><ntig><termGrp><term id="1270181">wall-time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2223429">нақты уақыт</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26196_1271711_2218357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that binds an existing StreamInsight query template to specific input and output adapters.</descrip></descripGrp><ntig><termGrp><term id="1271711">query binder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2218357">сұрауды байланыстыру модулі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="262_2791_626986"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of names and email addresses that are grouped under a single name.</descrip></descripGrp><ntig><termGrp><term id="2791">mailing list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626986">тарату тізімі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2620_128366_1250038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The vertical bar at the right of a window that users can click to move through a document.</descrip></descripGrp><ntig><termGrp><term id="128366">vertical scroll bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250038">тігінен айналдыру жолағы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2620_128367_1250038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The vertical bar at the right of a window that users can click to move through a document.</descrip></descripGrp><ntig><termGrp><term id="128367">vertical scrollbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250038">тігінен айналдыру жолағы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26208_1272387_2207882"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that is used to identify types of tokens in source code. This information is used for syntax highlighting and for quickly identifying token types that can trigger other operations, for example, brace matching.</descrip></descripGrp><ntig><termGrp><term id="1272387">language service scanner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2207882">тіл қызметінің іздеу құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26209_1272533_2211462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of the Master Data Services application for managing and accessing master data.</descrip></descripGrp><ntig><termGrp><term id="1272533">Master Data Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2211462">негізгі деректерді басқарушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2621_43256_1145143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program module or modules that provide access to a database management system (DBMS).</descrip></descripGrp><ntig><termGrp><term id="43256">database engine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1145143">ДҚБЖ механизмі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26211_1272654_1375964"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Web content that can be stored on the server and executed in the browser.</descrip></descripGrp><ntig><termGrp><term id="1272654">web resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1375964">веб ресурсы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26225_1272720_2207874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that is used to describe the functions and scope of the tokens in source code.</descrip></descripGrp><ntig><termGrp><term id="1272720">language service parser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2207874">тіл қызметінің талдау құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2623_381859_615852"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item with options that can be applied to a file before it is shared with others (e.g. 'Mark as Final' or 'Add a Digital Signature').</descrip></descripGrp><ntig><termGrp><term id="381859">Prepare</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615852">Дайындау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2627_115706_627507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application commonly used for budgets, forecasting, and other finance-related tasks that organizes data values using cells, where the relationships between cells are defined by formulas. A change to one cell produces changes to related cells. Spreadsheet programs usually provide graphing capabilities for output and a variety of formatting options for text, numeric values, and graph features.</descrip></descripGrp><ntig><termGrp><term id="115706">spreadsheet program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627507">электрондық кесте</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2627_323153_627507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application commonly used for budgets, forecasting, and other finance-related tasks that organizes data values using cells, where the relationships between cells are defined by formulas. A change to one cell produces changes to related cells. Spreadsheet programs usually provide graphing capabilities for output and a variety of formatting options for text, numeric values, and graph features.</descrip></descripGrp><ntig><termGrp><term id="323153">spreadsheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627507">электрондық кесте</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26279_1505027_1615174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that downloads and installs Microsoft updates that are recommended for users running Microsoft Online Services services.</descrip></descripGrp><ntig><termGrp><term id="1505027">Microsoft Office 365 desktop setup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1615174">Microsoft Office 365 жұмыс үстелін реттеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2631_126494_2888801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains configuration information for a specific user, such as desktop settings, persistent network connections, and application settings.</descrip></descripGrp><ntig><termGrp><term id="126494">user profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2888801">профиль</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2631_126494_627697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains configuration information for a specific user, such as desktop settings, persistent network connections, and application settings.</descrip></descripGrp><ntig><termGrp><term id="126494">user profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627697">пайдаланушының профайлы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2631_2888473_2888801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains configuration information for a specific user, such as desktop settings, persistent network connections, and application settings.</descrip></descripGrp><ntig><termGrp><term id="2888473">profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2888801">профиль</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2631_2888473_627697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains configuration information for a specific user, such as desktop settings, persistent network connections, and application settings.</descrip></descripGrp><ntig><termGrp><term id="2888473">profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627697">пайдаланушының профайлы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26315_1273491_1614797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain that is engaged in a trust relationship with another domain, which is also called a federation. This relationship is between two federation servers, and allows a system to provide controlled access to its resources or services to a user that belongs to another security realm without requiring the user to authenticate directly to the system and without the two systems sharing a database of user identities or passwords.</descrip></descripGrp><ntig><termGrp><term id="1273491">federated domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1614797">федеративті домен</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26315_1926326_1614797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain that is engaged in a trust relationship with another domain, which is also called a federation. This relationship is between two federation servers, and allows a system to provide controlled access to its resources or services to a user that belongs to another security realm without requiring the user to authenticate directly to the system and without the two systems sharing a database of user identities or passwords.</descrip></descripGrp><ntig><termGrp><term id="1926326">trusted domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1614797">федеративті домен</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26316_1273492_1615266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of data in the Internet Domain Name System that specifies information on available services. The SRV record is used to locate domain controllers for Active Directory.</descrip></descripGrp><ntig><termGrp><term id="1273492">SRV record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1615266">қызмет жазбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id=