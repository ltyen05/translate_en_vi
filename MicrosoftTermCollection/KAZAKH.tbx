p><term id="645109">static Web Part</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101642">статикалық веб-бөлік</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17414_645110_2101643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email server that uses the Simple Mail Transfer Protocol (SMTP).</descrip></descripGrp><ntig><termGrp><term id="645110">SMTP mail server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101643">SMTP пошта сервері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17415_645111_2101644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part added to a Web Part Page by a user who is working on the page in shared view.</descrip></descripGrp><ntig><termGrp><term id="645111">shared Web Part</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101644">жалпы веб-бөлік</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17416_645112_2101645"><langSet xml:lang="en-US"><descripGrp><descrip typ