m><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2306758">теңгерілген деректерді таратушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39495_2304642_2306760"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SSIS transform that takes a single input and distributes the incoming rows to one or more outputs uniformly via multithreading in a round robin fashion.</descrip></descripGrp><ntig><termGrp><term id="2304642">Balanced Data Distributor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2306760">BDD</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39495_2304643_2306758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SSIS transform that takes a single input and distributes the incoming rows to one or more outputs uniformly via multithreading in a round robin fashion.</descrip></descripGrp><ntig><termGrp><term id="2304643">BDD</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2306758">теңгерілген деректерді таратушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type