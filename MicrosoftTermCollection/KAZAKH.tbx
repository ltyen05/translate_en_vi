Grp></ntig></langSet></termEntry><termEntry id="46331_2609624_2611135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The downloadable tool that runs a series of tests to diagnose and help fix problems with Surface hardware.</descrip></descripGrp><ntig><termGrp><term id="2609624">Surface Diagnostic Toolkit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2611135">Surface диагностикалық құралдар жинағы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46337_2609835_2785781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To plan an event for a specific time slot.</descrip></descripGrp><ntig><termGrp><term id="2609835">schedule</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2785781">жоспарлау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4634_530464_2214578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Functions that do not have any input parameters.</descrip></descripGrp><ntig><termGrp><term id="530464">niladic functions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2214578">параметрлері жоқ функциялар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpe