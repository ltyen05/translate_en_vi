descripGrp><descrip type="definition">The act of reducing the probability and/or impact of a risk to an acceptable level.</descrip></descripGrp><ntig><termGrp><term id="252102">risk mitigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2775473">тәуекелдерді жою</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14211_213519_2641214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An order for a SKU that is currently not available for delivery.</descrip></descripGrp><ntig><termGrp><term id="213519">pre-order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2641214">алдын ала тапсырыс беру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14212_338602_1839212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status message displayed for the current network when a user changes the network selection to something other than the network of the main provider.</descrip></descripGrp><ntig><termGrp><term id="338602">Home service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1839212">Үй қызметі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14215_174867_2101475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder that contains the source files for Windows products that you install. It may also contain additional device drivers and application files.</descrip></descripGrp><ntig><termGrp><term id="174867">distribution share</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101475">дистрибутивтік жалпы ресурс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14216_397178_407575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of recipients that are created to expedite the mass emailing of messages and other information. When email is sent to a mail-enabled universal distribution group, all members of that list receive a copy of the message. Mail-enabled universal distribution groups cannot be used to assign permissions.</descrip></descripGrp><ntig><termGrp><term id="397178">mail-enabled universal distribution group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407575">поштадағы жалпы тарату тобы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14217_183928_615787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wizard that lets users select, configure, and import data from a data source into a Visio diagram.</descrip></descripGrp><ntig><termGrp><term id="183928">Data Selector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615787">дерек іріктеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14217_183928_779540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wizard that lets users select, configure, and import data from a data source into a Visio diagram.</descrip></descripGrp><ntig><termGrp><term id="183928">Data Selector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779540">Деректер таңдау шебері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14217_269319_615787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wizard that lets users select, configure, and import data from a data source into a Visio diagram.</descrip></descripGrp><ntig><termGrp><term id="269319">Data Selector Wizard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615787">дерек іріктеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14217_269319_779540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wizard that lets users select, configure, and import data from a data source into a Visio diagram.</descrip></descripGrp><ntig><termGrp><term id="269319">Data Selector Wizard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779540">Деректер таңдау шебері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14219_310257_627577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows technology that protects OS resources (files, folders registry keys) and prevents applications and administrators from making changes to a computer's resources in an arbitrary way.</descrip></descripGrp><ntig><termGrp><term id="310257">System Protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627577">жүйені қорғау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1422_530443_2205608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field or group of fields that identify an entity as a unique object.</descrip></descripGrp><ntig><termGrp><term id="530443">identifying field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2205608">идентификациялық өріс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14232_231970_627220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that provides interactive analysis of data, like a PivotTable report. You can change views of data, see different levels of detail, or reorganize the chart layout by dragging fields and by showing or hiding items in fields.</descrip></descripGrp><ntig><termGrp><term id="231970">PivotChart report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627220">жиынтық диаграмма есебі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14233_180154_638222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person who created the database, and has full control, including granting access permissions or deleting records. When a database has been restored, then the person who restored it becomes the owner.</descrip></descripGrp><ntig><termGrp><term id="180154">database owner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="638222">дерекқор иесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammati