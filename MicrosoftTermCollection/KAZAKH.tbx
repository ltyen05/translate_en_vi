/ntig></langSet></termEntry><termEntry id="7571_170485_626906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of a collection of drivers that responds to the same IRPs. Layered driver describes the highest-level and lowest-level drivers in a chain of layered drivers that process the same IRPs, along with all intermediate drivers in the chain.</descrip></descripGrp><ntig><termGrp><term id="170485">layered driver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626906">көп деңгейлі драйвер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7575_530257_2201715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column that represents finite, counted data</descrip></descripGrp><ntig><termGrp><term id="530257">discretized column</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2201715">дискреттелген баған</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7576_535367_2218182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Full-text query searching for those occurrences where the specified words are close to one another.</descrip></descripGrp><ntig><termGrp><term id="535367">proximity search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="