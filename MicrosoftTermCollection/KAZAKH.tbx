tig></langSet></termEntry><termEntry id="50713_2870703_2871352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team type in Microsoft Teams for Education that allows teachers and students to collaborate on group projects, assignments, and more.</descrip></descripGrp><ntig><termGrp><term id="2870703">Class Team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2871352">Сынып</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50713_2870703_2871353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team type in Microsoft Teams for Education that allows teachers and students to collaborate on group projects, assignments, and more.</descrip></descripGrp><ntig><termGrp><term id="2870703">Class Team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2871353">Сынып тобы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50713_2870704_2871352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team type in Microsoft Teams for Education that allows teachers and students to collaborate on group projects, assignments, and more.</descrip></descripGrp><ntig><termGrp><term id="2870704">Class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><term