torage that contains the data used by a program.</descrip></descripGrp><ntig><termGrp><term id="782377">data segment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2200329">деректер сегменті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22015_782379_2630856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer (usually quite powerful) that is used solely as a network server.</descrip></descripGrp><ntig><termGrp><term id="782379">dedicated server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2630856">бөлінген сервер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22019_782423_2484308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entry in a list, catalog, or directory providing information about a Web site, product or item for sale, or service.</descrip></descripGrp><ntig><termGrp><term id="782423">listing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2484308">профиль</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2202_40626_639486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To compile and organize entries for a search engine or content index by reading Web pages or other content.</descrip></descripGrp><ntig><termGrp><term id="40626">crawl</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="639486">мазмұнды тексеріп шығу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22021_782458_2522091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used on communications circuits that decreases distortion by amplifying or regenerating a signal so that it can be transmitted onward in its original strength and form. On a network, a repeater connects two networks or two network segments at the physical layer of the ISO/OSI reference model and regenerates the signal.</descrip></descripGrp><ntig><termGrp><term id="782458">repeater</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2522091">қайталауыш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22039_782585_1250336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that collects biometric data for a variety of applications.</descrip></descripGrp><ntig><termGrp><term id="782585">biometric sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250336">биометриялық сенсор</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22040_782586_1250337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sensor that uses ultrasound, infrared, heat or vibration stimuli to detect movement.</descrip></descripGrp><ntig><termGrp><term id="782586">motion sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250337">қимыл сенсоры</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22041_782588_1250338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A biometric sensor that analyses your eye retina to recognize or authenticate identity.</descrip></descripGrp><ntig><termGrp><term id="782588">retinal scanner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250338">көздің шатырша қабығын сканерлеу құрылғысы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22042_782589_1250339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that can respond to an applied stimulus by generating an electrical signal.</descrip></descripGrp><ntig><termGrp><term id="782589">electrical sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250339">электр сенсоры</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22043_782590_1250340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that is used for mechanical measurement of force, scale, pressure, strain, etc.</descrip></descripGrp><ntig><termGrp><term id="782590">mechanical sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250340">механикалық сенсор</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22044_782669_1250341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that tracks environmental changes such as temperature, atmospheric pressure, humidity, wind speed and wind direction.</descrip></descripGrp><ntig><termGrp><term id="782669">environmental sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250341">қоршаған орта күйінің сенсоры</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22045_782671_1250342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of sensor that can determine without physical contact if an object/person is nearby, or can be used to measure the distance between the object/person and the sensor device.</descrip></descripGrp><ntig><termGrp><term id="782671">proximity sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250342">ара қашықтық сенсоры</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22047_1053912_1250343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of sensor (such as a proximity sensor) that uses radio frequency identification (RFID) for a numerous purposes, such as identification of physical items, automatic log on, location of people, etc.</descrip></descripGrp><ntig><termGrp><term id="1053912">radio frequency identification sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250343">RFID сенсоры</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22047_1053912_1250344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of sensor (such as a proximity sensor) that uses radio frequency identification (RFID) for a numerous purposes, such as identification of physical items, automatic log on, location of people, etc.</descrip></descripGrp><ntig><termGrp><term id="1053912">radio frequency identification sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250344">радиожиілік анықтау сенсоры</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22047_782676_1250343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of sensor (such as a proximity sensor) that uses radio frequency identification (RFID) for a numerous purposes, such as identification of physical items, automatic log on, location of people, etc.</descrip></descripGrp><ntig><termGrp><term id="782676">RFID sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250343">RFID сенсоры</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22047_782676_1250344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of sensor (such as a proximity sensor) that uses radio frequency identification (RFID) for a numerous purposes, such as identification of physical items, automatic log on, location of people, etc.</descrip></descripGrp><ntig><termGrp><term id="782676">RFID sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250344">радиожиілік анықтау сенсоры</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22048_782677_1250345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sensor that responds to a pre-defined amount of light.</descrip></descripGrp><ntig><termGrp><term id="782677">light sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250345">жарық сенсоры</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22050_1700972_1764818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Internet site that provides a collection of products and services developed by Microsoft partners for Microsoft Office users.</descrip></descripGrp><ntig><termGrp><term id="1700972">Downloads Marketplace</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1764818">Office дүкені</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22050_1700974_1764818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Internet site that provides a collection of products and services developed by Microsoft partners for Microsoft Office users.</descrip></descripGrp><ntig><termGrp><term id="1700974">Office Store</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1764818">Office дүкені</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22050_782680_1764818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Internet site that provides a collection of products and services developed by Microsoft partners for Microsoft Office users.</descrip></descripGrp><ntig><termGrp><term id="782680">Office Marketplace</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1764818">Office дүкені</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22052_782696_2223427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component within an application that interfaces with the VSS platform infrastructure during backups to ensure that application data is ready for shadow copy creation.</descrip></descripGrp><ntig><termGrp><term id="782696">VSS writer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2223427">VSS жазу модулі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22058_782710_1145260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions that route and queue incoming calls and generate reports to an agent or a set of agents according to adjustable business logic. It defines the user experience of a user who calls a response group.</descrip></descripGrp><ntig><termGrp><term id="782710">workflow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1145260">жұмыс үрдісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22061_1087888_1253376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom tab, on an agent's Office Communicator client, that is used by the agent to sign in to his or her Response Group Service group. The agent must be signed in to the group in order to answer calls routed to the group.</descrip></descripGrp><ntig><termGrp><term id="1087888">Response Group Tab</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1253376">"Жауап тобы" қойыншасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22061_782713_1253376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom tab, on an agent's Office Communicator client, that is used by the agent to sign in to his or her Response Group Service group. The agent must be signed in to the group in order to answer calls routed to the group.</descrip></descripGrp><ntig><termGrp><term id="782713">Response Group tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1253376">"Жауап тобы" қойыншасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22080_783138_1250346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove a Bluetooth link or connection between two Bluetooth–enabled devices.</descrip></descripGrp><ntig><termGrp><term id="783138">unpair</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250346">ажырату</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22085_783181_2522056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A circuit that alternates between two possible states when a pulse is received at the input. For example, if the output of a flip-flop is high and a pulse is received at the input, the output "flips" to low; a second input pulse "flops" the output back to high, and so on.</descrip></descripGrp><ntig><termGrp><term id="783181">flip-flop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2522056">триггер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22085_783216_2522056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A circuit that alternates between two possible states when a pulse is received at the input. For example, if the output of a flip-flop is high and a pulse is received at the input, the output "flips" to low; a second input pulse "flops" the output back to high, and so on.</descrip></descripGrp><ntig><termGrp><term id="783216">bistable multivibrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2522056">триггер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22087_783218_2522061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A circuit element that burns out or breaks when the current passing through it exceeds a certain level. A fuse protects a circuit from damage caused by excess current. It performs the same function as a circuit breaker, but it cannot be reset, so it must be replaced if it breaks. A fuse consists of a short length of wire of a specific composition and thickness; the thicker the wire, the more current it can pass before the wire melts and breaks the circuit.</descrip></descripGrp><ntig><termGrp><term id="783218">fuse</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2522061">сақтандырғыш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2209_95057_1375889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user's right to perform a specific task, usually one that affects an entire computer system rather than a particular object. Privileges are assigned by administrators to individual users or groups of users as part of the security settings for the computer.</descrip></descripGrp><ntig><termGrp><term id="95057">privilege</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1375889">артықшықық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22135_784819_1778238"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view mode in Internet Explorer that determines whether content is rendered as if users were viewing it in a previous version of Internet Explorer.</descrip></descripGrp><ntig><termGrp><term id="784819">Compatibility View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1778238">Үйлесімділік көрінісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22138_785437_2214307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compiler that produces machine code for the computer on which it is running, as opposed to a cross-compiler, which produces code for another type of computer. Most compilers are native compilers.</descrip></descripGrp><ntig><termGrp><term id="785437">native compiler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2214307">меншікті компилятор</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2214_178344_2101447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of control flow and data flow elements that runs as a unit.</descrip></descripGrp><ntig><termGrp><term id="178344">package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101447">жиынтық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22146_785482_2215315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portion of a machine language or assembly language instruction that specifies the type of instruction and the structure of the data on which it operates.</descrip></descripGrp><ntig><termGrp><term id="785482">operation code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215315">операция коды</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2215_295551_2101446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report containing news or information, can be printed or distributed electronically.</descrip></descripGrp><ntig><termGrp><term id="295551">newsletter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101446">ақпараттық бюллетень</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2216_143575_2070175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A discussion comment that is associated with a particular paragraph, image or table.</descrip></descripGrp><ntig><termGrp><term id="143575">inline discussion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070175">енгізілген талқылау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22169_1029910_2381868"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A new type of domain account designed to provide applications such as SQL Server or Exchange with automatic password management and simplified service principal name (SPN) management.</descrip></descripGrp><ntig><termGrp><term id="1029910">managed service account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2381868">MSA</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22169_2381365_2381868"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A new type of domain account designed to provide applications such as SQL Server or Exchange with automatic password management and simplified service principal name (SPN) management.</descrip></descripGrp><ntig><termGrp><term id="2381365">MSA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2381868">MSA</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22170_1029915_2223413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Local Service account that does not require password management. A virtual account is separate from the Local Service, Local System, and Network Service accounts. It uses the computer’s account and credentials when it needs network access in a domain environment.</descrip></descripGrp><ntig><termGrp><term id="1029915">virtual account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2223413">виртуалдық тіркелгі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2218_210899_615601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type that will provide support for storing binary files within an Access database. More similar to the SharePoint concept of attachments than the current OLE object fields in Access. The data will be stored as a raw blob within the database.</descrip></descripGrp><ntig><termGrp><term id="210899">Attachment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615601">тіркеме</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22183_1030868_2234895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Institute of Electrical and Electronics Engineers (IEEE) 802.11 wireless network in which Service Set Identifier (SSID) suppression is enabled.</descrip></descripGrp><ntig><termGrp><term id="1030868">non-broadcast network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2234895">жасырын желі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22183_1030869_2234895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Institute of Electrical and Electronics Engineers (IEEE) 802.11 wireless network in which Service Set Identifier (SSID) suppression is enabled.</descrip></descripGrp><ntig><termGrp><term id="1030869">hidden network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2234895">жасырын желі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22185_1030897_2280237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that prevents Internet Explorer from storing data about your browsing session. This helps prevent anyone else who might be using your computer from seeing where you visited and what you looked at on the Web.</descrip></descripGrp><ntig><termGrp><term id="1030897">InPrivate Browsing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2280237">InPrivate шолуы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22186_1081740_1145171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that blocks third-party web content that could potentially track someone's web activity.</descrip></descripGrp><ntig><termGrp><term id="1081740">InPrivate Filtering</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1145171">InPrivate сүзгілеу</term><termNote type="geographicalUsage"