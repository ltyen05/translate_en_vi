<termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2453731">болжалды қателік шегі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43202_2447224_2449795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of similar feedback displayed in search results, instead of showing all the duplicate feedback.</descrip></descripGrp><ntig><termGrp><term id="2447224">collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2449795">жиын</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43203_2447225_2451285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that combines precision and recall, and that is calculated with (precision*recall)/(precision + recall).</descrip></descripGrp><ntig><termGrp><term id="2447225">f-measure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2451285">F-шара</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43203_2447225_2913610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that combines precision and recall, and that is calculated with (precision*recall)/(precision + recall).</descrip></descripGrp><ntig><termGrp><term id="2447225">f-measure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2913610">F1 бағасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43203_2805605_2451285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that combines precision and recall, and that is calculated with (precision*recall)/(precision + recall).</descrip></descripGrp><ntig><termGrp><term id="2805605">F1 score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2451285">F-шара</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43203_2805605_2913610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that combines precision and recall, and that is calculated with (precision*recall)/(precision + recall).</descrip></descripGrp><ntig><termGrp><term id="2805605">F1 score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2913610">F1 бағасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43204_2447226_2451297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Advanced eDiscovery control that appears as a bar in a bar graph and that can be clicked on to view all the details of what comprises the bar.</descrip></descripGrp><ntig><termGrp><term id="2447226">pivot bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2451297">жиынтық баған</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43205_2447227_2449798"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the collection that contains the feedback you submitted.</descrip></descripGrp><ntig><termGrp><term id="2447227">My feedback</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2449798">Менің пікірлерім</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43206_2447234_2451304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery feature that allows users to check the accuracy of the program's tagging from a user-defined point down to zero.</descrip></descripGrp><ntig><termGrp><term id="2447234">Test the Rest</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><la