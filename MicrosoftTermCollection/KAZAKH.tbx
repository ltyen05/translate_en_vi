tOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2338670">Wunderlist көмекші бағдарламасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40123_2331939_2338672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Wunderlist feature that allows users to enter due dates for a task as text (e.g. next Sunday), automatically recognize the date, and set a due date and reminder for the task.</descrip></descripGrp><ntig><termGrp><term id="2331939">Smart Due Dates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2338672">Смарт мерзімдер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40124_2332081_2338616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that gives users information regarding the safety of a message via a colored bar inserted into the message.</descrip></descripGrp><ntig><termGrp><term id="2332081">Safety Tips</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2338616">Қауіпсіздікке қатысты кеңестер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40126_2332083_2338592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows administrators to inform email senders that they may be about to violate one of the data loss prevention policies.</descrip></descripGrp><ntig><termGrp><term id="2332083">Policy Tips</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2338592">Саясатқа қатысты кеңестер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40128_2332337_2593115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A DNS server that has been configured to return non-routable addresses in response to DNS queries, preventing the use of a domain name.</descrip></descripGrp><ntig><termGrp><term id="2332337">sinkhole</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2593115">sinkhole</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40161_2333639_2340624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to tap a phone against another device to pay for a purchase using a credit or debit card enrolled in Microsoft Wallet as a method of payment.</descrip></descripGrp><ntig><termGrp><term id="2333639">tap to pay</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2340624">төлеу үшін түрту</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40162_2333642_2338505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI element that gives a user a view of the important email, as presorted by the Focused Inbox feature.</descrip></descripGrp><ntig><termGrp><term id="2333642">Focused</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2338505">Cұрыпталған</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40163_2333645_2338675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The email management approach developed by productivity expert Merlin Mann so that zero time is spent thinking about email without any of the five actions he identified.</descrip></descripGrp><ntig><termGrp><term id="2333645">Inbox Zero</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2338675">Inbox Zero</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4017_397157_407497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A storage platform that provides a single repository for managing multiple types of unstructured information in one infrastructure. The Exchange store combines the features and functionality of the file system, the Web, and a collaboration server (such as Microsoft Exchange) through a single, URL-addressable location for storing, accessing, and managing information, as well as building and running applications. The Exchange store is also known as the Web Storage System.</descrip></descripGrp><ntig><termGrp><term id="397157">Exchange store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407497">Ақпарат сақтағыш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40220_2338748_2340625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service designed to provide single sign-on for browser, apps, and services.</descrip></descripGrp><ntig><termGrp><term id="2338748">Web Account Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2340625">Веб-тіркелгі менеджері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40224_2339657_2340623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app ​that lets you edit a song, so you can save part of it as a ringtone.​</descrip></descripGrp><ntig><te