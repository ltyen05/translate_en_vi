pport key Office selling scenarios</descrip></descripGrp><ntig><termGrp><term id="2871545">Office</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2869483">Office Incentives Program</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50692_2871545_2872274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft program designed to reward and support key Office selling scenarios</descrip></descripGrp><ntig><termGrp><term id="2871545">Office</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2872274">Office</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50693_2889584_2890451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft program that provides customers with a Software Asset Management engagement with a Microsoft partner in order for them to better manage their software assets.</descrip></descripGrp><ntig><termGrp><term id="2889584">Solution Assessment Incentives</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2890451">Solution Assessment Incentives</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammatica