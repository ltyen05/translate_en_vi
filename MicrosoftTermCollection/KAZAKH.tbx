ech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20134_702320_776465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The usually pretrial disclosure of pertinent facts or documents by one or both parties to a legal action or proceeding.</descrip></descripGrp><ntig><termGrp><term id="702320">legal discovery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="776465">заңды ашу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20134_702321_776463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The usually pretrial disclosure of pertinent facts or documents by one or both parties to a legal action or proceeding.</descrip></descripGrp><ntig><termGrp><term id="702321">discovery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="776463">ашу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20134_702321_776465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The usually pretrial disclosure of pertinent facts or documents by one or both parties to a legal action or proceeding.</descrip></descripGrp><ntig><termGrp><term id="702321">discovery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="776465">заңды ашу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20136_702323_776467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Extra information displayed to a user while they are composing an email message. MailTips are displayed in an InfoBar, similar to the banner that appears saying "This message has not been sent." MailTips reveal anything that might be unexpected about the delivery or audience of the message, such as recipient validity or Out of Office status or whether the message might not be delivered.</descrip></descripGrp><ntig><termGrp><term id="702323">MailTip</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="776467">сөзкөмек</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20137_702324_776468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mechanism used to help a caller differentiate between users with names that match the touch-tone or speech input.</descrip></descripGrp><ntig><termGrp><term id="702324">matched name selection method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="776468">сейкес келуші аттарды таңдау әдісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20139_702327_776466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that automatically populates multiple mailbox properties when a mailbox is created in the service. A mailbox plan also assigns default permissions to the corresponding user account.</descrip></descripGrp><ntig><termGrp><term id="702327">mailbox plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="776466">пошта жәшігінің жоспары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20140_702751_779546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of shapes arranged in a tree structure that helps analyze and summarize data in a visual, easy-to-understand format. It starts out as a single shape, called a top node, that contains information imported from a worksheet, table, view, or cube.</descrip></descripGrp><ntig><termGrp><term id="702751">PivotDiagram</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779546">жиынтық диаграмма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20141_703430_760092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy that specifies the length of time during which items such as data, documents, builds, and releases are to be retained.</descrip></descripGrp><ntig><termGrp><term id="703430">retention policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="760092">сақтау саясаты</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20143_703432_776474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of Exchange features, organization-wide resource limits, and permissions that are automatically configured or applied when a new hosted organization is provisioned in the service.</descrip></descripGrp><ntig><termGrp><term id="703432">service plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="776474">қызмет көрсету жоспары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20144_703433_776475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML file used to define the elements of a service plan or a mailbox plan.</descrip></descripGrp><ntig><termGrp><term id="703433">service plan template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="776475">қызмет көрсету жоспарының үлгісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20145_703434_776476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email address that a user can create to use when they buy products online or register for updates from a Web site and don't want to use their main email address.</descrip></descripGrp><ntig><termGrp><term id="703434">sign-up address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="776476">тіркеу мекенжайы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20146_703455_776478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of capturing relationships between words by reducing inflected words to their stem or root form (reductive stemming), or expanding stems to their inflected forms (expansive stemming). For example, the word "swimming" is reduced to the stem "swim." Because the word "swam" can also be reduced to "swim," reductive stemming can create a list of all possible word forms that can be used by the query processor alongside the query string.</descrip></descripGrp><ntig><termGrp><term id="703455">word stemming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="776478">түбір шығару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20146_703455_776479"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of capturing relationships between words by reducing inflected words to their stem or root form (reductive stemming), or expanding stems to their inflected forms (expansive stemming). For example, the word "swimming" is reduced to the stem "swim." Because the word "swam" can also be reduced to "swim," reductive stemming can create a list of all possible word forms that can be used by the query processor alongside the query string.</descrip></descripGrp><ntig><termGrp><term id="703455">word stemming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="776479">сөз түбірлерін шығару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20146_703456_776478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of capturing relationships between words by reducing inflected words to their stem or root form (reductive stemming), or expanding stems to their inflected forms (expansive stemming). For example, the word "swimming" is reduced to the stem "swim." Because the word "swam" can also be reduced to "swim," reductive stemming can create a list of all possible word forms that can be used by the query processor alongside the query string.</descrip></descripGrp><ntig><termGrp><term id="703456">stemming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="776478">түбір шығару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20146_703456_776479"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of capturing relationships between words by reducing inflected words to their stem or root form (reductive stemming), or expanding stems to their inflected forms (expansive stemming). For example, the word "swimming" is reduced to the stem "swim." Because the word "swam" can also be reduced to "swim," reductive stemming can create a list of all possible word forms that can be used by the query processor alongside the query string.</descrip></descripGrp><ntig><termGrp><term id="703456">stemming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="776479">сөз түбірлерін шығару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20149_704965_779589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of data such as numbers, number and text combinations, dates, or time periods, based on an established pattern and used to automatically fill data into worksheet cells.</descrip></descripGrp><ntig><termGrp><term id="704965">fill series</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779589">толтыру қатары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20151_705248_2353765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that stops the task in progress and returns to the previous state.</descrip></descripGrp><ntig><termGrp><term id="705248">Cancel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2353765">бас тарту</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20154_705260_776471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of supplying and configuring computing resources.</descrip></descripGrp><ntig><termGrp><term id="705260">provisioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="776471">дайындық жүргізу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20159_707781_1839256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication technology based on short range (4cm or less) wireless data exchange.</descrip></descripGrp><ntig><termGrp><term id="707781">near field communication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1839256">жақын маңдағы байланыс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20159_707781_1839261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication technology based on short range (4cm or less) wireless data exchange.</descrip></descripGrp><ntig><termGrp><term id="707781">near field communication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1839261">NFC</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20159_707782_1839256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication technology based on short range (4cm or less) wireless data exchange.</descrip></descripGrp><ntig><termGrp><term id="707782">NFC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1839256">жақын маңдағы байланыс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20159_707782_1839261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication technology based on short range (4cm or less) wireless data exchange.</descrip></descripGrp><ntig><termGrp><term id="707782">NFC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1839261">NFC</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2016_103676_2219720"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To find a setting in which no hardware conflicts occur.</descrip></descripGrp><ntig><termGrp><term id="103676">resolve</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2219720">жою</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2017_139881_626397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field in the row or column area that contains custom groups as its items.</descrip></descripGrp><ntig><termGrp><term id="139881">custom group field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626397">пайдаланушы топ өрісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20174_714922_1145133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of specialized class in the .NET Framework for data storage and retrieval. These classes provide support for stacks, queues, lists, and hash tables. Most collection classes implement the same interfaces, and these interfaces may be inherited to create new collection classes that fit more specialized data storage needs.</descrip></descripGrp><ntig><termGrp><term id="714922">collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1145133">жиын</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20181_726173_1132527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece or slice of a Web page that users can directly subscribe to from the browser. The browser checks if the piece of the web has updates, and indicates to the user when there are new updates available. Users can preview the piece of the Web before navigating to the full Web page.</descrip></descripGrp><ntig><termGrp><term id="726173">Web Slice</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1132527">Веб-бөлік</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20194_718467_1374166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A plug-in that users download to run a Silverlight-based application in their browser. This term also refers to the component embedded in a Web page that renders Silverlight content.</descrip></descripGrp><ntig><termGrp><term id="718467">Silverlight plug-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1374166">Silverlight plug-in</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20195_718470_1374165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a type or member that accesses secure resources and can only be used by fully trusted code in the .NET Framework.</descrip></descripGrp><ntig><termGrp><term id="718470">security-critical</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1374165">қауіпсіздік тұрғысынан маңызды</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20197_718928_2214904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of processors with its own memory and possibly its own I/O channels.</descrip></descripGrp><ntig><termGrp><term id="718928">NUMA node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2214904">NUMA түйіні</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20198_718937_2717347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a software feature or programming object that is outdated and should not be used. A deprecated item is currently supported for backward compatibility, but it might become obsolete and unsupported in the future.</descrip></descripGrp><ntig><termGrp><term id="718937">deprecated</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2717347">ұсынылмаған</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="202_30582_2070076"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of characters treated as a unit and interpreted by a computer as text rather than numbers. A character string can contain any sequence of elements from a given character set, such as letters, numbers, control characters, and extended ASCII characters.</descrip></descripGrp><ntig><termGrp><term id="30582">character string</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070076">таңбалар қатары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20202_719546_2762542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To stop displaying an application’s active window on screen while leaving the application running.</descrip></descripGrp><ntig><termGrp><term id="719546">hide</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2762542">жасыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20213_719725_1346466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of subsystems and interfaces that form a common structure from which a stream of derivative products can be efficiently developed and produced. A given product may have platform deliverables (building blocks) from several areas that define its implementation.</descrip></descripGrp><ntig><termGrp><term id="719725">platform</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1346466">платформа</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2022_48703_1145153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a copy of.</descrip></descripGrp><ntig><termGrp><term id="48703">duplicate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1145153">көшірмелеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20222_719746_1981744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The window that displays solutions, projects, and files, as well as access to the commands that pertain to them.</descrip></descripGrp><ntig><termGrp><term id="719746">Solution Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1981744">Шешім жетектеушісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20229_720346_1598552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status of an item in source control that reflects one or more changes from a previous form. The greater the version number, the more recent the version.</descrip></descripGrp><ntig><termGrp><term id="720346">version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1598552">нұсқа</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2023_136809_2738124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A link that specifies a full path to a resource, such that the destination of the link doesn’t change based on where it is linking from.</descrip></descripGrp><ntig><termGrp><term id="136809">absolute link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2738124">абсолюттік сілтеме</term><termNote type="geographica