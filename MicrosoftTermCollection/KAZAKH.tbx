><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50590_2865142_2865816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Microsoft 365 for consumer users.</descrip></descripGrp><ntig><termGrp><term id="2865142">Microsoft 365 for home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2865816">Үйге арналған Microsoft 365</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50591_2865796_2866031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A headless app in the Microsoft Store that contains OpenGL and OpenCL API mapping layers on top of DirectX 12 that enable OpenCL and OpenGL apps to run with GPU acceleration in environments where there is no IHV OpenCL or OpenGL driver (for example, on Windows 10 ARM-based PCs).</descrip></descripGrp><ntig><termGrp><term id="2865796">OpenCL™ and OpenGL® Compatibility Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2866031">OpenCL™ және OpenGL® үйлесімділікті қамтамасыз етуші бумасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5060_129154_627713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In relational database management systems, a logical table created through the specification of one or more relational operations on one or more tables. A view is equivalent to a divided relation in the relational model.</descrip></descripGrp><ntig><termGrp><term id="129154">view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627713">көрініс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50604_2866253_2866589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who has high business impact or access to sensitive information, so they get additional mail flow or security monitoring.</descrip></descripGrp><ntig><termGrp><term id="2866253">priority user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2866589">басымдығы бар пайдаланушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50605_2866396_2878721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of calculation items that are grouped together to reduce the number of redundant measures using the same calculations.</descrip></descripGrp><ntig><termGrp><term id="2866396">calculation group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2878721">есептеу тобы</term><termNote type="geographicalUsage">KA