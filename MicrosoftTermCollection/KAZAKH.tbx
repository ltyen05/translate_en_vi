">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2549794">иеленудің жиынтық құны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10244_120183_2549794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An estimate of all direct and indirect costs associated with a purchase, capital investment or acquisition of computer hardware and software.</descrip></descripGrp><ntig><termGrp><term id="120183">total cost of ownership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2549794">иеленудің жиынтық құны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10245_35554_626296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string of text written in the command language and passed to the command interpreter for execution.</descrip></descripGrp><ntig><termGrp><term id="35554">command line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626296">пәрмен жолы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1025_183849_2180249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The kind of commercial enterprise or merchandise with which a business is engaged. Examples of business types would be software, hardware, clothing, etc.</descrip></descripGrp><ntig><termGrp><term id="183849">business type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2180249">кәсіпорын түрі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10254_85648_2520754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short piece of content that is informative.</descrip></descripGrp><ntig><termGrp><term id="85648">note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2520754">ескертпе</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10261_125604_627678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to software, to remove program files and folders from the hard disk and remove related data from the registry so the software or solution is no longer available.</descrip></descripGrp><ntig><termGrp><term id="125604">uninstall</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627678">жою</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10261_736801_627678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to software, to remove program files and folders from the hard disk and remove related data from the registry so the software or solution is no longer available.</descrip></descripGrp><ntig><termGrp><term id="736801">deinstall</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627678">жою</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10265_234076_626141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that brings up an international list that allows users to block emails from those domains.</descrip></descripGrp><ntig><termGrp><term id="234076">Blocked Top-Level Domain List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626141">блокталған жоғары деңгейлі домен тізімі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10268_169412_627326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To do over again.</descrip></descripGrp><ntig><termGrp><term id="169412">redo</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627326">қайтару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1027_1176956_1374158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key or combination of keys used to tell a computer to halt, or break out of, whatever it is doing. On IBM PCs and compatibles under DOS, pressing the Pause/ Break or Scroll Lock/Break key while holding down the Ctrl key issues the break command (as does Ctrl-C). On Macintosh computers, the key combination that sends a break code is Command-period.</descrip></descripGrp><ntig><termGrp><term id="1176956">control-break</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1374158">Ctrl+Break пернелері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1027_1373987_1374158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key or combination of keys used to tell a computer to halt, or break out of, whatever it is doing. On IBM PCs and compatibles under DOS, pressing the Pause/ Break or Scroll Lock/Break key while holding down the Ctrl key issues the break command (as does Ctrl-C). On Macintosh computers, the key combination that sends a break code is Command-period.</descrip></descripGrp><ntig><termGrp><term id="1373987">Ctrl+Break</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1374158">Ctrl+Break пернелері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1027_23660_1374158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key or combination of keys used to tell a computer to halt, or break out of, whatever it is doing. On IBM PCs and compatibles under DOS, pressing the Pause/ Break or Scroll Lock/Break key while holding down the Ctrl key issues the break command (as does Ctrl-C). On Macintosh computers, the key combination that sends a break code is Command-period.</descrip></descripGrp><ntig><termGrp><term id="23660">BREAK key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1374158">Ctrl+Break пернелері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10273_297181_626643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A peer-to-peer file sharing client used to connect to file sharing networks in order to download or share files.</descrip></descripGrp><ntig><termGrp><term id="297181">file sharing program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626643">файлдарды ортақтастыру бағдарламасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10275_6075_1091132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of changing the values in cells to see how those changes affect the outcome of formulas on a worksheet. For example, varying the interest rate that is used in an amortization table to determine the amount of the payments.</descrip></descripGrp><ntig><termGrp><term id="6075">what-if analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1091132">мүмкін болатын нұсқаларды талдау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10275_6076_1091132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of changing the values in cells to see how those changes affect the outcome of formulas on a worksheet. For example, varying the interest rate that is used in an amortization table to determine the amount of the payments.</descrip></descripGrp><ntig><termGrp><term id="6076">"what-if" evaluation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1091132">мүмкін болатын нұсқаларды талдау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10276_232855_627749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that displays the Web page in a Web browser.</descrip></descr