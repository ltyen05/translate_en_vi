ry id="22328_1042566_2750293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security attack that takes advantage of computer security holes for which no solution is yet available.</descrip></descripGrp><ntig><termGrp><term id="1042566">zero-day attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2750293">нөлдік күн шабуылы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22328_1042568_2750293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security attack that takes advantage of computer security holes for which no solution is yet available.</descrip></descripGrp><ntig><termGrp><term id="1042568">zero day attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2750293">нөлдік күн шабуылы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22328_2747277_2750293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security attack that takes advantage of computer security holes for which no solution is yet available.</descrip></descripGrp><ntig><termGrp><term id="2747277">0-day attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2750293">нөлдік күн шабуылы</term><termNote type="geographicalU