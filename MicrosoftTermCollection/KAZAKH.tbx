йындау модулі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26871_2482869_2220607"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rendering extension that maintains the report layout and formatting so that the resulting file is optimized for screen-based viewing and delivery, such as on a Web page or in the ReportViewer controls.</descrip></descripGrp><ntig><termGrp><term id="2482869">SPB renderer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2220607">есептерді қарап шығуға дайындау модулі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26872_1357919_2203875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rendering extension that maintains the report layout and formatting so that the resulting file is optimized for a consistent printing experience, or to view the report online in a book format.</descrip></descripGrp><ntig><termGrp><term id="1357919">hard page-break renderer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2203875">есептерді баспаға дайындау модулі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26872_2482867_2203875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rendering extension that maintains the report layout and formatting so that the resulting file is optimized for a consistent printing experience, or to view the report online in a book format.</descrip></descripGrp><ntig><termGrp><term id="2482867">HPB renderer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2203875">есептерді баспаға дайындау модулі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2688_119447_2221505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data retrieval operation where the database engine must read all the pages in a table to find the rows that qualify for a query.</descrip></descripGrp><ntig><termGrp><term id="119447">table scan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221505">кестені сканерлеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26891_1358013_2389111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who connects to the home network or business network using a computer connected to the Internet.</descrip></descripGrp><ntig><termGrp><term id="1358013">remote user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2389111">қашықтағы пайдаланушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26894_1358510_2794446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology used by Exchange to store user mailboxes and folders. A store consists of a rich-text database (.edb), plus a streaming native Internet content database (.stm).</descrip></descripGrp><ntig><termGrp><term id="1358510">store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2794446">сақтау орны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="269_186086_1333359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An access code that is required for a user to join a conference as a participant. This code is entered in the Options dialog box, on the Accounts tab, under Conferencing Information.</descrip></descripGrp><ntig><termGrp><term id="186086">participant code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1333359">Қатысушы коды</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2690_19121_626098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard key that moves the cursor to the left, one character at a time, usually erasing each character as it moves.</descrip></descripGrp><ntig><termGrp><term id="19121">BACKSPACE key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626098">BACKSPACE пернесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26902_1358990_1375622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form that is displayed when another form option isn’t explicitly set. An example would be if an administrator fails to define a form for a particular security group that has access to the application.</descrip></descripGrp><ntig><termGrp><term id="1358990">fallback form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1375622">резервтік пішін</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26903_1358991_1375743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI section that displays the fields available for customizing a form.</descrip></descripGrp><ntig><termGrp><term id="1358991">Field Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1375743">өріс жетектеушісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26904_1358992_1375913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI section in the Form Editor that shows existing relationships for a form and will allow you to add to or modify them.</descrip></descripGrp><ntig><termGrp><term id="1358992">Relationship Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1375913">Қатынас жетектеушісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26909_1359034_1375851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of deploying on-premises CRM so that remote users can connect to the application from the Internet.</descrip></descripGrp><ntig><termGrp><term id="1359034">Internet-facing deployment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1375851">IFD</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26909_1359034_1375857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of deploying on-premises CRM so that remote users can connect to the application from the Internet.</descrip></descripGrp><ntig><termGrp><term id="1359034">Internet-facing deployment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1375857">Интернеттен орналастыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26909_1370486_1375851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of deploying on-premises CRM so that remote users can connect to the application from the Internet.</descrip></descripGrp><ntig><termGrp><term id="1370486">IFD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1375851">IFD</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26909_1370486_1375857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of deploying on-premises CRM so that remote users can connect to the application from the Internet.</descrip></descripGrp><ntig><termGrp><term id="1370486">IFD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1375857">Интернеттен орналастыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26910_1359035_1490419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of authenticating a user based on a set of claims about the user's identity contained in a trusted token. This token is often issued and signed by an entity that is able to authenticate the user by other means, and that is trusted by the entity doing the claims-based authentication.</descrip></descripGrp><ntig><termGrp><term id="1359035">claims-based authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1490419">мәлімдеме негізіндегі түпнұсқалық растама</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26911_1359038_1375610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability to view and manage SharePoint documents from Microsoft Dynamics CRM.</descrip></descripGrp><ntig><termGrp><term id="1359038">document management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1375610">құжаттарды басқару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26912_1359039_1375818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The permission that is assigned to a user or users that allow them to read, update, or create a specific field.</descrip></descripGrp><ntig><termGrp><term id="1359039">field-level access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumbe