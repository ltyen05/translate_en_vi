r">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2414432">жобалар портфельдерін басқару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42317_2394292_2414430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal approach used by organizations to orchestrate, prioritize and benefit from projects by examining the risk-reward of each project, the available funds, the likelihood of a project's duration, and the expected outcomes.</descrip></descripGrp><ntig><termGrp><term id="2394292">PPM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2414430">PPM</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42317_2394292_2414432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal approach used by organizations to orchestrate, prioritize and benefit from projects by examining the risk-reward of each project, the available funds, the likelihood of a project's duration, and the expected outcomes.</descrip></descripGrp><ntig><termGrp><term id="2394292">PPM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2414432">жобалар портфельдерін басқару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote ty