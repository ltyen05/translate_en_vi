lNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2770033">таңбашалар тақтасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45671_2572292_2576900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A purchase of a product or service that is paid once and cannot be upgraded or renewed.</descrip></descripGrp><ntig><termGrp><term id="2572292">one-time purchase</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2576900">бір реттік сатып алу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45672_2572293_2576887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of resources that allows software existing on a computer to work with resources in a new format.</descrip></descripGrp><ntig><termGrp><term id="2572293">compatibility pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2576887">үйлесімділікті қамтамасыз етуші бума</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45673_2572295_2576892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An average of the secure 