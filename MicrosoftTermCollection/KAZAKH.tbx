eech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10508_397161_407481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A thread that creates multiple message copies and places them in the appropriate link queues. The dispatcher then triggers XFER OUT threads to process the fan-out message copies.</descrip></descripGrp><ntig><termGrp><term id="397161">fan-out thread</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407481">тарамды хабар ағыны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10509_210900_1777538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode in which the default style settings defined in Page Options &gt; CSS tab will be used on a page level as well as on an inline style level. The style application mode can also be set to manual.</descrip></descripGrp><ntig><termGrp><term id="210900">auto style application mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1777538">мәнерлерді автоқолдану режимі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10519_210459_615622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A .UDL text file that stores an OLE DB connectstring (simila