ticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627087">бүркеншік ат</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1575_1177075_626260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic circuit in a computer that generates a steady stream of timing pulses--the digital signals that synchronize every operation. The system clock signal is precisely set by a quartz crystal, typically at a specific frequency between 1 and 50 megahertz. The clock rate of a computer is one of the prime determinants of its overall processing speed, and it can go as high as the other components of the computer allow.</descrip></descripGrp><ntig><termGrp><term id="1177075">system timer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626260">сағат</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1575_1177075_627572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic circuit in a computer that generates a steady stream of timing pulses--the digital signals that synchronize every operation. The system clock signal is precisely set by a quartz crystal, typically at a specific frequency between 1 and 50 megahertz. The clock rate of a computer is one of the prime determinants of its overall processing speed, and it can go as high as the other components of the computer allow.</descrip></descripGrp><ntig><termGrp><term id="1177075">system timer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627572">жүйелік сағат</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1575_32826_626260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic circuit in a computer that generates a steady stream of timing pulses--the digital signals that synchronize every operation. The system clock signal is precisely set by a quartz crystal, typically at a specific frequency between 1 and 50 megahertz. The clock rate of a computer is one of the prime determinants of its overall processing speed, and it can go as high as the other components of the computer allow.</descrip></descripGrp><ntig><termGrp><term id="32826">clock</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626260">сағат</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1575_32826_627572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic circuit in a computer that generates a steady stream of timing pulses--the digital signals that synchronize every operation. The system clock signal is precisely set by a quartz crystal, typically at a specific frequency between 1 and 50 megahertz. The clock rate of a computer is one of the prime determinants of its overall processing speed, and it can go as high as the other components of the computer allow.</descrip></descripGrp><ntig><termGrp><term id="32826">clock</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627572">жүйелік сағат</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1575_334537_626260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic circuit in a computer that generates a steady stream of timing pulses--the digital signals that synchronize every operation. The system clock signal is precisely set by a quartz crystal, typically at a specific frequency between 1 and 50 megahertz. The clock rate of a computer is one of the prime determinants of its overall processing speed, and it can go as high as the other components of the computer allow.</descrip></descripGrp><ntig><termGrp><term id="334537">system clock</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626260">сағат</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1575_334537_627572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic circuit in a computer that generates a steady stream of timing pulses--the digital signals that synchronize every operation. The system clock signal is precisely set by a quartz crystal, typically at a specific frequency between 1 and 50 megahertz. The clock rate of a computer is one of the prime determinants of its overall processing speed, and it can go as high as the other components of the computer allow.</descrip></descripGrp><ntig><termGrp><term id="334537">system clock</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627572">жүйелік сағат</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15750_149937_615599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of an SQL statement that specifies which records to retrieve.</descrip></descripGrp><ntig><termGrp><term id="149937">WHERE clause</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615599">SQL WHERE сөйлемі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15753_140189_2101549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range of cells that contains data and that is bounded by empty cells or worksheet borders.</descrip></descripGrp><ntig><termGrp><term id="140189">data region</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101549">деректер аумағы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15754_35604_776532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interface between the operating system and the user in which the user types command language strings of text that are passed to the command interpreter for execution.</descrip></descripGrp><ntig><termGrp><term id="35604">command prompt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="776532">Пәрмен жолағы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15755_12576_2175591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The conversion of characters that must occur when data is transferred from a database that stores character data using a specific code page to a client application on a computer that uses a different code page. Typically, Windows-based client computers use ANSI/ISO code pages, and some databases (for compatibility reasons) might use OEM code pages.</descrip></descripGrp><ntig><termGrp><term id="12576">ANSI to OEM conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2175591">ANSI-OEM өзгерісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15758_96558_380592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of programs or tasks waiting for execution.</descrip></descripGrp><ntig><termGrp><term id="96558">queue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="380592">кезек</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15759_331728_2101550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2007 edition of the Microsoft server software that centrally stores standardized project and resource information across an organization.</descrip></descripGrp><ntig><termGrp><term id="331728">Microsoft® Office Project Server 2007</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101550">Microsoft® Office Project Server 2007</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15760_27264_1030572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication vehicle that contributes to the specified result of a campaign. You can create three types of campaign items in Commerce Server: ads, direct mail, or discounts. You can use third-party products to create additional types of campaign items.</descrip></descripGrp><ntig><termGrp><term id="27264">campaign item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030572">науқан элементі</term><termNote type="geographicalUsage">KAZ</termNote><termNo