ermGrp><term id="615853">Қор көздері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15329_418620_1362510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The folder in Outlook where instant messages and phone conversations are stored.</descrip></descripGrp><ntig><termGrp><term id="418620">Conversation History</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1362510">Сөйлесу журналы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15331_530442_2205576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A storage mode that uses a combination of multidimensional data structures and relational database tables to store multidimensional data.</descrip></descripGrp><ntig><termGrp><term id="530442">hybrid OLAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2205576">гибридтік OLAP</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15332_397204_407607"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Records management technology in Exchange 2007 that helps organizations to reduce the risks that are associated with email and other communications. MRM makes it easier to keep messages that are needed to comply with company policy, government regulations, or legal needs, and to remove content that has no legal or business value.</descrip></descripGrp><ntig><termGrp><term id="397204">messaging records management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407607">хабар мәтінін қадағалау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15332_397204_407608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Records management technology in Exchange 2007 that helps organizations to reduce the risks that are associated with email and other communications. MRM makes it easier to keep messages that are needed to comply with company policy, government regulations, or legal needs, and to remove content that has no legal or business value.</descrip></descripGrp><ntig><termGrp><term id="397204">messaging records management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407608">MRM</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15332_397205_407607"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Records management technology in Exchange 2007 that helps organizations to reduce the risks that are associated with email and other communications. MRM makes it easier to keep messages that are needed to comply with company policy, government regulations, or legal needs, and to remove content that has no legal or business value.</descrip></descripGrp><ntig><termGrp><term id="397205">MRM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407607">хабар мәтінін қадағалау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15332_397205_407608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Records management technology in Exchange 2007 that helps organizations to reduce the risks that are associated with email and other communications. MRM makes it easier to keep messages that are needed to comply with company policy, government regulations, or legal needs, and to remove content that has no legal or business value.</descrip></descripGrp><ntig><termGrp><term id="397205">MRM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407608">MRM</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15335_104365_627348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To copy files from a backup storage device to their normal location, especially if the files are being copied to replace files that were accidentally lost or deleted.</descrip></descripGrp><ntig><termGrp><term id="104365">restore</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627348">қалпына келтіру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1534_94749_627268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key on IBM PC and compatible keyboards that normally causes the computer to send a character-based “picture” of the screen contents to the printer.</descrip></descripGrp><ntig><termGrp><term id="94749">PRINT SCREEN key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627268">PRINT SCREEN пернесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15341_335525_638207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section, located on the Business Contact Manager menu, that tracks interactions with customers by linking items to records.</descrip></descripGrp><ntig><termGrp><term id="335525">Communication History</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="638207">Байланыс жұрналы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15344_292991_2731825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate which contains information that identifies the server, as well as information about the organization that issued the certificate.</descrip></descripGrp><ntig><termGrp><term id="292991">SSL server certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2731825">SSL сервер сертификаты</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15347_81536_2214245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An arithmetic operation whose result is the remainder of a division operation. For example, 17 modulo 3 = 2 because 17 divided by 3 yields a remainder of 2. Modulo operations are used in programming.</descrip></descripGrp><ntig><termGrp><term id="81536">modulo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2214245">бөлу қалдығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15349_235260_2174091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reporting system that enables end users to run queries and create custom reports without having to know the technicalities of the underlying database schema and query syntax.</descrip></descripGrp><ntig><termGrp><term id="235260">ad hoc reporting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2174091">автоматты есеп беру жүйесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15350_134128_627804"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for creating and manipulating text-based documents.</descrip></descripGrp><ntig><termGrp><term id="134128">word processor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627804">мәтіндік процессор</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15359_234913_1250201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual experience of the premium Windows Vista editions. Windows Aero builds on the Basic and Standard user experiences to offer customers our best-designed, highest-performing desktop environment. A noticeable element of the new Windows Aero experience is the professional-looking, transparent glass design, which creates an open, lightweight environment but more importantly enables users to focus on their content rather than the interface.</descrip></descripGrp><ntig><termGrp><term id="234913">Aero</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250201">шын, белсенді, қайтарғыш және ашық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Other</termNot