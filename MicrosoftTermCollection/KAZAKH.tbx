lang="en-US"><descripGrp><descrip type="definition">A visual indication that represents the current location being played within the selected media.</descrip></descripGrp><ntig><termGrp><term id="309435">playhead</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627232">ойнату көрсеткіші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13007_111882_615344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color that is mixed with black. A 10-percent shade is one part of the original color and nine parts black.</descrip></descripGrp><ntig><termGrp><term id="111882">shade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615344">көлеңкелеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13007_111882_627436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color that is mixed with black. A 10-percent shade is one part of the original color and nine parts black.</descrip></descripGrp><ntig><termGrp><term id="111882">shade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627436">көлеңке</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelect