tioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2218469">ауқымдар бойынша бөлу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7146_155976_2093593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology, policy, or procedure that counters a threat or protects assets.</descrip></descripGrp><ntig><termGrp><term id="155976">safeguard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093593">қауіпсіздік шарасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7147_237384_615671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A property that defines how items will be saved to the search index, how you may search for the property and whether or not the property is shown in search results.</descrip></descripGrp><ntig><termGrp><term id="237384">managed property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615671">басқарылатын сипат</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7155_45474_1249206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or being a connection that uses the public switched telephone network rather than a dedicated circuit or some other type of private network.</descrip></descripGrp><ntig><termGrp><term id="45474">dial-up</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1249206">нөмір теру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7158_125863_1362665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security or distribution group that can contain users, groups, and computers from any domain in its forest as members.</descrip></descripGrp><ntig><termGrp><term id="125863">universal group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1362665">әмбебап топ</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="716_37715_2070106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains machine-readable operating specifications for a piece of hardware or software or that contains information on another file or on a specific user, such as the user's logon ID.</descrip></descripGrp><ntig><termGrp><term id="37715">configuration file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langS