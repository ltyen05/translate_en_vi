2"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A map that displays a marker at each location (for example, cities) and varies marker color, size, and type.</descrip></descripGrp><ntig><termGrp><term id="1167334">marker map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2177502">белгілері бар стандартты карта</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25075_1167334_2211439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A map that displays a marker at each location (for example, cities) and varies marker color, size, and type.</descrip></descripGrp><ntig><termGrp><term id="1167334">marker map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2211439">белгілері бар карта</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25075_1170234_2177502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A map that displays a marker at each location (for example, cities) and varies marker color, size, and type.</descrip></descripGrp><ntig><termGrp><term id="1170234">basic marker map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2177502">белгілері бар стандартты карта</term><termNote type="geographicalUsa