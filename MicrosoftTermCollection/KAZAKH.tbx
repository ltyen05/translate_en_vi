rmNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43759_2468788_2471349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that enables customers to generate encryption keys on premises and send them securely to Azure-managed hardware security modules where they can be decrypted and used.</descrip></descripGrp><ntig><termGrp><term id="2468788">Bring Your Own Key</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2471349">BYOK</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43759_2468788_2471350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that enables customers to generate encryption keys on premises and send them securely to Azure-managed hardware security modules where they can be decrypted and used.</descrip></descripGrp><ntig><termGrp><term id="2468788">Bring Your Own Key</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2471350">жеке кілттерді жасау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4376_31635_2064663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A situation in which one object refers back to itself, either directly or indirectly.</descrip></descripGrp><ntig><termGrp><term id="31635">circular reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2064663">айналма сілтеме</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43761_2469253_2471367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word print layout that allows horizontal movement between pages in a document.</descrip></descripGrp><ntig><termGrp><term id="2469253">Page-Stack navigation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2471367">парақтау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43762_2469812_2472895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Sound that is spatialized or is precisely located around a listener in 3D space. Developers can use spatial sound in an application to convincingly place sounds in a 3D space all around the user. Sounds will then seem as if they are coming from real physical objects even though the user may only be using regular stereo headphones.</descrip></descripGrp><ntig><termGrp><term id="2469812">spatial sound</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2472895">кеңейтілген дыбыс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43768_2470183_2472896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Technology that enables a 3D graphics processor to display the image at the moment it is rendered for more fluid and better detailed gameplay, and for reducing or eliminating lag, stutter and frame tearing.</descrip></descripGrp><ntig><termGrp><term id="2470183">variable refresh rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2472896">айнымалы жаңарту жиілігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43768_2470196_2472896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Technology that enables a 3D graphics processor to display the image at the moment it is rendered for more fluid and better detailed gameplay, and for reducing or eliminating lag, stutter and frame tearing.</descrip></descripGrp><ntig><termGrp><term id="2470196">VRR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2472896">айнымалы жаңарту жиілігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43769_2470203_2473425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Advanced Threat Protection reporting feature that gives users interactive, personalized visual reports of the threats to their organization, provides context for attacks, and that provides actionable steps for protection.</descrip></descripGrp><ntig><termGrp><term id="2470203">Threat explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2473425">Қауіптерді шолу құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43785_2470551_2762327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The solution class that contains solutions to create development and testing environments so that you can deliver features faster.</descrip></descripGrp><ntig><termGrp><term id="2470551">Development and test</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2762327">Әзірлеу және тексеру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43798_2758211_2762316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated set of BI services which include Power BI, PowerApps, and Microsoft Flow.</descrip></descripGrp><ntig><termGrp><term id="2758211">Microsoft Power Platform</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2762316">Microsoft Power Platform</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43798_2758211_2762318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated set of BI services which include Power BI, PowerApps, and Microsoft Flow.</descrip></descripGrp><ntig><termGrp><term id="2758211">Microsoft Power Platform</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2762318">Power Platform</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43798_2758212_2762316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated set of BI services which include Power BI, PowerApps, and Microsoft Flow.</descrip></descripGrp><ntig><termGrp><term id="2758212">Power Platform</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2762316">Microsoft Power Platform</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43798_2758212_2762318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated set of BI services which include Power BI, PowerApps, and Microsoft Flow.</descrip></descripGrp><ntig><termGrp><term id="2758212">Power Platform</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2762318">Power Platform</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43799_2470927_2471591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The lightweight markup language with plain text formatting syntax designed to be converted to HTML and other formats and that is used to format readme files, write messages in online discussion forums, and create rich text using a plain text editor.</descrip></descripGrp><ntig><termGrp><term id="2470927">Markdown</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2471591">Markdown</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43800_2470929_2471592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word add-in that converts Markdown documents to Word format for editing and then converts the Word document back to Markdown format, using the Paragraph, Table, List, and Range objects.</descrip></descripGrp><ntig><termGrp><term id="2470929">Markdown editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2471592">Markdown editor</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43809_2471187_2498350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component type of the app designer that includes entities, dashboards, and business process flows.</descrip></descripGrp><ntig><termGrp><term id="2471187">artifact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2498350">артефакт</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4381_132217_2093435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person responsible for creating and maintaining a World Wide Web site. A webmaster is often responsible for responding to email, ensuring the site is operating properly, creating and updating Web pages, and maintaining the overall structure and design of the site.</descrip></descripGrp><ntig><termGrp><term id="132217">Web master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093435">веб-шебер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4381_132218_2093435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person responsible for creating and maintaining a World Wide Web site. A webmaster is often responsible for responding to email, ensuring the site is operating properly, creating and updating Web pages, and maintaining the overall structure and design of the site.</descrip></descripGrp><ntig><termGrp><term id="132218">webmaster</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093435">веб-шебер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4381_132219_2093435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person responsible for creating and maintaining a World Wide Web site. A webmaster is often responsible for responding to email, ensuring the site is operating properly, creating and updating Web pages, and maintaining the overall structure and design of the site.</descrip></descripGrp><ntig><termGrp><term id="132219">webmistress</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093435">веб-шебер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43810_2471606_2498352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customizable area of an app, site map, or view designer where users can add or edit different components of a business app.</descrip></descripGrp><ntig><termGrp><term id="2471606">canvas</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2498352">кенеп</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43811_2471609_2498348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stage in a business process flow that uses an automated process for gathering data.</descrip></descripGrp><ntig><termGrp><term id="2471609">action step</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2498348">әрекет қадамы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43812_2471610_2498351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customized rule that applies form logic without users having to write code or create plug-ins. Users can create business rules to set or clear form field values, validate data and errors, and create business recommendations based on business intelligence.</descrip></descripGrp><ntig><termGrp><term id="2471610">business rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2498351">бизнес ереже</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43813_2471611_2479028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numerical summary of an organization's security posture based on system configurations, user behavior and other security related measurements that represents the extent to which an organization has adopted security controls in their Microsoft environment which can help offset the risk of being breached.</descrip></descripGrp><ntig><termGrp><term id="2471611">secure score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2479028">қауіпсіздік бағасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43814_2471613_2498353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A format used to create an action card in the Relationship Assistant in Dynamics 365.</descrip></descripGrp><ntig><termGrp><term id="2471613">card form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2498353">карта пішіні</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43815_2471614_2498360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display window that shows users a variety of relevant data-driven insights and news from their contacts, watch list, leads, opportunities, accounts, and social media.</descrip></descripGrp><ntig><termGrp><term id="2471614">Insights pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2498360">Insights тақтасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43816_2471615_2498349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive designer that simplifies the app building experience so users can create and customize their own business apps with charts, entities, dashboards, forms, views, and business processes.</descrip></descripGrp><ntig><termGrp><term id="2471615">app designer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2498349">бағдарлама құрастырушысы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43817_2471616_2498362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive feature within the app designer that offers users a simplified way to design, edit, or customize how they view and access customer and business data.</descrip></descripGrp><ntig><termGrp><term id="2471616">view designer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2498362">көрініс құрастырушысы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4382_252092_2093436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transaction that contains distributions to another company within the same legal entity.</descrip></descripGrp><ntig><termGrp><term id="252092">intercompany transaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093436">компанияаралық транзакция</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43820_2471849_2498357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of plug-ins registered on an external data provider to implement support for connecting virtual entities to external data.</descrip></descripGrp><ntig><termGrp><term id="2471849">entity data provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2498357">нысан деректерінің провайдері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43821_2471850_2498358"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Connection information used by an external data provider for a virtual entity to retrieve and display external data.</descrip></descripGrp><ntig><termGrp><term id="2471850">entity data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp