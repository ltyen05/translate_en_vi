ote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2814446">сипат</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45807_2579499_2814447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A property that represents the status of the provisioning operation on the resource.</descrip></descripGrp><ntig><termGrp><term id="2579499">provisioning state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2814447">дайындау күйі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45808_2579500_2814438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predictive activity that is focused on evaluating the likelihood of a lead to convert into an actual business opportunity.</descrip></descripGrp><ntig><termGrp><term id="2579500">lead qualification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2814438">ықтимал тұтынушының біліктілігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45809_2579501_2814448"><langSet xml:lang="en-US"><descripGrp><