n-US"><descripGrp><descrip type="definition">The fourth day of the Islamic holiday that marks the end of Ramadan.</descrip></descripGrp><ntig><termGrp><term id="3152915">Eid al Fitr (4th Day)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3153403">Эйд-аль-Фитр (төртінші күн)</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56079_3152916_3153404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The fifth day  of the Islamic holiday that marks the end of Ramadan.</descrip></descripGrp><ntig><termGrp><term id="3152916">Eid al Fitr (5th Day)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3153404">Эйд-аль-Фитр (бесінші күн)</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5608_264890_615737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that outlines a strategic approach for product development. By understanding your business position in the marketplace, establishing product infrastructure, and a knowledge of your targets and competitors, this template establishes a framework to begin product development.</descrip></descripGrp><ntig><termGrp><term id="264890">Product Development Planning</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></n