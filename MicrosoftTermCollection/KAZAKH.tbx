try><termEntry id="37888_2168875_2249142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pane that functions as a centralized location where Office 365 for Business users can view all of their missed system events, and that is accessible through one entry point in the navigation bar and shows up in the flex pane.</descrip></descripGrp><ntig><termGrp><term id="2168875">notification pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2249142">хабарландырулар тақтасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37889_2168877_2249141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of authentication mechanisms which includes authenticating users with both on-premises and cloud-hosted Office services, single sign-on authentication (including against third party identity providers) so that passwords are not sent directly to Office 365, and multi-factor authentication.</descrip></descripGrp><ntig><termGrp><term id="2168877">modern authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2249141">заманауи аутентификация</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3789_90732_615540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of query that, when you run it, prompts for values (criteria) to use to select the records for the result set so that the same query can be used to retrieve different result sets.</descrip></descripGrp><ntig><termGrp><term id="90732">parameter query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615540">параметрлік сұрау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37890_2168878_2249143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API that enables developers to create, read, update, and delete objects and relationships between them in an Office graph.</descrip></descripGrp><ntig><termGrp><term id="2168878">Office Graph API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2249143">Office graph API</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37899_2169164_2684410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The attack method where the attacker steals the hashed credentials of a user (or a computer) in order to authenticate, via NTLM, to various resources within the same network.</descrip></descripGrp><ntig><termGrp><term id="2169164">Pass-the-Hash</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2684410">Pass-the-Hash</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37899_2169165_2684410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The attack method where the attacker steals the hashed credentials of a user (or a computer) in order to authenticate, via NTLM, to various resources within the same network.</descrip></descripGrp><ntig><termGrp><term id="2169165">PtH</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2684410">Pass-the-Hash</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37900_2169170_2795858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The attack method where the attacker steals a user’s Kerberos authentication ticket to impersonate that user and access various enterprise resources.</descrip></descripGrp><ntig><termGrp><term id="2169170">Pass-the-Ticket</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2795858">Pass-the-Ticket</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37900_2169171_2795858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The attack method where the attacker steals a user’s Kerberos aut