ition">The process of writing data to disk.</descrip></descripGrp><ntig><termGrp><term id="647152">save process</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2220068">сақтау процесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1745_557771_1030724"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string used to identify the version of a report.</descrip></descripGrp><ntig><termGrp><term id="557771">report signature</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030724">есеп қолтаңбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17450_647153_2203927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A structure in which elements are related to each other hierarchically.</descrip></descripGrp><ntig><termGrp><term id="647153">hierarchy tree</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2203927">иерархия ағашы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17451_647160_2221504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A name, expression or string that resolves to a table.</descrip></descripGrp><ntig><termGrp><term id="647160">table reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221504">кестеге сілтеме</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17452_647163_2201135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A part of a DML Statement that contains the DELETE keyword and associated parameters.</descrip></descripGrp><ntig><termGrp><term id="647163">DELETE clause</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2201135">DELETE сөйлемі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17453_647172_2201555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chain of attribute relationships that splits and rejoins but that contains no redundant relationships. For example, Day-&gt;Month-&gt;Year and Day-&gt;Quarter-&gt;Year have the same start and end points, but do not have any common relationships.</descrip></descripGrp><ntig><termGrp><term id="647172">diamond-shape relationship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2201555">ромб тәрізді байланыс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17454_647179_2223534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Resource Governor, a container for session requests that are similar according to the classification rules that are applied to each request. A workload group allows the aggregate monitoring of resource consumption and a uniform policy that is applied to all the requests in a group.</descrip></descripGrp><ntig><termGrp><term id="647179">workload group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2223534">жұмыс жүктемесі тобы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17456_648311_1250214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that tracks and stores a record of a shared document when it is first created, and each time it is edited.</descrip></descripGrp><ntig><termGrp><term id="648311">version history</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250214">нұсқа журналы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17457_648312_2201007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of logical pre-defined properties that model the behavior or characteristics for certain types of managed targets (such as a database, table, login, view,etc) in policy-based management.</descrip></descripGrp><ntig><termGrp><term id="648312">Declarative Management Framework Facet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2201007">DMF аспекті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17457_648314_2201007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of logical pre-defined properties that model the behavior or characteristics for certain types of managed targets (such as a database, table, login, view,etc) in policy-based management.</descrip></descripGrp><ntig><termGrp><term id="648314">Facet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2201007">DMF аспекті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17458_648315_2200997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy based system of SQL Server management.</descrip></descripGrp><ntig><termGrp><term id="648315">Declarative Management Framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2200997">Declarative Management Framework</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17459_648332_2200001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of SQL Server 2005 Integration Services that manipulates data.</descrip></descripGrp><ntig><termGrp><term id="648332">data flow component</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2200001">деректер ағынының компоненті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17461_648334_2221638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data flow component that is used to perform aggregations, sorting, merging, modifying, joining, data cleansing, and data distribution</descrip></descripGrp><ntig><termGrp><term id="648334">transformation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221638">түрлендіру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17462_648335_2201524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SSIS data flow component that loads data into data stores or creates in-memory datasets.</descrip></descripGrp><ntig><termGrp><term id="648335">destination</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2201524">тағайындау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17463_648336_2218641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An SSIS source that reads raw data from a file.</descrip></descripGrp><ntig><termGrp><term id="648336">Raw File source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2218641">Өңделмеген файл көзі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17464_648338_2218601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An SSIS destination that writes raw data to a file.</descrip></descripGrp><ntig><termGrp><term id="648338">Raw File destination</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2218601">Өңделмеген файл тағайындалуы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17465_648455_719992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Conditions that users specify to limit which records are included in the result set of a query.</descrip></descripGrp><ntig><termGrp><term id="648455">filter criteria</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="719992">Сүзгі шарттары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17466_648456_719993"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Exchange Server 2007 connector that uses a Drop directory on a Hub Transport server to send messages to a local messaging server that doesn't use the Simple Mail Transfer Protocol (SMTP) as its primary transport mechanism.</descrip></descripGrp><ntig><termGrp><term id="648456">Foreign connector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="719993">Сыртқы қосқыш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17467_648457_719994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An import of all data from a file, or a scoped view, of a connected data source to the connector space. Data from the connected data source is compared with data in the connector space. If there are no attribute changes, the object is not changed in the connector space.</descrip></descripGrp><ntig><termGrp><term id="648457">full import</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="719994">толық импорт</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17468_648458_1253374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Exchange Server user interface, the main tab on the properties page.</descrip></descripGrp><ntig><termGrp><term id="648458">General tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1253374">Жалпы қойыншасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17469_648459_1491516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Exchange Server 2007, a journal rule that processes all email messages that pass through a Hub Transport server. This includes email messages that were already processed by the external and internal rules.</descrip></descripGrp><ntig><termGrp><term id="648459">global rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1491516">глобалдық ереже</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1747_38372_2195972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special initialization function that is called automatically whenever an instance of a class is declared. This function prevents errors that result from the use of uninitialized objects. The constructor must have the same name as the class itself and must not return a value.</descrip></descripGrp><ntig><termGrp><term id="38372">constructor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2195972">құрастырғыш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17471_648468_1490919"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Exchange Server 2007, the feature that the Exchange administrator configures to enable functionality provided by IP Allow List Provider services that compile lists of IP addresses that are known not to have sent spam in the past. The Connection Filter agent queries the service to determine if a given IP address is "safe."</descrip></descripGrp><ntig><termGrp><term id="648468">IP Allow List provider</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1490919">IP рұқсат тізімін қамтамасыз етуші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17472_648469_1490920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Configuration that is used by the Connection Filter agent to query an IP Allow List provider.</descrip></descripGrp><ntig><termGrp><term id="648469">IP Allow List provider configuration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1490920">IP рұқсат тізімін қамтамасыз етуші конфигурациясы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17473_648470_1490921"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business that compiles and distributes lists of IP addresses that are known not to have sent spam in the past.</descrip></descripGrp><ntig><termGrp><term id="648470">IP Allow List provider service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1490921">IP рұқсат тізімін қамтамасыз етуші қызметі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17474_648471_1490922"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Exchange Server 2007, the feature that the Exchange administrator configures to enable functionality provided by IP Block List Provider services that compile lists of IP addresses from which spam has originated in the past.</descrip></descripGrp><ntig><termGrp><term id="648471">IP Block List provider</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></