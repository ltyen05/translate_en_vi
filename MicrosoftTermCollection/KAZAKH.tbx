rip></descripGrp><ntig><termGrp><term id="767327">cryptographic agility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779258">криптографиялық икемділік</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21212_767328_779258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of software to support customer-preferred algorithms for encryption, hashing, entropy and digital signatures.</descrip></descripGrp><ntig><termGrp><term id="767328">crypto agility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779258">криптографиялық икемділік</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21213_767329_779262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portion of InfoPath used to design forms.</descrip></descripGrp><ntig><termGrp><term id="767329">Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779262">құрастырғыш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21215_767331_1131596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove a file from the Microsoft Office Document Cache without deleting it on the server.</descrip></descripGrp><ntig><termGrp><term id="767331">discard</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1131596">алып тастау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21217_767333_1131597"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove a user's changes from the Microsoft Office Document Cache without deleting the file on the server or removing the latest version downloaded from the server from the Office Document Cache.</descrip></descripGrp><ntig><termGrp><term id="767333">discard changes</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1131597">өзгерістерді алып тастау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21227_767357_1040640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security feature that validates files before allowing them to be loaded by the application, in order to protect against file format vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="767357">Office File Validation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1040640">Office файлдарын тексеру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21231_767406_779502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool in Microsoft Office Groove that helps users to organize, conduct, and record meetings.</descrip></descripGrp><ntig><termGrp><term id="767406">Groove Meetings Tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779502">Groove кездесулерімен жұмыс жасау құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21233_767408_779503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that lets the user mark important dates and build collaborative schedules with other members of a workspace.</descrip></descripGrp><ntig><termGrp><term id="767408">Groove Calendar Tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779503">Groove күнтізбесімен жұмыс жасау құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2124_233438_1142643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scorecard system that adheres to the framework 