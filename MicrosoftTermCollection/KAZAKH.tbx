admin center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2840790">Power Platform басқару орталығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49850_2819348_2824908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that allows users to configure a filter list to use metadata tree view hierarchies and set filter controls to improve navigation and filtering of the list items.</descrip></descripGrp><ntig><termGrp><term id="2819348">metadata navigation filtering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2824908">метадеректерді шарлау және сүзгілеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49850_2819349_2824908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that allows users to configure a filter list to use metadata tree view hierarchies and set filter controls to improve navigation and filtering of the list items.</descrip></descripGrp><ntig><termGrp><term id="2819349">metadata navigation and filtering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2824908">метадеректерді шарлау және сүзгілеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49851_2819360_2824907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that enables users to dynamically filter and find content in lists and libraries by using a navigation hierarchy tree control to apply different metadata-based filters to the view.</descrip></descripGrp><ntig><termGrp><term id="2819360">metadata navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2824907">метадеректерді шарлау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49852_2819372_2824896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The type of web part, for example, Search box web part or Content Editor web part.</descrip></descripGrp><ntig><termGrp><term id="2819372">webpart type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2824896">веб-бөлік түрі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49853_2819381_2822402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The execution of arbitrary commands or code on a target machine or in a target process.</descrip></descripGrp><ntig><termGrp><term id="2819381">arbitrary code execution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2822402">ACE</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49853_2819381_2822420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The execution of arbitrary commands or code on a target machine or in a target process.</descrip></descripGrp><ntig><termGrp><term id="2819381">arbitrary code execution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2822420">еркін кодты орындау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49853_2819385_2822402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The execution of arbitrary commands or code on a target machine or in a target process.</descrip></descripGrp><ntig><termGrp><term id="2819385">ACE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2822402">ACE</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49853_2819385_2822420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The execution of arbitrary commands or code on a target machine or in a target process.</descrip></descripGrp><ntig><termGrp><term id="2819385">ACE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2822420">еркін кодты орындау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49854_2819397_2825364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">a set of entities and the relationships between the entities</descrip></descripGrp><ntig><termGrp><term id="2819397">entity schema</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2825364">нысандар схемасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49855_2819402_2823069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In OAuth authentication, a token that is used by the Consumer to ask the User to authorize access to the Protected Resources. The User-authorized Request Token is exchanged for an Access Token, MUST only be used once, and MUST NOT be used for any other purpose. It is RECOMMENDED that Request Tokens have a limited lifetime.</descrip></descripGrp><ntig><termGrp><term id="2819402">request token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2823069">сұрау таңбалауышы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49856_2819416_2824595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common cache source that can be accessed by multiple processes and machines.</descrip></descripGrp><ntig><termGrp><term id="2819416">shared cache</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2824595">ортақ кэш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49857_2819428_2824593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of users based on Azure AD attributes (such as location or department), or shared resources such as SharePoint sites. For example, you can have the segment "corporate advisory" and have "corporate advisory users" and "corporate advisory sites." In some cases, users in one segment may not be allowed to discover or communicate with users in another segment.</descrip></descripGrp><ntig><termGrp><term id="2819428">segment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2824593">сегмент</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49858_2819429_2823078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in M365 admin center, which provides data, insights and recommendations related to optimization of devices, software, and other technology in your organization.</descrip></descripGrp><ntig><termGrp><term id="2819429">technology experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2823078">технологиялық тәжірибе</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49858_2819429_2834794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in M365 admin center, which provides data, insights and recommendations related to optimization of devices, software, and other technology in your organization.</descrip></descripGrp><ntig><termGrp><term id="2819429">technology experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2834794">Технологиялық тәжірибе</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49858_2831275_2823078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in M365 admin center, which provides data, insights and recommendations related to optimization of devices, software, and other technology in your organization.</descrip></descripGrp><ntig><termGrp><term id="2831275">Technology experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2823078">технологиялық тәжірибе</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49858_2831275_2834794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in M365 admin center, which provides data, insights and recommendations related to optimization of devices, software, and other technology in your organization.</descrip></descripGrp><ntig><termGrp><term id="2831275">Technology experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2834794">Технологиялық тәжірибе</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49859_2819431_2824966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">MMD device profile that provides local administrator privileges for users who need more control of their issued devices.</descrip></descripGrp><ntig><termGrp><term id="2819431">Privileged access device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2824966">Артықшылығы бар қатынасу рұқсаты берілген құрылғы профилі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4986_37166_1250070"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device capable of processing information, storing data, and producing a desired result based on instructions provided.</descrip></descripGrp><ntig><termGrp><term id="37166">computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250070">компьютер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49860_2819434_2824964"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The MMD device profile that offers the greatest power to the local user (ability to install apps, etc.). Intended for use typically by developers, field engineers, etc.</descrip></descripGrp><ntig><termGrp><term id="2819434">Power user device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2824964">Тәжірибелі пайдаланушыға арналған құрылғы профилі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49861_2819436_2824975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The MMD device profile that is more &amp;quot;locked down&amp;quot; to preserve the security of sensitive data. Intended for handling sensitive data such as medical records.</descrip></descripGrp><ntig><termGrp><term id="2819436">Sensitive data device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2824975">Құпия деректері бар құрылғы профилі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49862_2819437_2824600"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The MMD device profile that has the most balance of user privileges and data security--expected to be the most common profile and used by typical information workers.</descrip></descripGrp><ntig><termGrp><term id="2819437">Standard device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2824600">Стандартты құрылғы профилі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49863_2911838_2912364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft Managed Desktop device profile optimized for use by frontline workers. Limited power for the user; intended for scenarios with multiple users sharing the same device, such as at a nurses' station. Likely to be operating under the F1 license.</descrip></descripGrp><ntig><termGrp><term id="2911838">frontline device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="291236