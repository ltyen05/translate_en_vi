o</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2469362">360 градустық бейне</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43714_2466503_2469365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The branded spatial sound format that Microsoft is offering ​for headphones.</descrip></descripGrp><ntig><termGrp><term id="2466503">Windows Sonic for Headphones</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2469365">Құлаққаптарға арналған Windows Sonic</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43715_2466516_2476618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for use of the PowerApps platform that includes Microsoft Flow.</descrip></descripGrp><ntig><termGrp><term id="2466516">PowerApps and Logic flows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2476618">PowerApps және логикалық ағындар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43717_2466997_2470470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 designed for small and medium businesses that includes the features of Windows 10 Pro, plus additional management policies that can be helpful to business customers. This edition is only available through subscription as part of a larger package of services, and is not available as a standalone download.</descrip></descripGrp><ntig><termGrp><term id="2466997">Windows 10 Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2470470">Windows 10 Business</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43721_2467020_2681812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Central Canadian region, located in Toronto, within the Azure region taxonomy.</descrip></descripGrp><ntig><termGrp><term id="2467020">CA Central</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2681812">Орталық Канада</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43721_2650472_2681812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Central Canadian region, located in Toronto, within the Azure region taxonomy.</descrip></descripGrp><ntig><termGrp><term id="2650472">Canada Central</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote 