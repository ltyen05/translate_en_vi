Text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626086">автомәтін</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49180_2785672_2787023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Data Investigations tab where admins can add and manage the people that they identified as persons of interest during an investigation.</descrip></descripGrp><ntig><termGrp><term id="2785672">People of interest</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2787023">Қызықтыратын адамдар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49181_2785680_2789531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A PowerApps app that is designed by adding and configuring the components you need (such as dashboards, views, charts, and forms) using the app designer, without requiring any coding.</descrip></descripGrp><ntig><termGrp><term id="2785680">model-driven app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2789531">модельге негізделген бағдарлама</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote typ