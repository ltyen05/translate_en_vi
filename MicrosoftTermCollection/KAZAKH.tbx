<termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2861312">контентті түсіну</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50521_2860780_2861322"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Shadow Stack security feature that prevents a class of vulnerabilities known as Return-Oriented Programming (ROP) and requires hardware in order to work.</descrip></descripGrp><ntig><termGrp><term id="2860780">hardware-enforced stack protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2861322">жабдықпен қамтамасыз етілген стекті қорғау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50521_2860780_3020381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Shadow Stack security feature that prevents a class of vulnerabilities known as Return-Oriented Programming (ROP) and requires hardware in order to work.</descrip></descripGrp><ntig><termGrp><term id="2860780">hardware-enforced stack protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3020381">HSP</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50521_3019770_2861322"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Shadow Stack security feature that prevents a class of vulnerabilities known as Return-Oriented Programming (ROP) and requires hardware in order to work.</descrip></descripGrp><ntig><termGrp><term id="3019770">HSP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2861322">жабдықпен қамтамасыз етілген стекті қорғау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50521_3019770_3020381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Shadow Stack security feature that prevents a class of vulnerabilities known as Return-Oriented Programming (ROP) and requires hardware in order to work.</descrip></descripGrp><ntig><termGrp><term id="3019770">HSP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3020381">HSP</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50524_2861024_2862295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power Mixed Reality feature that allows users to place a 3D object of a specific size into the AR environment around them.</descrip></descripGrp><ntig><termGrp><term id="2861024">AR Cube</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2862295">ТШ текшесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50525_2861025_2862297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Combining nearby pins together to form one new cluster pin, usually with a number of pins provided, to indicate the density of locations for a certain zoom level on the map.</descrip></descripGrp><ntig><termGrp><term id="2861025">pin clustering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2862297">белгіні кластерлеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50526_2861026_2862296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pins combined together on the map to form one new cluster pin, instead of showing a bunch of individual pins on top of each other, to indicate the density of locations for a certain zoom level.</descrip></descripGrp><ntig><termGrp><term id="2861026">cluster pin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2862296">кластер белгісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50527_2861027_2862298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The function of tilting the pitch to the map relative to the horizon.</descrip></descripGrp><ntig><termGrp><term id="2861027">pitch control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2862298">қадамды басқару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50531_2861482_2866827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To extract data from another service.</descrip></descripGrp><ntig><termGrp><term id="2861482">scrape</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2866827">шығарып алу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50536_2861588_2866828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft legal document that governs the customer’s use of the Online Services.</descrip></descripGrp><ntig><termGrp><term id="2861588">Online Services Terms</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2866828">Онлайн қызметтерді пайдалану шарттары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><te