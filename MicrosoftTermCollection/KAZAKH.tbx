his includes space (" "), newline (carriage return in combination with line feed), and the tab character.</descrip></descripGrp><ntig><termGrp><term id="629775">white-space character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="719959">Бос орын таңбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14155_233476_305337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of artificially delaying server responses for specific SMTP communication patterns that indicate high volumes of spam or other unwelcome email messages. The intent is to slow down the communication process for such email traffic so that the cost of sending spam increases for the person or organization who is sending the email.</descrip></descripGrp><ntig><termGrp><term id="233476">tarpitting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="305337">Сервер жауаптарын арнайы ақырындату</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14157_374307_615597"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The variable-length data type with a maximum of 8,000 ANSI characters.</descrip></descripGrp><ntig><termGrp><term id="374307">varchar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><la