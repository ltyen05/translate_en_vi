et></termEntry><termEntry id="9809_475785_2093960"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program for licensed Office software that provides access to updates, value-added downloads, free software trials, and special promotions.</descrip></descripGrp><ntig><termGrp><term id="475785">Office Genuine Advantage</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093960">Office Genuine Advantage бағдарламасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9809_475786_2093960"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program for licensed Office software that provides access to updates, value-added downloads, free software trials, and special promotions.</descrip></descripGrp><ntig><termGrp><term id="475786">OGA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093960">Office Genuine Advantage бағдарламасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9818_178782_638271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account status indicating that payments are late or not yet received.</descrip></descripGrp><ntig><termGrp><term id="178782">overdue</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="638271">кешіктірілген</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9819_559848_2220149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collation for an instance of SQL Server.</descrip></descripGrp><ntig><termGrp><term id="559848">server collation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2220149">сервер сұрыптау параметрлері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9820_2727454_627440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory or folder made available to users over the network.</descrip></descripGrp><ntig><termGrp><term id="2727454">file share</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627440">ортақ қор көзі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9820_298002_627440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory or folder made available to users over the network.</descrip></descripGrp><ntig><termGrp><term id="298002">share</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627440">ортақ қор көзі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9825_331779_1145180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An edition of Microsoft project management software used to plan, manage, and communicate a project schedule and other information among workgroup members, project managers, and other stakeholders.</descrip></descripGrp><ntig><termGrp><term id="331779">Microsoft® Office Project Standard 2007</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1145180">Microsoft® Office Project Standard 2007</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9828_558613_757847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who takes part in an online interaction such as conference call or meeting.</descrip></descripGrp><ntig><termGrp><term id="558613">participant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="757847">қатысушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9830_13827_1301529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An activity represented by a time interval that has a start time, an end time, and a duration.</descrip></descripGrp><ntig><termGrp><term id="13827">appointment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1301529">кездесу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9831_235026_627701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of confirming that data passing into the system is correct and complies with predefined rules, definitions, or parameters.</descrip></descripGrp><ntig><termGrp><term id="235026">validation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627701">тексерім</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9837_23010_626151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The partition that contains the Windows operating system and its support files. The boot partition can be, but does not have to be, the same as the system partition.</descrip></descripGrp><ntig><termGrp><term id="23010">boot partition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626151">бастау бөлімі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9839_503120_1839166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standardized service agreement between a user and a mobile operator that establishes data service details such as pricing, types of services, and bandwidth.</descrip></descripGrp><ntig><termGrp><term id="503120">data plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1839166">деректер жоспары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9843_54256_2911076"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of computer files on networks, wherein files are stored on a central computer or a server and are requested, reviewed, and modified by more than one individual. When a file is used with different programs or different computers, file sharing can require conversion to a mutually acceptable format. When a single file is shared by many people, access can be regulated through such means as password protection, security clearances, or file locking to prohibit changes to a file by more than one person at a time.</descrip></descripGrp><ntig><termGrp><term id="54256">file sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2911076">файлды бөлісу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9846_23701_2093961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A temporary suspension of program execution while in the development environment. In break mode, you can examine, debug, reset, step through, or continue program execution.</descrip></descripGrp><ntig><termGrp><term id="23701">break mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093961">ұзіліс режимі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9847_178880_638293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The form used to store business information (e.g. open activities, activity history, linked records).</descrip></descripGrp><ntig><termGrp><term id="178880">record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="638293">жазба</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9849_20127_626112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the printing and display of characters on the screen, an imaginary horizontal line with which the base of each character, excluding descenders, is aligned.</descrip></descripGrp><ntig><termGrp><term id="20127">base line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626112">тірек бағыттауыш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9849_20128_626112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the printing and display of characters on the screen, an imaginary horizontal line with which the base of each character, excluding descenders, is aligned.</descrip></descripGrp><ntig><termGrp><term id="20128">baseline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626112">тірек бағыттауыш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="985_226537_639484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection, storing, and sharing of information in a single system where many users can access it.</descrip></descripGrp><ntig><termGrp><term id="226537">content management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="639484">мазмұнды басқару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9856_307429_407567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of time that can elapse before the Exchange server asks a mobile device running Exchange ActiveSync to connect again.</descrip></descripGrp><ntig><termGrp><term id="307429">heartbeat interval</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407567">тактілік аралық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9864_81318_2093962"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mathematical or graphical representation of a real-world situation or object. For example, a mathematical model of the distribution of matter in the universe, a spreadsheet (numeric) model of business operations, or a graphical model of a molecule.</descrip></descripGrp><ntig><termGrp><term id="81318">model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093962">модель</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9865_145487_1250133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component database architecture that provides efficient network and Internet access to many types of data sources, including relational data, mail files, flat files, and spreadsheets. OLE DB comprises a specialized set of COM interfaces that expose data from a variety of data stores, both relational and nonrelational.</descrip></descripGrp><ntig><termGrp><term id="145487">OLE DB</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250133">OLE DB</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9865_145487_2442773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component database architecture that provides efficient network and Internet access to many types of data sources, including relational data, mail files, flat files, and spreadsheets. OLE DB comprises a specialized set of COM interfaces that expose data from a variety of data stores, both relational and nonrelational.</descrip></descripGrp><ntig><termGrp><term id="145487">OLE DB</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2442773">OLEDB</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9865_2072504_1250133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component database architecture that provides efficient network and Internet access to many types of data sources, including relational data, mail files, flat files, and spreadsheets. OLE DB comprises a specialized set of COM interfaces that expose data from a variety of data stores, both relational and nonrelational.</descrip></descripGrp><ntig><termGrp><term id="2072504">Object Linking and Embedding Database</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250133">OLE DB</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9865_2072504_2442773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component database architecture that provides efficient network and Internet access to many types of data sources, including relational data, mail files, flat files, and spreadsheets. OLE DB comprises a specialized set of COM interfaces that expose data from a variety of data stores, both relational and nonrelational.</descrip></descripGrp><ntig><termGrp><term id="2072504">Object Linking and Embedding Database</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2442773">OLEDB</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9865_2440377_1250133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component database architecture that provides efficient network and Internet access to many types of data sources, including relational data, mail files, flat files, and spreadsheets. OLE DB comprises a specialized set of COM interfaces that expose data from a variety of data stores, both relational and nonrelational.</descrip></descripGrp><ntig><termGrp><term id="2440377">OLEDB</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><te