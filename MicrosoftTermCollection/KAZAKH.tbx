ot have a valid client certificate installed.</descrip></descripGrp><ntig><termGrp><term id="2343551">unmanaged device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2389188">басқарылмайтын құрылғы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40291_2343552_2389164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove access to your cloud service environment.</descrip></descripGrp><ntig><termGrp><term id="2343552">suspend</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2389164">блоктау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40292_2343553_2389190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reinstate access to your cloud service environment.</descrip></descripGrp><ntig><termGrp><term id="2343553">unsuspend</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2389190">блоктан шығару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40293_2343554_2389143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An in-line deployment mode that provides ultimate control over user activities and data in motion, but requires traffic routing through the Adallom cloud.</descrip></descripGrp><ntig><termGrp><term id="2343554">SmartProxy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2389143">SmartProxy</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40294_2343730_2344727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short video clip that can be downloaded from Skype in a package of similar video clips, and can be inserted into a chat conversation.​</descrip></descripGrp><ntig><termGrp><term id="2343730">Moji</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2344727">Moji</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40297_2343749_2388737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An out-of-band, non-intrusive deployment mode that integrates directly into the framework of enterprise cloud applications, taking only a few minutes per application to set up.</descrip></descripGrp><ntig><termGrp><term id="2343749">API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2388737