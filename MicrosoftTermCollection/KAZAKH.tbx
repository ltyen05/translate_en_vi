ed around relationships among topics, content, and people.</descrip></descripGrp><ntig><termGrp><term id="2887244">Project Cortex</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2888094">Project Cortex</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51164_2887245_2888095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The line an error gets underscored with in apps like Word or Outlook during spell check.</descrip></descripGrp><ntig><termGrp><term id="2887245">squiggle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2888095">тильда</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51165_2887246_2888088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To orchestrate a collaboration session.</descrip></descripGrp><ntig><termGrp><term id="2887246">host</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2888088">ұйымдастыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51166_2887247_2888089"><l