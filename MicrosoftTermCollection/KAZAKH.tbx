32_2407115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request from one employee to have another employee take a shift from him/her.</descrip></descripGrp><ntig><termGrp><term id="2400532">shift offer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2407115">ауысымды ұсыну</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42429_2400543_2407122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request from one employee to another to trade shifts with each other.</descrip></descripGrp><ntig><termGrp><term id="2400543">shift swap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2407122">Ауысыммен алмасу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42430_2400558_2407126"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The StaffHub view where users can ask another employee to do a shift swap with them.</descrip></descripGrp><ntig><termGrp><term id="2400558">Swap my shift</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2407126">Ауысымыммен алмасу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGen