"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that is inserted in right-to-left and mixed text to specify the formatting of text when the inherent directionality of the text is insufficient to display expected results.</descrip></descripGrp><ntig><termGrp><term id="139513">control character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101570">басқарушы таңба</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16077_530248_2201505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To introduce redundancy into a table to incorporate data from a related table.</descrip></descripGrp><ntig><termGrp><term id="530248">denormalize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2201505">денормализациялау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1608_264787_615724"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list view toolbar type in the toolbar picker, that shows an abbreviated version of a full toolbar.</descrip></descripGrp><ntig><termGrp><term id="264787">Summary toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615724">құралдардың қысқаша тақтасы</term><termNote type=