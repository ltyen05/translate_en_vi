erm><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3084032">Microsoft Surface Laptop 5</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54084_3083988_3084116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The next-generation Surface Pro.</descrip></descripGrp><ntig><termGrp><term id="3083988">Microsoft Surface Pro 9</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3084116">Microsoft Surface Pro 9</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54085_3083989_3084200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The next-generation Surface Pro with Arm processor.</descrip></descripGrp><ntig><termGrp><term id="3083989">Microsoft Surface Pro 9 with 5G</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3084200">Microsoft Surface Pro 9 with 5G</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54086_3083990_3084284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Surface Studio computer with 11th generation Intel processor.</descrip></descripGrp><ntig><termGrp><term id="3083990">Microsoft Surface Studio 2+</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3084284">Microsoft Surface Studio 2+</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5409_527644_2176950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object whose surface contains faces, each of which is described by a simple polygon.</descrip></descripGrp><ntig><termGrp><term id="527644">mesh</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2176950">тор</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54097_3090777_3090837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data model that empowers organizations to unify, store and prepare water measurement data from their facilities into a single data model to help meet water sustainability goals.</descrip></descripGrp><ntig><termGrp><term id="3090777">water data model</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3090837">судың деректер үлгісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54102_3090778_3090798"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Emission of gases, mainly carbon dioxide from the combustion of fossil fuels: coal, oil and natural gas, that contribute to the greenhouse effect and, consequently, to the climate change of our planet.</descrip></descripGrp><ntig><termGrp><term id="3090778">GHG emission</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3090798">ПГ эмиссиясы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54104_3085781_3086381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales feature powered by an AI model that scans your emails and meetings in Outlook and finds items that might be related to your work in Dynamics 365. Activity suggestions can be synced and connected to contacts, accounts, leads, or opportunities.</descrip></descripGrp><ntig><termGrp><term id="3085781">activity suggestion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3086381">әрекет ұсынысы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54105_3085782_3086382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-generated summary of a customer conversation.</descrip></descripGrp><ntig><termGrp><term id="3085782">AI summary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3086382">AI жиынтық мәліметтері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54106_3085783_3086383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule created and activated for leads and opportunities by defining conditions to automatically assign records to sellers when the defined conditions are met in Dynamics 365 Sales.</descrip></descripGrp><ntig><termGrp><term id="3085783">assignment rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3086383">тағайындау ережесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54107_3085784_3086384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Conversation Intelligence insight that shows the keywords that the top sellers use more frequently in conversations with customers. By analyzing this insight, you can understand what words the top sellers use that help them to close deals and generate revenue.</descrip></descripGrp><ntig><termGrp><term id="3085784">Best practice keywords</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3086384">үздік тәжірибе кілтсөздері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54108_3085785_3086385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales page that provides a high-level view of how the conversation with a customer went, and includes action items and relevant keywords, a timeline, a transcript of the call, and more.</descrip></descripGrp><ntig><termGrp><term id="3085785">call summary</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3086385">қоңыраулар жиынтығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54109_3085786_3086386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales capability that enables the suggested contacts to be displayed in Teams when a seller starts a new connected chat. It helps the sellers to quickly find the right coworkers to collaborate with.</descrip></descripGrp><ntig><termGrp><term id="3085786">contact suggestion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3086386">контакт ұсынысы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54110_3085787_3086387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of Sales Accelerator that uses the AI-based model that flags duplicate leads based on standard rules. Sellers can choose to merge duplicate leads to the primary record or delete the duplicate leads ensuring the sellers always have the right leads with the right information.</descrip></descripGrp><ntig><termGrp><term id="3085787">Data Hygiene</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3086387">деректерді сұрыптау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54111_3085788_3086388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dedicated workspace in Dynamics 365 Sales for sellers to efficiently manage their sales pipeline. As a seller, you can personalize the workspace for your needs.</descrip></descripGrp><ntig><termGrp><term id="3085788">deal manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3086388">мәмілелер менеджері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54112_3085789_3086389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A ratio of the number of emails sent and received in a given opportunity, to the average sent and received ratio in all similar won deals.</descrip></descripGrp><ntig><termGrp><term id="3085789">email send/receive ratio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3086389">электрондық хабар жіберу/алу арақатынасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54113_3085790_3086390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A model that analyzes patterns in historical data that users provide and learns to associate those patterns with outcomes. Then, it uses the power of AI to detect learned patterns in new data, and use them to predict future outcomes.</descrip></descripGrp><ntig><termGrp><term id="3085790">prediction model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3086390">болжам үлгісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54114_3085791_3086391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows sellers to record calls by using the Teams dialer and get the most out of every call with advanced conversation intelligence capabilities such as AI-powered insights, rich call summaries, and more.</descrip></descripGrp><ntig><termGrp><term id="3085791">real-time transcription and insights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3086391">нақты уақыттағы транскрипция және мәліметтер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54115_3085792_3086392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data point that is associated with a lower than average probability of converting the lead into an opportunity.</descrip></descripGrp><ntig><termGrp><term id="3085792">score harmer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3086392">ұпай түсіргіш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54116_3085793_3086393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data point that is associated with a higher than average probability of converting the lead into an opportunity.</descrip></descripGrp><ntig><termGrp><term id="3085793">score improver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3086393">ұпай жақсартқыш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54117_3085794_3086394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that helps you to be more productive and get work done effectively by calling customers directly from within the Dynamics 365 Sales Hub app. You can make and receive calls through Teams.</descrip></descripGrp><ntig><termGrp><term id="3085794">Teams Dialer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3086394">Teams теру құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54118_3085795_3086395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A seller selected as having the best performance based on the amount of leads they qualified or opportunities they won.</descrip></descripGrp><ntig><termGrp><term id="3085795">top performer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3086395">үздік орындаушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54126_3086101_3086744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The add-on that offers 200 GB cloud storage for Microsoft 365 Personal and Family Subscribers.</descrip></descripGrp><ntig><termGrp><term id="3086101">+200 GB Microsoft Storage</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3086744">+200 Гбайт Microsoft сақтау орны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="g