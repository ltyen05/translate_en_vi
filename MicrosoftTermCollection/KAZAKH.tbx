ibility Wizard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="625941">арнайы мүмкіндіктер шебері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10095_339958_1839292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status message displayed when the caller ID of an incoming call is blocked.</descrip></descripGrp><ntig><termGrp><term id="339958">Private</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1839292">Жеке</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10097_331775_615075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A suite of Microsoft productivity software that supports common business tasks, including word processing, email, presentations, and data management and analysis.</descrip></descripGrp><ntig><termGrp><term id="331775">Microsoft® Office Professional 2007</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615075">Microsoft® Office Professional 2007 (қазақша нұсқасы)</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumbe