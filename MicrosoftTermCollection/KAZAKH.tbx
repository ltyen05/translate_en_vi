><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25542_1177000_2105085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email program originally introduced by cc:mail, Inc., and currently produced by the Lotus Development Corporation. Lotus cc:Mail runs on multiple networking platforms and the Internet and is closely integrated with Lotus Notes collaborative software.</descrip></descripGrp><ntig><termGrp><term id="1177000">Lotus cc:Mail</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2105085">cc:Mail</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25542_1177001_2105085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email program originally introduced by cc:mail, Inc., and currently produced by the Lotus Development Corporation. Lotus cc:Mail runs on multiple networking platforms and the Internet and is closely integrated with Lotus Notes collaborative software.</descrip></descripGrp><ntig><termGrp><term id="1177001">cc:Mail</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2105085">cc:Mail</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25558_1177032_2201973"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The grouping of users, objects, and permissions that is used by DPM administrators to manage DPM features that are used by end users.</descrip></descripGrp><ntig><termGrp><term id="1177032">DPM role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2201973">DPM рөлі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25559_1177033_2202019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software provided with DPM to facilitate a Windows Server 2003 bare metal recovery for the DPM server and the computers that DPM protects.</descrip></descripGrp><ntig><termGrp><term id="1177033">DPM System Recovery Tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202019">DPM SRT</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25559_1177033_2202041"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software provided with DPM to facilitate a Windows Server 2003 bare metal recovery for the DPM server and the computers that DPM protects.</descrip></descripGrp><ntig><termGrp><term id="1177033">DPM System Recovery Tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202041">DPM System Recovery Tool</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25559_1177034_2202019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software provided with DPM to facilitate a Windows Server 2003 bare metal recovery for the DPM server and the computers that DPM protects.</descrip></descripGrp><ntig><termGrp><term id="1177034">DPM SRT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202019">DPM SRT</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25559_1177034_2202041"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software provided with DPM to facilitate a Windows Server 2003 bare metal recovery for the DPM server and the computers that DPM protects.</descrip></descripGrp><ntig><termGrp><term id="1177034">DPM SRT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202041">DPM System Recovery Tool</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25560_1177035_2175869"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that automatically runs a consistency check on protected data sources when it detects an inconsistent replica.</descrip></descripGrp><ntig><termGrp><term id="1177035">auto-consistency check</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2175869">үйлесімділікті автоматты түрде тексеру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25561_1177036_2176011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In DPM, a feature that automatically identifies and adds new data sources for protection.</descrip></descripGrp><ntig><termGrp><term id="1177036">auto-protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2176011">автоматты түрде қорғау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25562_1177037_2199871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In DPM, a feature that enables protection of multiple data sources on a single volume or on the same tape. This allows you to store more data on each volume or tape.</descrip></descripGrp><ntig><termGrp><term id="1177037">data co-location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2199871">деректердің бірге орналасуы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25563_1177038_2201955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy-driven engine that DPM uses to protect and recover data.</descrip></descripGrp><ntig><termGrp><term id="1177038">DPM engine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2201955">DPM құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25564_1177040_2205835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data source that has been backed up on the DPM server but is no longer being actively protected.</descrip></descripGrp><ntig><termGrp><term id="1177040">inactive data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2205835">белсенді емес деректер көзі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25565_1177041_2217195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of protection in which data on the protected server is directly protected by a primary DPM Server.</descrip></descripGrp><ntig><termGrp><term id="1177041">primary protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2217195">негізгі қорғау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25566_1177042_2220106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of protection in which data on the protected server is protected by a primary DPM server and the replica on the primary DPM server is protected by a secondary DPM server.</descrip></descripGrp><ntig><termGrp><term id="1177042">secondary protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2220106">қосымша қорғау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25567_1177043_2221067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of protection that enables DPM to automatically identify and protect databases that are added to instances of SQL Server that are configured for auto-protection.</descrip></descripGrp><ntig><termGrp><term id="1177043">SQL Server instance auto-protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221067">SQL Server данасын автоматты түрде қорғау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25568_1245013_2202014"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool for SQL Server that enables backup administrators to authorize end users to recover backups of SQL Server databases from DPM, without further action from the backup administrator.</descrip></descripGrp><ntig><termGrp><term id="1245013">DPM Self-Service Tool for SQL Server</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202014">SQL Server үшін DPM өздігінше қызмет ету құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25568_1245014_2202014"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool for SQL Server that enables backup administrators to authorize end users to recover backups of SQL Server databases from DPM, without further action from the backup administrator.</descrip></descripGrp><ntig><termGrp><term id="1245014">DPM SST for SQL Server</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202014">SQL Server үшін DPM өздігінше қызмет ету құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2557_535210_2207600"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A defined set of properties, methods, and collections that form a logical grouping of behaviors and data.</descrip></descripGrp><ntig><termGrp><term id="535210">interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2207600">интерфейс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25575_1177084_1984900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A legal doctrine that is intended to protect the confidentiality of communications between an attorney and his or her client. The underlying rationale is that by assuring confidential communications, lawyers and their clients will feel free to discuss sensitive legal matters thoroughly.</descrip></descripGrp><ntig><termGrp><term id="1177084">attorney-client privilege</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1984900">адвокаттық құпия</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25576_1177085_1984733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that corresponds to the "Then" part of a rule (If-Then) and is used to specify what is to be done when a condition evaluates as true.</descrip></descripGrp><ntig><termGrp><term id="1177085">action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1984733">әрекет</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25577_1177086_1782098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specific word or phrase that is specified on the basis of an organization's messaging policy and used in keyword filtering (content filtering) to identify and prevent unwanted email messages from being delivered to users in the organization.</descrip></descripGrp><ntig><termGrp><term id="1177086">bad word</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1782098">балағат сөз</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25578_1177087_1985288"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The runspace on the datacenter (host) server, which contains the commands used by the remote user in a client-side session.</descrip></descripGrp><ntig><termGrp><term id="1177087">server-side session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1985288">cерверлік сеанс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25579_1177088_1984923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows PowerShell session on a user's local computer, which has the basic Windows PowerShell commands available to it.</descrip></descripGrp><ntig><termGrp><term id="1177088">client-side session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1984923">клиенттік сеанс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25582_1177091_1984769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mailbox that has been accessed at least once in the last 30 days.</descrip></descripGrp><ntig><termGrp><term id="1177091">active mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1984769">белсенді пошта жәшігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25583_1177092_1984976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory, database, file, or other data repository that is typically offsite and that needs to be accessed remotely.</descrip></descripGrp><ntig><termGrp><term id="1177092">connected data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1984976">қосылған деректер көзі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1177093_1985159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1177093">Outlook Live Management Agent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1985159">ELMA</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1177093_1985259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1177093">Outlook Live Management Agent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1985259">OLMA</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1177093_1985265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1177093">Outlook Live Management Agent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1985265">Outlook Live Management Agent</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1177245_1985159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1177245">OLMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1985159">ELMA</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1177245_1985259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1177245">OLMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1985259">OLMA</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1177245_1985265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1177245">OLMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1985265">Outlook Live Management Agent</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1354408_1985159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1354408">ELMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1985159">ELMA</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1354408_1985259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1354408">ELMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1985259">OLMA</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1354408_1985265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1354408">ELMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1985265">Outlook Live Management Agent</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25585_1177094_1985154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who has a business need to search the mailboxes in their organization for email and other message types that contain specific keywords.</descrip></descripGrp><ntig><termGrp><term id="1177094">discovery manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1985154">іздеу менеджері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25587_1177096_2195767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer operation in which two or more processes (programs) have access to the microprocessor's time and are therefore carried out nearly simultaneously. Because a microprocessor can work with much smaller units of time than people can perceive, concurrent processes appear to be occurring simultaneously but in reality are not.</descrip></descripGrp><ntig><termGrp><term id="1177096">concurrent operation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2195767">параллель операция</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25587_1177097_2195767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer operation in which two or more processes (programs) have access to the microprocessor's time and are therefore carried out nearly simultaneously. Because a microprocessor can work with much smaller units of time than people can perceive, concurrent processes appear to be occurring simultaneously but in reality are not.</descrip></descripGrp><ntig><termGrp><term id="1177097">concurrent processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2195767">параллель операция</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25588_1177100_1985166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">People outside the Outlook Live organization who can be added to public groups and displayed in your organization's address book and other address lists. External contacts have email addresses outside the organization and can't sign in to your domain.</descrip></descripGrp><ntig><termGrp><term id="1177100">external contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1985166">сыртқы контакт</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25589_1177102_1985167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state that a Windows Live ID takes when the user account with which it is associated is deleted from Outlook Live, but the Windows Live ID for the account isn't deleted. The credentials for that Windows Live ID are still valid and recognized, but the Windows Live ID is put into a forced rename state. If someone tries to sign in using that Windows Live ID and its password, they're asked to rename the Windows Live ID. They can rename the Windows Live ID, but because the new email address can't exist in the Outlook Live domain, the Windows Live ID is no longer functional in Outlook Live.</descrip></descripGrp><ntig><termGrp><term id="1177102">forced rename state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1985167">міндетті түрде атын өзгерту күйі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25593_1177108_1782110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Identity Lifecycle Manager (ILM) 2007 object that has been projected into the metaverse from a connector space object and is linked to at least one object in the connector space. A metaverse entry represents the aggregated view of objects from one or several connected data sources.</descrip></descripGrp><ntig><termGrp><term id="1177108">metaverse entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1782110">метаверс элементі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25594_1177109_1985255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of numbers found in the MX server field in the MX Record Configuration section on the Domain Settings page of the Windows Live Admin Center. The MX token value is unique for each domain. It is required to create an MX record or a CNAME record at DNS hosting services.</descrip></descripGrp><ntig><termGrp><term id="1177109">MX token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1985255">MX таңбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25595_1177111_1985264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The address by which a Exchange Server recipient object is recognized in a foreign messaging system. In Outlook Live, proxy addresses let people receive email that is sent to different email addresses.</descrip></descripGrp><ntig><termGrp><term id="1177111">proxy address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1985264">басқа электрондық пошта мекенжайы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25595_1177111_1985275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The address by which a Exchange Server recipient object is recognized in a foreign messaging system. In Outlook Live, proxy addresses let people receive email that is sent to different email addresses.</descrip></descripGrp><ntig><termGrp><term id="1177111">proxy address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1985275">прокси мекенжай</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25595_1218373_1985264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The address by which a Exchange Server recipient object is recognized in a foreign messaging system. In Outlook Live, proxy addresses let people receive email that is sent to different email addresses.</descrip></descripGrp><ntig><termGrp><term id="1218373">other e-mail address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1985264">басқа электрондық пошта мекенжайы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25595_1218373_1985275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The address by which a Exchange Server recipient object is recognized in a foreign messaging system. In Outlook Live, proxy addresses let people receive email that is sent to different email addresses.</descrip></descripGrp><ntig><termGrp><term id="1218373">other e-mail address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1985275">прокси мекенжай</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25597_1177114_1985280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specially-configured domain that defines settings for mail flow based on the destination domain of each email message. Administrators can configure specific settings for a specific destination domain, or configure default settings for all destination domains. In this way, they can control the types of messages that are sent to a domain. They can also apply message format policies and acceptable character sets for messages that are sent from users in their organization to the remote domain.</descrip></descripGrp><ntig><termGrp><term id="1177114">remote domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1985280">қашықтағы домен</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25599_1177116_1782301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Simple Mail Transfer Protocol (SMTP) address space or domain suffix that is shared by two different messaging systems. For example, you may have to share the SMTP address space between Microsoft Exchange and a third-party email system, or between Exchange environments that are configured in different Active Directory forests. In these scenarios, users in each email system have the same domain suffix as part of their email addresses.</descrip></descripGrp><ntig><termGrp><term id="1177116">shared address space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1782301">ортақ мекенжай кеңістігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25599_1177116_1782303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Simple Mail Transfer Protocol (SMTP) address space or domain suffix that is shared by two different messaging systems. For example, you may have to share the SMTP address space between Microsoft Exchange and a third-party email system, or between Exchange environments that are configured in different Active Directory forests. In these scenarios, users in each email system have the same domain suffix as part of their email addresses.</descrip></descripGrp><ntig><termGrp><term id="1177116">shared address space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1782303">бөлінген домен</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25599_1177117_1782301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Simple Mail Transfer Protocol (SMTP) address space or domain suffix that is shared by two different messaging systems. For example, you may have to share the SMTP address space between Microsoft Exchange and a third-party email system, or between Exchange environments that are configured in different Active Directory forests. In these scenarios, users in each email system have the same domain suffix as part of their email addresses.</descrip></descripGrp><ntig><termGrp><term id="1177117">split domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1782301">ортақ мекенжай кеңістігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25599_1177117_1782303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Simple Mail Transfer Protocol (SMTP) address space or domain suffix that is shared by two different messaging systems. For example, you may have to share the SMTP address space between Microsoft Exchange and a third-party email system, or between Exchange environments that are configured in different Active Directory forests. In these scenarios, users in each email system have the same domain suffix as part of their email addresses.</descrip></descripGrp><ntig><termGrp><term id="1177117">split domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1782303">бөлінген домен</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25607_1177137_2200404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person who manages a database. The administrator determines the content, internal structure, and access strategy for a database, defines security and integrity, and monitors performance.</descrip></descripGrp><ntig><termGrp><term id="1177137">database administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2200404">дерекқор әкімшісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25607_1177139_2200404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person who manages a database. The administrator determines the content, internal structure, and access strategy for a database, defines security and integrity, and monitors performance.</descrip></descripGrp><ntig><termGrp><term id="1177139">DBA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2200404">дерекқор әкімшісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25611_1177146_2670079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical card on which a product key is printed.</descrip></descripGrp><ntig><termGrp><term id="1177146">product key card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2670079">PKC</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25611_2667272_2670079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical card on which a product key is printed.</descrip></descripGrp><ntig><termGrp><term id="2667272">PKC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2670079">PKC</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2564_11046_1697390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In operating systems, the process of reserving memory for use by a program.</descrip></descripGrp><ntig><termGrp><term id="11046">allocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1697390">сақтау орнын бөлу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2564_1593445_1697390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In operating systems, the process of reserving memory for use by a program.</descrip></descripGrp><ntig><termGrp><term id="1593445">storage allocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1697390">сақтау орнын бөлу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2564_693442_1697390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In operating systems, the process of reserving memory for use by a program.</descrip></descripGrp><ntig><termGrp><term id="693442">memory allocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1697390">сақтау орнын бөлу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25642_1177250_1301452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of components, for example, entities, attributes, relationships, workflows, and reports, that provide a specific set of functionality on top of the core CRM platform.</descrip></descripGrp><ntig><termGrp><term id="1177250">solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1301452">Шешім</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25644_1177307_2215371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Tools that you can use to evaluate the performance of a solution. Performance tools can have different purposes; some are designed to evaluate end-to-end performance while others focus on evaluating performance of a particular aspect of a solution.</descrip></descripGrp><ntig><termGrp><term id="1177307">performance tools</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215371">өнімділікті бағалау құралдары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25647_1177383_1301428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A complete solution that has been packaged. After this solution has been installed, the extent to which it can be modified is specified by the publisher.</descrip></descripGrp><ntig><termGrp><term id="1177383">managed solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1301428">Басқарылатын шешім</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25648_1177384_1301438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solution to which a component belongs to. A component can have only one parent solution.</descrip></descripGrp><ntig><termGrp><term id="1177384">parent solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1301438">Тектік шешім</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25649_1177386_1301439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solution that contains only selected components. For example, if a user decides to export only  a subset of components (for example, some but not all entities), the solution is considered to be partial.</descrip></descripGrp><ntig><termGrp><term id="1177386">partial solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1301439">Жарты шешім</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25650_1177387_1301457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A part of a solution that someone extending CRM can use to achieve specific functionality.</descrip></descripGrp><ntig><termGrp><term id="1177387">solution component</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1301457">Шешім құрамдасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25651_1177388_1301437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that, once protected and installed, cannot be modified.</descrip></descripGrp><ntig><termGrp><term id="1177388">non-customizable component</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1301437">Теңшелмейтін құрамдас</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25652_1177389_1301402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solution component that, once protected and installed, can be modified, but not deleted, by a solution.</descrip></descripGrp><ntig><termGrp><term id="1177389">customizable component</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1301402">Теңшелмелі құрамдас</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25654_1177391_1301471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A deployment-wide container of solutions that can be deployed in multiple organizations.</descrip></descripGrp><ntig><termGrp><term id="1177391">solution repository</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1301471">Шешім репозиторийі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25655_1177392_1301464"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A partner, such as an ISV, who develops solutions on top of a software platform.</descrip></descripGrp><ntig><termGrp><term id="1177392">solution publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1301464">solution publisher</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25656_1177393_1301407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A "catch-all" solution that contains a reference to all unprotected components.</descrip></descripGrp><ntig><termGrp><term id="1177393">default solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1301407">Әдепкі шешім</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25661_1177398_1375942"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A grid added to a form by a customizer that provides users with access to a group of records, which are usually contextually related.</descrip></descripGrp><ntig><termGrp><term id="1177398">sub-grid</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1375942">ішкі тор</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25662_1177400_2445800"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A narrow and long form that appears in the task pane, which is used to view and edit related data for lookups.</descrip></descripGrp><ntig><termGrp><term id="1177400">task form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNo