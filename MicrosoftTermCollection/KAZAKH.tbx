53_1030734"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A facility used to house mission critical computer systems and associated components. It generally includes environmental controls (air conditioning, fire suppression, etc.), redundant/backup power supplies, redundant data communications connections and high security.</descrip></descripGrp><ntig><termGrp><term id="568053">data center</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030734">деректерді өңдеу орталығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16382_568057_1030735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A workflow that is defined by using workflow markup language contained in XAML-formatted files. The XAML files are deployed and stored in the database.</descrip></descripGrp><ntig><termGrp><term id="568057">declarative workflow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030735">жарияланатын іскери ереже</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16383_568059_1030736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism to integrate multiple low-level authentication schemes into a high-level API, which allows for programs that rely on authentication to be written independently of the underlying authentication scheme.</descrip></descripGrp><ntig><termGrp><term id="568059">pluggable authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030736">модульдік түпнұсқалық растама</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16384_568060_1030737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML or XOML file that contains the information that other programs require to instantiate and run the workflow. Optionally, any custom metadata the workflow requires to run.</descrip></descripGrp><ntig><termGrp><term id="568060">workflow definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030737">іскери ереже анықтамасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16385_568062_1030738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of rules for a workflow.</descrip></descripGrp><ntig><termGrp><term id="568062">workflow policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030738">іскери ереже саясаты</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16386_568102_2101583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft deployment and management tool for high availability Web applications built on the Microsoft Windows operating system.</descrip></descripGrp><ntig><termGrp><term id="568102">Application Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101583">Application Center</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16387_568108_2101584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report, accessible from the Web Author, that generates a list of all pages waiting for the approval of the user who is logged on.</descrip></descripGrp><ntig><termGrp><term id="568108">Approval Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101584">Мақұлдау көмекшісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16388_568111_1030739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process that occurs when a workflow host calls the WorkflowRuntime.CreateWorkflow method.</descrip></descripGrp><ntig><termGrp><term id="568111">workflow activation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030739">іскери ережені белсендіру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16389_568136_2101585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom group used to target content to people based on membership within the group.</descrip></descripGrp><ntig><termGrp><term id="568136">audience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101585">аудитория</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1639_148511_1250020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A workbook that is configured to allow multiple users on a network to view and make changes at the same time. Each user who saves the workbook sees the changes that are made by other users.</descrip></descripGrp><ntig><termGrp><term id="148511">shared workbook</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250020">ортақ жұмыс кітабы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16390_568168_1030740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An elemental unit of a workflow that represents actions and provides functionality for control flow, conditions, event handling, state management, and communication with applications and services.</descrip></descripGrp><ntig><termGrp><term id="568168">workflow activity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030740">іскери ереже әрекеті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16391_568169_2101586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web page presented to unauthenticated users logging on to a site requiring authentication with a Web browser.</descrip></descripGrp><ntig><termGrp><term id="568169">authentication page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101586">аутентификация беті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16392_568170_1030741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A registration process that occurs when you add a workflow definition to the Microsoft Dynamics CRM database.</descrip></descripGrp><ntig><termGrp><term id="568170">workflow registration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030741">іскери ереже тіркемесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16393_568172_2101587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Content Management Server (MCMS) feature that enables users to author, edit, and submit content from a Microsoft Word document to an MCMS Web site.</descrip></descripGrp><ntig><termGrp><term id="568172">Authoring Connector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101587">контентпен жұмысқа арналған байланыстырғыш құрал</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16394_568174_1030742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of runtime event processing, support programs, code libraries, a scripting language, or other software to help develop and glue together the different components of a software project. In Microsoft Dynamics CRM, the plug-ins and workflows are included in a single event model.</descrip></descripGrp><ntig><termGrp><term id="568174">event framework</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030742">оқиғаларды өңдеу инфрақұрылымы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16396_568178_1030743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An architectural principle where a single instance of software is used to run a service for multiple clients (tenants).</descrip></descripGrp><ntig><termGrp><term id="568178">multitenancy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030743">көптиістілік</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16397_568182_1030744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to multiple client organizations (tenants) that are served by a single software-as-a-service (SaaS) vendor's servers.</descrip></descripGrp><ntig><termGrp><term id="568182">multitenant</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030744">көп клиентті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16398_568183_1269806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Occurring after a core system operation has been completed.</descrip></descripGrp><ntig><termGrp><term id="568183">post-event</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1269806">әрекеттен кейінгі оқиға</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16399_568184_1269807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Occurring before a core system operation occurs.</descrip></descripGrp><ntig><termGrp><term id="568184">pre-event</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1269807">әрекетке дейінгі оқиға</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16400_568187_1030747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class whose definition is split over two or more source files. Each source file contains a section of the class definition, and all parts are combined when the application is compiled.</descrip></descripGrp><ntig><termGrp><term id="568187">partial class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030747">бөлінетін сынып</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16401_573419_2213026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that installs the SQL Server Compact 3.5 devices runtime components.</descrip></descripGrp><ntig><termGrp><term id="573419">Microsoft SQL Server Compact 3.5 for Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2213026">Құрылғыларға арналған Microsoft SQL Server Compact 3.5</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16414_583814_2576167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of an integrated development environment (IDE) that provides logical code elements that the user can select from a drop-down menu while coding.</descrip></descripGrp><ntig><termGrp><term id="583814">IntelliSense</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2576167">IntelliSense</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1642_210902_615646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode of session state in which the entire session state is serialized and stored as a BLOB on the client then deserialized during every post-back. This has a tremendous hit in bytes over the wire (BoW), but is highly scalable in that it doesn’t require storing information in the database.</descrip></descripGrp><ntig><termGrp><term id="210902">view state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615646">қарап шығу күйі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16427_3099101_3099312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that is used with a window that does not have enough display area to show all of its content. The pager control allows the user to scroll to the area of the window that is not currently in view.</descrip></descripGrp><ntig><termGrp><term id="3099101">pager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3099312">бет таңдағыш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16427_584196_3099312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that is used with a window that does not have enough display area to show all of its content. The pager control allows the user to scroll to the area of the window that is not currently in view.</descrip></descripGrp><ntig><termGrp><term id="584196">pager control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3099312">бет таңдағыш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16438_584264_779590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column chart subtype that compares values across categories. The categories are organized horizontally, and values vertically, to emphasize variation over time.</descrip></descripGrp><ntig><termGrp><term id="584264">clustered column chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779590">топтастырылған гистограмма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16439_584277_779596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column chart subtype that compares the percentage that each value contributes to a total across categories.</descrip></descripGrp><ntig><termGrp><term id="584277">100% stacked column chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779596">үлестік бағандық диаграмма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16440_584278_1144935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column chart subtype that compares data points along two axes.</descrip></descripGrp><ntig><termGrp><term id="584278">3-D column chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1144935">үш өлшемдік гистограмма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber"