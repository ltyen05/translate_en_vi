<termEntry id="21990_782330_1250333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To uninstall all software on a computer and reinstall a new Windows image.</descrip></descripGrp><ntig><termGrp><term id="782330">re-image</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250333">қайта кескіндеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21994_782341_1778351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An easy-to-use troubleshooter that helps find and fix program compatibility issues.</descrip></descripGrp><ntig><termGrp><term id="782341">Program Compatibility troubleshooter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1778351">бағдарламалық үйлесімділік ақауларын жою құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21996_782344_1250335"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small pop-up window that informs users of a non-critical problem or special condition in a control.</descrip></descripGrp><ntig><termGrp><term id="782344">balloon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250335">шығарылған аңғартпа</term><termNote type="geographicalUsage">KAZ</te