p><term id="2784181">Интернеттегі Бизнеске арналған Skype</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38337_2219973_2226476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Skype for Business web app that allows users, even those without a Skype account, to join Skype meeting from their wed browser.</descrip></descripGrp><ntig><termGrp><term id="2219973">Skype for Business Web App</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2226476">Бизнеске арналған Skype веб-бағдарламасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38338_2219974_2226477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A plug-in required for audio, video, and screen sharing during a Skype for Business Meeting</descrip></descripGrp><ntig><termGrp><term id="2219974">Skype for Business Web App Plug-in</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2226477">Бизнеске арналған Skype веб-бағдарламасының қосымша модулі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38339_2219975_2226478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optional feature of Skype for Business Online that enables users to make calls to, and receive calls from, the traditional network by using Skype for Business This feature is available to Voice Plan customers only, and administrators must sign in with a Skype-to-phone provider to get the feature.</descrip></descripGrp><ntig><termGrp><term id="2219975">Skype-to-phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2226478">Skype-телефон</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38344_2220379_2747577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The software development process based on the classical spiral model to reduce the number of security-related design and coding defects and the severity of any defects that are left, thus reducing software maintenance costs while increasing reliability of software.</descrip></descripGrp><ntig><termGrp><term id="2220379">SDL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2747577">Microsoft қорғалған бағдарламалық жасақтамаларын әзірлеудің өмірлік циклі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38344_2220379_2747581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The software development process based on the classical spiral model to reduc