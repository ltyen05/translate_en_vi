><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control and an attached label, such as a text box with an attached label.</descrip></descripGrp><ntig><termGrp><term id="36901">compound control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615466">құрамдас басқару элементі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43060_2439288_2442762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office Lens feature that uses voice guidance to help users with visual impairments center objects in the frame of their camera when taking pictures.</descrip></descripGrp><ntig><termGrp><term id="2439288">Frame Guide</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2442762">Кадрға алу көмекшісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43060_2505368_2442762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office Lens feature that uses voice guidance to help users with visual impairments center objects in the frame of their camera when taking pictures.</descrip></descripGrp><ntig><termGrp><term id="2505368">VoiceOver</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2442762">Кадрға алу көмекшісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43061_2439289_2442777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Graph tool that populates a graph from a set of input entities (documents, people, etc.) and the relationships between them.</descrip></descripGrp><ntig><termGrp><term id="2439289">Sets</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2442777">Жиынтықтар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43062_2439290_2448745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Graph tool that allows developers to create and explore sets, create and manage permissions on sets, perform queries on sets, and manage sets and their relationships.</descrip></descripGrp><ntig><termGrp><term id="2439290">Sets Studio</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2448745">Sets Studio</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43063_2439291_2440921"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables u