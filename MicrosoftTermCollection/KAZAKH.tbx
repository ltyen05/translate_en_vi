Grp><descrip type="definition">The free global learning event on Data, Analytics and AI for data professionals that features a keynote session and more than 200 breakout sessions delivered by Azure Data engineering, partner organizations, and community leaders.</descrip></descripGrp><ntig><termGrp><term id="3095200">DPS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3095312">DPS</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54286_3095420_3096210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code or configuration vulnerability within Microsoft 365 tenants, Microsoft cloud service tenants, or cloud service infrastructure that could cause wide-spread compromise of services, denial-of-service, or sensitive information disclosure.</descrip></descripGrp><ntig><termGrp><term id="3095420">cloud critical vulnerability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3096210">бұлттың критикалық осалдығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54287_3095421_3096212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A loss or potential loss of confidentiality via the unauthorized or accidental disclosure or transfer of sensitive or classified information to an unclassified information system.</descrip></descripGrp><ntig><te