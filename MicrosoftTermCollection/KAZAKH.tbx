efinition">The email search client that provides autocomplete, spell correct, fuzzy name search and that provides relevance-based and time-ordered results.</descrip></descripGrp><ntig><termGrp><term id="2485603">Email Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2489506">Email Insights</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44238_2485689_2488438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of design components with a consistent aesthetic theme and with consistent patterns that convey meaning to users.</descrip></descripGrp><ntig><termGrp><term id="2485689">design language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2488438">дизайн тілі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44239_2485690_2488439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The design language used for all products in Office 365 and SharePoint.</descrip></descripGrp><ntig><termGrp><term id="2485690">Office Design Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2488439">Office дизайн тілі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4424_559850_2222766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a transaction that remains open and cannot be completed. Uncommitable transactions could be considered a subclass of partially failed transactions, where the transaction has encountered an error that prevents its completion, but it is still holding its locks and has to be rolled back by the user.</descrip></descripGrp><ntig><termGrp><term id="559850">uncommittable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2222766">бекітілмейтін</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44240_2485691_2486666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The open-source, front-end framework, written in Fluent Design, for designing and building experiences that fit seamlessly into a broad range of Microsoft 365 products.</descrip></descripGrp><ntig><termGrp><term id="2485691">Office UI Fabric</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2486666">Office UI Fabric</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44241_2485693_2486667"><langSet xm