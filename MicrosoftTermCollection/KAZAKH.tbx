mber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="638252">Дерекқорды басқару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15361_49467_2101535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive form on a Web site that you fill out and send back to the owner of the Web site or a Web server.</descrip></descripGrp><ntig><termGrp><term id="49467">e-form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101535">электрондық форма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15361_652640_2101535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive form on a Web site that you fill out and send back to the owner of the Web site or a Web server.</descrip></descripGrp><ntig><termGrp><term id="652640">electronic form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101535">электрондық форма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15361_763948_2101535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive form on a Web site that you fill out and send back to the owner of the Web site or a Web server.</descrip></descripGrp><ntig><termGrp><term id="763948">online form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101535">электрондық форма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15367_168927_2201114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transaction that is not committed when the roll forward phase of recovery completes and that cannot be rolled back during database startup because data needed by roll back is offline. This data can reside in either a page or a file.</descrip></descripGrp><ntig><termGrp><term id="168927">deferred transaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2201114">кейінге қалдырылған транзакция</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15369_71392_626853"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specified amount of processing performed as a unit by a computer.</descrip></descripGrp><ntig><termGrp><term id="71392">job</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626853">тапсырма</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">