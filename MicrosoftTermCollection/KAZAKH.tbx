 library that is shared between site collections.</descrip></descripGrp><ntig><termGrp><term id="1623955">catalog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674077">каталог</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31786_1623956_1674101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A vertical bar in the margin of a document that shows where changes have been tracked and displays those changes when clicked.</descrip></descripGrp><ntig><termGrp><term id="1623956">change hint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674101">өзгерістерді көрсету</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31787_1623957_1674106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the distinct pieces that make up a chart, such as a title, axis, legend, trendline, or error bar.</descrip></descripGrp><ntig><termGrp><term id="1623957">chart element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1674106">диаграмма элементі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumbe