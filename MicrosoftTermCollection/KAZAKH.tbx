">IAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250041">Интернетке қатынасты қамтамасыз етуші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2782_308818_1490910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An organization that provides a connection to the internet and services related to that.</descrip></descripGrp><ntig><termGrp><term id="308818">IAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1490910">Интернет қызметін қамтамасыз етуші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2782_308818_626771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An organization that provides a connection to the internet and services related to that.</descrip></descripGrp><ntig><termGrp><term id="308818">IAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626771">Интернет провайдері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27825_1465554_2459401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To authorize the occurrence of future events in a system.</descrip></descripGrp><ntig><termGrp><term id="1465554">approve</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2459401">бекіту</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27832_1465561_2372400"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A record of the financial consequence an accounting event.</descrip></descripGrp><ntig><termGrp><term id="1465561">journal entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2372400">журнал жазбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27834_1465563_2372402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To record the financial consequences of accounting events in the subledger journal.</descrip></descripGrp><ntig><termGrp><term id="1465563">journalize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2372402">қосалқы кітапқа тіркеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27850_1465579_2325229"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of notification that is generated by user-defined rules meant to inform him/her of events, conditions, and status changes.</descrip></descripGrp><ntig><termGrp><term id="1465579">alert</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2325229">хабарландыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27851_1465580_2422363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication generated by the occurrence of an event that a system or user asynchronously sends for receipt. A notification message is a communication that is intended to be read by a recipient.</descrip></descripGrp><ntig><termGrp><term id="1465580">notification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2422363">хабарландыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27852_1465584_2608308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collective of attack vectors through which a system can be attacked successfully.</descrip></descripGrp><ntig><termGrp><term id="1465584">attack surface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2608308">шабуыл бағыттары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27854_1465588_2215310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In BizTalk Server, an agreement between the two partners that establishes a uni-directional communication channel, either for receiving messages or for sending messages. The specific source and target addresses are specified in the "one-way agreement" tabs when creating an Agreement.</descrip></descripGrp><ntig><termGrp><term id="1465588">one-way agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215310">бір жақты келісім</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27863_1467974_2372390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cost that expires when the benefits that incurred the cost are received during an accounting period.</descrip></descripGrp><ntig><termGrp><term id="1467974">expense</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2372390">шығыс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27867_1467978_2183440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The continuous and incremental processing of event streams from multiple sources based on declarative query and pattern specifications with near-zero latency.</descrip></descripGrp><ntig><termGrp><term id="1467978">complex event processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2183440">күрделі оқиғаларды өңдеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27867_1484612_2183440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The continuous and incremental processing of event streams from multiple sources based on declarative query and pattern specifications with near-zero latency.</descrip></descripGrp><ntig><termGrp><term id="1484612">CEP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2183440">күрделі оқиғаларды өңдеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27868_1467979_2197594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special punctuation event that indicates the completeness of the existing events.</descrip></descripGrp><ntig><termGrp><term id="1467979">CTI event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2197594">CTI оқиғасы</t