ote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="475483">Ата-ана бақылауы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13016_346958_627176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of partial control parents get over the accounts and devices of their children helping them supervise how their children behave online and letting them restrict what their children see.</descrip></descripGrp><ntig><termGrp><term id="346958">parental controls</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627176">ата-ана бақылауы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13018_475236_1030685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pricing method that determines the unit price of the product is calculated as a percent markup of the current cost or standard cost that was entered in the Current Cost field on the Product form.</descrip></descripGrp><ntig><termGrp><term id="475236">percent markup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1030685">үстеме баға пайызы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNot