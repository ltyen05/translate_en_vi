Grp><descrip type="definition">A disk that uses the master boot record (MBR) partition style.</descrip></descripGrp><ntig><termGrp><term id="175321">MBR disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093886">MBR диск</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8337_147809_2093887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A module that includes code for all event procedures triggered by events occurring on a specific report or its controls.</descrip></descripGrp><ntig><termGrp><term id="147809">report module</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093887">есеп модулі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8342_534990_2206757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query (SQL statement) that creates a new row and inserts values into specified columns.</descrip></descripGrp><ntig><termGrp><term id="534990">Insert Values query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2206757">мәндерді кірістіру сұрауы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type