rm of a datasheet, without changing the data.</descrip></descripGrp><ntig><termGrp><term id="360146">select query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615565">іріктеуді сұрау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14528_276550_1996550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single location in Windows where you can adjust mobile PC settings.</descrip></descripGrp><ntig><termGrp><term id="276550">Windows Mobility Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1996550">Windows ұтқырлық орталығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1453_85978_2070144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that displays information about objects, properties, methods, and constants in the current project and in referenced object libraries, and that you use to search for an element, get help on it, or paste it into a module.</descrip></descripGrp><ntig><termGrp><term id="85978">object browser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070144">Нысандар шолғышы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</t