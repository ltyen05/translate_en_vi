="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11223_335605_626832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A lightweight protocol designed to make the automated discovery, management, and configuration of iSCSI and Fiber Channel Protocol (FCP) devices on a TCP/IP network easier by providing a common mechanism for initiators and targets to discover one another and for handling zoning and authentication of both targets and initiators.</descrip></descripGrp><ntig><termGrp><term id="335605">iSNS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626832">iSNS</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11232_231971_627221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a PivotTable report, the summarized data calculated from the data fields of a source list or table.</descrip></descripGrp><ntig><termGrp><term id="231971">PivotTable data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627221">жиынтық кесте деректері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11233_178355_2215366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data flow element that connects the output of one data flow component to the input of another data flow component.</descrip></descripGrp><ntig><termGrp><term id="178355">path</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215366">жол</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11237_179047_2221218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To request data from a Publisher.</descrip></descripGrp><ntig><termGrp><term id="179047">subscribe</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221218">жазылу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11239_90209_2098673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The request by a user's browser for a Web page. The number of requests to view a page can indicate the frequency with which an ad is viewed.</descrip></descripGrp><ntig><termGrp><term id="90209">page view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098673">беттің қаралуы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></te