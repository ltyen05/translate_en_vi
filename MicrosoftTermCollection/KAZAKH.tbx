ntial.</descrip></descripGrp><ntig><termGrp><term id="110103">sensitivity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779564">құпиялылық деңгейі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6387_725767_1250091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of confidentiality of an email message or calendar item, ranging from normal to confidential.</descrip></descripGrp><ntig><termGrp><term id="725767">sensitivity level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250091">құпиялылық</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6387_725767_779564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of confidentiality of an email message or calendar item, ranging from normal to confidential.</descrip></descripGrp><ntig><termGrp><term id="725767">sensitivity level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="779564">құпиялылық деңгейі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6388_232427_1250092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number between 1 and 53 that is assigned to each week of the year, where the first week of the year is the first week that contains a Thursday.</descrip></descripGrp><ntig><termGrp><term id="232427">week number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250092">апта нөмірі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="639_252663_2070103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A characterization of an external entity based on how it is authenticated and what privileges it has. Trust levels can be associated with entry points, personas, assets, or other protected resources.</descrip></descripGrp><ntig><termGrp><term id="252663">trust level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070103">сенім деңгейі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6393_134066_627802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that calculates and displays the number of words, characters, lines, pages and paragraphs in a document.</descrip></descripGrp><ntig><termGrp><term id="134066">Word Count</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml