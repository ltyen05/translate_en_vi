Set xml:lang="en-US"><descripGrp><descrip type="definition">A symbol that separates thousands from hundreds within a number that has four or more places to the left of the decimal separator.</descrip></descripGrp><ntig><termGrp><term id="121352">thousand separator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221548">мыңдық бөлгіш</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5840_140302_2093515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The placeholder for a database field displayed inside a database results region.</descrip></descripGrp><ntig><termGrp><term id="140302">database column value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093515">дерекқор бағанының мәні</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5844_127521_2093516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scripting language that is used to create interactive or animated content for the Internet, such as games or advanced financial applications and that is based on Microsoft Visual Basic syntax.</descrip></descripGrp><ntig><termGrp><term id="127521">VBScript</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093516">VB