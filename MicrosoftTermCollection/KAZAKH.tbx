 2010</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1488166">Microsoft Visio Professional 2010</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25934_1244658_1488150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2010 edition of the Microsoft business diagramming and drawing software used to create charts, diagrams, and other schematic illustrations, designed for business users.</descrip></descripGrp><ntig><termGrp><term id="1244658">Microsoft Visio Standard 2010</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1488150">Microsoft Visio Standard 2010</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25938_1244793_2221289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dynamic option that displays the number of rows in which the determinant column value determines the dependent column.</descrip></descripGrp><ntig><termGrp><term id="1244793">Support Count</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221289">негізгі жиынтық саны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender