icalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10874_71636_2098661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A raster graphics file format for displaying high-resolution color graphics on the World Wide Web. JPEG graphics apply a user-specified compression scheme that can significantly reduce the file sizes of photo-realistic color graphics. A higher level of compression results in lower quality, whereas a lower level of compression results in higher quality. JPEG-format files have a .jpg file name extension.</descrip></descripGrp><ntig><termGrp><term id="71636">JPEG</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098661">JPEG</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10878_245069_1599953"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A status that indicates an article is being written.</descrip></descripGrp><ntig><termGrp><term id="245069">Draft</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1599953">Жоба</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10882_530818_2223412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository engine feature that is used to create relational views based on classes, 