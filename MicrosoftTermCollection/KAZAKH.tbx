464_129701_2098794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical grouping of hosts on one or more local area networks (LANs) that allows communication to occur between hosts as if they were on the same physical LAN.</descrip></descripGrp><ntig><termGrp><term id="129701">virtual LAN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098794">VLAN</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13464_129702_2098794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical grouping of hosts on one or more local area networks (LANs) that allows communication to occur between hosts as if they were on the same physical LAN.</descrip></descripGrp><ntig><termGrp><term id="129702">virtual local area network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098794">VLAN</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13464_129703_2098794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical grouping of hosts on one or more local area networks (LANs) that allows communication to occur between hosts as if they were on the same physical LAN.</descrip></descripGrp><ntig><termGrp><term id="129703">VLAN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098794">VLAN</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13467_530208_2184115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that displays related report model data when you click data within a rendered Report Builder report.</descrip></descripGrp><ntig><termGrp><term id="530208">clickthrough report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2184115">қосымша ақпараты бар есеп</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13469_73905_2098795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A semiconductor device that converts electrical energy into light, used, for example, for the activity lights on computer disk drives. Light-emitting diodes work on the principle of electroluminescence and are highly efficient, producing little heat for the amount of light output.</descrip></descripGrp><ntig><termGrp><term id="73905">LED</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098795">жарық диод</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13469_73906_2098795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A semiconductor device that converts electrical energy into light, used, for example, for the activity lights on computer disk drives. Light-emitting diodes work on the principle of electroluminescence and are highly efficient, producing little heat for the amount of light output.</descrip></descripGrp><ntig><termGrp><term id="73906">light-emitting diode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098795">жарық диод</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13470_530221_2197549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statistic that reports the time, in milliseconds, that the central processing unit (CPU) spent on the work.</descrip></descripGrp><ntig><termGrp><term id="530221">CPU busy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2197549">орталық процессор бос емес</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13475_28898_2098796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of computers and specially developed tutorial programs for teaching. CBT uses color, graphics, and other attention-getting aids to help maintain interest, and it has both simple and sophisticated applications.</descrip></descripGrp><ntig><termGrp><term id="28898">CBT</te