ificate in the chain is normally a self-signed certificate.</descrip></descripGrp><ntig><termGrp><term id="340147">trust chain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101459">сертификат тізбегі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13812_340148_2101459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of certificates, where each certificate in the sequence is signed by the subsequent certificate. The last certificate in the chain is normally a self-signed certificate.</descrip></descripGrp><ntig><termGrp><term id="340148">certificate trust chain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101459">сертификат тізбегі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13815_89046_2101460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that can be sent to one or more recipients across one or more messaging systems or be posted to a folder in a message store.</descrip></descripGrp><ntig><termGrp><term id="89046">outgoing message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101460">шығыс хабар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">No