 organizer used to add, uninstall, and search for desktop gadgets.</descrip></descripGrp><ntig><termGrp><term id="1037839">Desktop Gadget Gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250351">жұмыс үстеліндегі мини-бағдарламалар галереясы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22281_1037847_1145192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A library used to view and manage files, images or programs.</descrip></descripGrp><ntig><termGrp><term id="1037847">organizer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1145192">ұйымдастырушы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22282_1037851_1250352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that helps make the text on your screen easier to read for long periods of time.</descrip></descripGrp><ntig><termGrp><term id="1037851">ClearType Text Tuner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250352">ClearType Text Tuner шебері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><ter