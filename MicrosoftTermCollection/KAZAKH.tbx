 type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50568_2863799_2864115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of topics connected through shared resources and contributors that combines AI with human moderation to help your organization learn about itself.</descrip></descripGrp><ntig><termGrp><term id="2863799">knowledge network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2864115">білім жиынтығының желісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50570_2864253_2866829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A growing catalog of cloud apps that are ranked and scored based on industry standards.</descrip></descripGrp><ntig><termGrp><term id="2864253">cloud app catalog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2866829">бұлттық бағдарламалар каталогы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50571_2864257_2866830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A metric that measures the net adds of customers meeting specified criteria during a reporting period.</descrip></descripGrp><ntig><termGrp><term id="2864257">customer adds</term><termNote type="partOfSpeech">Noun</termNot