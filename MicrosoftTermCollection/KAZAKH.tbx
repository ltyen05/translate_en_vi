17521_2821582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Exchange Server test that verifies the Active Manager client/server processes on DAG (Database Availability Group) members and on the Client Access Server that perform lookups in Active Directory and Active Manager to determine where a user's mailbox database is active.</descrip></descripGrp><ntig><termGrp><term id="2817521">Server Locator Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2821582">серверлерді анықтау қызметі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49830_2817530_2821460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Button label for executing a search.</descrip></descripGrp><ntig><termGrp><term id="2817530">Find All</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2821460">Барлығын табу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49831_2817533_2821453"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of conditions, implemented through the Data Validation function in Excel, that restricts the permissible content of a cell.</descrip></descripGrp><ntig><termGrp><term id="2817533">data validation rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singula