ected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3191694">Bing-тегі Copilot</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56679_3191194_3191699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft technology that provides built-in generative AI for Microsoft Viva services.</descrip></descripGrp><ntig><termGrp><term id="3191194">Copilot in Viva</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3191699">Viva-дағы Copilot</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56679_3193313_3191699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft technology that provides built-in generative AI for Microsoft Viva services.</descrip></descripGrp><ntig><termGrp><term id="3193313">Microsoft 365 Copilot in Viva</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3191699">Viva-дағы Copilot</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56680_3191195_3191697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unified Copilot experience in Microsoft Loop that enables users to brainstorm, outline a plan, and draft content.</descrip></descripGrp><ntig><termGrp><term id="3191195">Copilot in Loop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3191697">Loop-тағы Copilot</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56680_3193311_3191697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unified Copilot experience in Microsoft Loop that enables users to brainstorm, outline a plan, and draft content.</descrip></descripGrp><ntig><termGrp><term id="3193311">Microsoft 365 Copilot in Loop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3191697">Loop-тағы Copilot</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56681_3191991_3192294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The most appropriate action dynamically selected and executed by AI, based on available resources and desired outcomes, within an automation plan. This process leverages large language models (LLMs) to reason over unstructured content and determine the necessary steps and sequence to achieve a specified objective, making it flexible and efficient in handling complex process flows.</descrip></descripGrp><ntig><termGrp><term id="3191991">adaptive action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3192294">бейімделу әрекеті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56682_3191992_3192295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of flow that is created using the AI flows feature.</descrip></descripGrp><ntig><termGrp><term id="3191992">AI flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3192295">ЖИ ағыны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56683_3191993_3192296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An LLM-enabled process automation feature in Power Automate that allows users to execute to an end result by describing in natural language what they want to achieve with parameters for the flow to work within.</descrip></descripGrp><ntig><termGrp><term id="3191993">AI flows</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3192296">ЖИ ағындары</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56684_3191994_3192297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connector that allows desktop flows to interact with various cloud services and applications. It enables the automation of tasks that involve cloud-based resources, by providing specific actions that can create, retrieve, update, or manage data in these services.</descrip></descripGrp><ntig><termGrp><term id="3191994">cloud connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3192297">бұлт қосқышы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56685_3191995_3192298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software robot that automates repetitive tasks within business processes, such as data entry, order processing, or customer service responses.</descrip></descripGrp><ntig><termGrp><term id="3191995">flowbot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3192298">ағын боты</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56686_3191996_3192299"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capacity within Power Automate that allows users to run desktop flows with zero infrastructure. It's allocated to hosted machines or committed to hosted machine groups.</descrip></descripGrp><ntig><termGrp><term id="3191996">hosted process capacity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3192299">орналастырылған өңдеу сыйымдылығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56687_3191997_3192300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A non-secret, random value used to ensure that identical plaintexts encrypt to different ciphertexts, thus enhancing the security of the encryption process.</descrip></descripGrp><ntig><termGrp><term id="3191997">initialization vector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3192300">баптандыру векторы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56688_3191998_3192301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The setting in a hosted machine group that determines the maximum number of hosted bots it can auto-allocate itself to turn on hosted machines.</descrip></descripGrp><ntig><termGrp><term id="3191998">Max bots</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3192301">максималды боттар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56689_3191999_3192302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capacity allocated to a cloud flow that enables it, along with all its associated cloud flows, to use premium connectors and execute actions up to a specified daily limit.</descrip></descripGrp><ntig><termGrp><term id="3191999">process capacity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3192302">өңдеу сыйымдылығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5669_161242_2093504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The zone to which all Macintosh clients on the network are assigned by default.</descrip></descripGrp><ntig><termGrp><term id="161242">default zone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093504">әдепкі аумақ</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5671_481868_2221579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To populate a model with data to derive patterns that can be used in prediction or knowledge discovery.</descrip></descripGrp><ntig><termGrp><term id="481868">train</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221579">оқыту</term><termNote type="geographicalU