030794">single-user computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1816986">ДК</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2400_1030794_1816987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microcomputer designed for use by one person at a time. Personal computers do not need to share the processing, disk, and printer resources of another computer.</descrip></descripGrp><ntig><termGrp><term id="1030794">single-user computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1816987">дербес компьютер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2400_91272_1816986"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microcomputer designed for use by one person at a time. Personal computers do not need to share the processing, disk, and printer resources of another computer.</descrip></descripGrp><ntig><termGrp><term id="91272">PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1816986">ДК</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2400_91272_1816987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microcomputer designed for use by one person at a time. Personal computers do not need to share the processing, disk, and printer resources of another computer.</descrip></descripGrp><ntig><termGrp><term id="91272">PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1816987">дербес компьютер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2400_91273_1816986"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microcomputer designed for use by one person at a time. Personal computers do not need to share the processing, disk, and printer resources of another computer.</descrip></descripGrp><ntig><termGrp><term id="91273">personal computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1816986">ДК</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2400_91273_1816987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microcomputer designed for use by one person at a time. Personal computers do not need to share the processing, disk, and printer resources of another computer.</descrip></descripGrp><ntig><termGrp><term id="91273">personal computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1816987">дербес компьютер</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24002_1093138_1998131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI or media segment that can display on top of or play concurrently with another UI or media segment.</descrip></descripGrp><ntig><termGrp><term id="1093138">overlay</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1998131">қабаттасу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2401_530744_2219246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range of dates that is specified by using comparison operators and return data for a range of dates.</descrip></descripGrp><ntig><termGrp><term id="530744">relative date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2219246">салыстырмалы күн</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24016_1093171_2592494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A powerful stand-alone computer of the sort used in computer-aided design and other applications requiring a high-end, usually expensive, machine with considerable calculating or graphics capability.</descrip></descripGrp><ntig><termGrp><term id="1093171">workstation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2592494">жұмыс станциясы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24019_1093175_1145120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A manila card about 3 inches high by 7 inches long on which 80 columns of data could be entered in the form of holes punched with a keypunch machine. The punched holes corresponded to numbers, letters, and other characters and could be read by a computer that used a punched-card reader.</descrip></descripGrp><ntig><termGrp><term id="1093175">punched card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1145120">карта</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24019_1093176_1145120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A manila card about 3 inches high by 7 inches long on which 80 columns of data could be entered in the form of holes punched with a keypunch machine. The punched holes corresponded to numbers, letters, and other characters and could be read by a computer that used a punched-card reader.</descrip></descripGrp><ntig><termGrp><term id="1093176">card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1145120">карта</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24039_1097320_2641218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On retailer websites, a collection of desired products or items a customer saves to their user account for future reference.</descrip></descripGrp><ntig><termGrp><term id="1097320">wish list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2641218">тілектер тізімі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2404_397151_407547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of processes that are run on the Exchange Server 2007 Hub Transport server role to establish one-way replication of recipient and configuration information from the Active Directory directory service to the Active Directory Application Mode (ADAM) instance on a computer that has the Edge Transport server role installed. EdgeSync copies only the information that is required for the Edge Transport server to perform anti-spam and message security configuration tasks, and information about the Send connector configuration that is required to enable mail flow from the Exchange 2007 organization's Hub Transport servers to the Internet through one or more Edge Transport servers. EdgeSync performs scheduled updates so that the information in ADAM remains current.</descrip></descripGrp><ntig><termGrp><term id="397151">EdgeSync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="407547">EdgeSync</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24043_1097333_2515222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that provides a common application programming interface (API). Applications written using that API will run in the same computer systems as the middleware.</descrip></descripGrp><ntig><termGrp><term id="1097333">middleware</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2515222">аралық бағдарламалық жасақтама</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2405_2020064_2021356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of battery power left on the system.</descrip></descripGrp><ntig><termGrp><term id="2020064">battery level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2021356">батарея заряды</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2405_2020064_2021357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of battery power left on the system.</descrip></descripGrp><ntig><termGrp><term id="2020064">battery level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2021357">батарея зарядының деңгейі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2405_236972_2021356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of battery power left on the system.</descrip></descripGrp><ntig><termGrp><term id="236972">battery charge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2021356">батарея заряды</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2405_236972_2021357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of battery power left on the system.</descrip></descripGrp><ntig><termGrp><term id="236972">battery charge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2021357">батарея зарядының деңгейі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24051_1097914_2029026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To return to a stable condition after some error has occurred. A program recovers from an error by stabilizing itself and resuming execution of instructions without user intervention.</descrip></descripGrp><ntig><termGrp><term id="1097914">recover</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2029026">қалпына келу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24057_1098418_1131610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of statistics that indicates the degree to which a service meets performance, usage, and other demands for the service.</descrip></descripGrp><ntig><termGrp><term id="1098418">service quality metrics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1131610">қызмет сапасының көрсеткіштері</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24059_1098419_1131582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules that defines security permissions for a collection of assemblies by associating attributes of those assemblies, such as location and signature, with a set of code access security permissions.</descrip></descripGrp><ntig><termGrp><term id="1098419">code access security (CAS) policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1131582">код үшін қатынасты басқару саясаты</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24059_1098420_1131582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules that defines security permissions for a collection of assemblies by associating attributes of those assemblies, such as location and signature, with a set of code access security permissions.</descrip></descripGrp><ntig><termGrp><term id="1098420">CAS policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1131582">код үшін қатынасты басқару саясаты</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24059_1508832_1131582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules that defines security permissions for a collection of assemblies by associating attributes of those assemblies, such as location and signature, with a set of code access security permissions.</descrip></descripGrp><ntig><termGrp><term id="1508832">code access security policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1131582">код үшін қатынасты басқару саясаты</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24063_1098424_2215348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In database programming, a subset of a database table or file.</descrip></descripGrp><ntig><termGrp><term id="1098424">partition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2215348">бөлім</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2407_73729_626908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, the order and sequence of input and output.</descrip></descripGrp><ntig><termGrp><term id="73729">layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626908">орналасу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24072_1098446_1131611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that monitors and collects statistics about a system. Those statistics can be compared to a set of thresholds to assess system performance, identify and resolve problems, and perform other diagnostic and administrative tasks.</descrip></descripGrp><ntig><termGrp><term id="1098446">diagnostic provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1131611">диагностиканы қамтамасыз етуші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24076_1098449_2689603"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time during which a program is running. In most interactive programs, a session is the time during which the program accepts input and processes information.</descrip></descripGrp><ntig><termGrp><term id="1098449">session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2689603">сеанс</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24102_1098534_1131612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feed that provides users with information, notifications and updates based on people, documents, and tags they are following.</descrip></descripGrp><ntig><termGrp><term id="1098534">activity feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1131612">белсенділік веб-арнасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singula