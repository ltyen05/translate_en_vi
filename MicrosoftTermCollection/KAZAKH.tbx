te type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627122">үндестіру орталығын іске қосу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10486_149827_1250141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The basic structure of a view. When you create a view, you must first select one of five view types (table, timeline, day/week/month, card, or icon) to determine how information will be arranged and formatted in your new view.</descrip></descripGrp><ntig><termGrp><term id="149827">view type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250141">көрініс түрі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10488_134409_2223525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Composition of often related [server] roles that run together on a single server or set of related servers. Each workload corresponds to an overall business/product area. Network is an example of a workload. While small or medium businesses might run an entire workload on a single machine, this would be unusual for a large enterprise. Workloads are often managed by the same group within IT, and a large business might have a separate operations team and purchasing decision maker for each workload.</descrip></descripGrp><ntig><termGrp><term id="134409">workload</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2223525">жұмыс жүктемесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10489_419469_2220627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The relative percentage of a multidimensional structure's cells that do not contain data.</descrip></descripGrp><ntig><termGrp><term id="419469">sparsity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2220627">сиректік</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10492_251783_1598542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collective grouping of projects, usually including a common set of goals, plans and measurement of success, that is managed and delivered in a coordinated way.</descrip></descripGrp><ntig><termGrp><term id="251783">program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1598542">бағдарлама</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10498_168444_1145193"><langSet xml:lang="en-US"><descr