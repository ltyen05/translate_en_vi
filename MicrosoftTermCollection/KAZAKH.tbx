able</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2328986">айналмалы платформа</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40037_2328194_2328984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The multi-app package for Windows 10 that includes the Messaging app for SMS, instant messaging, and Skype chat, and the Skype video app for VoIP video and audio calling.</descrip></descripGrp><ntig><termGrp><term id="2328194">Messaging + Skype</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2328984">Хабар алмасу және Skype</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40039_2329141_2330049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a previously banned person to a contact list again, so a user can receive calls or instant messages from the person.</descrip></descripGrp><ntig><termGrp><term id="2329141">unblock</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2330049">блоктан шығару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote><