efinition">The column name in Dataverse showing the time zone offset code that was in use at the time the row was created.</descrip></descripGrp><ntig><termGrp><term id="3068400">UTC Conversion Time Zone Code</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3068832">UTC ретінде түрлендірілген уақыт белдеуінің коды</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53900_3068401_3068833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transform type that defines how values that are present in one table should be mapped to values in the other table.</descrip></descripGrp><ntig><termGrp><term id="3068401">value map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="3068833">мәндер кестесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53901_3068403_3068671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">This status consumes a resource's capacity. A booking typically has this status when you open Maintain Bookings from the Team Members grid on the Project’s main form or the view bookings on the schedule board.</descrip></descripGrp><ntig><termGrp><term id="3068403">hard book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><