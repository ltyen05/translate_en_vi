<termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1615280">SRV жазбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26322_1273583_1615301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date at the end of a subscription. For example, in Microsoft Online Services, there are a variety of services that a customer may subscribe to, and each subscription has its own term length (e.g., 6 months, 12 months) and term end date.</descrip></descripGrp><ntig><termGrp><term id="1273583">term end date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1615301">аяқталу күні</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26323_1273587_1614751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The language chosen by a company in which they want to receive email messages and other business communications from Microsoft.</descrip></descripGrp><ntig><termGrp><term id="1273587">communications language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1614751">іскери қатынас тілі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</ter