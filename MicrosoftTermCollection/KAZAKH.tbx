ns that need to be advanced to a desired outcome.</descrip></descripGrp><ntig><termGrp><term id="2821617">business process flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2822068">бизнес процесінің ағыны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49903_2821620_2822069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flow in which a user selects a button to run repetitive tasks from any place, at any time, via a mobile device.</descrip></descripGrp><ntig><termGrp><term id="2821620">instant flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2822069">жылдам ағын</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49904_2821624_2822072"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flow in which the flow creator can add other users and groups as owners so that they can execute the flow.</descrip></descripGrp><ntig><termGrp><term id="2821624">team flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2822072">топ ағыны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49906_2822727_2827616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The baseline subscription-based offering of Microsoft Project.</descrip></descripGrp><ntig><termGrp><term id="2822727">Project Plan 1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2827616">Project (1-жоспар)</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49907_2822739_2827621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The subscription-based offering of Microsoft Project that includes the baseline functions (Project Plan 1), plus a desktop client for up to 5 machines and some additional functions such as for reporting and resource management.</descrip></descripGrp><ntig><termGrp><term id="2822739">Project Plan 3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2827621">Project (3-жоспар)</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49908_2822742_2827624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The subscription-based offering of Microsoft Project that includes the features in Project Plan 1 and Project Plan 3 plus some features for managing enterprise-wide resources.</descrip></descripGrp><ntig><termGrp><term id="2822742">Project Plan 5</term><