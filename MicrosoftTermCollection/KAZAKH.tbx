">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15818_234305_615381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form component, such as a template part or ActiveX control, that isn't included with InfoPath by default. Form designers can add or remove custom controls by using the Controls task pane.</descrip></descripGrp><ntig><termGrp><term id="234305">custom control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615381">теңшелетін басқару элементі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15832_180812_2200118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of the report server engine that processes data.</descrip></descripGrp><ntig><termGrp><term id="180812">Data Processor component</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2200118">деректерді өңдеу құралының компоненті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15834_83662_627074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of an application window that enables the user to navigate quickly to different parts of the program.</descrip></descripGrp><ntig><termGrp><term id="83662">navigation pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627074">шарлау аумағы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15839_137133_2101558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diamond-shaped handle used to adjust the appearance but not the size of most AutoShapes. For example, you can adjust a rounded rectangle to be more or less rounded.</descrip></descripGrp><ntig><termGrp><term id="137133">adjustment handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101558">пішіндер реттегіші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15842_210445_1778211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that verifies the technology is compatible with the target browser.</descrip></descripGrp><ntig><termGrp><term id="210445">compatibility checker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1778211">үйлесімділік тексергіші</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15847_51369_626592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of inputting information.</descrip></descripGrp><ntig><termGrp><term id="51369">entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626592">енгізу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15850_1056049_2484232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of items that a customer has selected to purchase from a commerce Web site. It is usually compiled into a file and sometimes visually represented by a shopping basket, shopping cart, or other container used when shopping.</descrip></descripGrp><ntig><termGrp><term id="1056049">shopping cart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2484232">дүкен арбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15850_1056053_2484232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of items that a customer has selected to purchase from a commerce Web site. It is usually compiled into a file and sometimes visually represented by a shopping basket, shopping cart, or other container used when shopping.</descrip></descripGrp><ntig><termGrp><term id="1056053">cart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2484232">дүкен арбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15850_188099_2484232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of items that a customer has selected to purchase from a commerce Web site. It is usually compiled into a file and sometimes visually represented by a shopping basket, shopping cart, or other container used when shopping.</descrip></descripGrp><ntig><termGrp><term id="188099">basket</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2484232">дүкен арбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15851_140348_2101559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical representation of any portion of a database schema. It can be either a whole or partial picture of the structure of the database. It includes tables, the columns they contain, and the relationships between the tables.</descrip></descripGrp><ntig><termGrp><term id="140348">database diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101559">дерекқор диаграммасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15853_139678_2101560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information, stored by the OLAP Cube Wizard in an .oqy file, that defines how to construct an OLAP cube in memory using data retrieved from a relational database.</descrip></descripGrp><ntig><termGrp><term id="139678">cube definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101560">текше анықтамасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15855_148370_1250207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character you choose to indicate where you want text to separate when you convert a table to text, or where you want new rows or columns to begin when you convert text to a table.</descrip></descripGrp><ntig><termGrp><term id="148370">separator character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1250207">бөлгіш таңбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15859_122509_2101561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The file that contains the information gathered during trace logging.</descrip></descripGrp><ntig><termGrp><term id="122509">trace log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2101561">тра