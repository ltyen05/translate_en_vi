1399_2026494_626688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that connects networks using different communications protocols so that information can be passed from one to the other. A gateway both transfers information and converts it to a form compatible with the protocols used by the receiving network.</descrip></descripGrp><ntig><termGrp><term id="2026494">network gateway</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626688">шлюз</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1399_57949_626688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that connects networks using different communications protocols so that information can be passed from one to the other. A gateway both transfers information and converts it to a form compatible with the protocols used by the receiving network.</descrip></descripGrp><ntig><termGrp><term id="57949">gateway</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626688">шлюз</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13990_347937_615397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of files that are used to implement a form. File types can include .html, .xml, .xsd, .xslt, script, and other file types that are necessary to support the functionality of 