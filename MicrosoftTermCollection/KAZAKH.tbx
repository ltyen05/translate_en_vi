ry id="13310_264893_615699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that addresses the general activities involved in efforts to achieve more efficient SOX compliance. This project assumes that the organization is already SOX compliant.</descrip></descripGrp><ntig><termGrp><term id="264893">SOX Compliance and Technology Options</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615699">Sarbanes-Oxley стандарттары бойынша ақпараттық қауіпсіздікті қамтамасыз ету</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13311_164575_626291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character, such as diacritic, that has no meaning by itself, but overlaps a base character to modify it.</descrip></descripGrp><ntig><termGrp><term id="164575">non-spacing character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626291">дербес емес таңба</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13311_319181_626291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character, such as diacritic, that has no meaning by itself, but overlaps a base character to modify it.</descrip></descripGrp><ntig><termGrp><term id="319181">combining character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular