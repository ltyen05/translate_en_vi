mber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32785_1703364_1713609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of process that displays the input forms and the data that a user needs at each step while interacting with a customer or following a process that requires user input.</descrip></descripGrp><ntig><termGrp><term id="1703364">dialog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1713609">диалог</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32786_1703365_1713664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of logical rules that define the steps necessary to automate specific business processes, tasks, or sets of actions to be performed on Microsoft Dynamics CRM records.</descrip></descripGrp><ntig><termGrp><term id="1703365">workflow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1713664">жұмыс ағыны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32789_1703368_1764880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Functionality supplied by the Web Conferencing service such as data sharing, and uploading documents and PowerPoint presentations, by using whiteboards and desktop sharing.</descrip></descripGrp><ntig><termGrp><term id="1703368">web conferencing</term>