 type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2515209">тармақ</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3961_257508_1145220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbolic name that defines a class of users for a set of components. Each role defines which users are allowed to invoke interfaces on a component.</descrip></descripGrp><ntig><termGrp><term id="257508">role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1145220">рөл</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39618_2306966_2641220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual indication to inform the user of recent events.</descrip></descripGrp><ntig><termGrp><term id="2306966">user notification badge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2641220">хабарландыру таңбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39618_2635506_2641220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual indication to inform the user of recent events.</descrip></descripGrp><ntig><termGrp><term id="2635506">notification badge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2641220">хабарландыру таңбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39619_2307116_2308612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online meeting for Skype for Business, the professional meetings and communications app formerly known as Lync. Skype Meetings enable participants to use audio, video, IM, screen sharing and other features</descrip></descripGrp><ntig><termGrp><term id="2307116">Skype Meeting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2308612">Skype жиналысы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3962_3044409_627042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog that requires the user to take some action before the focus can switch to another form or dialog box. Dialog boxes and messages are usually modal.</descrip></descripGrp><ntig><termGrp><term id="3044409">modal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627042">модальды тілқатысу терезесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3962_81228_627042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog that requires the user to take some action before the focus can switch to another form or dialog box. Dialog boxes and messages are usually modal.</descrip></descripGrp><ntig><termGrp><term id="81228">modal dialog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627042">модальды тілқатысу терезесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3966_294271_638241"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal request to hire an employee to fill a specific position within the organization.</descrip></descripGrp><ntig><termGrp><term id="294271">hiring requisition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="638241">жұмысқа жалдау өтінімі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3967_93870_1906355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To submit content to an online forum for others to see.</descrip></descripGrp><ntig><termGrp><term id="93870">post</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1906355">жариялау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3967_93870_627249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To submit content to an online forum for others to see.</descrip></descripGrp><ntig><termGrp><term id="93870">post</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627249">орналастыру</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39686_2307925_2468852"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cross-disciplinary software development practice where operations and development engineers participate jointly in the complete service life cycle, from design through the development process to production support. Communication, collaboration, integration, automation, and measurement cooperation between developers and other information-technology (IT) professionals is encouraged and expected.</descrip></descripGrp><ntig><termGrp><term id="2307925">DevOps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2468852">DevOps</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39692_2308052_2309851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark or piece of information that you can add to a map, save, and share with others.</descrip></descripGrp><ntig><termGrp><term id="2308052">note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2309851">карта жазбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39692_2308052_2309852"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark or piece of information that you can add to a map, save, and share with others.</descrip></descripGrp><ntig><termGrp><term id="2308052">note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2309852">жазба</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39692_2308053_2309851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark or piece of information that you can add to a map, save, and share with others.</descrip></descripGrp><ntig><termGrp><term id="2308053">map note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2309851">карта жазбасы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39692_2308053_2309852"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark or piece of information that you can add to a map, save, and share with others.</descrip></descripGrp><ntig><termGrp><term id="2308053">map note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2309852">жазба</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3970_375726_615308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to publish updates to a previously published Web site quickly by publishing only those files you have updated.</descrip></descripGrp><ntig><termGrp><term id="375726">incremental publish to the Web</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615308">үстеме жарияланым</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39701_2308955_2654391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software development methodology intended to improve software quality and responsiveness to changing customer requirements through frequent releases in short development cycles, which is intended to improve productivity and introduce checkpoints at which new customer requirements can be adopted.</descrip></descripGrp><ntig><termGrp><term id="2308955">extreme programming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2654391">экстремалды бағдарламалау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39701_2309246_2654391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software development methodology intended to improve software quality and responsiveness to changing customer requirements through frequent releases in short development cycles, which is intended to improve productivity and introduce checkpoints at which new customer requirements can be adopted.</descrip></descripGrp><ntig><termGrp><term id="2309246">XP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2654391">экстремалды бағдарламалау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3972_44091_626429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that is automatically used by a program when the user does not specify an alternative and are built into a program when a value or option must be assumed for the program to function.</descrip></descripGrp><ntig><termGrp><term id="44091">default</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626429">әдепкі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3974_31934_2070250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined name used to refer to an OLE object in Visual Basic. A class name consists of the name of the application used to create the OLE object, the object's type, and, optionally, the version number of the application.</descrip></descripGrp><ntig><termGrp><term id="31934">class name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070250">Класс атауы:</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39791_2309123_2575167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An iterative and incremental agile software development methodology for managing product development defining "a flexible, holistic product development strategy where a development team works as a unit to reach a common goal", challenges assumptions of the "traditional, sequential approach" to product development, and enabling teams to self-organize by encouraging physical co-location or close online collaboration of all team members, as well as daily face-to-face communication among all team members and disciplines in the project.</descrip></descripGrp><ntig><termGrp><term id="2309123">Scrum</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2575167">Scrum</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39791_2309123_2856900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An iterative and incremental agile software development methodology for managing product development defining "a flexible, holistic product development strategy where a development team works as a unit to reach a common goal", challenges assumptions of the "traditional, sequential approach" to product development, and enabling teams to self-organize by encouraging physical co-location or close online collaboration of all team members, as well as daily face-to-face communication among all team members and disciplines in the project.</descrip></descripGrp><ntig><termGrp><term id="2309123">Scrum</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2856900">икемді Scrum әдісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39791_2856027_2575167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An iterative and incremental agile software development methodology for managing product development defining "a flexible, holistic product development strategy where a development team works as a unit to reach a common goal", challenges assumptions of the "traditional, sequential approach" to product development, and enabling teams to self-organize by encouraging physical co-location or close online collaboration of all team members, as well as daily face-to-face communication among all team members and disciplines in the project.</descrip></descripGrp><ntig><termGrp><term id="2856027">Agile Scrum</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2575167">Scrum</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39791_2856027_2856900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An iterative and incremental agile software development methodology for managing product development defining "a flexible, holistic product development strategy where a development team works as a unit to reach a common goal", challenges assumptions of the "traditional, sequential approach" to product development, and enabling teams to self-organize by encouraging physical co-location or close online collaboration of all team members, as well as daily face-to-face communication among all team members and disciplines in the project.</descrip></descripGrp><ntig><termGrp><term id="2856027">Agile Scrum</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2856900">икемді Scrum әдісі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="398_119516_2221511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SQL Server internal client/server data transfer protocol. TDS allows client and server products to communicate regardless of operating-system platform, server release, or network transport.</descrip></descripGrp><ntig><termGrp><term id="119516">tabular data stream</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221511">кестелік деректер ағыны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="398_119516_2221529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SQL Server internal client/server data transfer protocol. TDS allows client and server products to communicate regardless of operating-system platform, server release, or network transport.</descrip></descripGrp><ntig><termGrp><term id="119516">tabular data stream</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221529">TDS</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="398_119517_2221511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SQL Server internal client/server data transfer protocol. TDS allows client and server products to communicate regardless of operating-system platform, server release, or network transport.</descrip></descripGrp><ntig><termGrp><term id="119517">TDS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221511">кестелік деректер ағыны</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="398_119517_2221529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SQL Server internal client/server data transfer protocol. TDS allows client and server products to communicate regardless of operating-system platform, server release, or network transport.</descrip></descripGrp><ntig><termGrp><term id="119517">TDS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2221529">TDS</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3980_37784_1771307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To acknowledge an action or the value of some data (e.g. password) by definite assurance.</descrip></descripGrp><ntig><termGrp><term id="37784">confirm</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1771307">растау</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39836_2309204_2654412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software development approach where developers must first write a test that fails before they write the code to make the test succeed.</descrip></descripGrp><ntig><termGrp><term id="2309204">TDD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2654412">сынақ негізінде әзірлеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39836_2309244_2654412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software development approach where developers must first write a test that fails before they write the code to make the test succeed.</descrip></descripGrp><ntig><termGrp><term id="2309244">test-driven development</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2654412">сынақ негізінде әзірлеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3984_343651_2070251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A decision made with up-to-date information.</descrip></descripGrp><ntig><termGrp><term id="343651">informed decision</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070251">негізделген шешім</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumb