a different processing thread from the action that raised the event. The event handler and the action are processed simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1098535">asynchronous event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1131613">асинхронды оқиға</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24104_1098536_1131614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event whose handler runs in the same processing thread as the action that raised the event. The action cannot continue until processing is complete for the event handler.</descrip></descripGrp><ntig><termGrp><term id="1098536">synchronous event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1131614">синхронды оқиға</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24105_1098537_1131615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An asynchronous event whose handler runs only after the action that raised the event is complete.</descrip></descripGrp><ntig><termGrp><term id="1098537">after event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="1131615">әрекеттен кейінгі оқиға</term><termNote type="geographicalUsage">KAZ</ter