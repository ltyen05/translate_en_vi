ompleted</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2425502">Орындалғандар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42729_2421540_2425504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Classroom view where teachers can view the progress of the assignments that they have assigned for any of their classes.</descrip></descripGrp><ntig><termGrp><term id="2421540">In progress</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2425504">Орындалуда</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42730_2421541_2896806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams tool that allows teachers to create, distribute, track, and review student work and that allows students to track due dates, turn in their work, and check feedback.</descrip></descripGrp><ntig><termGrp><term id="2421541">Assignments</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2896806">Тағайындаулар</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type=