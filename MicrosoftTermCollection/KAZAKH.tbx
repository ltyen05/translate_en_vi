et xml:lang="en-US"><descripGrp><descrip type="definition">The default data type for variables that don't have type-declaration characters when a Deftype statement isn't in effect. A Variant can store numeric, string, date/time, Null, or Empty data.</descrip></descripGrp><ntig><termGrp><term id="149730">Variant data type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2093893">"Variant" деректер түрі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8468_184201_615822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Content has been hashed but could not be verified as valid against the signature.</descrip></descripGrp><ntig><termGrp><term id="184201">Signed - unverified</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="615822">қол қойылған - тексерілмеген</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8472_105648_2219829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a cluster, the process of systematically upgrading cluster nodes one node at a time while the other nodes continue to provide service.</descrip></descripGrp><ntig><termGrp><term id="105648">rolling upgrade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><te