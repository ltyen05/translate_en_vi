ақтауы құралы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="905_228494_2070114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A monetary debt or obligation of future services.</descrip></descripGrp><ntig><termGrp><term id="228494">liability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070114">қарыз</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9050_35663_2194817"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The order in which the user must type a command-line command or utility name and any arguments and options that follow it.</descrip></descripGrp><ntig><termGrp><term id="35663">command syntax</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2194817">пәрмен жолының синтаксисі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9050_35663_719936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The order in which the user must type a command-line command or utility name and any arguments and options that follow it.</descrip></descripGrp><ntig><termGrp><term id="35663">command syntax</term><termNote type="partOfS