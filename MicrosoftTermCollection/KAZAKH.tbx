mNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12830_725793_626448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a graphical user interface such as Windows, a pattern or picture in the screen background that can be chosen by the user.</descrip></descripGrp><ntig><termGrp><term id="725793">desktop background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626448">өң суреті</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12838_73230_626886"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To attach a label to.</descrip></descripGrp><ntig><termGrp><term id="73230">label</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626886">белгілеу</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12839_420872_2098764"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft .NET Framework programming model for developing graphical user interfaces.</descrip></descripGrp><ntig><termGrp><term id="420872">Windows Forms</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098764">Windows Forms</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1284_370915_2070133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables you to store, track, and restore an object by automatically maintaining previous versions of the object.</descrip></descripGrp><ntig><termGrp><term id="370915">versioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070133">нұсқаларды басқару</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12841_12529_2098765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-bit character set used by Microsoft Windows that allows you to represent up to 256 characters (0 through 255) by using your keyboard. The ASCII character set is a subset of the ANSI set.</descrip></descripGrp><ntig><termGrp><term id="12529">ANSI character set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098765">ANSI таңбалар жиынтығы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12845_44281_626437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On IBM and PC-compatible computers, a key whose function changes depending on the application program. Usually it erases the character under the cursor, although in some applications it can erase selected text or graphics.</descrip></descripGrp><ntig><termGrp><term id="44281">DELETE key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="626437">DELETE пернесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12846_373352_2098766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The extent to which links are followed within sites when crawling for content. Measured in number of links.</descrip></descripGrp><ntig><termGrp><term id="373352">page depth</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098766">бет қарау тереңдігі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1285_143904_2070134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A language used to interpret keystrokes from the keyboard, which can result in different characters appearing than what is printed on the physical keyboard.</descrip></descripGrp><ntig><termGrp><term id="143904">keyboard language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2070134">пернетақта тілі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12851_52010_2202958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In SQL Trace, a collection of properties that define an event.</descrip></descripGrp><ntig><termGrp><term id="52010">event class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2202958">оқиға класы</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12857_13730_2098767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window that serves as an interface between the user and the application.</descrip></descripGrp><ntig><termGrp><term id="13730">application window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2098767">бағдарлама терезесі</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1286_584250_779534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic map that can document procedures, analyze processes, indicate work or information flow, or track cost and efficiency.</descrip></descripGrp><ntig><termGrp><term id="584250">flowchart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNu