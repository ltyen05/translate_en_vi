gular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="627533">тік тырнақша</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45617_2572043_2576884"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An average of the secure scores of organizations that have a similar number of Office 365 active seats.</descrip></descripGrp><ntig><termGrp><term id="2572043">active seat average score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2576884">белсенді жұмыс орындары бойынша орташа баға</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45618_2572044_2576898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of tools and dashboards in the Office 365 Security &amp; Compliance Center that monitors signals from sources, analyzes them based on a repository of threat intelligence, and presents data that allows decision makers and administrators to react to threats.</descrip></descripGrp><ntig><termGrp><term id="2572044">Office 365 Threat Intelligence</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kk"><ntig><termGrp><term id="2576898">Office 365 Threat Intelligence</term><termNote type="geographicalUsage">KAZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gra