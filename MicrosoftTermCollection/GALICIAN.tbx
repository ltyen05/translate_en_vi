gl"><ntig><termGrp><term id="1538531">aplicación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7369_80126_497799"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information about the properties or structure of data that is not part of the values the data contains.</descrip></descripGrp><ntig><termGrp><term id="80126">metadata</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497799">metadatos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7373_87506_1178747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An association between two tables in which the primary key value of each record in the primary table corresponds to the value in the matching field or fields of many records in the related table.</descrip></descripGrp><ntig><termGrp><term id="87506">one-to-many relationship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178747">relación un a varios</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7376_1146759_2913216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of computer programs in which one or more users in