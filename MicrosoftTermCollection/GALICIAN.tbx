ransmit data, measured by the number of events, or signal changes, that occur in one second.</descrip></descripGrp><ntig><termGrp><term id="20603">baud rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178184">velocidade en baudios</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46600_2621935_2622324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test that reveals flaws in the security mechanisms of a computer systems, showing if they protect data and maintain functionality as intended.</descrip></descripGrp><ntig><termGrp><term id="2621935">security test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2622324">proba de seguranza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46601_2621936_2624006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 portal that contains Microsoft 365 security and compliance features.</descrip></descripGrp><ntig><termGrp><term id="2621936">Security &amp; Compliance Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2624006">Centro de seguranza e cumprimento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</term