of, including data about user and guest volume as well as messaging activity.</descrip></descripGrp><ntig><termGrp><term id="2900640">Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2900891">Insights</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51557_2901206_2901515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The licensing model in which Power BI Premium features are licensed on a per user basis.</descrip></descripGrp><ntig><termGrp><term id="2901206">Premium per user</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2901515">Premium por usuario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51557_2901206_2901526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The licensing model in which Power BI Premium features are licensed on a per user basis.</descrip></descripGrp><ntig><termGrp><term id="2901206">Premium per user</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2901526">Power BI Premium por usuario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51557_2901207_2901515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The licensing model in which Power BI Premium features are licensed on a per user basis.</descrip></descripGrp><ntig><termGrp><term id="2901207">Power BI Premium per user</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2901515">Premium por usuario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51557_2901207_2901526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The licensing model in which Power BI Premium features are licensed on a per user basis.</descrip></descripGrp><ntig><termGrp><term id="2901207">Power BI Premium per user</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2901526">Power BI Premium por usuario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51563_2901221_2901632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A third-party device (such as a camera, headset, phone, or room accessory) that has been certified via the Microsoft device Certification Program to provide a compatible experience when used with specific Microsoft software.</descrip></descripGrp><ntig><termGrp><term id="2901221">certified device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2901632">dispositivo certificado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51574_2901680_2901936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The journey a website visitor follows leading to a purchase.</descrip></descripGrp><ntig><termGrp><term id="2901680">conversion funnel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2901936">funil de conversión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51578_2901804_2901865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Feature (either built into Windows or available as the Windows Lookup app) to allow users to select a word or group of words and look up more information, definition or translation.</descrip></descripGrp><ntig><termGrp><term id="2901804">Lookup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2901865">Busca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5158_154233_498257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An industry-standard Internet tunneling protocol that provides encapsulation for sending Point-to-Point Protocol (PPP) frames across packet-oriented media. For IP networks, L2TP traffic is sent as User Datagram Protocol (UDP) messages. In Microsoft operating systems, L2TP is used in conjunction with Internet Protocol security (IPSec) as a virtual private network (VPN) technology to provide remote access or router-to-router VPN connections. L2TP is described in RFC 2661.</descrip></descripGrp><ntig><termGrp><term id="154233">Layer Two Tunneling Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498257">protocolo de túnel de capa 2</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5158_154233_498901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An industry-standard Internet tunneling protocol that provides encapsulation for sending Point-to-Point Protocol (PPP) frames across packet-oriented media. For IP networks, L2TP traffic is sent as User Datagram Protocol (UDP) messages. In Microsoft operating systems, L2TP is used in conjunction with Internet Protocol security (IPSec) as a virtual private network (VPN) technology to provide remote access or router-to-router VPN connections. L2TP is described in RFC 2661.</descrip></descripGrp><ntig><termGrp><term id="154233">Layer Two Tunneling Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498901">L2TP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5158_318115_498257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An industry-standard Internet tunneling protocol that provides encapsulation for sending Point-to-Point Protocol (PPP) frames across packet-oriented media. For IP networks, L2TP traffic is sent as User Datagram Protocol (UDP) messages. In Microsoft operating systems, L2TP is used in conjunction with Internet Protocol security (IPSec) as a virtual private network (VPN) technology to provide remote access or router-to-router VPN connections. L2TP is described in RFC 2661.</descrip></descripGrp><ntig><termGrp><term id="318115">L2TP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498257">protocolo de túnel de capa 2</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5158_318115_498901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An industry-standard Internet tunneling protocol that provides encapsulation for sending Point-to-Point Protocol (PPP) frames across packet-oriented media. For IP networks, L2TP traffic is sent as User Datagram Protocol (UDP) messages. In Microsoft operating systems, L2TP is used in conjunction with Internet Protocol security (IPSec) as a virtual private network (VPN) technology to provide remote access or router-to-router VPN connections. L2TP is described in RFC 2661.</descrip></descripGrp><ntig><termGrp><term id="318115">L2TP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498901">L2TP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51586_2902141_2903150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style in Word that shows text with a dotted underline.</descrip></descripGrp><ntig><termGrp><term id="2902141">Smart Hyperlink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2903150">hiperligazón intelixente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51587_2902142_2903157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style in Word that shows text as blue with a blue underline.</descrip></descripGrp><ntig><termGrp><term id="2902142">SmartLink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2903157">ligazón intelixente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51589_2902145_2903140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conceptual container that allows a company administrator to restrict the users and groups that an admin can manage to only those in a specific department, region, or any segment that their organization defines.</descrip></descripGrp><ntig><termGrp><term id="2902145">administrative unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2903140">unidade administrativa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51589_2910377_2903140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conceptual container that allows a company administrator to restrict the users and groups that an admin can manage to only those in a specific department, region, or any segment that their organization defines.</descrip></descripGrp><ntig><termGrp><term id="2910377">AU</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2903140">unidade administrativa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51593_2902151_2903146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An isolated group within an organizational structure that has little to no interaction with other groups, often leading to a lack of collaboration and other negative outcomes.</descrip></descripGrp><ntig><termGrp><term id="2902151">silo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2903146">silo</term><termNote type="