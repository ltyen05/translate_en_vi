rip type="definition">A search method that lets you direct your search using conversational language.</descrip></descripGrp><ntig><termGrp><term id="318314">natural query syntax</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498921">sintaxe de consulta natural</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45129_2547452_2548652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The custom visual that allows you to visualize two measures over time, showing their trend based on a joint timeline.</descrip></descripGrp><ntig><termGrp><term id="2547452">Dual KPI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2548652">Dual KPI</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45130_2547453_2548653"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that exceeds the number of days old the latest date in the dataset can be.</descrip></descripGrp><ntig><termGrp><term id="2547453">stale data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2548653">datos obsoletos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><te