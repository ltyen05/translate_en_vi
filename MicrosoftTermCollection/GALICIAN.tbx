alicious content harmless.</descrip></descripGrp><ntig><termGrp><term id="2329598">ZAP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2332091">ZAP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40091_2329598_2332092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email protection feature that detects messages with phish, spam, or malware that have already been delivered to your users' inboxes, and then renders the malicious content harmless.</descrip></descripGrp><ntig><termGrp><term id="2329598">ZAP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2332092">Purga automática na hora cero</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40092_2329599_2332088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of add-ins that transform pages from a variety of apps into sways.</descrip></descripGrp><ntig><termGrp><term id="2329599">Send to Sway</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2332088">Enviar a Sway</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40093_2329763_2332086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The blog platform on Docs.com where users can share their posts using Sway.</descrip></descripGrp><ntig><termGrp><term id="2329763">Journal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2332086">Diario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40107_2330211_2332084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SharePoint authoring tool that allows users to create different types of SharePoint pages such as microsites, articles, and blogs.</descrip></descripGrp><ntig><termGrp><term id="2330211">authoring canvas</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2332084">Lenzo de creación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40108_2330214_2332089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The container that holds all the tools for the authoring canvas.</descrip></descripGrp><ntig><termGrp><term id="2330214">toolbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2332089">Caixa de ferramentas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40109_2330388_2332087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables customers to satisfy stringent SEC Rule 17a-4 record retention requirements with advanced administrative controls for archiving such as restricting changes to archiving policies and preventing such policies from being turned off or removed.</descrip></descripGrp><ntig><termGrp><term id="2330388">Preservation Lock</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2332087">Bloqueo de preservación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40111_2330390_2333207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A generic reference to an organization's Windows Store for Business to offer specific content to their users, and for users to download approved content.</descrip></descripGrp><ntig><termGrp><term id="2330390">private store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2333207">tenda privada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40112_2330405_2333195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A map downloaded to your PC, phone or tablet that can be used to get directions and search for places even when you are not connected to the Internet.</descrip></descripGrp><ntig><termGrp><term id="2330405">offline map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2333195">mapa sen conexión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40115_2331026_2365950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the mechanisms that the HTTP protocol provides for web cache validation, and which allows a client to make conditional requests.</descrip></descripGrp><ntig><termGrp><term id="2331026">ETag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2365950">ETag</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40115_2331027_2365950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the mechanisms that the HTTP protocol provides for web cache validation, and which allows a client to make conditional requests.</descrip></descripGrp><ntig><termGrp><term id="2331027">entity tag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2365950">ETag</term><termNo