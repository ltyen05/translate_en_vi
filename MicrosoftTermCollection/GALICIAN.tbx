indows 10. With these settings, information technology administrators decide when and which devices receive updates in their organization, and set different schedules for groups of devices. They can also pause updates for individual devices.</descrip></descripGrp><ntig><termGrp><term id="2579456">Windows Update for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2580504">Windows Update para empresas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45792_2579483_2814300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A segment for which both static and dynamic profiles are combined.</descrip></descripGrp><ntig><termGrp><term id="2579483">compound segment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2814300">segmento composto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45793_2579484_2814301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A segment that is refreshed automatically. Dynamic segments are defined by rules and their contents change over time.</descrip></descripGrp><ntig><termGrp><term id="2579484">dynamic segment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2814301">segmento dinámico</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45794_2579485_2814299"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A result of a business initiative.</descrip></descripGrp><ntig><termGrp><term id="2579485">business outcome</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2814299">resultado empresarial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45795_2579486_2814303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A classification that allows users to identify attribute profiles as A, B, or C for the prediction being generated and enables users to efficiently plan targeted follow-ups.</descrip></descripGrp><ntig><termGrp><term id="2579486">grade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2814303">grao</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45796_2579487_2814305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A match that indicates the prediction policy was not able to map the different data sources to the same entity, but the likelihood the match is accurate and relevant is high.</descrip></descripGrp><ntig><termGrp><term id="2579487">inferred match</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2814305">coincidencia inferida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45797_2579488_2814306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card that displays information regarding the predictive matches for a given profile in a form similar to a visiting card, along with other insights.</descrip></descripGrp><ntig><termGrp><term id="2579488">info card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2814306">cartón de información</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45798_2579489_2814307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A representation of an event or activity of relevance to a business.</descrip></descripGrp><ntig><termGrp><term id="2579489">interaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2814307">interacción</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45799_2579490_2814309"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limit against which other match values can be compared. Only matches with a score equal to or higher than this limit value will be displayed.</descrip></descripGrp><ntig><termGrp><term id="2579490">match threshold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2814309">limiar de coincidencia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45800_2579491_2814310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifier of the user who owns the Azure instance.</descrip></descripGrp><ntig><termGrp><term id="2579491">owning user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2814310">usuario propietario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45801_2579492_2814311"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A forecast of a value from a machine learning model.</descrip></descripGrp><ntig><termGrp><term id="2579492">prediction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2814311">predición</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45802_2579493_2814312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attribute of a profile taken into account when generating predictions.</descrip></descripGrp><ntig><termGrp><term id="2579493">predictive grade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2814312">grao de predición</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45803_2579494_2814313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A match made from a combination of data from multiple sources. Data coming from various sources often uses different fields to uniquely identify records and contains different values.</descrip></descripGrp><ntig><termGrp><term id="2579494">predictive match</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2814313">coincidencia preditiva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45804_2579495_2814314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules defined by the user to obtain a list of potentially matching entities, of either profiles or interactions.</descrip></descripGrp><ntig><termGrp><term id="2579495">predictive match policy</term><termNote type="partOfSpeech">Noun</termNote><termNo