tervention of a human operator, automatically routing calls based on selections made by the caller.</descrip></descripGrp><ntig><termGrp><term id="2754105">auto attendant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2764553">operador automático na nube</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10637_2754779_2764551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that supplies callers with information and performs an action without the intervention of a human operator, automatically routing calls based on selections made by the caller.</descrip></descripGrp><ntig><termGrp><term id="2754779">Cloud auto attendant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2764551">operador automático</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10637_2754779_2764553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that supplies callers with information and performs an action without the intervention of a human operator, automatically routing calls based on selections made by the caller.</descrip></descripGrp><ntig><termGrp><term id="2754779">Cloud auto attendant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2764553">operador automático na nube</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10657_307433_412280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The prefix that is used to direct a call internationally. The International Access Code is 011 in the United States and 00 in much of the rest of the world.</descrip></descripGrp><ntig><termGrp><term id="307433">international access code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412280">código de acceso internacional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10675_338607_2016133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A setting for the phone keyboard that causes a key to continue to produce a tone as long as the key is pressed.</descrip></descripGrp><ntig><termGrp><term id="338607">Long tones</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2016133">Tons longos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10678_103034_1698341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application, commonly part of a database management program, that uses a report form created by the user to lay out and print the contents of a database. A report generator is used to select specific record fields or ranges of records, to make the output attractive by including such features as headings, running heads, page numbers, and fonts.</descrip></descripGrp><ntig><termGrp><term id="103034">report generator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1698341">xerador de informes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10678_103035_1698341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application, commonly part of a database management program, that uses a report form created by the user to lay out and print the contents of a database. A report generator is used to select specific record fields or ranges of records, to make the output attractive by including such features as headings, running heads, page numbers, and fonts.</descrip></descripGrp><ntig><termGrp><term id="103035">report writer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1698341">xerador de informes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10681_110083_1178783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who sends an electronic message.</descrip></descripGrp><ntig><termGrp><term