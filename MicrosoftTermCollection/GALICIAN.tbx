rip></descripGrp><ntig><termGrp><term id="2343497">distributor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2344291">distribuidor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40288_2343547_2392958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A heat map of user location over a selected period of time.</descrip></descripGrp><ntig><termGrp><term id="2343547">active user map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2392958">mapa de usuarios activos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40289_2343550_2392986"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that has a valid client certificate installed.</descrip></descripGrp><ntig><termGrp><term id="2343550">managed device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2392986">dispositivo xestionado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40290_2343551_2393014"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that does not have a valid client certificate installed.</descrip></descripGrp><ntig><termGrp><term id="2343551">unmanaged device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2393014">dispositivo non xestionado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40291_2343552_2393006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove access to your cloud service environment.</descrip></descripGrp><ntig><termGrp><term id="2343552">suspend</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2393006">suspender</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40292_2343553_2393016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reinstate access to your cloud service environment.</descrip></descripGrp><ntig><termGrp><term id="2343553">unsuspend</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2393016">anular suspensión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40293_2343554_2393004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An in-line deployment mode that provides ultimate control over user activities and data in motion, but requires traffic routing through the Adallom cloud.</descrip></descripGrp><ntig><termGrp><term id="2343554">SmartProxy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2393004">SmartProxy</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40294_2343730_2344292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short video clip that can be downloaded from Skype in a package of similar video clips, and can be inserted into a chat conversation.​</descrip></descripGrp><ntig><termGrp><term id="2343730">Moji</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2344292">Moji</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40297_2343749_2392961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An out-of-band, non-intrusive deployment mode that integrates directly into the framework of enterprise cloud applications, taking only a few minutes per application to set up.</descrip></descripGrp><ntig><termGrp><term id="2343749">API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><ter