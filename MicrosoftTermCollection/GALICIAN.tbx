3_2407699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that allows users to find and navigate to a specific section of a sway, similar to an interactive table of contents.</descrip></descripGrp><ntig><termGrp><term id="2405683">Universal Navigation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2407699">Navegación universal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42447_2405688_2407696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway view that shows users a list of templates from which they can start their sway.</descrip></descripGrp><ntig><termGrp><term id="2405688">Start from a template</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2407696">Comezar a partir dun modelo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42448_2405693_2407688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway panel that contains all of the different Group options.</descrip></descripGrp><ntig><termGrp><term id="2405693">Group Type</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2407688">Tipo de grupo</term><termNote type="geographicalUsage