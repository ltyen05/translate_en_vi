></descripGrp><ntig><termGrp><term id="2844113">Interesting Calendars</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2847441">Calendarios interesantes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50292_2844117_2847463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 connected experience that adds the full address of a public place in the Location field when the user adds the name of this public place to a calendar item. Within an organization, it also suggests available meeting rooms, public places from Bing Maps, and other locations from the user's meeting history.</descrip></descripGrp><ntig><termGrp><term id="2844117">Location suggestions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2847463">suxestións de localización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50293_2844118_2853109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color from the Outlook calendar color palette.</descrip></descripGrp><ntig><termGrp><term id="2844118">burgundy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2853109">borgoña</term><termNote type="geographicalUsage">ESP</termNote><termNote type