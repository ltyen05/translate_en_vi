 unit and can be referenced or reused multiple times.</descrip></descripGrp><ntig><termGrp><term id="1162493">set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1660415">conxunto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1250_530462_1183341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A grouping of dimension members or items from a data source that are named and treated as a single unit and can be referenced or reused multiple times.</descrip></descripGrp><ntig><termGrp><term id="530462">named set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1183341">conxunto con nome</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1250_530462_1660415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A grouping of dimension members or items from a data source that are named and treated as a single unit and can be referenced or reused multiple times.</descrip></descripGrp><ntig><termGrp><term id="530462">named set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1660415">conxunto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</