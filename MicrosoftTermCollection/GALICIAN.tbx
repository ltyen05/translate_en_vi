that was not written by the owners of the project.</descrip></descripGrp><ntig><termGrp><term id="2522800">third-party code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2525492">código de terceiros</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44821_2522807_2525489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform used by Microsoft products for payment integration.</descrip></descripGrp><ntig><termGrp><term id="2522807">Microsoft Seller Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2525489">Centro de vendedores de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44823_2524057_2575157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware accessory that allows you to take action in mixed reality. It tracks a precise position in space, allowing for fine-grained interaction with digital objects. When using a Windows Mixed Reality immersive headset, the motion controller is the primary way to take action.</descrip></descripGrp><ntig><termGrp><term id="2524057">motion controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2575157">controlador de movemento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44823_2524057_2575168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware accessory that allows you to take action in mixed reality. It tracks a precise position in space, allowing for fine-grained interaction with digital objects. When using a Windows Mixed Reality immersive headset, the motion controller is the primary way to take action.</descrip></descripGrp><ntig><termGrp><term id="2524057">motion controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2575168">controlador de movemento de Windows Mixed Reality</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44823_2531456_2575157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware accessory that allows you to take action in mixed reality. It tracks a precise position in space, allowing for fine-grained interaction with digital objects. When using a Windows Mixed Reality immersive headset, the motion controller is the primary way to take action.</descrip></descripGrp><ntig><termGrp><term id="2531456">Windows Mixed Reality motion controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2575157">controlador de movemento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="gramma