rip></descripGrp><ntig><termGrp><term id="3097647">time zone rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3098220">regra do fuso horario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54538_3098584_3098629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Dynamics 365 Project Operations for developers who need to test integrations with Project Operations API’s.</descrip></descripGrp><ntig><termGrp><term id="3098584">API Testing Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3098629">Portal de probas das API</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54539_3099039_3099631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The holiday that commemorates the birthday of His Majesty King Charles III.</descrip></descripGrp><ntig><termGrp><term id="3099039">King’s Birthday</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3099631">Aniversario do Rei</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54540_3099040_3099630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The holiday that commemorates the crowning of His Majesty King Charles III.</descrip></descripGrp><ntig><termGrp><term id="3099040">Coronation Day for King Charles III</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3099630">Día da Coroación do Rei Carlos III</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54541_3099042_3102304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows leaders to encourage open dialog and feedback across communities and teams through news, Ask Me Anything (AMA) events, surveys, and more in Viva Engage.</descrip></descripGrp><ntig><termGrp><term id="3099042">Leadership Corner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3102304">Espazo de liderado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54542_3099043_3102299"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of metrics available to Viva suite licensed customers that allows users to gain a deeper understanding of engagement and trends happening across Viva Engage.</descrip></descripGrp><ntig><termGrp><term id="3099043">Advanced Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3102299">Análises avanzadas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54543_3099094_3099192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI model that lets users read and save information from standard documents such as invoices or tax documents. When they automate this process, they can save valuable time by reviewing, extracting, organizing, and saving the data automatically by using Power Automate and Power Apps.</descrip></descripGrp><ntig><termGrp><term id="3099094">document processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3099192">procesamento de documentos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54544_3099095_3099193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A machine that allows users to build, test, and run attended and unattended desktop flows without providing or setting up any physical machines.</descrip></descripGrp><ntig><termGrp><term id="3099095">hosted machine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3099193">máquina aloxada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54545_3099096_3099194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category name for connectors that are submitted and maintained by external connector developers and are published to the Power Platform for use directly from within the product. Independent publishers do not own the underlying service behind their connector.</descrip></descripGrp><ntig><termGrp><term id="3099096">independent publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3099194">publicador independente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54546_3099097_3099195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The extent to which a person or entity has a right to use software in a particular way, as described in the terms of the license agreement.</descrip></descripGrp><ntig><termGrp><term id="3099097">license coverage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3099195">cobertura de licenza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54547_3099098_3099197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of actions which may be referenced as a group within a desktop flow.</descrip></descripGrp><ntig><termG