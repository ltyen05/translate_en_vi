ditor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48376_2735256_2738005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A company that creates drivers.</descrip></descripGrp><ntig><termGrp><term id="2735256">vendor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2738005">fornecedor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48377_2735257_2737992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To use a session to retrieve a file from a remote computer.</descrip></descripGrp><ntig><termGrp><term id="2735257">get</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2737992">obter</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48378_2735258_2737989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To use a session to put a file in a remote computer.</descrip></descripGrp><ntig><termGrp><term id="2735258">drop</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2737989">depositar</ter