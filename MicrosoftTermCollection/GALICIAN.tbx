59"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ° character</descrip></descripGrp><ntig><termGrp><term id="44224">DEGREE SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498959">símbolo de graos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3627_168528_1688691"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A meeting participant who can do all sharing activities, including presenting, showing, sharing, and whiteboard, and admit participants from the lobby.</descrip></descripGrp><ntig><termGrp><term id="168528">presenter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1688691">moderador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3628_142420_2094466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Use to display instructions for using a form, command buttons, or unbound controls to accept input. Displays at the bottom of the form in Form view and at the end of a printout.</descrip></descripGrp><ntig><termGrp><term id="142420">form footer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094466">pé de páxina do formulario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="363_145555_498199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection between an OLE object and its OLE server, or between a dynamic data exchange (DDE) source document and a destination document.</descrip></descripGrp><ntig><termGrp><term id="145555">OLE/DDE link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498199">ligazón OLE/DDE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="363_145555_499138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection between an OLE object and its OLE server, or between a dynamic data exchange (DDE) source document and a destination document.</descrip></descripGrp><ntig><termGrp><term id="145555">OLE/DDE link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="499138">ligazón</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="363_358322_498199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection between an OLE object and its OLE server, or between a dynamic data exchange (DDE) source document and a destination document.</descrip></descripGrp><ntig><termGrp><term id="358322">link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498199">ligazón OLE/DDE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="363_358322_499138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection between an OLE object and its OLE server, or between a dynamic data exchange (DDE) source document and a destination document.</descrip></descripGrp><ntig><termGrp><term id="358322">link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="499138">ligazón</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3633_44143_497531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In some dialog boxes, the command button that is selected or highlighted when the dialog box is initially displayed. The default button has a bold border, indicating that it will be chosen automatically if you press ENTER. You can override a default button by clicking Cancel or another command button.</descrip></descripGrp><ntig><termGrp><term id="44143">default button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497531">botón predefinido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3634_27320_497397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To revoke an action by quitting it without saving any changes that it would result in.</descrip></descripGrp><ntig><termGrp><term id="27320">cancel</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497397">cancelar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3638_53737_497620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area in a window or record that stores a single data value.</descrip></descripGrp><ntig><termGrp><term id="53737">field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497620">campo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3641_211084_1303166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The specific description in a contract of the service support to be provided, including pricing and how support is to be allotted.</descrip></descripGrp><ntig><termGrp><term id="211084">contract line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1303166">liña de contrato</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3643_323598_499031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool in Windows Vista that backs up the entire computer (OS, settings, and files).</descrip></descripGrp><ntig><termGrp><term id="323598">Complete PC Backup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="499031">copia de seguranza CompletePC</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3644_116003_497989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statistical measure of the amount by which a set of values differs from the arithmetical mean, equal to the square root of the mean of the differences' squares.</descrip></descripGrp><ntig><termGrp><term id="116003">standard deviation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497989">desviación estándar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3655_85228_497829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hyphen that is used to prevent a hyphenated word, number, or phrase from breaking if it falls at the end of a line.</descrip></descripGrp><ntig><termGrp><term id="85228">nonbreaking hyphen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497829">guión de non separación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3657_16207_2767294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A characteristic of an object.</descrip></descripGrp><ntig><termGrp><term id="16207">attribute</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2767294">atributo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3659_319140_498971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ( character.</descrip></descripGrp><ntig><termGrp><term id="319140">opening parenthesis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498971">paréntese de apertura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3662_77222_497774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that makes the screen more readable by people who have low vision by creating a separate window that displays a magnified portion of the screen.</descrip></descripGrp><ntig><termGrp><term id="77222">Magnifier</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497774">Lupa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3672_446292_1276391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account, and its information, that is included within another account.</descrip></descripGrp><ntig><termGrp><term id="446292">sub-account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1276391">subconta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36774_2070563_2086131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subset of settings and features that can be assigned to one of four slots in action center for quick, one-tap access. In addition, they can provide useful, actionable, or critical info regarding the setting or feature.</descrip></descripGrp><ntig><termGrp><term id="2070563">quick action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086131">acción rápida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36775_2070564_2086157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that is built using the Windows universal app platform. Developers can create a Windows universal app that runs on all Windows-based device types, or they can choose to limit an app to specific devices.</descrip></descripGrp><ntig><termGrp><term id="2070564">universal app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086157">aplicación universal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36775_2247950_2086157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that is built using the Windows universal app platform. Developers can create a Windows universal app that runs on all Windows-based device types, or they can choose to limit an app to specific devices.</descrip></descripGrp><ntig><termGrp><term id="2247950">Windows universal app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086157">aplicación universal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36776_2070565_2086108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To provide Wi-Fi credentials to Outlook.com contacts, Skype contacts, and Facebook friends.</descrip></descripGrp><ntig><termGrp><term id="2070565">exchange</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086108">intercambiar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36778_2071066_2086113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone's volume mode when in a call.</descrip></descripGrp><ntig><termGrp><term id="2071066">In-Call</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086113">Chamada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36779_2071067_2086104"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of data connection in a roaming area. Generally making phone calls or using your data connection when the phone is roaming is more expensive, and the user will be charged additional fees for voice roaming calls.</descrip></descripGrp><ntig><termGrp><term id="2071067">data roaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086104">itinerancia de datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36780_2071068_2086163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The connection on your phone that allows you to make phone calls.</descrip></descripGrp><ntig><termGrp><term id="2071068">voice connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086163">conexión de voz</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36781_2071069_2086165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone call made in a roaming area. Generally making phone calls or using your data connection when the phone is roaming is more expensive, and the user will be charged additional fees for voice roaming calls.</descrip></descripGrp><ntig><termGrp><term id="2071069">voice roaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086165">itinerancia de voz</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36783_2071243_2086136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The setting that determines if the screen will rotate automatically when the phone is rotated.</descrip></descripGrp><ntig><termGrp><term id="2071243">screen rotation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086136">rotación de pantalla</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36784_2071244_2086169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft operating system designed for handheld portable devices.</descrip></descripGrp><ntig><termGrp><term id="2071244">Windows Embedded Handheld</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086169">Windows Embedded Handheld</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36785_2071245_2086168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft operating system built on Windows Phone 8 designed for handheld portable devices.</descrip></descripGrp><ntig><termGrp><term id="2071245">Windows Embedded 8 Handheld</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086168">Windows Embedded 8 Handheld</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36786_2071246_2072315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predetermined text reply that can be automatically sent in response to incoming calls, text messages, or both when Driving Mode is turned on. The text reply is sent with no action on the part of the user.</descrip></descripGrp><ntig><termGrp><term id="2071246">text reply</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2072315">resposta de texto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36787_2071247_2086148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A response to an incoming call using a text message when the caller is a contact calling from a mobile phone.</descrip></descripGrp><ntig><termGrp><term id="2071247">text reply</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086148">enviar SMS de resposta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36790_2071376_2086137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera option to capture just one image when the user presses the camera button.</descrip></descripGrp><ntig><termGrp><term id="2071376">single photo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086137">unha foto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36791_2071377_2086140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo you can choose to use as the background for some Live Tiles on the Start screen.</descrip></descripGrp><ntig><termGrp><term id="2071377">Start background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086140">fondo de inicio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36792_2071378_2086161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Phone feature to upgrade a phone call into a Skype video call.</descrip></descripGrp><ntig><termGrp><term id="2071378">video upgrade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086161">cambio a videochamada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36793_2071379_2086167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual setting that enables app screen content to display in a window.</descrip></descripGrp><ntig><termGrp><term id="2071379">windowed mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086167">modo ventá</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36794_2071380_2086109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual setting that is similar to “stretch” - the resolution of the phone screen is refitted to fill as much of the external screen as possible without compromising its dimensionality.</descrip></descripGrp><ntig><termGrp><term id="2071380">expanded screen mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086109">modo pantalla expandida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36795_2071381_2086130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows desktop application that is required to enable users to project their phone screen to a Windows device using a USB connection.</descrip></descripGrp><ntig><termGrp><term id="2071381">Project My Screen App</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086130">Aplicación Proxectar a miña pantalla</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2072311_2077811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2072311">Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2077811">Grupos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2072311_2378769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2072311">Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2378769">Grupos de Office 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2072311_2875709"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2072311">Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2875709">Grupos de Microsoft 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2874478_2077811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2874478">Microsoft 365 Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2077811">Grupos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2874478_2378769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2874478">Microsoft 365 Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2378769">Grupos de Office 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2874478_2875709"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2874478">Microsoft 365 Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2875709">Grupos de Microsoft 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36806_2072312_2077813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The database that stores search feature settings which include but are not limited to query rules and the search schema.</descrip></descripGrp><ntig><termGrp><term id="2072312">search settings database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2077813">base de datos de configuración de busca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36807_2072313_2077812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to record on-screen activity, and embeds the video automatically in PowerPoint.</descrip></descripGrp><ntig><termGrp><term id="2072313">Screen Recording</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2077812">gravación de pantalla</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36824_2077814_2103960"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Skype software application that uses the non-desktop user interface introduced with Windows 8.</descrip></descripGrp><ntig><termGrp><term id="2077814">Skype for modern Windows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2103960">Skype para Windows moderno</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36825_2078795_2246351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Skype software application for Windows desktop.</descrip></descripGrp><ntig><termGrp><term id="2078795">Skype for Windows desktop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2246351">Skype para escritorio de Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36831_2082095_2105932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A management object that contains the connection settings and administrator credentials for the source server that hosts the mailboxes that you want to migrate to Exchange Online.</descrip></descripGrp><ntig><termGrp><term id="2082095">Migration Endpoint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2105932">Extremo de migración</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36832_2085426_2094003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that contains the most commonly used contextual commands such as Cut, Copy, Paste, Comment, and Proofing.</descrip></descripGrp><ntig><termGrp><term id="2085426">Mini Toolbar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094003">Minibarra de ferramentas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36833_2085429_2094002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A yellow bar with a warning icon appearing below the ribbon that provides information or alerts the user. Information can be security alerts, errors, or notifications.</descrip></descripGrp><ntig><termGrp><term id="2085429">Message Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094002">Barra de mensaxes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36834_2085430_2094005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that shows the progress of an operation.</descrip></descripGrp><ntig><termGrp><term id="2085430">Progress UI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094005">IU de progreso</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36835_2085431_2094004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recurring meeting that does not have a standard pattern of daily, weekly, monthly, etc.</descrip></descripGrp><ntig><termGrp><term id="2085431">custom repeat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094004">repetición personalizada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36836_2086047_2094001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The icon on the upper-left corner of the Office 365 suite. The icon is the entry point to all Office 365 services for which the user has a valid subscription, and to the Admin center (only if the user is an admin).</descrip></descripGrp><ntig><termGrp><term id="2086047">app launcher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094001">iniciador de aplicacións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36839_2086613_2749585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Australia East region, located in New South Wales, within the Azure region taxonomy.</descrip></descripGrp><ntig><termGrp><term id="2086613">AU East</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2749585">Este de Australia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36839_2722799_2749585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Australia East region, located in New South Wales, within the Azure region taxonomy.</descrip></descripGrp><ntig><termGrp><term id="2722799">Australia East</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2749585">Este de Australia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36868_2093283_2105933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component in Exchange 2013 that performs background tasks, such as mailbox database maintenance, mailbox processing, inference training, calendar repair, offline address book generation, and more.</descrip></descripGrp><ntig><termGrp><term id="2093283">Time-Based Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2105933">Asistente para tarefas de duración definida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36869_2093284_2105934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component in Exchange 2013 that performs background tasks, such as mailbox database maintenance, mailbox processing, inference training, calendar repair, offline address book generation, and more.</descrip></descripGrp><ntig><termGrp><term id="2093284">Time-Based Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2105934">Asistente para tarefas de duración definida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36870_2093285_2105930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A time-based assistant (TBA) that parses emails and makes internal inferences based on them. Inferences are used to allow the system to gain insight into a user’s mailbox based on user patterns. Those inferences are then used to populate features for users, such as People View in Outlook Web App.</descrip></descripGrp><ntig><termGrp><term id="2093285">inference training</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2105930">aprendizaxe de inferencias</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36871_2093286_2105931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that feeds data (such as mailbox messages) to the inference training assistant in batches. It controls performance by giving the inference training assistant a fixed amount of work to process at each interval.</descrip></descripGrp><ntig><termGrp><term id="2093286">inference training feeder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2105931">alimentador de aprendizaxe de inferencias</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36872_2093287_2105926"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of OneNote for Android that allows you to create notes, audio notes, and picture notes right from your phone’s home screen.</descrip></descripGrp><ntig><termGrp><term id="2093287">widget</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2105926">widget</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36873_2093298_2105923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual tab on the Ribbon that enables the user to modify the appearance, size, and other aspects of the container controls in a form.</descrip></descripGrp><ntig><termGrp><term id="2093298">Control Tools</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2105923">ferramentas de control</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36880_2099681_2177776"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The on-screen keyboard key that traditionally (as in word processing) is used to insert tab characters into a document.</descrip></descripGrp><ntig><termGrp><term id="2099681">Tab</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2177776">tabulador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNou