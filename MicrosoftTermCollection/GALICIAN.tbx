cebook page, and posting on a Facebook page.</descrip></descripGrp><ntig><termGrp><term id="2015342">audience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2053838">público</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3494_308304_498812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who creates or maintains a weblog.</descrip></descripGrp><ntig><termGrp><term id="308304">blogger</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498812">blogueiro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3495_160383_1696193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area that shows available network connections and helps users quickly connect to the most appropriate one.</descrip></descripGrp><ntig><termGrp><term id="160383">Connection Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1696193">Xestor de conexións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3495_160383_498286"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area that shows available network connections and helps users quickly connect to the most appropriate one.</descrip></descripGrp><ntig><termGrp><term id="160383">Connection Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498286">xestor de conexión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34954_2016735_2020255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control used in Office 365 mobile applications to indicate navigation between applications in Office 365.</descrip></descripGrp><ntig><termGrp><term id="2016735">Office 365 global navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2020255">navegación global de Office 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34966_2017840_2177699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To show or share screen content in a display other than the primary display.</descrip></descripGrp><ntig><termGrp><term id="2017840">project</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2177699">proxectar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34967_2017939_2020257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that filters a user’s Inbox to only display email messages from people who are the user's frequent contacts. When a frequent contact sends the user a new email, the sender's photo is displayed beneath “People” in the Folder Pane. When the user selects the sender’s photo under “People,” email messages from that sender are displayed.</descrip></descripGrp><ntig><termGrp><term id="2017939">People view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2020257">visualización Xente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34968_2018622_2139910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An out of the box (OOB) solution where admins can set up and configure the applications that a customer service agent needs easily and quickly.</descrip></descripGrp><ntig><termGrp><term id="2018622">Unified Service Desk for Microsoft Dynamics CRM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2139910">USD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34968_2018622_2140359"><