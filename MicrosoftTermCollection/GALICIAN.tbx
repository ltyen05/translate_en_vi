ntry id="11135_146792_498208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of a document as it will appear when you print it.</descrip></descripGrp><ntig><termGrp><term id="146792">print preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498208">previsualización da impresión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1114_4659_1950417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A password that cannot be easily guessed or cracked and which is at least eight characters long, does not contain all or part of the user's account name, and contains at least three of the four following categories of characters: uppercase characters, lowercase characters, numbers, and symbols found on the keyboard (such as !, @, #).</descrip></descripGrp><ntig><termGrp><term id="4659">strong password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950417">contrasinal seguro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11140_359992_499157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A table outside the open database or project.</descrip></descripGrp><ntig><termGrp><term id="359992">external table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><lan