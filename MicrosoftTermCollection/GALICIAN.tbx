Number">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1294_346944_497683"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pictorial graphic such as a digital photograph or illustration.</descrip></descripGrp><ntig><termGrp><term id="346944">digital image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497683">imaxe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1294_346944_499094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pictorial graphic such as a digital photograph or illustration.</descrip></descripGrp><ntig><termGrp><term id="346944">digital image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="499094">imaxe dixital</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1294_370920_497683"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pictorial graphic such as a digital photograph or illustration.</descrip></descripGrp><ntig><termGrp><term id="370920">picture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497683">imaxe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNo