><descrip type="definition">In Microsoft 365 scores, a recommendation based on data from your organization, which, if completed, results directly or indirectly in points earned to improve your score. This can be a direct action like changing a setting, or an indirect action like providing training to users that encourages them to use a feature more.</descrip></descripGrp><ntig><termGrp><term id="2819449">recommendation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2821937">acción</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49868_2819449_2822349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft 365 scores, a recommendation based on data from your organization, which, if completed, results directly or indirectly in points earned to improve your score. This can be a direct action like changing a setting, or an indirect action like providing training to users that encourages them to use a feature more.</descrip></descripGrp><ntig><termGrp><term id="2819449">recommendation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2822349">acción de mellora</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49868_2819449_2822367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft 365 scores, a recommendation based on data from your organization, which, if completed, results directly or indirectly in points earned to improve your score. This can be a direct action like changing a setting, or an indirect action like providing training to users that encourages them to use a feature more.</descrip></descripGrp><ntig><termGrp><term id="2819449">recommendation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2822367">recomendación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49869_2819450_2822268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Status of a Microsoft Managed Desktop device if it meets all of these criteria: synced with Intune in the last 5 days AND at least 6 hours powered on and connected to Internet AND at least 2 hours continuously powered on and connected to Internet.</descrip></descripGrp><ntig><termGrp><term id="2819450">active</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2822268">activo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49870_2819451_2822272"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A minimum or starting point used for comparisons.</descrip></descripGrp><ntig><termGrp><term id="2819451">baseline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2822272">liña base</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49871_2819453_2822377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A summary page in Microsoft 365 admin center showing all scores for your organization side by side.</descrip></descripGrp><ntig><termGrp><term id="2819453">score overview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2822377">visión xeral de puntuación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49872_2819454_2822371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subcategory within a larger score such as Security Score, Compliance Score, Productivity Score, or User Experience Score.</descrip></descripGrp><ntig><termGrp><term id="2819454">score category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2822371">categoría de puntuación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49873_2819455_2822274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard or point of reference against which things may be compared or assessed.</descrip></descripGrp><ntig><te