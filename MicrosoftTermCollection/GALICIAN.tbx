"><ntig><termGrp><term id="2935744">Explorador de Automatización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51298_2890888_3147162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability for inspecting a text aiming at identifying the prevalent emotional opinion within the text, especially to determine if the writer's attitude is positive, negative, or neutral.</descrip></descripGrp><ntig><termGrp><term id="2890888">sentiment analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3147162">análise de opinión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51300_2890891_2935751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The concept of letting software robots perform actions, tasks, and processes that involves a web browser or web application.</descrip></descripGrp><ntig><termGrp><term id="2890891">Web Automation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2935751">Automatización Web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51301_2891089_2892095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Slovenian national holiday celebrated on June 25 to commemorate Slovenia's declaration of independence from Yugoslavia in 1991.</descrip></descripGrp><ntig><termGrp><term id="2891089">Statehood Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2892095">Día do Estado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51302_2891211_2892096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The national holiday in Bosnia and Herzegovina celebrated on November 25 to commemorate the day in 1943 on which ZAVNOBiH, the Anti-Fascist Council of Bosnia and Herzegovina, adopted a resolution to declare the country/region an equal community of Muslims, Serbs, and Croats.</descrip></descripGrp><ntig><termGrp><term id="2891211">Statehood Day (Bosnia and Herzegovina)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2892096">Día do Estado (Bosnia e Hercegovina)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51303_2891233_2892184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Czech national holiday celebrated on September 28 to commemorate the day in 935 on which St. Wenceslas, patron of the Czech state, was murdered by his brother.</descrip></descripGrp><ntig><termGrp><term id="2891233">Czech Statehood Day (St. Wenceslas Day)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2892184">Día do Estado checo (Día de S. Venceslao)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51304_2891239_2892089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Argentinian national holiday celebrated on June 20 to commemorate the Argentine flag and its creator, Manuel Belgrano.</descrip></descripGrp><ntig><termGrp><term id="2891239">Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2892089">Día da bandeira</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51305_2891254_2892092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The supplementary holiday day that may be granted during years in which Argentina's Flag Day occurs on a Tuesday or a Thursday and is used to create a four-day weekend.</descrip></descripGrp><ntig><termGrp><term id="2891254">Flag Day (bridge)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2892092">Día da bandeira (ponte)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51306_2891255_2892090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Mexican national holiday celebrated on February 24 to commemorate past and current flags of Mexico.</descrip></descripGrp><ntig><termGrp><term id="2891255">Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2892090">Día da bandeira</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51307_2891256_2892091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The national holiday in Poland celebrated on May 2 to commemorate the raising of the Polish flag over the Victory Column at the end of the Battle of Berlin in 1945.</descrip></descripGrp><ntig><termGrp><term id="2891256">Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2892091">Día da bandeira</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51308_2891257_2892093"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azerbaijan national holiday celebrated on November 9 to commemorate the adoption of the Flag of Azerbaijan on November 9, 1918.</descrip></descripGrp><ntig><termGrp><term id="2891257">National Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2892093">Día da bandeira nacional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51309_2891258_2892094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The day on which the Azerbaijan National Flag Day is celebrated if the official holiday itself falls on a weekend.</descrip></descripGrp><ntig><termGrp><term id="2891258">National Flag Day (Observed)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2892094">Día da bandeira nacional (compensado)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5131_159863_498282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of detecting and splitting video content into separate clips. Clips are created by Windows Movie Maker when there is a significant change from one frame to another.</descrip></descripGrp><ntig><termGrp><term id="159863">clip creation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498282">creación de clips</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51323_2892217_2893816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prevent a UI element such as an error, notification, button, or a visual feature such as line numbers or page margins, from appearing to the end user.</descrip></descripGrp><ntig><termGrp><term id="2892217">suppress</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2893816">suprimir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51330_2893119_2893814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Implies that the artifact (object or activity) or some of its characteristics deviate from what is considered ‘normal’; typically a statistical outlier.</descrip></descripGrp><ntig><termGrp><term id="2893119">anomalous</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2893814">anómalo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51331_2893120_2893815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number calculated to let the customer know how vulnerable devices in their organization are.</descrip></descripGrp><ntig><termGrp><term id="2893120">exposure score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2893815">puntuación de exposición</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51336_2893893_2907275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of tools that helps you create, reuse, and share Adaptive Cards.</descrip></descripGrp><ntig><termGrp><term id="2893893">templating</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2907275">modelos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51338_2893964_2894358"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft 365 Teams background effect that is limited only to uploading the user's own images.</descrip></descripGrp><ntig><termGrp><term id="2893964">custom background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2894358">fondo personalizado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51339_2893965_2894373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox Live matchmaking service that groups players based on user information and the request for any users who want to play together.</descrip></descripGrp><ntig><termGrp><term id="2893965">SmartMatch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2894373">SmartMatch</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51341_2894028_2894843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">​The next iteration of the Authenticator app in which users can save and automatically fill passwords, addresses, and payment info on mobile devices and computers (via browser extension).</descrip></descripGrp><ntig><termGrp><term id="2894028">Microsoft Autofill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2894843">Enchemento automático de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51343_2894031_2894841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of the Windows Clock app that allows the user to set a timer for a period of focus time.</descrip></descripGrp><ntig><termGrp><term id="2894031">Focus sessions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2894841">Sesións de concentración</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51347_2894037_2894844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The possibility for a person to input text in Windows with their voice (aka dictation).</descrip></descripGrp><ntig><termGrp><term id="2894037">voice typing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2894844">escritura de voz</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51349_2894217_2894832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The international holiday celebrated on March 8 that honors women and is commemorated in various ways around the world, including as a public holiday, a day of protest, or as a celebration of womanhood.</descrip></descripGrp><ntig><termGrp><term id="2894217">International Women's Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2894832">Día Internacional da Muller</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51350_2894218_2894834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Vietnamese public holiday celebrated on April 30 to commemorate the day in 1975 when North Vietnamese and Việt Cộng forces captured Saigon (now Ho Chi Minh City), signaling the end of the Vietnam War and the beginning of the reunification process.</descrip></descripGrp><ntig><termGrp><term id="2894218">Reunification Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2894834">Día da Reunificación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51351_2894219_2894836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The day on which the Vietnamese holiday Reunification Day is celebrated if the official holiday itself falls on a weekend.</descrip></descripGrp><ntig><termGrp><term id="2894219">Reunification Day (Observed)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2894836">Día da Reunificación (compensado)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51352_2894246_2895185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account from a social identity provider, such as Facebook or Google.</descrip></descripGrp><ntig><termGrp><term id="2894246">social account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2895185">conta de redes sociais</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51364_2894612_3024879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transport layer network protocol based on User Datagram Protocol (UDP), which can improve the performance of web applications that currently use TCP.</descrip></descripGrp><ntig><termGrp><term id="2894612">QUIC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3024879">QUIC</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51369_2894964_2895263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool that allows customers to compare their EOP policies settings against Microsoft's recommended settings for EOP and Office 365 ATP security.</descrip></descripGrp><ntig><termGrp><term id="2894964">Configuration Analyzer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2895263">Analizador de configuración</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51374_2895274_2935745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The component of the designer to capture sequence of user actions performed on a Windows desktop.</descrip></descripGrp><ntig><termGrp><term id="2895274">Desktop recorder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><lang