der">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43759_2468787_2470881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that enables customers to generate encryption keys on premises and send them securely to Azure-managed hardware security modules where they can be decrypted and used.</descrip></descripGrp><ntig><termGrp><term id="2468787">BYOK</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2470881">Bring Your Own Key</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43759_2468787_2470882"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that enables customers to generate encryption keys on premises and send them securely to Azure-managed hardware security modules where they can be decrypted and used.</descrip></descripGrp><ntig><termGrp><term id="2468787">BYOK</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2470882">BYOK</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43759_2468788_2470881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that enables customers to generate encryption keys on premises and send them securely to Azure-managed hardware security modules where they can be decrypted and used.</descrip></descripGrp><ntig><termGrp><term id="2468788">Bring Your Own Key</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2470881">Bring Your Own Key</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43759_2468788_2470882"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that enables customers to generate encryption keys on premises and send them securely to Azure-managed hardware security modules where they can be decrypted and used.</descrip></descripGrp><ntig><termGrp><term id="2468788">Bring Your Own Key</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2470882">BYOK</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4376_31635_1708232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A situation in which one object refers back to itself, either directly or indirectly.</descrip></descripGrp><ntig><termGrp><term id="31635">circular reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1708232">referencia circular</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43761_2469253_2470891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word print layout that allows horizontal movement between pages in a document.</descrip></descripGrp><ntig><termGrp><term id="2469253">Page-Stack navigation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2470891">Navegación de páxinas horizontal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43762_2469812_2472574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Sound that is spatialized or is precisely located around a listener in 3D space. Developers can use spatial sound in an application to convincingly place sounds in a 3D space all around the user. Sounds will then seem as if they are coming from real physical objects even though the user may only be using regular stereo headphones.</descrip></descripGrp><ntig><termGrp><term id="2469812">spatial sound</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2472574">son espacial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43768_2470183_2472575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Technology that enables a 3D graphics processor to display the image at the moment it is rendered for more fluid and better detailed gameplay, and for reducing or eliminating lag, stutter and frame tearing.</descrip></descripGrp><ntig><termGrp><term id="2470183">variable refresh rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2472575">frecuencia de actualización variable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43768_2470183_2472577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Technology that enables a 3D graphics processor to display the image at the moment it is rendered for more fluid and better detailed gameplay, and for reducing or eliminating lag, stutter and frame tearing.</descrip></descripGrp><ntig><termGrp><term id="2470183">variable refresh rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2472577">VRR</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43768_2470196_2472575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Technology that enables a 3D graphics processor to display the image at the moment it is rendered for more fluid and better detailed gameplay, and for reducing or eliminating lag, stutter and frame tearing.</descrip></descripGrp><ntig><termGrp><term id="2470196">VRR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2472575">frecuencia de actualización variable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43768_2470196_2472577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Technology that enables a 3D graphics processor to display the image at the moment it is rendered for more fluid and better detailed gameplay, and for reducing or eliminating lag, stutter and frame tearing.</descrip></descripGrp><ntig><termGrp><term id="2470196">VRR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2472577">VRR</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43769_2470203_2471794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Advanced Threat Protection reporting feature that gives users interactive, personalized visual reports of the threats to their organization, provides context for attacks, and that provides actionable steps for protection.</descrip></descripGrp><ntig><termGrp><term id="2470203">Threat explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2471794">Explorador de ameazas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43785_2470551_2766742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The solution class that contains solutions to create development and testing environments so that you can deliver features faster.</descrip></descripGrp><ntig><termGrp><term id="2470551">Development and test</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2766742">Desenvolvemento e probas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43798_2758211_2766740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated set of BI services which include Power BI, PowerApps, and Microsoft Flow.</descrip></descripGrp><ntig><termGrp><term id="2758211">Microsoft Power Platform</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2766740">Microsoft Power Platform</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43798_2758211_2766741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated set of BI services which include Power BI, PowerApps, and Microsoft Flow.</descrip></descripGrp><ntig><termGrp><term id="2758211">Microsoft Power Platform</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2766741">Power Platform</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43798_2758212_2766740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated set of BI services which include Power BI, PowerApps, and Microsoft Flow.</descrip></descripGrp><ntig><termGrp><term id="2758212">Power Platform</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2766740">Microsoft Power Platform</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43798_2758212_2766741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated set of BI services which include Power BI, PowerApps, and Microsoft Flow.</descrip></descripGrp><ntig><termGrp><term id="2758212">Power Platform</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2766741">Power Platform</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43799_2470927_2471573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The lightweight markup language with plain text formatting syntax designed to be converted to HTML and other formats and that is used to format readme files, write messages in online discussion forums, and create rich text using a plain text editor.</descrip></descripGrp><ntig><termGrp><term id="2470927">Markdown</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2471573">Markdown</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43800_2470929_2471574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word add-in that converts Markdown documents to Word format for editing and then converts the Word document back to Markdown format, using the Paragraph, Table, List, and Range objects.</descrip></descripGrp><ntig><termGrp><term id="2470929">Markdown editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2471574">Markdown editor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43809_2471187_2497975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component type of the app designer that includes entities, dashboards, and business process flows.</descrip></descripGrp><ntig><termGrp><term id="2471187">artifact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2497975">artefacto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43810_2471606_2497977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customizable area of an app, site map, or view designer where users can add or edit different components of a business app.</descrip></descripGrp><ntig><termGrp><term id="2471606">canvas</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2497977">lenzo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43811_2471609_2497973"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stage in a business process flow that uses an automated process for gathering data.</descrip></descripGrp><ntig><termGrp><term id="2471609">action step</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2497973">paso de acción</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43812_2471610_2497976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customized rule that applies form logic without users having to write code or create plug-ins. Users can create business rules to set or clear form field values, validate data and errors, and create business recommendations based on business intelligence.</descrip></descripGrp><ntig><termGrp><term id="2471610">business rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2497976">regra de negocio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43813_2471611_2474861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numerical summary of an organization's security posture based on system configurations, user behavior and other security related measurements that represents the extent to which an organization has adopted security controls in their Microsoft environment which can help offset the risk of being breached.</descrip></descripGrp><ntig><termGrp><term id="2471611">secure score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2474861">puntuación de seguranza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43814_2471613_2497978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A format used to create an action card in the Relationship Assistant in Dynamics 365.</descrip></descripGrp><ntig><termGrp><term id="2471613">card form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2497978">formulario de cartón</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43815_2471614_2497985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display window that shows users a variety of relevant data-driven insights and news from their contacts, watch list, leads, opportunities, accounts, and social media.</descrip></descripGrp><ntig><termGrp><term id="2471614">Insights pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2497985">panel de Insights</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43816_2471615_2497974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive designer that simplifies the app building experience so users can create and customize their own business apps with charts, entities, dashboards, forms, views, and business processes.</descrip></descripGrp><ntig><termGrp><term id="2471615">app designer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2497974">deseñador de aplicacións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43817_2471616_2497987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive feature within the app designer that offers users a simplified way to design, edit, or customize how they view and access customer and business data.</descrip></descripGrp><ntig><termGrp><term id="2471616">view designer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2497987">deseñador de visualizacións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43820_2471849_2497982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of plug-ins registered on an external data provider to implement support for connecting virtual entities to external data.</descrip></descripGrp><ntig><termGrp><term id="2471849">entity data provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2497982">fornecedor de datos de entidades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43821_2471850_2497983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Connection information used by an external data provider for a virtual entity to retrieve and display external data.</descrip></descripGrp><ntig><termGrp><term id="2471850">entity data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2497983">orixe de datos da entidade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43822_2471851_2497979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stage in business process flow that uses user input to gather data.</descrip></descripGrp><ntig><termGrp><term id="2471851">data step</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2497979">paso de datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43823_2471852_2497984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A representation of progress toward a sales goal: identify leads, qualify, develop, propose, and close.</descrip></descripGrp><ntig><termGrp><term id="2471852">funnel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2497984">funil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43827_2472567_2496856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A movie created in the Photos app, featuring a set of related pictures and videos combined with a soundtrack, transitions and other effects. This term can also be used to refer to the set of photos and videos included in the story. ​A story may be created automatically by the app, or manually by the user.</descrip></descripGrp><ntig><termGrp><term id="2472567">story</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2496856">historia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4384_319144_498972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The “ character.</descrip></descripGrp><ntig><termGrp><term id="319144">opening quotation mark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498972">comiñas dobres de apertura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4384_319145_498972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The “ character.</descrip></descripGrp><ntig><termGrp><term id="319145">opening curly quotation mark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498972">comiñas dobres de apertura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4384_319146_498972"><langSet xml:lang="en-US"><descripGrp><d