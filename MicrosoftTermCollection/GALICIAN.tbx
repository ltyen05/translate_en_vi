que identifier that contains no proof key, as it is considered the owner and, therefore, there is no need to prove ownership.</descrip></descripGrp><ntig><termGrp><term id="2285238">bearer token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2365947">token de portador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39386_2510032_2365947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifier that contains no proof key, as it is considered the owner and, therefore, there is no need to prove ownership.</descrip></descripGrp><ntig><termGrp><term id="2510032">bearer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2365947">token de portador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3939_2774568_2776007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The action of combining the report layout with the data from the data source for the purpose of viewing the report.</descrip></descripGrp><ntig><termGrp><term id="2774568">rendering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2776007">procesamento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote ty