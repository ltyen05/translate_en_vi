ss Ultimate.</descrip></descripGrp><ntig><termGrp><term id="2898061">Xbox All Access</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2898371">Xbox All Access</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51487_2898926_2901591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based application that allows information to be shared between Microsoft Business Solutions and partners. PSBC features key information about the partner organizations and their customers, such as sales numbers, customer lists, and support call history.</descrip></descripGrp><ntig><termGrp><term id="2898926">PartnerSource Business Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2901591">PartnerSource Business Center</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51488_2898927_2901548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft website that provides product and service information, a technical database, downloads, documentation, and online training as a benefit to Dynamics customers.</descrip></descripGrp><ntig><termGrp><term id="2898927">CustomerSource</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lan