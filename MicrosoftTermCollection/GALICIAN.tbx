">click</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913445">clic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34388_1991498_2913446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The wired controller cable.</descrip></descripGrp><ntig><termGrp><term id="1991498">controller cable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913446">cable do mando</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34389_1991499_2588910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button on both the wireless controller and the console used to make a permanent attachment between the controller and console.</descrip></descripGrp><ntig><termGrp><term id="1991499">connect button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2588910">botón de conexión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3439_26498_2094406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control used on a form, report, or data access page to display the result of an expression. The result is recalculated each time there is a change in any of the values that the expression is based on.</descrip></descripGrp><ntig><termGrp><term id="26498">calculated control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094406">control calculado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34390_1991500_2913448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Port on the controller to which peripherals, such as a headset, may be connected.</descrip></descripGrp><ntig><termGrp><term id="1991500">expansion port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913448">porto de expansión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34391_1991501_2913454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The controller cable release.</descrip></descripGrp><ntig><termGrp><term id="1991501">inline release</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913454">desconexión de seguridade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><term