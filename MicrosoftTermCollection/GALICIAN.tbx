></descripGrp><ntig><termGrp><term id="2794546">ACR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2795786">informe de conformidade de accesibilidade de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49326_2794547_2795778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The design of mainstream products and services that are accessible to, and usable by, as many people as reasonably possible without the need for special adaptation or specialised design, as defined by the British Standards Institute.</descrip></descripGrp><ntig><termGrp><term id="2794547">inclusive design</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2795778">deseño inclusivo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49327_2794548_2795779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A design that meets inclusive design principles.</descrip></descripGrp><ntig><termGrp><term id="2794548">inclusive design</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2795779">diseño inclusivo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote 