 type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2057820">Ausente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33617_1805611_2016173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The interface that enables users to see what is consuming the storage space on their phone, displaying the space used by apps, games, media, settings, and more. It also allows moving content from phone to SD card.</descrip></descripGrp><ntig><termGrp><term id="1805611">phone storage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2016173">almacenamento do teléfono</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33617_1805611_2086143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The interface that enables users to see what is consuming the storage space on their phone, displaying the space used by apps, games, media, settings, and more. It also allows moving content from phone to SD card.</descrip></descripGrp><ntig><termGrp><term id="1805611">phone storage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086143">Sensor de almacenamento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Prop