Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3060659">uso compartido de contido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53727_3059305_3060658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams that enables users to join a meeting from a conference room with their own personal device.</descrip></descripGrp><ntig><termGrp><term id="3059305">companion device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3060658">dispositivo complementario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53728_3059306_3060664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows you to share content from physical whiteboards and documents in a high-quality way during meetings.</descrip></descripGrp><ntig><termGrp><term id="3059306">intelligent content capture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3060664">captura intelixente de contido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53729_3059307_3060660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables Microsoft 365 Enterprise users to streamline communication, collaboration, and meeting-related tasks using spoken natural language.</descrip></descripGrp><ntig><termGrp><term id="3059307">Cortana voice assistance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3060660">asistencia de voz de Cortana</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53730_3059308_3060661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to join a third-party online meeting from their Teams Rooms just as easily as they can join meetings hosted in Teams.</descrip></descripGrp><ntig><termGrp><term id="3059308">Direct Guest Join</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3060661">Conexión directa de convidados</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53731_3059309_3060662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera that supports AI-powered active speaker tracking, multiple video streams, and people recognition.</descrip></descripGrp><ntig><termGrp><term id="3059309">intelligent camera</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3060662">cámara intelixente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53732_3187998_3064419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Clipchamp, the paid plan that offers access to premium features for everyday editors.</descrip></descripGrp><ntig><termGrp><term id="3187998">Premium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3064419">Básico</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53733_3060419_3072783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area in Clipchamp's video editor where all components are assembled and arranged on tracks.</descrip></descripGrp><ntig><termGrp><term id="3060419">timeline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3072783">liña de tempo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53734_3060420_3072784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of the timeline where editing elements such as videos, images, audio, stickers, text blocks, etc. are placed and arranged to create a video.</descrip></descripGrp><ntig><termGrp><term id="3060420">track</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3072784">pista</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53735_3060421_3064409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of branded assets such as logos, fonts, colors and images that are uploaded to be used in graphic designing or video editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060421">brand kit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3064409">kit de marca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53736_3060422_3072777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video clip from a library of professional stock assets that is integrated in the Clipchamp video editor for use in editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060422">stock video</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3072777">vídeo de arquivo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53737_3060423_3072775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio clip from a library of professional stock assets that is integrated in the Clipchamp video editor for use in editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060423">stock audio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3072775">audio de arquivo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53738_3060424_3072776"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image/photo from a library of professional stock assets that is integrated in the Clipchamp video editor for use in editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060424">stock image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3072776">imaxe de arquivo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53739_3060425_3068209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of visual elements such as animated clips, GIFs, images, colored backgrounds or overlays that are used in video editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060425">graphics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3068209">gráficos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53740_3060426_3072774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An animated or still image such as a cartoon figure that can be inserted in video editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060426">sticker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3072774">adhesivo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53741_3060427_3070889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of an aspect ratio preset in Clipchamp that lets users create videos that have the correct height and width to be uploaded as videos on popular social media platforms.</descrip></descripGrp><ntig><termGrp><term id="3060427">Social</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3070889">Medios sociais</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53742_3060428_3064422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video editing transition effect used to move from one video clip to another.</descrip></descripGrp><ntig><termGrp><term id="3060428">fade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3064422">fundido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53743_3060429_3068203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Clipchamp, to break assets on the timeline of a video editing project into multiple smaller segments.</descrip></descripGrp><ntig><termGrp><term id="3060429">cut</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3068203">cortar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53744_3060430_3066589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transition effect placed at the beginning of a video clip that gradually increases the visibility of the image or the sound of an audio track.</descrip></descripGrp><ntig><termGrp><term id="3060430">fade in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3066589">fundido de entrada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53744_3060431_3066589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transition effect placed at the beginning of a video clip that gradually increases the visibility of the image or the sound of an audio track.</descrip></descripGrp><ntig><termGrp><term id="3060431">fade-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3066589">fundido de entrada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53745_3060432_3068206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transition effect placed at the end of a video clip that gradually decreases the visibility of the image or the sound of an audio track.</descrip></descripGrp><ntig><termGrp><term id="3060432">fade out</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3068206">fundido de saída</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53745_3060433_3068206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transition effect placed at the end of a video clip that gradually decreases the visibility of the image or the sound of an audio track.</descrip></descripGrp><ntig><termGrp><term id="3060433">fade-out</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig