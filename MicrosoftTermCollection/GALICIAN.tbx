mNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53901_3068403_3068631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">This status consumes a resource's capacity. A booking typically has this status when you open Maintain Bookings from the Team Members grid on the Project’s main form or the view bookings on the schedule board.</descrip></descripGrp><ntig><termGrp><term id="3068403">hard book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3068631">reserva firme</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53902_3068404_3068632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contract line that contains details that may help calculate the cost and potential revenue of the work involved to deliver the contract line.</descrip></descripGrp><ntig><termGrp><term id="3068404">project contract line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3068632">liña de contrato do proxecto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53903_3068405_3068633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status of soft bookings is only available to be set from the schedule board when booking a project’s primary requirement. Similar to “proposed bookings”, soft bookings do not consume a resource’s capacity can be used for preliminary resource planning purposes.</descrip></descripGrp><ntig><termGrp><term id="3068405">soft book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3068633">reserva variable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53904_3068406_3068634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that allows Project Manager to buy vendor resource time to staff project tasks and resource requirements.</descrip></descripGrp><ntig><termGrp><term id="3068406">subcontract line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3068634">liña de subcontratación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53905_3068407_3068635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A basic group for project transactions that are not company or transaction type-specific. For example, Design, Travel, Installation, and Service Transaction categories to group Project transactions.</descrip></descripGrp><ntig><termGrp><term id="3068407">transaction category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3068635">categoría da transacción</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53906_3069030_3070689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Lookup &amp; Reference Excel function that returns all matching fields(s) from the linked data type specified in the value argument.</descrip></descripGrp><ntig><termGrp><term id="3069030">FIELDVALUE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3070689">VALORCAMPO</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53907_3069186_3072651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use or study of the English language by non-native speakers in an English-speaking environment.</descrip></descripGrp><ntig><termGrp><term id="3069186">English as a second language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3072651">inglés como segundo idioma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53907_3069186_3072655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use or study of the English language by non-native speakers in an English-speaking environme