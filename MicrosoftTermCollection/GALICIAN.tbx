her person is posting on the feed.</descrip></descripGrp><ntig><termGrp><term id="2160537">Unfollow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2215254">Deixar de seguir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37816_2160541_2215255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button in Yammer that allows users to undo the application of the "Like" button for a post.</descrip></descripGrp><ntig><termGrp><term id="2160541">Unlike</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2215255">Non me gusta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37817_2160552_2215260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy describing the rules for using a service that a new user must accept in order to use that service.</descrip></descripGrp><ntig><termGrp><term id="2160552">usage policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2215260">política de uso</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig