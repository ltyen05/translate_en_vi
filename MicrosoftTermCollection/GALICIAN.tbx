ech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2399007">Entrada manuscrita para teléfono</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42393_2397415_2398687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word Mobile tab that allows users to choose the color, thickness, and style that they want their ink to appear as.</descrip></descripGrp><ntig><termGrp><term id="2397415">Draw</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2398687">Escoller</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42394_2397416_2399008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PowerPoint Designer feature that scans users' text for well-defined structures, such as timelines or processes, and converts them to visual representations.</descrip></descripGrp><ntig><termGrp><term id="2397416">Text to SmartArt</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2399008">Texto para converter a SmartArt</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig