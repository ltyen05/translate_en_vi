 id="6075">what-if analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1139719">análise de hipóteses</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10275_6076_1139719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of changing the values in cells to see how those changes affect the outcome of formulas on a worksheet. For example, varying the interest rate that is used in an amortization table to determine the amount of the payments.</descrip></descripGrp><ntig><termGrp><term id="6076">"what-if" evaluation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1139719">análise de hipóteses</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10276_232855_498470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that displays the Web page in a Web browser.</descrip></descripGrp><ntig><termGrp><term id="232855">Web Page Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498470">previsualización da páxina web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammatica