441990_2451120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft touchscreen accessory for Surface devices that allows users to access menus and scroll and swipe through documents and images.</descrip></descripGrp><ntig><termGrp><term id="2441990">Surface Dial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2451120">Surface Dial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43107_2441993_2451121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft all-in-one touchscreen computer.</descrip></descripGrp><ntig><termGrp><term id="2441993">Surface Studio</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2451121">Surface Studio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43109_2441995_2449878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of 500 or more documents that are used for training Advanced eDiscovery, and whose themes are the same as the type of documents that need to be analyzed.</descrip></descripGrp><ntig><termGrp><term id="2441995">control set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2449878">conxunto de documentos</term><ter