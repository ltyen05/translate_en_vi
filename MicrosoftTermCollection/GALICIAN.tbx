ker in a group call to match the position of the speaker (i.e right or left).</descrip></descripGrp><ntig><termGrp><term id="1814266">true sound</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2057899">Son real</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33735_1814267_2057900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera that can be used with a television set to make video calls.</descrip></descripGrp><ntig><termGrp><term id="1814267">TV cam</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2057900">cámara para TV</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33736_1814672_2057902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A part of a Skype subscription offer that allows a user to call to selected destination(s) within limits defined by the Fair Usage Policy.</descrip></descripGrp><ntig><termGrp><term id="1814672">unlimited calls</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2057902">chamadas sen límite</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33737_1814673_2057901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Characteristic of a subscription which gives you, for a per-month fee, unlimited calls to a selected country/region; e.g. Unlimited Portugal.</descrip></descripGrp><ntig><termGrp><term id="1814673">Unlimited</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2057901">sen límite</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33738_1814780_2057905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A free internet call between two Skype users seeing each other via webcam.</descrip></descripGrp><ntig><termGrp><term id="1814780">video call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2057905">chat de vídeo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33738_1815075_2057905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A free internet call between two Skype users seeing each other via webcam.</descrip></descripGrp><ntig><termGrp><term id="1815075">video chat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2057905">chat de vídeo</term><