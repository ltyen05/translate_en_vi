n where text or an image (typically indicating the button's function) may be displayed.</descrip></descripGrp><ntig><termGrp><term id="25636">button face</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497382">cara do botón</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13594_503136_1688820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The presence status that indicates a user hasn't used his/her mouse, keyboard, computer, mobile phone, or communications device for a specified time.</descrip></descripGrp><ntig><termGrp><term id="503136">Inactive</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1688820">Inactivo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13598_26923_497395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that notifies a user that a call is coming in while the user is in a call.</descrip></descripGrp><ntig><termGrp><term id="26923">call waiting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497395">chamada en espera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="136_557698_1302597"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system job that detects duplicate records for one entity.</descrip></descripGrp><ntig><termGrp><term id="557698">Bulk Duplicate Detection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1302597">Detección de duplicados en masa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1360_358369_363239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encoding mechanism that converts binary data into printable ASCII characters so that the data can be included in the message body without violating SMTP conventions.</descrip></descripGrp><ntig><termGrp><term id="358369">UUENCODE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="363239">UUENCODE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13604_34469_497455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The particular range of colors that a device or color model is able to produce.</descrip></descripGrp><ntig><termGrp><term id="34469">color gamut</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp>