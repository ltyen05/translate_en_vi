</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2479771">optar por participar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56650_3189681_3190772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unified Copilot experience in Word that helps users to create, edit, transform and organize documents efficiently.</descrip></descripGrp><ntig><termGrp><term id="3189681">Microsoft 365 Copilot in Word</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3190772">Copilot en Word</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56650_3189681_3190778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unified Copilot experience in Word that helps users to create, edit, transform and organize documents efficiently.</descrip></descripGrp><ntig><termGrp><term id="3189681">Microsoft 365 Copilot in Word</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3190778">Microsoft 365 Copilot en Word</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></term