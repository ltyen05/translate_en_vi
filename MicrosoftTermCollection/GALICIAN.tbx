393735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customized shortened URL used for tweets, leaving room for text to use the business brand in the link.</descrip></descripGrp><ntig><termGrp><term id="2391817">branded URL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2393735">URL de marca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42267_2391822_2393741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The serious vulnerability that affects HTTPS and other services that rely on SSL and TLS, allowing attackers to break the encryption and read or steal sensitive information.</descrip></descripGrp><ntig><termGrp><term id="2391822">DROWN</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2393741">DROWN</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42273_2391828_2393748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The distributed security service which runs on Azure that helps isolate and destroy malware by analyzing millions of potential exploit and malware samples in virtual machines.</descrip></descripGrp><ntig><termGrp><term id="2391828">Microsoft Malware Detonation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></lan