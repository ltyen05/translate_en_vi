<termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1764187">lista externa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24587_1136147_2612321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process when one entity authenticates itself to a second entity and the second entity authenticates itself to the first entity. In networking, two routers often perform mutual authentication in order to create a connection.</descrip></descripGrp><ntig><termGrp><term id="1136147">mutual authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2612321">autenticación mutua</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24590_1136151_1995590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task page in the Windows Control Panel from where customers can get real-time status information about their network, and also make changes to settings.</descrip></descripGrp><ntig><termGrp><term id="1136151">Network and Sharing Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1995590">Centro de rede e uso compartido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type=