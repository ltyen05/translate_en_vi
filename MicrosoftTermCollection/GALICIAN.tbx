">Someone who uses sign language.</descrip></descripGrp><ntig><termGrp><term id="3063995">signer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3065662">usuario da lingua de signos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53837_3064385_3065643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service category that combines expert-trained technology with human-led services to help organizations achieve more secure, compliant, and productive outcomes.</descrip></descripGrp><ntig><termGrp><term id="3064385">Microsoft Security Experts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3065643">Expertos en seguridade de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53841_3065532_3099852"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark that appears in the user interface guiding the user through a product experience.</descrip></descripGrp><ntig><termGrp><term id="3065532">coachmark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3099852">marca de orientación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGend