e type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2015260">telemetría</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2496_1275091_1688687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A privacy relationship setting that allows the most amount of information to be viewed.</descrip></descripGrp><ntig><termGrp><term id="1275091">Friends and Family</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1688687">Amigos e familiares</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2496_418562_1688687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A privacy relationship setting that allows the most amount of information to be viewed.</descrip></descripGrp><ntig><termGrp><term id="418562">Personal</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1688687">Amigos e familiares</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24966_1166067_1950207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intermediary between a software publisher and a certification authority (CA). The local registration authority can, for example, verify a publisher's credentials before sending them to the CA.</descrip></descripGrp><ntig><termGrp><term id="1166067">local registration authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950207">autoridade de rexistro local</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24966_1166067_1950210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intermediary between a software publisher and a certification authority (CA). The local registration authority can, for example, verify a publisher's credentials before sending them to the CA.</descrip></descripGrp><ntig><termGrp><term id="1166067">local registration authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950210">LRA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24966_1166080_1950207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intermediary between a software publisher and a certification authority (CA). The local registration authority can, for example, verify a publisher's credentials before sending them to the CA.</descrip></descripGrp><ntig><termGrp><term id="1166080">LRA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatic