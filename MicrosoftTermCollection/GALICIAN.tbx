 xml:lang="gl"><ntig><termGrp><term id="1658108">Definir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32153_1637189_1658258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image that is bounded by a picture frame.</descrip></descripGrp><ntig><termGrp><term id="1637189">picture content</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1658258">contido da imaxe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32154_1637190_1658270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A site template that is designed to provide lightweight project management functionality, including Tasks, Calendar, Timeline, and Project Summary.</descrip></descripGrp><ntig><termGrp><term id="1637190">Project Site</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1658270">Sitio de proxecto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32155_1637191_1660279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An animation effect that plays when the value of a cell is recalculated. The old value slides out of the bottom as the new value slides in from the top.</descrip></descripGrp><ntig><termGrp><term id="1637191">recalculation animation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1660279">animación de recálculo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32156_1637192_1660520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of tasks that includes the predecessors and successors to the task that is selected.</descrip></descripGrp><ntig><termGrp><term id="1637192">task path</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1660520">camiño á tarefa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32157_1637193_1660432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A streamlined process for sharing Office documents with others.</descrip></descripGrp><ntig><termGrp><term id="1637193">simplified sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1660432">uso compartido simplificado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32159_1637282_1660417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A website that provides content and resources to help developers create custom solutions for SharePoint Foundation, SharePoint Server and SharePoint Designer.</descrip></descripGrp><ntig><termGrp><term id="1637282">SharePoint Developer Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1660417">SharePoint Developer Center</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32160_1637588_1658255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that converts a PDF file to flowing text and document elements that are native to the application being used.</descrip></descripGrp><ntig><termGrp><term id="1637588">PDF reflow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1658255">fluxo de conversión de PDF</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32161_1637594_1660627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint shared service that aggregates tasks that systems such as SharePoint, Project Server, and Exchange assign to users.</descrip></descripGrp><ntig><termGrp><term id="1637594">Work Management Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1660627">Servizo de xestión de traballo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32162_1637597_1660629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of the Work Management Service that synchronizes tasks with systems outside of SharePoint, such as an Exchange mailbox, to enable task management in Outlook.</descrip></descripGrp><ntig><termGrp><term id="1637597">Work Management Task Sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1660629">Sincronización de tarefas de administración de traballo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32164_1637809_1660275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A touch-friendly, contextual control that presents commands in a circular arrangement.</descrip></descripGrp><ntig><termGrp><term id="1637809">radial menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1660275">menú circular</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32165_1637810_1660420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security model in which Project Server permissions are derived from SharePoint.</descrip></descripGrp><ntig><termGrp><term id="1637810">SharePoint integrated permission model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1660420">modelo integrado de permisos de SharePoint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32166_1637811_1658268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security model in which permissions are assigned directly in Project Server using global and category permissions.</descrip></descripGrp><ntig><termGrp><term id="1637811">Project Server permission model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1658268">modelo de permisos de Project Server</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32167_1637812_1660440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gallery of HTML code snippets for common components that can be customized and added to SharePoint designs.</descrip></descripGrp><ntig><termGrp><term id="1637812">Snippet Gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1660440">Galería de fragmentos de código</term><termNote type="geographicalUsa