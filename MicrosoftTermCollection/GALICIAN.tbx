ition">A commonly used file format for storing contact information. Contacts that use the vCard format are stored as .vcf files.</descrip></descripGrp><ntig><termGrp><term id="269343">vCard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498703">vCard</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46748_2632160_2636069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To deceive a device system by pretending to be another person or entity.</descrip></descripGrp><ntig><termGrp><term id="2632160">impersonate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2636069">usurpar a identidade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46749_2632166_2636070"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An act of deceiving a device or system by pretending to be another person or entity.</descrip></descripGrp><ntig><termGrp><term id="2632166">impersonation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2636070">usurpación de identidade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammati