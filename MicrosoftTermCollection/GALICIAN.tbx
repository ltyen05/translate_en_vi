oun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31909_1627812_1634497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A root certification authority that appears in the Trusted Root Certification Authorities console of the Windows operating systems and is trusted by the operating system.</descrip></descripGrp><ntig><termGrp><term id="1627812">trusted root CA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1634497">CA raíz de confianza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31909_1627812_1634532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A root certification authority that appears in the Trusted Root Certification Authorities console of the Windows operating systems and is trusted by the operating system.</descrip></descripGrp><ntig><termGrp><term id="1627812">trusted root CA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1634532">autoridade certificadora raíz de confianza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31910_1628156_1658112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that identifies a possible meeting request or event in an email message and enables the user