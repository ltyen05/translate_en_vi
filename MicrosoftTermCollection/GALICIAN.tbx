tig><termGrp><term id="2270215">Deseñador de Power BI</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39078_2270188_2351237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client agent that enables Power BI to connect to on-premises SQL Server Analysis Services instances.</descrip></descripGrp><ntig><termGrp><term id="2270188">Analysis Services Connector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2351237">Analysis Services Connector</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39079_2270271_2279487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook folder where low priority messages are moved either via the Clutter filter or by the user, based on individual user preferences.</descrip></descripGrp><ntig><termGrp><term id="2270271">Clutter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2279487">Outros correos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3909_7248_412268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows-based computers, a 32-bit value (a bitmask) that specifies the permissions that are assigned in an access control entry (ACE). An access mask is also part of the access request when an object is opened. The access mask in the request is compared to the access mask in each ACE to determine whether or not to grant the request.</descrip></descripGrp><ntig><termGrp><term id="7248">access mask</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412268">máscara de acceso</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39094_2270444_2331399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range of statistical and analytical techniques from modeling, machine learning, and data mining that analyze current and historical data to forecast future trends or events.</descrip></descripGrp><ntig><termGrp><term id="2270444">predictive analytics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2331399">análise preditiva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39097_2270759_2277017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2016 edition of the Microsoft relational database management system.</descrip></descripGrp><ntig><termGrp><term id="2270759">Access 2016</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></la