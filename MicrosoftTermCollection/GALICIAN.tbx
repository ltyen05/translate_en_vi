o</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45191_2550387_2551922"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text overlay style in Story Remix, with a semi-opaque white background, and subtle typography.</descrip></descripGrp><ntig><termGrp><term id="2550387">Quiet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2551922">Discreto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45192_2550388_2551908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text overlay style in Story Remix, with white outlined, transparent lettering that looks modern, linear, and authentic.</descrip></descripGrp><ntig><termGrp><term id="2550388">Downtown</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2551908">Sofisticado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45194_2550415_2555421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The on-premise reporting solution that gives users access to data and insights, as well as the enterprise reporting capabilities of SQL Server Repo