17_2594095_2595937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the status of a person who is not available.</descrip></descripGrp><ntig><termGrp><term id="2594095">oof</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2595937">ausente do traballo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46026_2594471_2597276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The free add-on SKU of simple-to-use applications from Office 365 Business Premium available for Office 365 Enterprise E3 and E5 users.</descrip></descripGrp><ntig><termGrp><term id="2594471">Business Apps (free)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2597276">Aplicacións empresariais (gratuítas)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46027_2594482_2597277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 content pack that gives admins insights into how users adopt and use the various services in Office 365.</descrip></descripGrp><ntig><termGrp><term id="2594482">Office 365 Adoption</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2597277">Adopción de Office 365</t