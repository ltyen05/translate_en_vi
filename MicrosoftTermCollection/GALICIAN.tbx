rivilege administrative accounts, and the systems they have access to, from compromise.</descrip></descripGrp><ntig><termGrp><term id="2857328">privileged access workstation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2859239">estación de traballo con acceso privilexiado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50468_2857329_2859234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dedicated administrative workstation or laptop in an environment designed to help protect high-privilege administrative accounts, and the systems they have access to, from compromise.</descrip></descripGrp><ntig><termGrp><term id="2857329">PAW</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2859234">PAW</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50468_2857329_2859239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dedicated administrative workstation or laptop in an environment designed to help protect high-privilege administrative accounts, and the systems they have access to, from compromise.</descrip></descripGrp><ntig><termGrp><term id="2857329">PAW</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2859239">estación de trabal