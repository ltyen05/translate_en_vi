d symbols, such as those used in East Asian written languages, using a standard keyboard.</descrip></descripGrp><ntig><termGrp><term id="64765">IME</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497687">IME</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11777_64765_497688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that lets you enter complex characters and symbols, such as those used in East Asian written languages, using a standard keyboard.</descrip></descripGrp><ntig><termGrp><term id="64765">IME</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497688">editor de métodos de entrada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11777_64766_497687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that lets you enter complex characters and symbols, such as those used in East Asian written languages, using a standard keyboard.</descrip></descripGrp><ntig><termGrp><term id="64766">input method editor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497687">IME</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</t