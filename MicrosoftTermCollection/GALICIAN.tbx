isher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2333176">editor de liña de negocio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40116_2331305_2333192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person or business that makes line-of-business apps available to customers through an online market.</descrip></descripGrp><ntig><termGrp><term id="2331305">LOB publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2333192">editor de LOB</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40118_2331575_2333222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is licensed by a company in bulk for use by end users.</descrip></descripGrp><ntig><termGrp><term id="2331575">volume application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2333222">aplicación por volumen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40121_2331937_2335066"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An automatically generated filter list in Wunderlist (e.g. Today, Week, Assigned to me, Starred, All, and Completed Smart List) that shows all tasks from across all your task lists that meet the specific criteria.</descrip></descripGrp><ntig><termGrp><term id="2331937">smart list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2335066">lista intelixente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40122_2331938_2335088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Mac OS X specific part of the app that allows Wunderlist to receive push notifications on the Mac.</descrip></descripGrp><ntig><termGrp><term id="2331938">Wunderlist Helper</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2335088">Asistente de Wunderlist</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40123_2331939_2336069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Wunderlist feature that allows users to enter due dates for a task as text (e.g. next Sunday), automatically recognize the date, and set a due date and reminder for the task.</descrip></descripGrp><ntig><termGrp><term id="2331939">Smart Due Dates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2336069">Datas de vencemento intelixentes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40124_2332081_2335065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that gives users information regarding the safety of a message via a colored bar inserted into the message.</descrip></descripGrp><ntig><termGrp><term id="2332081">Safety Tips</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2335065">Suxestións de seguranza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40126_2332083_2335061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows administrators to inform email senders that they may be about to violate one of the data loss prevention policies.</descrip></descripGrp><ntig><termGrp><term id="2332083">Policy Tips</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2335061">Suxestións de políticas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40128_2332337_2594806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A DNS server that has been configured to return non-routable addresses in response to DNS queries, preventing the use of a domain name.</descrip></descripGrp><ntig><termGrp><term id="2332337">sinkhole</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2594806">sumidoiro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40161_2333639_2340344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to tap a phone against another device to pay for a purchase using a credit or debit card enrolled in Microsoft Wallet as a method of payment.</descrip></descripGrp><ntig><termGrp><term id="2333639">tap to pay</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2340344">tocar para pagar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40162_2333642_2336068"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI element that gives a user a view of the important email, as presorted by the Focused Inbox feature.</descrip></descripGrp><ntig><termGrp><term id="2333642">Focused</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2336068">Preordenadas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40163_2333645_2338376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The email management approach developed by productivity expert Merlin Mann so that zero time is spent thinking about email without any of the five actions he identified.</descrip></descripGrp><ntig><termGrp><term id="2333645">Inbox Zero</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2338376">Caixa de entrada baleira</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4017_397157_412179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A storage platform that provides a single repository for managing multiple types of unstructured information in one infrastructure. The Exchange store combines the features and functionality of the file system, the Web, and a collaboration server (such as Microsoft Exchange) through a single, URL-addressable location for storing, accessing, and managing information, as well as building and running applications. The Exchange store is also known as the Web Storage System.</descrip></descripGrp><ntig><termGrp><term id="397157">Exchange store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412179">almacenamento do Exchange</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40220_2338748_2340345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service designed to provide single sign-on for browser, apps, and services.</descrip></descripGrp><ntig><termGrp><term id="2338748">Web Account Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2340345">Xestor de contas web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40224_2339657_2340343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app ​that lets you edit a song, so you can save part of it as a ringtone.​</descrip></descripGrp><ntig><termGrp><term id="2339657">Ringtone Maker</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2340343">Creador de tons de chamada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40226_2339682_2346020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that lets users draw someone's attention to an email message or calendar item by adding the @ symbol followed by the person's name to the body of the message or item. When this happens, the person will be notified automatically that they were mentioned.</descrip></descripGrp><ntig><termGrp><term id="2339682">Mentions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2346020">Mencións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40226_2339682_2677682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that lets users draw someone's attention to an email message or calendar item by adding the @ symbol followed by the person's name to the body of the message or item. When this happens, the person will be notified automatically that they were mentioned.</descrip></descripGrp><ntig><termGrp><term id="2339682">Mentions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2677682">@mencións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40226_2677038_2346020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that lets users draw someone's attention to an email message or calendar item by adding the @ symbol followed by the person's name to the body of the message or item. When this happens, the person will be notified automatically that they were mentioned.</descrip></descripGrp><ntig><termGrp><term id="2677038">@mentions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2346020">Mencións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40226_2677038_2677682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that lets users draw someone's attention to an email message or calendar item by adding the @ symbol followed by the person's name to the body of the message or item. When this happens, the person will be notified automatically that they were mentioned.</descrip></descripGrp><ntig><termGrp><term id="2677038">@mentions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2677682">@mencións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40227_2339683_2346029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The slide transition in PowerPoint that smoothly animates objects across slides.</descrip></descripGrp><ntig><termGrp><term id="2339683">Morph</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2346029">Transformación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40236_2340522_2342517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature to protect sensitive data stored in Azure SQL Database or SQL Server databases, allowing clients to encrypt this data inside client applications and never reveal the encryption keys to the database engine, thus providing a separation between those who own the data and those who manage it.</descrip></descripGrp><ntig><termGrp><term id="2340522">Always Encrypted</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2342517">Always Encrypted</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40237_2340528_2342519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SSIS component that allows the OLE DB Provider for SSIS to consume output of an SSIS package as a tabular result set by creating a linked server that uses the OLE DB Provider for SSIS and then running a SQL query on the linked server to display data returned by the SSIS package.</descrip></descripGrp><ntig><termGrp><term id="2340528">Data Streaming Destination</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2342519">Destino da transmisión de datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40238_2340529_2342520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that extracts log messages collected from different sources and writes them into a single file.</descrip></descripGrp><ntig><termGrp><term id="2340529">direct log consumer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2342520">consumidor de rexistros directo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40238_2600603_2342520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that extracts log messages collected from different sources and writes them into a single file.</descrip></descripGrp><ntig><termGrp><term id="2600603">DLC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2342520">consumidor de rexistros directo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40239_2340532_2342524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extended object reference included in a command and not persisted to temporarily change the existing data bindings for the duration of the command.</descrip></descripGrp><ntig><termGrp><term id="2340532">out-of-line binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2342524">vinculación fóra de liña</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4024_185143_1688683"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button in a video conversation window that starts or restarts the video feed.</descrip></descripGrp><ntig><termGrp><term id="185143">Play</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1688683">Reproducir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40240_2340533_2342525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cluster of SQL Server instances to process large data sets from external data sources in which multiple server instances share a single database.</descrip></descripGrp><ntig><termGrp><term id="2340533">scale-out group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2342525">grupo de escala horizontal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40241_2340538_2342522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SQL Server feature that allows data files to be initialized instantaneously for fast execution by reclaiming used disk space without filling that space with zeros and overwriting disk content as new data is written to the files.</descrip></descripGrp><ntig><termGrp><term id="2340538">Instant File Initialization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2342522">IFI</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40241_2340538_2342523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SQL Server feature that allows data files to be initialized instantaneously for fast execution by reclaiming used disk space without filling that space with zeros and overwriting disk content as new data is written to the files.</descrip></descripGrp><ntig><termGrp><term id="2340538">Instant File Initialization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2342523">Inicio instantáneo de ficheiros</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40241_2341056_2342522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SQL Server feature that allows data files to be initialized instantaneously for fast execution by reclaiming used disk space without filling that space with zeros and overwriting disk content as new data is written to the files.</descrip></descripGrp><ntig><termGrp><term id="2341056">IFI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2342522">IFI</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40241_2341056_2342523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SQL Server feature that allows data files to be initialized instantaneously for fast execution by reclaiming used disk space without filling that space with zeros and overwriting disk content as new data is written to the files.</descrip></descripGrp><ntig><termGrp><term id="2341056">IFI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2342523">Inicio instantáneo de ficheiros</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40246_2341008_2392962"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure that contains authentication and authorization information to use an application.</descrip></descripGrp><ntig><termGrp><term id="2341008">application access token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2392962">token de acceso á aplicación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40247_2341011_2392960"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The identification of items that do not conform to an expected pattern or to other items present in a dataset.</descrip></descripGrp><ntig><termGrp><term id="2341011">anomaly detection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2392960">detección de anomalías</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40248_2341012_2392977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy run on discovered services that identifies behaviors that are outside the norm for an organization.</descrip></descripGrp><ntig><termGrp><term id="2341012">discovery anomaly policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2392977">política de detección de anomalías</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4025_315147_1178179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A descriptive or user-friendly label for a control or object, displayed on the screen. The display name may differ from the internal name.</descrip></descripGrp><ntig><termGrp><term id="315147">display name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178179">nome para mostrar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40250_2341031_2392998"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To put an end to the validity of something.</descrip></descripGrp><ntig><termGrp><term id="2341031">revoke</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2392998">revogar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40252_2341036_2393017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software agent that acts on behalf of the user.</descrip></descripGrp><ntig><termGrp><term id="2341036">user agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2393017">axente de usuario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40253_2341037_2392984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To run a process or thread temporarily in the security context of a specific caller and to gain authorized access to resources using that identity.</descrip></descripGrp><ntig><termGrp><term id="2341037">impersonate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2392984">suplantar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40253_2341037_2633216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To run a process or thread temporarily in the security context of a specific caller and to gain authorized access to resources using that identity.</descrip></descripGrp><ntig><termGrp><term id="2341037">impersonate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2633216">representar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40255_2343536_2392994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy that is enforced in real time, as activities occur, to provide maximum protection for your SaaS.</descrip></descripGrp><ntig><termGrp><term id="2343536">proxy policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2392994">política de proxy</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40256_2341040_2392997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reinstate an item to its original state.</descrip></descripGrp><ntig><termGrp><term id="2341040">restore</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2392997