Note><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33844_1908771_1973232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 online subscription for businesses that need communication and collaboration tools and the ability to read and do lightweight editing of documents with the Office Web Apps.</descrip></descripGrp><ntig><termGrp><term id="1908771">Office 365 Enterprise E2</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1973232">Office 365 Enterprise E2</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33846_1908773_1973234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limited-day trial for an Office 365 online subscription for businesses that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Web Apps.</descrip></descripGrp><ntig><termGrp><term id="1908773">Office 365 Enterprise E3 Trial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1973234">Versión de avaliación de Office 365 Enterprise E3</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33847_1908774_1973235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 subscription for businesses that need productivity, communications and collaboration tools including the familiar desktop Office and compliance features like data loss prevention and archiving. Also includes Skype for Business Plus CAL, enabling customers to get Enterprise Voice on-premises.</descrip></descripGrp><ntig><termGrp><term id="1908774">Office 365 Enterprise E4</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1973235">Office 365 Enterprise E4</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33848_1908775_1973236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limited-day trial for an Office 365 online subscription for businesses that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Web Apps and on-premises server rights to information protection and enterprise voice capabilities.</descrip></descripGrp><ntig><termGrp><term id="1908775">Office 365 Enterprise E4 Trial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1973236">Versión de avaliación de Office 365 Enterprise E4</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33853_1908780_1973242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limited-day trial for an Office 365 online subscription for midsize businesses (fewer than 250 users) that need that need O