55">State</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1973598">Estado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33969_1961560_1973589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search field that allows the user to search across multiple entities such as contacts, accounts, and leads.</descrip></descripGrp><ntig><termGrp><term id="1961560">Multi-Entity Quick Find</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1973589">Procura rápida en varias entidades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33970_1961562_1973585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Field that specifies which character will be the default character used to separate data items when the data is being imported into Microsoft Dynamics CRM.</descrip></descripGrp><ntig><termGrp><term id="1961562">Default delimiter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1973585">Delimitador predefinido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33973_1961568_1973570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field in the Import Data Wizard that indicates that the wizard can determine which of the fields being imported match up with Microsoft Dynamics CRM fields.</descrip></descripGrp><ntig><termGrp><term id="1961568">Automatic mapping</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1973570">Asignación automática</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33974_1961569_1973606"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that refers to being able to do your work from anywhere with your mobile device, whether you are in your office, at home, or traveling ("on the go").</descrip></descripGrp><ntig><termGrp><term id="1961569">Work on the go</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1973606">Traballa dende calquera sitio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33975_1961570_1973592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To fix a list in a given area of the UI, so it is always accessible in that area.</descrip></descripGrp><ntig><termGrp><term id="1961570">Pin this list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1973592">Fixar esta lista</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33976_1961571_1973593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Button on a form that causes that section of the form you are in to open in a new window.</descrip></descripGrp><ntig><termGrp><term id="1961571">Pop Out</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1973593">Ventá emerxente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33977_1961572_1973586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique occurrence of an application.</descrip></descripGrp><ntig><termGrp><term id="1961572">instance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1973586">instancia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33979_1961574_1973575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operational process that guides a user to achieve a certain goal.</descrip></descripGrp><ntig><termGrp><