ce</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2576327">Intelixencia contra ameazas de Office 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45618_2572936_2576330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of tools and dashboards in the Office 365 Security &amp; Compliance Center that monitors signals from sources, analyzes them based on a repository of threat intelligence, and presents data that allows decision makers and administrators to react to threats.</descrip></descripGrp><ntig><termGrp><term id="2572936">Threat Intelligence</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2576330">Intelixencia contra ameazas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45619_2572051_2576339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subscription that is paid upfront and that automatically renews at the end of the term.</descrip></descripGrp><ntig><termGrp><term id="2572051">pre-paid subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2576339">subscrición de prepago</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45621_2572053_2576342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business that sells goods to the public in small quantities for use or consumption rather than for resale.</descrip></descripGrp><ntig><termGrp><term id="2572053">retailer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2576342">distribuidor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45634_2572083_2575148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox One support app that allows users to optimize their Xbox experience, stay informed about issues, get personalized help and take actions to solve issues or improve their overall experience.</descrip></descripGrp><ntig><termGrp><term id="2572083">Xbox Assist</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2575148">Asistencia de Xbox</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4565_31042_1479433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of finalizing a purchase on a website. For example, when customers shop on your website, they may select several items and save them in their shopping basket. When they have finished shopping, they click on a checkout link or graphical button that takes them to an online form where they enter their name, billing address, payment type, and shipping information.</descrip></descripGrp><ntig><termGrp><term id="31042">checkout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1479433">finalización da compra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45654_2572168_2575139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The effect that users can apply to a photo or video clip in the Photos app. It resembles a waterfall.</descrip></descripGrp><ntig><termGrp><term id="2572168">Waterfall</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2575139">Fervenza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45656_2650477_2696495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The South Africa North region, located in Johannesburg, within the Azure region taxonomy.</descrip></descripGrp><ntig><termGrp><term id="2650477">South Africa North</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2696495">Norte de Suráfrica</term><termNote type="geographicalUsage">ESP</termNote><termNote type