Number">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12830_725793_497335"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a graphical user interface such as Windows, a pattern or picture in the screen background that can be chosen by the user.</descrip></descripGrp><ntig><termGrp><term id="725793">desktop background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497335">deseño do escritorio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12838_73230_497739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To attach a label to.</descrip></descripGrp><ntig><termGrp><term id="73230">label</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497739">etiquetar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12845_44281_497533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On IBM and PC-compatible computers, a key whose function changes depending on the application program. Usually it erases the character under the cursor, although in some applications it can erase selected text or graphics.</descrip></descripGrp><ntig><termGrp><term id="44281">DELETE key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497533">tecla SUPR</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1287_62976_3041537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the HSB color model, one of the three characteristics used to describe a color. Hue is the attribute that most readily distinguishes one color from other colors. It depends on the frequency of a light wave in the visible spectrum.</descrip></descripGrp><ntig><termGrp><term id="62976">hue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3041537">matiz</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12871_316306_498883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To wait for incoming traffic, calls or connection requests on a port.</descrip></descripGrp><ntig><termGrp><term id="316306">listen</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498883">agardar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12872_1790611_2020744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To be unresponsive.</descrip></descripGrp><ntig><termGrp><term id="1790611">stop responding</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2020744">deixar de responder</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12874_276553_498715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool for accessing right-click menus and targeting small pieces of the interface using touch input.</descrip></descripGrp><ntig><termGrp><term id="276553">touch pointer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498715">punteiro táctil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12875_181717_1950391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The assignment of a specific role that determines whether a user or group can access a specific item and perform an operation on it.</descrip></descripGrp><ntig><termGrp><term id="181717">role assignment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950391">asignación de función</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12884_1939_497210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application of the Standard Generalized Markup Language that uses tags to mark elements, such as text and graphics, in a document to indicate how Web browsers should display these elements to the user and should respond to user actions.</descrip></descripGrp><ntig><termGrp><term id="1939">HTML</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497210">HTML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12884_1939_497211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application of the Standard Generalized Markup Language that uses tags to mark elements, such as text and graphics, in a document to indicate how Web browsers should display these elements to the user and should respond to user actions.</descrip></descripGrp><ntig><termGrp><term id="1939">HTML</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497211">linguaxe de marcación de hipertexto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12884_1940_497210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application of the Standard Generalized Markup Language that uses tags to mark elements, such as text and graphics, in a document to indicate how Web browsers should display these elements to the user and should respond to user actions.</descrip></descripGrp><ntig><termGrp><term id="1940">Hypertext Markup Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497210">HTML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12884_1940_497211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application of the Standard Generalized Markup Language that uses tags to mark elements, such as text and graphics, in a document to indicate how Web browsers should display these elements to the user and should respond to user actions.</descrip></descripGrp><ntig><termGrp><term id="1940">Hypertext Markup Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497211">linguaxe de marcación de hipertexto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12892_38946_497495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of assistance in which a program that provides on-screen help shows information to the user concerning the current command or operation being attempted.</descrip></descripGrp><ntig><termGrp><term id="38946">context-sensitive Help</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497495">axuda contextual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12897_121594_2677002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of identification data for a security principle, issued by a domain controller for purposes of user authentication.</descrip></descripGrp><ntig><termGrp><term id="121594">ticket</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2677002">tícket</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1290_45650_2740436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that represents number in a numbering system.</descrip></descripGrp><ntig><termGrp><term id="45650">digit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2740436">díxito</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12905_232396_498449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of domain names and email addresses that are treated as junk email and are blocked unless the sender is on the Safe Senders List or the recipient is on the Safe Recipients List.</descrip></descripGrp><ntig><termGrp><term id="232396">Blocked Senders List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498449">Lista de remitentes bloqueados</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12919_113429_412209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device or part of a device that receives something from another device.</descrip></descripGrp><ntig><termGrp><term id="113429">sink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412209">receptor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12923_397158_412210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of Microsoft Management Console (MMC) snap-ins that Microsoft Exchange provides.</descrip></descripGrp><ntig><termGrp><term id="397158">Exchange System Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412210">Xestor do sistema do Exchange</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12934_150180_2856586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition"