age is selected.</descrip></descripGrp><ntig><termGrp><term id="1166077">contextual tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1275725">separador contextual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24977_1166109_1275890"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solution that is "open" and that can be modified by anybody with the required privileges.</descrip></descripGrp><ntig><termGrp><term id="1166109">unprotected solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1275890">solución desprotexida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24979_1166112_1275731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mode in which certain information is not available for edit on the page until the page is saved after creation. An example of this would be the opportunity record pages, where the opportunity has to be saved before products can be added.</descrip></descripGrp><ntig><termGrp><term id="1166112">create mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1275731">modo de creación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><term