</ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1765310">desconxelar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33272_1764210_1767036"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of software that's distributed to manufacturers to build into hardware they will make available when the final software is made generally available.</descrip></descripGrp><ntig><termGrp><term id="1764210">RTM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1767036">versión RTM</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33272_1764210_1767037"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of software that's distributed to manufacturers to build into hardware they will make available when the final software is made generally available.</descrip></descripGrp><ntig><termGrp><term id="1764210">RTM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1767037">RTM</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33272_1764519_1767036"><langSet xml:lang="en-US"><descripGrp><descrip type="definition