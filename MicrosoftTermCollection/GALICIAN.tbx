xml:lang="en-US"><descripGrp><descrip type="definition">A frequency in a communications channel modulated to carry analog or digital signal information. For example, an FM radio transmitter modulates the frequency of a carrier signal and the receiver processes the carrier signal to extract the analog information. An AM radio transmitter modulates the amplitude of a carrier signal.</descrip></descripGrp><ntig><termGrp><term id="28148">carrier signal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2520917">frecuencia operadora</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="756_106608_1689061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An on-screen scale marked off in inches or other units of measure and used to show line widths, tab settings, paragraph indents, and so on.</descrip></descripGrp><ntig><termGrp><term id="106608">ruler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1689061">regra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7561_306402_498789"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter effect in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="306402">Rotate 180</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498789">Rotar 180º</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7566_184262_498348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A delay that occurs while data is processed or delivered.</descrip></descripGrp><ntig><termGrp><term id="184262">latency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498348">latencia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7570_140476_1178749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The .pst data file used as the main delivery location for your email messages.</descrip></descripGrp><ntig><termGrp><term id="140476">default data file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178749">ficheiro de datos predefinido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7571_170485_498305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of a collection of drivers that responds to the same IRPs. Layered driver describes the highest-level and lowest-level drivers in a chain of layered drivers that process the same IRPs, along with all intermediate drivers in the chain.</descrip></descripGrp><ntig><termGrp><term id="170485">layered driver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498305">controlador superposto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7584_130154_498070"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portion of unique computer code contained in a virus. Antivirus programs search for known virus signatures to identify infected programs and files.</descrip></descripGrp><ntig><termGrp><term id="130154">virus signature</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498070">sinatura de virus</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7590_375744_380448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets a Microsoft Outlook user who has a Microsoft Exchange email account work offline, either by choice or due to a connection problem. A copy of the user's mailbox is stored on their computer and is frequently updated from the mail server. Any changes that are made while a connection to the server is not available are synchronized automatically when a connection becomes available.</descrip></descripGrp><ntig><termGrp><term id="375744">Cached Exchange Mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="380448">modo Exchange en caché</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="76_39968_497507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of protecting the rights of an originator of a creative work, such as a text, a piece of music, a painting, or a computer program, through law.</descrip></descripGrp><ntig><termGrp><term id="39968">copyright</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497507">copyright</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7612_47524_497573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In windowing environments, such as the Apple Macintosh and Microsoft Windows, an on-screen window (enclosed work area) in which the user can create, view, or work on a document.</descrip></descripGrp><ntig><termGrp><term id="47524">document window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497573">ventá de documento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7621_1275092_1688808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A privacy relationship setting that allows a small amount of information to be viewed, typically for nonfederated contacts.</descrip></descripGrp><ntig><termGrp><term id="1275092">External Contacts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1688808">Contactos externos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7621_418565_1688808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A privacy relationship setting that allows a small amount of information to be viewed, typically for nonfederated contacts.</descrip></descripGrp><ntig><termGrp><term id="418565">Public</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1688808">Contactos externos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7627_277360_1276290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A segment of an organization's market. Sales territories are often defined by geographical location, such as Northwest territory and Southeast territory.</descrip></descripGrp><ntig><termGrp><term id="277360">sales territory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1276290">zona de vendas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7631_134267_498100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a spreadsheet program, a file containing a number of related worksheets.</descrip></descripGrp><ntig><termGrp><term id="134267">workbook</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498100">libro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7638_398504_2819471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stored record of the audio and video components of a meeting or session.</descrip></descripGrp><ntig><termGrp><term id="398504">recording</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2819471">gravación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7641_50797_497604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To programmatically disguise content to hide its substance.</descrip></descripGrp><ntig><termGrp><term id="50797">encrypt</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang