ch is used to scale the amount of force from the vector field that is applied to the images.</descrip></descripGrp><ntig><termGrp><term id="307372">turbulence force</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498799">forza da turbulencia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8474_138253_1178759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The distance between the cells of a table or workbook.</descrip></descripGrp><ntig><termGrp><term id="138253">cell spacing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178759">espazamento entre celas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8483_584267_498725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column chart subtype that shows the relationship of individual items to the whole, comparing the contribution of each value to a total across categories.</descrip></descripGrp><ntig><termGrp><term id="584267">stacked column chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498725">columna amontoada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNot