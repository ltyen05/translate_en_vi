><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3539_308341_498820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of records that results from running a query or applying a filter.</descrip></descripGrp><ntig><termGrp><term id="308341">results</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498820">resultados</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35390_2029084_2036306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 8.1 Pro that is optimized for students and educational institutions.</descrip></descripGrp><ntig><termGrp><term id="2029084">Windows 8.1 Pro for Education</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2036306">Windows 8.1 Pro for Education</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35391_2029155_2036784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that establishes a simple flow for learning about and using authenticated Microsoft Online Services endpoints for a given user. It is a single point where a developer can start, pass the user identity, get information to initiate authorization flows, get the hosting location of services for that user, and get the endpoints to the service.</descrip></descripGrp><ntig><termGrp><term id="2029155">Discovery Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2036784">Servizo de detección</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35392_2029156_2036787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of web services built on top of the Office 365 platform that makes available Office 365 components or data, such as documents, spreadsheets, presentations, calendars, mail, contacts, and tasks. These services are available from within apps for Office, apps for SharePoint, and also from third-party sites or applications who want to use Office 365 components, but are hosted on another platform, such as Microsoft Azure.</descrip></descripGrp><ntig><termGrp><term id="2029156">Office 365 APIs</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2036787">API de Office 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35393_2029157_2036785"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that creates a template for a sensitive information type from a form, which can then be used to define transport rules, prevent oversharing of information, and create Data Loss Protection policies.</descrip></descripGrp><ntig><termGrp><term id="2029157">Document Fingerprinting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2036785">Creación de impresión dixital de documento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35394_2029266_2036304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The software update to Windows 8.1 Enterprise that gives users a more familiar and convenient experience across touch, keyboard and mouse inputs and enables more affordable Windows device choices.</descrip></descripGrp><ntig><termGrp><term id="2029266">Windows 8.1 Enterprise Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2036304">Windows 8.1 Enterprise Update</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35395_2029267_2036312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The software update to Windows 8.1 Single Language that gives users a more familiar and convenient experience across touch, keyboard and mouse inputs and enables more affordable Windows device choices.</descrip></descripGrp><ntig><termGrp><term id="2029267">Windows 8.1 Single Language Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Si