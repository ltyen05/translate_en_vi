Usage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44178_2482815_2498016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of logical rules for adjusting the score of a lead being nurtured by a marketing campaign.</descrip></descripGrp><ntig><termGrp><term id="2482815">lead scoring model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2498016">modelo de puntuación do cliente potencial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44179_2482820_2498021"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display window that shows users a variety of relevant data-driven insights and news from their contacts' interactions on social media.</descrip></descripGrp><ntig><termGrp><term id="2482820">social pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2498021">panel social</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44180_2482821_2498022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field where you enter information about a marketing campaign used to attract or generate a lead.</descrip></descripGrp><ntig><termGrp><term id="248282