ermNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2013935">barra de aplicacións do escritorio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34735_2009421_2013941"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The workspace along the bottom edge of the screen that enables the user to access Office 365 services or sign out.</descrip></descripGrp><ntig><termGrp><term id="2009421">mobile app bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2013941">barra de aplicacións para móbil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34739_2012681_2013943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to compose or reply to a message without leaving the context of the conversation.</descrip></descripGrp><ntig><termGrp><term id="2012681">Quick Compose</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2013943">Redacción rápida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34741_2012702_2522496"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows organizations to comply with legal discovery requirements by searching and holding relevant content from mailboxes, Skype for Business, and SharePoint Online websites, documents and file shares.</descrip></descripGrp><ntig><termGrp><term id="2012702">In-Place eDiscovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2522496">eDiscovery local</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34748_2012910_2013948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office feature that creates a view where users can see the content that has been shared with them.</descrip></descripGrp><ntig><termGrp><term id="2012910">Shared with Me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2013948">Compartidos comigo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34749_2012913_2013940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows a preview of a webpage or YouTube video. The preview will show a photo, title, and description of the webpage or video.</descrip></descripGrp><ntig><termGrp><term id="2012913">Inline Previews</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2013940">previsualizacións en liña</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34750_2012915_2013934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that opens the current document’s table of contents in a pane. Users can pin the pane to the document, and when they scroll through the document, the table of contents dynamically highlights the section they are in.</descrip></descripGrp><ntig><termGrp><term id="2012915">Contents</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2013934">Contidos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34751_2012916_2013937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI element that enables the user to locate text and go to locations where the text occurs in a document.</descrip></descripGrp><ntig><termGrp><term id="2012916">Find</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2013937">Busca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34754_2013078_2013944"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of multiple authors, who are editing a shared document, to simultaneously see text and formatting changes made by co-authors as they add them.</descrip></descripGrp><ntig><termGrp><term id="2013078">Real-time Co-authoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2013944">coautoría en tempo real</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34755_2013123_2013951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that creates new and improved mobile browser views. Documents are displayed as big touchable tiles on the screen. Users can view their own documents, shared documents, or ones they follow. They can open documents or share the URL of a document with other users. Additionally, users can navigate to Mail, Calendar, People, and Sites to view sites that they follow and those promoted by their site administrator.</descrip></descripGrp><ntig><termGrp><term id="2013123">Touch Design</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2013951">Deseño táctil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34756_2013318_2017731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app for the Windows Store designed for small groups of SharePoint users to enable them to perform basic tasks, such as provide access to team document libraries, site feeds, and project tasks.</descrip></descripGrp><ntig><termGrp><term id="2013318">Sites app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2017731">aplicación Sitios</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34758_2013323_2767497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transfer of customer data from one system to another.</descrip></descripGrp><ntig><termGrp><term id="2013323">migration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2767497">migración</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34759_2013324_2589488"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product that provides additional functionality when used with a prerequisite underlying base product.</descrip></descripGrp><ntig><termGrp><term id="2013324">add-on</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2589488">complemento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3476_374309_2094561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variable-length data type with a maximum of 8,000 bytes of binary data.</descrip></descripGrp><ntig><termGrp><term id="374309">varbinary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094561">varbinary</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34761_2013325_2015707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that is only available when a device is connected to the Internet so that the file’s data uses little space in the device’s storage.</descrip></descripGrp><ntig><termGrp><term id="2013325">smart file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2015707">ficheiro intelixente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34764_2013405_2914479"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Video communication with another player on Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="2013405">video chat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2914479">chat de vídeo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">