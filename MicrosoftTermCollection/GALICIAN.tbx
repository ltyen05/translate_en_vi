Grp><ntig><termGrp><term id="2745965">junk</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2749883">enviar a correo lixo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48557_2745975_2749897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move an email out of a folder where junk messages are stored.</descrip></descripGrp><ntig><termGrp><term id="2745975">unjunk</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2749897">sacar do correo lixo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48558_2745981_2749894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of offensive and/or explicit words and phrases.</descrip></descripGrp><ntig><termGrp><term id="2745981">sensitive word list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2749894">lista de palabras ofensivas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48559_2745984_2749893"><langSet xml:lang="en-US"><descripGrp><descrip type="de