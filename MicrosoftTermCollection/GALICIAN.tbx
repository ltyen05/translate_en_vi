 type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5607_318742_498953"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user’s assessment of how good they think a particular piece of content or product is.</descrip></descripGrp><ntig><termGrp><term id="318742">rating</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498953">clasificación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56078_3152915_3153182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The fourth day of the Islamic holiday that marks the end of Ramadan.</descrip></descripGrp><ntig><termGrp><term id="3152915">Eid al Fitr (4th Day)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3153182">Eid al-Fitr (4.º día)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56079_3152916_3153183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The fifth day  of the Islamic holiday that marks the end of Ramadan.</descrip></descripGrp><ntig><termGrp><term id="3152916">Eid al Fitr (5th Day)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3153183">Eid al-Fitr (5.º día)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56080_3152917_3153184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The second day of the two-day holiday that commemorates the formation of the United Arab Emirates.</descrip></descripGrp><ntig><termGrp><term id="3152917">National Day (2nd Day)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3153184">Día Nacional (2.º día)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56081_3153497_3153516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within Dynamics 365 Supply Chain Management designed for companies engaged in international trade of goods. It helps them monitor and adhere to both internal policies and external regulations. The solution lets them express these rules, even complex ones, by using formulas that are similar to the formulas in Microsoft Excel. It guarantees that these rules are consistently followed during the entire sales and fulfillment procedure.</descrip></descripGrp><ntig><termGrp><term id="3153497">Export Control</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3153516">Control de exportacións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56082_3153688_3153854"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Microsoft Teams used in workplace and education contexts.</descrip></descripGrp><ntig><termGrp><term id="3153688">Microsoft Teams (work or school)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3153854">Microsoft Teams (traballo ou escola)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56082_3153688_3153856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Microsoft Teams used in workplace and education contexts.</descrip></descripGrp><ntig><termGrp><term id="3153688">Microsoft Teams (work or school)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3153856">Teams (traballo ou escola)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56082_3153689_3153854"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Microsoft Teams used in workplace and education contexts.</descrip></descripGrp><ntig><termGrp><term id="3153689">Teams (work or school)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3153854">Microsoft Teams (traballo ou escola)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56082_3153689_3153856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Microsoft Teams used in workplace and education contexts.</descrip></descripGrp><ntig><termGrp><term id="3153689">Teams (work or school)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3153856">Teams (traballo ou escola)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56084_3153773_3154839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A prioritization technique used to communicate the importance and priority of various project requirements. The acronym is derived from the first letter of each of four prioritization categories: Must have, Should have, Could have, and Won’t have.</descrip></descripGrp><ntig><termGrp><term id="3153773">MoSCoW</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3154839">MoSCoW</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56085_3153841_3155891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft service offering that provides hands-on advisory services to help large enterprises embrace modern security capabilities and build security resilience.</descrip></descripGrp><ntig><termGrp><term id="3153841">Microsoft Security Enterprise Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3155891">Servizos empresariais</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56085_3153841_3155895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft service offering that provides hands-on advisory services to help large enterprises embrace modern security capabilities and build security resilience.</descrip></descripGrp><ntig><termGrp><term id="3153841">Microsoft Security Enterprise Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3155895">Servizos empresariais de seguranza de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56085_3153845_3155891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft service offering that provides hands-on advisory services to help large enterprises embrace modern security capabilities and build security resilience.</descrip></descripGrp><ntig><termGrp><term id="3153845">Enterprise Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3155891">Servizos empresariais</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56085_3153845_3155895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft service offering that provides hands-on advisory services to help large enterprises embrace modern security capabilities and build security resilience.</descrip></descripGrp><ntig><termGrp><term id="3153845">Enterprise Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3155895">Servizos empresariais de seguranza de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56086_3153851_3154354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Copilot in the Edge browser that enables the user, when writing in the browser, to use generative AI to reword their written text.</descrip></descripGrp><ntig><termGrp><term id="3153851">inline compose</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3154354">redacción en liña</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56087_3153852_3154355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows IT Admins to enable their organization's branding assets from Entra onto profile-related UI for profiles signed in with an Entra ID account.</descrip></descripGrp><ntig><termGrp><term id="3153852">organization branding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3154355">marca da organización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56088_3153853_3154350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that, based on a prompt entered by the user, creates custom images formatted as an Edge theme.</descrip></descripGrp><ntig><termGrp><term id="3153853">custom theme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3154350">tema personalizado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56089_3153855_3154357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user, when writing in the browser, to use generative AI to reword their written text.</descrip></descripGrp><ntig><termGrp><term id="3153855">rewrite</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3154357">reescritura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56091_3153897_3154356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An input surface where users enter their requests for Copilot in natural language. It is the user’s interaction point with the system.</descrip></descripGrp><ntig><termGrp><term id="3153897">prompt bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3154356">barra de indicacións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56092_3153898_3155887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides real-time exploration of a machine's operational information, spanning from hardware specifications, such as memory usage, to software configuration, including installed applications, registry keys, and networking settings.</descrip></descripGrp><ntig><termGrp><term id="3153898">device query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3155887">consulta sobre o dispositivo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56093_3153899_3155881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows organizations to selectively scan and protect historical older data using the latest enhanced advanced classifiers, to comprehensively identify and protect their sensitive corporate intellectual property and PII.</descrip></descripGrp><ntig><termGrp><term id="3153899">data scan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3155881">análise de datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56094_3153900_3155873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables a customer’s Entra ID admin to approve access to identity data in their tenant.</descrip></descripGrp><ntig><termGrp><term id="3153900">customer lockbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3155873">caixa de seguridade do cliente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56095_3153903_3154346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Edge feature that enables users to perform complex tasks such as more accurate calculations, coding, data analysis, visualization, math and more.</descrip></d