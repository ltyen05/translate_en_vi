ility Answer Desk</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2746447">Answer Desk Accesibilidade empresarial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48503_2742482_2746494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The website that  contains resources for people with disabilities and for companies that want to make their content accessible for all.</descrip></descripGrp><ntig><termGrp><term id="2742482">Office Accessibility Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2746494">Centro de accesibilidade de Office</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48509_2742883_2746546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A denial-of-service attack where an attacker sends a succession of SYN requests to a target's system to consume enough server resources to make the system unresponsive.</descrip></descripGrp><ntig><termGrp><term id="2742883">SYN flood</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2746546">inundación de SYN</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGend