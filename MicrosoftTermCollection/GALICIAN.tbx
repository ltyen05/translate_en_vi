ig></langSet></termEntry><termEntry id="25927_1244649_1275902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Two or more resources (users, facilities, or equipment) that can be scheduled interchangeably.</descrip></descripGrp><ntig><termGrp><term id="1244649">resource group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1275902">grupo de recursos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25928_1244650_1275872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scheduling component that is used to view and manage appointments and service activities.</descrip></descripGrp><ntig><termGrp><term id="1244650">service calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1275872">calendario de servizos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245016_1950022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245016">Active Directory Management Agent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950022">Axente de xestión de Active Directory</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245016_1950029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245016">Active Directory Management Agent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950029">ADMA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245017_1950022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245017">ADMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950022">Axente de xestión de Active Directory</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245017_1950029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245017">ADMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950029">ADMA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25959_1247422_1950443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mailbox folder structure on some IMAP servers in which mail folders are accessed with the administrator username and password, and shell login access to the mail server is not allowed. Access to specific mailboxes is managed by access control lists. This means that users are assigned the permissions to only access their mailbox folder, while an administrator has access to all mailboxes. This allows organizations to use administrative credentials to migrate email from an IMAP server to Outlook Live.</descrip></descripGrp><ntig><termGrp><term id="1247422">virtual shared folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950443">cartafol compartido virtual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2596_335540_2767847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To provide your name and contact information to an organization so that you can receive product information, updates, and special offers.</descrip></descripGrp><ntig><termGrp><term id="335540">register</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2767847">rexistrarse</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25963_1250378_1275844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The desktop client version of the Microsoft Dynamics CRM product suite for Microsoft Office Outlook.</descrip></descripGrp><ntig><termGrp><term id="1250378">Microsoft Dynamics CRM for Microsoft Office Outlook</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1275844">Microsoft Dynamics CRM para Microsoft Office Outlook</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25965_1250380_1275851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The laptop client version of the Microsoft Dynamics CRM product suite for Microsoft Office Outlook.</descrip></descripGrp><ntig><termGrp><term id="1250380">Microsoft Dynamics CRM for Microsoft Office Outlook with Offline Access</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1275851">Microsoft Dynamics CRM para Microsoft Office Outlook con acceso sen conexión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2597_143708_2094636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fundamental data type that holds integers. An Integer variable is stored as a 16-bit (2-byte) number ranging in value from -32,768 to 32,767.</descrip></descripGrp><ntig><termGrp><term id="143708">Integer data type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094636">tipos de datos Integer</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25978_1251313_1950162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To place a windows Live ID in a forced rename state, while the Windows Live ID and all of its existing settings, including the password, Xbox Live points, or Zune points are preserved. The user can sign in using the Windows Live ID and its password, but they're immediately asked to rename the Windows Live ID. They must specify an email address that's outside the Outlook Live domain.</descrip></descripGrp><ntig><termGrp><term id="1251313">evict</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950162">forzar cambio de nome</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25980_1253436_1374179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The condition, at a particular time, of a record.</descrip></descripGrp><ntig><termGrp><term id="1253436">record status</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1374179">estado do rexistro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25981_1253437_1374275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The condition, at a particular time, of a workflow.</descrip></descripGrp><ntig><termGrp><term id="1253437">workflow status</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1374275">estado do fluxo de traballo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25984_1253576_1787551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar including the Bing search box installed for the variety of common-used browsers, like Internet Explorer, Firefox, etc.</descrip></descripGrp><ntig><termGrp><term id="1253576">Bing Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1787551">Barra de Bing</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25985_1253605_2335058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical representation of data where the intensity of color corresponds to the related analytical data. For example, low values in a range appear as blue (cold) and high values as red (hot).</descrip></descripGrp><ntig><termGrp><term id="1253605">heat map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2335058">mapa térmico</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25985_2593079_2335058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical representation of data where the intensity of color corresponds to the related analytical data. For example, low values in a range appear as blue (cold) and high values as red (hot).</descrip></descripGrp><ntig><termGrp><term id="2593079">heatmap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2335058">mapa térmico</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2599_211415_498393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Intel microprocessor that uses explicitly parallel instruction set computing and 64-bit memory addressing. "Itanium-based" refers to systems or platforms that are based on the Itanium processor. "Itanium2-based" refers to systems or platforms that are based on the Itanium2 processor. "Itanium architecture-based" refers to systems or platforms that are based on the Itanium and Itanium2 processors.</descrip></descripGrp><ntig><termGrp><term id="211415">Itanium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498393">Itanium</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25992_1253847_1650393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online community where members can virtually socialize by posting and commenting on a newsfeed, by chatting, and by sharing photos, images, articles, and other content.</descrip></descripGrp><ntig><termGrp><term id="1253847">social network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1650393">rede social</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25992_2696313_1650393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online community where members can virtually socialize by posting and commenting on a newsfeed, by chatting, and by sharing photos, images, articles, and other content.</descrip></descripGrp><ntig><termGrp