oun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3049824">Automatización de documentos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53559_3049250_3049825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user role that has the ability to perform all administrative actions on an environment.</descrip></descripGrp><ntig><termGrp><term id="3049250">environment admin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3049825">administrador do ambiente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53560_3049251_3049826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user role that has the ability to create new resources in an environment.</descrip></descripGrp><ntig><termGrp><term id="3049251">environment maker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3049826">creador do ambiente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53561_3049252_3049827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Power Apps app adapted to different languages, providing a great user experience for users around the world.</descrip></descripGrp><ntig><termGrp><term id="3049252">global app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3049827">aplicación global</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53562_3049253_3049828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Power Apps app prominently displayed in a tile titled “FEATURED APP” at the top of all views.</descrip></descripGrp><ntig><termGrp><term id="3049253">hero app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3049828">aplicación principal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53563_3049254_3049829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The prebuilt AI model that extracts information from passports and US driver licenses.</descrip></descripGrp><ntig><termGrp><term id="3049254">Identity document reader</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3049829">Lector de documentos de identidade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNot