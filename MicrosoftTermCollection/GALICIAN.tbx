:lang="gl"><ntig><termGrp><term id="2501818">Project Copenhagen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44378_2499542_2501819"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PowerPoint plugin that allows users to post their slides as images, videos, or albums on social media accounts, automatically upload them to OneDrive, and that shows any comments directly in PowerPoint.</descrip></descripGrp><ntig><termGrp><term id="2499542">Social Share</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2501819">Social Share</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44379_2499544_2501817"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for Android that allows users to select links, text, and images, save it on their clipboard, and then put it somewhere universally accessible, such as Wunderlist, even from applications that don’t allow selection.</descrip></descripGrp><ntig><termGrp><term id="2499544">Clip Layer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2501817">Clip Layer</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termG