l"><ntig><termGrp><term id="2847590">Microsoft 365 F1</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50346_2844883_2847612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The end-to-end security solution designed to provide a view of an organization's overall threat landscape so that administrators can easily spot new threats and attacks.​</descrip></descripGrp><ntig><termGrp><term id="2844883">Microsoft Defender XDR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2847612">Microsoft Defender XDR</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50346_2844883_3144503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The end-to-end security solution designed to provide a view of an organization's overall threat landscape so that administrators can easily spot new threats and attacks.​</descrip></descripGrp><ntig><termGrp><term id="2844883">Microsoft Defender XDR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3144503">Defender XDR</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50346_3144484_2847612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The end-to-end security solution designed to provide a view of an organization's overall threat landscape so that administrators can easily spot new threats and attacks.​</descrip></descripGrp><ntig><termGrp><term id="3144484">Defender XDR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2847612">Microsoft Defender XDR</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50346_3144484_3144503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The end-to-end security solution designed to provide a view of an organization's overall threat landscape so that administrators can easily spot new threats and attacks.​</descrip></descripGrp><ntig><termGrp><term id="3144484">Defender XDR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3144503">Defender XDR</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50347_2844884_2847797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within the Microsoft 365 Compliance Center that allows admins to test out their auto-labeling policy before deploying it at scale. This feature allows users to understand the impact of coverage and effectiveness of an auto-labeling policy prior to implementation.</descrip></descripGrp><ntig><termGrp><term id="2844884">Policy Simulation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2847797">Simulación de políticas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50348_2844886_2847701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A content hub website within Microsoft 365 that provides consumers with content supporting Microsoft 365 consumer offerings.</descrip></descripGrp><ntig><termGrp><term id="2844886">Modern Life Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2847701">Centro de vida moderna</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50349_2844887_2847090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within Azure Active Directory that provides an instant enforcement of policies such as account deletion, password changes, session revocation, device compliance state change, and user location changes.</descrip></descripGrp><ntig><termGrp><term id="2844887">Continuous Access Evaluation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2847090">Avaliación continua do acceso</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</te