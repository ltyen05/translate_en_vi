e type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2470438">aplicación empresarial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10038_295550_498737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A personal record of experiences, occurrences or proceedings, like a Baby Book or Life Book.</descrip></descripGrp><ntig><termGrp><term id="295550">journal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498737">diario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10039_56540_497640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of many sequential images that make up video or animation.</descrip></descripGrp><ntig><termGrp><term id="56540">frame</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497640">fotograma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1004_77322_497775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The individual, or account, to whom an email message is sent.</descrip></descripG