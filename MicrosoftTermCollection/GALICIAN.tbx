 Deployment Service.</descrip></descripGrp><ntig><termGrp><term id="1162840">Deployment Administration Server</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1275760">Servidor de administración de despregamento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2486_143220_2282826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that heightens the color contrast of some text and images on your screen, making those items more distinct and easier to identify.</descrip></descripGrp><ntig><termGrp><term id="143220">High Contrast</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2282826">Contraste alto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24860_1162841_1275819"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single physical or virtual server that contains all the server roles.</descrip></descripGrp><ntig><termGrp><term id="1162841">full server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1275819">servidor completo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="gramm