ion">The tab that presents the most basic information about an entity/record type or instance/record in the system.</descrip></descripGrp><ntig><termGrp><term id="475203">General</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1305892">Xeral</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5452_25722_497384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of memory measurement that consists of eight bits.</descrip></descripGrp><ntig><termGrp><term id="25722">byte</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497384">byte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54525_3097635_3098216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A plan that provides different types of assets, such as medical, health, and hospitalization benefits or income in the event of sickness, accident, or death.</descrip></descripGrp><ntig><termGrp><term id="3097635">benefit plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3098216">plan de vantaxes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalN