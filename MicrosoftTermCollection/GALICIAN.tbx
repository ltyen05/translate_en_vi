p></ntig></langSet></termEntry><termEntry id="45663_2572287_2576345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A possible danger of an attack that takes advantage of computer security holes for which the creation of a patch would take at least a day.</descrip></descripGrp><ntig><termGrp><term id="2572287">zero-day threat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2576345">ameaza do día cero</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45666_2572288_2576316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agent that collects data from an endpoint.</descrip></descripGrp><ntig><termGrp><term id="2572288">end-point agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2576316">axente de extremo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45666_2572288_2576352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agent that collects data from an endpoint.</descrip></descripGrp><ntig><termGrp><term id="2572288">end-point agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2576352">axente do extremo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</term