"partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17823_650183_1178846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A format, such as cell shading or font color, that Excel automatically applies to cells if a specified condition is true.</descrip></descripGrp><ntig><termGrp><term id="650183">conditional format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178846">formato condicional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17826_650186_1139803"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The type of Web Part connection. For example, the Provide Row To connection type passes a row of data from one Web Part to another Web Part.</descrip></descripGrp><ntig><termGrp><term id="650186">connection type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1139803">tipo de conexión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17828_650188_1178847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of buttons used to move through contact items displayed in Address Cards or Detailed Address Cards view. The Contact index moves the focus to the first contact whose name begins with the selected character.</descrip></descripGrp><ntig><termGrp><term id="650188">Contact index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178847">índice de contactos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17842_650202_1178848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color that is essential to the CMY color model and the CMYK color-mixing method.</descrip></descripGrp><ntig><termGrp><term id="650202">cyan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178848">ciano</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17844_650204_1178849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programming interface to access and manipulate database objects.</descrip></descripGrp><ntig><termGrp><term id="650204">DAO</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178849">DAO</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17844_650204_2094430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programming interface to access and manipulate database objects.</descrip></descripGrp><ntig><termGrp><term id="650204">DAO</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094430">Obxectos de acceso a datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17844_651820_1178849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programming interface to access and manipulate database objects.</descrip></descripGrp><ntig><termGrp><term id="651820">Data Access Objects</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178849">DAO</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17844_651820_2094430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programming interface to access and manipulate database objects.</descrip></descripGrp><ntig><termGrp><term id="651820">Data Access Objects</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094430">Obxectos de acceso a datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17848_650208_2094438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of creating two or more special copies (replicas) of an Access database. Replicas can be synchronized, changes made to data in one replica, or design changes made in the Design Master, are sent to other replicas.</descrip></descripGrp><ntig><termGrp><term id="650208">database replication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094438">replicación de base de datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17851_650211_2094440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that is used to separate the day, month, and year when date values are formatted. The characters are determined by system settings or by the Format function.</descrip></descripGrp><ntig><termGrp><term id="650211">date separator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094440">separador de data</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17853_650213_2094442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default property setting of a control type. You customize a control type before you create two or more similar controls to avoid customizing each control individually.</descrip></descripGrp><ntig><termGrp><term id="650213">default control style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094442">estilo de control predefinido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17854_650214_1178850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The font that a program uses by default to display text.</descrip></descripGrp><ntig><termGrp><term id="650214">default font</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178850">tipo de letra predefinido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17855_650215_2094443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A property that you can set for a control so that each time a new control of that type is created, this property will have the same value.</descrip></descripGrp><ntig><termGrp><term id="650215">default property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094443">propiedade predefinida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17859_650219_1707035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of time between the scheduled start of a task and the time when work should actually begin on the task.</descrip></descripGrp><ntig><termGrp><term id="650219">delay</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1707035">atraso</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17861_650221_2094444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The grid that you use to design a query or filter in query Design view or in the Advanced Filter/Sort window. For queries, this grid was formerly known as the QBE grid.</descrip></descripGrp><ntig><termGrp><term id="650221">design grid</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094444">cuadrícula de deseño</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17863_650223_2094446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of PivotTable view that contains detail and total fields.</descrip></descripGrp><ntig><termGrp><term id="650223">detail area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094446">área de detalles</term><termNote type="geographica