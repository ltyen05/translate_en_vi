-US"><descripGrp><descrip type="definition">A public building used for town or city government offices and meetings.</descrip></descripGrp><ntig><termGrp><term id="3149024">city hall</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3149613">concello</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55975_3149025_3149610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database or spreadsheet tool that allows the user to view selected rows and columns of data from different perspectives (or "pivots").</descrip></descripGrp><ntig><termGrp><term id="3149025">pivot table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3149610">táboa dinámica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55977_3149113_3149612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who speaks at a meeting or online event.</descrip></descripGrp><ntig><termGrp><term id="3149113">speaker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3149612">orador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55980_3149769_3150331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Sexually explicit images or videos that are distributed without the consent of the individuals depicted.</descrip></descripGrp><ntig><termGrp><term id="3149769">non-consensual intimate imagery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150331">imaxes íntimas sen consentimento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55981_3149770_3150329"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A review process performed by a human, as opposed to automated or AI-driven review.</descrip></descripGrp><ntig><termGrp><term id="3149770">human review</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150329">revisión humana</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55982_3149771_3150340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the context of user interface design, a rectangular component that can have any border-radius from 0px to 100%.</descrip></descripGrp><ntig><termGrp><term id="3149771">pill</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150340">cápsula</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55983_3150428_3150715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ability of an AI-powered system to link together a series of actions or procedures based on changing inputs or conditions. This means the system can adapt its behavior or decision-making process in real-time based on the current context or situation.</descrip></descripGrp><ntig><termGrp><term id="3150428">dynamic chaining</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150715">encadeamento dinámico</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55984_3150429_3150716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ability of an AI-powered chatbot to understand and remember the context of a conversation and use it to fill in missing information in the current user request.</descrip></descripGrp><ntig><termGrp><term id="3150429">dynamic slot filling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150716">enchemento dinámico de ocos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55985_3150430_3150717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that can be used for AI-powered bots to create a new topic or edit an existing one by describing what a user wants to happen or have their bot generate conversational responses even if there isn't a matching topic.</descrip></descripGrp><ntig><termGrp><term id="3150430">intelligent authoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150717">creación intelixente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55986_3150431_3150718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-powered technology that relies on an ability to understand what a user says. The NLU engine creates a language model from sets of training examples. Once trained, the engine uses the model to predict the intent of an utterance.</descrip></descripGrp><ntig><termGrp><term id="3150431">natural language understanding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150718">comprensión de linguaxe natural</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55986_3150431_3150719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-powered technology that relies on an ability to understand what a user says. The NLU engine creates a language model from sets of training examples. Once trained, the engine uses the model to predict the intent of an utterance.</descrip></descripGrp><ntig><termGrp><term id="3150431">natural language understanding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150719">CLN</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55986_3150452_3150718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-powered technology that relies on an ability to understand what a user says. The NLU engine creates a language model from sets of training examples. Once trained, the engine uses the model to predict the intent of an utterance.</descrip></descripGrp><ntig><termGrp><term id="3150452">NLU</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150718">comprensión de linguaxe natural</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55986_3150452_3150719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-powered technology that relies on an ability to understand what a user says. The NLU engine creates a language model from sets of training examples. Once trained, the engine uses the model to predict the intent of an utterance.</descrip></descripGrp><ntig><termGrp><term id="3150452">NLU</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150719">CLN</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55987_3150432_3150720"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action that can be called from a topic, connector, flow, or skill. It extends the capabilities of your bot by using AI to ask your users questions to fill in missing information and can dynamically generate information for your users.</descrip></descripGrp><ntig><termGrp><term id="3150432">plugin action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150720">acción de complemento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55988_3150433_3150721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common topic used in conversations with a bot. System topics are built into Microsoft Copilot Studio and are added to a bot automatically when a user creates it. They help the bot respond to common system events, such as escalation, or carry out essential behavior, such as ending a conversation.</descrip></descripGrp><ntig><termGrp><term id="3150433">system topic</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150721">tema do sistema</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55989_3150434_3150722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Power Pages feature that allows makers to embed advanced sequential multistep forms to a webpage without code. Also, makers will be able to preview each step of the form in the design studio canvas.</descrip></descripGrp><ntig><termGrp><term id="3150434">multistep form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150722">formulario con varios pasos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55990_3150435_3150723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A self-service diagnostic tool that can be used by administrators to identify common issues in their website. It helps to identify issues with a website by looking at various configuration parameters and provides suggestions on how to fix them.</descrip></descripGrp><ntig><termGrp><term id="3150435">site checker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150723">verificador de sitios</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55991_3150436_3150724"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A profile that can be set up to create targeted app experiences for agents and supervisors, being an alternative to building and maintaining custom apps. With the agent experience profiles, administrators can create custom profiles with specific session templates, conversation channels, and productivity tools. These profiles can then be assigned to users.</descrip></descripGrp><ntig><termGrp><term id="3150436">agent experience profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150724">perfil de experiencia do axente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55992_3150437_3150725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A script that provides guidance about what an agent should do when they get a customer issue and ensure that they share only accurate and company-endorsed information. Agent scripts help agents be accurate, effective, and efficient in customer handling.</descrip></descripGrp><ntig><termGrp><term id="3150437">agent script</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150725">script de axente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55993_3150438_3150726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Dynamics 365 Customer Service feature that allows agents to easily recap an ongoing customer interaction. Agents can generate a conversation summary when they either transfer a conversation, add a user to consult, or start a linked Teams chat. The summary quickly provides context and relays any steps they've already taken.</descrip></descripGrp><ntig><termGrp><term id="3150438">auto-summarization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150726">resumo automático</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55994_3150439_3150727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A profile that can be created in Dynamics 365 Customer Service and assigned to agents to define the types and amount of work they can take. Capacity profiles contain information, such as the amount of work, concurrent or daily capacity, and whether other channels are affected.</descrip></descripGrp><ntig><termGrp><term id="3150439">capacity profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150727">perfil de capacidade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55995_3150440_3150728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that can be configured in Dynamics 365 Customer Service to help supervisors plan the right level of staffing for their business based on predicted volumes of cases to ensure that they have an adequate number of agents available to serve their customers.</descrip></descripGrp><ntig><termGrp><term id="3150440">case forecasting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150728">previsión de casos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55996_3150441_3150729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability provided to organizations for using the customer communication functions running on the cloud.</descrip></descripGrp><ntig><termGrp><term id="3150441">CCaaS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150729">CCaaS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55997_3150442_3150730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A live chat widget that can be displayed on an organization's portal for customers to interact with bots and human agents.</descrip></descripGrp><ntig><termGrp><term id="3150442">chat widget</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150730">widget de chat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55998_3150443_3150731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line-of-business application or component whose user interface is hosted in the shell application.</descrip></descripGrp><ntig><termGrp><term id="3150443">hosted application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150731">aplicación aloxada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55999_3150444_3150732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A functionality that helps ingest data from third party sources into Dynamics 365 Customer Service. This gives the ability to identify the most relevant and contextual content across knowledge sources which helps agents find the most suitable solution for customers easily.</descrip></descripGrp><ntig><termGrp><term id="3150444">integrated search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150732">busca integrada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56000_3150445_3150733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intelligent assistant that provides real-time recommendations to agents, helping them take actions while interacting with customers. It allows organizations to build a custom bot and plug-in to their environment. These custom bots interpret conversations in real time and provide relevant recommendations such as knowledge articles, similar cases, and next-best steps to the agent's user interface.</descrip></descripGrp><ntig><termGrp><term id="3150445">smart assist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150733">asistencia intelixente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56001_3150446_3150734"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Customer Service feature that provides agents with the ability to receive and make public switched telephone network (PSTN) calls through a native calling experience in Dynamics 365.</descrip></descripGrp><ntig><termGrp><term id="3150446">Omnichannel Voice</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3150734">Voz de Multicanle</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56002_3150644_3152066"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams offering available to customers in the EEA and Switzerland that provides meetings, chat, calling (VOIP), and collaboration without any limitation on seat numbers.</descrip></descripGrp><ntig><termGrp><term id="3150644">Microsoft Teams EEA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3152066">Microsoft Teams EEE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56002_3150644_3152068"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams offering available to customers in the EEA and Switzerland that provides meetings, chat, calling (VOIP), and collaboration without any limitation on seat numbers.</descrip></descripGrp><ntig><termGrp><term id="3150644">Microsoft Teams EEA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3152068">Teams EEE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56002_3150645_3152066"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams offering available to customers in the EEA and Switzerland that provides meetings, chat, calling (VOIP), and collaboration without any limitation on seat numbers.</descrip></descripGrp><ntig><termGrp><term id="3150645">Teams EEA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3152066">Microsoft Teams EEE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56002_3150645_3152068"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams offering available to customers in the EEA and Switzerland that provides meetings, chat, calling (VOIP), and collaboration without any limitation on seat numbers.</descrip></descripGrp><ntig><termGrp><term id="3150645">Teams EEA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3152068">Teams EEE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56003_3150646_3152058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To plan the details of something in advance.</descrip></descripGrp><ntig><termGrp><term id="3150646">blueprint</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3152058">planificar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56004_3151343_3152059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to blur the background of an image to bring crisp focus to the most important part of the image.</descrip></descripGrp><ntig><termGrp><term id="3151343">blur background</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3152059">desenfoque do fondo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56005_3151344_3152065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instruction or question you use to tell Copilot what you want.</descrip></descripGrp><ntig><termGrp><term id="3151344">Copilot prompt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3152065">indicación de Copilot</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56006_3151345_3155909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collaboration feature that allows users to search and discover people across multiple tenants.</descrip></descripGrp><ntig><termGrp><term id="3151345">people search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3155909">busca de persoas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56007_3151346_3155903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Entra ID and Microsoft 365 that enables users to form a tenant group within an organization.</descrip></descripGrp><ntig><termGrp><term id="3151346">multitenant organization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3155903">organización con varios arrendatarios</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56008_3151380_3151524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collaboration space that can be created in Microsoft Teams to connect people from your organization and customers related to your project together in a team that includes the apps and channels you need to make progress faster.</descrip></descripGrp><ntig><termGrp><term id="3151380">deal room</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3151524">sala de negociación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56009_3151381_3151525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control in model-driven apps that allows users to view, open, and edit records from views and subgrids. In addition to inline editing, the control provides other capabilities including a modern data browsing experience via infinite scrolling, allowing users to scroll indefinitely through data until they find the records they're interested in, and an ability to customize the visual appearance of columns for specific needs.</descrip></descripGrp><ntig><termGrp><term id="3151381">grid control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3151525">control de grade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56010_3151382_3151526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A score that shows the overall health and trend of each of your business relationships. It is calculated by collecting the relevant activities, and weighting the activity by type. The result is normalized to produce a health score between 0 and 100, and the health characterized as good (for a score of 60-100), fair (40-59) or poor (0-39).</descrip></descripGrp><ntig><termGrp><term id="3151382">health score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3151526">puntuación de estado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56011_3151383_3151527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A prompt that a user can use to catch up on the updates to their lead records since the last seven days or the last login. The catch up information is generated from the audit history.</descrip></descripGrp><ntig><termGrp><term id="3151383">lead catchup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3151527">posta ao día de clientes potenciais</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56012_3151384_3151528"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-powered summary that allows sellers to access a quick overview of leads from various sources. This feature saves time and effort and ensures that sales teams focus on the most promising leads, leading to increased seller productivity and efficiency.</descrip></descripGrp><ntig><termGrp><term id="3151384">lead summary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3151528">resumo de clientes potenciais</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56013_3151385_3151529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A prompt that a user can use to catch up on the updates to their opportunity records since the last seven days or the last login. The catch up information is generated from the audit history.</descrip></descripGrp><ntig><termGrp><term id="3151385">opportunity catchup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3151529">posta ao día de oportunidades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56014_3151386_3151530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A summary of each opportunity generated by Sales Copilot with key information like sales stage, budget, and close date. This helps you interact better with customers and boost sales and customer satisfaction.</descrip></descripGrp><ntig><termGrp><term id="3151386">opportunity summary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3151530">resumo de oportunidades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56027_3152018_3153189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2024 public preview version of Microsoft Office Professional Plus that utilizes the LTSC servicing model.</descrip></descripGrp><ntig><termGrp><term id="3152018">Microsoft Office LTSC Professional Plus 2024 Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3153189">Versión preliminar de Microsoft Office LTSC Professional Plus 2024</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56028_3152019_3153192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2024 public preview version of Microsoft Project Professional.</descrip></descripGrp><ntig><termGrp><term id="3152019">Microsoft Project Professional 2024 Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3153192">Versión preliminar de Microsoft Project Professional 2024</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56029_3152020_3153194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2024 public preview version of Microsoft Visio Professional that utilizes the LTSC servicing model.</descrip></descripGrp><ntig><termGrp><term id="3152020">Microsoft Visio LTSC Professional 2024 Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3153194">Versión preliminar de Microsoft Visio LTSC Professional 2024</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56030_3152021_3153190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The preview version of Access.</descrip></descripGrp><ntig><termGrp><term id="3152021">Access Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3153190">Versión preliminar de Access</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56031_3152022_3153191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The preview version of Excel.</descrip></descripGrp><ntig><termGrp><term id="3152022">Exce