Set></termEntry><termEntry id="14140_335527_1178805"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A commercial organization.</descrip></descripGrp><ntig><termGrp><term id="335527">company</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178805">empresa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14146_183989_2094482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the grouping window in which most user interaction takes place.</descrip></descripGrp><ntig><termGrp><term id="183989">grouping pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094482">panel de agrupación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14147_93948_497903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An alphanumeric code assigned to all addresses in order to facilitate mail delivery.</descrip></descripGrp><ntig><termGrp><term id="93948">postal code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497903">código postal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14148_140884_498165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A combination of a digital certificate and a public and private encryption key set.</descrip></descripGrp><ntig><termGrp><term id="140884">Digital ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498165">ID dixital</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1415_64659_497685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The processes involved in the capture, storage, display, and printing of graphical images.</descrip></descripGrp><ntig><termGrp><term id="64659">imaging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497685">procesamento de imaxes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14155_233476_610976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of artificially delaying server responses for specific SMTP communication patterns that indicate high volumes of spam or other unwelcome email messages. The intent is to slow down the communication process for such email traffic so that the cost of sending spam increases for the person or organization who is sending the email.</descrip></descripGrp><ntig><termGrp><term id="233476">tarpitting</term><termNote t