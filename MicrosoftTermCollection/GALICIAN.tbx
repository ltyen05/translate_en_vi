ermNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1658241">fonte de noticias</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24108_1098542_1139931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A script-based applet that is stored as a favorite or bookmark in a web browser, or is accessed through a hyperlink on a webpage.</descrip></descripGrp><ntig><termGrp><term id="1098542">bookmarklet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1139931">miniaplicación favorita</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24109_1098543_1707030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of associating a feature with a site definition, without modifying the site definition itself or using code routines. The associated feature is added automatically to new sites that are based on that site definition.</descrip></descripGrp><ntig><termGrp><term id="1098543">feature stapling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1707030">asociación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24109_1275537_1707030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of associating a feature with a site definition, without modifying the site definition itself or using code routines. The associated feature is added automatically to new sites that are based on that site definition.</descrip></descripGrp><ntig><termGrp><term id="1275537">stapling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1707030">asociación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24121_1098843_2238653"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A candidate key that is not designated as the primary key and is used to uniquely identify records in a database table.</descrip></descripGrp><ntig><termGrp><term id="1098843">alternate key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2238653">clave alternativa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24124_1098902_2686494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transfer of certain properties, such as open files, from a parent program or process to another program or process that the parent causes to run.</descrip></descripGrp><ntig><termGrp><term id="1098902">inheritance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2686494">herdanza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24134_1098938_2229459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text-editing program that lets users create instant messages or blog posts that contain rich text elements, such as text formatting and embedded images.</descrip></descripGrp><ntig><termGrp><term id="1098938">rich-text editor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2229459">editor de texto enriquecido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24138_1098950_1374641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the form where a user can report violations of the terms of use. Contextually, it's understood that the abuse in question is poor conduct, such as obscene language or threats.</descrip></descripGrp><ntig><termGrp><term id="1098950">Report Abuse</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1374641">Notificar abuso</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24139_1098951_2913215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Rules that explain how someone should behave while using a service or product.</descrip></descripGrp><ntig><termGrp><term id="1098951">code of conduct</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913215">código de conduta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2414_4707_1973603"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tested, cumulative set of hotfixes, security updates, critical updates, and updates packaged together for easy deployment. A rollup generally targets a specific area, such as security, or component of a product, such as Microsoft Internet Information Services (IIS).</descrip></descripGrp><ntig><termGrp><term id="4707">update rollup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1973603">paquete de actualizacións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24142_1098959_1718155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code that grants rights to an individual, for example to use a system or access stored data.</descrip></descripGrp><ntig><termGrp><term id="1098959">authorization code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1718155">código de autorización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24171_1755527_1759740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web portal from which each company’s service administrator can manage user accounts and settings for each of the Office 365 services to which they subscribe.</descrip></descripGrp><ntig><termGrp><term id="1755527">Office 365 admin center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1759740">Centro de administración de Office 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24196_1115313_2767459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program or program module that adds functionality to or extends the effectiveness of a program.</descrip></descripGrp><ntig><termGrp><term id="1115313">extension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2767459">extensión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24197_1115314_2511471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text-based, data interchange format that is used to transmit structured data, typically in Ajax Web applications.</descrip></descripGrp><ntig><termGrp><term id="1115314">JavaScript Object Notation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2511471">Notación de obxectos JavaScript</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24197_1115314_2511473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text-based, data interchange format that is used to transmit structured data, typically in Ajax Web applications.</descrip></descripGrp><ntig><termGrp><term id="1115314">JavaScript Object Notation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2511473">JSON</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24197_1115315_2511471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text-based, data interchange format that is used to transmit structured data, typically in Ajax Web applications.</descrip></descripGrp><ntig><termGrp><term id="1115315">JSON</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2511471">Notación de obxectos JavaScript</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24197_1115315_2511473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text-based, data interchange format that is used to transmit structured data, typically in Ajax Web applications.</descrip></descripGrp><ntig><termGrp><term id="1115315">JSON</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2511473">JSON</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2420_308318_498815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date after which information or a resource is no longer valid.</descrip></descripGrp><ntig><termGrp><term id="308318">expiration date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498815">data de caducidade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24215_1115333_1139942"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compressed file that can be deployed to a server farm or a site. It can contain assemblies, resource files, site and feature definitions, templates, code access security policies, and Web Parts.</descrip></descripGrp><ntig><termGrp><term id="1115333">solution package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1139942">paquete de solución</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24225_1115347_2360769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A block of cells selected for similar treatment in a spreadsheet. A range of cells can extend across a row, down a column, or over a combination of the two, but all cells in the range must be contiguous, sharing at least one common border.</descrip></descripGrp><ntig><termGrp><term id="1115347">range</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2360769">intervalo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24245_1117153_1520520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An installation package that the user downloads from http://download.live.com/?mkt=en-us.</descrip></descripGrp><ntig><termGrp><term id="1117153">download</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1520520">descarga</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24247_1117155_1374642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The main landing or start page on Windows Live.</descrip></descripGrp><ntig><termGrp><term id="1117155">Windows Live Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1374642">Páxina de inicio de Windows Live</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2425_34681_497459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined set of harmonized colors that you can apply to text and objects. Text and objects with an applied scheme color will change automatically when you switch to a new color scheme or modify the current color scheme.</descrip></descripGrp><ntig><termGrp><term id="34681">color scheme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497459">esquema de cores</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24254_1117166_2767295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that connects networks using the same communications protocols so that information can be passed from one to the other.</descrip></descripGrp><ntig><termGrp><term id="1117166">bridge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2767295">ponte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24284_1119138_2387923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-defined and annotated group of points of interest on a map.</descrip></descripGrp><ntig><termGrp><term id="1119138">collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2387923">colección</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24287_1119142_1649896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button next to a search box that someone clicks to search for something.</descrip></descripGrp><ntig><termGrp><term id="1119142">Search button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1649896">botón Buscar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24289_1119158_1275817"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view to which a set of conditions have been applied to reduce the total number of displayed objects.</descrip></descripGrp><ntig><termGrp><term id="1119158">filtered view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1275817">visualización filtrada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24304_1119174_2720726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The shared service that securely stores credential sets for external data sources and associates those credential sets to identities of individuals or to group identities. This service can be used to support a variety of solutions. For example, the stored credentials can be leveraged by certain applications to enable single sign-on.</descrip></descripGrp><ntig><termGrp><term id="1119174">Secure Store Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2720726">Almacenamento seguro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24304_1162515_2720726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The shared service that securely stores credential sets for external data sources and associates those credential sets to identities of individuals or to group identities. This service can be used to support a variety of solutions. For example, the stored credentials can be leveraged by certain applications to enable single sign-on.</descrip></descripGrp><ntig><termGrp><term id="1162515">SSS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2720726">Almacenamento seguro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24304_2717982_2720726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The shared service that securely stores credential sets for external data sources and associates those credential sets to identities of individuals or to group identities. This service can be used to support a variety of solutions. For example, the stored credentials can be leveraged by certain applications to enable single sign-on.</descrip></descripGrp><ntig><termGrp><term id="2717982">Secure Store</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2720726">Almacenamento seguro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24349_1122704_2822372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A licensing and delivery model that groups a set of related features, products, components, or functionality together in support of one or more business processes. It may comprise a range of components or features but customers perceive it as a single, coherent entity.</descrip></descripGrp><ntig><termGrp><term id="1122704">service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGr