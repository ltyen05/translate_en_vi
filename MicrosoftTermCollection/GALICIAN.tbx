rip type="definition">A challenge meant to be easily solved by humans, while remaining too hard to be economically solved by computers.</descrip></descripGrp><ntig><termGrp><term id="747523">Completely Automated Public Turing test to tell Computers and Humans Apart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2050224">desafío HIP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54300_3096552_3097120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A historical account of information about a topic, feature, or state that includes textual and visual elements and can be exported and shared.</descrip></descripGrp><ntig><termGrp><term id="3096552">report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3097120">informe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54301_3096553_3097114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Unlawful or unauthorized access to or use of systems, equipment, or facilities resulting in disclosure, modification, destruction, or other compromise of customer data.</descrip></descripGrp><ntig><termGrp><term id="3096553">customer data breach</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3097114">vulneración de datos de cliente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54302_3096554_3097121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An issue that has potential to result in a customer data breach, including violations of security policies, acceptable use policies, or standard security practices.</descrip></descripGrp><ntig><termGrp><term id="3096554">security incident</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3097121">incidente de seguranza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54303_3096555_3097117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mitigation of violations of security policies and recommended practices.</descrip></descripGrp><ntig><termGrp><term id="3096555">incident handling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3097117">tratamento de incidentes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54304_3096556_3097119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security incident that involves the accidental or unauthorized exposure or alteration of customer content and end-user identifiable information (EUII) in Microsoft 365 services.</descrip></descripGrp><ntig><termGrp><term id="3096556">privacy issue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3097119">problema de privacidade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54312_3097234_3098944"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An observable change to the normal behavior of a system, environment, process, workflow or person; any observable occurrence in a system or network.</descrip></descripGrp><ntig><termGrp><term id="3097234">security event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3098944">evento de seguranza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54313_3097235_3098942"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An automated notification resulting from a detection.</descrip></descripGrp><ntig><termGrp><term id="3097235">security alert</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3098942">alerta de seguranza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</te