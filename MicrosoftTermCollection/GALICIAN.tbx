rmNote></termGrp></ntig></langSet></termEntry><termEntry id="10558_557724_1308228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of workflow that runs only when a user specifically starts it from within the Web application UI. User action is required to start the workflow.</descrip></descripGrp><ntig><termGrp><term id="557724">on-demand workflow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1308228">fluxo de traballo a pedido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10559_32556_1950093"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Occurring on the client side of a client-server system. For example, on the World Wide Web, JavaScript scripts are client-side because they are executed by your browser (the client). In contrast, CGI scripts are server-side because they run on the Web server. Java applets can be either server-side or client-side depending on which computer (the server or the client) executes them.</descrip></descripGrp><ntig><termGrp><term id="32556">client-side</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950093">de parte do cliente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10561_19019_2016033"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task that is part of an operating system or program, and is operating without interaction with the user while the user is working on another task.</descrip></descripGrp><ntig><termGrp><term id="19019">background task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2016033">tarefa en segundo plano</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10565_375737_380466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of deploying new Edge Transport servers based on the configuration information of a previously configured source server. The configuration information of the previously configured source server is copied and exported to an XML file, which is then imported to the target server.</descrip></descripGrp><ntig><termGrp><term id="375737">cloned configuration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="380466">configuración clonada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10566_26904_2094407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">All modules that might be called by any procedure in the module in which code is currently running.</descrip></descripGrp><ntig><termGrp><term id="26904">call tree</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094407">árbore de chamadas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10572_24731_2094405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar that is part of an application when it's installed on your computer.</descrip></descripGrp><ntig><termGrp><term id="24731">built-in toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094405">barra de ferramentas integrada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10575_3794_497247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Malware that replicates, commonly by infecting other files in the system, thus allowing the execution of the malware code and its propagation when those files are activated.</descrip></descripGrp><ntig><termGrp><term id="3794">virus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497247">virus</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10579_106311_2766702"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of selecting paths in a network along which to send network traffic.</descrip></descripGrp><ntig><termGrp><term id="106311">routing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2766702">encamiñamento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10581_318761_498958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ] character.</descrip></descripGrp><ntig><termGrp><term id="318761">right bracket</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498958">corchete de peche</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10581_318763_498958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ] character.</descrip></descripGrp><ntig><termGrp><term id="318763">right square bracket</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498958">corchete de peche</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10581_318764_498958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ] character.</descrip></descripGrp><ntig><termGrp><term id="318764">closing square bracket</term><termNote type="partOfSpee