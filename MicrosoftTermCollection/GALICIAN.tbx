ermGrp><term id="498132">corpo do texto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11479_137930_498132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text that forms the major content of a publication. Does not include titles, headlines, pull quotes, and captions, for example.</descrip></descripGrp><ntig><termGrp><term id="137930">body text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498132">corpo do texto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11481_109185_2094660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group that can be listed in discretionary access control lists (DACLs) used to define permissions on resources and objects. A security group can also be used as an email entity. Sending an email message to the group sends the message to all the members of the group.</descrip></descripGrp><ntig><termGrp><term id="109185">security group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094660">grupo de seguridade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11486_126144_2015264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type that can only hold a whole number with a value greater than, or equal to, zero. In this implementation, the maximum value that an unsigned integer can hold is 0xFFFFFFFF (4,294,967,295).</descrip></descripGrp><ntig><termGrp><term id="126144">unsigned integer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2015264">número enteiro sen signo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11487_212898_1336593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to applications or commands run in the order listed and that must finish before the next application or command is run.</descrip></descripGrp><ntig><termGrp><term id="212898">synchronous</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1336593">síncrono</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11487_2479307_1336593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to applications or commands run in the order listed and that must finish before the next application or command is run.</descrip></descripGrp><ntig><termGrp><term id="2479307">sync</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><ter