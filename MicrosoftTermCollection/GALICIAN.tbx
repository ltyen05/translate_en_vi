Note type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54040_3080863_3082264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The product that provides context-aware cloud posture management with agentless vulnerability scanning, and attack paths analysis built on top of a new intelligent cloud security graph.</descrip></descripGrp><ntig><termGrp><term id="3080863">Defender CSPM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3082264">Xestión da posición de seguranza da nube de Microsoft Defender</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54045_3080956_3082271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Purview Information Protection that can automatically label files that have previously been auto-classified with the appropriate classification and sensitivity label.</descrip></descripGrp><ntig><termGrp><term id="3080956">scanner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3082271">escáner</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54046_3080957_3082276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies the first period in the calculation.</descrip></descripGrp><ntig><termGrp><term id="3080957">start_period</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3082276">período_inicial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54047_3080958_3082261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies the last period in the calculation.</descrip></descripGrp><ntig><termGrp><term id="3080958">end_period</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3082261">período_final</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54048_3080959_3082275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies the first, or starting date of a given period.</descrip></descripGrp><ntig><termGrp><term id="3080959">start_date</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3082275">data_inicial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54049_3080960_3082259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies the last, or ending, date of the period.</descrip></descripGrp><ntig><termGrp><term id="3080960">end_date</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3082259">data_final</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5405_77118_497773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of keystrokes and instructions recorded and saved as a key combination (such as CTRL + X) or file name. When the macro is used, all of the recorded steps are performed automatically. Macros save time by replacing a series of frequently performed steps with a simple key combination or name.</descrip></descripGrp><ntig><termGrp><term id="77118">macro</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497773">macro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54050_3080961_3082257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in the DATEVALUE Excel function that represents a date in an Excel date format, or a reference to a cell that contains text that represents a date in an Excel date format.</descrip></descripGrp><ntig><termGrp><term id="3080961">date_text</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3082257">texto_de_data</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54051_3080962_3082273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies a number in the date-time code used by Excel.</descrip></descripGrp><ntig><termGrp><term id="3080962">serial_number</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3082273">núm_de_serie</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54052_3082099_3082649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability in Dynamics 365 Customer Service that schedules resources for service activity. It considers the availability of employees, facilities, and equipment to plan schedules accordingly. It also helps customer service organizations with improved service quality by preventing over-scheduling. It is built on top of Universal Resource Scheduling (URS).</descrip></descripGrp><ntig><termGrp><term id="3082099">Dynamics 365 Core Service Scheduling</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3082649">Programación de servizos básicos de Dynamics 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54053_3082100_3082648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app module that help employees create cases for their problems and interact with agents through the commenting feature. The app enables also searching the knowledge base for solutions pertaining to their problems.</descrip></descripGrp><ntig><termGrp><term id="3082100">Customer Service Team Member</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3082648">Membro do equipo do servizo de atención ao cliente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54054_3082101_3082652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to search various knowledge sources, e.g. a knowledge base.</descrip></descripGrp><ntig><termGrp><term id="3082101">knowledge search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3082652">busca de coñecemento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54055_3082102_3082647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The insight in Dynamics 365 Sales Conversation Intelligence. This insight shows the number of calls where the negative customer sentiments are more than average.</descrip></descripGrp><ntig><termGrp><term id="3082102">Customer sentiment</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3082647">Opinión do cliente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54056_3082103_3082657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The insight in Dynamics 365 Sales Conversation Intelligence. This insight shows the tracked keywords that are defined in the application and that customers use the most during the sales calls. Conversation intelligence highlights these tracked keywords in this insight.</descrip></descripGrp><ntig><termGrp><term id="3082103">Tracked keywords</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3082657">Palabras clave rastrexadas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54057_3082104_3082656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The insight in Dynamics 365 Sales Conversation Intelligence. This insight shows the defined competitors' names that customers use most and are trending upwards during the sales calls. Conversation intelligence highlights these competitors in this section.</descrip></descripGrp><ntig><termGrp><term id="3082104">Tracked competitors</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3082656">Competidores rastrexados</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54058_3082105_3082653"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The insight in Dynamics 365 Sales Conversation Intelligence. This insight helps to discover new products, brands, and organizations that customers are speaking about in sales calls, which they never spoke of in previous calls. These products, brands, and organizations are not defined in the application (tracked keywords and competitors), and the application uses Microsoft Bing's knowledge repository to identify the products, brands, and organizations to display.</descrip></descripGrp><ntig><termGrp><term id="3082105">Other brands and organizations</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3082653">Outras marcas e organizacións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54059_3082106_3082650"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intelligent chat bot that can answer frequently asked questions, created by the Employee FAQ template. If an answer cannot be provided, it automatically collects requests and notifies human experts in Microsoft Teams channel. Then experts can chat directly with employees on Teams, in order to resolve the request.</descrip></descripGrp><ntig><termGrp><term id="3082106">FAQ bot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3082650">bot de preguntas máis frecuentes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54060_3082107_3082651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A multi-disciplinary team of developers, users, and business leaders that use their specific disciplines and expertise to help build a product that aligns to one common goal. By combining the team’s knowledge with the latest technology, fusion teams can deliver products and solutions faster and more efficiently.</descrip></descripGrp><ntig><termGrp><term id="3082107">fusion team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3082651">equipo de colaboración</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54062_3083270_3083715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Clock app which helps users minimize distractions by turning on Do Not Disturb and silencing icon flashing and badge notifications for apps in the taskbar.</descrip></descripGrp><ntig><termGrp><term id="3083270">focus session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3083715">sesión de concentración</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54063_3083390_3085157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Defender for Business add-on that delivers the same level of protection for both clients and servers within a single admin experience, helping users to protect all endpoints in one location.</descrip></descripGrp><ntig><termGrp><term id="3083390">Microsoft Defender for Business servers</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3085157">Microsoft Defender para servidores empresariais</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54066_3083517_3083716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical recording studio that creates holographic video—holograms of dynamic people and performances.</descrip></descripGrp><ntig><termGrp><term id="3083517">mixed reality capture studio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3083716">estudio de captura de realidade mixta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54069_3083575_3083717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video that can be viewed as a flat video from any given viewpoint but exists volumetrically in 3D space, offering viewers a more immersive experience.</descrip></descripGrp><ntig><termGrp><term id="3083575">volumetric video</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3083717">vídeo volumétrico</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54071_3083658_3083718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The prefix displayed on a badge indicating the search result originates from the Web.</descrip></descripGrp><ntig><termGrp><term id="3083658">Web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3083718">Web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54072_3083695_3085141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 offer for one person that includes 100 GB of cloud storage with advanced file and photo protection, secure, ad-free Outlook email and calendar, and Web and mobile versions of Word, Excel, and PowerPoint.</descrip></descripGrp><ntig><termGrp><term id="3083695">Microsoft 365 Basic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3085141">Microsoft 365 Básico</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54073_3083696_3085169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft cloud-based security service commercial offer, which provides configuration, protection, and detection capabilities.</descrip></descripGrp><ntig><termGrp><term id="3083696">Microsoft Defender for Office 365 Plan 1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3085169">Microsoft Defender para Office 365, plan 1</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54073_3190849_3085169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft cloud-based security service commercial offer, which provides configuration, protection, and detection capabilities.</descrip></descripGrp><ntig><termGrp><term id="3190849">Microsoft Defender for Office 365 (Plan 1)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3085169">Microsoft Defender para Office 365, plan 1</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54074_3083702_3085118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of insights within Microsoft Viva Insights that helps users prioritize wellbeing with actionable recommendations, such as reserving time for focused work, taking regular breaks, and practicing mindfulness.</descrip></descripGrp><ntig><termGrp><term id="3083702">personal insights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3085118">información persoal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54075_3083703_3085117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of insights within Microsoft Viva Insights that gives managers visibility into their team’s collaboration patterns, which are leading indicators that ladder up to overall wellbeing.</descrip></descripGrp><ntig><termGrp><term id="3083703">manager insights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3085117">información para os administradores</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54076_3083704_3085115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of insights within Microsoft Viva Insights that provides business leaders with a snapshot into how their organization is performing, including company-wide outcomes and leading indicators for each outcome.</descrip></descripGrp><ntig><termGrp><term id="3083704">leader insights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3085115">información para os líderes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54077_3083705_3085105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Viva feature that functions as a hub for employees to ask questions, find solutions, discover knowledge, and help coworkers.</descrip></descripGrp><ntig><termGrp><term id="3083705">Answers</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3085105">Respostas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54078_3083710_3085199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies the value that is redeemed per $100 face value.</descrip></descripGrp><ntig><termGrp><term id="3083710">redemption</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3085199">amortización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54079_3083711_3085109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in Excel DOLLARDE function that specifies a number expressed as an integer part and a fraction part, separated by a decimal symbol.</descrip></descripGrp><ntig><termGrp><term id="3083711">fractional_dollar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3085109">dólar_fraccional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54080_3083712_3085108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies a decimal number.</descrip></descripGrp><ntig><termGrp><term id="3083712">decimal_dollar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3085108">dólar_decimal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54081_3083713_3085175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies the nominal interest rate.</descrip></descripGrp><ntig><termGrp><term id="3083713">nominal_rate</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3085175">taxa_nominal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54083_3083987_3084018"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The next-generation Surface laptop.</descrip></descripGrp><ntig><termGrp><term id="3083987">Microsoft Surface Laptop 5</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3084018">Microsoft Surface Laptop 5</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54084_3083988_3084102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The next-generation Surface Pro.</descrip></descripGrp><ntig><termGrp><term id="3083988">Microsoft Surface Pro 9</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3084102">Microsoft Surface Pro 9</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54085_3083989_3084186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The next-generation Surface Pro with Arm processor.</descrip></descripGrp><ntig><termGrp><term id="3083989">Microsoft Surface Pro 9 with 5G</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3084186">Microsoft Surface Pro 9 with 5G</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54086_3083990_3084270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Surface Studio computer with 11th generation Intel processor.</descrip></descripGrp><ntig><termGrp><term id="3083990">Microsoft Surface Studio 2+</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3084270">Microsoft Surface Studio 2+</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5409_527644_2175843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object whose surface contains faces, each of which is described by a simple polygon.</descrip></descripGrp><ntig><termGrp><term id="527644">mesh</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2175843">malla</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54097_3090777_3090828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data model that empowers organizations to unify, store and prepare water measurement data from their facilities into a single data model to help meet water sustainability goals.</descrip></descripGrp><ntig><termGrp><term id="3090777">water data model</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3090828">modelo de datos de auga</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54102_3090778_3090789"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Emission of gases, mainly carbon dioxide from the combustion of fossil fuels: coal, oil and natural gas, that contribute to the greenhouse effect and, consequently, to the climate change of our planet.</descrip></descripGrp><ntig><termGrp><term id="3090778">GHG emission</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3090789">emisión de GEI</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54104_3085781_3086251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales feature powered by an AI model that scans your emails and meetings in Outlook and finds items that might be related to your work in Dynamics 365. Activity suggestions can be synced and connected to contacts, accounts, leads, or opportunities.</descrip></descripGrp><ntig><termGrp><term id="3085781">activity suggestion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3086251">suxestión de actividade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54105_3085782_3086252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-generated summary of a customer conversation.</descrip></descripGrp><ntig><termGrp><term id="3085782">AI summary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3086252">resumo de IA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54106_3085783_3086253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule created and activated for leads and opportunities by defining conditions to automatically assign records to sellers when the defined conditions are met in Dynamics 365 Sales.</descrip></descripGrp><ntig><termGrp><term id="3085783">assignment rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3086253">regra de atribución</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54107_3085784_3086254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Conversation Intelligence insight that shows the keywords that the top sellers use more frequently in conversations with customers. By analyzing this insight, you can understand what words the top sellers use that help them to close deals and generate revenue.</descrip></descripGrp><ntig><termGrp><term id="3085784">Best practice keywords</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3086254">Palabras clave de procedementos recomendados</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54108_3085785_3086255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales page that provides a high-level view of how the conversation with a customer went, and includes action items and relevant keywords, a timeline, a transcript of the call, and more.</descrip></descripGrp><ntig><termGrp><term id="3085785">call summary</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3086255">resumo da chamada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54109_3085786_3086256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales capability that enables the suggested contacts to be displayed in Teams when a seller starts a new connected chat. It helps the sellers to quickly find the right coworkers to collaborate with.</descrip></descripGrp><ntig><termGrp><term id="3085786">contact suggestion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3086256">suxestión de contactos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54110_3085787_3086257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of Sales Accelerator that uses the AI-based model that flags duplicate leads based on standard rules. Sellers can choose to merge duplicate leads to the primary record or delete the duplicate leads ensuring the sellers always have the right leads with the right information.</descrip></descripGrp><ntig><termGrp><term id="3085787">Data Hygiene</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3086257">Hixiene de datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54111_3085788_3086258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dedicated workspace in Dynamics 365 Sales for sellers to efficiently manage their sales pipeline. As a seller, you can personalize the workspace for your needs.</descrip></descripGrp><ntig><termGrp><term id="3085788">deal manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3086258">xestor de ofertas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54112_3085789_3086259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A ratio of the number of emails sent and received in a given opportunity, to the average sent and received ratio in all similar won deals.</descrip></descripGrp><ntig><termGrp><term id="3085789">email send/receive ratio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3086259">proporción de correos electrónicos enviados e recibidos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54113_3085790_3086260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A model that analyzes patterns in historical data that users provide and learns to associate those patterns with outcomes. Then, it uses the power of AI to detect learned patterns in new data, and use them to predict future outcomes.</descrip></descripGrp><ntig><termGrp><term id="3085790">prediction model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3086260">modelo de predición</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54114_3085791_3086261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows sellers to record calls by using the Teams dialer and get the most out of every call with advanced conversation intelligence capabilities such as AI-powered insights, rich call summaries, and more.</descrip></descripGrp><ntig><termGrp><term id="3085791">real-time transcription and insights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3086261">información e transcrición en tempo real</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54115_3085792_3086262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data point that is associated with a lower than average probability of converting the lead into an opportunity.</descrip></descripGrp><ntig><termGrp><term id="3085792">score harmer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3086262">factor que empeora a puntuación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54116_3085793_3086263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data point that is associated with a higher than average probability of converting the lead into an opportunity.</descrip></descripGrp><ntig><termGrp><term id="3085793">score improver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Sing