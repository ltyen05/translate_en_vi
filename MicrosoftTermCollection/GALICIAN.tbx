rp><ntig><termGrp><term id="2501470">detail form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2516639">formulario de detalles</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44430_2501474_2517073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of input fields that users can add all at once, as a single “block,” to a marketing page in order to create an input form on the page. Each block is preconfigured with the required collection of fields, and is ready for use. When creating a page, designers will typically choose from a limited selection of existing blocks, while managers or administrators will typically create new blocks only occasionally.</descrip></descripGrp><ntig><termGrp><term id="2501474">field block</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2517073">bloque de campos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44431_2550466_2551925"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that enables the users to view, organize, edit and share all of their photos and videos from multiple sources, and tell stories with them by making them into new videos. It replaces the default Photos app in Windows 10.</descrip></descripGrp><ntig><termGrp><term id="2550466">Photos &amp; Videos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2551925">Fotos e vídeos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44449_2502392_2805904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-release version of a service or a feature that are made available to customers for evaluation purposes and at reduced or different service terms.</descrip></descripGrp><ntig><termGrp><term id="2502392">preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2805904">previsualización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44449_2502392_2912757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-release version of a service or a feature that are made available to customers for evaluation purposes and at reduced or different service terms.</descrip></descripGrp><ntig><termGrp><term id="2502392">preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2912757">versión preliminar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44459_2502425_2516640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shortcut to a website, document, photo, or other file that can be included in a map.</descrip></descripGrp><ntig><termGrp><term id="2502425">geo pin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2516640">marcador xeográfico</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44460_2502426_2516641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web page that operates on a Dynamics 365 server and is created by a Dynamics 365 customer to support their marketing initiatives.</descrip></descripGrp><ntig><termGrp><term id="2502426">marketing page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2516641">páxina de márketing</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44461_2502427_2516642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team that owns records and has security roles assigned to the team. The team’s privileges are defined by these security roles. In addition to privileges provided by the team’s security roles, users have the privileges defined by their individual security roles and by the roles from other teams in which they are members. A team has full access rights on the records that the team owns.</descrip></descripGrp><ntig><termGrp><term id="2502427">owning team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2516642">equipo propietario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44462_2502428_2516635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team that doesn’t own records and doesn’t have security roles assigned to it. The users have privileges defined by their individual security roles and by the roles from other teams in which they are members. The records are shared with an access team and the team members are granted access rights on the records, such as Read, Write, or Append.</descrip></descripGrp><ntig><termGrp><term id="2502428">access team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2516635">equipo con acceso</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44463_2502429_2516643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transient message that provides quick access to a company privacy policy or to its privacy statement.</descrip></descripGrp><ntig><termGrp><term id="2502429">privacy banner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2516643">faixa de privacidade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44464_2502430_2516644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A competency grouping method for conference breakouts.</descrip></descripGrp><ntig><termGrp><term id="2502430">session track</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2516644">rastrexo de sesións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44465_2502431_2516645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database record that matches a (human) speaker to a specific session from a specific event where they will be speaking. It assigns a speaker to a session.</descrip></descripGrp><ntig><termGrp><term id="2502431">speaker engagement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2516645">asignación de relatores</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44466_2502432_2516647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A prospect that is contacted by phone. Tele prospecting is the practice of generating interest for a product or service over the phone. The purpose of tele prospecting is to further qualify the lead to determine if a hand off to sales is necessary.</descrip></descripGrp><ntig><termGrp><term id="2502432">tele prospect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2516647">posible interesado contactado por teléfono</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44467_2502433_2516648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication feature that automatically creates a webinar on the Lync or Skype for Business server and generates a hypertext link that you can send to contacts to enable them to join online.</descrip></descripGrp><ntig><termGrp><term id="2502433">webinar provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2516648">fornecedor de seminarios web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44469_2502845_2516646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customer journey component tile that enables a marketer to separate out a percentage or number of contacts into different branches of the journey.</descrip></descripGrp><ntig><termGrp><term id="2502845">splitter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2516646">divisor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44477_2502881_2504464"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card that displays information about a group, such as email address, group description and other shared information.</descrip></descripGrp><ntig><termGrp><term id="2502881">group card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2504464">cartón do grupo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44478_2502884_2504468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of data, such as contact details, and information that describes a person and what he/she is working on.</descrip></descripGrp><ntig><termGrp><term id="2502884">profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2504468">perfil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44479_2502886_2504469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A broad group of users through which updates to the OneDrive sync client are released.</descrip></descripGrp><ntig><termGrp><term id="2502886">update ring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2504469">círculo de actualizacións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44485_2502932_2503536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The package of computer fonts that supports both Arabic script and the Latin alphabet.</descrip></descripGrp><ntig><termGrp><term id="2502932">Dubai Font</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2503536">Dubai Font</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44486_2502933_2503539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft framework that allows application developers to supply assistive technology tools with semantic metadata for text and UI element properties, and whose metadata can be used by text-to-speech (TTS) engines.</descrip></descripGrp><ntig><termGrp><term id="2502933">SayAs</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2503539">SayAs</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44487_2502935_2504470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Advanced Threat Protection feature that uses Safe links to disable malicious links in user emails and Safe attachment to disable malicious attached files in user emails.</descrip></descripGrp><ntig><termGrp><term id="2502935">URL detonation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2504470">Desactivación de URL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44488_2503299_2504460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of actions that users take to disconnect their Office 365 and LinkedIn accounts​.</descrip></descripGrp><ntig><termGrp><term id="2503299">disconnect accounts</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2504460">desconexión de contas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44489_2503302_2504461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of actions that users take to connect their Office 365 and LinkedIn accounts​.</descrip></descripGrp><ntig><termGrp><term id="2503302">connect accounts</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><