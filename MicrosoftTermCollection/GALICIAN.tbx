gSet xml:lang="gl"><ntig><termGrp><term id="1334903">mapa do sitio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11785_182825_1335660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The description of the status of a record or activity. The options available are based on what record type is open and in which module.</descrip></descripGrp><ntig><termGrp><term id="182825">status reason</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1335660">motivo para o estado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11795_147980_498219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to keyboard settings, document views, user interface objects, languages, etc. for which text is displayed in a right-to-left direction.</descrip></descripGrp><ntig><termGrp><term id="147980">right-to-left</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498219">da dereita á esquerda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11795_661874_498219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to keyboard settings, document views, user interface objects, languages, etc. for which text is displayed in a right-to-left direction.</descrip></descripGrp><ntig><termGrp><term id="661874">RTL</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498219">da dereita á esquerda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11796_331741_1479436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft set of business productivity services that provides a secure online workspace for organizing and managing information and a complete set of tools that integrate with existing Microsoft Office programs.</descrip></descripGrp><ntig><termGrp><term id="331741">Microsoft Office Live</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1479436">Microsoft Office Live</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11797_149448_1178787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that includes the name of the person who originally sent a task request plus the names of everyone who received the task request, reassigned the task to someone else, or chose to keep an updated copy of the task in their task list.</descrip></descripGrp><ntig><termGrp><term id="149448">update list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178787">lista de actualización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11798_106558_2105925"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line printed above, below, or to the side of some element, either to set that item off from the remainder of the page or to improve the look of the page. Footnotes, for example, often appear below a short rule that sets them off from the main text on the page. The thickness of a rule is typically measured in points. (A point is approximately 1/72 inch.)</descrip></descripGrp><ntig><termGrp><term id="106558">rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2105925">liña de regra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11798_2085540_2105925"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line printed above, below, or to the side of some element, either to set that item off from the remainder of the page or to improve the look of the page. Footnotes, for example, often appear below a short rule that sets them off from the main text on the page. The thickness of a rule is typically measured in points. (A point is approximately 1/72 inch.)</descrip></descripGrp><ntig><termGrp><term id="2085540">rule line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2105925">liña de regra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11799_234773_498506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows deletion of the files created during hibernation.</descrip></descripGrp><ntig><termGrp><term id="234773">Hibernation File Cleaner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498506">Limpeza dos ficheiros de hibernación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1180_89323_1178670"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To extend over and cover a part of something.</descrip></descripGrp><ntig><termGrp><term id="89323">overlap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178670">sobrepor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11800_118815_1606628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information about a computer that's derived from the System Information program.</descrip></descripGrp><ntig><termGrp><term id="118815">system info</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1606628">información do sistema</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11803_89506_2300206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A role that controls how permissions are set and can grant permissions to others.</descrip></descripGrp><ntig><termGrp><term id="89506">owner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2300206">propietario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11804_118547_498007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of entities working together to accomplish a task.</descrip></descripGrp><ntig><termGrp><term id="118547">system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498007">sistema</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11810_210490_498380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A networking standard that uses cables to provide network access. Ethernet is the most widely installed technology for connecting computers.</descrip></descripGrp><ntig><termGrp><term id="210490">Ethernet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498380">Ethernet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11816_234850_2369173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statement of the financial position of an organization that reports the state of assets, liabilities, and equity on a specified date.</descrip></descripGrp><ntig><termGrp><term id="234850">balance sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2369173">balance xeral</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11820_125350_498045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character-encoding standard developed by the Unicode Consortium that represents almost all of the written languages of the world. The Unicode character repertoire has multiple representation forms, including UTF-8, UTF-16, and UTF-32. Most Windows interfaces use the UTF-16 form.</descrip></descripGrp><ntig><termGrp><term id="125350">Unicode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498045">Unicode</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11821_77656_497781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of display that uses a liquid compound having a polar molecular structure, sandwiched between two transparent electrodes. When an electric field is applied, the molecules align with the field, forming a crystalline arrangement that polarizes the light passing through it. A polarized filter laminated over the electrodes blocks polarized light. In this way, a grid of electrodes can selectively "turn on" a cell, or a pixel, containing the liquid crystal material, turning it dark.</descrip></descripGrp><ntig><termGrp><term id="77656">LCD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497781">LCD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11821_77656_497782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of display that uses a liquid compound having a polar molecular structure, sandwiched between two transparent electrodes. When an electric field is applied, the molecules align with the field, forming a crystalline arrangement that polarizes the light passing through it. A polarized filter laminated over the electrodes blocks polarized light. In this way, a grid of electrodes can selectively "turn on" a cell, or a pixel, containing the liquid crystal material, turning it dark.</descrip></descripGrp><ntig><termGrp><term id="77656">LCD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497782">pantalla de cristal líquido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11821_77658_497781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of display that uses a liquid compound having a polar molecular structure, sandwiched between two transparent electrodes. When an electric field is applied, the molecules align with the field, forming a crystalline arrangement that polarizes the light passing through it. A polarized filter laminated over the electrodes blocks polarized light. In this way, a grid of electrodes can selectively "turn on" a cell, or a pixel, containing the liquid crystal material, turning it dark.</descrip></descripGrp><ntig><termGrp><term id="77658">liquid crystal display</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497781">LCD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11821_77658_497782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of display that uses a liquid compound having a polar molecular structure, sandwiched between two transparent electrodes. When an electric field is applied, the molecules align with the field, forming a crystalline arrangement that polarizes the light passing through it. A polarized filter laminated over the electrodes blocks polarized light. In this way, a grid of electrodes can selectively "turn on" a cell, or a pixel, containing the liquid crystal material, turning it dark.</descrip></descripGrp><ntig><termGrp><term id="77658">liquid crystal display</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497782">pantalla de cristal líquido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11827_184720_1688931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a contact who is external to the user's organization or enterprise but with whom the user's organization or enterprise is linked.</descrip></descripGrp><ntig><termGrp><term id="184720">federated</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1688931">asociado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1183_346957_499103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that cannot be found or recovered.</descrip></descripGrp><ntig><termGrp><term id="346957">lost data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="499103">datos perdidos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Mascu