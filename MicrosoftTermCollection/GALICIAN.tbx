_2837913_2838508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 mobile app optimized for a larger tablet screen.</descrip></descripGrp><ntig><termGrp><term id="2837913">Dynamics 365 for tablets</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2838508">Microsoft Dynamics 365 para tabletas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50178_2837903_2838509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud-based service that extends the power of Dynamics 365 for Customer Service to enable customers to instantly connect and engage with their customers via newly introduced channels: live chat and SMS.</descrip></descripGrp><ntig><termGrp><term id="2837903">Omnichannel Engagement Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2838509">Plataforma común de compromiso multicanle</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50179_2837904_2838510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The add-in to Dynamics 365 Customer Service apps that extends the power of Dynamics 365 Customer Service to enable organizations to instantly connect and engage with their customers via channels like live chat and texting.</descrip></descripGrp><ntig><termGrp><term id="2837904">Omnichannel for Customer Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2838510">Multicanle para Customer Service</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50180_2837905_2838512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool that helps new customers get started with setting up Dynamics 365 Business Central. It creates and helps apply configuration packages using a toolset designed to speed up deployment times, improve quality of implementation, introduce a repeatable approach to implementations, and enable productivity by automating and simplifying recurring tasks.</descrip></descripGrp><ntig><termGrp><term id="2837905">RapidStart Services Implementer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2838512">Implementador de RapidStart Services</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50181_2837906_2838513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The add-on capability for the Dynamics 365 Field Service application that enables users to automatically schedule work orders for the most appropriate resources, by optimizing bookings for the shortest travel time, available work hours, and many other constraints.</descrip></descripGrp><ntig><termGrp><term id="2837906">Resource Scheduling Optimization</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2838513">Resource Scheduling Optimization</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50182_2837907_2838514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that enable in-store activities by field sales personnel including: site visit planning, activity lists, checklists and surveys.</descrip></descripGrp><ntig><termGrp><term id="2837907">Retail Sales Execution</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2838514">Execución de vendas ao detalle</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50183_2837908_2838515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Dynamics 365 AI for Market Insights app that provides audience insights from interactions on Bing search.</descrip></descripGrp><ntig><termGrp><term id="2837908">Search Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2838515">Información de busca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</t