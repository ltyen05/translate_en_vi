Note type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2617561">Servizo de atestación de estado de Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46481_2615123_2617554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Windows Defender Security Center that helps customers keep their devices refreshed and up to date with the latest version of Windows 10. Device health advisor monitors the device and provides information and recommendations in a Health report to address common issues with storage capacity, device drivers, battery life, or Windows Update.</descrip></descripGrp><ntig><termGrp><term id="2615123">Device performance &amp; health</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2617554">Desempeño e estado de funcionamento do dispositivo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46505_2618212_2619388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tenant that consists of a central location and one or more satellite geo locations.</descrip></descripGrp><ntig><termGrp><term id="2618212">Multi-Geo tenant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2619388">arrendatario multi