rogram</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2875592">Xbox Insider Program</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46062_2595010_2885349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that allows passionate Xbox fans the opportunity to give Microsoft feedback on the latest Xbox One System updates, as well as features and games still in development on both the Xbox One console and Windows 10 PCs.</descrip></descripGrp><ntig><termGrp><term id="2595010">Xbox Insider Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2885349">Insider Program</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46062_2884922_2875592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that allows passionate Xbox fans the opportunity to give Microsoft feedback on the latest Xbox One System updates, as well as features and games still in development on both the Xbox One console and Windows 10 PCs.</descrip></descripGrp><ntig><termGrp><term id="2884922">Insider Program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2875592">Xbox Insider Program</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46062_2884922_2885349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that allows passionate Xbox fans the opportunity to give Microsoft feedback on the latest Xbox One System updates, as well as features and games still in development on both the Xbox One console and Windows 10 PCs.</descrip></descripGrp><ntig><termGrp><term id="2884922">Insider Program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2885349">Insider Program</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46063_2595012_2875612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows Xbox Insiders to get early previews of the latest features and content on Xbox. Users can earn XP by completing surveys, polls, and quests, and also by providing developers and engineers with feedback to make improvements before releasing new features and products.</descrip></descripGrp><ntig><termGrp><term id="2595012">Xbox Insider Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2875612">Xbox Insider Hub</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46064_2595111_2597282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The preview version of Office 365 Adoption.</descrip></descripGrp><ntig><termGrp><term id="2595111">Office 365 Adoption Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2597282">Adopción de Office 365 Preview</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46066_2595121_2609781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The extension used for cloud debugging that allows you to automatically collect a debug snapshot from your live web application when an exception occurs.</descrip></descripGrp><ntig><termGrp><term id="2595121">Visual Studio Snapshot Debugger</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2609781">Snapshot Debugger</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46066_2595122_2609781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The extension used for cloud debugging that allows you to automatically collect a debug snapshot from your live web application when an exception occurs.</descrip></descripGrp><ntig><termGrp><term id="2595122">Snapshot Debugger</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><la