h">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6031_475227_1305891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A privilege level that specifies the user has access to objects anywhere within the organization. The application refers to this level as Organization.</descrip></descripGrp><ntig><termGrp><term id="475227">Global</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1305891">Global</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6032_178599_1302843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that sells similar products or services and competes for the same customer segment.</descrip></descripGrp><ntig><termGrp><term id="178599">competitor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1302843">competidor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6033_319444_498989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area within the Control Panel that provides accessibility options and settings to help users interact more easily with the computer.</descrip></descripGrp><ntig><termGrp><term id="319444">Ease of Access Center</term><termNote type="partOfSpeech">Prop