>Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1759709">acción personalizada mediante aplicación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33033_1740566_1759763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An installation component of Lync Server used to display, adjust, and validate a planned topology.</descrip></descripGrp><ntig><termGrp><term id="1740566">Topology Builder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1759763">Xerador de topoloxías</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33036_1740614_1759725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Part of the existing Lync Web App IIS web component. Lets users optionally join meetings by using a mobile device.</descrip></descripGrp><ntig><termGrp><term id="1740614">Join Launcher</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1759725">Iniciador de asistencia a reunións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33048_1743026_1759747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule that converts phone numbers to the local dialing format for interaction with private branch exchange (PBX) systems.</descrip></descripGrp><ntig><termGrp><term id="1743026">outbound translation rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1759747">regra de transformación de saída</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33049_1743075_1759737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft Lync 2010 Attendee is a conferencing client that lets people who don't have Lync 2010 installed, participate in online meetings.</descrip></descripGrp><ntig><termGrp><term id="1743075">Microsoft Lync 2010 Attendee</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1759737">Microsoft Lync 2010 Attendee</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3305_203181_2180479"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The video format with the same resolution as traditional television.</descrip></descripGrp><ntig><termGrp><term id="203181">standard definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2180479">SD</term><termNote type="geographicalUsage">ESP</termNote><termNote type