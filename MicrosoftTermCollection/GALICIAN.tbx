Number">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7864_342527_499077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical connection created between two hosts to exchange data.</descrip></descripGrp><ntig><termGrp><term id="342527">session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="499077">sesión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7869_78635_1178216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The key used by the client and server for all session key generation. The master key is used to generate the client-read key, the client-write key, the server-read key, and the server-write key. Master keys can be exported as simple key BLOBs.</descrip></descripGrp><ntig><termGrp><term id="78635">master key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178216">clave mestra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7874_7041_497263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string of characters entered by a user to verify his or her identity to a network or to a local computer, device, or client, or to sign in to an account, app, and so on.</descrip></descripGrp><ntig><termGrp><term id="7041">access code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497263">código de acceso</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7874_7041_497264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string of characters entered by a user to verify his or her identity to a network or to a local computer, device, or client, or to sign in to an account, app, and so on.</descrip></descripGrp><ntig><termGrp><term id="7041">access code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497264">contrasinal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7874_7042_497263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string of characters entered by a user to verify his or her identity to a network or to a local computer, device, or client, or to sign in to an account, app, and so on.</descrip></descripGrp><ntig><termGrp><term id="7042">password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497263">código de acceso</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7874_7042_497264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string of characters entered by a user to verify his or her identity to a network or to a local computer, device, or client, or to sign in to an account, app, and so on.</descrip></descripGrp><ntig><termGrp><term id="7042">password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497264">contrasinal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7875_307417_412211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows Outlook and mobile devices to automatically discover and connect to the correct Exchange server without requiring the user to know the Exchange server name or other details, even if the mailbox has been moved or a server has failed.</descrip></descripGrp><ntig><termGrp><term id="307417">AutoConnect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412211">Conexión automática</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7878_236973_498545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Parental Controls that allows users to block Web sites that they don't want to view.</descrip></descripGrp><ntig><termGrp><term id="236973">Web restrictions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498545">restricións de páxinas web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="788_397211_412190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An international messaging standard that can be used by a variety of messaging systems. X.400 uses a strict addressing method that reflects a hierarchical environment. The use of X.400 has been largely supplanted by the combination of SMTP and MIME.</descrip></descripGrp><ntig><termGrp><term id="397211">X.400</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412190">X.400</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7885_48295_497583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move an item on the screen (1) by touching the item on a screen and then sliding the finger across the screen or (2) by pressing and holding down the left mouse button while moving the mouse.</descrip></descripGrp><ntig><termGrp><term id="48295">drag</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497583">arrastrar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7890_1177068_3127116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of times an ad was clicked, divided by the number of times the ad was shown (impressions).</descrip></descripGrp><ntig><termGrp><term id="1177068">clickthrough rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3127116">taxa de clics</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7890_1177069_3127116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of times an ad was clicked, divided by the number of times the ad was shown (impressions).</descrip></descripGrp><ntig><termGrp><term id="1177069">click rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3127116">taxa de clics</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7890_1274148_3127116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of times an ad was clicked, divided by the number of times the ad was shown (impressions).</descrip></descripGrp><ntig><termGrp><term id="1274148">click-through rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3127116">taxa de clics</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7890_1274316_3127116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of times an ad was clicked, divided by the number of times the ad was shown (impressions).</descrip></descripGrp><ntig><termGrp><term id="1274316">CTR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3127116">taxa de clics</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7890_183122_3127116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of times an ad was clicked, divided by the number of times the ad was shown (impressions).</descrip></descripGrp><ntig><termGrp><term id="183122">ad click rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3127116">taxa de clics</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7899_185897_1688927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button in a video conversation window that temporarily stops the video feed in the current video conversation. The infotip for this button toggles between Pause and Restart this video feed.</descrip></descripGrp><ntig><termGrp><term id="185897">Pause</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1688927">Pausa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7904_234775_1178217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Visual impairment that results in great reduction in vision capabilities and that cannot be aided by glasses or contact lenses. It could, however, be aided by special devices.</descrip></descripGrp><ntig><termGrp><term id="234775">low vision</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178217">deficiencias visuais</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7906_159800_2768578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A license that specifies the number of computers that can connect to and use software located on a server.</descrip></descripGrp><ntig><termGrp><term id="159800">CAL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2768578">CAL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7906_159800_2768582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A license that specifies the number of computers that can connect to and use software located on a server.</descrip></descripGrp><ntig><termGrp><term id="159800">CAL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2768582">licenza de acceso de cliente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7906_159801_2768578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A license that specifies the number of computers that can connect to and use software located on a server.</descrip></descripGrp><ntig><termGrp><term id="159801">client access license</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2768578">CAL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7906_159801_2768582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A license that specifies the number of computers that can connect to and use software located on a server.</descrip></descripGrp><ntig><termGrp><term id="159801">client access license</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2768582">licenza de acceso de cliente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7928_237030_498551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data repository, in which items such as text, text boxes, pictures, tables, shapes, etc. can be stored and re-used within the same document and across multiple documents.</descrip></descripGrp><ntig><termGrp><term id="237030">content library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498551">biblioteca de contidos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7931_106258_1178218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that sends, or routes, information between two networks (for example, between a home network and the Internet).</descrip></descripGrp><ntig><termGrp><term id="106258">router</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178218">router</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7933_265341_498674"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Characterized by row or column-specific formatting. Often describes rows or columns of data that use alternating colors or shading to enhance readability.</descrip></descripGrp><ntig><termGrp><term id="265341">banded</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498674">con faixas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7942_76244_497765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of rules and data specific to a language and a geographic area. Locales include information on sorting rules, date and time formatting, numeric and monetary conventions, and character classification.</descrip></descripGrp><ntig><termGrp><term id="76244">locale</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497765">configuración rexional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7948_52504_497612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To output data and database objects to another database, spreadsheet, or file format so another database, application, or program can use the data or database objects.</descrip></descripGrp><ntig><termGrp><term id="52504">export</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497612">exportar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7949_1509579_1606641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portable computer that allows you to write on or interact with the screen.</descrip></descripGrp><ntig><termGrp><term id="1509579">tablet PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1606641">tableta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7949_1509579_498416"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portable computer that allows you to write on or interact with the screen.</descrip></descripGrp><ntig><termGrp><term id="1509579">tablet PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498416">Tablet PC</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7949_1671013_1606641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portable computer that allows you to write on or interact with the screen.</descrip></descripGrp><ntig><termGrp><term id="1671013">tablet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1606641">tableta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammat