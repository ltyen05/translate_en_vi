in the room with an enhanced meeting layout by bringing meeting information gathered from fluid components to the forefront of the screen and bringing the gallery to the bottom so people can meet face to face.</descrip></descripGrp><ntig><termGrp><term id="3001103">Front row</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3001624">Primeira fila</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52813_3001104_3001628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Teams channel to which team owners can add users (people) who aren't members of the team.</descrip></descripGrp><ntig><termGrp><term id="3001104">shared channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3001628">canle compartida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52814_3001105_3001629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The last portion of the URL for a SharePoint site.</descrip></descripGrp><ntig><termGrp><term id="3001105">site address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3001629">enderezo compartido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52815_3001106_3001627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Teams channel that's created for a subset of people in the team.</descrip></descripGrp><ntig><termGrp><term id="3001106">private channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3001627">canle privada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52816_3001107_3001630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Teams channel that has the same membership list as the team itself (not a private or shared channel).</descrip></descripGrp><ntig><termGrp><term id="3001107">standard channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3001630">canle estándar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52817_3001108_3001622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint site that's created for a private channel or shared channel.</descrip></descripGrp><ntig><termGrp><term id="3001108">channel site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3001622">sitio da canle</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52818_3001109_3001625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device, such as a proxy server or firewall, that network traffic passes through after leaving a user's device and before reaching the destination web page or service.</descrip></descripGrp><ntig><termGrp><term id="3001109">intermediary network device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3001625">dispositivo de rede intermediario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52823_3001641_3002222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The evaluation edition of Windows 11 Enterprise.</descrip></descripGrp><ntig><termGrp><term id="3001641">Windows 11 Enterprise Evaluation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3002222">Windows 11 Enterprise Evaluation</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52824_3001642_3002223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows 11 Enterprise version that utilizes the LTSC servicing model.</descrip></descr