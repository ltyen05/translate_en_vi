a macro is running.</descrip></descripGrp><ntig><termGrp><term id="650237">echo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094454">eco</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1789_114199_2016225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To delay an item, such as a reminder, an alarm, or a recommendation, by a specified time.</descrip></descripGrp><ntig><termGrp><term id="114199">snooze</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2016225">pospoñer</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1801_111907_497962"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make resources, such as folders, printers, files, photos, available to others.</descrip></descripGrp><ntig><termGrp><term id="111907">share</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497962">compartir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1802_293191_498723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that reacts or responds to requests or events.</descrip></descripGrp><ntig><termGrp><term id="293191">responder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498723">dispositivo de resposta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1809_149352_498233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control you place on a form or report to contain an unbound object.</descrip></descripGrp><ntig><termGrp><term id="149352">unbound object frame</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498233">marco de obxecto desvinculado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1819_143381_2734786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A path containing a document with hyperlinks that is used as the root of the hyperlinks in the document.</descrip></descripGrp><ntig><termGrp><term id="143381">hyperlink base</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2734786">base de hiperligazón</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singu