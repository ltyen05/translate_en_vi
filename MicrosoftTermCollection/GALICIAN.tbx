erience allowing for comparison of different user location network connections.</descrip></descripGrp><ntig><termGrp><term id="2816685">network performance score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2819466">puntuación de rede</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49812_2816686_2819465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Microsoft 365 Admin Center, a score that shows how network connectivity impacts user experience allowing for comparison of different user location network connections.</descrip></descripGrp><ntig><termGrp><term id="2816686">network score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2819465">puntuación de desempeño de rede</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49812_2816686_2819466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Microsoft 365 Admin Center, a score that shows how network connectivity impacts user experience allowing for comparison of different user location network connections.</descrip></descripGrp><ntig><termGrp><term id="2816686">network score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2819466">puntuación de rede</term><term