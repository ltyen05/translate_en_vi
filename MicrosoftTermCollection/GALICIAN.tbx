/ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1520395">filtraxe web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22482_1045718_1950177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person authorized to manage and make certain changes to a group, such as to approve a membership request.</descrip></descripGrp><ntig><termGrp><term id="1045718">group owner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950177">propietario do grupo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22490_1045759_1178988"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio or video file that you rent from an online store, typically for a monthly fee.</descrip></descripGrp><ntig><termGrp><term id="1045759">subscription file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178988">ficheiro de subscrición</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22492_1045783_1178989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A troubleshooter that performs common maintenance tasks in Windows, such as cleaning up unused files and shortcuts.</descrip></descripGrp><ntig><termGrp><term id="1045783">Maintenance troubleshooter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178989">solucionador de problemas de mantemento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22493_1045790_1178990"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A troubleshooter that helps find and fix problems about hardware and devices.</descrip></descripGrp><ntig><termGrp><term id="1045790">Hardware and Devices troubleshooter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178990">solucionador de problemas de hardware e dispositivos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2250_527637_1374621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a process, tool, etc. that is enabled by Windows Live.</descrip></descripGrp><ntig><termGrp><term id="527637">powered by Windows Live</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1374621">con tecnoloxía de Windows Live</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22509_1047681_1178991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search location exposed via .osdx templates and made possible via the OpenSearch technology. It connects the local search indexer to a remote index and provides the end user with the ability to search for files on a Web site or on an intranet site from within Windows.</descrip></descripGrp><ntig><termGrp><term id="1047681">search connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178991">conector de busca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22516_1047720_1694732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web site from Microsoft which provides solutions for the top issues about Windows Update or Microsoft Update, and enables you to contact a support professional.</descrip></descripGrp><ntig><termGrp><term id="1047720">Microsoft Update Solution Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1694732">Centro de soluciones de Microsoft Update</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2252_163636_498292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network-enabled host running Simple Network Mana