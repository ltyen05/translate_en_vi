 directions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2460980">indicacións de ruta en transporte público</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43367_2456824_2460982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The instructions for how to get from one location to another on foot.</descrip></descripGrp><ntig><termGrp><term id="2456824">walking directions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2460982">indicacións de ruta a pé</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43370_2457378_2461318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office feature that recognizes hand-drawn inked shapes and converts them into computer-generated looking shapes and that provides support for diagram making, shape manipulation and that provides shape information.</descrip></descripGrp><ntig><termGrp><term id="2457378">Ink to shape</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2461318">Entrada manuscrita en forma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNum