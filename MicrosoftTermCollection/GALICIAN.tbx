><langSet xml:lang="gl"><ntig><termGrp><term id="1744288">CVV</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17795_650155_2005001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The code that credit card companies use to authorize credit card charges. For example, American Express uses a four-digit number on the front of the credit card, and Visa, MasterCard, and Discover use a three-digit number on the back.</descrip></descripGrp><ntig><termGrp><term id="650155">card validation code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2005001">código de seguranza de MasterCard</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17796_650156_1178844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart axis that represents the category for each data point. It displays arbitrary text values like Qtr1, Qtr2, and Qtr3; it cannot display scaled numerical values.</descrip></descripGrp><ntig><termGrp><term id="650156">category axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178844">eixe de categorías</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17797_650157_2094411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that is displayed in the category area of PivotChart view. Items in a category field appear as labels on the category axis.</descrip></descripGrp><ntig><termGrp><term id="650157">category field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094411">campo de categoría</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17803_650163_2094413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A constraint that allows for business rules that span multiple tables. For example, the Order table could have a CHECK constraint that would prevent orders for a customer from exceeding a credit limit defined for the customer in the Customer table.</descrip></descripGrp><ntig><termGrp><term id="650163">CHECK constraint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094413">restrición CHECK</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17812_650172_1727372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of modeling elements that interact within a given context to perform an operation or a use case. The objects in a collaboration are roles describing types of objects rather than representations of the objects themselves.</descrip></descripGrp><ntig><termGrp><term id="650172">collaboration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1727372">colaboración</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17815_650175_2094418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of PivotTable view that contains column fields.</descrip></descripGrp><ntig><termGrp><term id="650175">column area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094418">área de columna</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17816_1507691_1178845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A supplemental program with the filename extension .dll or .exe that extends the capabilities of a program by adding custom commands and specialized features.</descrip></descripGrp><ntig><termGrp><term id="1507691">Component Object Model add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178845">suplemento COM</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17816