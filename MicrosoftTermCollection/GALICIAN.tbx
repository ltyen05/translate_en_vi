ic</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178303">medida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15484_132656_1689046"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that allows multiple users across a network to work together on a document that is simultaneously displayed on all the users' screens as though they are gathered around a physical whiteboard.</descrip></descripGrp><ntig><termGrp><term id="132656">whiteboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1689046">encerado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15484_132656_2885947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that allows multiple users across a network to work together on a document that is simultaneously displayed on all the users' screens as though they are gathered around a physical whiteboard.</descrip></descripGrp><ntig><termGrp><term id="132656">whiteboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2885947">encerado dixital</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote