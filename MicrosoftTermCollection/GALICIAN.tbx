ype="definition">A form that is displayed when another form option isn’t explicitly set. An example would be if an administrator fails to define a form for a particular security group that has access to the application.</descrip></descripGrp><ntig><termGrp><term id="1358990">fallback form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1374116">formulario de reserva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26903_1358991_1374124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI section that displays the fields available for customizing a form.</descrip></descripGrp><ntig><termGrp><term id="1358991">Field Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1374124">Explorador de campos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26904_1358992_1374180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI section in the Form Editor that shows existing relationships for a form and will allow you to add to or modify them.</descrip></descripGrp><ntig><termGrp><term id="1358992">Relationship Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1374180">Explorador de relacións</term><t