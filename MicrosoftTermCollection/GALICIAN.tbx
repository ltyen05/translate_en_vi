 type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2013936">consumo de recursos dinámico para Busca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34718_2002302_2013950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides the ability to keep SharePoint items on In-Place Hold for a specific time period.</descrip></descripGrp><ntig><termGrp><term id="2002302">Time-Based In-Place Hold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2013950">Retención local con duración definida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34719_2002360_2013938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The shared calendar that you can create in Office for a group of users to schedule events, track milestones, create meetings, and engage in conversations around events. Users can add events from a group calendar to their personal calendars.</descrip></descripGrp><ntig><termGrp><term id="2002360">Group Calendar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2013938">Calendario de grupo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote ty