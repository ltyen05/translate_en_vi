p></ntig></langSet></termEntry><termEntry id="55446_3143256_3144254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A percentage that represents the difference between the expected price of a cryptocurrency at the time of a transaction and the actual price when the transaction is executed.</descrip></descripGrp><ntig><termGrp><term id="3143256">slippage tolerance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3144254">tolerancia ao escorregamento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55447_3143312_3144257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the context of cryptocurrency, a digital unit of a digital currency that is used as a specific asset or a representation of a particular use on a blockchain.</descrip></descripGrp><ntig><termGrp><term id="3143312">token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3144257">token</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55448_3143315_3144261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of cryptocurrencies or tokens that a user is interested in tracking.</descrip></descripGrp><ntig><termGrp><term id="3143315">watchlist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></lang