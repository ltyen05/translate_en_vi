Note type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1686939">indicador HTTP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12520_1296_497195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the TCP/IP suite of protocols, used to copy files between two computers on the Internet. Both computers must support their respective FTP roles: one must be an FTP client and the other an FTP server.</descrip></descripGrp><ntig><termGrp><term id="1296">File Transfer Protocol</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497195">protocolo de transferencia de ficheiros</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12520_1296_497196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the TCP/IP suite of protocols, used to copy files between two computers on the Internet. Both computers must support their respective FTP roles: one must be an FTP client and the other an FTP server.</descrip></descripGrp><ntig><termGrp><term id="1296">File Transfer Protocol</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497196">FTP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12520_1297_497195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the TCP/IP suite of protocols, used to copy files between two computers on the Internet. Both computers must support their respective FTP roles: one must be an FTP client and the other an FTP server.</descrip></descripGrp><ntig><termGrp><term id="1297">FTP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497195">protocolo de transferencia de ficheiros</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12520_1297_497196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the TCP/IP suite of protocols, used to copy files between two computers on the Internet. Both computers must support their respective FTP roles: one must be an FTP client and the other an FTP server.</descrip></descripGrp><ntig><termGrp><term id="1297">FTP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497196">FTP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12522_1359809_1755983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that runs on a Lync Server or Office Communications Server front-end server to mix and manage inputs from multiple clients in a multiparty instant messaging (IM) session.</descrip></descripGrp><ntig><termGrp><term id="1359809">IM Conferencing service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1755983">Servidor de conferencias de mensaxería instantánea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12522_522086_1755983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that runs on a Lync Server or Office Communications Server front-end server to mix and manage inputs from multiple clients in a multiparty instant messaging (IM) session.</descrip></descripGrp><ntig><termGrp><term id="522086">IM Conferencing Server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1755983">Servidor de conferencias de mensaxería instantánea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12524_73352_497741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of binaries that can be installed on top of the core product and enables users to select a preferred language so that the user interface and Help files appear in that preferred language.</descrip></descripGrp><ntig><termGrp><term id="73352">language pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497741">paquete de idioma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12530_262704_498646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common programming interface to the lower-level system area network (SAN) implementations, developed by Microsoft. WSD sits underneath the standard WinSock application programming interface (API), but bypasses the kernel networking layers to talk directly to the SAN hardware. Because WSD sits underneath the existing WinSock API, IT departments can deploy applications in a SAN environment without modifying the applications.</descrip></descripGrp><ntig><termGrp><term id="262704">WinSock direct</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498646">Winsock Direct</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12530_262704_498647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common programming interface to the lower-level system area network (SAN) implementations, developed by Microsoft. WSD sits underneath the standard WinSock application programming interface (API), but bypasses the kernel networking layers to talk directly to the SAN hardware. Because WSD sits underneath the existing WinSock API, IT departments can deploy applications in a SAN environment without modifying the applications.</descrip></descripGrp><ntig><termGrp><term id="262704">WinSock direct</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498647">WSD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12530_262705_498646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common programming interface to the lower-level system area network (SAN) implementations, developed by Microsoft. WSD sits underneath the standard WinSock application programming interface (API), but bypasses the kernel networking layers to talk directly to the SAN hardware. Because WSD sits underneath the existing WinSock API, IT departments can deploy applications in a SAN environment without modifying the applications.</descrip></descripGrp><ntig><termGrp><term id="262705">WSD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498646">Winsock Direct</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12530_262705_498647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common programming interface to the lower-level system area network (SAN) implementations, developed by Microsoft. WSD sits underneath the standard WinSock application programming interface (API), but bypasses the kernel networking layers to talk directly to the SAN hardware. Because WSD sits underneath the existing WinSock API, IT departments can deploy applications in a SAN environment without modifying the applications.</descrip></descripGrp><ntig><termGrp><term id="262705">WSD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498647">WSD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12531_232862_1178793"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of files, managed by a manifest.xml file, that add functionality to a Microsoft Office Word or Microsoft Office Excel document by specifying custom display or actions.</descrip></descripGrp><ntig><termGrp><term id="232862">XML expansion pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178793">paquete de expansión XML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12537_95084_497910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of declarations and statements that are executed as a unit.</descrip></descripGrp><ntig><termGrp><term id="95084">procedure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497910">procedemento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12539_346969_499107"><langSet xm