-US"><descripGrp><descrip type="definition">The trial offer for Microsoft 365 Business Standard for Nonprofits.</descrip></descripGrp><ntig><termGrp><term id="2512681">Office 365 Business Premium for Nonprofits Trial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2515667">Proba de Office 365 Bussines Superior para organizacións sen ánimo de lucro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44639_2512914_2729582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack in which attackers attempt to increase existing privileges and use them multiple times in order to eventually gain full control over the victim’s environment.</descrip></descripGrp><ntig><termGrp><term id="2512914">privilege escalation attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2729582">ataque por escalación de privilexios</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44646_2897501_2898054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that helps protect your enterprise hybrid environments from multiple types of advanced targeted cyber attacks and insider threats.</descrip></descripGrp><ntig><termGrp><term id="2897501">Microsoft Defender for Identity</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2898054">Microsoft Defender for Identity</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44647_2513424_2519109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To take an existing story in the Photos app and generate a new version of that story with edits to content, style, music, and other options.​</descrip></descripGrp><ntig><termGrp><term id="2513424">remix</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2519109">remesturar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44648_2513444_2519110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Groove Music app, a graphical display that changes colors and shapes on the screen in response to the music that is playing. The user can choose from several different visualizers, which each look different.</descrip></descripGrp><ntig><termGrp><term id="2513444">visualizer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2519110">visualizador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44651_2513850_2737997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The extension that enables access to data across Office 365 services and Azure Active Directory through Microsoft Graph.</descrip></descripGrp><ntig><termGrp><term id="2513850">Microsoft Office 365 Connected Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2737997">Microsoft Office 365 Connected Services</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44660_2514598_2515672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The website that allows developers to experiment with using OAuth2 with Outlook APIs.</descrip></descripGrp><ntig><termGrp><term id="2514598">OAuth Sandbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2515672">Illamento de procesos para OAuth</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44661_2514599_2515669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The website that allows developers to edit the JSON definition of an actionable message card and immediately see the rendered result.</descrip></descripGrp><ntig><termGrp><term id="2514599">Card Playground</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig>