Set><langSet xml:lang="gl"><ntig><termGrp><term id="1178275">clave principal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13408_299899_498774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Words or phrases that convey hatred or contempt or is intended to intimidate or cause harm to a group of people based on race, religion, ethnic origin, sexual orientation or disability.</descrip></descripGrp><ntig><termGrp><term id="299899">hate speech</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498774">incitación ao odio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13412_319156_2016030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of the access point used to establish wireless connectivity.</descrip></descripGrp><ntig><termGrp><term id="319156">access point name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2016030">APN</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13412_379559_2016030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of the access point used to establish wireless connectivity.</descrip>