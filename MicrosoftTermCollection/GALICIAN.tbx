r</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412311">cartafol predefinido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1308_232849_498467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A nonprinting mark you insert to show the end of a section.</descrip></descripGrp><ntig><termGrp><term id="232849">section break</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498467">quebra de sección</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13089_102926_497935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of copying content and/or configuration settings from one location, generally a server node, to another to ensure synchronization or fault tolerance.</descrip></descripGrp><ntig><termGrp><term id="102926">replication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497935">replicación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13092_71417_2392985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specified series of operations, called steps, performed sequentially by a program to complete an action.</descrip></descripGrp><ntig><termGrp><term id="71417">job</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2392985">traballo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13093_143022_2094480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The depth at which a group in a report or data access page is nested inside other groups. Groups are nested when a set of records is grouped by more than one field, expression, or group record source.</descrip></descripGrp><ntig><termGrp><term id="143022">group level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094480">nivel do grupo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1310_169918_1744249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unique, 25-character code on a prepaid card that adds computer use time to your prepaid computer or that pays for your subscription.</descrip></descripGrp><ntig><termGrp><term id="169918">prepaid card number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1744249">ficha</term><termNote type="geographicalUsag