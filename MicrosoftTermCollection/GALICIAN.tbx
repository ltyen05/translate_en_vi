ipGrp><descrip type="definition">The feature within the PC Manager app that boosts PC performance by freeing memory.</descrip></descripGrp><ntig><termGrp><term id="3100753">PC Boost</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3101231">Mellora do rendemento do PC</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54583_3100754_3101230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within the PC Manager app that protects the operational system default browser settings from unexpected changes.</descrip></descripGrp><ntig><termGrp><term id="3100754">Browser Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3101230">Protección do explorador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54587_3113361_3114094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Entra product that enables securing and managing workloads, such as applications, service principals, managed identities and other software components that need to access cloud resources.</descrip></descripGrp><ntig><termGrp><term id="3113361">Microsoft Entra Workload ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3114094">ID de carga de traballo de Microsoft Entra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54587_3113361_3114096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Entra product that enables securing and managing workloads, such as applications, service principals, managed identities and other software components that need to access cloud resources.</descrip></descripGrp><ntig><termGrp><term id="3113361">Microsoft Entra Workload ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3114096">ID de carga de traballo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54587_3113362_3114094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Entra product that enables securing and managing workloads, such as applications, service principals, managed identities and other software components that need to access cloud resources.</descrip></descripGrp><ntig><termGrp><term id="3113362">Workload ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3114094">ID de carga de traballo de Microsoft Entra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54587_3113362_3114096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Entra product that enables securing and managing workloads, such as applications, service principals, managed identities and other software components that need to access cloud resources.</descrip></descripGrp><ntig><termGrp><term id="3113362">Workload ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3114096">ID de carga de traballo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54588_3101395_3102306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unity add-in that enables Microsoft Mesh users to upload custom environment templates to suit corporate events and meetings or create digital twins to match real-world environments in Mesh Spaces and Events.</descrip></descripGrp><ntig><termGrp><term id="3101395">Mesh Toolkit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3102306">Kit de ferramentas de Mesh</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54591_3101398_3102300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A strategy for fact checking an unfamiliar online source by leaving the webpage and opening a new browser tab to see what additional websites say about the unknown source.</descrip></descripGrp><ntig><termGrp><term id="3101398">lateral reading</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3102300">lectura lateral</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54592_3101451_3101623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A layout control which helps to lay out an array of objects in a predefined three-dimensional shape. It supports various surface styles, such as plane, cylinder, sphere, and radial. The radius and size of the objects and the space between them can be adjusted.</descrip></descripGrp><ntig><termGrp><term id="3101451">3D object collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3101623">colección de obxectos 3D</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54593_3101452_3101624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Dynamics 365 Guides on HoloLens that allows user and remote collaborator annotate in the environment while on the call. Annotations are useful for pointing out different parts of the space, including parts that may be difficult or dangerous to reach. All call participants can see each others’ additions, and can make their own annotations.</descrip></descripGrp><ntig><termGrp><term id="3101452">annotation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3101624">anotación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54594_3101453_3101625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An anchor in Dynamics 365 Guides used to align guide by gazing at a printed circular code anchor that's attached to a physical object in the real world.</descrip></descripGrp><ntig><termGrp><term id="3101453">circular code anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3101625">áncora de código circular</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54595_3101454_3101626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An anchor in Dynamics 365 Guides used to align guide to a digital 3D hologram that's overlaid on a physical object in the real world.</descrip></descripGrp><ntig><termGrp><term id="3101454">holographic anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3101626">áncora holográfica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54596_3101455_3101627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of anchor in Dynamics 365 Guides that represents a position and orientation relative to a real-world object in an environment. It provides a common frame of reference that allows to place digital content in the same physical location of a real-world object.</descrip></descripGrp><ntig><termGrp><term id="3101455">object anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3101627">áncora de obxecto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54597_3101456_3101628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An anchor in Dynamics 365 Guides used to align guide by gazing at a printed QR code anchor that's attached to a physical object in the real world. QR code anchoring is recommended for small to medium-size objects and spaces because it's the most accurate method, and the anchor can be printed at different sizes.</descrip></descripGrp><ntig><termGrp><term id="3101456">QR code anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3101628">áncora de código QR</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54598_3101457_3101629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Dynamics 365 Remote Assist that enables to capture and annotate a part of the environment during a call. Users can save the snapshot to their mobile device gallery, the in-call text chat, or both.</descrip></descripGrp><ntig><termGrp><term id="3101457">snapshot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3101629">instantánea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54599_3101458_3101630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A central building block for creating a guide in Microsoft Dynamics 365 Guides. After creating the structure for guide in the Outline page, Step Editor will need to be used to add instructional text and 3D models or media to support the step.</descrip></descripGrp><ntig><termGrp><term id="3101458">step</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3101630">paso</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54600_3102395_3103141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Purview feature that combines the risk scoring and user-activity approach of Insider Risk Management, with the data protection capabilities from Microsoft DLP.</descrip></descripGrp><ntig><termGrp><term id="3102395">Adaptive Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3103141">Protección adaptable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54601_3102396_3103143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The marketing handle for Threat Intelligence research, content, and resources that serves as a center for teams that collaborate across product engineering, data science, policy, legal, and security services to apply research methods and analysis to protect customers through Microsoft products and services.</descrip></descripGrp><ntig><termGrp><term id="3102396">Microsoft Threat Intelligence</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3103143">Intelixencia sobre ameazas de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54601_3102396_3103147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The marketing handle for Threat Intelligence research, content, and resources that serves as a center for teams that collaborate across product engineering, data science, policy, legal, and security services to apply research methods and analysis to protect customers through Microsoft products and services.</descrip></descripGrp><ntig><termGrp><term id="3102396">Microsoft Threat Intelligence</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3103147">Intelixencia sobre ameazas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54601_3102397_3103143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The marketing handle for Threat Intelligence research, content, and resources that serves as a center for teams that collaborate across product engineering, data science, policy, legal, and security services to apply research methods and analysis to protect customers through Microsoft products and services.</descrip></descripGrp><ntig><termGrp><term id="3102397">Threat Intelligence</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3103143">Intelixencia sobre ameazas de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54601_3102397_3103147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The marketing handle for Threat Intelligence research, content, and resources that serves as a center for teams that collaborate across product engineering, data science, policy, legal, and security services to apply research methods and analysis to protect customers through Microsoft products and services.</descrip></descripGrp><ntig><termGrp><term id="3102397">Threat Intelligence</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3103147">Intelixencia sobre ameazas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54603_3102400_3112468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that retains Microsoft Incident Response with a pre-paid block of hours to enable faster and more effective response to cybersecurity incidents.</descrip></descripGrp><ntig><termGrp><term id="3102400">Microsoft Incident Response Retainer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3112468">Retención de resposta a incidentes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54603_3102400_3112470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that retains Microsoft Incident Response with a pre-paid block of hours to enable faster and more effective response to cybersecurity incidents.</descrip></descripGrp><ntig><termGrp><term id="3102400">Microsoft Incident Response Retainer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3112470">Retención de resposta a incidentes de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54603_3102401_3112468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that retains Microsoft Incident Response with a pre-paid block of hours to enable faster and more effective response to cybersecurity incidents.</descrip></descripGrp><ntig><termGrp><term id="3102401">Incident Response Retainer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3112468">Retención de resposta a incidentes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54603_3102401_3112470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that retains Microsoft Incident Response with a pre-paid block of hours to enable faster and more effective response to cybersecurity incidents.</descrip></descripGrp><ntig><termGrp><term id="3102401">Incident Response Retainer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3112470">Retención de resposta a incidentes de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54604_3102403_3103145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability that enables developers to create applications with native validation experiences.</descrip></descripGrp><ntig><termGrp><term id="3102403">native authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3103145">autenticación nativa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54605_3102404_3103144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The "voice of the employee" solution that helps organizations understand and improve employee engagement through organization-wide surveys and recommended actions.</descrip></descripGrp><ntig><termGrp><term id="3102404">Microsoft Viva Glint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3103144">Microsoft Viva Glint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54605_3102404_3156166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The "voice of the employee" solution that helps organizations understand and improve employee engagement through organization-wide surveys and recommended actions.</descrip></descripGrp><ntig><termGrp><term id="3102404">Microsoft Viva Glint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3156166">Glint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54605_3102