/ntig></langSet></termEntry><termEntry id="52131_2946707_2946811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows IT pros and admins to set up internal SharePoint Online sites within their organizations and populate them with training videos customized to their end users.</descrip></descripGrp><ntig><termGrp><term id="2946707">Microsoft 365 learning pathways</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2946811">itinerarios de aprendizaxe de Microsoft 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52131_2946708_2946810"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows IT pros and admins to set up internal SharePoint Online sites within their organizations and populate them with training videos customized to their end users.</descrip></descripGrp><ntig><termGrp><term id="2946708">learning pathways</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2946810">itinerarios de aprendizaxe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52131_2946708_2946811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows IT pros and admins to set up internal SharePoint Online sites within their organizations and populate them with training videos customized to their end users.</descrip></descripGrp><ntig><termGrp><term id="2946708">learning pathways</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2946811">itinerarios de aprendizaxe de Microsoft 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52139_2946739_2946813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Teams that helps the remote worker reinstate the division between work time and home time by scheduling time at the beginning of the workday to prepare for work and at the end of the workday to reflect, celebrate accomplishments, plan the next day's tasks, or meditate with Headspace.</descrip></descripGrp><ntig><termGrp><term id="2946739">virtual commute</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2946813">desprazamento virtual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52143_2947723_2948498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML document that specifies a list of sites, their compatibility mode, and their intended browser.</descrip></descripGrp><ntig><termGrp><term id="2947723">Enterprise Mode Site List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2948498">Lista de sitios do modo de empresa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52144_2947724_2948503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A benefit, advantage, or discount provided to a customer when they use a product in association with a Windows device.</descrip></descripGrp><ntig><termGrp><term id="2947724">Windows benefit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2948503">vantaxe de Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52146_2947726_2948497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category of products across the industry that deliver the full PC/desktop experience running in the cloud, accessible through a browser or a remote-access app; a hybrid OS working on any device as a cloud-based service.</descrip></descripGrp><ntig><termGrp><term id="2947726">Cloud PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2948497">PC na nube</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52146_3003124_2948497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category of products across the industry that deliver the full PC/desktop experience running in the cloud, accessible through a browser or a remote-access app; a hybrid OS working on any device as a cloud-based service.</descrip></descripGrp><ntig><termGrp><term id="3003124">cloud PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2948497">PC na nube</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52147_2947728_2948501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Short vibrations and haptic signals emitted by an accessory or peripheral to inform the user that an action has been taken or add a feeling of resistance/traction.</descrip></descripGrp><ntig><termGrp><term id="2947728">tactile signals</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2948501">sinais táctiles</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52148_2947836_2948634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user role that has permissions to schedule an appointment.</descrip></descripGrp><ntig><termGrp><term id="2947836">Scheduler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2948634">Programador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52149_2947838_2948639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user condition when all traditional aspects of professional, social, and personal life are fulfilled and balanced.</descrip></descripGrp><ntig><termGrp><term id="2947838">wellbeing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2948639">benestar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52150_2947839_2948640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A plan that helps employees to achieve the condition when all traditional aspects of professional, social, and personal life are fulfilled and balanced by adopting habits that will help them disconnect and unwind in their off-hours.</descrip></descripGrp><ntig><termGrp><term id="2947839">wellbeing plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2948640">plan de benestar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52155_2948052_2948630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 app that lets users create and share lists that help them track issues, assets, routines, contacts, inventory, and mo