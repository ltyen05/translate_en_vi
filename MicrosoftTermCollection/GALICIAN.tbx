tig></langSet></termEntry><termEntry id="4964_232406_498450"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital address book that is automatically created from contacts in the Contacts folder.</descrip></descripGrp><ntig><termGrp><term id="232406">Outlook Address Book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498450">axenda de enderezos de Outlook</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49648_2808686_2832308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of or relating to the time delay that occurs between the occurrence of an event and the use of the processed data, such as for display or feedback and control purposes.</descrip></descripGrp><ntig><termGrp><term id="2808686">near real-time</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2832308">case en tempo real</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49677_2809791_2838511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows customers using Power Apps and Common Data Service to create external-facing websites that allow users outside their organizations to sign in with a variety of authentication providers, create and view data in Common Data Service, and browse content anonymously.</descrip></descripGrp><ntig><termGrp><term id="2809791">Power Apps portals</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2838511">Portais de Power Apps</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49700_2812847_2840757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The family of Microsoft products that provide malware protection and a unified infrastructure for client management and security.</descrip></descripGrp><ntig><termGrp><term id="2812847">System Center Endpoint Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2840757">System Center Endpoint Protection</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49702_2812919_2832309"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power Query feature for data preparation which allows you to apply different data transformations by previewing data and selecting transformations in the user experience.</descrip></descripGrp><ntig><termGrp><term id="2812919">Power Query Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2832309">Editor de Power Query</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49702_2812919_2906500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power Query feature for data preparation which allows you to apply different data transformations by previewing data and selecting transformations in the user experience.</descrip></descripGrp><ntig><termGrp><term id="2812919">Power Query Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2906500">Editor de consultas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49702_2906173_2832309"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power Query feature for data preparation which allows you to apply different data transformations by previewing data and selecting transformations in the user experience.</descrip></descripGrp><ntig><termGrp><term id="2906173">Query Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2832309">Editor de Power Query</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49702_2906173_2906500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power Query feature for data preparation which allows you to apply different data transformations by previewing data and selecting transformations in the user experience.</descrip></descripGrp><ntig><termGrp><term id="2906173">Query Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2906500">Editor de consultas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49708_2813043_2832311"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that brings together data science capabilities and machine learning assets into a single web pane that streamlines machine learning workflows.</descrip></descripGrp><ntig><termGrp><term id="2813043">studio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2832311">estudio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49719_2813882_2824631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A robotic process automation (RPA) feature that enables customers to automate processes across legacy and modern systems without needing API connectors.</descrip></descripGrp><ntig><termGrp><term id="2813882">UI flows</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2824631">fluxos de interface de usuario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4972_75877_1178713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In information processing, an operation performed by the computer at hand rather than by a remote computer.</descrip></descripGrp><ntig><termGrp><term id="75877">local</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178713">local</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4973_141204_498170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In line and area charts, lines that extend from a data point to the category (x) axis. Useful in area charts to clarify where one data marker ends and the next begins.</descrip></descripGrp><ntig><termGrp><term id="141204">drop lines</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498170">liñas de unión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49731_2814044_2815425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of flow that is created using the UI flows feature.</descrip></descripGrp><ntig><termGrp><term id="2814044">UI flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp><