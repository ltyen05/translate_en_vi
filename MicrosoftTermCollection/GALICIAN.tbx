Set></termEntry><termEntry id="35638_2106336_2107556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription that is the best plan for small and midsized nonprofit organizations that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Online.</descrip></descripGrp><ntig><termGrp><term id="2106336">Office 365 Nonprofit Business Premium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2107556">Office 365 Nonprofit Business Superior</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35639_2106335_2107555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription for small and midsized nonprofit organizations that need anywhere access to email and documents with Office Online.</descrip></descripGrp><ntig><termGrp><term id="2106335">Office 365 Nonprofit Business Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2107555">Office 365 Nonprofit Business Básico</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35640_2046824_2067694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An offer from Microsoft Office 365 for nonprofit organizations that offers additional storage options for SharePoint Online, pric