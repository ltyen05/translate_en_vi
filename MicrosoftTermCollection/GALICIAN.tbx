Grp><ntig><termGrp><term id="437306">last name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1305901">apelidos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13356_34914_497465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard Windows control that can be used to provide interactive column titles for a list.</descrip></descripGrp><ntig><termGrp><term id="34914">column heading</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497465">título de columna</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13361_568043_1302763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user interface control that can be added to Microsoft Dynamics CRM entity forms and within the application toolbar or navigation area of an entity form. These controls are configured in XML within ISV.Config and are designed to allow the inclusion of functionality from another web application within Microsoft Dynamics CRM. There are three types of client extension controls: Menu Items, Buttons, Entity Form Navigation areas.</descrip></descripGrp><ntig><termGrp><term id="568043">client extension control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1302763">control de extensión de cliente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13363_184068_498342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu option on the Property Panel that enables the user to specify document properties.</descrip></descripGrp><ntig><termGrp><term id="184068">Property Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498342">editor de propiedades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1337_297179_498756"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of trojan that causes systems equipped with modems to dial phone numbers without the consent of the user. In most cases, the phone numbers dialed are premium rate numbers which result in unexpected charges on the affected user's phone bill.</descrip></descripGrp><ntig><termGrp><term id="297179">dialer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498756">troiano marcador de teléfono</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13370_33049_497446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To end an application's relationship with an open file so that the application will no longer be able to access the file without opening it again.</descrip></descripGrp><ntig><termGrp><term id="33049">close</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497446">pechar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13372_413712_1178798"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbol that is displayed beside a paragraph in outline view. You can use the symbol to display or hide subordinate levels of text and to reorganize text quickly.</descrip></descripGrp><ntig><termGrp><term id="413712">outline symbol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178798">símbolo de esquema</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13374_359204_499143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A complete Web site stored in a named subdirectory of the top-level Web site.</descrip></descripGrp><ntig><termGrp><term id="359204">subsite</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="499143">subsitio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termN