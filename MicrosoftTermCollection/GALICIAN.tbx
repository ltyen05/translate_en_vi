Note type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54659_3103216_3103861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app available within Microsoft 365, Microsoft Edge, and other apps that provides live updates related to Microsoft 365 activity such as document editing, email mentions, articles shared in Teams.</descrip></descripGrp><ntig><termGrp><term id="3103216">Microsoft Feed</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3103861">Microsoft Feed</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54660_3103217_3103855"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API that provides Super Resolution (SR) support for D3D12 applications.</descrip></descripGrp><ntig><termGrp><term id="3103217">DirectSR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3103855">DirectSR</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54661_3103943_3104956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Teams app for EDU that functions as a learning management system (LMS) by allowing educators to create, organize, and reuse their course content over time and allowing students to find relevant learning resources in Teams.</descrip></descripGrp><ntig><termGrp><term id="3103943">Classwork</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104956">Classwork</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54662_3103944_3104957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated security approach that covers the entire lifecycle of cloud-native applications by combining cloud security posture management (CSPM), cloud workload protection (CWP), cloud infrastructure entitlement management (CIEM), and cloud applications security broker (CASB).</descrip></descripGrp><ntig><termGrp><term id="3103944">Cloud-Native Application Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104957">Protección das aplicacións nativas da nube</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54662_3103944_3104958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated security approach that covers the entire lifecycle of cloud-native applications by combining cloud security posture management (CSPM), cloud workload protection (CWP), cloud infrastructure entitlement management (CIEM), and cloud applications security broker (CASB).</descrip></descripGrp><ntig><termGrp><term id="3103944">Cloud-Native Application Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104958">CNAPP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54662_3103945_3104957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated security approach that covers the entire lifecycle of cloud-native applications by combining cloud security posture management (CSPM), cloud workload protection (CWP), cloud infrastructure entitlement management (CIEM), and cloud applications security broker (CASB).</descrip></descripGrp><ntig><termGrp><term id="3103945">CNAPP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104957">Protección das aplicacións nativas da nube</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54662_3103945_3104958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated security approach that covers the entire lifecycle of cloud-native applications by combining cloud security posture management (CSPM), cloud workload protection (CWP), cloud infrastructure entitlement management (CIEM), and cloud applications security broker (CASB).</descrip></descripGrp><ntig><termGrp><term id="3103945">CNAPP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104958">CNAPP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54663_3103946_3104936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Security kit that includes infographics, videos, and an email to help users protect identities, devices, and data, safeguard from phishing and other scams, manage passwords efficiently and keep software up to date.</descrip></descripGrp><ntig><termGrp><term id="3103946">Be Cyber Smart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104936">Kit de ciberseguranza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54664_3103947_3104959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Jargon or popular language for the use of multiple cloud computing and storage services in a single heterogeneous architecture.</descrip></descripGrp><ntig><termGrp><term id="3103947">multicloud</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104959">multinube</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54665_3103948_3104979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows customers to cryptographically tie tokens to the device a user originally signed in from.</descrip></descripGrp><ntig><termGrp><term id="3103948">token protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104979">protección de tokens</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54666_3104302_3104336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability that quickly captures detailed steps for each process in your organization to help you better understand the opportunities to streamline your workflows. Process advisor includes both task mining and process mining capabilities.</descrip></descripGrp><ntig><termGrp><term id="3104302">process advisor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104336">asesor de procesos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54667_3104366_3104896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container-like module that is used to organize the information or modules on a page by providing a collapsible drawer-like capability. An accordion module can be used on any page.</descrip></descripGrp><ntig><termGrp><term id="3104366">accordion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104896">acordeón</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54668_3104367_3104897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Commerce module that is used to display and link to loyalty program information.</descrip></descripGrp><ntig><termGrp><term id="3104367">Account loyalty</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104897">Fidelización de contas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54669_3104368_3104898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A module that provides product information needed to make a purchase decision and allows the user to add the items to cart.</descrip></descripGrp><ntig><termGrp><term id="3104368">buy box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104898">cadro de compra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5467_375735_380475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism that helps reduce the volume of antivirus scanning that is required across an organization by stamping messages that have been scanned for viruses with metadata that indicates the version of the antivirus software that performed the scan and the result of that scan. This metadata, or "stamp," travels securely with the message as it is routed through different email servers within the organization and is used to determine whether subsequent additional virus scanning on the message can be bypassed.</descrip></descripGrp><ntig><termGrp><term id="375735">antivirus stamping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="380475">carimbo antivirus</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54670_3104369_3104899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code-free style change that overrides any Dynamics 365 Commerce module's Cascading Style Sheets (CSS).</descrip></descripGrp><ntig><termGrp><term id="3104369">CSS override</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104899">anulación de CSS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54671_3104370_3104901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programmatically determined marker in your published pages that allows screen-reader users to understand where they are currently located in the webpage.</descrip></descripGrp><ntig><termGrp><term id="3104370">landmark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104901">punto de referencia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54672_3104371_3104902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card that entitles the card holder to participate in the loyalty programs that are assigned to the card.</descrip></descripGrp><ntig><termGrp><term id="3104371">loyalty card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104902">cartón de fidelidade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54673_3104372_3104904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned systematically to a new call center channel. Because call centers are created as operating units, users can link the call center channel to various Commerce features, such as assortments, catalogs, and specific modes of delivery.</descrip></descripGrp><ntig><termGrp><term id="3104372">operating unit number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104904">número de unidade operativa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54673_3104372_3104906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned systematically to a new call center channel. Because call centers are created as operating units, users can link the call center channel to various Commerce features, such as assortments, catalogs, and specific modes of delivery.</descrip></descripGrp><ntig><termGrp><term id="3104372">operating unit number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104906">NUO</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54673_3104389_3104904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned systematically to a new call center channel. Because call centers are created as operating units, users can link the call center channel to various Commerce features, such as assortments, catalogs, and specific modes of delivery.</descrip></descripGrp><ntig><termGrp><term id="3104389">OUN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104904">número de unidade operativa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54673_3104389_3104906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned systematically to a new call center channel. Because call centers are created as operating units, users can link the call center channel to various Commerce features, such as assortments, catalogs, and specific modes of delivery.</descrip></descripGrp><ntig><termGrp><term id="3104389">OUN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104906">NUO</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54674_3104373_3104905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that can be created and used to quickly place repeat orders.</descrip></descripGrp><ntig><termGrp><term id="3104373">order template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104905">modelo de pedido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54675_3104374_3104907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extension that facilitates communication between Commerce (and associated components) and a payment service.</descrip></descripGrp><ntig><termGrp><term id="3104374">payment connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104907">conector de pagamento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54676_3104375_3104908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page that provides detailed information about a product, and lets customers select product options such as a size, style, and color. A PDP should showcase all the product information that a customer requires to make a purchase decision.</descrip></descripGrp><ntig><termGrp><term id="3104375">PDP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104908">PDP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54677_3104376_3104909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of rules that are joined by AND conditions. Users can also create multiple rule blocks that have OR conditions between them.</descrip></descripGrp><ntig><termGrp><term id="3104376">rule block</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104909">bloque de regras</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54678_3104377_3104910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A profile that can be set up to manage identity management settings for site user logins.</descrip></descripGrp><ntig><termGrp><term id="3104377">site authentication profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104910">perfil de autenticación do sitio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54679_3104378_3104911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolset that enables users to build templates, select themes, and select and configure modules for a website without writing any code.</descrip></descripGrp><ntig><termGrp><term id="3104378">site builder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104911">xerador de sitios</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54680_3104379_3104912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A module that lets users browse across multiple sites by providing an easy way to switch between sites and select their preferred shopping site when a business has different sites across markets, regions, and locales.</descrip></descripGrp><ntig><termGrp><term id="3104379">site picker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104912">selector de sitios</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54681_3104380_3104913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programming element that lets a screen reader pass over navigation elements and ads on a Web site and go directly to the desired content.</descrip></descripGrp><ntig><termGrp><term id="3104380">skip link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104913">ligazón de omisión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54682_3104381_3104914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A module that is used to add space between sections on your page to allow for different layout and design options.</descrip></descripGrp><ntig><termGrp><term id="3104381">spacer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104914">separador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54683_3104548_3105854"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The add-on service made available as a Microsoft Dataverse solution that adds the ability to replicate Dataverse data to a Microsoft Azure SQL Database store in a customer-owned Microsoft Azure subscription.</descrip></descripGrp><ntig><termGrp><term id="3104548">Data Export</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3105854">Exportación de datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54684_3104549_3105855"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The asynchronous service that executes long-running operations independent of the main Microsoft Dataverse core operation.</descrip></descripGrp><ntig><termGrp><term id="3104549">Dynamics 365 Async Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3105855">Servizo asíncrono de Dynamics 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54684_3104549_3105856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The asynchronous service that executes long-running operations independent of the main Microsoft Dataverse core operation.</descrip></descripGrp><ntig><termGrp><term id="3104549">Dynamics 365 Async Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3105856">Servizo de procesamento asíncrono de Dynamics 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54684_3104558_3105855"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The asynchronous service that executes long-running operations independent of the main Microsoft Dataverse core operation.</descrip></descripGrp><ntig><termGrp><term id="3104558">Dynamics 365 Asynchronous Processing Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3105855">Servizo asíncrono de Dynamics 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54684_3104558_3105856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The asynchronous service that executes long-running operations independent of the main Microsoft Dataverse core operation.</descrip></descripGrp><ntig><termGrp><term id="3104558">Dynamics 365 Asynchronous Processing Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3105856">Servizo de procesamento asíncrono de Dynamics 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54685_3104550_3105857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The event website that provides an online resource where people can read about your event and its speakers, create an account, register for the event, purchase passes, view their session schedule, and more.</descrip></descripGrp><ntig><termGrp><term id="3104550">Event Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3105857">Portal do evento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54686_3104551_3105858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that enables continuous replication of Common Data Service entity data to Azure Data Lake, which can then be used to run analytics, such as Power BI reporting, machine learning, data warehousing, or other downstream integration purposes. It simplifies the technical and administrative complexity of operationalizing entities for analytics and managing schema and data.</descrip></descripGrp><ntig><termGrp><term id="3104551">Export to Data Lake</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3105858">Exportar a lago de datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54687_3104552_3105859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The component that is used to display the SharePoint documents in Microsoft Dynamics 365.</descrip></descripGrp><ntig><termGrp><term id="3104552">Microsoft Dynamics 365 List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet 