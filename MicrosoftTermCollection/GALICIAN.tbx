"gl"><ntig><termGrp><term id="1950343">MTE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3838_47370_497568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar that is attached to one edge of the program window. When you drag a toolbar below the program title bar or to the left, right, or bottom edge of the window, the toolbar snaps into place on the edge of the program window.</descrip></descripGrp><ntig><termGrp><term id="47370">docked toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497568">barra de ferramenas ancorada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38399_2223248_2228215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway Design feature that allows users to change the navigation and layout model of a particular Sway document.</descrip></descripGrp><ntig><termGrp><term id="2223248">Structure</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2228215">Estrutura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38416_2226110_2229907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that is installed as part of the MultiPoint role on server and ensures that some MultiPoint configuration settings remain set to keep Windows MultiPoint Server running smoothly.</descrip></descripGrp><ntig><termGrp><term id="2226110">Windows MultiPoint Server Repair Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2229907">Servizo de reparación de Windows MultiPoint Server</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38418_2226112_2229744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in the Messaging app that detects whether an SMS message is spam, based on its content.</descrip></descripGrp><ntig><termGrp><term id="2226112">smart blocking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2229744">bloqueo intelixente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38419_2227157_2229637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keypad that is available in Programmer mode, which allows the user to look at numbers represented as various combinations of 1s and 0s, and to toggle between 1 and 0 for each binary bit to form a new number.</descrip></descripGrp><ntig><termGrp><term id="2227157">bit toggling keypad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2229637">teclado de alternancia de bits</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38420_2227158_2229646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of thematically related apps, games, music tracks, videos, or other items available for purchase or download in the Store. A thematic group of editorially chosen apps and games for merchandising or marketing purposes.</descrip></descripGrp><ntig><termGrp><term id="2227158">Collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2229646">Colección</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38421_2227159_2229652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to select a color and increase or decrease the vibrancy of that color in an image.</descrip></descripGrp><ntig><termGrp><term id="2227159">color boost</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2229652">reforzo de cores</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38422_2227160_2792550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu invoked with a shortcut key (Windows + G) when gaming that allows users to take a screenshot, take a 30 second clip of a game, and adjust volume controls.</descrip></descripGrp><ntig><termGrp><term id="2227160">Game Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2792550">Game Bar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2227161_2229685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2227161">IoT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2229685">IoT</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2227161_2269495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2227161">IoT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2269495">Internet das cousas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2268355_2229685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2268355">Internet of Things</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2229685">IoT</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2268355_2269495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2268355">Internet of Things</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2269495">Internet das cousas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38424_2227162_2229730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A broad set of all the user's local and cloud-based content, including documents, apps, settings, photos, videos, music, and email.  Cortana or Bing can search this content and return it in search results.</descrip></descripGrp><ntig><termGrp><term id="2227162">my stuff</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2229730">as miñas cousas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38426_2227164_2229848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A note, handwritten or typed, that can be added by the user directly on webpages from within the browser.</descrip></descripGrp><ntig><termGrp><term id="2227164">Web Note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2229848">Nota web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38427_2227165_2229852"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 available through volume licensing, that is designed for education institutions, and includes all of the features of Windows 10 Pro, plus some other features like virtualization, management, DirectAccess, and BranchCache.</descrip></descripGrp><ntig><termGrp><term id="2227165">Windows 10 Education</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2229852">Windows 10 Education</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38428_2227166_2229859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 that is available only through volume licensing, is designed for businesses, and includes all of the features of Windows 10 Pro, plus some other features like virtualization, management, DirectAccess, and BranchCache.</descrip></descripGrp><ntig><termGrp><term id="2227166">Windows 10 Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2229859">Windows 10 Enterprise</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38429_2227167_2229865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 designed for HoloLens.</descrip></descripGrp><ntig><termGrp><term id="2227167">Windows 10 Holographic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2229865">Windows 10 Holographic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38430_2227168_2229868"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 designed for home users.</descrip></descripGrp><ntig><termGrp><term id="2227168">Windows 10 Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2229868">Windows 10 Home</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38431_2227169_2229873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 optimized for fixed function IoT devices.</descrip></descripGrp><ntig><termGrp><term id="2227169">Windows 10 IoT Core</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2229873">Windows 10 IoT Core</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38432_2227170_2229876"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 for a range of powerful IoT devices that provides granular lockdown capabilities, Win32 and modern app support.</descrip></descripGrp><ntig><termGrp><term id="2227170">Windows 10 IoT Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2229876">Windows 10 IoT Enterprise</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38434_2