o, shopping, and restaurants in a user's current location and the surrounding area.</descrip></descripGrp><ntig><termGrp><term id="1629244">Local Scout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086135">rastrexador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31971_2058971_2016131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature accessed from Search or Maps that displays things to see and do, shopping, and restaurants in a user's current location and the surrounding area.</descrip></descripGrp><ntig><termGrp><term id="2058971">scout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2016131">Rastrexador local</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31971_2058971_2086135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature accessed from Search or Maps that displays things to see and do, shopping, and restaurants in a user's current location and the surrounding area.</descrip></descripGrp><ntig><termGrp><term id="2058971">scout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2086135">rastrexador</term><termNote type="geographicalUsage">ESP</termNote><termNote t