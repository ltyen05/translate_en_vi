 linked to one another.</descrip></descripGrp><ntig><termGrp><term id="648627">master project</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1689066">proxecto principal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17513_648724_1649901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To briefly press a UI element with your fingertip or stylus to perform an activity (such as choosing an action from a menu or opening an item). A "tap" is normally around 0.1 second in duration.</descrip></descripGrp><ntig><termGrp><term id="648724">tap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1649901">tocar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17525_649087_1178839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number from 0 to 1 that reveals how closely the estimated values for the trendline correspond to your actual data. A trendline is most reliable when its R-squared value is at or near 1.</descrip></descripGrp><ntig><termGrp><term id="649087">coefficient of determination</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178839">valor de R ao cadrado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17525_649088_1178839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number from 0 to 1 that reveals how closely the estimated values for the trendline correspond to your actual data. A trendline is most reliable when its R-squared value is at or near 1.</descrip></descripGrp><ntig><termGrp><term id="649088">R-squared value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178839">valor de R ao cadrado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17530_649578_1178840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A label that identifies the categories, values, or series in a chart.</descrip></descripGrp><ntig><termGrp><term id="649578">tick mark label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178840">etiqueta de marca de escala</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17530_649579_1178840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A label that identifies the categories, values, or series in a chart.</descrip></descripGrp><ntig><termGrp><term id="649579">tick-mark label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178840">etiqueta de marca de escala</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17531_649800_1178841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small line of measurement, similar to a division on a ruler, that intersects an axis.</descrip></descripGrp><ntig><termGrp><term id="649800">tick mark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178841">marca de escala</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17532_649802_1178842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The developer of a macro that is trusted by you on your computer. The trusted publisher is identified by the certificate that they used to digitally sign the macro.</descrip></descripGrp><ntig><termGrp><term id="649802">trusted publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178842">fonte de confianza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17532_649803_1178842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The developer of a macro that is trusted by you on your computer. The trusted publisher is identified by the certificate that they used to digitally sign the macro.</descrip></descripGrp><ntig><termGrp><term id="649803">trusted source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178842">fonte de confianza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1758_517980_2767490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server running Lync Server or Office Communications Server that mediates signaling and voice between the Enterprise Voice IP network and the public switched telephone network.</descrip></descripGrp><ntig><termGrp><term id="517980">Mediation Server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2767490">Servidor de mediación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="176_1136584_363209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data access interface that communicates with OLE DB-compliant data sources to connect to, retrieve, manipulate, and update data.</descrip></descripGrp><ntig><termGrp><term id="1136584">Active Data Object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></te