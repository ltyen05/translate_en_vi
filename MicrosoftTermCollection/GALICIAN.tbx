ain names in Internet email addresses.</descrip></descripGrp><ntig><termGrp><term id="616796">commercial @</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497318">arroba</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37324_2116468_2137366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft service that provides fonts on demand to Microsoft applications, eliminating the need for any fonts to be shipped with those applications.</descrip></descripGrp><ntig><termGrp><term id="2116468">Microsoft Fonts Online</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2137366">Microsoft Fonts Online</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37325_2116471_2137598"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle that appears on objects or text insertion points when a user taps on them making selection easier.</descrip></descripGrp><ntig><termGrp><term id="2116471">selection handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2137598">controlador de selección</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">