p><descrip type="definition">The online community where IT professionals, developers, and end-users, as well as Microsoft employees can interact, ask questions, share ideas or observations on Office 365 and many other Microsoft technologies.</descrip></descripGrp><ntig><termGrp><term id="3054295">Microsoft Technical Community</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3054417">Microsoft Technical Community</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53663_3054432_3056366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows 365 capability that allows the user to work offline in your Cloud PC environment and sync when reconnected.</descrip></descripGrp><ntig><termGrp><term id="3054432">Windows 365 Offline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3056366">Windows 365 sen conexión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53664_3054433_3056364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows 365 capability that allows the user to boot directly to your Cloud PC.</descrip></descripGrp><ntig><termGrp><term id="3054433">Windows 365 Boot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3056364">Arranque de Windows 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53665_3054434_3056367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows 365 capability that allows the user to swipe between desktop and a Cloud PC/Windows 365 environment as part of task view.</descrip></descripGrp><ntig><termGrp><term id="3054434">Windows 365 Switch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3056367">Cambio de ambiente de Windows 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53668_3055383_3059692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to device features that can detect if someone is coming or going from a device, triggering the device to wake or lock.</descrip></descripGrp><ntig><termGrp><term id="3055383">presence sensing</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3059692">detección de presenza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53669_3055384_3056363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature on select devices with a sensor to detect motion as someone approaches so the device powers back on.</descrip></descripGrp><ntig><termGrp><term id="3055384">wake on approach</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3056363">reactivación ao acercarse</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53670_3055385_3056362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature on select devices with the proper sensor to detect motion as someone walks away from their device so it powers down/sleeps to save power.</descrip></descripGrp><ntig><termGrp><term id="3055385">lock on leave</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3056362">bloqueo ao afastarse</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53671_3055386_3059680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that dims or brightens the display in response to lighting conditions.</descrip></descripGrp><ntig><termGrp><term id="3055386">adaptive dimming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3059680">atenuación adaptable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfS