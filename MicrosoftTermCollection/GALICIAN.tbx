tage value that indicates how much each category weighs into the overall grade. Other factors, such as class participation, may also be considered.</descrip></descripGrp><ntig><termGrp><term id="1623978">evaluation criteria</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1658126">criterios de avaliación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31795_1623979_1658137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of refining a search for information by filtering on individual properties or facets of the items being searched.</descrip></descripGrp><ntig><termGrp><term id="1623979">faceted navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1658137">navegación por refinamento progresivo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31796_1623980_1658141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Comments about a completed assignment that an educator makes during review and grading and that are available to the student once the grade is posted.</descrip></descripGrp><ntig><termGrp><term id="1623980">feedback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1658141">comentarios</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31799_1624313_1658155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A JavaScript API that provides simple and consistent programmatic access to Office documents and applications across Office client environments through common as well as application-specific data types, objects, functions and events.</descrip></descripGrp><ntig><termGrp><term id="1624313">JavaScript API for Office</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1658155">API de JavaScript para Office</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31800_1624314_1658156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of learning that addresses a portion of the content for a class and may include assignments, materials, and other lessons.</descrip></descripGrp><ntig><termGrp><term id="1624314">lesson</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1658156">lección</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31800_2686115_1658156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of learning that addresses a portion of the content for a class and may include assignments, materials, and other lessons.</descrip></descripGrp><ntig><termGrp><term id="2686115">unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1658156">lección</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31801_1624315_1658157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A layout that is updated in real time as an object on the page is moved, resized, or rotated, enabling the user to preview the end result before the action is completed.</descrip></descripGrp><ntig><termGrp><term id="1624315">live layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1658157">disposición dinámica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31802_1624316_1658201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that turns on change tracking and lets you set a password to prevent unauthorized users from turning it off.</descrip></descripGrp><ntig><termGrp><term id="1624316">Lock Tracking</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1658201">Bloquear rastrexo de modificacións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</ter