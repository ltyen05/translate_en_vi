graphicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54815_3114838_3115706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to utilize Python libraries to quickly clean up data, explore the relationships within the data, and use sophisticated AI-powered libraries to analyze the data and make predictions.</descrip></descripGrp><ntig><termGrp><term id="3114838">Python in Excel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3115706">Python en Excel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5483_88655_497857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number whose form indicates position in an ordered sequence of items, such as first, third, or twentieth.</descrip></descripGrp><ntig><termGrp><term id="88655">ordinal number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497857">número ordinal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54832_3115260_3122509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 Copilot capability that delivers relevant, actionable responses to prompts.</descrip></descripGrp><ntig><termGrp><term id="3115260">Semantic Index for Copilot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3122509">Índice semántico de Copilot</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54833_3115363_3118411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software extension that augments the capabilities of AI systems, enabling them to interact with APIs from other software and services to retrieve real-time information, incorporate company and other business data, and perform new types of computations.</descrip></descripGrp><ntig><termGrp><term id="3115363">plugin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3118411">extensión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5487_26569_497392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Broadly, any device that performs arithmetic operations on numbers. Sophisticated calculators can be programmed for certain functions and can store values in memory, but they differ from computers in several ways: they have a fixed set of commands, they do not recognize text, they cannot retrieve values stored in a data file, and they cannot find and use values generated by a program such as a spreadsheet.</descrip></descripGrp><ntig><termGrp><term id="26569">calculator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497392">calculadora</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54958_3116446_3117043"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The geographically defined boundary consisting of the countries in the European Union (EU) and the European Free Trade Association (EFTA) within which Microsoft has committed to store and process customer data for its major commercial enterprise online services.</descrip></descripGrp><ntig><termGrp><term id="3116446">EU Data Boundary</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3117043">Fronteira de datos da UE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54959_3116447_3117032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To instruct, train, or guide.</descrip></descripGrp><ntig><termGrp><term id="3116447">coach</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3117032">adestrar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54960_3116448_3117034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who gives instructions, training, or guidance.</descrip></descripGrp><ntig><termGrp><term id="3116448">coach</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3117034">adestrador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54961_3116449_3117044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Teams feature that allows users to discuss content that's being presented or to ask questions to the presenter and other participants.</descrip></descripGrp><ntig><termGrp><term id="3116449">in-meeting chat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3117044">chat dentro da reunión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54962_3116450_3117175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Media available to be reused by others.</descrip></descripGrp><ntig><termGrp><term id="3116450">stock media</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3117175">ficheiro multimedia de arquivo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSp