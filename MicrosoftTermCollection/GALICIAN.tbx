 type="definition">Skype for Business client for iPad</descrip></descripGrp><ntig><termGrp><term id="2329151">Skype for Business for iPad</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2336944">Skype for Business para iPad</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4005_44392_497535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One or more special characters used to separate peers in a delimited structure, at any level (fields, records, and so on).</descrip></descripGrp><ntig><termGrp><term id="44392">delimiter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497535">delimitador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40050_2329152_2336943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Skype for Business client for Android</descrip></descripGrp><ntig><termGrp><term id="2329152">Skype for Business for Android</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2336943">Skype for Business para Android</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40051_2329153_2336942"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A planning tool for Skype for Business Server 2015</descrip></descripGrp><ntig><termGrp><term id="2329153">Skype for Business 2015 Planning tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2336942">Ferramenta de planificación de Skype for Business 2015</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40052_2329154_2336941"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The searchable directory of Skype users that allows users to search for other users via name, email address, or profile name.</descrip></descripGrp><ntig><termGrp><term id="2329154">Skype Directory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2336941">directorio de Skype</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40053_2329155_2336940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A balance that indicates the amount of Skype credit that remains on an account.</descrip></descripGrp><ntig><termGrp><term id="2329155">Skype Credit balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><t