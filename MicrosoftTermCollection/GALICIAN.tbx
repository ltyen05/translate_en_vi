gl"><ntig><termGrp><term id="2253385">panel Deseño</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38596_2398707_2405175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that provides users with a menu of different style modifications that can be applied to their sway.</descrip></descripGrp><ntig><termGrp><term id="2398707">Design customization</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2405175">Personalización de deseño</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38597_2244480_2253393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Sway card that takes a set of cards and creates a group out of them with a particular visualization pattern.</descrip></descripGrp><ntig><termGrp><term id="2244480">group card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2253393">deseño de grupo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38598_2244481_2253461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The gallery that holds all the Style options that can be applied to a sway.</descrip></descripGrp><ntig><termGrp><term id="2244481">Style gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2253461">Galería de estilos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38599_2244483_2253392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option that shows the set of fonts that can be applied to a sway.</descrip></descripGrp><ntig><termGrp><term id="2244483">Font choices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2253392">Opcións de tipos de letra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="386_93737_497898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware- or software-based interface used to transfer information between a computer and other devices. Hardware ports are physical connections that are visible on the outside of the computer. Software ports are the numbered gateways in programs that software programs use to exchange information.</descrip></descripGrp><ntig><termGrp><term id="93737">port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497898">porto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38600_2244485_2253390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Design feature that allows users to save particular Designs, Styles, or Structures for easy use or access later.</descrip></descripGrp><ntig><termGrp><term id="2244485">Favorites</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2253390">Favoritos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38601_2244486_2253467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The navigation layout that presents content in a single column on the page and that allows user to navigate from top to bottom.​​</descrip></descripGrp><ntig><termGrp><term id="2244486">Vertical</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2253467">Vertical</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38602_2244487_2253420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Structure that places content along the horizontal axis and allows users to navigate through it from left and right.</descrip></descripGrp><ntig><termGrp><term id="2244487">Panorama</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2253420">Panorámica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38603_2244846_2253386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that allows a user to click on an embedded image to see any of the following: a high resolution version of it, a link to where the image was found, as well as related images.</descrip></descripGrp><ntig><termGrp><term id="2244846">Detail view</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2253386">Visualización de detalles</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38604_2244850_2259592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button on the Sway home page that allows the user to begin using sway.</descrip></descripGrp><ntig><termGrp><term id="2244850">Get Started!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2259592">Comezar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38605_2244852_2253377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows users to create a bulleted list out of their text.</descrip></descripGrp><ntig><termGrp><term id="2244852">Bulleted list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2253377">Lista con viñetas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38625_2244876_2253408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows users to create a numbered list out of their text.</descrip></descripGrp><ntig><termGrp><term id="2244876">Numbered list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2253408">Lista numerada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38626_2244888_2253422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway link that opens an email that allows users to report a violation of Sway’s terms of use.</descrip></descripGrp><ntig><termGrp><term id="2244888">Report a violation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2253422">Notificar unha violación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38627_2244890_2253381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway menu that displays all of the available cards in a single panel.</descrip></descripGrp><ntig><termGrp><term id="2244890">Card gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2253381">Galería de deseños</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38628_2244894_2253407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows users to create a hyperlink embedded in their sway.</descrip></descripGrp><ntig><termGrp><term id="2244894">Link</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2253407">Ligar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38629_2244901_2248959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook folder where archived items are stored.</descrip></descripGrp><ntig><termGrp><term id="2244901">Archive</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2248959">Arquivo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38631_2247560_2248552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that assists customers in upgrading from Windows 7 Service Pack 1 (SP1) or Windows 8.1 Update 1 to Windows 10.  It notifies them of the option to upgrade, checks their PC for compatibility, and allows them to reserve a free upgrade.</descrip></descripGrp><ntig><termGrp><term id="2247560">Get Windows 10</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2248552">Obter Windows 10</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38632_2247561_2248564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The website where people can download Microsoft software for recovery (when they own it, but the old copy has been damaged), or first-time installation (when they own the rights, but haven't yet acquired the software itself).</descrip></descripGrp><ntig><termGrp><term id="2247561">Microsoft Software Download</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2248564">Descarga de software de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38633_2247562_2248554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work area on a computer screen that contains different groups of apps or content open and available for different tasks or aspects of your life.</descrip></descripGrp><ntig><termGrp><term id="2247562">virtual desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2248554">escritorio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38633_2247562_2248567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work area on a computer screen that contains different groups of apps or content open and available for different tasks or aspects of your life.</descrip></descripGrp><ntig><termGrp><term id="2247562">virtual desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2248567">escritorio virtual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38633_2247563_2248554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work area on a computer screen that contains different groups of apps or content open and available for different tasks or aspects of your life.</descrip></descripGrp><ntig><termGrp><term id="2247563">desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2248554">escritorio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38633_2247563_2248567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work area on a computer screen that contains different groups of apps or content open and available for different tasks or aspects of your life.</descrip></descripGrp><ntig><termGrp><term id="2247563">desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2248567">escritorio virtual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38635_2247565_2248577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action to express that you agree with similar feedback sent by someone else. Rather than resubmit the same feedback, you can tap "Upvote," which means that you agree with the feedback that has been previously submitted.</descrip></descripGrp><ntig><termGrp><term id="2247565">upvote</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2248577">voto a favor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38636_2247566_2248578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To agree with similar feedback sent by someone else. Rather than resubmit the same feedback, you can tap "Upvote," which means that you agree with the feedback that has been previously submitted.</descrip></descripGrp><ntig><termGrp><term id="2247566">upvote</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2248578">votar a favor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38638_2247833_2248561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user accounts that are connected as a family. This feature allows adults to manage kids’ experiences within the kids’ user account.</descrip></descripGrp><ntig><termGrp><term id="2247833">Microsoft family</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2248561">familia de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38639_2247838_2248566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section in Windows Store containing the user ratings and reviews for a given app.</descrip></descripGrp><ntig><termGrp><term id="2247838">Ratings and reviews</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2248566">Valoracións e opinións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38640_2410918_2588895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A supplementary item that can be purchased by a user from within an app, and for use with that app.</descrip></descripGrp><ntig><termGrp><term id="2410918">add-on</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2588895">complemento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38657_2249394_2255566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that displays web articles in a distraction-free layout that is optimized for their screen size.</descrip></descripGrp><ntig><termGrp><term id="2249394">reading view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2255566">visualización de lectura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3866_318126_498907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A language whose characters require ligation or shaping, such as a right-to-left language (Arabic, Persian, Hebrew, and Urdu) or certain South Asian languages.</descrip></descripGrp><ntig><termGrp><term id="318126">complex script</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498907">escrita complexa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38688_2254265_2331398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the MARS user interface, a logical course through a task in CRM, such as creating an account or qualifying a lead, leading to the conclusion of that task.</descrip></descripGrp><ntig><termGrp><term id="2254265">path</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2331398">camiño</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38689_2254270_2331397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control on the side of the user interface that contains helpful information about how to use the product. This control can contains sections, which in turn contain different content types, such as guided tasks or links, that help users complete tasks through the UI.</descrip></descripGrp><ntig><termGrp><term id="2254270">panel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2331397">panel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38690_2254279_2255568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The prerelease build of Windows 10 for enterprises available to customers in April 2015 or later.</descrip></descripGrp><ntig><termGrp><term id="2254279">Windows 10 Enterprise Insider Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2255568">Windows 10 Enterprise Insider Preview</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38691_2254280_2255570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The prerelease build of Windows 10 made available to customers in April 2015 or later. This is the most basic edition of Windows 10 Insider Preview.</descrip></descripGrp><ntig><termGrp><term id="2254280">Windows 10 Home Insider Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2255570">Windows 10 Home Insider Preview</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38694_2254283_2255571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The prerelease build of Windows 10 for phones that was made available to Insiders.</descrip></descripGrp><ntig><