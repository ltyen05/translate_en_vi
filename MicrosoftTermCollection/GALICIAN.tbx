">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12942_94098_2913041"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that turns a device off and on.</descrip></descripGrp><ntig><termGrp><term id="94098">power button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913041">botón de acender/apagar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12943_234576_498493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item in the Journal folder that acts as a shortcut to an activity that has been recorded.</descrip></descripGrp><ntig><termGrp><term id="234576">journal entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498493">entrada de diario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12948_182890_1276396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compilation of the different measurements that a product is available in. A unit group contains the base unit in which a product is available, for example, a two-liter. It then lists all the different increments that this base unit is packaged in for sale, such as an individual two-liter bottle or a case of 6 two-liter bottles, and also indicates which measurement is the primary unit.</descrip></descripGrp><ntig><termGrp><term id="182890">unit group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1276396">grupo de unidades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12954_134044_1139739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search technology used to separate text into individual words.</descrip></descripGrp><ntig><termGrp><term id="134044">word breaker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1139739">separador de palabras</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12958_1060966_1178795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To activate something making it available for use.</descrip></descripGrp><ntig><termGrp><term id="1060966">turn on</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178795">activar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12958_50552_1178795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To activate some