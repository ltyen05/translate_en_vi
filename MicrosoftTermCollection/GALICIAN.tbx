ake action on data-related incidents such as a data breach, data spillage, or needing to search for and purge messages that contain a harmful attachment.</descrip></descripGrp><ntig><termGrp><term id="2738468">Data investigations</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2740434">Investigacións de datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48469_2738471_2740435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 compliance center view that allows users to respond to a data subject request and create data subject request cases.</descrip></descripGrp><ntig><termGrp><term id="2738471">Data subject requests</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2740435">Sollicitudes do titular dos datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48472_2739176_2742675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of targeted information that is meant to change an individual's perception on something in a way that is untrue such that the shift will cause harm.</descrip></descripGrp><ntig><termGrp><term id="2739176">weaponized information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2742675">información terxiversadora</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48474_2739487_2742668"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition under which a policy is triggered.</descrip></descripGrp><ntig><termGrp><term id="2739487">policy trigger</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2742668">desencadeador de política</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48482_2741337_2742958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to authentication means that do not require a password.</descrip></descripGrp><ntig><termGrp><term id="2741337">password-less</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2742958">sen contrasinal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48482_2917812_2742958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to authentication means that do not require a password.</descrip></descripGrp><ntig><termGrp><term id="2917812">passwordless</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2742958">sen contrasinal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48485_2741340_2742959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A means of authentication in which key-based authentication is used to enable a user credential that is tied to a device and the users are not required to provide a password.</descrip></descripGrp><ntig><termGrp><term id="2741340">password-less authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2742959">autenticación sen contrasinal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48485_2917816_2742959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A means of authentication in which key-based authentication is used to enable a user credential that is tied to a device and the users are not required to provide a password.</descrip></descripGrp><ntig><termGrp><term id="2917816">passwordless authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2742959">autenticación sen contrasinal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48488_2741343_2742962"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security model that requires authentication and encryption of each access request as though it originates from an open network. Principles include segmentation, to make it harder for attackers to move through the network, and restricting user access to the minimum amount needed to do their job.</descrip></descripGrp><ntig><termGrp><term id="2741343">Zero Trust</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2742962">Confianza cero</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48494_2741547_2742931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft cyber security center that is staffed with security professionals, data scientists, and product engineers who are available 24 hours, seven days a week to help protect, detect, and respond to threats in real-time.</descrip></descripGrp><ntig><termGrp><term id="2741547">Cyber Defense Operations Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2742931">CDOC</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48494_2741547_2742932"><langSet xml:lang="en-US"><descripGrp><descrip type="definiti