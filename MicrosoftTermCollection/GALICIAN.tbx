ripGrp><descrip type="definition">A diagram that is based on Information Technology Infrastructure Library (ITIL) standard.</descrip></descripGrp><ntig><termGrp><term id="3014893">ITIL diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3015441">diagrama ITIL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53050_3014894_3015479"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram that is based on Six Sigma methodology.</descrip></descripGrp><ntig><termGrp><term id="3014894">Six Sigma flowchart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3015479">fluxograma Six Sigma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53054_3017114_3017682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work model that involves a mixture of in-office and remote work.</descrip></descripGrp><ntig><termGrp><term id="3017114">hybrid work</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3017682">traballo híbrido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langS