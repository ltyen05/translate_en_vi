"grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14847_211833_1319512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of text labels describing the role accounts and contacts play with opportunities as well as other accounts and contacts.</descrip></descripGrp><ntig><termGrp><term id="211833">relationship role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1319512">rol de relación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14848_253634_497749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line or row of characters used to lead the eye from a data label to a data point, or from a callout to the appropriate part of an illustration.</descrip></descripGrp><ntig><termGrp><term id="253634">leader line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497749">guía</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14848_253634_498580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line or row of characters used to lead the eye from a data label to a data point, or from a callout to the appropriate part of an illustration.</descrip></descripGrp><ntig><termGrp><term id="253634">leader line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498580">liña guía</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14848_73800_497749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line or row of characters used to lead the eye from a data label to a data point, or from a callout to the appropriate part of an illustration.</descrip></descripGrp><ntig><termGrp><term id="73800">leader</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497749">guía</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14848_73800_498580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line or row of characters used to lead the eye from a data label to a data point, or from a callout to the appropriate part of an illustration.</descrip></descripGrp><ntig><termGrp><term id="73800">leader</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498580">liña guía</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14854_359997_499160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field in a table that draws data from another table.</descrip></descripGrp><ntig><termGrp><term id="359997">Lookup field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="499160">campo de busca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14866_396930_412203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distribution group that uses recipient filters and conditions to derive its membership at the time the message is sent.</descrip></descripGrp><ntig><termGrp><term id="396930">dynamic distribution group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412203">rolda de distribución dinámica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14871_397149_412237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Exchange Server 2007 and 2010 server role that provides anti-spam and antivirus protection and applies messaging security policies to messages in transport between organizations by using a series of agents that act on messages as they are processed by the message transport components. This server role is deployed in the perimeter network outside the Active Directory directory service forest. Computers that have the Edge Transport server role installed handle all Internet-facing mail flow and provide Simple Mail Transfer Protocol (SMTP) relay and smart host services for the Exchange organization.</descrip></descripGrp><ntig><termGrp><term id="397149">Edge Transport server role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412237">función do servidor Transporte Edge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14874_287209_2739457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of Internet protocol that does not contain any link-layer header before it.</descrip></descripGrp><ntig><termGrp><term id="287209">raw IP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2739457">IP sen procesar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14874_287210_2739457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of Internet protocol that does not contain any link-layer header before it.</descrip></descripGrp><ntig><termGrp><term id="287210">low-level IP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2739457">IP sen procesar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1488_136966_498123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A row in the upper part of the Macro window in which you enter macro names, actions, conditions, and comments associated with a particular macro or macro group.</descrip></descripGrp><ntig><termGrp><term id="136966">action row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498123">fila da acción</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14883_416797_1727609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder in the workspace browser where available report views are listed.</descrip></descripGrp><ntig><termGrp><term id="416797">Reports</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1727609">Informes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14885_397156_412306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Exchange 2007 graphical user interface (GUI) from which administrators can perform tasks to configure and manage Exchange servers. The Exchange Management Console is based on Windows Microsoft Management Console (MMC) 3.0.</descrip></descripGrp><ntig><termGrp><term id="397156">Exchange Management Console</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml: