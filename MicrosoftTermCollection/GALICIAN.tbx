inine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32226_1641038_1658248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables subscription customers to launch Office rich client applications online from a computer on which those applications are not already installed.</descrip></descripGrp><ntig><termGrp><term id="1641038">Office on Demand</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1658248">Office cando queiras</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32227_1641039_1722414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio style that sets your audio to play in the background as a soundtrack to your presentation.</descrip></descripGrp><ntig><termGrp><term id="1641039">Play in Background</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1722414">Reproducir de fondo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32228_1641040_1658276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to edit SharePoint list content directly without opening an edit window.</descrip></descripGrp><ntig><termGrp><term id="1641040">Quick Edit</term><termNote type="partOfSpeech">ProperNoun</termNote><ter