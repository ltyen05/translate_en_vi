uestions to either the entire company network or specific users and poll the answers.</descrip></descripGrp><ntig><termGrp><term id="2160161">Poll</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2215210">Enquisas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37805_2160171_2215213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button in Yammer that allows users to show approval for other users for something they have done or shared on Yammer.</descrip></descripGrp><ntig><termGrp><term id="2160171">Praise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2215213">Eloxiar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37806_2160178_2215214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button in Yammer that directs users to where they can change their account settings.</descrip></descripGrp><ntig><termGrp><term id="2160178">Preferences</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2215214">Preferencias</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote t