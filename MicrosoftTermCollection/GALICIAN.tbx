de traballo ou por produtos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35343_2026691_2028507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A consolidated view of all sites that a user has followed.</descrip></descripGrp><ntig><termGrp><term id="2026691">Site Folders</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2028507">Cartafoles do sitio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35344_2026692_2028500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Logical rules composed of predicates and actions that enable administrators to perform actions, such as allow, block, or redirect client access traffic on the Exchange Server.</descrip></descripGrp><ntig><termGrp><term id="2026692">Client Access Rule</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2028500">Regra de acceso do cliente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35345_2026693_2028503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Exchange Admin Center (EAC) that generates a dynamic log of commands made to a server at that given point of time. Administrators can view the log to check the UI behavior, analyze or troubleshoot commands, or even run custom scripts on a server.</descrip></descripGrp><ntig><termGrp><term id="2026693">Cmdlet Logging Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2028503">Visualizador do rexistro de cmdlet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35346_2026694_2028497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A procedure in which adding a shape to the drawing canvas automatically also adds the shape's name as a text label.</descrip></descripGrp><ntig><termGrp><term id="2026694">auto-labelling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2028497">etiquetaxe automática</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3535_397220_412313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Anti-spam functionality that is enabled on computers that have the Edge Transport server role installed to block messages according to characteristics of the sender. The Sender Reputation agent continuously monitors senders and their past Simple Mail Transfer Protocol (SMTP) interactions, such as the amount of spam and messages that are not spam that a sender has sent, and relies on persisted data about the sender to determine what action, if any, to take on an inbound message.</descrip></descripGrp><ntig><termGrp><term id="397220">sender reputation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412313">reputación do remitente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35351_2026819_2393010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of scaling back resource usage by blocking connectivity of clients that are adversely impacting the overall health of the system.</descrip></descripGrp><ntig><termGrp><term id="2026819">engine throttling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2393010">limitación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35351_2026820_2393010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of scaling back resource usage by blocking connectivity of clients that are adversely impacting the overall health of the system.</descrip></descripGrp><ntig><termGrp><term id="2026820">throttling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2393010">limitación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3537_232842_1178696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A global template that you can use for any type of document. You can modify this template to change the default document formatting or content.</descrip></descripGrp><ntig><termGrp><term id="232842">Normal template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178696">modelo Normal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35386_2029080_2036317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 8.1 that has the search engine in Internet Explorer defaulted to Bing.</descrip></descripGrp><ntig><termGrp><term id="2029080">Windows 8.1 with Bing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2036317">Windows 8.1 con Bing</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35387_2029081_2036313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The software update to Windows 8.1 that gives users a more familiar and convenient experience across touch, keyboard and mouse inputs and enables more affordable Windows device choices.</descrip></descripGrp><ntig><termGrp><term id="2029081">Windows 8.