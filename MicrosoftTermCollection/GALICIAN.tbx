39088">Servizos intelixentes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43041_2676674_2677428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The group of intelligent services for users with an Office 365 account.​</descrip></descripGrp><ntig><termGrp><term id="2676674">Office Intelligent Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2677428">Servizos intelixentes de Office</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43042_2438463_2439081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">​​The Editor feature that detects potentially incorrect verbal conjugation and offers suggestions to correct the error.​</descrip></descripGrp><ntig><termGrp><term id="2438463">Incorrect Verb Form</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2439081">Forma verbal incorrecta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43043_2438464_2439078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Editor feature that detects potentially incorrect pronoun use and offers suggestions to correct the error.</descrip></descripGrp><ntig><termGrp><term id="2438464">Incorrect Pronoun Case</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2439078">Caso pronominal incorrecto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43044_2438783_2439521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The drawing app you can use to create simple or elaborate drawings. These drawings can be either black-and-white or color. You can also use Paint to work with pictures, such as .jpg, .gif, or .bmp files.</descrip></descripGrp><ntig><termGrp><term id="2438783">Microsoft Paint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2439521">Microsoft Paint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43044_2438783_2439522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The drawing app you can use to create simple or elaborate drawings. These drawings can be either black-and-white or color. You can also use Paint to work with pictures, such as .jpg, .gif, or .bmp files.</descrip></descripGrp><ntig><termGrp><term id="2438783">Microsoft Paint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2439522">Paint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43044_2438784_2439521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The drawing app you can use to create simple or elaborate drawings. These drawings can be either black-and-white or color. You can also use Paint to work with pictures, such as .jpg, .gif, or .bmp files.</descrip></descripGrp><ntig><termGrp><term id="2438784">Paint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2439521">Microsoft Paint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43044_2438784_2439522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The drawing app you can use to create simple or elaborate drawings. These drawings can be either black-and-white or color. You can also use Paint to work with pictures, such as .jpg, .gif, or .bmp files.</descrip></descripGrp><ntig><termGrp><term id="2438784">Paint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2439522">Paint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43053_2439180_2439523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar, appearing at the top, that displays a small preview image (thumbnail) of the content in each open tab.</descrip></descripGrp><ntig><termGrp><term id="2439180">preview bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2439523">barra de previsualización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43054_2439181_2439529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to see a small preview of the content in each open tab, shown in a persistent bar (not just on mouseover)​.</descrip></descripGrp><ntig><termGrp><term id="2439181">tab preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2439529">previsualización de pestana</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43055_2439182_2439528"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To clear or remove all tabs that are currently displayed, and save them as a set of tabs that you can restore later.</descrip></descripGrp><ntig><termGrp><term id="2439182">set aside</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2439528">reservar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43056_2439225_2922945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The low-code, back-end data platform that includes data storage, a set of common entities with built-in data models, security management, AI, and scalable integration. Its shared data storage provides single-source data consistency that customers can build apps, flows, bots, and AI models on, of varying complexity at scale.</descrip></descripGrp><ntig><termGrp><term id="2439225">Common Data Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2922945">Dataverse</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43056_2715882_2922945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The low-code, back-end data platform that includes data storage, a set of common entities with built-in data models, security management, AI, and scalable integration. Its shared data storage provides single-source data consistency that customers can build apps, flows, bots, and AI models on, of varying complexity at scale.</descrip></descripGrp><ntig><termGrp><term id="2715882">CDS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2922945">Dataverse</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43056_2907430_2922945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The low-code, back-end data platform that includes data storage, a set of common entities with built-in data models, security management, AI, and scalable integration. Its shared data storage provides single-source data consistency that customers can build apps, flows, bots, and AI models on, of varying complexity at scale.</descrip></descripGrp><ntig><termGrp><term id="2907430">Dataverse</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2922945">Dataverse</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43059_2439287_2442648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office tool that erases a portion of an ink stroke up to where it intersects with itself or another ink stroke.</descrip></descripGrp><ntig><termGrp><term id="2439287">Segment Eraser</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2442648">Borrador de segmentos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4306_36901_2094422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control and an attached label, such as a text box with an attached label.</descrip></descripGrp><ntig><termGrp><term id="36901">compound control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094422">control composto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43060_2439288_2442640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office Lens feature that uses voice guidance to help users with visual impairments center objects in the frame of their camera when taking pictures.</descrip></descripGrp><ntig><termGrp><term id="2439288">Frame Guide</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2442640">Guía de encadramento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43060_2505368_2442640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office Lens feature that uses voice guidance to help users with visual impairments center objects in the frame of their camera when taking pictures.</descrip></descripGrp><ntig><termGrp><term id="2505368">VoiceOver</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2442640">Guía de encadramento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43061_2439289_2442651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Graph tool that populates a graph from a set of input entities (documents, people, etc.) and the relationships between them.</descrip></descripGrp><ntig><termGrp><term id="2439289">Sets</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2442651">Conxuntos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43062_2439290_2445964"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Graph tool that allows developers to create and explore sets, create and manage permissions on sets, perform queries on sets, and manage sets and their relationships.</descrip></descripGrp><ntig><termGrp><term id="2439290">Sets Studio</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2445964">Estudo de conxuntos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43063_2439291_2440912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables users to discover the usage level of their Office productivity apps compared with non-Office productivity apps and get high level insights of productivity application usage w