ected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2016234">pantalla Inicio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29803_1632118_2016232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Home screen of an unlocked phone.</descrip></descripGrp><ntig><termGrp><term id="1632118">Start</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2016232">Inicio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29803_1632118_2016234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Home screen of an unlocked phone.</descrip></descripGrp><ntig><termGrp><term id="1632118">Start</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2016234">pantalla Inicio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29812_1510524_2015263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change the state of an enumerator or data source object so that it cannot be used to access data.</descrip></descripGrp><ntig><termGrp><term id="1510524">uninitialize</term><te