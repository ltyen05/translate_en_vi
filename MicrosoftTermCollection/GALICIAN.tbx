Note type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2847704">modelo de aviso</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50336_2844806_2847045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A validation of a partner’s capability to deliver high-fidelity services in a specific solution area. Advanced specializations are customer-facing labels displayed on a partner’s business profile in the Partner Directory, enabling partners to showcase their differentiated skills.</descrip></descripGrp><ntig><termGrp><term id="2844806">advanced specialization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2847045">especialización avanzada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50337_2844818_2847087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A validation of a partner’s broad technical capability in a Microsoft product or technology.</descrip></descripGrp><ntig><termGrp><term id="2844818">competency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2847087">competencia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50338_2844833_2847035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advanced specialization that provides a means for partners to showcase proven expertise and verifiable accreditation in adoption and change management services via Microsoft 365 Teams and Yammer.</descrip></descripGrp><ntig><termGrp><term id="2844833">Adoption and change management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2847035">Adopción e xestión de cambios</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50339_2844838_2847511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advanced specialization that provides a means for partners to showcase proven, verifiable expertise in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="2844838">Meetings and meeting rooms for Microsoft Teams</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2847511">Reunións e salas de reunións para Microsoft Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50340_2844846_2847811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advanced specialization that allows partners to showcase proven expertise and Microsoft engineering approved methodologies for deploying Office 365.</descrip></descripGrp><ntig><termGrp><term id="2844846">teamwork deployment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2847811">despregamento de traballo en equipo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50341_2844851_2847041"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Teams add-on that will include features/capabilities such as priority notifications, targeting in chats, channels, and tasks (third-party, dynamic), and workflow driven escalations.</descrip></descripGrp><ntig><termGrp><term id="2844851">Advanced Collaboration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2847041">Colaboración avanzada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50342_2844853_2847073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advanced specialization that provides a means for partners to showcase proven expertise and verifiable accreditation via the Microsoft Teams Phone System.</descrip></descripGrp><ntig><termGrp><term id="2844853">Calling for Microsoft Teams</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2847073">Chamadas para Microsoft Teams</term><termNote type="geographicalUsage">ESP</te