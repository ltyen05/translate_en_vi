</ntig></langSet></termEntry><termEntry id="37965_2172250_2339875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Label for drop-down list where an administrator indicates if the location record is a regular location record or is specific to OneNote integration.</descrip></descripGrp><ntig><termGrp><term id="2172250">Location Type</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2339875">Tipo de localización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37966_2172251_2339872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Choice in the drop-down list in the OneNote integration feature setting where an administrator indicates that the location record is specific to OneNote integration.</descrip></descripGrp><ntig><termGrp><term id="2172251">Dedicated for OneNote Integration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2339872">Dedicado á integración de OneNote</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37967_2172252_2339874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Choice in the drop-down list in the OneNote integration feature setting where an administrator indicates that the location record is a regular location record, meaning that it is not specific to OneNote integration.</d