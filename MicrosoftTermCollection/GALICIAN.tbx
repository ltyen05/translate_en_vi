páxina</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32687_1690725_1693955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Internet Explorer that enables users to go to the next page on a site quickly by swiping across the page or clicking the Forward button.</descrip></descripGrp><ntig><termGrp><term id="1690725">flip ahead</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1693955">pasar páxina</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32688_1690726_1694903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that shuts down or restarts the PC.</descrip></descripGrp><ntig><termGrp><term id="1690726">Power</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1694903">Acender/apagar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32720_1694143_1718178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option that lets users choose, be default, what mode they will view records in forms in.</descrip></descripGrp><ntig><termGrp><term id="1694143">Form Mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1718178">modo de visualización de formulario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32721_1694144_1718168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Type of form that is not editable, so viewers can quickly see data, but not modify it.</descrip></descripGrp><ntig><termGrp><term id="1694144">read-optimized</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1718168">optimizado para a lectura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3273_4400_1950454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML format for describing Web services. WSDL allows Web service providers and users of such services to work together easily by enabling the separation of the description of the abstract functionality offered by a service from concrete details of a service description such as "how" and "where" that functionality is offered.</descrip></descripGrp><ntig><termGrp><term id="4400">Web Services Description Language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950454">WSDL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3273_4400_363240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML format for describing Web services. WSDL allows Web service providers and users of such services to work together easily by enabling the separation of the description of the abstract functionality offered by a service from concrete details of a service description such as "how" and "where" that functionality is offered.</descrip></descripGrp><ntig><termGrp><term id="4400">Web Services Description Language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="363240">Linguaxe de descrición de servizos web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3273_4401_1950454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML format for describing Web services. WSDL allows Web service providers and users of such services to work together easily by enabling the separation of the description of the abstract functionality offered by a service from concrete details of a service description such as "how" and "where" that functionality is offered.</descrip></descripGrp><ntig><termGrp><term id="4401">WSDL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950454">WSDL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3273_4401_363240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML format for describing Web services. WSDL allows Web service providers and users of such services to work together easily by enabling the separation of the description of the abstract functionality offered by a service from concrete details of a service description such as "how" and "where" that functionality is offered.</descrip></descripGrp><ntig><termGrp><term id="4401">WSDL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="363240">Linguaxe de descrición de servizos web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32734_1707158_1722131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows service application that reads data files uploaded by the Office Telemetry Agent and inserts the data into SQL Server.</descrip></descripGrp><ntig><termGrp><term id="1707158">Office Telemetry Processor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1722131">Procesador de telemetría de Office</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32741_1698172_1708236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An assignment property that indicates whether grades for the assignment are numeric or non-numeric.</descrip></descripGrp><ntig><termGrp><term id="1698172">Grade Values</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1708236">Valores de cualificación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32747_1698384_1707763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remotely view, stream, or copy files stored on a PC running OneDrive from any other device.</descrip></descripGrp><ntig><termGrp><term id="1698384">fetch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1707763">obter</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32750_1698385_1718167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A part of the Activity Feeds solution, where the posts about records are displayed.</descrip></descripGrp><ntig><termGrp><term id="1698385">Record Wall</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1718167">Taboleiro de información</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32759_1700973_1718165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account on a social networking site such as Facebook or Twitter that you connect to from Microsoft Dynamics CRM.</descrip></descripGrp><ntig><termGrp><term id="1700973">social channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1718165">canle social</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32761_1703328_1718179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business entity, typically a company, that provides up to date data to a Microsoft Dynamics CRM user.</descrip></descripGrp><ntig><termGrp><term id="1703328">external data provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1718179">fornecedor de datos externos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32761_1703328_1718184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business entity, typically a company, that provides up to date data to a Microsoft Dynamics CRM user.</descrip></descripGrp><ntig><termGrp><term id="1703328">external data provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1718184">fornecedor de servizos de datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32761_1703343_1718179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business entity, typically a company, that provides up to date data to a Microsoft Dynamics CRM user.</descrip></descripGrp><ntig><termGrp><term id="1703343">data service provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1718179">fornecedor de datos externos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32761_1703343_1718184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business entity, typically a company, that provides up to date data to a Microsoft Dynamics CRM user.</descrip></descripGrp><ntig><termGrp><term id="1703343">data service provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1718184">fornecedor de servizos de datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32762_1703329_1718173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The record that contains person-specific information (age, height, etc) in CRM.</descrip></descripGrp><ntig><termGrp><term id="1703329">person record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1718173">información persoal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32763_1703330_1718172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Business Network feature in CRM, the connection that a person has to another person, whether explicit, where the relationship is defined, or implicit, where the people may have had contact, but the relationship is not defined.</descrip></descripGrp><ntig><termGrp><term id="1703330">person relationship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1718172">relación persoal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32764_1703331_1718171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that represents a person, declared as such in metadata.</descrip></descripGrp><ntig><termGrp><term id="1703331">person-type entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1718171">entidade de tipo persoa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32765_1703332_1718159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that represents a person in the Business Network, to which person-type entities in CRM can be linked.</descrip></descripGrp><ntig><termGrp><term id="1703332">Business Network profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1718159">perfil da rede profesional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32766_1703333_1718158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An explicit (for example, “colleague”) or implicit (for example,  “sent 100 emails in the last 30 days”) relationship, with inherent strength, between people in the Business Network.</descrip></descripGrp><ntig><termGrp><term id="1703333">Business Network relationship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1718158">relación da rede profesional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32767_1703334_1718188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A role that is similar to the customer service role, with the addition of being able to manage public conversations enabled and with the following permissions: organization read, BU append, BU append to, and user delete.</descrip></descripGrp><ntig><termGrp><term id="1703334">community representative</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1718188">representante da comunidade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32768_1703340_1718164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a pie chart that represents records, for example, cases broken out by source, the part of the "pie" (the slice) that represents social sources such as Facebook, Twitter, and other social channels.</descrip></descripGrp><ntig><termGrp><term id="1703340">social slice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1718164">porción social</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32769_1703344_1744240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action by which a subscription (the source subscription) is replaced by a new subscription, both owned by the same billing account, along a preconfigured conversion path. The source subscription is canceled and the destination subscription is the new subscription.</descrip></descripGrp><ntig><termGrp><term id="1703344">conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1744240">conversión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32770_1703345_1744292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A new subscription that is created as a result of a conversion or a merge.</descrip></descripGrp><ntig><termGrp><term id="1703345">destination subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1744292">subscrición de destino</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32772_1703346_1718180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add to or augment data that is in the system, usually from an outside data service provider.</descrip></descripGrp><ntig><termGrp><term id="1703346">enrich</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1718180">enriquecer</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32773_1703347_1744269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subscription that is canceled to create a new subscription as a result of a conversion or merge.</descrip></descripGrp><ntig><termGrp><term id="1703347">source subscription</term><ter