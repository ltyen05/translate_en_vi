efinition">Software that changes settings without adequate consent.</descrip></descripGrp><ntig><termGrp><term id="297189">settings modifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498761">modificador da configuración</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11312_149466_498235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action query that changes a set of records according to criteria you specify. An update query does not return any records.</descrip></descripGrp><ntig><termGrp><term id="149466">update query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498235">consulta de actualización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11314_53258_497617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file system used by MS-DOS and Microsoft Windows operating systems to organize and manage files.</descrip></descripGrp><ntig><termGrp><term id="53258">FAT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497617">FAT</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">