termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498641">Importar vídeo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4191_262696_498641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows wizard that helps the user import digital video to the computer from digital video cameras and other sources.</descrip></descripGrp><ntig><termGrp><term id="262696">Import Video</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498641">Importar vídeo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41911_2372259_2373622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form that needs to be filled out when porting a telephone number(s). This form gives permission to request to port number(s) from a different service provider in case of dispute.</descrip></descripGrp><ntig><termGrp><term id="2372259">Letter of Authorization</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2373622">Carta de autorización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41912_2372260_2373618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A telephone number to which all of a customer phone numbers are charged in a consolidated telephone phone bill, instead of showing charges under each telephone number. Also called billed telephone number.</descrip></descripGrp><ntig><termGrp><term id="2372260">billing telephone number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2373618">número de teléfono de facturación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41913_2372261_2373625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of taking the phone numbers you currently have with a telephone service provider or carrier and transferring those numbers over to different provider.</descrip></descripGrp><ntig><termGrp><term id="2372261">number porting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2373625">Procesamento da portabilidade do número</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41914_2372262_2373627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An order that you submit to transfer phone numbers from a service provider to Skype for Business Online.</descrip></descripGrp><ntig><termGrp><term id="2372262">port order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2373627">Pedido de portabilidade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41915_2372263_2373621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effective date that a user selects when requesting the phone numbers are ported over or transferred to Skype for Business Online.</descrip></descripGrp><ntig><termGrp><term id="2372263">Firm Order Commitment</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2373621">Cita de pedido en firme</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41916_2372270_2373629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To sanction or confirm that the data comply with predefined rules or parameters.</descrip></descripGrp><ntig><termGrp><term id="2372270">validate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2373629">validar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41917_2372848_2375002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function which takes an expression and performs an implicit intersection when the expression is a range, returns the top left value when expression is an array, and otherwise just returns the expression.</descrip></descripGrp><ntig><termGrp><term id="2372848">SINGLE()</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2375002">SINGLE()</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41919_2373340_2374217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A timeframe that a customer sets to describe when they usually use their device, during which automatic restarts will not happen.</descrip></descripGrp><ntig><termGrp><term id="2373340">active hours</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2374217">horas de actividade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41920_2373341_2374219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The command that pastes a URL that you copied to your clipboard into the address bar and takes you to the site.</descrip></descripGrp><ntig><termGrp><term id="2373341">Paste and go</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2374219">Pegar e ir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41921_2373342_2374220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app included in Windows that allows a trusted friend or support professional to help solve a problem with your PC by accessing and taking control of it over a remote connection.</descrip></descripGrp><ntig><termGrp><term id="2373342">Quick Assist</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2374220">Asistencia rápida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41921_2373342_3161419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app included in Windows that allows a trusted friend or support professional to help solve a problem with your PC by accessing and taking control of it over a remote connection.</descrip></descripGrp><ntig><termGrp><term id="2373342">Quick Assist</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3161419">Asistencia rápida de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41921_3160521_2374220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app included in Windows that allows a trusted friend or support professional to help solve a problem with your PC by accessing and taking control of it over a remote connection.</descrip></descripGrp><ntig><termGrp><term id="3160521">Microsoft Quick Assist</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2374220">Asistencia rápida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41921_3160521_3161419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app included in Windows that allows a trusted friend or support professional to help solve a problem with your PC by accessing and taking control of it over a remote connection.</descrip></descripGrp><ntig><termGrp><term id="3160521">Microsoft Quick Assist</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3161419">Asistencia rápida de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41924_2373924_2374997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ShiftR feature that allows managers to create a schedule that groups employees with the same type of job together.</descrip></descripGrp><ntig><termGrp><term id="2373924">Group by positions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2374997">Agrupar por cargos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41928_2374250_2376834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The parts of a model that hang with no support, and therefore are likely to collapse during printing.</descrip></descripGrp><ntig><termGrp><term id="2374250">overhang</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2376834">parte saínte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41929_2374256_2376836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mesh printed along with a model meant to support overhangs and balance the model while it prints.</descrip></descripGrp><ntig><termGrp><term id="2374256">raft</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2376836">balsa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41930_2374257_2376838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that is printed with a model to support and balance a model while it prints.</descrip></descripGrp><ntig><termGrp><term id="2374257">support</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2376838">soporte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41931_2374260_2375005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Zoom feature that allows users to create a pictorial table of contents containing a collection of their Section Zooms and that can update if the presentation is edited.</descrip></descripGrp><ntig><termGrp><term id="2374260">Summary Zoom</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2375005">Visualización xeral de resumo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41932_2374261_2375003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Zoom feature that presents a preview of a slide in a presentation which auto-updates when the slide is updated and navigates users to that slide when they click on the preview</descrip></descripGrp><ntig><termGrp><term id="2374261">Slide Zoom</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2375003">Visualización xeral de diapositiva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41933_2374264_2375000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Zoom feature that presents a preview of a section in a presentation which auto-updates when the section’s first slide is updated, navigates users to that section when they click on the preview, and returns them back to the Summary Zoom when they are done.</descrip></descripGrp><ntig><termGrp><term id="2374264">Section Zoom</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2375000">Visualización xeral de sección</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41937_2374321_2376831"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A lock screen feature for mobile devices that lets users see their clock and lock screen info at a glance after your screen has turned off.​​</descrip></descripGrp><ntig><termGrp><term id="2374321">glance screen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2376831">pantalla de vista rápida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41938_2374322_2509071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that teachers can use to provision student PCs for classroom use.​</descrip></descripGrp><ntig><termGrp><term id="2374322">Set up School PCs</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2509071">Configurar PC escolares</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41939_2374323_2509074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The education app used for secure, online assessments, such as exams. It doesn't allow test takers to access resources stored on their device or the internet; it prevents OS-level distractions; and it doesn't allow test-takers to share test content with other students.​</descrip></descripGrp><ntig><termGrp><term id="2374323">Take a Test</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2509074">Facer un exame</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41946_2375030_2376827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for games that are rented most over time.</descrip></descripGrp><ntig><termGrp><term id="2375030">Most rented games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2376827">Os xogos máis alugados</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41947_2375031_2376826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for apps that are rented most over time.</descrip></descripGrp><ntig><termGrp><term id="2375031">Most rented apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2376826">As aplicacións máis alugadas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41948_2375032_2376825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for apps or games that are rented most over time.</descrip></descripGrp><ntig><termGrp><term id="2375032">Most rented</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2376825">Os máis alugados</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41949_2375033_2376820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for games that are in the top 1000 items based on sales.</descrip></descripGrp><ntig><termGrp><term id="2375033">Best selling games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig>