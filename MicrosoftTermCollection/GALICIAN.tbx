e right margin.</descrip></descripGrp><ntig><termGrp><term id="319132">right-aligned</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498967">aliñado á dereita</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13070_292970_2717686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of authentication delegation in which Kerberos can be used to impersonate users that send requests for certain services, as opposed to all services.</descrip></descripGrp><ntig><termGrp><term id="292970">Kerberos constrained delegation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2717686">delegación limitada de Kerberos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13076_1486351_1178269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of words or other text used to gain access to a network, program, or data. A passphrase is generally longer for added security.</descrip></descripGrp><ntig><termGrp><term id="1486351">pass phrase</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178269">frase de acceso</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote ty