term id="1689059">programación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43200_2447219_2450626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that is half the width of the confidence interval of a population parameter estimated by a sample, such that the true value is likely to be within the sample value +/- the number.</descrip></descripGrp><ntig><termGrp><term id="2447219">margin of error</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2450626">marxe de erro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43201_2447221_2454124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An input parameter defined by an expert to determine the quality of executed QA tests and the size of test samples.</descrip></descripGrp><ntig><termGrp><term id="2447221">estimated error margin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2454124">marxe de erro estimado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43202_2447224_2448192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of similar feedback displayed in search results, instead of showing all the duplicate feedback.</descrip></descripGrp><ntig><termGrp><term id="2447224">collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2448192">colección</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43203_2447225_2450618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that combines precision and recall, and that is calculated with (precision*recall)/(precision + recall).</descrip></descripGrp><ntig><termGrp><term id="2447225">f-measure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2450618">medida f</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43203_2805605_2450618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that combines precision and recall, and that is calculated with (precision*recall)/(precision + recall).</descrip></descripGrp><ntig><termGrp><term id="2805605">F1 score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2450618">medida f</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></ter