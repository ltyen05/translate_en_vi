ry><termEntry id="53750_3060439_3064410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Clipchamp that increases or reduces the playback speed of a video or audio track.</descrip></descripGrp><ntig><termGrp><term id="3060439">Clip speed</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3064410">Velocidade do clip</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53751_3060440_3068215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of motion text title or graphic that covers the lower region of the video frame, often used in TV broadcasting.</descrip></descripGrp><ntig><termGrp><term id="3060440">lower third</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3068215">terzo inferior</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53752_3060639_3061026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within Microsoft Teams that enables teachers to quickly create and review math assignments for their students.</descrip></descripGrp><ntig><termGrp><term id="3060639">Math Progress</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3061026">Progreso de matemáticas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53753_3060640_3061023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within Microsoft Teams that provides students with real-time feedback, helpful tips, and opportunities to practice based on challenging areas from math assignments.</descrip></descripGrp><ntig><termGrp><term id="3060640">Math Coach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3061023">Adestrador de matemáticas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53754_3060641_3061049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within Microsoft Teams that allows teachers to create Teams assignments focused on presentation, enabling them to identify areas where students can improve their presentation skills.</descrip></descripGrp><ntig><termGrp><term id="3060641">Speaker Progress</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3061049">Progreso de discursos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53755_3060642_3061051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables teachers to create and review focused writing Teams assignments for their students.</descrip></descripGrp><ntig><termGrp><term id="3060642">Writing Progress</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3061051">Progreso de escrita</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53756_3060643_3061050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within Microsoft Teams that provides students with real-time feedback, helpful tips and opportunities to practice based on challenging areas from writing assignments.</descrip></descripGrp><ntig><termGrp><term id="3060643">Writing Coach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3061050">Adestrador de escrita</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53757_3060644_3061042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within Microsoft Teams that allows teachers to create and review Search literacy assignments.</descrip></descripGrp><ntig><termGrp><term id="3060644">Search Progress</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3061042">Progreso de busca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53758_3060695_3061031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product that provides secure, performant and deep identity-aware access to all Internet, SaaS, and Microsoft 365 apps.</descrip></descripGrp><ntig><termGrp><term id="3060695">Microsoft Entra Internet Access</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3061031">Acceso a Internet de Microsoft Entra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53759_3060696_3061039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product that provides secure, performant and deep identity-aware Zero Trust Network Access to all private apps and legacy resources.</descrip></descripGrp><ntig><termGrp><term id="3060696">Microsoft Entra Private Access</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3061039">Acceso privado de Microsoft Entra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53760_3060705_3061041"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Viva and Mic