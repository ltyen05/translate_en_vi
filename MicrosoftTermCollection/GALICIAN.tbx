le of being retrieved (read), printed or copied but not changed (written) or saved.</descrip></descripGrp><ntig><termGrp><term id="98978">read-only</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178820">só de lectura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14968_592384_1990391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An apartment that consists of one or more threads.</descrip></descripGrp><ntig><termGrp><term id="592384">MTA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1990391">MTA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14968_592384_1990392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An apartment that consists of one or more threads.</descrip></descripGrp><ntig><termGrp><term id="592384">MTA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1990392">apartamento con varios subprocesos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14968_82756_1990391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An apartment that consists of one or more threads.</descrip></descripGrp><ntig><termGrp><term id="82756">multithreaded apartment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1990391">MTA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14968_82756_1990392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An apartment that consists of one or more threads.</descrip></descripGrp><ntig><termGrp><term id="82756">multithreaded apartment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1990392">apartamento con varios subprocesos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14974_84430_497825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On a local area network (LAN), a drive that other computers on the network can connect to. A network drive allows people to access shared files and folders.</descrip></descripGrp><ntig><termGrp><term id="84430">network drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497825">unidade de rede</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14988_397197_412262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A replication that combines the asynchronous log shipping and replay features built into Exchange 2007 with the failover and management features provided by a failover cluster that is created with the Microsoft Windows Cluster service.</descrip></descripGrp><ntig><termGrp><term id="397197">cluster continuous replication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412262">réplica continua en clúster</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14988_746537_412262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A replication that combines the asynchronous log shipping and replay features built into Exchange 2007 with the failover and management features provided by a failover cluster that is created with the Microsoft Windows Cluster service.</descrip></descripGrp><ntig><termGrp><term id="746537">CCR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412262">réplica continua en clúster</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14990_10614_497291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An on-screen box, in a graphical user interface, that is used to deliver a message or warning.</descrip></descripGrp><ntig><termGrp><term id="10614">alert box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497291">caixa de alerta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14991_446295_1336727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item on the Set Up menu that opens the Time Off dialog, which defines how much of the user's schedule is affected by a schedule change.</descrip></descripGrp><ntig><termGrp><term id="446295">Time Off</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1336727">Tempo libre</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14992_129955_2638682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A simulated 3-D environment that a user can experience and manipulate as if it were physical. The user sees the environment on display screens, possibly mounted in a special pair of goggles. Special input devices, such as gloves or suits fitted with motion sensors, detect the user's actions.</descrip></descripGrp><ntig><termGrp><term id="129955">virtual reality</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2638682">RV</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14992_685431_2638682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A simulated 3-D environment that a user can experience and manipulate as if it were physical. The user sees the environment on display screens, possibly mounted in a special pair of goggles. Special input devices, such as gloves or suits fitted with motion sensors, detect the user's actions.</descrip></descripGrp><ntig><termGrp><term id="685431">VR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2638682">RV</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14994_397171_412285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A replication that uses a single server and built-in technology to create and maintain a copy of a storage group on a second set of disks that are connected to the same server as the primary storage group. LCR provides asynchronous log shipping, log replay, and a quick manual switch to a copy of the data.</descrip></descripGrp><ntig><termGrp><term id="397171">local continuous replication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412285">réplica continua local</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14994_741948_412285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A replication that uses a single server and built-in technology to create and maintain a copy of a storage group on a second set of disks that are connected to the same server as the primary storage group. LCR provides asynchronous log shipping, log replay, and a quick manual switch to a copy of the data.</descrip></descripGrp><ntig><termGrp><term id="741948">LCR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412285">réplica continua local</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14999_397227_412175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hidden section of an email message. From the time a message is first created, information about it is added to the message header, including technical details, such as who created the message and the software used to compose it.</descrip></descripGrp><ntig><termGrp><term id="397227">P2 header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412175">cabeceira P2</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14999_397227_497798"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hidden section of an email message. From the time a message is first created, information about it is added to the message header, including technical details, such as who created the message and the software used to compose it.</descrip></descripGrp><ntig><termGrp><term id="397227">P2 header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497798">cabeceira da mensaxe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14999_80016_412175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hidden section of an email message. From the time a message is first created, information about it is added to the message header, including technical details, such as who created the message and the software used to compose it.</descrip></descripGrp><ntig><termGrp><term id="80016">message header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412175">cabeceira P2</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14999_80016_497798"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hidden section of an email message. From the time a message is first created, information about it is added to the message header, including technical details, such as who created the message and the software used to compose it.</descrip></descripGrp><ntig><termGrp><term id="80016">message header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497798">cabeceira da mensaxe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15_2161198_412221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical grouping of managed folders. When a managed folder mailbox policy is applied to a user’s mailbox, all the managed folders that are linked to the policy are deployed in a single operation, thereby making the deployment of messaging records management (MRM) easier.</descrip></descripGrp><ntig><termGrp><term id="2161198">UM mailbox policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412221">política de caixas de correo con cartafoles xestionados</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15_397203_412221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical grouping of managed folders. When a managed folder mailbox policy is applied to a user’s mailbox, all the managed folders that are linked to the policy are deployed in a single operation, thereby making the deployment of messaging records management (MRM) easier.</descrip></descripGrp><ntig><termGrp><term id="397203">managed folder mailbox policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412221">política de caixas de correo con cartafoles xestionados</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1500_7883_497273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an entity such as the device, program, file, record or portion of the screen that is currently operational or subject to command operations.</descrip></descripGrp><ntig><termGrp><term id="7883">active</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497273">activo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15011_360142_2094554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form that isn't connected to a record source such as a table, query, or SQL statement.</descrip></descripGrp><ntig><termGrp><term id="360142">unbound form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094554">formulario desvinculado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15015_184144_498347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The title for a dialog that specifies how a signature line should be signed, including instructions for signers.</descrip></descripGrp><ntig><termGrp><term id="184144">Signature Setup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498347">configuración de sinatura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15016_398502_1707024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presenter or attendee in a meeting.</descrip></descripGrp><ntig><termGrp><term id="398502">participant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1707024">participante da reunión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15016_747374_1707024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presenter or attendee in a meeting.</descrip></descripGrp><ntig><termGrp><term id="747374">meeting participant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1707024">participante da reunión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15022_319430_1178298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having a frequency in the electromagnetic spectrum in the range just below that of red light.</descrip></descripGrp><ntig><termGrp><term id="319430">infrared</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178298">infravermello</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15024_322622_499025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure of processing power, given in megahertz (MHz).</descrip></descripGrp><ntig><termGrp><term id="322622">clock speed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="499025">velocidade do reloxo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15026_26543_497391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field defined in a query that displays the result of an expression rather than displaying stored data. The value is recalculated each time a value in the expression changes.</descrip></descripGrp><ntig><termGrp><term id="26543">calculated field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497391">campo calculado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15037_36858_497478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To create an object, such as an email message.</descrip></descripGrp><ntig><termGrp><term id="36858">compose</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497478">redactar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15038_415596_2369194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A node with no child objects represented in the tree.</descrip></descripGrp><ntig><termGrp><term id="415596">leaf</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2369194">nó folla</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15038_73880_2369194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A node with no child objects represented in the tree.</descrip></descripGrp><ntig><termGrp><term id="73880">leaf node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2369194">nó folla</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termN