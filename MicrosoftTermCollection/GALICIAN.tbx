s the installation of updates to Windows operating systems by scanning and installing to client systems in a way that permits end user control over the process</descrip></descripGrp><ntig><termGrp><term id="155874">Windows Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1695612">Windows Update</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14622_1961688_1972942"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that calculates (standard and scientific) and converts.</descrip></descripGrp><ntig><termGrp><term id="1961688">Windows Calculator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1972942">Calculadora de Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14622_1961688_2175846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that calculates (standard and scientific) and converts.</descrip></descripGrp><ntig><termGrp><term id="1961688">Windows Calculator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2175846">Calculadora de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammatical