peech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3099855">índice de rotación de inventario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53845_3065536_3099856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A catalog of powerful modules designed to provide a wide range of supply chain solutions.</descrip></descripGrp><ntig><termGrp><term id="3065536">module library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3099856">biblioteca de módulos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53846_3065537_3099857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure of the supplier's ability to deliver goods on time and in full.</descrip></descripGrp><ntig><termGrp><term id="3065537">on time in full</term><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3099857">a tempo e na totalidade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53847_3065538_3099860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An imbalance of the amount of supplies with their demand in the market.</descrip></descripGrp><ntig><termGrp><term id="3065538">supply &amp; demand mismatch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3099860">desequilibrio entre a oferta e a demanda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53848_3065539_3099864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure of potential shortfall or surplus in meeting customer demand.</descrip></descripGrp><ntig><termGrp><term id="3065539">supply coverage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3099864">cobertura do fornecemento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53851_3065644_3065985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A survey for customer service agents to check their satisfaction with their work.</descrip></descripGrp><ntig><termGrp><term id="3065644">ASAT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3065985">ASAT</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></l