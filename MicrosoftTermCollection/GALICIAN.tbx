ote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913630">cable de carga</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34414_1991524_2913631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The slot on the quick charger that holds a battery pack during recharging.</descrip></descripGrp><ntig><termGrp><term id="1991524">compartment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913631">compartimento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34415_1991525_2913632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The charging stand of the Xbox 360 Quick Charge Kit that can hold and recharge up to two rechargeable battery packs concurrently.</descrip></descripGrp><ntig><termGrp><term id="1991525">quick charger</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913632">cargador rápido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34416_1991526_2913633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The controller battery charger that recharges the battery when not in use, and a rechargeable battery pack.</descrip></descripGrp><ntig><termGrp><term id="1991526">Xbox 360 Quick Charge Kit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913633">Kit de carga rápida Xbox 360</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34417_1991527_2588902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The rechargeable battery for the wireless controller or the play &amp; charge kit.</descrip></descripGrp><ntig><termGrp><term id="1991527">battery pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2588902">batería</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34418_1991528_2913634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The controller battery charger that powers the controller battery while in use.</descrip></descripGrp><ntig><termGrp><term id="1991528">Xbox 360 Play &amp; Charge Kit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913634">Kit Carga e Xoga Xbox 360</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34419_1991529_2913655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The audio speaker on the headset.</descrip></descripGrp><ntig><termGrp><term id="1991529">earpiece</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913655">auricular</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34420_1991530_2913657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cable attached to the headset.</descrip></descripGrp><ntig><termGrp><term id="1991530">headset cable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913657">cable dos auriculares</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34421_1991531_2913658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button on the wireless headset used to make a permanent attachment between the headset and console. Connect button acceptable.</descrip></descripGrp><ntig><termGrp><term id="1991531">headset connect button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913658">botón de conexión dos auriculares</term><termNo