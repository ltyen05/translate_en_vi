 type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2710147">enderezo de correo electrónico de traballo ou escolar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48013_2703754_2768511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email address from a user account managed by Microsoft on behalf of organizations that use Azure Active Directory.</descrip></descripGrp><ntig><termGrp><term id="2703754">work or school email address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2768511">correo electrónico de traballo ou escolar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48013_2766685_2710147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email address from a user account managed by Microsoft on behalf of organizations that use Azure Active Directory.</descrip></descripGrp><ntig><termGrp><term id="2766685">work or school email</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2710147">enderezo de correo electrónico de traballo ou escolar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singul