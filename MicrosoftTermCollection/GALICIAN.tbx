Speech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2405172">estilo de título</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42425_2400154_2400540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that lets gamers buy a game once and play it on both their Windows 10 PC and Xbox One console with shared progress, game saves and achievements.</descrip></descripGrp><ntig><termGrp><term id="2400154">Xbox Play Anywhere</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2400540">Xbox Play Anywhere</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42427_2400525_2405191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The StaffHub button that takes users to the screen where they can either create a shift swap request or a shift offer request.</descrip></descripGrp><ntig><termGrp><term id="2400525">Swap or offer shift</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2405191">Trocar ou ofrecer a quenda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42428_2400532_2405188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request from one employee to have another employee take a shift from him/her.</descrip></descripGrp><ntig><termGrp><term id="2400532">shift offer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2405188">oferta de quenda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42429_2400543_2405189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request from one employee to another to trade shifts with each other.</descrip></descripGrp><ntig><termGrp><term id="2400543">shift swap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2405189">troco de quenda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42430_2400558_2405190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The StaffHub view where users can ask another employee to do a shift swap with them.</descrip></descripGrp><ntig><termGrp><term id="2400558">Swap my shift</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2405190">Trocar a miña quenda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Proper