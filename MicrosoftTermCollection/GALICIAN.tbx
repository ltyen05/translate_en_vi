igation Hold.</descrip></descripGrp><ntig><termGrp><term id="2733031">legal hold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2733540">suspensión legal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48333_2733647_2734542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To proactively search for potential security threats and suspicious behavior.​</descrip></descripGrp><ntig><termGrp><term id="2733647">hunt</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2734542">procurar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48334_2733655_2734539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of proactively looking through a complete set of networks for security threats so that they can be isolated and eliminated.</descrip></descripGrp><ntig><termGrp><term id="2733655">cyber threat hunting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2734539">procura de ciberameazas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><