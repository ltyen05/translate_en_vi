m id="498116">CD-RW</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9354_34316_2094417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conflict that results when a client reads data from the server and then attempts to modify that data in a batch update, but before the update attempt is executed, another client changes the original server data.</descrip></descripGrp><ntig><termGrp><term id="34316">collision</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094417">choque</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9355_309006_1178767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The legal agreement between Microsoft and the user, with regard to the terms of use and transfer of software.</descrip></descripGrp><ntig><termGrp><term id="309006">Microsoft Software License Terms</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178767">Termos de licenza do software de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9367_211576_1305888"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A division of a fiscal year that is reflected on financial statements.</descrip></descripGrp><ntig><termGrp><term id="211576">fiscal period</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1305888">período fiscal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9367_227661_1305888"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A division of a fiscal year that is reflected on financial statements.</descrip></descripGrp><ntig><termGrp><term id="227661">accounting period</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1305888">período fiscal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="937_379971_1276385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business location to which resources are assigned. A site is used to ensure that all resources required for a service are in the same physical location.</descrip></descripGrp><ntig><termGrp><term id="379971">site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1276385">sitio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9375_85176_497828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For local area networks (LANs), a device that is connected to the network and is capable of communicating with other network devices.</descrip></descripGrp><ntig><termGrp><term id="85176">node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497828">nó</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="938_584283_498726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar chart subtype that shows the relationship of individual items to the whole.</descrip></descripGrp><ntig><termGrp><term id="584283">stacked bar chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498726">barra amontoada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9391_318770_497519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The † character.</descrip></descripGrp><ntig><termGrp><term id="318770">DAGGER</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497519">cruz</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9391_42062_497519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The † character.</descrip></descripGrp><ntig><termGrp><term id="42062">dagger</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497519">cruz</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9392_60785_1538537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An information structure that precedes and identifies the information that follows.</descrip></descripGrp><ntig><termGrp><term id="60785">header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1538537">cabeceira</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9394_144700_1178768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Used by Microsoft Exchange to identify, locate, and open a form.</descrip></descripGrp><ntig><termGrp><term id="144700">message class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178768">clase de mensaxe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termN