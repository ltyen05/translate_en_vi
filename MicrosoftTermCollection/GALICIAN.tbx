idación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32132_1636625_1638598"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process in which a developer tests an app to make sure it meets app requirements.</descrip></descripGrp><ntig><termGrp><term id="1636625">verification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1638598">verificación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3214_359988_1178167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window that displays data from a table, form, query, view, or stored procedure in a row-and-column format.</descrip></descripGrp><ntig><termGrp><term id="359988">Datasheet view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178167">visualización Folla de datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32145_1637178_1656107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A site template that offers a protected document library for educational institutions where students can discover, acquire, and consume selected content that is subject to digital rights mana