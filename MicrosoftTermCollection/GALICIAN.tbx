ngSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2024 version of Microsoft Office designed for home.</descrip></descripGrp><ntig><termGrp><term id="3161268">Microsoft Office Home 2024</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3164763">Microsoft Office Home 2024</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56224_3161604_3162437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within the inline editing canvas of Designer in Copilot where you can select an object and AI highlights the color to make the object pop and then mutes the color of the rest of the image.</descrip></descripGrp><ntig><termGrp><term id="3161604">color pop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3162437">Resalte de cor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56225_3161605_3162440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Pixel art images are built using pixels as the only building blocks.</descrip></descripGrp><ntig><termGrp><term id="3161605">pixel art</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3162440">arte de píxel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56226_3161606_3162443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that makes an image or photograph look like a watercolor painting.</descrip></descripGrp><ntig><termGrp><term id="3161606">watercolor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3162443">acuarela</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56227_3161607_3162435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Block print technique involves carving a design into wood or linoleum and using that block to print the design onto paper or fabric.</descrip></descripGrp><ntig><termGrp><term id="3161607">block print</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3162435">xilografía</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56228_3161608_3162442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Steampunk images often combine elements of the Victorian era with futuristic technology, including gears, cogs, brass, and steam-powered machinery.</descrip></descripGrp><ntig><termGrp><term id="3161608">steampunk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3162442">steampunk</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56229_3161609_3162436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Claymation images use movable clay characters and are often seen in children's films and cartoons.</descrip></descripGrp><ntig><termGrp><term id="3161609">claymation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3162436">plastimación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56230_3161610_3162434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Art deco images often blends modernity and luxury, creating a glamorous style.</descrip></descripGrp><ntig><termGrp><term id="3161610">art deco</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3162434">Art déco</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56231_3161611_3162438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Low poly images use a limited number of polygons to represent shapes and are characterized by their simplicity and geometric shapes.</descrip></descripGrp><ntig><termGrp><term id="3161611">low poly</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3162438">low poly</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56232_3161612_3162439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Origami style is characterized by its minimalism, geometric shapes and creativity.</descrip></descripGrp><ntig><termGrp><term id="3161612">origami</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3162439">papiroflexia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56233_3161613_3162441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to take 1-2 images/photos and select a style or type a prompt and have your images combined and reimagined, generating an image with a new style.</descrip></descripGrp><ntig><termGrp><term id="3161613">restyle image</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3162441">remodelar imaxe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56234_3161614_3161628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bookable resource which is a container for the child resources who are members of the crew. Crews allow dispatchers to search and schedule multiple resources at once. Resource crews can include a group of employees, subcontractors, equipment, facilities, or any combination thereof who will perform the same work during a period of time. Crews speed up and simplify the scheduling process and allow team members to work together more consistently.</descrip></descripGrp><ntig><termGrp><term id="3161614">crew</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3161628">equipo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56235_3161615_3161670"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool used in Dynamics 365 Field Service to allocate resources, schedule jobs, manage bookings, and visually track various activities over time.</descrip></descripGrp><ntig><termGrp><term id="3161615">schedule board</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3161670">panel de programación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5624_1517462_1707039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window that is displayed when users are participating in a virtual conversation and that displays a list of participants, the conversation content, and the commands and controls for managing the conversation.</descrip></descripGrp><ntig><termGrp><term id="1517462">instant messaging window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1707039">ventá de conversa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5624_418623_1707039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window that is displayed when users are participating in a virtual conversation and that displays a list of participants, the conversation content, and the commands and controls for managing the conversation.</descrip></descripGrp><ntig><termGrp><term id="418623">conversation window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1707039">ventá de conversa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56242_3161706_3166157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-powered feature that determines and selects the optimized view of each person in a meeting room by comparing multiple video sources, such as laptop and room cameras, and selecting the best video view.</descrip></descripGrp><ntig><termGrp><term id="3161706">automatic camera switching​</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3166157">cambio de cámara automático</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56243_3161707_3162477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The AI-powered service in Microsoft Viva that helps individuals track and grow their key job skills, and helps organizations grow and manage talent.</descrip></descripGrp><ntig><termGrp><term id="3161707">Skills in Viva</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3162477">Skills in Viva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56244_3161708_3166177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI demo that works as a feature in Microsoft Priva, connecting to Microsoft Priva products.</descrip></descripGrp><ntig><termGrp><term id="3161708">privacy manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3166177">xestor de privacidade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56246_3161864_3161908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2024 version of Microsoft Access.</descrip></descripGrp><ntig><termGrp><term id="3161864">Microsoft Access 2024</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3161908">Microsoft Access 2024</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56247_3161866_3161992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2024 version of Microsoft Excel.</descrip></descripGrp><ntig><termGrp><term id="3161866">Microsoft Excel 2024</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3161992">Microsoft Excel 2024</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56248_3161867_3162076"><langSet xml:lang="en-US"><descr