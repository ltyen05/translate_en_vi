pe="definition">The API which uses people’s calendars and other constraints to find a good time for those people to meet.</descrip></descripGrp><ntig><termGrp><term id="2514606">Find Meeting Times API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2515670">API de busca de horas para reunións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44665_2514607_2515671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API which surfaces functionality to create, get, update, and delete a user’s tasks.</descrip></descripGrp><ntig><termGrp><term id="2514607">Tasks API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2515671">API de tarefas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44666_2514608_2515674"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API which surfaces functionality to manipulate and send messages, attachments, events, and folders.</descrip></descripGrp><ntig><termGrp><term id="2514608">Office 365 Mail API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2515674">API de correo de Office 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44668_2515502_2519105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The setting (toggle) on account.microsoft.com/family that, when switched on, requires children to get adult permission for the things they buy in the Windows and Xbox stores — except for what they get with gift cards or money in their Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2515502">Ask a parent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2519105">Pedir permiso</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44669_2515503_2519106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of Microsoft Defender Advanced Threat Protection, which helps protect the data in the specified folder locations from modification by suspicious or malicious apps.</descrip></descripGrp><ntig><termGrp><term id="2515503">controlled folder access</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2519106">acceso controlado a carpetas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44670_2515507_2519107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Groove Music that allows the sound in specified frequency bands to be amplified or reduced, in order to adjust the quality and character of the sound.​</descrip></descripGrp><ntig><termGrp><term id="2515507">equalizer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2519107">ecualizador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44671_2515527_2519102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of people who uses or shares a common language or dialect and contributes to language-related activities for Windows features.</descrip></descripGrp><ntig><termGrp><term id="2515527">Language Community</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2519102">Comunidade lingüística</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44672_2515529_2519103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section in the Feedback Hub app where users can organize language-related activities for their Language community.</descrip></descripGrp><ntig><termGrp><term id="2515529">Language Community tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2519103">separador Comunidade lingüística</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44674_2515571_2519104"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of tools that provides data-driven insights that can reduce the cost of deploying, servicing, and supporting Windows 10. It uses telemetry data to provide rich, actionable information to help assess the operational efficiency and health of Windows 10 devices in a user's environment.</descrip></descripGrp><ntig><termGrp><term id="2515571">Windows Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2519104">Windows Analytics</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44676_2515692_2516442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that generates Office 365 reports using SharePoint on-premises diagnostic and usage logs so that administrators can manage their infrastructure more efficiently.</descrip></descripGrp><ntig><termGrp><term id="2515692">SharePoint Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2516442">SharePoint Insights</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44683_2515738_2516437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A voltage regulator that uses an alternating electrical current to provide a continuously variable output voltage.</descrip></descripGrp><ntig><termGrp><term id="2515738">induction voltage regulator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2516437">regulador de indución</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44683_2515738_2516438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A voltage regulator that uses an alternating electrical current to provide a continuously variable output voltage.</descrip></descripGrp><ntig><termGrp><term id="2515738">induction voltage regulator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2516438">regulador de voltaxe de indución</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44683_2515739_2516437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A voltage regulator that uses an alternating electrical current to provide a continuously variable output voltage.</descrip></descripGrp><ntig><termGrp><term id="2515739">induction regulator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2516437">regulador de indución</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44683_2515739_2516438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A voltage regulator that uses an alternating electrical current to provide a continuously variable output voltage.</descrip></descripGrp><ntig><termGrp><term id="2515739">induction regulator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2516438">regulador de voltaxe de indución</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44685_2515779_2516440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A metal-oxide semiconductor field-effect transistor in which the conduction channel is formed by the movement of holes (electron "vacancies" created as electrons move from atom to atom) rather than electrons.</descrip></descripGrp><ntig><termGrp><term id="2515779">p-channel metal-oxide semiconductor field-effect transistor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2516440">transistor de efecto de campo semicondutor de óxido de metal de canal P</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44686_2515780_2516436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An induction voltage regulator which has a primary excitation winding wound on a magnetic core which can be rotated and which also has a stationary secondary winding.</descrip></descripGrp><ntig><termGrp><term id="2515780">1-phase induction voltage regulator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2516436">regulador de voltaxe de indución de 1 fase</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44687_2516154_2519124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform that provides support for business process workflows in SharePoint, and which is either pre-installed in SharePoint or installed separately, depending on the version.</descrip></descripGrp><ntig><termGrp><term id="2516154">Workflow Platform</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2519124">Plataforma de fluxo de traballo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44688_2516155_2519123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that provides support for business process workflows, used by SharePoint and other products.</descrip></descripGrp><ntig><termGrp><term id="2516155">Workflow Manager</term><ter