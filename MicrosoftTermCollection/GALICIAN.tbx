tig><termGrp><term id="3034592">Plataforma do ARDK</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53237_3033416_3034591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application for ARDK users that hosts the system UI, including the application launcher, dock, and task bar.</descrip></descripGrp><ntig><termGrp><term id="3033416">ARDK Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3034591">Inicio do ARDK</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53238_3033417_3034581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application for ARDK users to calibrate their eyes for the eye tracker.</descrip></descripGrp><ntig><termGrp><term id="3033417">ARDK Eye Calibration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3034581">Calibración ocular do ARDK</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53246_3033423_3034588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone application that allows users to submit feedback from their Samsung phone about a problem with their ARDK head-mounted display.</descrip></descripGrp><ntig><termGrp><term id="3033423">ARDK Feedback</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3034588">Comentarios do ARDK</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53247_3033521_3034696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UK bank holiday celebrated on June 3, 2022 to commemorate the 70th anniversary of Queen Elizabeth II's accession to the throne.</descrip></descripGrp><ntig><termGrp><term id="3033521">Platinum Jubilee Bank Holiday</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3034696">Festivo do Xubileo de Platino</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53248_3033522_3033817"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The solution that enables enterprises to easily converge employees with relevant skills necessary to resolve complex cases. It is a structured approach to have a set of SMEs work together to bring a resolution to a complex customer issue.</descrip></descripGrp><ntig><termGrp><term id="3033522">Intelligent swarming</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3033817">Creación intelixente de enxames</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53249_3033523_3033818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of bringing in a team of SMEs from across the organization and working with them to solve complex customer issues.</descrip></descripGrp><ntig><termGrp><term id="3033523">swarm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3033818">enxame</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5325_145206_1178193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To minimize the duplication of information in a relational database through effective table design.</descrip></descripGrp><ntig><termGrp><term id="145206">normalize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178193">organizar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53251_3033532_3034693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Canadian holiday (colloquially known as Orange Shirt Day) celebrated on September 30 to recognize the legacy of the Canadian Indian residential school system.</descrip></descripGrp><ntig><termGrp><term id="3033532">National Day for Truth and Reconciliation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3034693">Día Nacional da Verdade e a Reconciliación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53252_3033536_3034677"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The US federal holiday celebrated on June 19 to commemorate the emancipation of African-American slaves, celebrated on the anniversary of June 19, 1865, the date of the announcement of General Order No. 3 by Union Army general Gordon Granger proclaiming freedom for slaves in Texas, the last state of the Confederacy with institutional slavery.</descrip></descripGrp><ntig><termGrp><term id="3033536">Juneteenth</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3034677">Juneteenth</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53254_3033546_3034689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The day on which the US holiday Juneteenth is celebrated if the official holiday itself falls on a weekend.</descrip></descripGrp><ntig><termGrp><term id="3033546">Juneteenth (Observed)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3034689">Juneteenth (compensado)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53255_3033556_3034618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in the Authenticator app and Edge that allows users to update their password on a website with one click.</descrip></descripGrp><ntig><termGrp><term id="3033556">easy update</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3034618">actualización sinxela</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53256_3033563_3034691"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The bundle of Teams Phone + Microsoft Teams Calling Plans.</descrip></descripGrp><ntig><termGrp><term id="3033563">Microsoft Teams Phone with Calling Plan</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3034691">Teléfono de Microsoft Teams con plan de chamadas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53257_3033564_3034694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The lightweight Android app that delivers the best of Outlook in a small download size and is optimiz