028165_3028327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in the Microsoft 365 Admin Center that provides insights to help IT admins understand how their organization adopts Microsoft 365 recommended practices and shows how Microsoft 365 delivers hybrid workplace value.</descrip></descripGrp><ntig><termGrp><term id="3028165">adoption score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3028327">puntuación de adopción</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53182_3028166_3029385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A session in Teams that allows users to set a timer to work uninterrupted with Microsoft Teams notifications silenced to help them make progress on important tasks in regular intervals, with breaks planned in between.</descrip></descripGrp><ntig><termGrp><term id="3028166">focus session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3029385">sesión de concentración</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53183_3028167_3029382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel feature that provides users with smart suggestions for cleaning their data to make every column in sheets consistent and ready for analysis.</descrip></descripGrp><ntig><termGrp><term id="3028167">Cle