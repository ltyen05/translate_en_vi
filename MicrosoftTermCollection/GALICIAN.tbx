><term id="210451">File as Printout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178667">Ficheiro como impresión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9891_269336_498699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event triggered by Windows system components that is recorded in the system log, such as the failure of a driver or other system component to load during startup.</descrip></descripGrp><ntig><termGrp><term id="269336">system event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498699">evento do sistema</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9900_185600_1374623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that users can select to indicate that they are currently busy.</descrip></descripGrp><ntig><termGrp><term id="185600">Busy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1374623">Ocupado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9911_33170_497447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The » character.</descrip></descripGrp><ntig><termGrp><term id="33170">closing chevron</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497447">comiñas angulares de peche</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9913_234815_498510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item on the Control Panel.</descrip></descripGrp><ntig><termGrp><term id="234815">Solutions to Problems</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498510">Solución de problemas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9928_557811_1305893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an application on Microsoft Dynamics Live CRM and partner-hosted versions of Microsoft Dynamics CRM. Deployments where the Microsoft Dynamics CRM server is maintained for an organization by a third-party, such as Microsoft or a partner.</descrip></descripGrp><ntig><termGrp><term id="557811">hosted</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1305893">aloxado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partO