id="1008_57309_1722399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An index that enables full-text search for a group of managed properties.</descrip></descripGrp><ntig><termGrp><term id="57309">full-text index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1722399">índice de busca de texto completo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10084_106109_2417961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To turn an object so that it is viewed at a different angle.</descrip></descripGrp><ntig><termGrp><term id="106109">rotate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2417961">rotar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10094_157455_498273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive tool that makes it easier to set up commonly used accessibility features by specifying options by type of disability, rather than by numeric value changes.</descrip></descripGrp><ntig><termGrp><term id="157455">Accessibility Wizard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498273">Asistente de accesibilidade</term><termNote type="geographicalUsage">ESP</term