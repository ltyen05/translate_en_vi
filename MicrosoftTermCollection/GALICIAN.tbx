ig></langSet></termEntry><termEntry id="34376_1991486_2913413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cover that protects the hard drive bay in the absence of an attached hard drive.</descrip></descripGrp><ntig><termGrp><term id="1991486">hard drive bay cover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913413">tapa de baía de disco ríxido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34377_1991487_2913416"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The plug that connects the hard drive to the console.</descrip></descripGrp><ntig><termGrp><term id="1991487">hard drive connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913416">conector de disco ríxido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34378_1991488_2913417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The HDMI port on the back of the Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="1991488">HDMI AV port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913417">porto AV HDMI</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34379_1991489_2913421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sensor on the console that receives infrared signals (for example, from a remote control).</descrip></descripGrp><ntig><termGrp><term id="1991489">infrared sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913421">sensor de infravermellos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34380_1991490_2913424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The component on the power supply cord that pulls the right amount of electricity from a wall outlet and converts the AC current to DC current.</descrip></descripGrp><ntig><termGrp><term id="1991490">power supply</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913424">fonte de alimentación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34381_1991491_2913425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The console power supply cable that runs from the power supply to the console.</descrip></descripGrp><ntig><termGrp><term id="1991491">power supply cord</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected<