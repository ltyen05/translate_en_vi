><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49893_2821486_2825719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A threat that originates from outside the company's or organization's network.</descrip></descripGrp><ntig><termGrp><term id="2821486">external threat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2825719">ameaza externa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49894_2821499_2825766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Protection against spam, malware, viruses, phishing attempts, malicious links, and other threats.</descrip></descripGrp><ntig><termGrp><term id="2821499">threat protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2825766">protección contra ameazas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49896_2821551_2825706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 capability that leverages threat intelligence and machine learning algorithms to automatically respond to security incidents.</descrip></descripGrp><ntig><termGrp><term id="2821551">automated incident response</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2825706">resposta automatizada a incidentes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49897_2821557_2825715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A grouping of emails based on similarity of attributes from message headers, body, URLs and attachments.</descrip></descripGrp><ntig><termGrp><term id="2821557">email cluster</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2825715">clúster de correo electrónico</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49898_2821559_2825761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email cluster containing email messages that have similar sender and content attributes.</descrip></descripGrp><ntig><termGrp><term id="2821559">similarity cluster</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2825761">clúster de similitudes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49899_2821564_2825747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email cluster containing email messages that contain the same indicator entity (file hash or URL) as another email.</descrip></descripGrp><ntig><termGrp><term id="2821564">indicator cluster</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2825747">clúster de indicador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49900_2821598_2824626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flow that performs one or more tasks automatically after it is triggered by an event.</descrip></descripGrp><ntig><termGrp><term id="2821598">automated flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2824626">fluxo automatizado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49901_2821600_2824629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flow that performs one or more tasks on a set schedule.</descrip></descripGrp><ntig><termGrp><term id="2821600">scheduled flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2824629">fluxo programado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49902_2821617_2824627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flow that provides a streamlined user experience that leads people through the processes their organization has defined for interactions that need to be advanced to a desired outcome.</descrip></descripGrp><ntig><termGrp><term id="2821617">business process flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2824627">fluxo do proceso de negocio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49903_2821620_2824628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flow in which a user selects a button to run repetitive tasks from any place, at any time, via a mobile device.</descrip></descripGrp><ntig><termGrp><term id="2821620">instant flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2824628">fluxo instantáneo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49904_2821624_2824630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flow in which the flow creator can add other users and groups as owners so that they can execute the flow.</descrip></descripGrp><ntig><termGrp><term id="2821624">team flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2824630">fluxo de equipo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49906_2822727_2824951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The baseline subscription-based offering of Microsoft Project.</descrip></descripGrp><ntig><termGrp><term id="2822727">Project Plan 1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2824951">Project Plan 1</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49907_2822739_2824954"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The subscription-based offering of Microsoft Project that includes the baseline functions (Project Plan 1), plus a desktop client for up to 5 machines and some additional functions such as for reporting and resource management.</descrip></descripGrp><ntig><termGrp><term id="2822739">Project Plan 3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2824954">Project Plan 3</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49908_2822742_2824955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The subscription-based offering of Microsoft Project that includes the features in Project Plan 1 and Project Plan 3 plus some features for managing enterprise-wide resources.</descrip></descripGrp><ntig><termGrp><term id="2822742">Project Plan 5</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2824955">Project Plan 5</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49909_2822865_2824956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Visio online subscription-based offering for creating and sharing simple diagrams in a browser. Includes Visio web app and 2 GB OneDrive storage.</descrip></descripGrp><ntig><termGrp><term id="2822865">Visio Plan 1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2824956">Visio Plan 1</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49910_2822866_2824957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Visio online subscription-based offering for creating professional business and IT diagrams that meet industry standards and can be connected to data. Includes both Visio web and desktop versions.</descrip></descripGrp><ntig><termGrp><term id="2822866">Visio Plan 2</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2824957">Visio Plan 2</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49911_2822924_2840751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The partner benefit program that helps partner companies publish solutions or services on Microsoft AppSource and Azure Marketplace, exposing them to a huge new pool of potential customers.</descrip></descripGrp><ntig><termGrp><term id="2822924">Marketplace Rewards</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2840751">Marketplace Rewards</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49916_2823663_2827199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of dynamically linking a chart to backend data. When the data is updated, the chart is also automatically updated.</descrip></descripGrp><ntig><termGrp><term id="2823663">data linking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2827199">ligazón de datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNot