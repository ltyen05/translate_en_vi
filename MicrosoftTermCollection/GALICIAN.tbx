minine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51491_2905721_2899234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows app that helps users assess the current state of their device on dimensions like battery life, storage, and updates and recommends ways to improve the device's performance or compare with the performance of a new PC.</descrip></descripGrp><ntig><termGrp><term id="2905721">PC Health Check</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2899234">Comprobación do estado do PC de Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51491_2905721_2905995"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows app that helps users assess the current state of their device on dimensions like battery life, storage, and updates and recommends ways to improve the device's performance or compare with the performance of a new PC.</descrip></descripGrp><ntig><termGrp><term id="2905721">PC Health Check</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2905995">Comprobación do estado do PC</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51492_2898944_2899231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To take all actions needed to get a new device or SoC (System on a Chip) ready to successfully boot Windows, with all required drivers loading and functioning properly.</descrip></descripGrp><ntig><termGrp><term id="2898944">bring up</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2899231">preparar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51493_2898945_2899232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows app that can run a variety of manufacturing and hardware tools, tests, and tasks during the OEM device bring-up and manufacturing process.</descrip></descripGrp><ntig><termGrp><term id="2898945">Factory Orchestrator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2899232">Orquestador de fábrica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51505_2899583_2900611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in Microsoft Teams for Education that provides the user with at-a-glance data views to help them monitor their students' Teams activity, including overall digital engagement, assignment turn-in, communication activity, and grade distribution and trends.</descrip></descripGrp><ntig><termGrp><term id="2899583">Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2900611">Insights</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51505_2899583_2949856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in Microsoft Teams for Education that provides the user with at-a-glance data views to help them monitor their students' Teams activity, including overall digital engagement, assignment turn-in, communication activity, and grade distribution and trends.</descrip></descripGrp><ntig><termGrp><term id="2899583">Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2949856">Education Insights</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51505_2949265_2900611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in Microsoft Teams for Education that provides the user with at-a-glance data views to help them monitor their students' Teams activity, including overall digital engagement, assignment turn-in, communication activity, and grade distribution and trends.</descrip></descripGrp><ntig><termGrp><term id="2949265">Education Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2900611">Insights</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51505_2949265_2949856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in Microsoft Teams for Education that provides the user with at-a-glance data views to help them monitor their students' Teams activity, including overall digital engagement, assignment turn-in, communication activity, and grade distribution and trends.</descrip></descripGrp><ntig><termGrp><term id="2949265">Education Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2949856">Education Insights</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51506_2899584_2900618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The video conferencing mode in Microsoft Teams in which participants' video feeds are combined on the screen in such a way as to give the participants the impression that they are all in the same physical space together.</descrip></descripGrp><ntig><termGrp><term id="2899584">Together mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2900618">Modo Xuntos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51507_2899585_2900612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view in Microsoft Teams that allows the user to see up to 49 video feeds at once.</descrip></descripGrp><ntig><termGrp><term id="2899585">Large gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2900612">Galería de gran tamaño</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51508_2899586_2900609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view in Microsoft Teams that allows the user to see up to 9 video feeds at once.</descrip></descripGrp><ntig><termGrp><term id="2899586">Gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2900609">Galería</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51509_2899587_2900614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A billing model wherein an associated payment method is charged automatically over set periods of time.</descrip></descripGrp><ntig><termGrp><term id="2899587">recurring billing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2900614">facturación periódica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="gramm