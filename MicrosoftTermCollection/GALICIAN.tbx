>Microsoft Volume Licensing Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2770218">Servizos do programa das Licenzas por volume de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20386_724609_2770218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The license management Web site for Microsoft volume licensing customers that displays a customer's license status, agreement numbers, online records, and other license information.</descrip></descripGrp><ntig><termGrp><term id="724609">MVLS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2770218">Servizos do programa das Licenzas por volume de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20392_724615_2605388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to Microsoft Volume Licensing Programs, a service provided over the Internet that volume licensing customers may subscribe to.</descrip></descripGrp><ntig><termGrp><term id="724615">online service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2605388">servizo en liña</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20393_724616_2766743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of making the source code (program instructions) for a software product freely available, at no cost, to third parties.</descrip></descripGrp><ntig><termGrp><term id="724616">open source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2766743">código aberto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="204_237285_498557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical bar (think bar charts) displayed in each cell. The length of the bar is related to the cell’s value.</descrip></descripGrp><ntig><termGrp><term id="237285">data bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498557">barra de datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20404_724628_2215215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The prices for a product, license or service.</descrip></descripGrp><ntig><termGrp><term id="724628">pricing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2215215">prezos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2042_166734_3026456"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file containing objects and their associated functions and data that is linked into your application when the executable file is built.</descrip></descripGrp><ntig><termGrp><term id="166734">static library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3026456">biblioteca estática</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2043_87960_497850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In mathematics, an action performed on a set of entities that produces a new entity. Examples of mathematical operations are addition and subtraction.</descrip></descripGrp><ntig><termGrp><term id="87960">operation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497850">operación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20436_724668_2802190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual or organization that carries out work on behalf of another company or person.</descrip></descripGrp><ntig><termGrp><term id="724668">subcontractor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2802190">subcontratista</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2046_61898_1178157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A successful retrieval of a record matching a query.</descrip></descripGrp><ntig><termGrp><term id="61898">hit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178157">resultado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20463_1666780_1676115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information provided with a product by a manufacturer describing how to use a product.</descrip></descripGrp><ntig><termGrp><term id="1666780">documentation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1676115">documentación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20463_2666668_1676115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 