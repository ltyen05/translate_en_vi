ntig><termGrp><term id="3006345">Rede Xbox</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34327_3005788_2400539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox online brand gaming and entertainment network.</descrip></descripGrp><ntig><termGrp><term id="3005788">Xbox network</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2400539">Xbox Live</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34327_3005788_3006345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox online brand gaming and entertainment network.</descrip></descripGrp><ntig><termGrp><term id="3005788">Xbox network</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3006345">Rede Xbox</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34328_1991438_2913303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Games and other applications that are served and run directly from the Xbox Live service, typically with an additional fee to play.</descrip></descripGrp><ntig><termGrp><term id="1991438">Arcade</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913303">Arcade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34329_1991439_2913305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Games that are created by the Xbox community and downloaded from the Xbox Live service, typically with a fee to play the full game.</descrip></descripGrp><ntig><termGrp><term id="1991439">Indie Games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913305">Xogos indie</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3433_40323_1689069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In telephony, the one-, two-, or three-character sequence that represents the country/region being called.</descrip></descripGrp><ntig><termGrp><term id="40323">country code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1689069">indicativo do país</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34330_1991440_2913308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of Xbox Live that caters to a particular style of gameplay. Four zones exist: pro, recreation, family, and underground.</descrip></descripGrp><ntig><termGrp><term id="1991440">Xbox Live Gamer Zone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913308">Zona de xogo Xbox Live</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34331_1991441_2913319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of players on Xbox Live that can play games and chat together.</descrip></descripGrp><ntig><termGrp><term id="1991441">Xbox Live Party</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913319">Grupo de Xbox Live</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34333_1991443_2588986"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Brand name of the games offering from Xbox.</descrip></descripGrp><ntig><termGrp><term id="1991443">Xbox Games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2588986">Xbox Games</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34335_1991445_2589003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for Windows 8, Windows Phone, and other portable devices that connects phones, PCs, and tablets with your Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="1991445">Xbox SmartGlass</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2589003">Xbox SmartGlass</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34335_1991445_2589004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for Windows 8, Windows Phone, and other portable devices that connects phones, PCs, and tablets with your Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="1991445">Xbox SmartGlass</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2589004">Compañeiro Xbox SmartGlass</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34335_2432221_2589003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for Windows 8, Windows Phone, and other portable devices that connects phones, PCs, and tablets with your Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="2432221">Xbox SmartGlass Companion</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2589003">Xbox SmartGlass</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34335_2432221_2589004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for Windows 8, Windows Phone, and other portable devices that connects phones, PCs, and tablets with your Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="2432221">Xbox SmartGlass Companion</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2589004">Compañeiro Xbox SmartGlass</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34337_1991447_2913321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live account.</descrip></descripGrp><ntig><termGrp><term id="1991447">membership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913321">afiliación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34338_1991448_2913330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Code used to restrict access, entered using a combination of controller button and trigger presses.</descrip></descripGrp><ntig><termGrp><term id="1991448">passcode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913330">código de acceso</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34339_1991449_2913332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live account security feature in which Xbox sends a one-time code to a customer's preference of contact options (email, text message, or phone), allowing them to return the code to verify their identity.</descrip></descripGrp><ntig><termGrp><term id="1991449">security check</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913332">comprobación de seguranza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34340_1991450_2913338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a transaction in which Microsoft Points are exchanged.</descrip></descripGrp><ntig><termGrp><term id="1991450">redeem</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913338">trocar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34341_1991451_2913340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To extend an Xbox Live membership.</descrip></descripGrp><ntig><termGrp><term id="1991451">renew</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913340">renovar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34342_1991452_2913341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Membership code that is purchased or won through offers, contests, events, and so on.</descrip></descripGrp><ntig><termGrp><term id="1991452">Xbox Live code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913341">código de Xbox Live</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34344_1991454_2913347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Basic level of Xbox Live membership.</descrip></descripGrp><ntig><termGrp><term id="1991454">Xbox Live Free membership</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913347">afiliación gratuita a Xbox Live</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34345_1991455_2913348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The controller-free gaming experience from Xbox.</descrip></descripGrp><ntig><termGrp><term id="1991455">Kinect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913348">Kinect</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_1991456_2175829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="1991456">Kinect sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2175829">sensor Kinect</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_1991456_2914483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="1991456">Kinect sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2914483">sensor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_2013412_2175829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="2013412">sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2175829">sensor Kinect</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_2013412_2914483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="2013412">sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2914483">sensor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34347_1991457_2913349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The automatic angle adjustment function of the Kinect sensor.</descrip></descripGrp><ntig><termGrp><term id="1991457">auto-tilt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913349">inclinación automática</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34348_1991458_2913350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The infrared camera component of the Kinect sensor.</descrip></descripGrp><ntig><termGrp><term id="1991458">depth sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913350">sensor de profundidade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34349_1991459_2913351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The RGB camera component of the Kinect sensor.</descrip></descripGrp><ntig><termGrp><term id="1991459">video sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913351">sensor de vídeo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34350_1991460_2913354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The entire area that the sensor can "see," including walls, furniture, and other obstructions.</descrip></descripGrp><ntig><termGrp><term id="1991460">field of view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913354">campo de visión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34351_1991461_2588949"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area within the Kinect sensor's field of view is able to detect a person or in which a player moves.</descrip></descripGrp><ntig><termGrp><term id="1991461">play space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2588949">área de xogo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34352_1991462_2913356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Facial identification used by the sensor to recognize a player.</descrip></descripGrp><ntig><termGrp><term id="1991462">facial recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913356">recoñecemento facial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34353_1991463_2913357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A motion made by a player that's intended to be tracked by the sensor.</descrip></descripGrp><ntig><termGrp><term id="1991463">gesture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913357">xesto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34354_1991464_2913358"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In-game gesture that invokes the Kinect Guide.</descrip></descripGrp><ntig><termGrp><term id="1991464">guide gesture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913358">xesto de guía</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34355_1991465_2913359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Biometric recognition of a player by the system, through the use of the Kinect sensor and software.</descrip></descripGrp><ntig><termGrp><term id="1991465">Kinect ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913359">ID de Kinect</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34356_1991466_2913361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual progress indicator that appears in the corner of the screen when a player performs the guide gesture. Because the icon is only visible when cued by the guide gesture, use only when necessary to specifically call out its functionality, as in an instructional demo, for example.</descrip></descripGrp><ntig><termGrp><term id="1991466">guide icon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913361">icona de guía</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34357_1991467_2913362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The icon that appears when a player is detected in the play space, prompting a wave to engage with Kinect. Once engaged, a hand pointer appears, which serves as a mechanism for navigation and object manipulation.</descrip></descripGrp><ntig><termGrp><term id="1991467">hand icon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913362">icona de man</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34358_1991468_2913363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The icon that is present when the Kinect microphone is available to accept voice commands.</descrip></descripGrp><ntig><termGrp><term id="1991468">microphone icon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913363">icona de micrófono</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34359_1991469_2913365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Spoken input that's intended to be received and interpreted by the sensor as input.</descrip></descripGrp><ntig><termGrp><term id="1991469">speech</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913365">voz</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34360_1991470_2913367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The detection and following of a person's movements by the sensor.</descrip></descripGrp><ntig><termGrp><term id="1991470">tracking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913367">seguimento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34361_1991471_2913371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Vocal input that's used by the sensor to identify a player.</descrip></descripGrp><ntig><termGrp><term id="1991471">voice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913371">voz</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34362_1991472_2913373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The panel that appears in the Xbox Dashboard when the Kinect sensor recognizes the voice command "Xbox".</descrip></descripGrp><ntig><termGrp><term id="1991472">voice bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913373">barra de voz</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34363_1991473_2913376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Video communication with another player on Xbox Live, using the Kinect sensor. Formerly video chat.</descrip></descripGrp><ntig><termGrp><term id="1991473">Video Kinect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913376">Video Kinect</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34364_1991474_2913378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect based guide that appears over a game and allows for social interactions (friends, invites, chat, etc.).</descrip></descripGrp><ntig><termGrp><term id="1991474">Kinect Guide</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913378">Guía de Kinect</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34365_1991475_2913379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect based troubleshooter that helps users with common problems related to the play space, lighting, speech/audio, setup, and hardware errors.</descrip></descripGrp><ntig><termGrp><term id="1991475">Kinect Tuner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913379">Configurador de Kinect</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34366_1991476_2913380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Disc used for playing games.</descrip></descripGrp><ntig><termGrp><term id="1991476">game disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913380">disco de xogo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34367_1991477_2913381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a permanent attachment between a wireless