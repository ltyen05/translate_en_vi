Grp><term id="2110522">Exchange Online (Plan 2) (Government Pricing)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2147613">Exchange Online (Plan 2) (Prezos para a Administración pública)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37232_2110523_2147965"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SharePoint Online (Plan 1) offer for government organizations that is hosted in the commercial cloud environment.</descrip></descripGrp><ntig><termGrp><term id="2110523">SharePoint Online (Plan 1) (Government Pricing)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2147965">SharePoint Online (Plan 1) (Prezos para a Administración pública)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37233_2110524_2147967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SharePoint Online (Plan 2) offer for government organizations that is hosted in the commercial cloud environment.</descrip></descripGrp><ntig><termGrp><term id="2110524">SharePoint Online (Plan 2) (Government Pricing)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2147967">SharePoint Online (Plan 2) (Prezos para