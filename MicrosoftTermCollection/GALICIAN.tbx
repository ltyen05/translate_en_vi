="en-US"><descripGrp><descrip type="definition">The security solution designed to safeguard end-to-end communication and collaboration for organizations using Microsoft tools like Teams and Outlook.</descrip></descripGrp><ntig><termGrp><term id="3126502">Defender for Collaboration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3126580">Defender para a colaboración</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55154_3126502_3126582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security solution designed to safeguard end-to-end communication and collaboration for organizations using Microsoft tools like Teams and Outlook.</descrip></descripGrp><ntig><termGrp><term id="3126502">Defender for Collaboration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3126582">Microsoft Defender para a colaboración</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55155_3126610_3127115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-powered model used in Dynamics 365 Marketing that provides users with a feedback loop to gain a comprehensive view of the effectiveness of their real-time marketing tactics in driving key business outcomes, empowering them to optimize their marketing mix by learning from tactics that worked well and improving or dropping tactics that didn’t.</descrip></descripGrp><ntig><termGrp><term id="3126610">attribution model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3127115">modelo de atribución</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55156_3126611_3127117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hub to manage consent and compliance in Dynamics 365 Marketing. Compliance profiles govern how consent is captured and enforced, as well as store information such as company address, the preference management experience, and related configuration.</descrip></descripGrp><ntig><termGrp><term id="3126611">compliance profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3127117">perfil de cumprimento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55157_3126612_3127118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Dynamics 365 Marketing that helps users analyze event data through a broad overview of the event planning activities and results from all their events, and event records for one event to see results and analytics that relate to that event only.</descrip></descripGrp><ntig><termGrp><term id="3126612">event analytics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3127118">análises de eventos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55158_3126613_3127119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets users set a limit on the number of messages their customers receive in a given amount of time through a particular channel in real-time marketing journeys.</descrip></descripGrp><ntig><termGrp><term id="3126613">frequency cap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3127119">límite de frecuencia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55159_3126614_3127120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template available in Dynamics 365 Marketing to quickly create a new customer journey or reuse an existing customer journey structure as a starting point for future campaigns.</descrip></descripGrp><ntig><termGrp><term id="3126614">journey template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3127120">modelo de viaxe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55160_3126615_3127121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in Dynamics 365 Marketing that allows users to define key customer milestones, measure them over time, and assess the contribution and effectiveness of their journeys, channels, and marketing assets in driving customers to the milestones.</descrip></descripGrp><ntig><termGrp><term id="3126615">marketing effectiveness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3127121">eficacia do márketing</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55161_3126616_3127122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An inbound communication channel that allows your customers to register for newsletters, ask for quotations, etc. The form is defined by a set of input fields arranged into a form layout.</descrip></descripGrp><ntig><termGrp><term id="3126616">marketing form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3127122">formulario de márketing</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55162_3126617_3127123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A center in real-time marketing that allows users to provide customers with branded experiences to sign up for communications and fine-tune their preferences to ensure they receive the right communications.</descrip></descripGrp><ntig><termGrp><term id="3126617">preference center</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3127123">centro de preferencias</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55163_3126618_3127124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that is visibly present at the event, and features a sponsor's logo or message. These typically include small freebies given away to event attendees, but could also be some type of infrastructure or facility provided to event-goers.</descrip></descripGrp><ntig><termGrp><term id="3126618">sponsorable article</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3127124">artigo que se pode patrocinar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55164_3126700_3128069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dedicated Microsoft Edge experience built for work that enables admins in organizations to give their users a productive and secure work browser across managed and unmanaged devices.</descrip></descripGrp><ntig><termGrp><term id="3126700">Microsoft Edge for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3128069">Microsoft Edge para negocios</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55165_3126701_3128068"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The directory service that provides authentication, authorization, and password management for Microsoft Windows networks.</descrip></descripGrp><ntig><termGrp><term id="3126701">Microsoft Entra Domain Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3128068">Servizos de dominio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55165_3126701_3128072"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The directory service that provides authentication, authorization, and password management for Microsoft Windows networks.</descrip></descripGrp><ntig><termGrp><term id="3126701">Microsoft Entra Domain Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3128072">Servizos de dominio de Microsoft Entra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55165_3126702_3128068"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The directory service that provides authentication, authorization, and password management for Microsoft Windows networks.</descrip></descripGrp><ntig><termGrp><term id="3126702">Domain Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3128068">Servizos de dominio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55165_3126702_3128072"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The directory service that provides authentication, authorization, and password management for Microsoft Windows networks.</descrip></descripGrp><ntig><termGrp><term id="3126702">Domain Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3128072">Servizos de dominio de Microsoft Entra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55166_3126703_3128074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows service responsible for managing updates in the background, handling downloads, installations, and the maintenance of updates on the user's computer.</descrip></descripGrp><ntig><termGrp><term id="3126703">Update Orchestrator Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3128074">Servizo de orquestador de actualizacións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55167_3127754_3128256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams add-on license that allows offices to designate devices as shared devices, including common area phones, Teams displays for hot-desks, and Teams panels for meeting spaces.</descrip></descripGrp><ntig><termGrp><term id="3127754">Microsoft Teams Shared Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3128256">Dispositivos compatidos de Microsoft Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55167_3127754_3128258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams add-on license that allows offices to designate devices as shared devices, including common area phones, Teams displays for hot-desks, and Teams panels for meeting spaces.</descrip></descripGrp><ntig><termGrp><term id="3127754">Microsoft Teams Shared Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3128258">Dispositivos compartidos de Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55167_3127759_3128256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams add-on license that allows offices to designate devices as shared devices, including common area phones, Teams displays for hot-desks, and Teams panels for meeting spaces.</descrip></descripGrp><ntig><termGrp><term id="3127759">Teams Shared Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3128256">Dispositivos compatidos de Microsoft Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55167_3127759_3128258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams add-on license that allows offices to designate devices as shared devices, including common area phones, Teams displays for hot-desks, and Teams panels for meeting spaces.</descrip></descripGrp><ntig><termGrp><term id="3127759">Teams Shared Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3128258">Dispositivos compartidos de Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55168_3127764_3127792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control used to incrementally adjust a value in small steps. It’s mainly used for numeric values, but other values are supported too.</descrip></descripGrp><ntig><termGrp><term id="3127764">spin button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3127792">botón de axuste</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55169_3127765_3127793"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of work items that can help decouple different areas of a process allowing each part to operate independently and exchange prioritized inputs and outputs asynchronously.</descrip></descripGrp><ntig><termGrp><term id="3127765">work queue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3127793">fila de traballo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55170_3127858_3128255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft Viva Goals, to pass on OKRs from one level to the next, allowing employees and teams to see how their work directly contributes to the ultimate goals of their organization.</descrip></descripGrp><ntig><termGrp><term id="3127858">cascade</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3128255">amosar en cadoiro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55171_3128244_3128877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service in Windows, available through Azure, that adds digital signatures to application binaries and packages, and thereby providing security promises of authenticity and integrity used to establish trust in software that you are distributing.</descrip></descripGrp><ntig><termGrp><term id="3128244">Trusted Signing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3128877">Sinatura de confianza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55172_3128313_3128875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Intune that allows users to refresh a device's configuration.</descrip></descripGrp><ntig><termGrp><term id="3128313">Config Refresh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3128875">Actualización da configuración</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55173_3128440_3128876"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of NFTs, crypto currencies, and other Web 3 properties that the user keeps in their Microsoft Wallet.</descrip></descripGrp><ntig><termGrp><term id="3128440">crypto 