ng="en-US"><descripGrp><descrip type="definition">Software that secures, monitors, manages, and supports mobile devices deployed across mobile operators, service providers, and enterprises.</descrip></descripGrp><ntig><termGrp><term id="2042111">MDM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2064554">xestión de dispositivos móbiles</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35592_2042112_2046819"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A partially completed diagram that includes shapes and tips to help the user get started in Visio. A user can select from three diagrams at startup.</descrip></descripGrp><ntig><termGrp><term id="2042112">Starter Diagram</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2046819">Diagrama inicial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35606_2042664_2046811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that manages the ability to share various components of the Office 365 site (such as Outlook calendars, SharePoint sites, and Lync meetings) with visitors or external users.</descrip></descripGrp><ntig><termGrp><term id="2042664">External sharing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2046811">Uso compartido externo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35607_2042666_2046816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that renders a PDF document as a single or series of pictures in a page.</descrip></descripGrp><ntig><termGrp><term id="2042666">PDF Render</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2046816">Procesamento de PDF</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35608_2042671_2046817"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables IT administrators to move Personal Folders files (.pst) to a mailbox in Office 365. A .pst file is a data file that stores your messages and other items on your computer.</descrip></descripGrp><ntig><termGrp><term id="2042671">PST import</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2046817">importación de PST</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35609_2106333_2107557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription for nonprofit organizations that need communication and collaboration tools and the ability to read and do lightweight editing of documents with the Office Online.</descrip></descripGrp><ntig><termGrp><term id="2106333">Office 365 Nonprofit E1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2107557">Office 365 Nonprofit E1</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3561_168804_1688801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows a user to share documents or applications with others. The user can also choose to give another person control of an application or the user's computer.</descrip></descripGrp><ntig><termGrp><term id="168804">application sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1688801">uso compartido de aplicacións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35610_2106334_2107558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription for nonprofit organizations ​that is the best plan for nonprofit organizations that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Online.</descrip></descripGrp><ntig><termGrp><term id="2106334">Office 365 Nonprofit E3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2107558">Office 365 Nonprofit E3</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35612_2042970_2064547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to select specific fields for an entity (record type) and specify how they should synchronize between CRM and Exchange, either in both ways or in one direction (from CRM to Exchange or from Exchange to CRM).</descrip></descripGrp><ntig><termGrp><term id="2042970">field-level synchronization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2064547">sincronización a nivel de campo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35613_2043345_2064556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for the button on the app bar that affixes a tile to your Home screen.</descrip></descripGrp><ntig><termGrp><term id="2043345">Pin to Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2064556">Fixar na pantalla de benvida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35614_2043468_2064550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An out-of-the-box attribute that can be exported, translated into a specified language, and then imported back into CRM.</descrip></descripGrp><ntig><termGrp><term id="2043468">localizable field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2064550">campo localizable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35616_2043469_2064559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Status shown for a task that is assigned in Outlook and tracked in CRM, where the task assignment is declined, and the assigner of the task reassigns the task back to himself or herself.</descrip></descripGrp><ntig><termGrp><term id="2043469">Reclaimed</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2064559">Reclamada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35617_2043470_2064546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In telecommunications, a callback occurs when the originator of a call is immediately called back in a second call as a response.</descrip></descripGrp><ntig><termGrp><term id="2043470">callback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2064546">devolución de chamada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35620_2043673_2064564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in document management where you can store your documents in SharePoint and access them from Microsoft Dynamics CRM.</descrip></descripGrp><ntig><termGrp><term id="2043673">server-based SharePoint integration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2064564">integración de SharePoint baseada en servidor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35621_2044156_2064558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A configuration file that defines how web browsers and other user agents can automatically choose the appropriate proxy server (access method) for fetching a given URL.</descrip></descripGrp><ntig><termGrp><term id="2044156">proxy auto-config file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2064558">ficheiro de configuración automática de proxy</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote 