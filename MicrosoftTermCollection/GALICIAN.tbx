ork regions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1787173">rexións da rede</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33068_1747457_1787193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Provides presence information and helps to manage preferences.</descrip></descripGrp><ntig><termGrp><term id="1747457">User Services pool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1787193">Grupo de servizos do usuario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33071_1747983_1787175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collections of subnets with similar bandwidth, for example, a branch office location, a set of buildings, or a campus.</descrip></descripGrp><ntig><termGrp><term id="1747983">network site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1787175">nó da rede</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33072_1748196_1764173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Defines bandwidth limitations between sites that are directly linked within a call admission control (CAC) configuration.</descrip></descripGrp><ntig><termGrp><term id="1748196">network inter-site policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1764173">política entre sitios en rede</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33075_1749609_1787116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that enables internal users to share audio and video data with external users.</descrip></descripGrp><ntig><termGrp><term id="1749609">A/V Edge server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1787116">Servidor Edge A/V</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33077_1752711_1773752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Lync Server service that is used to help maintain presence information for users and to manage meetings and conferences.</descrip></descripGrp><ntig><termGrp><term id="1752711">User Services service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1773752">servizo de Servizos de usuario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33079_1752868_1755966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A website that provides tools and resources to help developers create apps for Office and SharePoint.</descrip></descripGrp><ntig><termGrp><term id="1752868">Apps for Office and SharePoint Developer Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1755966">Aplicacións para Office e SharePoint Developer Center</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33079_2285292_1755966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A website that provides tools and resources to help developers create apps for Office and SharePoint.</descrip></descripGrp><ntig><termGrp><term id="2285292">Office and SharePoint Add-in Developer Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1755966">Aplicacións para Office e SharePoint Developer Center</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33080_1752880_1759739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Business Connectivity Services feature that enables developers to extend functionality that is 