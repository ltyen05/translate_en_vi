Number">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3100446">chamadas compartidas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54565_3100234_3100451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams meetings that allows participants to augment their video stream with visual effects, such as make up, styles and frames.</descrip></descripGrp><ntig><termGrp><term id="3100234">video filters</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3100451">filtros de vídeo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54566_3100235_3100450"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides a personal meeting stage configuration that keeps sign language interpreters and other signers in a consistent, central location with the highest available video quality throughout the meeting.</descrip></descripGrp><ntig><termGrp><term id="3100235">sign language view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3100450">vista da lingua de signos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSe