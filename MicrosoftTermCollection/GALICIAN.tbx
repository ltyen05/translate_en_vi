ripGrp><descrip type="definition">A character with a non-zero width.</descrip></descripGrp><ntig><termGrp><term id="166282">spacing character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498296">carácter de espazamento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9432_209994_498372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rectangular array of pixels applied to a visual object.</descrip></descripGrp><ntig><termGrp><term id="209994">texture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498372">textura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9433_179566_498320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common drop-down menu that includes general purpose commands for editing objects displayed within a window, such as Cut, Copy, and Paste.</descrip></descripGrp><ntig><termGrp><term id="179566">Edit menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498320">menú Editar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></l