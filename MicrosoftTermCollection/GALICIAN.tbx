</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="317_141660_498175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML vocabulary that is used to transform XML data to another form, such as HTML, by means of a style sheet that defines presentation rules.</descrip></descripGrp><ntig><termGrp><term id="141660">XSL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498175">XSL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3170_783225_2016254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A touch-sensitive screen on your device that can recognize the location of a touch (of a fingertip or stylus, for example) on its surface and translate that touch into a desired action (such as opening an item or moving the cursor).</descrip></descripGrp><ntig><termGrp><term id="783225">touchscreen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2016254">pantalla táctil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31700_1612766_1647538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To purchase an app after downloading, install