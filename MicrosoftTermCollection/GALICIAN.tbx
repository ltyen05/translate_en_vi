ip></descripGrp><ntig><termGrp><term id="140165">data record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178823">rexistro de datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15254_1986304_1992336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to provide input through the screen by using a finger or a pen.</descrip></descripGrp><ntig><termGrp><term id="1986304">touch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1992336">funcionalidade táctil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15254_276552_1992336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to provide input through the screen by using a finger or a pen.</descrip></descripGrp><ntig><termGrp><term id="276552">touch input</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1992336">funcionalidade táctil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15255_14930_497314"><langSet xml