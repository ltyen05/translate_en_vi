pports real-time synchronization for users who are editing the same page.</descrip></descripGrp><ntig><termGrp><term id="1788117">Notebook Presence</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1790808">Presenza de usuarios de cadernos de notas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33504_1788118_1790855"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online meeting for teaching and collaboration pertaining to a particular lesson.</descrip></descripGrp><ntig><termGrp><term id="1788118">virtual classroom</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1790855">aula virtual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33505_1788119_1790829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tab on the Office ribbon that contains language and proofing tools, change tracking and markup options, and other features related to document review.</descrip></descripGrp><ntig><termGrp><term id="1788119">Review tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1790829">separador Revisar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="gra