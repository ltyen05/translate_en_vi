ila maior</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55679_3183004_3185462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of storing multidimensional arrays in memory where the elements of each row are stored contiguously.</descrip></descripGrp><ntig><termGrp><term id="3183004">row-major order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3185462">orde de fila maior</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5568_270269_1178195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to share items such as documents or folders with other devices on a layered communications network that operate on the same protocol level.</descrip></descripGrp><ntig><termGrp><term id="270269">People Near Me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178195">Persoas ao meu redor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55803_3149759_3150339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows players to quickly find the people they want to play with –frie