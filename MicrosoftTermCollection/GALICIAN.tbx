67035">restaurar o computador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33278_1764509_1767044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reset a system so that all user customizations are removed.</descrip></descripGrp><ntig><termGrp><term id="1764509">reset your PC</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1767044">restablecer o computador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33281_1764780_1767047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service run by the Windows Store team that supports the end-to-end process for registering Windows Store developers and onboarding apps into the Windows Store catalog.</descrip></descripGrp><ntig><termGrp><term id="1764780">dashboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1767047">panel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33281_1764780_1997055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service run by the Windows Store team that supports the end-to-end process for registering Windows Store developers and onboarding apps into the Windows Store catalog.</descrip></descripGrp><ntig><termGrp><term id="1764780">dashboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1997055">panel de Windows Store</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33282_1764781_1978147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that slows down the speed of panning from a user interaction.</descrip></descripGrp><ntig><termGrp><term id="1764781">speed bump</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1978147">pausa de desprazamento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33288_1764988_1767030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that allows customers to finalize their purchase on a website.</descrip></descripGrp><ntig><termGrp><term id="1764988">Checkout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1767030">Finalizar compra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntr