ion">A container in Resource Manager that holds related resources for an application. The resource group can include all of the resources for an application, or only those resources that are logically grouped together.</descrip></descripGrp><ntig><termGrp><term id="2137967">resource group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2365952">grupo de recursos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37463_2138009_2802185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication mechanism to configure access control based on role claims contained in the authentication token.</descrip></descripGrp><ntig><termGrp><term id="2138009">role-based access control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2802185">control de acceso baseado en funcións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37463_2138010_2802185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication mechanism to configure access control based on role claims contained in the authentication token.</descrip></descripGrp><ntig><termGrp><term id="2138010">RBAC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2802185">control de acceso baseado en funcións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37465_2138907_2175759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The result of projecting an image onto a cylinder.</descrip></descripGrp><ntig><termGrp><term id="2138907">cylindrical projection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2175759">proxección cilíndrica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37466_2138908_2176183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The result of projecting an image onto a flat surface.</descrip></descripGrp><ntig><termGrp><term id="2138908">planar projection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2176183">proxección plana</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37467_2138909_2176259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The result of projecting an image onto a sphere.</descrip></descripGrp><ntig><termGrp><term id="2138909">spherical projection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2176259">proxección esférica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37468_2138910_2176234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The resulting 3D mesh containing color information.</descrip></descripGrp><ntig><termGrp><term id="2138910">scan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2176234">dixitalización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37469_2138911_2176094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To close a hole in a 3D model with a patching surface or plane.</descrip></descripGrp><ntig><termGrp><term id="2138911">patch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2176094">aplicar parche</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37470_2138912_2176204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode in which the user can manipulate a 3D object by rotating it.</descrip></descripGrp><ntig><termGrp><term id="2138912">rotate mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatica