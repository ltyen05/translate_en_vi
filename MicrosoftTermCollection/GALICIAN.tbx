619927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The auto chat moderation tool in Mixer that looks at the context of messages people are sending and “snipes” content the user finds inappropriate before it hits their channel. Users can preview messages removed, and report inaccuracies.</descrip></descripGrp><ntig><termGrp><term id="2619590">Catbot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2619927">Catbot</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46550_2619604_2649051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-release version of an offering for select customers instead of all customers.</descrip></descripGrp><ntig><termGrp><term id="2619604">private preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2649051">versión preliminar privada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46554_2671644_2672733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that analyzes clients' usage, provides recommendations on how to configure features in a way that reduces the attack surface without interrupting critical workflows, and that provides supporting data on feature usage and security risk.</descrip></descripGrp><ntig><termGrp><term id="2671644">Security Policy Advisor</term><termNo