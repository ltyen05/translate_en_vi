tion">The proprietary protocol to provide remote display and input capabilities over network connections for Windows-based applications between two computers.</descrip></descripGrp><ntig><termGrp><term id="269326">Remote Desktop Protocol</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498694">RDP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8595_269327_498693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The proprietary protocol to provide remote display and input capabilities over network connections for Windows-based applications between two computers.</descrip></descripGrp><ntig><termGrp><term id="269327">RDP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498693">Protocolo de escritorio remoto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8595_269327_498694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The proprietary protocol to provide remote display and input capabilities over network connections for Windows-based applications between two computers.</descrip></descripGrp><ntig><termGrp><term id="269327">RDP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498694">RDP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8600_37568_497483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of an action or operation that takes place based on whether or not a certain condition is true.</descrip></descripGrp><ntig><termGrp><term id="37568">conditional</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497483">condicional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8609_2856023_2572916"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any of a family of processes that software developers use to minimize risk by developing applications incrementally, over a series of short iterations. In this model, real-time communications, such as in person conversations and telephone calls, are preferred over written documentation; the primary measure of progress is working software, instead of hours spent, tasks completed, documents reviewed, or phases signed-off; stakeholders are expected to collaborate, instead of negotiating; and planning happens continuously in order to respond to change.</descrip></descripGrp><ntig><termGrp><term id="2856023">Agile methodology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2572916">método áxil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8609_2856023_2856557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any of a family of processes that software developers use to minimize risk by developing applications incrementally, over a series of short iterations. In this model, real-time communications, such as in person conversations and telephone calls, are preferred over written documentation; the primary measure of progress is working software, instead of hours spent, tasks completed, documents reviewed, or phases signed-off; stakeholders are expected to collaborate, instead of negotiating; and planning happens continuously in order to respond to change.</descrip></descripGrp><ntig><termGrp><term id="2856023">Agile methodology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2856557">metodoloxía áxil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8609_460694_2572916"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any of a family of processes that software developers use to minimize risk by developing applications incrementally, over a series of short iterations. In this model, real-time communications, such as in person conversations and telephone calls, are preferred over written documentation; the primary measure of progress is working software, instead of hours spent, tasks completed, documents reviewed, or phases signed-off; stakeholders are expected to collaborate, instead of negotiating; and planning happens continuously in order to respond to change.</descrip></descripGrp><ntig><termGrp><term id="460694">Agile method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2572916">método áxil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8609_460694_2856557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any of a family of processes that software developers use to minimize risk by developing applications incrementally, over a series of short iterations. In this model, real-time communications, such as in person conversations and telephone calls, are preferred over written documentation; the primary measure of progress is working software, instead of hours spent, tasks completed, documents reviewed, or phases signed-off; stakeholders are expected to collaborate, instead of negotiating; and planning happens continuously in order to respond to change.</descrip></descripGrp><ntig><termGrp><term id="460694">Agile method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2856557">metodoloxía áxil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8612_173657_1950092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Application software that gathers data from the user, prepares it for the server, and issues a request to the server. The client presents data received from the server to the user through its own user interface.</descrip></descripGrp><ntig><termGrp><term id="173657">client application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950092">aplicación cliente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8614_358362_363200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item in the Exchange store that represents an appointment, a meeting, a meeting request, or an event. It can identify the place, resources, recurrence, and attendees involved at a discrete time.</descrip></descripGrp><ntig><termGrp><term id="358362">calendar item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="363200">elemento de calendario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8641_184378_498350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The permission setting that permits a person or domain to add the user to contact lists, see the user's status, or send instant messages to the user.</descrip></descripGrp><ntig><termGrp><term id="184378">Allow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498350">Permitir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8643_44563_1178228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To put into use.</descrip></descripGrp><ntig><termGrp><term id="44563">deploy</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178228">aplicar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8644_185806_1520377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI element that ends a user session or exits a service.</descrip></descripGrp><ntig><termGrp><term id="185806">Sign Out</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1520377">Peche de sesión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8657_2140019_497289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person in charge of managing a computer. The administrator is responsible for installing software, assigning passwords, and managing files.</descrip></descripGrp><ntig><termGrp><term id="2140019">admin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497289">administrador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8657_2140019_498909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person in charge of managing a computer. The administrator is responsible for installing software, assigning passwords, and managing files.</descrip></descripGrp><ntig><termGrp><term id="2140019">admin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498909">administrador do computador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8657_318135_497289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person in charge of managing a computer. The administrator is responsible for installing software, assigning passwords, and managing files.</descrip></descripGrp><ntig><termGrp><term id="318135">computer administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497289">administrador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8657_318135_498909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person in charge of managing a computer. The administrator is responsible for installing software, assigning passwords, and managing files.</descrip></descripGrp><ntig><termGrp><term id="318135">computer administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498909">administrador do computador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8657_9827_497289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person in charge of managing a computer. The administrator is responsible for installing software, assigning passwords, and managing files.</descrip></descripGrp><ntig><termGrp><term id="9827">administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497289">administrador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8657_9827_498909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person in charge of managing a computer. The administrator is responsible for installing software, assigning passwords, and managing files.</descrip></descripGrp><ntig><termGrp><term id="9827">administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498909">administrador do computador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="866_312761_498858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A System Audio Effects (SYSFX) component used to provide a more immersive audio experience in the Windows Media Player and thus an improved listening experience by utilizing the available speakers that a user has attached to his/her PC by sending audio to all of the speakers, regardless of the number of channels the content contains. This will provide a better sounding experience for stereo and quadraphonic content being rendered on multi-channel playback systems.</descrip></descripGrp><ntig><termGrp><term id="312761">speaker fill</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498858">complemento de altofalantes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8662_88814_2392991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that remains on a system after it has ceased to be of use.</descrip></descripGrp><ntig><termGrp><term id="88814">orphan file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2392991">ficheiro orfo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8664_55395_497633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The stylistic attributes of a font — such as bold, italic, and underline.</descrip></descripGrp><ntig><termGrp><term id="55395">font style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497633">estilo do tipo de letra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8668_374344_2094644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The variable-length data type with a maximum of 4,000 Unicode characters.</descrip></descripGrp><ntig><termGrp><term id="374344">nvarchar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094644">nvarchar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8684_397181_412214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed folder that is created by an Exchange administrator and placed in a user’s mailbox for messaging records management purposes where retention and journaling of messages is controlled by managed content settings that are applied to the folder.</descrip></descripGrp><ntig><termGrp><term id="397181">managed custom folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412214">cartafol personalizado xestionado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8688_228749_2793695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of users, accounts, Web sites, etc. that are permitted to perform certain actions on a network.</descrip></descripGrp><ntig><termGrp><term id="228749">Allow list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2793695">Lista de permitidos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8688_228749_3000920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of users, accounts, Web sites, etc. that are permitted to perform certain actions on a network.</descrip></descripGrp><ntig><termGrp><term id="228749">Allow list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3000920">lista de permitidos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8688_276556_2793695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of users, accounts, Web sites, etc. that are permitted to perform certain actions on a network.</descrip></descripGrp><ntig><termGrp><term id="276556">allow list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2793695">Lista de permitidos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8688_276556_3000920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of users, accounts, Web sites, etc. that are permitted to perform certain actions on a network.</descrip></descripGrp><ntig><termGrp><term id="276556">allow list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3000920">lista de permitidos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8702_168246_1689049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A meeting participant who cannot initiate desktop or application sharing or presenting and whose permissions are controlled by the organizer and presenters.</descrip></descripGrp><ntig><termGrp><term id="168246">attendee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1689049">participante</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8706_186134_498356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of rules on a computer and a portable device that allow digital media files and other information to be synchronized.</descrip></descripGrp><ntig><termGrp><term id="186134">partnership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498356">asociación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8712_64603_1708235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file containing graphics (illustrations, photographs, etc.) or other visual information.</descrip></descripGrp><ntig><termGrp><term id="64603">image file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1708235">ficheiro de imaxe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8715_96006_2795788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To eliminate old or unneeded information systematically.</descrip></descripGrp><ntig><termGrp><term id="96006">purge</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2795788">purgar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8718_73755_412244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary access protocol for Active Directory. LDAP is an industry-standard protocol, established by the Internet Engineering Task Force (IETF), that allows users to query and update information in a directory service. Active Directory supports both LDAP version 2 and LDAP version 3.</descrip></descripGrp><ntig><termGrp><term id="73755">LDAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412244">LDAP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8718_73755_412245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary access protocol for Active Directory. LDAP is an industry-standard protocol, established by the Internet Engineering Task Force (IETF), that allows users to query and update information in a directory service. Active Directory supports both LDAP version 2 and LDAP version 3.</descrip></descripGrp><ntig><termGrp><term id="73755">LDAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412245">protocolo lixeiro de acceso a directorios</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8718_73756_412244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary access protocol for Active Directory. LDAP is an industry-standard protocol, established by the Internet Engineering Task Force (IETF), that allows users to query and update information in a directory service. Active Directory supports both LDAP version 2 and LDAP version 3.</descrip></descripGrp><ntig><termGrp><term id="73756">Lightweight Directory Access Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412244">LDAP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8718_73756_412245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary access protocol for Active Directory. LDAP is an industry-standard protocol, established by the Internet Engineering Task Force (IETF), that allows users to query and update information in a directory service. Active Directory supports both LDAP version 2 and LDAP version 3.</descrip></descripGrp><ntig><termGrp><term id="73756">Lightweight Directory Access Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412245">protocolo lixeiro de acceso a directorios</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8727_306408_498793"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter effect in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="306408">Threshold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498793">Limiar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8729_101470_2064560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operator that allows the programmer to compare two (or more) values or expressions. Typical relational operators are greater than (&gt;), equal to (=), less than (&lt;), not equal to (&lt;&gt;), greater than or equal to (&gt;=), and less than or equal to (&lt;=).</descrip></descripGrp><ntig><termGrp><term id="101470">relational operator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2064560">operador relacional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8740_117601_1538553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A brief content of a larger document.</descrip></descripGrp><ntig><termGrp><term id="117601">summary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1538553">resumo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8743_494345_3104900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to anything (e.g. elements) that can receive focus.</descrip></descripGrp><ntig><termGrp><term id="494345">focusable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3104900">activable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8744_35474_497469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard system control that initiates a command.</descrip></descripGrp><ntig><termGrp><term id="35474">command button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497469">botón de comando</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8744_35475_497469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard system control that initiates a command.</descrip></descripGrp><ntig><termGrp><term id="35475">push button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497469">botón de comando</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8747_351591_499131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Windows that allows users to access and manage printers, multi-function printers, digital cameras and scanners.</descrip></descripGrp><ntig><termGrp><term id="351591">Printing and Imaging Devices</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="499131">Dispositivos de impresión e de procesamento de imaxes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8751_418607_1520504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prevent another user from initiating a conversation and from viewing your presence or other information, such as your personal information.</descrip></descripGrp><ntig><termGrp><term id="418607">block</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1520504">bloquear</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8757_558600_1686936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The list of answers to a search request that match the search criteria specified by the user.</descrip></descripGrp><ntig><termGrp><term id="558600">search results</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1686936">resultados de busca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8759_475191_1336745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A job performed on entities or records, based on rules defined in a workflow.</descrip></descripGrp><ntig><termGrp><term id="475191">workflow job</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1336745">tarefa do fluxo de traballo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8769_9149_1950027"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of an agreement that defines the business process that is used, your role, your partner's role, and the policies or parameters that are used in that relationship along with documentation, such as a list of business and legal terms.</descrip></descripGrp><ntig><termGrp><term id="9149">addendum</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950027">anexo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8777_24948_497377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list in which each item or block of text is preceded by a bullet.</descrip></descripGrp><ntig><termGrp><term id="24948">bulleted list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497377">lista con viñetas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8780_100131_497927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The temporary storage place on Windows where deleted files are transferred and remain until manually emptied and files are permanently deleted, which allows users to retrieve files until that point.</descrip></descripGrp><ntig><termGrp><term id="100131">Recycle Bin</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497927">Papeleira de reciclaxe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8790_232417_363231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of domain names and email addresses that you want to receive messages from. E-mail addresses in Contacts and in the Global Address Book are included in this list by default. People you sent messages to will be added to the list.</descrip></descripGrp><ntig><termGrp><term id="232417">Safe Senders List</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="363231">Lista de remitentes seguros</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8792_359700_2094573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field size or data type that can hold positive integer numbers ranging from 0 to 255.</descrip></descripGrp><ntig><termGrp><term id="359700">byte</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094573">byte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8795_10234_497290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that runs on a Simple Network Management Protocol (SNMP) managed device. The agent application is the object of management activities. A computer running SNMP agent software is also sometimes referred to as an agent.</descrip></descripGrp><ntig><termGrp><term id="10234">agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497290">axente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8801_1177095_497412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optical storage medium for digital data.</descrip></descripGrp><ntig><termGrp><term id="1177095">optical disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="gra