g="en-US"><descripGrp><descrip type="definition">A small amount of executable code contained in the master boot record that scans the partition table for the active partition, finds the starting sector of the active partition, loads a copy of the boot sector from the active partition into memory, and transfers control to the executable code in the boot sector.</descrip></descripGrp><ntig><termGrp><term id="1597055">master boot code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1752794">código de arranque principal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3117_109079_1537103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Protection of a computer system and its data from harm or loss.</descrip></descripGrp><ntig><termGrp><term id="109079">security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1537103">seguranza da rede</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3117_109079_497954"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Protection of a computer system and its data from harm or loss.</descrip></descripGrp><ntig><termGrp><term id="109079">security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497954">seguranza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3117_747373_1537103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Protection of a computer system and its data from harm or loss.</descrip></descripGrp><ntig><termGrp><term id="747373">network security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1537103">seguranza da rede</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3117_747373_497954"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Protection of a computer system and its data from harm or loss.</descrip></descripGrp><ntig><termGrp><term id="747373">network security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497954">seguranza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3119_126168_1600018"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a newsreader client program, to remove a newsgroup from the list of newsgroups to which upload one subscribes.</descrip></descripGrp><ntig><termGrp><term id="126168">unsubscribe</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1600018">cancelar a subscrición</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3127_140864_2735728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone number format for dialing internal, operator, or emergency numbers by a computer.</descrip></descripGrp><ntig><termGrp><term id="140864">dialable format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2735728">formato de marcación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3128_216346_1276252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication method that creates a single activity for distribution to a group of marketing lists, accounts, contacts, or leads. Contrast with a campaign, which supports an end-to-end marketing program that has multiple activities.</descrip></descripGrp><ntig><termGrp><term id="216346">quick campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1276252">campaña rápida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31293_1598403_1606540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A runtime environment for Windows Store apps that's designed to minimize app impact on the computer by placing runtime restrictions on what apps can do.</descrip></descripGrp><ntig><termGrp><term id="1598403">app container</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1606540">contedor de aplicacións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31294_1627809_1634749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filtering feature that monitors downloaded apps for malware or unknown reputation.</descrip></descripGrp><ntig><termGrp><term id="1627809">Windows SmartScreen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1634749">Windows SmartScreen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31295_1598405_1606543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows that includes a set of maintenance tasks that run automatically when the user's PC is idle.</descrip></descripGrp><ntig><termGrp><term id="1598405">Automatic Maintenance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1606543">Mantemento automático</term><termN