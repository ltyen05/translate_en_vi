"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer technology that identifies where human faces are present in a digital image or a video frame, without identifying any specific faces. This technology can be used to identify images or an area of one image that is relatively important because it contains a face (e.g. this might be used to auto-select the area to crop for a profile photo.)</descrip></descripGrp><ntig><termGrp><term id="2483085">face detection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2768506">detección de persoas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44192_2766791_2768506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer technology that identifies where human faces are present in a digital image or a video frame, without identifying any specific faces. This technology can be used to identify images or an area of one image that is relatively important because it contains a face (e.g. this might be used to auto-select the area to crop for a profile photo.)</descrip></descripGrp><ntig><termGrp><term id="2766791">people detection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2768506">detección de persoas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44194_2483156_2485054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A socket allowing computer memory (RAM) to be inserted into the computer.</descrip></descripGrp><ntig><termGrp><term id="2483156">memory slot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2485054">rañura de memoria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44196_2483498_2496839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extension to the Windows Insider Program to include engagement for enterprises and SMEs through dedicated forums, blogs and events, regular surveys with IT professionals, as well as extensive documentation to support their organizations deploy Insider builds.</descrip></descripGrp><ntig><termGrp><term id="2483498">Windows Insider Program for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2496839">Insider para empresas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44196_2483498_2496845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extension to the Windows Insider Program to include engagement for enterprises and SMEs through dedicated forums, blogs and events, regular surveys with IT professionals, as well as extensive documentation to support their organizations deploy Insider builds.</descrip></descripGrp><ntig><termGrp><term id="2483498">Windows Ins