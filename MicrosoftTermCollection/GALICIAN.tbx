54"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to select a later time to automatically deliver emails and where said emails are stored in the Drafts folder until the time selected for sending.​</descrip></descripGrp><ntig><termGrp><term id="2490693">Send Later</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2500354">Enviar máis tarde</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44350_2490694_2502455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that Excel returns when a formula returns an array of values and one or more of the cells it would spill to already has content.</descrip></descripGrp><ntig><termGrp><term id="2490694">#NOSPILL!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2502455">#SENDESBORDAMENTO!</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44351_2490695_2500344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that Excel returns when a function tried to connect to a network resource or a remote service but failed.​​</descrip></descripGrp><ntig><termGrp><term id="2490695">#CONNECT!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></