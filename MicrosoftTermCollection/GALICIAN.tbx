p></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3068217">Meme</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53826_3062879_3068216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The preset motion title in Clipchamp that adds animated text elements in video editing projects.</descrip></descripGrp><ntig><termGrp><term id="3062879">Lower Third Split</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3068216">División no terzo inferior</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53828_3062995_3063139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The national holiday in New Zealand celebrated around the time of the winter solstice in mid-June, that marks the changing of the seasons and the beginning of the Māori New Year.</descrip></descripGrp><ntig><termGrp><term id="3062995">Matariki</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3063139">Matariki</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53829_3062996_3063137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows organizations to set up and run realistic cyberattacks and test their security policies and practices.</descrip></descripGrp><ntig><termGrp><term id="3062996">Attack simulation training</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3063137">Adestramento con simulacións de ataques</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53830_3063048_3063132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In contact card, a customer's email address or phone number.</descrip></descripGrp><ntig><termGrp><term id="3063048">contact point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3063132">punto de contacto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53831_3063049_3063133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A design element that lets you establish a block of common content that you can reuse in multiple emails, forms, and/or pages. It is used to establish common headers, footers and other blocks of content that you would like to standardize across your communications.</descrip></descripGrp><ntig><termGrp><term id="3063049">content block</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3063133">bloque de contido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53832_3063050_3063135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A primary model in Dynamics 365 Marketing, which includes trigger-based customer journeys, custom triggers, and SMS and push notifications. It allows you to trigger customer journeys in real time based on the signals and rich profile data you collect from your customers, pick the right channel for each individual, and connect in the moments that matter.</descrip></descripGrp><ntig><termGrp><term id="3063050">real-time marketing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3063135">márketing en tempo real</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53833_3063051_3063134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A primary model in Dynamics 365 Marketing, which provides email marketing, customer journeys, lead scoring, marketing pages, and social posting, allowing you to seamlessly connect your marketing and sales processes.</descrip></descripGrp><ntig><termGrp><term id="3063051">outbound marketing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3063134">márketing de saída</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGend