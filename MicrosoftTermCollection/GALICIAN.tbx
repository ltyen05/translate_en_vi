ermNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2015261">telemetría</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32930_2790091_2015262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that shows how products are used including where, how often, with which other software and hardware. This data is used to identify user needs and experiences as well as potential marketing and product improvement opportunities over time. Partners and Microsoft can better understand what happens between planning, lab testing, sales data, and real world scenarios over time.</descrip></descripGrp><ntig><termGrp><term id="2790091">diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2015262">datos telemétricos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32930_2790091_2792299"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that shows how products are used including where, how often, with which other software and hardware. This data is used to identify user needs and experiences as well as potential marketing and product improvement opportunities over time. Partners and Microsoft can better understand what happens between planning, lab testing, sales data, and real world scenarios over time.</descrip></descripGrp><ntig><termGrp><term id="2790091">diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2792299">datos de diagnóstico</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32934_1722196_1755947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that returns the first non-null expression from a list of arguments.</descrip></descripGrp><ntig><termGrp><term id="1722196">COALESCE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1755947">COALESCE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32986_1724598_1759734"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optional feature of Lync Online that enables users to make calls to, and receive calls from, the traditional network by using Lync. This feature is available to Voice Plan customers only, and administrators must sign in with a Lync-to-phone provider to get the feature.</descrip></descripGrp><ntig><termGrp><term id="1724598">Lync-to-phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1759734">Lync-to-phone</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32994_2027122_2033968"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app for Mac computers that creates a folder on the user's computer, downloads the contents of their OneDrive, and keeps the folder in sync with any file changes online and among additional computers.</descrip></descripGrp><ntig><termGrp><term id="2027122">OneDrive for Mac</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2033968">OneDrive for Mac</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32995_1736382_1755967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that facilitates the use of Presenter View by automatically applying the Extend setting for Windows projection and identifying the correct display for Slide Show versus Presenter view.</descrip></descripGrp><ntig><termGrp><term id="1736382">Auto-Extend</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1755967">Extensión automática</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32996_1736384_1755971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Presenter View that enables the user to switch which monitor is showing Presenter View and which monitor is showing Slide Show.</descrip></descripGrp><ntig><termGrp><term id="1736384">Swap Displays</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1755971">Intercambiar pantallas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32999_2282725_2288119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft on-premises server product that runs Microsoft Office Online.</descrip></descripGrp><ntig><termGrp><term id="2282725">Office Online Server</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2288119">Office Online Server</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3300_294443_498729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The entity designated to receive something.</descrip></descripGrp><ntig><termGrp><term id="294443">recipient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498729">destinatario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33000_1736513_1759730"><langSet xml:lang="en-US"><de