Note><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42406_2398709_2405177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway Design feature that allows the user to pick a pair of fonts (for titles and other text) from a list of choices.</descrip></descripGrp><ntig><termGrp><term id="2398709">Font choices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2405177">Opcións de tipo de letra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42407_2398710_2405169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway Design feature that allows users to select whether animations should be subtle, moderate or intense.</descrip></descripGrp><ntig><termGrp><term id="2398710">Animation emphasis</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2405169">Énfase de animación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42414_2399526_2405173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that automatically chooses from several caption styles having different layout and visibility, based on the Navigation layout, Group choice, and Style choice.</descrip></descripGrp><ntig><termGrp><term id="2399526">Caption variation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2405173">Variación de título</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42415_2399527_2404371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway Caption variation that shows an icon where the user can click to see the caption somewhere on the captioned content.</descrip></descripGrp><ntig><termGrp><term id="2399527">Hidden</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2404371">Oculto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42416_2399528_2405182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The caption style chosen by Sway Caption variation that shows the caption at the bottom of the captioned content and that expands to show the entire caption with a scroll bar when the content is clicked on.</descrip></descripGrp><ntig><termGrp><term id="2399528">Minimal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2405182">Minimalista</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></ter