termEntry><termEntry id="32232_1641044_1660624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook calendar feature that can be enabled to display the weather forecast for a selected location.</descrip></descripGrp><ntig><termGrp><term id="1641044">Weather Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1660624">Barra de meteoroloxía</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32240_1641050_1660617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A property grid that only displays the properties that appear in the sentence-level view of an action.</descrip></descripGrp><ntig><termGrp><term id="1641050">top-level property grid</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1660617">grade de propiedades de nivel superior</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32261_1644639_1656151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual summary of appointment or meeting information, which is displayed in a callout without opening the item.</descrip></descripGrp><ntig><termGrp><term id="1644639">calendar item peek</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="165615