Grp><descrip type="definition">The process of customizing the look and feel of the site to reflect the company's style. An administrator can customize the logo, change the background image and theme colors, and change the home page's URL</descrip></descripGrp><ntig><termGrp><term id="2014991">custom theming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2017678">personalización da aparencia do sitio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34872_2015001_2017712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An index structure that stores graph nodes and edges and their associated data.</descrip></descripGrp><ntig><termGrp><term id="2015001">graph index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2017712">índice de gráfico</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34876_2015005_2017719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The control that lets users change their photo, presence, and other public information.</descrip></descripGrp><ntig><termGrp><term id="2015005">My profile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2017719">O meu perfil</term><termNote type="geographicalUs