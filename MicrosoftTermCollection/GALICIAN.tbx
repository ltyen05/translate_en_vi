calNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33085_1755674_1758062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The charm that takes users to the Start screen.</descrip></descripGrp><ntig><termGrp><term id="1755674">Start charm</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1758062">botón clave Inicio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33087_1755689_1758051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The functionality that allows users to switch back to recently used apps.</descrip></descripGrp><ntig><termGrp><term id="1755689">app switching</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1758051">mudar de aplicación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33088_1755690_1758055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state that enables a PC to turn on instantly and have tiles and other services update even when the screen is off.</descrip></descripGrp><ntig><termGrp><term id="1755690">connected standby</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1758055">modo de espera conectado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33089_1755691_1758056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of Windows and device settings that users can change grouped into one location.</descrip></descripGrp><ntig><termGrp><term id="1755691">PC settings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1758056">Configuración do PC</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3309_375734_380451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Functionality in Exchange Server 2007 that helps the messaging administrator diagnose spam-related problems by applying diagnostic metadata, or "stamps," such as sender-specific information, puzzle validation results, and content filtering results, to messages as they pass through the anti-spam features that filter inbound messages from the Internet.</descrip></descripGrp><ntig><termGrp><term id="375734">anti-spam stamping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="380451">carimbo contra correo electrónico non desexado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33091_1755693_1758063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tablet hardware button with the Windows logo on it that's similar to the Windows key on a keyboard. Pressing the Power and Windows buttons simultaneously is the equivalent of pressing Ctrl+Alt+Del.</descrip></descripGrp><ntig><termGrp><term id="1755693">Windows button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1758063">botón de Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33092_1755782_1760779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The spreading of malicious content through online advertising.</descrip></descripGrp><ntig><termGrp><term id="1755782">malvertising</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1760779">publicidade malintencionada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33092_1755783_1760779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The spreading of malicious content through online advertising.</descrip></descripGrp><ntig><termGrp><term id="1755783">malicious advertising</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1760779">publicidade malintencionada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33093_1755827_1780481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rating of how safe an app is determined to be by SmartScreen, according to age, presence of digital certificate, and other criteria.</descrip></descripGrp><ntig><termGrp><term id="1755827">SmartScreen Application Reputation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1780481">reputación de aplicacións SmartScreen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33099_1757767_1759746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that determines what the out-of-box experience will be.</descrip></descripGrp><ntig><termGrp><term id="1757767">out-of-box experience application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1759746">aplicación de OOBE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33099_1757767_1759748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that determines what the out-of-box experience will be.</descrip></descripGrp><ntig><termGrp><term id="1757767">out-of-box experience application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1759748">aplicación de experiencia inicial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33099_1757768_1759746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that determines what the out-of-box experience will be.</descrip></descripGrp><ntig><termGrp><term id="1757768">OOBE application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1759746">aplicación de OOBE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33099_1757768_1759748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that determines what the out-of-box experience will be.</descrip></descripGrp><ntig><termGrp><term id="1757768">OOBE application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1759748">aplicación de experiencia inicial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33100_1757919_1764177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server that issues requests to fetch webpages on behalf of a caller, and returns the webpages to the caller.</descrip></descripGrp><ntig><termGrp><term id="1757919">web proxy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1764177">proxy web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33101_1757920_1764170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A JavaScript library available in apps for SharePoint to allow cross-domain client-level communication.</descrip></descripGrp><ntig><termGrp><term id="1757920">cross-domain library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1764170">biblioteca de dominios cruzados</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33102_1757921_1764169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An HTML and JavaScript based control that renders the top chrome, which is available to use in apps for SharePoint.</descrip></descripGrp><ntig><termGrp><term id="1757921">chrome control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1764169">control de cromo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33103_1758412_1765303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 3D geospatial and temporal visualization tool that enables users to map, explore, and interact with information across multiple dimensions, allowing them to draw new insights from large data sets.</descrip></descripGrp><ntig><termGrp><term id="1758412">GeoFlow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1765303">GeoFlow</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33105_1758865_1760785"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Japanese kana characters that indicate the correct pronunciation, sorting, and grouping behavior of a word written in kanji.</descrip></descripGrp><ntig><termGrp><term id="1758865">Yomi</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1760785">yomi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33106_1759158_1760672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides a progressive disclosure method that remains active only as long as the user holds (presses down) their finger on the touch surface.</descrip></descripGrp><ntig><termGrp><term id="1759158">Tap and Hold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1760672">Tocar e manter</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33109_1759220_1761046"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The charm that provides access to the devices commands.</descrip></descripGrp><ntig><termGrp><term id="1759220">Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1761046">Dispositivos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33111_1759222_1760675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware button that increases and decreases the sound volume.</descrip></descripGrp><ntig><termGrp><term id="1759222">volume control button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1760675">botón de control de volume</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33112_1759223_1767038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label that indicates a screen or monitor that is attached to a PC and that content can be projected on to.</descrip></descripGrp><ntig><termGrp><term id="1759223">Second screen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1767038">Segunda pantalla</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33115_1760042_1764178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interface that enables a web application server (for example, Office Web Apps Server) to access and change files that are stored by a host server (such as SharePoint Server).</descrip></descripGrp><ntig><termGrp><term id="1760042">WOPI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1764178">WOPI</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33116_1760045_1764179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web application server, such as Office Web Apps Server, that uses WOPI and WOPI conventions to integrate with a host server, and is designed to view and edit files stored by the host.</descrip></descripGrp><ntig><termGrp><term id="1760045">WOPI application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1764179">aplicación WOPI</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33117_1760047_1764180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A host server, such as SharePoint Server, that uses WOPI to support file operations and provides a wrapper for the WOPI application UI.</descrip></descripGrp><ntig><termGrp><term id="1760047">WOPI host</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1764180">computador servidor WOPI</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33118_1761200_1779805"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that comes with a product key and DVD that allows users them to purchase Windows and activate their current copy of Windows from the client.</descrip></descripGrp><ntig><termGrp><term id="1761200">Get Genuine Windows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1779805">Get Genuine Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3312_298013_498772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number in the form a + bi, where a and b are real numbers and i = sqrt(-1) , so that bi is imaginary unless b = 0.</descrip></descripGrp><ntig><termGrp><term id="298013">complex number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498772">número complexo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33142_1762245_1773747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint site to which an app is installed.</descrip></descripGrp><ntig><termGrp><term id="1762245">host web</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1773747">web de aloxamento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33143_1762246_1773743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subweb site to which the SharePoint components of an app are deployed when the app is installed on a host web.</descrip></descripGrp><ntig><termGrp><term id="1762246">app web</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1773743">web da aplicación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33144_1762266_1765300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To deploy the components of an app on appropriate hosts and establish app isolation automatically.</descrip></descripGrp><ntig><termGrp><term id="1762266">autohost</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1765300">aloxar automaticamente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33147_1762377_1767029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report generated by OEMs for each OA 3.0 manufactured computer which is then sent to Microsoft for processing. This report includes the hardware hash value and Product Key ID.</descrip></descripGrp><ntig><termGrp><term id="1762377">computer build report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1767029">CBR</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33147_1762377_1767031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report generated by OEMs for each OA 3.0 manufactured computer which is then sent to Microsoft for processing. This report includes the hardware hash value and Product Key ID.</descrip></descripGrp><ntig><termGrp><term id="1762377">computer build report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><