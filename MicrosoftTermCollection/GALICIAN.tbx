 Teams)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3158134">Office 365 F3 (sen Teams)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56178_3156856_3158195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of the Microsoft 365 F3 subscription offering for customers outside the EEA and Switzerland that does not include Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="3156856">Microsoft 365 F3 (no Teams)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3158195">Microsoft 365 F3 (no Teams)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56179_3156857_3158008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of the Microsoft 365 Business Basic subscription offering for customers outside the EEA and Switzerland that does not include Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="3156857">Microsoft 365 Business Basic (no Teams)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3158008">Microsoft 365 empresarial básico (sen Teams)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56180_3156858_3158011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of the Microsoft 365 Business Standard subscription offering for customers outside the EEA and Switzerland that does not include Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="3156858">Microsoft 365 Business Standard (no Teams)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3158011">Microsoft 365 empresarial estándar (sen Teams)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56181_3156859_3158026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of the Microsoft 365 Business Premium subscription offering for customers outside the EEA and Switzerland that does not include Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="3156859">Microsoft 365 Business Premium (no Teams)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3158026">Microsoft 365 empresarial premium (sen Teams)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56182_3156860_3157921"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The standalone Microsoft Teams offer for enterprise customers available outside the EEA and Switzerland.</descrip></descripGrp><ntig><termGrp><term id="3156860">Microsoft Teams Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3157921">Microsoft Teams empresarial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56183_3157895_3158154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A plugin that leverages Power Platform components like flows, connectors or prompts to define a specific business behavior which can be added to a copilot. The copilot will use the appropriate plugin able to address the questions of an end user in the application.</descrip></descripGrp><ntig><termGrp><term id="3157895">AI plugin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3158154">complemento de IA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56184_3157896_3158155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of the Power Automate Automation Kit that organizations can use to create and maintain automation assets, such as master data records, map resources and environments, and assign roles to employees.</descrip></descripGrp><ntig><termGrp><term id="3157896">automation center</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3158155">centro de automatización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56185_3157897_3158156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power Automate feature that provides users with insights into how their hosted RPA capacity and process capacity are being used within their environment. It offers an overview of the environment-assigned capacities, details their usage and provides suggestions and insights for more efficient management of automations and the desktop infrastructure.</descrip></descripGrp><ntig><termGrp><term id="3157897">capacity utilization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3158156">utilización da capacidade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56186_3157898_3158157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of data that is read from or written to the run history of the cloud flow.</descrip></descripGrp><ntig><termGrp><term id="3157898">content throughput</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3158157">rendemento do contido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56187_3157899_3158158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A prompt that gives makers the freedom to instruct the GPT model to behave in a certain way or to perform a specific task. By carefully crafting a prompt, they can generate responses that suit their specific business needs. This transforms the GPT model into a flexible tool to accomplish various tasks.</descrip></descripGrp><ntig><termGrp><term id="3157899">custom prompt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3158158">pregunta personalizada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56188_3157900_3158159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A machine and machine group setting, which optimizes the machine-assignment logic of a run queue. When enabled, the extended queue prioritization is applied on machines with multi-session support.</descrip></descripGrp><ntig><termGrp><term id="3157900">extended queue prioritization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3158159">priorización ampliada da fila</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56189_3157901_3158160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component used for communication between the Power Automate for desktop browser extension and the Power Automate for desktop application that allows running or creating flows involving web automation.</descrip></descripGrp><ntig><termGrp><term id="3157901">native message host</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3158160">servidor de mensaxes nativas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56190_3157902_3158161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To insert a work queue item back into the work queue after it has been de-queued for processing.</descrip></descripGrp><ntig><termGrp><term id="3157902">requeue</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3158161">volver pór na fila</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56191_3157903_3158162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shared capacity for Power Platform requests that can be used by service principal flows within the same tenant. When enabled, it allows a flow to use a higher number of Power Platform requests, scaling up to 10 million requests in 24 hours.</descrip></descripGrp><ntig><termGrp><term id="3157903">tenant pool</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3158162">grupo de arrendatarios</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56192_3157904_3158163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bot that can be enabled by the Power Automate unattended RPA add-on to extend desktop-based automation. It runs autonomously and can be deployed on a local or remote desktop, or in a virtualized environment.</descrip></descripGrp><ntig><termGrp><term id="3157904">unattended bot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3158163">bot sen supervisión</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56193_3158110_3158197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of the Office 365 E1 offering for customers in the EEA and Switzerland that does not include Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="3158110">Office 365 E1 EEA (no Teams)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3158197">Office 365 E1 EEE (sen Teams)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56194_3158111_3158211">