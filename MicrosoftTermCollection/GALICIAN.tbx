ine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30992_1584354_1588635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of apps and websites of any type that a parent chooses which a child can use at any time and for as long as necessary outside of curfew hours.</descrip></descripGrp><ntig><termGrp><term id="1584354">homework list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1588635">lista de recursos autorizados</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30993_1584355_1588637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app chosen by a parent that a child can use at any time and for as long as necessary outside of curfew hours.</descrip></descripGrp><ntig><termGrp><term id="1584355">homework app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1588637">aplicación autorizada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30994_1584358_1588636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A website that a child has permission to use anytime outside of curfew hours.</descrip></descripGrp><ntig><termGrp><term id="1584358">homework website</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></