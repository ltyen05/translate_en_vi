608_3129690_3130945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Viva module that makes organizational communications more effective by helping communicators to define, create, target, and manage their communications, all from one place, and at one time.</descrip></descripGrp><ntig><termGrp><term id="3129690">Amplify</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3130945">Amplify</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5361_237928_1537108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The approximate location of one or more resources, such as a person, computer, printer, or asset, in a space plan.</descrip></descripGrp><ntig><termGrp><term id="237928">space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1537108">espazo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53611_3052168_3053223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Outlook that empowers individuals to set up personal appointment booking pages to eliminate the back-and-forth of scheduling 1:1 meetings while still maintaining control of their calendar.</descrip></descripGrp><ntig><termGrp><term id="3052168">Bookings with me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3053223">Bookings comigo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53612_3052180_3053230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app in Microsoft Teams that allows organizations to create basic check-in forms for a range of processes (end of shift, store evaluations, recurring action items) based off out-of-the-box tools.</descrip></descripGrp><ntig><termGrp><term id="3052180">Updates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3053230">Actualizacións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53613_3052187_3053229"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that connects business owners with payment providers in Microsoft Teams and helps them receive payments from customers while they register for a webinar and during a meeting.</descrip></descripGrp><ntig><termGrp><term id="3052187">Payments</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3053229">Pagamentos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53614_3052229_3053224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The free Microsoft-owned domain used by default for some automatic user creation and domain transfer scenarios when the tenant hasn't added a custom domain.</descrip></descripGrp><ntig><termGrp><term id="3052229">fallback domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3053224">dominio de reserva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53615_3052230_3053228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that admins can have sent to their users through an automated system, and which can be made to appear as notifications inside Office apps, as Windows notifications, on the Windows desktop, and on other specific surfaces.</descrip></descripGrp><ntig><termGrp><term id="3052230">organizational message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3053228">mensaxe para toda a organización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5362_1274329_1688685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A privacy relationship setting that allows a large amount of information to be viewed, usually assigned to people on your team.</descrip></descripGrp><ntig><termGrp><term id="1274329">Workgroup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1688685">Grupo de traballo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5362_418566_1688685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A privacy relationship setting that allows a large amount of information to be viewed, usually assigned to people on your team.</descrip></descripGrp><ntig><termGrp><term id="418566">Team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1688685">Grupo de traballo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53621_3052240_3052269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The error in Excel that is shown when the user uses an incorrect range operator in a formula or when they use a space character between range references to specify an intersection of two ranges that don't intersect.</descrip></descripGrp><ntig><termGrp><term id="3052240">#NULL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3052269">#NULO</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53646_3053620_3053792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A configuration standard that consists of cybersecurity requirements for a specific product and enable a methodology for securing protocols within networks, servers, computers, and logical designs to enhance overall security.</descrip></descripGrp><ntig><termGrp><term id="3053620">Security Technical Implementation Guide</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3053792">Guía de implantación técnica de seguridade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53646_3053620_3053793"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A configuration standard that consists of cybersecurity requirements for a specific product and enable a methodology for securing protocols within networks, servers, computers, and logical designs to enhance overall security.</descrip></descripGrp><ntig><termGrp><term id="3053620">Security Technical Implementation Guide</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3053793">STIG</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53646_3053621_3053792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A configuration standard that consists of cybersecurity requirements for a specific product and enable a methodology for securing protocols within networks, servers, computers, and logical designs to enhance overall security.</descrip></descripGrp><ntig><termGrp><term id="3053621">STIG</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3053792">Guía de implantación técnica de seguridade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53646_3053621_3053793"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A configuration standard that consists of cybersecurity requirements for a specific product and enable a methodology for securing protocols within networks, servers, computers, and logical designs to enhance overall security.</descrip></descripGrp><ntig><termGrp><term id="3053621">STIG</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3053793">STIG</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53647_3053673_3054406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of security procedures and tools that broadly protect sensitive enterprise information from misuse, unauthorized access, disruption, or destruction. It encompasses physical and environmental security, access control, and cybersecurity.</descrip></descripGrp><ntig><termGrp><term id="3053673">information security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammat