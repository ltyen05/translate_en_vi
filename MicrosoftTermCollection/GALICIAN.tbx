cripGrp><descrip type="definition">A chronological list of posts to monitor that match user-defined criteria.</descrip></descripGrp><ntig><termGrp><term id="2145491">stream</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2331406">secuencia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37612_2146201_2163671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The full-screen pane in Office Universal Apps that shows a list of previous versions of the file that is currently open, and that provides the ability to preview and create a copy of an older versions or restore the current document to an older version.</descrip></descripGrp><ntig><termGrp><term id="2146201">History</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2163671">Historial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37613_2147009_2150013"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dimensions of circles in a bubble chart or a bubble map.</descrip></descripGrp><ntig><termGrp><term id="2147009">bubble size</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2150013">tamaño da burbulla</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37614_2147014_2150017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way of testing a mathematical model by entering known or closely estimated inputs for past events into the model to see how well the output matches the known results.</descrip></descripGrp><ntig><termGrp><term id="2147014">hindcast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2150017">retroanálise</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37615_2147075_2150018"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of identical, small charts with different values to compare them at the same time repeating horizontally within the borders of the chart.</descrip></descripGrp><ntig><termGrp><term id="2147075">horizontal multiples</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2150018">varios horizontais</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37616_2147078_2150019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of identical, small charts with different values to compare them at the same time repeating horizontally, then vertically within the borders of the chart.</descrip></descripGrp><ntig><termGrp><term id="2147078">vertical multiples</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2150019">varios verticais</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37617_2147080_2150016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of enriching a description of a location with geographic coordinates from spatial reference to facilitate analysis with a geographic information system.</descrip></descripGrp><ntig><termGrp><term id="2147080">geocoding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2150016">xeocodificación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37619_2147250_2147472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dual-component app that can be installed on a user's mobile device for secure access to work and school accounts through account sign-in verification.</descrip></descripGrp><ntig><termGrp><term id="2147250">Azure Authenticator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2147472">Azure Authenticator</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><t