nt to a case.</descrip></descripGrp><ntig><termGrp><term id="2445820">hotspot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2449881">área relevante</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43163_2445821_2448220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within Microsoft Edge where people can access e-books and other e-publications that they purchase or download.</descrip></descripGrp><ntig><termGrp><term id="2445821">Books</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2448220">Libros</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43164_2445822_2449906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery view that displays each processed file with information related to its relevance score and details as to why the score was given.</descrip></descripGrp><ntig><termGrp><term id="2445822">Transparency analysis</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2449906">análise da transparencia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote 