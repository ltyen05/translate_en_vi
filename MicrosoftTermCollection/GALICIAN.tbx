ammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3057766">distintivo de experto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5369_34870_497463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special symbol that breaks a column when inserted into a document. It ends the current column and starts the next column.</descrip></descripGrp><ntig><termGrp><term id="34870">column break</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497463">quebra de columna</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53690_3056787_3061010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, pertaining to a development method that uses a drag-and-drop approach and doesn’t require any coding knowledge.</descrip></descripGrp><ntig><termGrp><term id="3056787">no-code</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3061010">sen código</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53691_3056788_3061007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, pertaining to a development method that uses a drag-and-drop approach and requires basic knowledge of coding to finish the building and deploying process.</descrip></descripGrp><ntig><termGrp><term id="3056788">low-code</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3061007">con pouco código</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53692_3056798_3057784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In gaming, a method by which games just read and write from their desired save directory, using the standard Win32 file IO APIs, and synchronization is handled automatically.</descrip></descripGrp><ntig><termGrp><term id="3056798">cloud save</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3057784">gardado na nube</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53693_3056864_3057765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that launches the ink editing experience in Word, allowing the users to edit documents with ink gestures.</descrip></descripGrp><ntig><termGrp><term id="3056864">Action Pen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3057765">Lapis de accións</ter