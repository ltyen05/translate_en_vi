nster</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3022352">Monstro das emocións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53098_3021183_3022364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The starter plan for Microsoft Managed Desktop.</descrip></descripGrp><ntig><termGrp><term id="3021183">Microsoft Managed Desktop Plan 1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3022364">Microsoft Managed Desktop plan 1</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53099_3021184_3022365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The premium plan for Microsoft Managed Desktop.</descrip></descripGrp><ntig><termGrp><term id="3021184">Microsoft Managed Desktop Plan 2</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3022365">Microsoft Managed Desktop plan 2</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53100_3021185_3022340"><langSet xml:lang="en-US"><descripGrp><des