<descripGrp><descrip type="definition">The Microsoft Philanthropies program that provides technology grants and discounts to nonprofit organizations all over the world.</descrip></descripGrp><ntig><termGrp><term id="3057909">Tech for Social Impact</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3058684">Tecnoloxía para o impacto social</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53716_3057910_3058685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of games or contests in Microsoft Teams that make up a single unit of competition to promote new learnings and healthy usage of tools and scenarios across the organization.</descrip></descripGrp><ntig><termGrp><term id="3057910">tournament</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3058685">torneo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53717_3057911_3058672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams feature that intelligently arranges meeting elements for optimal viewing by automatically adjusting the layout when people join, turn on the video, or present.</descrip></descripGrp><ntig><termGrp><term id="3057911">Dynamic view</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></t