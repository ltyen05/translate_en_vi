69"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The music track which customers can use as a soundtrack in movies that they create from photo and video content in the Photos app. This is music that you might hear while waiting on hold on the telephone.</descrip></descripGrp><ntig><termGrp><term id="2569521">On Hold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2570469">En espera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45578_2569566_2575170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category of games that are optimized for Xbox One X console.</descrip></descripGrp><ntig><termGrp><term id="2569566">Xbox One X Enhanced</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2575170">Mellorado para Xbox One X</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45579_2569567_2581550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The premium 4K gaming and entertainment console from Microsoft.</descrip></descripGrp><ntig><termGrp><term id="2569567">Xbox One X</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2581550">Xbox One X</term><termNote type="geographi