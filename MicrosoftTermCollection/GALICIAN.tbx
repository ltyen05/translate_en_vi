mber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2057841">MI de grupo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20707_746426_2057839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instant message session with multiple parties, exchanged via IM (not through your mobile operator).</descrip></descripGrp><ntig><termGrp><term id="746426">group IM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2057839">chat de grupo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20707_746426_2057840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instant message session with multiple parties, exchanged via IM (not through your mobile operator).</descrip></descripGrp><ntig><termGrp><term id="746426">group IM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2057840">conversa de grupo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20707_746426_2057841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instant message session with multiple parties, exchanged via IM (not through your mobile operator).</descrip></descripGrp><ntig><termGrp><term id="746426">group IM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2057841">MI de grupo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20714_746441_2454146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that replicates formatting from a source item — such as text in Word, a cell in Excel, a control in Access, or a shape in Publisher — to one or more target items.</descrip></descripGrp><ntig><termGrp><term id="746441">Format Painter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2454146">Pincel de formato</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2072_156842_2792274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that displays advertisement.</descrip></descripGrp><ntig><termGrp><term id="156842">adware</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2792274">adware</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20723_1047661_1178891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of items, such as files and folders, assembled from various locations. The locations might be on your computer, an external hard drive, removable media, or someone else’s computer.</descrip></descripGrp><ntig><termGrp><term id="1047661">Windows library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178891">biblioteca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20723_746479_1178891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of items, such as files and folders, assembled from various locations. The locations might be on your computer, an external hard drive, removable media, or someone else’s computer.</descrip></descripGrp><ntig><termGrp><term id="746479">library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178891">biblioteca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20724_746483_1178892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark an item so that it always appears in a specific place in the UI or in a list.</descrip></descripGrp><ntig><termGrp><term id="746483">pin</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178892">fixar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20725_746484_1178893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove an item, such as a tile, library, movie, game, or app, from a given area of the UI, to make it inaccessible in that area.</descrip></descripGrp><ntig><termGrp><term id="746484">unpin</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178893">soltar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20733_1509298_1520490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user with role-based permission who can change settings for apps, services, users, subscriptions, and/or devices.</descrip></descripGrp><ntig><termGrp><term id="1509298">admin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1520490">administrador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20733_746527_1520490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user with role-based permission who can change settings for apps, services, use