S"><descripGrp><descrip type="definition">To stop the operation of a program or execution of a command temporarily.</descrip></descripGrp><ntig><termGrp><term id="91151">pause</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497874">pausar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49320_2794537_2795770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The responsibility of a company for the impacts of its decisions and activities on society and the environment, through transparent and ethical behaviour that contributes to sustainable development, takes into account the expectations of stakeholders, is in compliance with applicable law and consistent with international norms of behavior, and is integrated throughout the organization and practised in its relationships, as based on ISO 26000:2010.</descrip></descripGrp><ntig><termGrp><term id="2794537">corporate social responsibility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2795770">responsabilidade social corporativa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49320_2794537_2795772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The responsibility of a company for the impacts of its decisions and activities on society and the environment, through transparent and ethical behaviour that contributes to sustainable development, takes into account the expectations of stakeholders, is in compliance with applicable law and consistent with international norms of behavior, and is integrated throughout the organization and practised in its relationships, as based on ISO 26000:2010.</descrip></descripGrp><ntig><termGrp><term id="2794537">corporate social responsibility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2795772">CSR</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49320_2794538_2795770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The responsibility of a company for the impacts of its decisions and activities on society and the environment, through transparent and ethical behaviour that contributes to sustainable development, takes into account the expectations of stakeholders, is in compliance with applicable law and consistent with international norms of behavior, and is integrated throughout the organization and practised in its relationships, as based on ISO 26000:2010.</descrip></descripGrp><ntig><termGrp><term id="2794538">CSR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2795770">responsabilidade social corporativa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49320_2794538_2795772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The responsibility of a company for the impacts of its decisions and activities on society and the environment, through transparent and ethical behaviour that contributes to sustainable development, takes into account the expectations of stakeholders, is in compliance with applicable law and consistent with international norms of behavior, and is integrated throughout the organization and practised in its relationships, as based on ISO 26000:2010.</descrip></descripGrp><ntig><termGrp><term id="2794538">CSR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2795772">CSR</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49321_2794539_2795774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal report by a business of its decisions and activities as well as their impacts on society and the environment.</descrip></descripGrp><ntig><termGrp><term id="2794539">CSR report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2795774">informe de responsabilidade social corporativa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49321_2794539_2795775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal report by a business of its decisions and activities as well as their impacts on society and the environment.</descrip></descripGrp><ntig><termGrp><term id="2794539">CSR report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2795775">informe de CSR</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49321_2794542_2795774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal report by a business of its decisions and activities as well as their impacts on society and the environment.</descrip></descripGrp><ntig><termGrp><term id="2794542">Corporate Social Responsibility report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2795774">informe de responsabilidade social corporativa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49321_2794542_2795775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal report by a business of its decisions and activities as well as their impacts on society and the environment.</descrip></descripGrp><ntig><termGrp><term id="2794542">Corporate Social Responsibility report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2795775">informe de CSR</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49322_2794540_2795777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A comprehensive, proactive process to identify the actual and potential negative social, environmental and economic impacts of an organization's decisions and activities over the entire life cycle of a project or organizational activity, with the aim of avoiding and mitigating negative impacts, as defined by ISO 26000:2010.</descrip></descripGrp><ntig><termGrp><term id="2794540">due diligence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2795777">dilixencia previa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49323_2794541_2795767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The checklist created by Microsoft based on ISO/IEC 19086-1, the Cloud Computing Service Level Agreement Framework, to guide organizations in their move to the cloud.</descrip></descripGrp><ntig><termGrp><term id="2794541">Cloud Services Due Diligence Checklist</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2795767">Lista de verificación de dilixencia previa dos servizos na nube</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49324_2794543_2795780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The company-wide policy that drives consideration for accessibility into every stage of production, including design, development, evaluation, and release.</descrip></descripGrp><ntig><termGrp><term id="2794543">Microsoft Accessibility Standards</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2795780">MAS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49324_2794543_2795784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The company-wide policy that drives consideration for accessibility into every stage of production, including design, development, evaluation, and release.</descrip></descripGrp><ntig><termGrp><term id="2794543">Microsoft Accessibility Standards</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2795784">Estándares de accesibilidade de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49324_2794544_2795780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The company-wide policy that drives consideration for accessibility into every stage of production, including design, development, evaluation, and release.</descrip></descripGrp><ntig><termGrp><term id="2794544">MAS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2795780">MAS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49324_2794544_2795784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The company-wide policy that drives consideration for accessibility into every stage of production, including design, development, evaluation, and release.</descrip></descripGrp><ntig><termGrp><term id="2794544">MAS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2795784">Estándares de accesibilidade de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49325_2794545_2795750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that assesses a Microsoft product against a particular accessibility standard and describes how the accessibility features of Microsoft products help agencies address global accessibility requirements.</descrip></descripGrp><ntig><termGrp><term id="2794545">Microsoft accessibility conformance report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2795750">ACR</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49325_2794545_2795786"><langS