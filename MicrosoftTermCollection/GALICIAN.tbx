langSet xml:lang="gl"><ntig><termGrp><term id="412328">suplantar identidade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14245_294303_1276296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A defined set of application access privileges. The security role assigned to a user determines which tasks the user can perform and which parts of the user interface the user can view. All users must be assigned at least one security role in order to access the system.</descrip></descripGrp><ntig><termGrp><term id="294303">security role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1276296">rol de seguranza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14246_343618_1139750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagramming capability that shows charts in three dimensions.</descrip></descripGrp><ntig><termGrp><term id="343618">3-D effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1139750">efecto 3D</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14256_72076_497726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To adjust horizontal spacing so that text is aligned evenly along both the left and right margins. Justifying text creates a smooth edge on both sides.</descrip></descripGrp><ntig><termGrp><term id="72076">justify</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497726">xustificar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14269_49251_497589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A change made to content, such as a file, document, or post.</descrip></descripGrp><ntig><termGrp><term id="49251">edit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497589">edición</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14289_251895_1555498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request to an Internet site that asks for content to be retrieved.</descrip></descripGrp><ntig><termGrp><term id="251895">HTTP request</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1555498">solicitude</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></