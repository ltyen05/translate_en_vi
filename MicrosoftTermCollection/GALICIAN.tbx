angSet xml:lang="gl"><ntig><termGrp><term id="1606588">Microsoft Corporation</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28358_1585472_1950166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection established between on-premises and cloud email systems that not only allows users to use email from either location with the same set of credentials, but provides a richer management experience.</descrip></descripGrp><ntig><termGrp><term id="1585472">Exchange hybrid deployment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950166">despregamento híbrido de Exchange</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2839_37265_1538533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions in some computer language intended to be executed on a computer so as to perform some task. The term usually implies a self-contained entity, as opposed to a routine or a library.</descrip></descripGrp><ntig><termGrp><term id="37265">computer program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1538533">programa de computador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28405_1484852_2727538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of services designed to help evaluate organizations' environments, develop customized Microsoft SharePoint deployment plans, and that is part of software assurance coverage.</descrip></descripGrp><ntig><termGrp><term id="1484852">SharePoint Deployment Planning Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2727538">SDPS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28405_1484852_2727539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of services designed to help evaluate organizations' environments, develop customized Microsoft SharePoint deployment plans, and that is part of software assurance coverage.</descrip></descripGrp><ntig><termGrp><term id="1484852">SharePoint Deployment Planning Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2727539">Servizos de planificación de despregamento de SharePoint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28405_1673938_2727538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of services designed to help evaluate organizations' environments, develop customized Microsoft SharePoint deployment plans, and that is part of software assurance coverage.</descrip></descripGrp><ntig><termGrp><term id="1673938">SDPS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2727538">SDPS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28405_1673938_2727539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of services designed to help evaluate organizations' environments, develop customized Microsoft SharePoint deployment plans, and that is part of software assurance coverage.</descrip></descripGrp><ntig><termGrp><term id="1673938">SDPS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2727539">Servizos de planificación de despregamento de SharePoint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28406_1484854_2726099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Software Assurance benefit delivered by Microsoft Certified Partner that consists of one to fifteen days of planning the deployment of Microsoft Office Software for a specific organization.</descrip></descripGrp><ntig><termGrp><term id="1484854">Microsoft Desktop Deployment Planning Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2726099">Servizos de planificación de despregamento para escritorio de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28426_1486692_2689231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that represents a service at the Key Distribution Center (KDC). The service principal has a name and an associated key. A subclass of principal, a service principal generally does not correspond to a human user of the system, but rather to an automated service providing a resource, such as a file server.</descrip></descripGrp><ntig><termGrp><term id="1486692">service principal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2689231">entidade de servizo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28434_1487371_1790797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2011 edition of Microsoft Office that runs on the Mac operating system.</descrip></descripGrp><ntig><termGrp><term id="1487371">Microsoft Office for Mac 2011</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1790797">Microsoft Office for Mac 2011</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28434_2170107_1790797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2011 edition of Microsoft Office that runs on the Mac operating system.</descrip></descripGrp><ntig><termGrp><term id="2170107">Office for Mac 2011</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1790797">Microsoft Office for Mac 2011</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28459_1488400_2015250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To convert a nested structure into a flat structure.</descrip></descripGrp><ntig><termGrp><term id="1488400">flatten</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2015250">simplificar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2846_297003_498750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trojan that captures and/or transmits passwords to an attacker.</descrip></descripGrp><ntig><termGrp><term id="297003">password stealer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498750">ladrón de contrasinal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><