010_3118063_3120216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A deployment strategy that provides employees the flexibility to access corporate applications, services, and data from the device of their choice.</descrip></descripGrp><ntig><termGrp><term id="3118063">BYOPC</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3120216">Trae o teu PC</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55010_3118063_3120218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A deployment strategy that provides employees the flexibility to access corporate applications, services, and data from the device of their choice.</descrip></descripGrp><ntig><termGrp><term id="3118063">BYOPC</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3120218">BYOPC</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55011_3118476_3120224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of water that is socially equitable, environmentally sustainable, and economically beneficial.</descrip></descripGrp><ntig><termGrp><term id="3118476">water stewardship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id