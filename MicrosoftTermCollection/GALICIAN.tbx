tion">An UI element that allows users to adjust the display angle of an object on the screen.</descrip></descripGrp><ntig><termGrp><term id="2575532">angle indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2590963">indicador de ángulo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45725_2577623_2625308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The free edition of SQL Server ideal for development and production for desktop, web, and small server applications.</descrip></descripGrp><ntig><termGrp><term id="2577623">SQL Server Express</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2625308">SQL Server Express</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45725_2577624_2625308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The free edition of SQL Server ideal for development and production for desktop, web, and small server applications.</descrip></descripGrp><ntig><termGrp><term id="2577624">Microsoft SQL Server Express</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2625308">SQL Server Express</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNo