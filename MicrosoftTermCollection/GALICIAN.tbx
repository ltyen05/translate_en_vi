xt in documents.</descrip></descripGrp><ntig><termGrp><term id="2857342">document understanding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2859111">comprensión de documentos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50472_2857343_2859259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to recognize one’s emotions, as well as understand the reasons why one might be feeling them.</descrip></descripGrp><ntig><termGrp><term id="2857343">self-awareness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2859259">recoñecemento propio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50473_2857349_2859266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The shared meaning that keeps teams focused, aligned, higher performing, and happier.</descrip></descripGrp><ntig><termGrp><term id="2857349">team purpose</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2859266">propósito de equipo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSe