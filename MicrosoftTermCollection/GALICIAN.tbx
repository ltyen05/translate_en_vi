tig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2793703">repositorio secreto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46037_2594855_2645503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data platform designed for data warehousing and Big Data analytics which offers deep data integration, high-speed query processing, scalable storage, and simple maintenance for your end-to-end business intelligence solutions.</descrip></descripGrp><ntig><termGrp><term id="2594855">Microsoft Analytics Platform System</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2645503">Microsoft Analytics Platform System</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46037_2594856_2645503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data platform designed for data warehousing and Big Data analytics which offers deep data integration, high-speed query processing, scalable storage, and simple maintenance for your end-to-end business intelligence solutions.</descrip></descripGrp><ntig><termGrp><term id="2594856">APS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2645503">Microsoft Analytics Platform System</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46046_2594916_2596369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Windows Defender Security Center where people can see, access, and troubleshoot features related to their accounts, including device login, Windows Hello, Dynamic Lock, and other convenience and security features related to accounts and login.</descrip></descripGrp><ntig><termGrp><term id="2594916">account protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2596369">protección de contas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46047_2594920_2596370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Windows Defender Security Center, within Ransomware protection, where customers can set up or initiate file restores with cloud providers, to help recover from a ransomware attack (which often encrypts files).</descrip></descripGrp><ntig><termGrp><term id="2594920">Ransomware data recovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2596370">Recuperación de datos por ataque de software malicioso con rescate</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46048_2594927_2596372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Windows Defender Security Center, the area within the Virus &amp; threat protection section (pillar), where customers can find and use features to help prevent or recover from ransomware attacks.​</descrip></descripGrp><ntig><termGrp><term id="2594927">Ransomware protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2596372">Protección contra software malicioso con rescate</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46049_2594936_2596374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Defender Security Center, the area within the Virus &amp; threat protection section (pillar) where customers can see the history of the threats found on their devices.</descrip></descripGrp><ntig><termGrp><term id="2594936">Threat history</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2596374">Historial de ameazas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46050_2594944_2596376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Defender Security Center app on Windows 10, the area within the Virus &amp; threat protection section (pillar) where customers can see information about ​the definitions being used to recognize the latest threats on their device, and check for updates to those definitions.</descrip></descripGrp><ntig><termGrp><term id="2594944">Virus &amp; threat protection updates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2596376">Actualizacións de protección antivirus e contra ameazas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46052_3029685_3029824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to make and receive calls and texts, check notifications, and instantly access their Android device's photos and apps from their Windows PC.</descrip></descripGrp><ntig><termGrp><term id="3029685">Phone Link</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3029824">Ligazón co teléfono</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46053_2594977_2914523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A partnership program for game streamers to represent the Mixer community in the online world. Participants in the Mixer Partnership Program can benefit from more transcoding options, custom emoticons, testing of new features, priority support, promotional opportunities and more.</descrip></descripGrp><ntig><termGrp><term id="2594977">Mixer Partnership Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2914523">Programa de asociación de Mixer</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46054_2594978_2915900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Legally binding document that defines the terms of the relationship between participants in the Mixer Partnership Program and Microsoft Corporation.</descrip></descripGrp><ntig><termGrp><term id="2594978">Mixer Program Agreement</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2915900">Contrato do programa de Mixer</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46057_2594988_2596386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The partner (authorized by the Microsoft Partner Network) that is associated as the customer’s transacting partner on a cloud subscription.</descrip></descripGrp><ntig><termGrp><term id="2594988">transacting partner of record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2596386">asociado de transacción de rexistro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46058_2594992_2596383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The partner (authorized by the Microsoft Partner Network) who is helping the customer design, build, deploy or manage a solution that they have built on the service. It is not the partner who sold the subscription.</descrip></descripGrp><ntig><termGrp><term id="2594992">digital partner of record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2596383">asociado dixital de rexistro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46061_2595007_2875602"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The participant in the Xbox Insider Program.</descrip></descripGrp><ntig><termGrp><term id="2595007">Xbox Insider</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2875602">Xbox Insider</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46061_2595007_3114553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The participant in the Xbox Insider Program.</descrip></descripGrp><ntig><termGrp><term id="2595007">Xbox Insider</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3114553">Insider</term><termNote