92553_2725557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value between 1 and 8 that is assigned to a message based on its content and that reflects the likelihood that the message is phishing.</descrip></descripGrp><ntig><termGrp><term id="592553">PCL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2725557">nivel de confianza de suplantación de identidade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42806_2428403_2458595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search type that returns search results sorted by relevance, in a single list.</descrip></descripGrp><ntig><termGrp><term id="2428403">relevance search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2458595">busca por relevancia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42807_2428404_2458580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system for provisioning computer processing and data storage services in an on-demand manner through virtualization and made available over the Internet.</descrip></descripGrp><ntig><termGrp><term id="2428404">cloud provisioning system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2458580">sistema de aprovisionamento na nube</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4281_88221_2479772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To explicitly decline to participate.</descrip></descripGrp><ntig><termGrp><term id="88221">opt out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2479772">optar por non participar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42813_2428410_2458585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email message sent from Dynamics 365, which is able to report back to the system each time a reader interacts with it, including events such as: opened, clicked, downloaded, and replied to.</descrip></descripGrp><ntig><termGrp><term id="2428410">followed email</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2458585">correo electrónico seguido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42814_2428411_2458597"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email message received in a user's private Outlook/Exchange inbox, but later copied directly into Dynamics 365, where the message is shared with the sales team and associated with specific records.</descrip></descripGrp><ntig><termGrp><term id="2428411">tracked email</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2458597">correo electrónico rastrexado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42815_2428412_2458577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual "card" that provides an alert message to the user and includes relevant links and action buttons to act on that information. Cards are generated and prioritized with the most important shown first. The cards are shown many places in the UI, with all cards shown on top-level dashboards and filtered cards shown for specific records (just the cards that apply to that record).</descrip></descripGrp><ntig><termGrp><term id="2428412">action card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2458577">cartón de acción</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42816_2428413_2458582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location of the file that's displayed to a user when the record it is in is similar to the record the user is currently viewing.</descrip></descripGrp><ntig><termGrp><term id="2428413">document location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2458582">localización do documento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42817_2428414_2458588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To follow an email message after sending it in order to see the number of views, replies, and the last activity associated with the email.</descrip></descripGrp><ntig><termGrp><term id="2428414">monitor</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2458588">monitorar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42818_2428415_2458584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action card that displays information about a followed message. For example, when a recipient opens an email message you're following, you can be notified to call that recipient.</descrip></descripGrp><ntig><termGrp><term id="2428415">email engagement card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2458584">cartón de interacción do correo electrónico</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42819_2428416_2458591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that shows the activities of a recipient for a followed email message. You can see the number of views, replies, and the last activity associated with the message.</descrip></descripGrp><ntig><termGrp><term id="2428416">recipient activity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2458591">actividade do destinatario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42820_2428417_2458596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical user interface element in a guided task that explains or demonstrates how to progress an activity toward completion. A guided task is comprised of one step or a sequence of steps.</descrip></descripGrp><ntig><termGrp><term id="2428417">step</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2458596">paso</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42821_2428418_2458587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A configurable sidebar or guided task within an application.</descrip></descripGrp><ntig><termGrp><term id="2428418">Learning Path control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2458587">control de camiño de aprendizaxe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42822_2428420_2458579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual personification created by a player to represent them in social spaces in an app.</descrip></descripGrp><ntig><termGrp><term id="2428420">avatar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2458579">avatar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42823_2428422_2458586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A display showing the list of top scoring players in a fantasy sales game or other competition.</descrip></descripGrp><ntig><termGrp><term id="2428422">leaderboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2458586">táboa de clasificación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42824_2428423_2458589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An acknowledgment given to a player when they meet the conditions of a KPI in a game. Points add up to the player's score.</descrip></descripGrp><ntig><termGrp><term id="2428423">point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2458589">punto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42825_2428424_2458590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A representation of a player's information in a game or an app.</descrip></descripGrp><ntig><termGrp><term id="2428424">profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2458590">perfil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42826_2428432_2588904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To stream content so that other people can watch and comment on it.</descrip></descripGrp><ntig><termGrp><term id="2428432">broadcast</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2588904">difundir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42828_2428470_2429600"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Learning Tools feature that allows users to change letter, word, line, and column spacing to reduce visual crowding.</descrip></descripGrp><ntig><termGrp><term id="2428470">Text Spacing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2429600">Espazado de texto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42829_2428723_2429607"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The task pane (in Office and other programs) where users can view a translation of other content and control the settings for that translation.</descrip></descripGrp><ntig><termGrp><term id="2428723">Translator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2429607">Tradutor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42830_2429203_2431901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Project view where users can create a high-level view of their project plan that can be shared through other Office applications.</descrip></descripGrp><ntig><termGrp><term id="2429203">Timeline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="