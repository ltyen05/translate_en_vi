ype="definition">A business that is either small or mid-sized.</descrip></descripGrp><ntig><termGrp><term id="2519063">SMB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2522511">peme</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44734_2519470_2784550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of one or more individual functions that are managed, deployed, and scaled together.</descrip></descripGrp><ntig><termGrp><term id="2519470">function app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2784550">aplicación de función</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44738_2519484_2522461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The preview version of Microsoft Whiteboard.</descrip></descripGrp><ntig><termGrp><term id="2519484">Microsoft Whiteboard Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2522461">Microsoft Whiteboard Preview</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet