:lang="en-US"><descripGrp><descrip type="definition">To provide services (often using a server) to client computers that connect from remote locations, for example, to offer Internet access or to be the source for a news or mail service.</descrip></descripGrp><ntig><termGrp><term id="62295">host</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2410834">hospedar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33205_1763054_2694559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that provides a certain healthcare treatment.</descrip></descripGrp><ntig><termGrp><term id="1763054">health provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2694559">fornecedor de atención médica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33205_1763055_2694559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that provides a certain healthcare treatment.</descrip></descripGrp><ntig><termGrp><term id="1763055">healthcare provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2694559">fornecedor de atención médica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33205_3192613_2694559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that provides a certain healthcare treatment.</descrip></descripGrp><ntig><termGrp><term id="3192613">provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2694559">fornecedor de atención médica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33229_1763300_2015252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that runs on mobile devices such as a smart phone.</descrip></descripGrp><ntig><termGrp><term id="1763300">mobile app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2015252">aplicación para móbil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33235_1763327_2781372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person under medical care.</descrip></descripGrp><ntig><termGrp><term id="1763327">patient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2781372">paciente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33253_1763768_1776635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint field type that enables annotation of a SharePoint list with latitude and longitude.</descrip></descripGrp><ntig><termGrp><term id="1763768">Geolocation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1776635">Xeolocalización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33254_1763770_1776633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint view that provides an optimized mobile browser experience for users and renders in HTML5.</descrip></descripGrp><ntig><termGrp><term id="1763770">contemporary view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1776633">visualización moderna</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33255_1763771_1776631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint view that renders in HTML format, or a similar markup language such as CHTML or WML, and provides backward compatibility for mobile browsers that cannot support the contemporary view.</descrip></descripGrp><ntig><termGrp><term id="1763771">classic view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1776631">visualización clásica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33256_1763840_1765309"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location where Active Directory directory service objects, such as users and groups, are mastered (an original source that defines copies of an object) in a cross-premises deployment.</descrip></descripGrp><ntig><termGrp><term id="1763840">source of authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1765309">orixe da autoridade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33257_1763864_1787146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web-based meeting scheduling and management tool for users who don’t have access to Microsoft Outlook, or are on an operating system not based on Windows. With Lync Web Scheduler, you can create new meetings, change your existing meetings, and send invitations using your favorite email program.</descrip></descripGrp><ntig><termGrp><term id="1763864">Lync Web Scheduler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1787146">Lync Web Scheduler</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33258_1763927_1776637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that enables a single publishing site to be rendered differently for different mobile devices in order to optimize the user experience.</descrip></descripGrp><ntig><termGrp><term id="1763927">Device Channels</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1776637">Canais de dispositivos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33261_1764038_1787127"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A deployment model in which part of a tenant organization's mailboxes, files, or other services, are hosted and part of them are not hosted but instead exist in the organization's own on-premises deployment.</descrip></descripGrp><ntig><termGrp><term id="1764038">cross-premises deployment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1787127">implantación distribuída</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33262_1764120_1765301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A provider that offers DNS hosting services.</descrip></descripGrp><ntig><termGrp><term id="1764120">DNS hosting provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1765301">fornecedor de aloxamento DNS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33263_1764123_1765308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain, website, or other directory whose name consists of a single chunk, such as "contoso," without a suffix such as .com, .corp, .net, .org.</descrip></descripGrp><ntig><termGrp><term id="1764123">single-label domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1765308">dominio de etiqueta única</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33266_1764131_2621766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Azure Multi-Factor Authentication (MFA) Server which enables integration with Active Directory or another LDAP directory.</descrip></descripGrp><ntig><termGrp><term id="1764131">directory integration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2621766">integración de directorios</term><termNote type="geographicalUsage">ESP</termNote><termNote t