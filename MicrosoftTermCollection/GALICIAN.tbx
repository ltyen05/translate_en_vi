42153_2393002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service with official permission to be used within an organization.</descrip></descripGrp><ntig><termGrp><term id="2342153">sanctioned service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2393002">servizo autorizado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40272_2342154_2393015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service with no official permission to be used within an organization.</descrip></descripGrp><ntig><termGrp><term id="2342154">unsanctioned service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2393015">servizo non autorizado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40273_2342387_2342620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security feature that uses virtualization-based security to isolate secrets so that only privileged system software can access them.</descrip></descripGrp><ntig><termGrp><term id="2342387">Credential Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2342620">Credential Guard</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSp