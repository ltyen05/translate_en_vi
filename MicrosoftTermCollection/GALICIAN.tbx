ographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37821_2161165_2163672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that converts images that users upload from Office Lens to .docx or .pptx files for editing, printing, and sharing.</descrip></descripGrp><ntig><termGrp><term id="2161165">Office Lens to Doc</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2163672">Office Lens a documento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37823_2161167_2163673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web app that allows users to put together different types of content, such as text, images and videos, using an interactive online canvas that can be shared and embedded on other sites.</descrip></descripGrp><ntig><termGrp><term id="2161167">Sway</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2163673">Sway</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37831_2161701_2691125"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules defined by the administrator that mandates the adherence to sta