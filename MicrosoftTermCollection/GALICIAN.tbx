e="definition">An independent public authority that supervises the application and adherence of GDPR and that has investigative and corrective authority.</descrip></descripGrp><ntig><termGrp><term id="2785566">DPA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2786378">DPA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49175_2785666_2786546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of researching the cause and scope of a potential problem (e.g. case, alert, incident) and determining its severity.</descrip></descripGrp><ntig><termGrp><term id="2785666">investigation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2786546">investigación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49176_2785667_2786541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network node that network traffic passes through to reach nodes outside of the network.</descrip></descripGrp><ntig><termGrp><term id="2785667">egress point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2786541">punto de saída</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote