Grp></ntig></langSet></termEntry><termEntry id="2361_310912_498840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification sent from one blog to another. It is a way for bloggers to let each other know when one of them has made a reference to another's blog entry.</descrip></descripGrp><ntig><termGrp><term id="310912">trackback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498840">notificación de referencia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23615_1088719_2520923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electron-emitting electrode in a vacuum tube.</descrip></descripGrp><ntig><termGrp><term id="1088719">cathode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2520923">cátodo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23618_1088724_1179003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enter information by means of the keyboard or other input method.</descrip></descripGrp><ntig><termGrp><term id="1088724">enter</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1179003">introducir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSp