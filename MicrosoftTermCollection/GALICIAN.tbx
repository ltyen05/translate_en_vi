ll relevant data for an organization, rather than a data warehouse or other relational database.</descrip></descripGrp><ntig><termGrp><term id="3119445">lake-first</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3119470">lago primeiro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55034_3119531_3119856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability that enables administrators to secure specific tables or columns from specific report viewers who do not have appropriate access levels.</descrip></descripGrp><ntig><termGrp><term id="3119531">object-level security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3119856">seguridade a nivel de obxecto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55035_3119825_3119942"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of structuring information models and associated data schemas such that every data element is mastered (or edited) in only one place.</descrip></descripGrp><ntig><termGrp><term id="3119825">single source of truth</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3119942">unha única fonte de información</term><t