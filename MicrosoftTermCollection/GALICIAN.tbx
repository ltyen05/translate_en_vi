id="34316_1991426_2913262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live area that caters to players who want to game against the best.</descrip></descripGrp><ntig><termGrp><term id="1991426">pro zone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913262">zona pro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34317_1991427_2913263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live area that caters to players who take a more casual, laid-back approach to gaming.</descrip></descripGrp><ntig><termGrp><term id="1991427">recreation zone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913263">zona informal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34318_1991428_2913264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A player's reputation, computed from the aggregation of all player reviews a player has received, represented in every gamer card as an icon.</descrip></descripGrp><ntig><termGrp><term id="1991428">rep</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2913264">reputación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</ter