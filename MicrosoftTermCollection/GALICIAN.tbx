of a Date and Time attribute where field values are displayed with no time zone conversion.</descrip></descripGrp><ntig><termGrp><term id="2157394">Time-Zone Independent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2238667">Independente do fuso horario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37779_2157426_2347289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image file type in which a very short video is followed by a transition to a still image. The combination of video and still image captures the essence of the moment.</descrip></descripGrp><ntig><termGrp><term id="2157426">living image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2347289">imaxe animada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37780_2157427_2175939"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo that illustrates motion by blurring together multiple frames of a short video to create the effect of motion in the still image.</descrip></descripGrp><ntig><termGrp><term id="2157427">motion focus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2175939">enfoque de movemento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37781_2157428_2177703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The top level view in File Explorer that shows the user's most frequently used and most recently used files and folders or folders pinned by the user for quick access.</descrip></descripGrp><ntig><termGrp><term id="2157428">Quick access</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2177703">Acceso rápido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37782_2157429_2177707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides unending stream of music based not on the user's library, but on an artist or song selected by the user.</descrip></descripGrp><ntig><termGrp><term id="2157429">Radio</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2177707">Radio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37784_2157431_2175832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interval of time that it takes to complete a circuit in a race or exercise course, which the user can record with a stopwatch.</descrip></descripGrp><ntig><termGrp><term id="2157431">lap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2175832">volta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37785_2157432_2176289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The total amount of time up to a given point that the user marks while using the stopwatch. After marking a split, the stopwatch continues running in the background.</descrip></descripGrp><ntig><termGrp><term id="2157432">split</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2176289">intervalo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37786_2157433_2175087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that enables app publishers to send ad requests to multiple ad networks to ensure that publishers can match the right ad networks to the right inventory and maximize the ad revenue.</descrip></descripGrp><ntig><termGrp><term id="2157433">ad mediation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2175087">intermediación de anuncios</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37787_2158519_2215025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ID that is given to an app developer by a software system supporting custom apps when the developer registers their app with the software system.</descrip></descripGrp><ntig><termGrp><term id="2158519">client ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2215025">ID de cliente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37788_2158520_2215135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solicitation of ideas or content from a large group of people, generally from an online community.</descrip></descripGrp><ntig><termGrp><term id="2158520">crowdsourcing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2215135">micromecenado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37790_2158530_2215139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A daily summary of new messages posted by a group that a user belongs to.</descrip></descripGrp><ntig><termGrp><term id="2158530">daily digest</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2215139">resumo diario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37791_2158845_2215147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button in Yammer that allows a group administrator to deny access to a particular group of users that have requested access to that group.</descrip></descripGrp><ntig><termGrp><term id="2158845">Deny</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2215147">Denegar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37792_2158857_2215143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button in Yammer that allows a user to refuse a network invitation.</descrip></descripGrp><ntig><termGrp><term id="2158857">Decline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2215143">Rexeitar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37793_2158861_2215160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Yammer feature that automatically synchronizes a company's directory with its Yammer network so that additions and deletions appear in Yammer.</descrip></descripGrp><ntig><termGrp><term id="2158861">Yammer Directory Sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2215160">Sincronización de directorio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37793_2158861_2215269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Yammer feature that automatically synchronizes a company's directory with its Yammer network so that additions and deletions appear in Yammer.</descrip></descripGrp><ntig><termGrp><term id="2158861">Yammer Directory Sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2215269">Sincronización de directorio de Yammer</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37793_2158862_2215160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Yammer feature that automatically synchronizes a company's directory with its Yammer network so that additions and deletions appear in Yammer.</descrip></descripGrp><ntig><termGrp><term id="2158862">Directory Sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2215160">Sincronización de directorio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="