 type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16034_269340_1178828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file system defined by the Optical Storage Technology Association (OSTA) that is the successor to the CD-ROM file system (CDFS). UDF is used for removable disk media like DVD, CD, and magneto-optic (MO) disks.</descrip></descripGrp><ntig><termGrp><term id="269340">UDF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178828">UDF</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16034_269340_498700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file system defined by the Optical Storage Technology Association (OSTA) that is the successor to the CD-ROM file system (CDFS). UDF is used for removable disk media like DVD, CD, and magneto-optic (MO) disks.</descrip></descripGrp><ntig><termGrp><term id="269340">UDF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498700">Formato universal de disco</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16037_245224_3028084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature available in various security products that continuously detects and blocks attacks and potentially malicious objects, providing uninterrupted protection.</descrip></descripGrp><ntig><termGrp><term id="245224">Real-time protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3028084">protección en tempo real</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16037_3027999_3028084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature available in various security products that continuously detects and blocks attacks and potentially malicious objects, providing uninterrupted protection.</descrip></descripGrp><ntig><termGrp><term id="3027999">real-time protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3028084">protección en tempo real</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16047_139902_2094428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">User-defined sort order. For example, you could define a custom sort order to display values in the EmployeeTitle column on the basis of the title's seniority.</descrip></descripGrp><ntig><termGrp><term id="139902">custom order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094428">orde personalizada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16063_2481712_499074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware device, or a logical partition of it, that reads data from and writes data to hard disks.</descrip></descripGrp><ntig><termGrp><term id="2481712">HDD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="499074">unidade de disco ríxido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16063_339969_499074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware device, or a logical partition of it, that reads data from and writes data to hard disks.</descrip></descripGrp><ntig><termGrp><term id="339969">hard disk drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="499074">unidade de disco ríxido</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16066_236645_498537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to time on a schedule when a person may participate in a scheduled task.</descrip></descripGrp><ntig><termGrp><term id="236645">tentative</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</ter