 de tempo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56354_3169482_3170223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A place in Recall feature where users can scroll through their past snapshots to find things they've seen on their Windows computer.</descrip></descripGrp><ntig><termGrp><term id="3169482">timeline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3170223">cronoloxía</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56355_3169483_3170308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-based Windows feature that filters out background sounds so people can hear you clearly.</descrip></descripGrp><ntig><termGrp><term id="3169483">voice focus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3170308">prioridade da voz</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56356_3169484_3170393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect that can make users appear like a watercolor painting while using their camera.</descrip></descripGrp><ntig><termGrp><term id="3169484">watercolor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3170393">acuarela</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56357_3187626_3169505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within Recall that highlights and analyzes text and images on screen and allows users to click and perform actions.</descrip></descripGrp><ntig><termGrp><term id="3187626">Click to Do</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3169505">contido salientado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56357_3187626_3188308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within Recall that highlights and analyzes text and images on screen and allows users to click and perform actions.</descrip></descripGrp><ntig><termGrp><term id="3187626">Click to Do</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3188308">Premer para actuar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56361_3170784_3171263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An organizational unit that represents the company group or division that is primarily responsible for winning the sale and managing the delivery of work and services to the customer.</descrip></descripGrp><ntig><termGrp><term id="3170784">contracting unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3171263">unidade de contratación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56379_3170802_3171264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limit set on a specific cost, time, or resource that should not be surpassed during the execution or billing of a project.</descrip></descripGrp><ntig><termGrp><term id="3170802">not-to-exceed</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3171264">non superable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56389_3170812_3171265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that stores the relation between two similar business transactions such as cost and related sales actuals or transaction reversals triggered by billing activities such as invoice confirmation or invoice corrections.</descrip></descripGrp><ntig><termGrp><term id="3170812">transaction connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3171265">conexión de transacción</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56391_3170950_3176185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software-based trusted execution environment inside the address space of a host application. More technically, it is a Dynamic Link Library (DLL) loaded by a standard Windows application that secures secrets and sensitive operations in memory.</descrip></descripGrp><ntig><termGrp><term id="3170950">virtualization-based security enclave</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3176185">enclave VBS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56391_3170950_3176192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software-based trusted execution environment inside the address space of a host application. More technically, it is a Dynamic Link Library (DLL) loaded by a standard Windows application that secures secrets and sensitive operations in memory.</descrip></descripGrp><ntig><termGrp><term id="3170950">virtualization-based security enclave</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3176192">enclave de seguranza baseada en virtualización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56391_3170951_3176185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software-based trusted execution environment inside the address space of a host application. More technically, it is a Dynamic Link Library (DLL) loaded by a standard Windows application that secures secrets and sensitive operations in memory.</descrip></descripGrp><ntig><termGrp><term id="3170951">VBS enclave</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3176185">enclave VBS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56391_3170951_3176192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software-based trusted execution environment inside the address space of a host application. More technically, it is a Dynamic Link Library (DLL) loaded by a standard Windows application that secures secrets and sensitive operations in memory.</descrip></descripGrp><ntig><termGrp><term id="3170951">VBS enclave</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3176192">enclave de seguranza baseada en virtualización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56392_3170952_3174280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that uses hardware virtualization and the Windows hypervisor to create an isolated virtual environment that becomes the root of trust of the OS that assumes the kernel can be compromised.</descrip></descripGrp><ntig><termGrp><term id="3170952">virtualization-based security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3174280">VBS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56392_3170952_3174281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that uses hardware virtualization and the Windows hypervisor to create an isolated virtual environment that becomes the root of trust of the OS that assumes the kernel can be compromised.</descrip></descripGrp><ntig><termGrp><term id="3170952">virtualization-based security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3174281">seguranza baseada en virtualización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56392_3170953_3174280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that uses hardware virtualization and the Windows hypervisor to create an isolated virtual environment that becomes the root of trust of the OS that assumes the kernel can be compromised.</descrip></descripGrp><ntig><termGrp><term id="3170953">VBS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3174280">VBS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56392_3170953_3174281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that uses hardware virtualization and the Windows hypervisor to create an isolated virtual environment that becomes the root of trust of the OS that assumes the kernel can be compromised.</descrip></descripGrp><ntig><termGrp><term id="3170953">VBS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3174281">seguranza baseada en virtualización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56393_3170954_3172460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The setting within Microsoft Teams that allows users to turn on the voice and face recognition features.</descrip></descripGrp><ntig><termGrp><term id="3170954">Recognition</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3172460">Recoñecemento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote 