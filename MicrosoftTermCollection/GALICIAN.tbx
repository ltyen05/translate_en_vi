ss automation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2815424">RPA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49732_2814049_3018600"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process automation technology that is used to automate repetitive tasks.</descrip></descripGrp><ntig><termGrp><term id="2814049">robotic process automation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3018600">automatización robótica de procesos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49734_2814051_2815423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An expression that creates a new instance of an object.</descrip></descripGrp><ntig><termGrp><term id="2814051">object expression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2815423">expresión de obxecto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49748_2815101_2835606"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides a dedicated cache solution that complements Delivery Optimization distributed peer-to-peer system.</descrip></descripGrp><ntig><termGrp><term id="2815101">Connected Cache</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2835606">Caché conectada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49754_2815537_2815676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Microsoft 365 that includes business services—email, file storage and sharing, Office Online, meetings and IM, and more. Office applications not included.</descrip></descripGrp><ntig><termGrp><term id="2815537">Office 365 E1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2815676">Office 365 E1</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49755_2815538_2815719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Microsoft 365 that includes Skype for Business integrations with telephone system, Office 365 Advanced Threat Protection, Customer Lockbox,Power BI Pro, as well as both the Microsoft Office desktop apps and the online versions. It includes all the features of ProPlus and Office 365 E1 plus security and compliance tools, such as legal hold, data loss prevention, and more.</descrip></descripGrp><ntig><termGrp><term id="2815538">Office 365 E3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2815719">Office 365 E3</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49756_2815539_2815762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Microsoft 365 that includes Skype for Business integrations with telephone system, Office 365 Advanced Threat Protection, Customer Lockbox,Power BI Pro, as well as both the Microsoft Office desktop apps and the online versions. It includes all the features of Office 365 E3 plus advanced security, analytics, and voice capabilities.</descrip></descripGrp><ntig><termGrp><term id="2815539">Office 365 E5</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2815762">Office 365 E5</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49759_2815544_2832306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft licensing agreement designed for automated processing, dynamic updating of terms, transparent pricing, and enhanced billing management capabilities.</descrip></descripGrp><ntig><termGrp><term id="2815544">Microsoft Customer Agreement</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2832306">Contrato de cliente de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49764_2815600_2816050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of user account attributes, segments, "block" and/or "allow" policies, and policy application definitions that together establish information barriers within an organization.</descrip></descripGrp><ntig><termGrp><term id="2815600">information barrier policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2816050">política de barreira de información</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49768_2815606_2816721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An IT tool which enables business users to collect signals from their products and services and gain actionable insights into their customers’ usage and experiences.</descrip></descripGrp><ntig><termGrp><term id="2815606">telemetry collection service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2816721">servizo de recompilación de datos de telemetría</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></te