rip type="definition">To remove part of a document, usually placing it temporarily in memory so that the cut portion can be inserted (pasted) elsewhere.</descrip></descripGrp><ntig><termGrp><term id="41913">cut</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497518">cortar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17372_640684_2814298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual container that holds a particular category of items or data.</descrip></descripGrp><ntig><termGrp><term id="640684">bucket</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2814298">depósito</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17386_641208_1139788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of limiting search results based on the identity of the user who submitted the query.</descrip></descripGrp><ntig><termGrp><term id="641208">security trimming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1139788">recorte de seguranza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammat