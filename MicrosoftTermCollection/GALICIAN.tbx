langSet></termEntry><termEntry id="1254_415810_1950452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A family of Microsoft Web-based team collaboration environments that provide the ability to create and access virtual workspaces for managing documents, discussions, lists, surveys and other important contextual information such as team member status and presence.</descrip></descripGrp><ntig><termGrp><term id="415810">SharePoint Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950452">Windows SharePoint Services</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1254_639899_1950340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A family of Microsoft Web-based team collaboration environments that provide the ability to create and access virtual workspaces for managing documents, discussions, lists, surveys and other important contextual information such as team member status and presence.</descrip></descripGrp><ntig><termGrp><term id="639899">WSS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950340">Servizos de Microsoft Windows SharePoint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1254_639899_1950452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A family of Microsoft Web-based team collaboration environments that provide the ability to create and access virtual workspaces for managing documents, discussions, lists, surveys and other important contextual information such as team member status and presence.</descrip></descripGrp><ntig><termGrp><term id="639899">WSS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950452">Windows SharePoint Services</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12544_76022_497764"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security group that can be granted rights and permissions only to resources on the computer on which the group is created. Local groups can have any user accounts that are local to the computer as members, as well as users, groups, and computers from a domain to which the computer belongs.</descrip></descripGrp><ntig><termGrp><term id="76022">local group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497764">grupo local</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12547_155493_498261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technical document in the Microsoft Knowledge Base accessible through Microsoft.com.</descrip></descripGrp><ntig><termGrp><term id="155493">KB article</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498261">artigo de Knowledge Base</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12548_139813_498148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user dictionary that contains a list of words not in the application dictionary that an author wants the spelling checker to accept as correct.</descrip></descripGrp><ntig><termGrp><term id="139813">custom dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498148">dicionario personalizado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12551_237304_498563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula syntax that allows the user to refer to list and pivot data in a friendlier way.</descrip></descripGrp><ntig><termGrp><term id="237304">Structured References</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498563">referencias estruturadas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12557_269335_498698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A problem that prevents sync from completing. Sync errors are typically caused by problems with the device, network folder, or other computer you are trying to sync with.</descrip></descripGrp><ntig><termGrp><term id="269335">sync error</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498698">erro de sincronización</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12560_257510_2772150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identifier used by two APPC logical units (LUs) to validate security when a session is activated. The security key performs a function similar to that of a password, but at the LU-LU session level rather than at the TP-conversation level.</descrip></descripGrp><ntig><termGrp><term id="257510">security key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2772150">clave de seguranza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12565_475205_1301516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Microsoft Dynamics CRM user interface, a field in which users type the amount of money designated for a campaign activity.</descrip></descripGrp><ntig><termGrp><term id="475205">Budget Allocated</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1301516">Orzamento atribuído</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12571_306405_1178265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter effect in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="306405">Sepia Tone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178265">Ton sepia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12578_58758_497650"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button on the address bar that enables the user to navigate to the specified location (such as a folder path or web address).</descrip></descripGrp><ntig><termGrp><term id="58758">Go</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497650">Ir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12583_46527_1479426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reveal knowledge or information.</descrip></descripGrp><ntig><termGrp><term id="46527">disclose</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1479426">revelar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12590_15839_1301487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process whose execution can proceed independently or in the background. Other processes may be started before the asynchronous process has finished.</descrip></descripGrp><ntig><termGrp><term id="15839">asynchronous operation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1301487">operación asíncrona</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12592_77991_1178794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person whose work or profession is management.</descrip></descripGrp><ntig><termGrp><term id="77991">manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178794">xefe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12596_1146761_2094434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single unit of data.</descrip></descripGrp><ntig><termGrp><term id="1146761">data element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094434">elemento de datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12596_140073_2094434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single unit of data.</descrip></descripGrp><ntig><termGrp><term id="140073">data item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094434">elemento de datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12597_235370_2453386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A structured set of activities designed to yield a specified result or output.</descrip></descripGrp><ntig><termGrp><term id="235370">process</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2453386">proceso</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12607_170582_498306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that installs or upgrades the Windows operating system.</descrip></descripGrp><ntig><termGrp><term id="170582">Windows Setup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498306">programa de instalación de Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12612_308347_498826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advertiser's association with a Web site that can involve financial or material support in return for increased visibility perceived advantage over run-of-site advertising and a targeted audience.</descrip></descripGrp><ntig><termGrp><term id="308347">sponsorship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498826">patrocinio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12614_397146_412194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The record of an Edge Transport server that has been subscribed to an Exchange organization and to which the Microsoft Exchange EdgeSync service propagates recipient and configuration data. The Microsoft Exchange EdgeSync service relies on Edge Subscriptions. Also, Edge Subscription is the process that is required to establish an Edge Subscription for a given Edge Transport server.</descrip></descripGrp><ntig><termGrp><term id="397146">Edge Subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412194">subscrición Edge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12625_137177_2094393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The system administrator's group account that retains full permissions on all databases used by a workgroup. The Setup program automatically adds the default Admin user account to the Admins group.</descrip></descripGrp><ntig><termGrp><term id="137177">Admins group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094393">grupo Administradores</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12634_298003_498767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item that provides options for restarting or turning off your computer or device, or for activating Stand By or Hibernate modes.</descrip></descripGrp><ntig><termGrp><term id="298003">Shut Down</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498767">Apagar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12644_36190_2094576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of gathering and packing the currently allocated regions of memory or auxiliary storage into as small a space as possible, so as to create as much continuous free space as possible.</descrip></descripGrp><ntig><termGrp><term id="36190">compaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094576">compactación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12650_50986_1722154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference that follows the body text. An endnote consists of two linked parts: the note reference mark and the corresponding note text.</descrip></descripGrp><ntig><termGrp><term id="50986">endnote</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1722154">nota de fin</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12659_81864_497808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined command for a single mouse click or a double mouse click, with or without a modifier key, that can be used to perform a task.</descrip></descripGrp><ntig><termGrp><term id="81864">mouse shortcut</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497808">atallo do rato</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12666_50449_1727623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state of an uninitialized Variant variable (which returns a VarType of 0).</descrip></descripGrp><ntig><termGrp><term id="50449">empty</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1727623">baleiro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1267_314102_497510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Shading made up of regularly spaced, intersecting lines.</descrip></descripGrp><ntig><termGrp><term id="314102">hatch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497510">cruzado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1267_40948_497510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Shading made up of regularly spaced, intersecting lines.</descrip></descripGrp><ntig><termGrp><term id="40948">cross hatch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497510">cruzado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12676_252120_498577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of formatting characteristics that you can apply to text, tables, and lists in your document to quickly change their appearance.</descrip></descripGrp><ntig><termGrp><term id="252120">style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498577">estilo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12678_415521_1139737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A name that uniquely identifies a server computer on a network.</descrip></descripGrp><ntig><termGrp><term id="415521">server name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1139737">nome do servidor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12690_310997_498847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application that helps the user to activate a Windows product with Microsoft.</descrip></descripGrp><ntig><termGrp><term id="310997">Windows Activation Client</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498847">Cliente de activación de Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12695_253689_2094579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-byte, fixed-point data type that is useful for calculations involving money or for fixed-point calculations in which accuracy is extremely important. The Currency data type is used to store numbers with up to 15 digits to the left of the decimal point and 4 digits to the right. The type-declaration character in Microsoft© Visual Basic© is an at sign (@). Currency can range from -922,337,203,685,477.5808 to 922,337,203,685,477.5807.</descrip></descripGrp><ntig><termGrp><term id="253689">Currency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094579">Moeda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12695_253689_2094640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-byte, fixed-point data type that is useful for calculations involving money or for fixed-point calculations in which accuracy is extremely important. The Currency data type is used to store numbers with up to 15 digits to the left of the decimal point and 4 digits to the right. The type-declaration character in Microsoft© Visual Basic© is an at sign (@). Currency can range from -922,337,203,685,477.5808 to 922,337,203,685,477.5807.</descrip></descripGrp><ntig><termGrp><term id="253689">Currency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094640">moeda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12695_374694_2094579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-byte, fixed-point data type that is useful for calculations involving money or for fixed-point calculations in which accuracy is extremely important. The Currency data type is used to store numbers with up to 15 digits to the left of the decimal point and 4 digits to the right. The type-declaration character in Microsoft© Visual Basic© is an at sign (@). Currency can range from -922,337,203,685,477.5808 to 922,337,203,685,477.5807.</descrip></descripGrp><ntig><termGrp><term id="374694">money</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094579">Moeda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12695_374694_2094640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-byte, fixed-point data type that is useful for calculations involving money or for fixed-point calculations in which accuracy is extremely important. The Currency data type is used to store numbers with up to 15 digits to the left of the decimal point and 4 digits to the right. The type-declaration character in Microsoft© Visual Basic© is an at sign (@). Currency can range from -922,337,203,685,477.5808 to 922,337,203,685,477.5807.</descrip></descripGrp><ntig><termGrp><term id="374694">money</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094640">moeda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12696_41116_497511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that calculates a sum, average, count, or other type of total on records, and then groups the result by two types of information: one down the left side of the datasheet and the other across the top.</descrip></descripGrp><ntig><termGrp><term id="41116">crosstab query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497511">consulta de táboa de referencias cruzadas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12708_179577_498321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common drop-down menu that includes commands for file operations, such as Open, Save, and Print.</descrip></descripGrp><ntig><termGrp><term id="179577">File menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498321">menú Ficheiro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1271_397184_412196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information contained in an email message that is required to send and deliver a message between messaging servers by using SMTP protocol commands. The message envelope contains the sender email address and the recipient email address information. Recipients never see the message envelope, because it is not part of the message content, and it is discarded when the message reaches its destination. The X.400 messaging standard equivalent to the message envelope is called the "P1 header." The message envelope is often referred to as the "P1 header."</descrip></descripGrp><ntig><termGrp><term id="397184">message envelope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412196">cabeceira P1</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1271_397184_412197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information contained in an email message that is required to send and deliver a message between messaging servers by using SMTP protocol commands. The message envelope contains the sender email address and the recipient email address information. Recipients never see the message envelope, because it is not part of the message content, and it is discarded when the message reaches its destination. The X.400 messaging standard equivalent to the message envelope is called the "P1 header." The message envelope is often referred to as the "P1 header."</descrip></descripGrp><ntig><termGrp><term id="397184">message envelope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412197">sobre de mensaxe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1271_397195_412196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information contained in an email message that is required to send and deliver a message between messaging servers by using SMTP protocol commands. The message envelope contains the sender email address and the recipient email address information. Recipients never see the message envelope, because it is not part of the message content, and it is discarded when the message reaches its destination. The X.400 messaging standard equivalent to the message envelope is called the "P1 header." The message envelope is often referred to as the "P1 header."</descrip></descripGrp><ntig><termGrp><term id="397195">P1 header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412196">cabeceira P1</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1271_397195_412197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information contained in an email message that is required to send and deliver a message between messaging servers by using SMTP protocol commands. The message envelope contains the sender email address and the recipient email address information. Recipients never see the message envelope, because it is not part of the message content, and it is discarded when the message reaches its destination. The X.400 messaging standard equivalent to the message envelope is called the "P1 header." The message envelope is often referred to as the "P1 header."</descrip></descripGrp><ntig><termGrp><term id="397195">P1 header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412197">sobre de mensaxe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12711_2464298_2470446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scaled-down version of a product where a user can try out different features before buying it.</descrip></descripGrp><ntig><termGrp><term id="2464298">test drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2470446">versión de proba</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12716_2328432_2621767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The type of enterprise in which businesses or organizations are engaged.</descrip></descripGrp><ntig><termGrp><term id="2328432">line of business</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2621767">liña de negocio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12724_32944_1950096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time to which a clock is set.</descrip></descripGrp><ntig><termGrp><term id="32944">clock setting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1950096">configuración da hora</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12728_237800_1787172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A point on the project schedule at which the project team assesses progress and quality, and reviews deviations in scope and specifications. A project may have many interim milestones for internal use only, which signal a transition within a phase and help divide large projects into workable pieces. External milestones or major milestones typically occur at the end of major phases of work and are associated with the completion of major deliverables. External milestones are the points where the team and customer review work to date and agree to proceed with the project, appear as a task with a duration of zero work units, and are exposed on customer reports.</descrip></descripGrp><ntig><termGrp><term id="237800">milestone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1787172">fito</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12730_53477_1698339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form sent with a fax that provides information about the sender, e.g. the name, address, telephone number, and fax number.</descrip></descripGrp><ntig><termGrp><term id="53477">fax cover page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1698339">portada de fax</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12730_641197_1698339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form sent with a fax that provides information about the sender, e.g. the name, address, telephone number, and fax number.</descrip></descripGrp><ntig><termGrp><term id="641197">cover page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1698339">portada de fax</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12755_1177216_497549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of storage characterized by high capacity (roughly 650 MB) and the use of laser optics rather than magnetic means for reading data. Optical disk storage commonly used for audio, video, and computer data. DVDs range in capacity from 4.7 GB to 17 GB, and can store significantly more than a CD-ROM.</descrip></descripGrp><ntig><termGrp><term id="1177216">digital versatile disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497549">disco de vídeo dixital</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12755_1177216_497550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of storage characterized by high capacity (roughly 650 MB) and the use of laser optics rather than magnetic means for reading data. Optical disk storage commonly used for audio, video, and computer data. DVDs range in capacity from 4.7 GB to 17 GB, and can store significantly more than a CD-ROM.</descrip></descripGrp><ntig><termGrp><term id="1177216">digital versatile disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497550">DVD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12755_45847_497549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of storage characterized by high capacity (roughly 650 MB) and the use of laser optics rather than magnetic means for reading data. Optical disk storage commonly used for audio, video, and computer data. DVDs range in capacity from 4.7 GB to 17 GB, and can store significantly more than a CD-ROM.</descrip></descripGrp><ntig><termGrp><term id="45847">digital video disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497549">disco de vídeo dixital</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12755_45847_497550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of storage characterized by high capacity (roughly 650 MB) and the use of laser optics rather than magnetic means for reading data. Optical disk storage commonly used for audio, video, and computer data. DVDs range in capacity from 4.7 GB to 17 GB, and can store significantly more than a CD-ROM.</descrip></descripGrp><ntig><termGrp><term id="45847">digital video disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497550">DVD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12755_45848_497549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of storage characterized by high capacity (roughly 650 MB) and the use of laser optics rather than magnetic means for reading data. Optical disk storage commonly used for audio, video, and computer data. DVDs range in capacity from 4.7 GB to 17 GB, and can store significantly more than a CD-ROM.</descrip></descripGrp><ntig><termGrp><term id="45848">DVD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497549">disco de vídeo dixital</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12755_45848_497550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of storage characterized by high capacity (roughly 650 MB) and the use of laser optics rather than magnetic means for reading data. Optical disk storage commonly used for audio, video, and computer data. DVDs range in capacity from 4.7 GB to 17 GB, and can store significantly more than a CD-ROM.</descrip></descripGrp><ntig><termGrp><term id="45848">DVD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497550">DVD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1276_121665_1722159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reach the end of a pre-determined period of inactivity or absence of expected event or action, after which a device, program, or process is typically deactivated or interrupted.</descrip></descripGrp><ntig><termGrp><term id="121665">time out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1722159">exceder o tempo de espera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><t