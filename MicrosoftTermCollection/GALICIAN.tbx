67576_2268462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of access permission to sensitive resources, such as AD DS management console, a sensitive SP site or sensitive file-share.</descrip></descripGrp><ntig><termGrp><term id="2267576">privileged role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2268462">función con privilexios</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38998_2267577_2268458"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user, who can inherit the access permissions of a certain role, after performing all necessarily authNZ activities.</descrip></descripGrp><ntig><termGrp><term id="2267577">assigned user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2268458">usuario atribuído</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38999_2267578_2268456"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act when an assigned user successfully receives the access rights of a privileged role.</descrip></descripGrp><ntig><termGrp><term id="2267578">activation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2268456">activación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="390_18288_1178664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Referring to anything that is ready for immediate use by a user or application.</descrip></descripGrp><ntig><termGrp><term id="18288">available</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178664">dispoñible</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39000_2267579_2268457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication or authorization gate that the an assigned user has to complete in order to activate a role.</descrip></descripGrp><ntig><termGrp><term id="2267579">activation gate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2268457">porta de activación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39001_2267580_2268465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user, who administers all of the privileged access management systems and is able to define PIM roles, and candidates.</descrip></descripGrp><ntig><termGrp><term id="2267580">security administrator</term><termNote type="partOfSpeech">No