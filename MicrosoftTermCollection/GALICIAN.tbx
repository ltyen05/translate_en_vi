</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3049839">personalizador do sistema</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53574_3049265_3049840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of blocking external tenants from establishing connections into your tenant (inbound isolation) as well as blocking your tenant from establishing connections to external tenants (outbound isolation).</descrip></descripGrp><ntig><termGrp><term id="3049265">tenant isolation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3049840">illamento de arrendatarios</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53575_3049266_3049841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The prebuilt AI model that extracts all text in photos and PDF documents.</descrip></descripGrp><ntig><termGrp><term id="3049266">Text recognition</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3049841">Recoñecemento de texto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></t