pGrp><ntig><termGrp><term id="1275658">speed dial key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1772887">chave de marcación rápida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5437_1275658_2016230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single- or double-digit number associated with telephone numbers, or email or Web addresses, that enables users to quickly access the numbers or addresses.</descrip></descripGrp><ntig><termGrp><term id="1275658">speed dial key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2016230">marcación rápida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5437_616102_1772887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single- or double-digit number associated with telephone numbers, or email or Web addresses, that enables users to quickly access the numbers or addresses.</descrip></descripGrp><ntig><termGrp><term id="616102">speed dial number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1772887">chave de marcación rápida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</te