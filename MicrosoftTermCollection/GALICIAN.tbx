p><ntig><termGrp><term id="1791361">Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1973282">Protección</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33514_1791362_1973285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The stand-alone email filtering service for customers that run Exchange or another messaging solution on-site but use the Exchange Online Protection service that is hosted in the Microsoft cloud environment.</descrip></descripGrp><ntig><termGrp><term id="1791362">Exchange Online Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1973285">Exchange Online Protection</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33514_2925587_1973285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The stand-alone email filtering service for customers that run Exchange or another messaging solution on-site but use the Exchange Online Protection service that is hosted in the Microsoft cloud environment.</descrip></descripGrp><ntig><termGrp><term id="2925587">EOP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1973285">Exchange Online Protection</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33518_1791366_1973286"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email message that contains a spam report for individual users who don't have access to quarantine or the junk email folder.</descrip></descripGrp><ntig><termGrp><term id="1791366">End-User Spam Notification</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1973286">Notificación de correo non desexado para usuarios finais</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33519_1791367_1973281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Policies that are detailed enough to be applied to distribution groups, security groups, and individual users.</descrip></descripGrp><ntig><termGrp><term id="1791367">user-based policies</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1973281">políticas baseadas en usuarios</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33520_1791368_2392978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of transport rules and classification logic that applies specific filtering based on specific regulatory requirements, for example, HIPAA (Health Insurance Portability and Accountability Act).</descrip></descripGrp><ntig><termGrp><term id="1791368">DLP policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2392978">política de DLP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33522_1791370_1973283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An informative notice displayed to email senders while they’re composing a message that they might be violating a data loss prevention (DLP) policy.</descrip></descripGrp><ntig><termGrp><term id="1791370">policy tip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1973283">suxestión de políticas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33560_1795065_2632806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of features that identify, monitor and protect sensitive information.</descrip></descripGrp><ntig><termGrp><term id="1795065">data loss prevention</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2632806">prevención de perda de datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote