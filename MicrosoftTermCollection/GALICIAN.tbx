termEntry id="11322_19990_497347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that has meaning independent of other characters, or any graphical character that is not a diacritical mark.</descrip></descripGrp><ntig><termGrp><term id="19990">base character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497347">carácter básico</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11325_253810_2094645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variable that contains a reference to an object.</descrip></descripGrp><ntig><termGrp><term id="253810">object variable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094645">variable de obxectos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11326_415806_1727348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One unit of ownership interest in a company.</descrip></descripGrp><ntig><termGrp><term id="415806">share</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1727348">acción</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="g