="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497437">marca de verificación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8882_187096_1722170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To retrieve a writable copy of a file or project from a source repository. This locks the file for editing to prevent others from overwriting or editing it inadvertently.</descrip></descripGrp><ntig><termGrp><term id="187096">check out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1722170">desprotexer</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8884_135175_2094566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field data type you use for fields that will contain only one of two values, such as Yes or No and True or False. Null values are not allowed.</descrip></descripGrp><ntig><termGrp><term id="135175">Yes/No data type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094566">tipo de datos Si/Non</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8887_62829_2094594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file format that can be viewed using a Web browser. With this file format, you can publish your reports directly to your Intranet or web site.</descrip></descripGrp><ntig><termGrp><term id="62829">HTML file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094594">ficheiro HTML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8891_308309_2015697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Add-in software that provides partially localized user interfaces for particular computer programs in languages not supported by localized versions of those programs.</descrip></descripGrp><ntig><termGrp><term id="308309">Language Interface Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2015697">Paquete de idioma de interface</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8891_308309_2015698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Add-in software that provides partially localized user interfaces for particular computer programs in languages not supported by localized versions of those programs.</descrip></descripGrp><ntig><termGrp><term id="308309">Language Interface Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2015698">LIP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8891_308310_2015697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Add-in software that provides partially localized user interfaces for particular computer programs in languages not supported by localized versions of those programs.</descrip></descripGrp><ntig><termGrp><term id="308310">LIP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2015697">Paquete de idioma de interface</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8891_308310_2015698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Add-in software that provides partially localized user interfaces for particular computer programs in languages not supported by localized versions of those programs.</descrip></descripGrp><ntig><termGrp><term id="308310">LIP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2015698">LIP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8892_65579_2749872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A third-party software developer which may include an individual or an organization that independently creates computer software.</descrip></descripGrp><ntig><termGrp><term id="65579">independent software vendor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2749872">fornecedor de software independente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8892_65579_2749880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A third-party software developer which may include an individual or an organization that independently creates computer software.</descrip></descripGrp><ntig><termGrp><term id="65579">independent software vendor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2749880">ISV</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8892_65580_2749872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A third-party software developer which may include an individual or an organization that independently creates computer software.</descrip></descripGrp><ntig><termGrp><term id="65580">ISV</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2749872">fornecedor de software independente</term><termNote type=