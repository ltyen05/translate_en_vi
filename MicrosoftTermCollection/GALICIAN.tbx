escripGrp><ntig><termGrp><term id="319154">registered trademark symbol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498977">símbolo de marca rexistrada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15806_319155_498977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The symbol or character used to indicate that a word, phrase, symbol, or design is a registered trademark.</descrip></descripGrp><ntig><termGrp><term id="319155">REGISTERED SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498977">símbolo de marca rexistrada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15814_140706_498163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window that shows the design of these database objects - tables, queries, forms, reports, macros, and data access pages. In Design view, you can create new database objects and modify the design of existing ones.</descrip></descripGrp><ntig><termGrp><term id="140706">Design view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498163">visualización de deseño</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatical