">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2265211">Conector de aplicacións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38980_2267302_2269408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of REST APIs that allows app developers unified access to entities and relationships from Microsoft and Office 365 services.</descrip></descripGrp><ntig><termGrp><term id="2267302">Microsoft Graph</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2269408">Microsoft Graph</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38981_2267303_2269407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that figures out which part of an image is important, and then determines how to best fit the image within its current context and Design.</descrip></descripGrp><ntig><termGrp><term id="2267303">Focus Points</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2269407">Puntos importantes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38983_2267305_2269406"><l