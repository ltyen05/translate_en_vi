ig></langSet></termEntry><termEntry id="48627_2751842_2764321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a system in which all users can access and modify the source code and have the rights to distribute such modifications.</descrip></descripGrp><ntig><termGrp><term id="2751842">open-source</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2764321">código aberto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48628_2752101_2753492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person or group who engages in criminal activity on the internet.</descrip></descripGrp><ntig><termGrp><term id="2752101">cybercriminal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2753492">cibercriminal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48629_2752103_2753491"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A crime that is committed over the Internet and where the use of a computer is integral to the crime.</descrip></descripGrp><ntig><termGrp><term id="2752103">cybercrime</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2753491">cibercrime</term><termNote type="geographi