elta query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2509045">consulta delta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44563_2506551_2509032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string on the end of the path in a GET request (“/delta”) that triggers delta query.</descrip></descripGrp><ntig><termGrp><term id="2506551">delta function</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2509032">función delta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44564_2506552_2509044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A complete set of data returned for a resource from a delta query GET request.</descrip></descripGrp><ntig><termGrp><term id="2506552">delta feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2509044">fonte delta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44565_2506553_2509082"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An opaque token returned in a delta query GET response which encodes the point in time of the last data provided to the client.</descrip></descripGrp><ntig><termGrp><term id="2506553">state token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2509082">token de estado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44567_2506560_2509087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of data about a resource that contains complex values, generally indicating behaviors or capabilities of an item.</descrip></descripGrp><ntig><termGrp><term id="2506560">facet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2509087">faceta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44568_2506562_2509047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of data related to Outlook MAPI properties not already exposed in the Microsoft Graph API metadata.</descrip></descripGrp><ntig><termGrp><term id="2506562">extended property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2509047">propiedade estendida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44569_2506611_2509075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that enables Wi-Fi devices to connect directly, without a router or other mechanism, making it simpler to do things like print, share, sync, and display.​</descrip></descripGrp><ntig><termGrp><term id="2506611">Wi-Fi Direct</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2509075">Wi-Fi Direct</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44586_2506886_2509064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that enables members of a Language community to provide translation and language-related feedback about features. The app is currently available only for Windows Desktop.</descrip></descripGrp><ntig><termGrp><term id="2506886">Language Community app</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2509064">aplicación Comunidade lingüística</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44587_2506888_2509066"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request to gather and send language feedback using quests in Feedback Hub and the Language Community app.​</descrip></descripGrp><ntig><termGrp><term id="2506888">language quest</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2509066">encomenda lingüística</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4459_148656_498222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The slide that stores information about the design template applied, including font styles, placeholder sizes and positions, background design, and color schemes.</descrip></descripGrp><ntig><termGrp><term id="148656">slide master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498222">padrón de diapositivas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44608_2573054_2577557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of the expanded view of the profile card that contains LinkedIn profile information.</descrip></descripGrp><ntig><termGrp><term id="2573054">LinkedIn profile in Microsoft</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2577557">Perfil de LinkedIn en Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44611_2509173_2512657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to compose and save a message as a template, and then reuse it when they want to.</descrip></descripGrp><ntig><termGrp><term id="2509173">Email templates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2512657">Modelos de correo electrónico</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4462_72367_497728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The core of layered architecture that manages the most basic operations of the operating system and the computer's processor. The kernel schedules different blocks of executing code, called threads, for the processor to keep it as busy as possible and coordinates multiple processors to optimize performance. The kernel also synchronizes activities among Executive-level subcomponents, such as I/O Manager and Process Manager, and handles hardware exceptions and other hardware-dependent functions. The kernel works closely with the hardware abstraction layer.</descrip></descripGrp><ntig><termGrp><term id="72367">kernel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497728">kernel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></t