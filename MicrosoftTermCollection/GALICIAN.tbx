e a selected product, for example, by credit card or check.</descrip></descripGrp><ntig><termGrp><term id="1778971">purchase process</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1784674">proceso de compra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33426_1778972_1784671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of contact or meeting with a person to gauge his or her level of interest in your product or offer.</descrip></descripGrp><ntig><termGrp><term id="1778972">prospecting</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1784671">prospección</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33427_1778974_1784660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To act on or make further investigations on a contact or lead, on the basis of information received.</descrip></descripGrp><ntig><termGrp><term id="1778974">follow-up</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1784660">seguimento</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33428_1778978_1784657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Comments and reactions to something, intended to provide useful information for future business decisions and development.</descrip></descripGrp><ntig><termGrp><term id="1778978">feedback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1784657">comentarios</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33430_1779005_1784669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A particularly urgent and difficult to solve customer problem.</descrip></descripGrp><ntig><termGrp><term id="1779005">pain point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1784669">problemas de negocio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33431_1779019_1784668"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability, service, product, or resource offered to a customer.</descrip></descripGrp><ntig><termGrp><term id="1779019">offering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1784668">oferta</term><termNote type="geographicalUsage">ESP</t