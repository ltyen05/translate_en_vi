ip type="definition">The category of items that have recently started to gain in popularity.</descrip></descripGrp><ntig><termGrp><term id="2312659">New and rising games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2161259">Novidades populares en aplicacións</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33605_2312659_2161260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category of items that have recently started to gain in popularity.</descrip></descripGrp><ntig><termGrp><term id="2312659">New and rising games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2161260">Novidades populares en xogos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33606_1803761_2016157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An external device that interacts with an NFC-enabled phone. These devices exchange data, such as contact details or secure payment information, with NFC-enabled phones through contactless communication.</descrip></descripGrp><ntig><termGrp><term id="1803761">NFC reader</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2016157">lector NFC</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33607_1803831_2016158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An exchange of information between two devices using NFC, or near field communication. Using NFC transactions, a person can use their phone to make payments in a store or as a bus pass.</descrip></descripGrp><ntig><termGrp><term id="1803831">NFC transaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2016158">transacción NFC</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33608_1803832_2016164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data limit plan where users purchase upfront a quota of data for a given time. For instance, pre-paid 500MB which expire in 6 months.</descrip></descripGrp><ntig><termGrp><term id="1803832">One time</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2016164">Bono de datos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33609_1803833_2016168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To navigate through screens or menus at a controlled rate, performed by putting your finger(s) on and keeping contact with the phone's touch screen while moving it around.</descrip></descripGrp><ntig><termGrp><term id="1803833">pan</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2016168">premer e mover</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33610_1803834_2057836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The policy that states the rules of acceptable use, determined by Skype.</descrip></descripGrp><ntig><termGrp><term id="1803834">Fair Usage Policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2057836">Política de uso aceptable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33610_1803834_2057837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The policy that states the rules of acceptable use, determined by Skype.</descrip></descripGrp><ntig><termGrp><term id="1803834">Fair Usage Policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2057837">PUA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></la