<termEntry id="27004_1362158_1520568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A webpage link saved as a .url file in someone's "Favorites" folder on Windows OneDrive. Favorites can be created directly within OneDrive, or via the Windows Live Toolbar.</descrip></descripGrp><ntig><termGrp><term id="1362158">favorite</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1520568">favorito</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27007_1362193_2694577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that manages media quality over a wide area network (WAN) connection by either rerouting traffic or by denying connection requests when bandwidth is approaching saturation.</descrip></descripGrp><ntig><termGrp><term id="1362193">call admission control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2694577">control de admisión de chamadas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27007_1517552_2694577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that manages media quality over a wide area network (WAN) connection by either rerouting traffic or by denying connection requests when bandwidth is approaching saturation.</descrip></descripGrp><ntig><termGrp><term id="1517552">CAC</term><termNote type="partOfSpee