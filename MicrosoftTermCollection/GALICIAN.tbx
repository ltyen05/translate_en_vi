learn and easy to use.</descrip></descripGrp><ntig><termGrp><term id="126865">user-friendly</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498055">fácil de utilizar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15319_52477_2998586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The operation in which a number is raised to a given power, as in 23. In computer programs and programming languages, exponentiation is often shown by a caret (^), as in 2^3.</descrip></descripGrp><ntig><termGrp><term id="52477">exponentiation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2998586">potenciación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15327_219610_1771864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The control panel for Office (including the Tools Options dialog).</descrip></descripGrp><ntig><termGrp><term id="219610">Resources</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1771864">Recursos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15329_418620_1689071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The folder in Outlook where instant messages and phone conversations are stored.</descrip></descripGrp><ntig><termGrp><term id="418620">Conversation History</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1689071">Historial de conversas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15332_397204_412290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Records management technology in Exchange 2007 that helps organizations to reduce the risks that are associated with email and other communications. MRM makes it easier to keep messages that are needed to comply with company policy, government regulations, or legal needs, and to remove content that has no legal or business value.</descrip></descripGrp><ntig><termGrp><term id="397204">messaging records management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412290">xestión de rexistros de mensaxes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15332_397204_412291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Records management technology in Exchange 2007 that helps organizations to reduce the risks that are associated with email and other communications. MRM makes it easier to keep messages that are needed to comply with company policy, government regulations, or legal needs, and to remove content that has no legal or business value.</descrip></descripGrp><ntig><termGrp><term id="397204">messaging records management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412291">MRM</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15332_397205_412290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Records management technology in Exchange 2007 that helps organizations to reduce the risks that are associated with email and other communications. MRM makes it easier to keep messages that are needed to comply with company policy, government regulations, or legal needs, and to remove content that has no legal or business value.</descrip></descripGrp><ntig><termGrp><term id="397205">MRM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412290">xestión de rexistros de mensaxes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15332_397205_412291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Records management technology in Exchange 2007 that helps organizations to reduce the risks that are associated with email and other communications. MRM makes it easier to keep messages that are needed to comply with company policy, government regulations, or legal needs, and to remove content that has no legal or business value.</descrip></descripGrp><ntig><termGrp><term id="397205">MRM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="412291">MRM</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15335_104365_497937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To copy files from a backup storage device to their normal location, especially if the files are being copied to replace files that were accidentally lost or deleted.</descrip></descripGrp><ntig><termGrp><term id="104365">restore</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497937">restaurar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1534_94749_497906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key on IBM PC and compatible keyboards that normally causes the computer to send a character-based “picture” of the screen contents to the printer.</descrip></descripGrp><ntig><termGrp><term id="94749">PRINT SCREEN key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497906">tecla IMPR PANT</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15344_292991_2739460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate which contains information that identifies the server, as well as information about the organization that issued the certificate.</descrip></descripGrp><ntig><termGrp><term id="292991">SSL server certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2739460">certificado SSL de servidor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15350_134128_1178302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for creating and manipulating text-based documents.</descrip></descripGrp><ntig><termGrp><term id="134128">word processor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178302">procesador de texto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15359_234913_498518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual experience of the premium Windows Vista editions. Windows Aero builds on the Basic and Standard user experiences to offer customers our best-designed, highest-performing desktop environment. A noticeable element of the new Windows Aero experience is the professional-looking, transparent glass design, which creates an open, lightweight environment but more importantly enables users to focus on their content rather than the interface.</descrip></descripGrp><ntig><termGrp><term id="234913">Aero</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498518">AERO</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15359_234913_498519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual experience of the premium Windows Vista editions. Windows Aero builds on the Basic and Standard user experiences to offer customers our best-designed, highest-performing desktop environment. A noticeable element of the new Windows Aero experience is the professional-looking, transparent glass design, which creates an open, lightweight environment but more importantly enables users to focus on their content rather than the interface.</descrip></descripGrp><ntig><termGrp><term id="234913">Aero</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498519">auténtico, enérxico, reflexivo e aberto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15359_234915_498518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual experience of the premium Windows Vista editions. Windows Aero builds on the Basic and Standard user experiences to offer customers our best-designed, highest-performing desktop environment. A noticeable element of the new Windows Aero experience is the professional-looking, transparent glass design, which creates an open, lightweight environment but more importantly enables users to focus on their content rather than the interface.</descrip></descripGrp><ntig><termGrp><term id="234915">Authentic, Energetic, Reflective, and Open</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498518">AERO</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15359_234915_498519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual experience of the premium Windows Vista editions. Windows Aero builds on the Basic and Standard user experiences to offer customers our best-designed, highest-performing desktop environment. A noticeable element of the new Windows Aero experience is the professional-looking, transparent glass design, which creates an open, lightweight environment but more importantly enables users to focus on their content rather than the interface.</descrip></descripGrp><ntig><termGrp><term id="234915">Authentic, Energetic, Reflective, and Open</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498519">auténtico, enérxico, reflexivo e aberto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15359_777773_498518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual experience of the premium Windows Vista editions. Windows Aero builds on the Basic and Standard user experiences to offer customers our best-designed, highest-performing desktop environment. A noticeable element of the new Windows Aero experience is the professional-looking, transparent glass design, which creates an open, lightweight environment but more importantly enables users to focus on their content rather than the interface.</descrip></descripGrp><ntig><termGrp><term id="777773">Windows Aero</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498518">AERO</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15359_777773_498519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual experience of the premium Windows Vista editions. Windows Aero builds on the Basic and Standard user experiences to offer customers our best-designed, highest-performing desktop environment. A noticeable element of the new Windows Aero experience is the professional-looking, transparent glass design, which creates an open, lightweight environment but more importantly enables users to focus on their content rather than the interface.</descrip></descripGrp><ntig><termGrp><term id="777773">Windows Aero</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498519">auténtico, enérxico, reflexivo e aberto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15369_71392_1336815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specified amount of processing performed as a unit by a computer.</descrip></descripGrp><ntig><termGrp><term id="71392">job</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1336815">traballo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15369_71392_497722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specified amount of processing performed as a unit by a computer.</descrip></descripGrp><ntig><termGrp><term id="71392">job</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497722">tarefa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15377_233257_1276222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single item with an item number that consists of one or more component items from inventory or a product catalog.</descrip></descripGrp><ntig><termGrp><term id="233257">kit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1276222">kit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15377_233294_1276222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single item with an item number that consists of one or more component items from inventory or a product catalog.</descrip></descripGrp><ntig><termGrp><term id="233294">kit item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1276222">kit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15381_431811_2775432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of audio, video, or computer equipment linked through a communications system to enable geographically separated individuals to participate in a meeting or discussion.</descrip></descripGrp><ntig><termGrp><term id="431811">teleconferencing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2775432">teleconferencia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15383_2482719_2485048"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary circuit board in a computer that contains most of the basic components of the system.</descrip></descripGrp><ntig><termGrp><term id="2482719">baseboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2485048">placa base</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15383_81653_2485048"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary circuit board in a computer that contains most of the basic components of the system.</descrip></descripGrp><ntig><termGrp><term id="81653">motherboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2485048">placa base</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15383_81654_2485048"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary circuit board in a computer that contains most of the basic components of the system.</descrip></descripGrp><ntig><termGrp><term id="81654">system board</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2485048">placa base</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15384_178508_2344869"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An order for a large quantity of products or services. The minimum quantity that qualifies as a bulk order is set by individual companies.</descrip></descripGrp><ntig><termGrp><term id="178508">bulk order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2344869">pedido por xunto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15386_154964_498259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A delay of the amount of time that elapses before a character begins repeating when you hold down a key.</descrip></descripGrp><ntig><termGrp><term id="154964">repeat delay</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498259">atraso na repetición</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15396_148352_1178824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">E-mail accounts and folders that you can group and set common options for, such as whether to download headers or messages, size limits on downloaded messages, behavior online vs. offline, and time interval for connecting to the server.</descrip></descripGrp><ntig><termGrp><term id="148352">Send/Receive group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1178824">grupo de envío ou recepción</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15399_446286_1336697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process whose execution can proceed independently or in the background. Other processes may be started before the asynchronous process has finished.</descrip></descripGrp><ntig><termGrp><term id="446286">system job</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1336697">traballo do sistema</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="154_543576_1139632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the Administrators group on the local server computer.</descrip></descripGrp><ntig><termGrp><term id="543576">server administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1139632">administrador do servidor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15406_460690_1308700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To initiate another response.</descrip></descripGrp><ntig><termGrp><term id="460690">override</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1308700">anular</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15418_475193_1305903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of accounts contacts or leads who are identified through their demographics as people or businesses who might be the most receptive to a campaign. For example to introduce a new product you can create a marketing list of accounts that have previously purchased similar products and send them brochures about the new product.</descrip></descripGrp><ntig><termGrp><term id="475193">marketing list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1305903">márketing</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15419_140417_2094439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any sequence of characters with a valid format that is surrounded by number signs (#). Valid formats include the date format specified by the locale settings for your code or the universal date format.</descrip></descripGrp><ntig><termGrp><term id="140417">date literal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2094439">literal de data</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1542_30264_497428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbol that carries meaning in language, such as a letter, number, punctuation mark, or emoticon.</descrip></descripGrp><ntig><termGrp><term id="30264">character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497428">carácter</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15422_460670_1303165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The postal location that correspondence should be mailed to about a contract.</descrip></descripGrp><ntig><termGrp><term id="460670">contract address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1303165">enderezo do contrato</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15424_65290_497691"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Unable to be used together.</descrip></descripGrp><ntig><termGrp><term id="65290">incompatible</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497691">incompatible</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15430_91737_497878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The % character.</descrip></descripGrp><ntig><termGrp><term id="91737">percent sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497878">signo de porcentaxe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15431_475244_1314336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account that is immediately above a contact entity. Any action taken on the account entity can propagate to the child contact entity.</descrip></descripGrp><ntig><termGrp><term id="475244">parent customer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1314336">cliente primario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15434_460700_1334922"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of settings required to produce a snapshot, including user credentials, filter criteria, parameters, and schedule information.</descrip></descripGrp><ntig><termGrp><term id="460700">snapshot definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1334922">definición da instantánea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15440_179059_1727370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an account status indicating that payments are up-to-date.</descrip></descripGrp><ntig><termGrp><term id="179059">current</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1727370">ao corrente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15447_461351_1314339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A drop-down list control that determines the values of another drop-down list (also known as a picklist) or a check box.</descrip></descripGrp><ntig><termGrp><term id="461351">parent picklist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1314339">lista despregable primaria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15449_261564_498597"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool used to edit the content of web pages that the customer has created with Office Live.</descrip></descripGrp><ntig><termGrp><term id="261564">Page Editor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498597">editor de páxina</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15452_219611_497512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of data that is organized and summarized into a multidimensional structure that is defined by a set of dimensions and measures.</descrip></descripGrp><ntig><termGrp><term id="219611">OLAP cube</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497512">cubo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15452_219611_498426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of data that is organized and summarized into a multidimensional structure that is defined by a set of dimensions and measures.</descrip></descripGrp><ntig><termGrp><term id="219611">OLAP cube</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="498426">cubo OLAP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="gra