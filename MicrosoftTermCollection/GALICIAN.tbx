ech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27832_1465561_2369191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A record of the financial consequence an accounting event.</descrip></descripGrp><ntig><termGrp><term id="1465561">journal entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2369191">entrada de diario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27834_1465563_2369193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To record the financial consequences of accounting events in the subledger journal.</descrip></descripGrp><ntig><termGrp><term id="1465563">journalize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2369193">rexistrar no diario</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27850_1465579_2321786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of notification that is generated by user-defined rules meant to inform him/her of events, conditions, and status changes.</descrip></descripGrp><ntig><termGrp><term id="1465579">alert</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2321786">alerta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27851_1465580_2424208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication generated by the occurrence of an event that a system or user asynchronously sends for receipt. A notification message is a communication that is intended to be read by a recipient.</descrip></descripGrp><ntig><termGrp><term id="1465580">notification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2424208">notificación</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27852_1465584_2606887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collective of attack vectors through which a system can be attacked successfully.</descrip></descripGrp><ntig><termGrp><term id="1465584">attack surface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2606887">superficie de ataque</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27856_1467945_1663844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of printing on both sides of the paper.</descrip></descripGrp><ntig><termGrp><term id="1467945">duplex printing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1663844">Impresión polas dúas caras</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27863_1467974_2369181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cost that expires when the benefits that incurred the cost are received during an accounting period.</descrip></descripGrp><ntig><termGrp><term id="1467974">expense</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2369181">gasto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27934_1468118_2624173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view where the preview area is centered and the thumbnails that immediately precede and follow the current thumbnail are adjacent to the preview area.</descrip></descripGrp><ntig><termGrp><term id="1468118">carousel view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2624173">visualización de carrusel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2795_60402_1772883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Depending on values embedded in the program code rather than on values that can be input and changed by the user.</descrip></descripGrp><ntig><termGrp><term id="60402">hard-coded</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1772883">definido no código</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2796_3846_497250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Self-propagating malicious software that can automatically distribute itself from one computer to another through network connections. A worm can take harmful action, such as consuming network or local system resources, possibly causing a denial of service attack.</descrip></descripGrp><ntig><termGrp><term id="3846">worm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497250">verme</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28_2656622_2658239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of the user interface (UI) in Outlook Web Access that can be hosted in iframes as part of other Web applications such as SharePoint Portal Server portals. Outlook Web Access exposes a set of Outlook Web Access Web Part URLs that allow other applications to request certain portions of the Outlook Web Access UI. For example, another application can load the Outlook Web Access Web Part URL for the Inbox, Calendar, or Contact folder into an iframe hosted in that application.</descrip></descripGrp><ntig><termGrp><term id="2656622">Outlook Web App Web Part</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="2658239">Peza web de Outlook Web App</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="280_114555_497978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To organize information, such as a list of files, in a particular order. For example, a list of files can be sorted alphabetically by name in ascending or descending order.</descrip></descripGrp><ntig><termGrp><term id="114555">sort</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497978">ordenar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2800_375743_380471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process in which Unified Messaging dials calls. Unified Messaging generally receives calls, but sometimes dials calls. For example, outdialing occurs when Unified Messaging transfers a call to an auto attendant or a subscriber uses Play-on-Phone from Outlook.</descrip></descripGrp><ntig><termGrp><term id="375743">outdialing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="380471">automatización de chamadas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2807_503144_1688814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that indicates a user should be contacted only for urgent issues.</descrip></descripGrp><ntig><termGrp><term id="503144">Urgent interruptions only</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="1688814">Só interrupcións urxentes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2809_29638_497425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security label that accompanies all Microsoft products distributed by original equipment manufacturers (OEMs).</descrip></descripGrp><ntig><termGrp><term id="29638">certificate of authenticity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497425">certificado de autenticidade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2809_29638_497426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security label that accompanies all Microsoft products distributed by original equipment manufacturers (OEMs).</descrip></descripGrp><ntig><termGrp><term id="29638">certificate of authenticity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497426">COA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2809_29639_497425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security label that accompanies all Microsoft products distributed by original equipment manufacturers (OEMs).</descrip></descripGrp><ntig><termGrp><term id="29639">COA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497425">certificado de autenticidade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2809_29639_497426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security label that accompanies all Microsoft products distributed by original equipment manufacturers (OEMs).</descrip></descripGrp><ntig><termGrp><term id="29639">COA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497426">COA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="