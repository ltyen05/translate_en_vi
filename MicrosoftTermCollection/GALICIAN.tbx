="73009">keypad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497735">teclado numérico</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7190_73010_497735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calculator-style block of keys, usually at the right side of a keyboard, that can be used to enter numbers.</descrip></descripGrp><ntig><termGrp><term id="73010">numeric keypad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="497735">teclado numérico</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7198_233471_610969"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A grouping of telephony users with some specific properties, such as unique telephone extension numbers, that allow the Private Branch eXchange (PBX) to determine what action to take with dialed digits.</descrip></descripGrp><ntig><termGrp><term id="233471">dial plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="610969">plan de marcado</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></