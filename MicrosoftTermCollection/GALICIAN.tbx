4_3091613_3092080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within Feed Management Tools that automatically publishes new partner feeds documents found when pulling for content periodically.</descrip></descripGrp><ntig><termGrp><term id="3091613">auto-publishing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3092080">publicación automática</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54205_3091617_3092084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that holds information about where and how to retrieve content from partner’s servers.</descrip></descripGrp><ntig><termGrp><term id="3091617">feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3092084">fonte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54206_3091621_3092095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feed where content is periodically pulled from the news feed.</descrip></descripGrp><ntig><termGrp><term id="3091621">pull feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gl"><ntig><termGrp><term id="3092095">fonte de extracción</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun<