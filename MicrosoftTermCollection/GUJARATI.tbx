IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1898_67709_495675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To load the program and installation files onto your computer or device so that the program runs correctly.</descrip></descripGrp><ntig><termGrp><term id="67709">install</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495675">સ્થાપિત કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1901_92735_495862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbolic value used in place of a real value that is unknown or unavailable at the current time, or that is not displayed for security reasons.</descrip></descripGrp><ntig><termGrp><term id="92735">placeholder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495862">પ્લેસહોલ્ડર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1902_57264_495617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Capable of using or being displayed on the full area of a display screen. Applications running in windowing environments, although they might use the entire area of the screen, commonly allocate different areas to different windows, any of which can be enlarged to fill the entire screen.</descrip></descripGrp><ntig><termGrp><term id="57264">full screen</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495617">સંપૂર્ણ સ્ક્રીન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1902_779009_495617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Capable of using or being displayed on the full area of a display screen. Applications running in windowing environments, although they might use the entire area of the screen, commonly allocate different areas to different windows, any of which can be enlarged to fill the entire screen.</descrip></descripGrp><ntig><termGrp><term id="779009">full-screen</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495617">સંપૂર્ણ સ્ક્રીન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1914_1060965_2290050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make an entity nonfunctional.</descrip></descripGrp><ntig><termGrp><term id="1060965">turn off</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2290050">બંધ કરો</term><termNote type="geographicalUsage">IND</termNote><termNote ty