owledge network based around relationships among topics, content, and people.</descrip></descripGrp><ntig><termGrp><term id="2887244">Project Cortex</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2888400">પ્રોજેક્ટ Cortex</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51164_2887245_2888401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The line an error gets underscored with in apps like Word or Outlook during spell check.</descrip></descripGrp><ntig><termGrp><term id="2887245">squiggle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2888401">અવ્યવસ્થિત</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51165_2887246_2888364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To orchestrate a collaboration session.</descrip></descripGrp><ntig><termGrp><term id="2887246">host</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2888364">હોસ્ટ કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51166