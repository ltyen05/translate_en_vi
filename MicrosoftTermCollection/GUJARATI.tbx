"definition">The feature of Bing that enables customers to block sites containing adult (sexually explicit) content. Customers can choose from three levels of filtering: strict (hides adult text and image results); moderate (hides adult images only); and off (doesn't hide any search results).</descrip></descripGrp><ntig><termGrp><term id="1766385">SafeSearch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2015550">SafeSearch</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33322_1768216_2867828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An enterprise-level subscription offering that includes online service versions of Word, PowerPoint, Excel, Outlook, OneNote, Access, Publisher, and Lync.</descrip></descripGrp><ntig><termGrp><term id="1768216">Office 365 ProPlus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2867828">એન્ટરપ્રાઇઝ માટે Microsoft 365 ઍપ્સ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33322_1777199_2867828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An enterprise-level subscription offering that includes online service versions of Word, PowerPoint, Excel, Outlook, OneNote, Access, Publisher, and Lync.</descrip></descripGrp><ntig><termGrp><term id="1777199">Microsoft Office 365 ProPlus</term><termNote typ