</descripGrp><ntig><termGrp><term id="2331305">LOB publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2335041">લાઇન-ઑફ-બિઝનેસ પ્રકાશક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40116_2331305_2335043"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person or business that makes line-of-business apps available to customers through an online market.</descrip></descripGrp><ntig><termGrp><term id="2331305">LOB publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2335043">LOB પ્રકાશક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40118_2331575_2335049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is licensed by a company in bulk for use by end users.</descrip></descripGrp><ntig><termGrp><term id="2331575">volume application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2335049">વૉલ્યૂમ એપ્લિકેશન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40121_2331937_2340608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An automatically generated filter list in Wunderlist (e.g. Today, Week, Assigned to me, Starred, All, and Completed Smart List) that shows all tasks from across all your task lists that meet the specific criteria.</descrip></descripGrp><ntig><termGrp><term id="2331937">smart list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2340608">સ્માર્ટ યાદી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40122_2331938_2340587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Mac OS X specific part of the app that allows Wunderlist to receive push notifications on the Mac.</descrip></descripGrp><ntig><termGrp><term id="2331938">Wunderlist Helper</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2340587">Wunderlist સહાયક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40123_2331939_2340607"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Wunderlist feature that allows users to enter due dates for a task as text (e.g. next Sunday), automatically recognize the date, and set a due date and reminder for the task.</descrip></descripGrp><ntig><termGrp><term id="2331939">Smart Due Dates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2340607">સ્માર્ટ કારણે તારીખો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40124_2332081_2340606"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that gives users information regarding the safety of a message via a colored bar inserted into the message.</descrip></descripGrp><ntig><termGrp><term id="2332081">Safety Tips</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2340606">સુરક્ષા ટિપ્સ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40126_2332083_2340595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows administrators to inform email senders that they may be about to violate one of the data loss prevention policies.</descrip></descripGrp><ntig><termGrp><term id="2332083">Policy Tips</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2340595">નીતિ ટિપ્સ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40162_2333642_2427368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI element that gives a user a view of the important email, as presorted by the Focused Inbox feature.</descrip></descripGrp><ntig><termGrp><term id="2333642">Focused</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2427368">ફોકસ કરાયેલ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40163_2333645_2340591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The email management approach developed by productivity expert Merlin Mann so that zero time is spent thinking about email without any of the five actions he identified.</descrip></descripGrp><ntig><termGrp><term id="2333645">Inbox Zero</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2340591">ઇનબૉક્સ શૂન્ય</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4017_397157_1957115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A storage platform that provides a single repository for managing multiple types of unstructured information in one infrastructure. The Exchange store combines the features and functionality of the file system, the Web, and a collaboration server (such as Microsoft Exchange) through a single, URL-addressable location for storing, accessing, and managing information, as well as building and running applications. The Exchange store is also known as the Web Storage System.</descrip></descripGrp><ntig><termGrp><term id="397157">Exchange store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957115">Exchange વેબ સેવાઓ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40226_2339682_2346913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that lets users draw someone's attention to an email message or calendar item by adding the @ symbol followed by the person's name to the body of the message or item. When this happens, the person will be notified automatically that they were mentioned.</descrip></descripGrp><ntig><termGrp><term id="2339682">Mentions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2346913">ઉલ્લેખો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40226_2339682_2678792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that lets users draw someone's attention to an email message or calendar item by adding the @ symbol followed by the person's name to the body of the message or item. When this happens, the person will be notified automatically that they were mentioned.</descrip></descripGrp><ntig><termGrp><term id="2339682">Mentions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNot