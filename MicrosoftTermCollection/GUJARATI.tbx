es for the element's Left and Top properties are relative to the upper-left corner of the element's parent.</descrip></descripGrp><ntig><termGrp><term id="136834">fixed positioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496100">ચોક્કસ સ્થિતિ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11113_136834_496101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Placement of an element relative to either the element's parent or, if there isn't one, the body. Values for the element's Left and Top properties are relative to the upper-left corner of the element's parent.</descrip></descripGrp><ntig><termGrp><term id="136834">fixed positioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496101">નિશ્ચિત સ્થિતિ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11115_502817_2344740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To notify by means of an alert that a particular event has occurred.</descrip></descripGrp><ntig><termGrp><term id="502817">alert</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2344740">ચેતવણી આપો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote