g password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957325">સશક્ત પાસવર્ડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11140_359992_497148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A table outside the open database or project.</descrip></descripGrp><ntig><termGrp><term id="359992">external table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="497148">બાહ્ય કોષ્ટક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11141_79960_1856493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The content that is delivered in an email message.</descrip></descripGrp><ntig><termGrp><term id="79960">message body</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856493">સંદેશ મુખ્ય ભાગ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11146_210474_1856649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The digital signature functionality including Digital Signatures, electronic signatures, Mark As Fi