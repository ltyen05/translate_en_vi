76_182566_496323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Web site that provides customers with access to a database of articles written by Microsoft Support professionals.</descrip></descripGrp><ntig><termGrp><term id="182566">Microsoft Knowledge Base</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496323">Microsoft નૉલૅજ બેસ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8279_143597_1856578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A movie clip that plays when the user opens a Web page, or when the pointer rests on a movie image, or in both instances, depending on the object's settings. Not all Web browsers support inline movies.</descrip></descripGrp><ntig><termGrp><term id="143597">inline movie</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856578">ઇનલાઇન મૂવી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="828_178555_2736882"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that is frequently accessed when using Business Contact Manager for Outlook and that is often listed on the Business Tools menu.</descrip></descripGrp><ntig><termGrp><term id="178555">business tool</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp>