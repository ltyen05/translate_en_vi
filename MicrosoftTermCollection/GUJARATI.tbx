Note type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1215313">સર્વર નામ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12685_233028_1792415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To hold back elements or modify the appearance of an existing list or data set in order to view a specific subset of the data.</descrip></descripGrp><ntig><termGrp><term id="233028">filter</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1792415">ફિલ્ટર કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12690_310997_496838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application that helps the user to activate a Windows product with Microsoft.</descrip></descripGrp><ntig><termGrp><term id="310997">Windows Activation Client</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496838">Windows એક્ટિવેશન ક્લાયંટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12695_253689_1792406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-byte, fixed-point data type that is useful for calculations involving money or for fixed-point calculations in which accuracy is extremely important. The Currency data type is used to store numbers with up to 15 digits to the left of the decimal point and 4 digits to the right. The type-declaration character in Microsoft© Visual Basic© is an at sign (@). Currency can range from -922,337,203,685,477.5808 to 922,337,203,685,477.5807.</descrip></descripGrp><ntig><termGrp><term id="253689">Currency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1792406">મુદ્રા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12695_374694_1792406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-byte, fixed-point data type that is useful for calculations involving money or for fixed-point calculations in which accuracy is extremely important. The Currency data type is used to store numbers with up to 15 digits to the left of the decimal point and 4 digits to the right. The type-declaration character in Microsoft© Visual Basic© is an at sign (@). Currency can range from -922,337,203,685,477.5808 to 922,337,203,685,477.5807.</descrip></descripGrp><ntig><termGrp><term id="374694">money</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1792406">મુદ્રા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12696_41116_495482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that calculates a sum, average, count, or other type of total on records, and then groups the result by two types of information: one down the left side of the datasheet and the other across the top.</descrip></descripGrp><ntig><termGrp><term id="41116">crosstab query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495482">ક્રૉસ ટૅબ ક્વેરી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12708_179577_496307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common drop-down menu that includes commands for file operations, such as Open, Save, and Print.</descrip></descripGrp><ntig><termGrp><term id="179577">File menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496307">ફાઇલ મેનૂ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12724_32944_1957031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time to which a clock is set.</descrip></descripGrp><ntig><termGrp><term id="32944">clock setting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957031">ઘડિયાળની સેટિંગ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech"