termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2485970">બેસબોર્ડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15383_81654_2485970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary circuit board in a computer that contains most of the basic components of the system.</descrip></descripGrp><ntig><termGrp><term id="81654">system board</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2485970">બેસબોર્ડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15384_178508_2344741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An order for a large quantity of products or services. The minimum quantity that qualifies as a bulk order is set by individual companies.</descrip></descripGrp><ntig><termGrp><term id="178508">bulk order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2344741">બલ્ક ઑર્ડર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15386_154964_496242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A delay of the amount of time that elapses before a character begins repeati