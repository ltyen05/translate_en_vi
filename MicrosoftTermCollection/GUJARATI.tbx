e="definition">A feature of Windows where a user's credentials are securely stored.</descrip></descripGrp><ntig><termGrp><term id="1667479">Credential Locker</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1676222">ક્રેડેંશિયલ લૉકર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32397_1667525_1679130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To take action on a message by either replying to the sender, to the sender and all recipients, or by forwarding the message to someone else.</descrip></descripGrp><ntig><termGrp><term id="1667525">respond</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1679130">પ્રતિસાદ આપો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32398_1672123_1857240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pane in the Outlook window that contains folders for each view, such as Mail or Calendar.</descrip></descripGrp><ntig><termGrp><term id="1672123">Folder Pane</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1857240">ફોલ્ડર ફલક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGe