Note><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31793_1623963_1857090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instance of Excel that has minimal UI and that enables a user to insert or edit chart data within the context of a non-Excel Office document.</descrip></descripGrp><ntig><termGrp><term id="1623963">Data Grid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1857090">ડેટા ગ્રિડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31794_1623978_1857091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The categories of assignments for a given class, along with a percentage value that indicates how much each category weighs into the overall grade. Other factors, such as class participation, may also be considered.</descrip></descripGrp><ntig><termGrp><term id="1623978">evaluation criteria</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1857091">મૂલ્યાંકન માપદંડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31795_1623979_1857092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of refining a search for information by filtering on individual properties