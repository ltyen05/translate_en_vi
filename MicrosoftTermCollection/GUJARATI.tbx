><termGrp><term id="27629">CAPS LOCK key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495373">CAPS LOCK</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1082_27629_495374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toggle key that, when on, shifts the alphabetic characters on the keyboard to uppercase.</descrip></descripGrp><ntig><termGrp><term id="27629">CAPS LOCK key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495374">CAPS LOCK કી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10824_139748_1856549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The list of animation sequences for a slide. Items are listed in the order in which they are added, and include icons that indicate timing in relation to other animation events.</descrip></descripGrp><ntig><termGrp><term id="139748">Custom Animation list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856549">કસ્ટમ ઍનિમેશન સૂચી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntr