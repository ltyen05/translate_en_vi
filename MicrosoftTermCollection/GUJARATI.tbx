mGrp></ntig></langSet></termEntry><termEntry id="8085_262737_2748154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication protocol that provides a mechanism for mutual authentication between a client and a server, or between one server and another, before a network connection is opened between them.</descrip></descripGrp><ntig><termGrp><term id="262737">Kerberos</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2748154">Kerberos</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8085_636858_2748154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication protocol that provides a mechanism for mutual authentication between a client and a server, or between one server and another, before a network connection is opened between them.</descrip></descripGrp><ntig><termGrp><term id="636858">Kerberos authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2748154">Kerberos</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8090_360150_497160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ActiveX Database Objects (ADO) object used to contain a result set. It also exhibits cursor behavior depending on the recordset properties set by an application. ADO recordsets are mapped to OLE DB rowsets.</descrip></descripGrp><ntig><termGrp><term id="360150">recordset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="497160">રેકોર્ડસેટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8095_117241_1856513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To send something in for consideration.</descrip></descripGrp><ntig><termGrp><term id="117241">submit</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856513">સબમિટ કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8099_265320_1856711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder where a collection of PowerPoint slides is shared.</descrip></descripGrp><ntig><termGrp><term id="265320">Slide Library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856711">સ્લાઇડ લાઇબ્રેરી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8102_42162_1788279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short horizontal line used as a punctuation mark.</descrip></descripGrp><ntig><termGrp><term id="42162">dash</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1788279">ડૅશ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8115_66527_1215269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain controller that holds the infrastructure operations master role in Active Directory. The infrastructure master updates the group-to-user reference whenever group memberships change and replicates these changes across the domain. At any time, the infrastructure master role can be assigned to only one domain controller in each domain.</descrip></descripGrp><ntig><termGrp><term id="66527">infrastructure master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1215269">ઇન્ફ્રાસ્ટ્રકચર માસ્ટર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8120_375742_1957116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that provides a programming interface for accessing Microsoft Exchange data through the Client Access server role by using Web services.</descrip></descripGrp><ntig><termGrp><term id="375742">Exchange Web Services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957116">બાહ્ય સંપર્ક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8123_234529_1944497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic that indicates follow-up action is required, or otherwise identifies an important item.</descrip></descripGrp><ntig><termGrp><term id="234529">flag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1944497">ફ્લેગ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8125_359995_497149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that uses a minimum amount of data to display the general layout of a report.</descrip></descripGrp><ntig><termGrp><term id="359995">Layout Preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="497149">લેઆઉટ પૂર્વાવલોકન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8136_396927_1792412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A World Wide Web Consortium specification that describes the structure of dynamic HTML and XML documents in a way that allows them to be manipulated through a Web browser.</descrip></descripGrp><ntig><termGrp><term id="396927">Document Object Model</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1792412">DOM</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8136_396927_1957085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A World Wide Web Consortium specification that describes the structure of dynamic HTML and XML documents in a way that allows them to be manipulated through a Web browser.</descrip></descripGrp><ntig><termGrp><term id="396927">Document Object Model</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957085">ડોમેન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8136_396928_1792412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A World Wide Web Consortium specification that describes the structure of dynamic HTML and XML documents in a way that allows them to be manipulated through a Web browser.</descrip></descripGrp><ntig><termGrp><term id="396928">DOM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1792412">DOM</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8136_396928_1957085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A World Wide Web Consortium specification that describes the structure of dynamic HTML and XML documents in a way that allows them to be manipulated through a Web browser.</descrip></descripGrp><ntig><termGrp><term id="396928">DOM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957085">ડોમેન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8150_212894_496399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu containing important and frequently used programs, folders, and utilities. To open the Start menu, click the Start button on the taskbar.</descrip></descripGrp><ntig><termGrp><term id="212894">Start menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496399">શરૂઆત મેનૂ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8152_1275531_1215270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The certification authority which issued the certificate to the subject.</descrip></descripGrp><ntig><termGrp><term id="1275531">issuer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1215270">પ્રમાણપત્ર આપનાર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8152_29615_1215270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The certification authority which issued the certificate to the subject.</descrip></descripGrp><ntig><termGrp><term id="29615">certificate issuer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1215270">પ્રમાણપત્ર આપનાર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8156_232394_496435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Appears to the left of a meeting or appointment (or all the way around the item when selected), indicating time status as free, tentative, busy, out of office, or no information available. Visible only in Day and Work Week view.</descrip></descripGrp><ntig><termGrp><term id="232394">availability indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496435">ઉપલબ્ધતા સૂચક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8160_16016_1216344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To include an external document, a file, or an executable program with a message.</descrip></descripGrp><ntig><termGrp><term id="16016">attach</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1216344">જોડો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8160_16016_495291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To include an external document, a file, or an executable program with a message.</descrip></descripGrp><ntig><termGrp><term id="16016">attach</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495291">સંલગ્ન કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8180_319923_496981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To suppress the sound produced by a device or application.</descrip></descripGrp><ntig><termGrp><term id="319923">mute</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496981">મ્યૂટ કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8188_46307_1957074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that provides access to data and objects in a directory or network environment.</descrip></descripGrp><ntig><termGrp><term id="46307">directory service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957074">ડાયરેક્ટરી સેવા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8196_146580_1792442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic file format that is supported by some World Wide Web browsers. PNG supports variable transparency of images (alpha channels) and control of image brightness on different computers (gamma correction). PNG files are compressed bitmaps.</descrip></descripGrp><ntig><termGrp><term id="146580">Portable Network Graphics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1792442">PNG</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8196_146581_1792442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic file format that is supported by some World Wide Web browsers. PNG supports variable transparency of images (alpha channels) and control of image brightness on different computers (gamma correction). PNG files are compressed bitmaps.</descrip></descripGrp><ntig><termGrp><term id="146581">PNG</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1792442">PNG</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="82_6483_2998514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The magnitude of a number, irrespective of its sign (+ or -). An absolute value is always greater than or equal to zero. For example, 10 is the absolute value of 10 and of -10. Programming languages and spreadsheet programs commonly include functions that return the absolute value of a number.</descrip></descripGrp><ntig><termGrp><term id="6483">absolute value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2998514">સંપૂર્ણ મૂલ્ય</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="820_210484_1856654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove the digital signature added to the document.</descrip></descripGrp><ntig><termGrp><term id="210484">un-sign</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856654">બિન-હસ્તાક્ષરિત કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8200_41830_495487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar that you create for your application.</descrip></descripGrp><ntig><termGrp><term id="41830">custom toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495487">કસ્ટમ ઉપકરણ પટ્ટી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8206_346965_497096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Strength exerted; might.</descrip></descripGrp><ntig><termGrp><term id="346965">power</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="497096">ઘાત</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="821_39300_495469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Management of a computer and its processing abilities so as to maintain order as tasks and activities are carried out. Control applies to measures designed to ensure error-free actions carried out at the right time and in the right order relative to other data-handling or hardware-based activities.</descrip></descripGrp><ntig><termGrp><term id="39300">control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495469">નિયંત્રણ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8218_231957_1944494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PivotTable report that supplies the source data to the PivotChart report. It is created automatically when you create a new PivotChart report. When you change the layout of either report, the other also changes.</descrip></descripGrp><ntig><termGrp><term id="231957">associated PivotTable report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1944494">સંબંધિત PivotTable રિપોર્ટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="823_144037_496170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of buttons representing hyperlinks to pages both within a Web site and to external sites.</descrip></descripGrp><ntig><termGrp><term id="144037">link bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496170">લિંક પટ્ટી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="824_129372_496048"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of or pertaining to a device or service that appears to the user as something it actually is not or that does not physically exist.</descrip></descripGrp><ntig><termGrp><term id="129372">virtual<