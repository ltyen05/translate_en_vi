crosoft 365 Enterprise users to streamline communication, collaboration, and meeting-related tasks using spoken natural language.</descrip></descripGrp><ntig><termGrp><term id="3059307">Cortana voice assistance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="3060292">Cortana વૉઇસ આસિસ્ટન્સ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53730_3059308_3060295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to join a third-party online meeting from their Teams Rooms just as easily as they can join meetings hosted in Teams.</descrip></descripGrp><ntig><termGrp><term id="3059308">Direct Guest Join</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="3060295">ડાયરેક્ટ ગેસ્ટ જોઇન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53731_3059309_3060297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera that supports AI-powered active speaker tracking, multiple video streams, and people recognition.</descrip></descripGrp><ntig><termGrp><term id="3059309">intelligent camera</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="3060297">સમજદાર કૅમેરા</term><termNote type="geographicalUsage">I