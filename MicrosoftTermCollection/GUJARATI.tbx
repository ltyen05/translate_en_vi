Note type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26685_1380060_1462779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display name UI label used when there isn’t a display name value available, as when data can't be retrieved or someone hasn’t completely filled out their profile.</descrip></descripGrp><ntig><termGrp><term id="1380060">Someone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1462779">કોઈ વ્યક્તિ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26686_1346464_1358224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The label for the Windows Live Devices task webpage where someone specifies a name and an icon for the computer that they plan to sync.</descrip></descripGrp><ntig><termGrp><term id="1346464">Personalize</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358224">પર્સનલાઇઝ કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26687_1346465_1358249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The group label for the links that provide one-click access to a subset of email messages based on specific criteria, such as flagged, containing photos, and from social networking services.</descrip></descripGrp><ntig><termGrp><term id="1346465">Quick views</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358249">ઝડપી દૃશ્યો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2669_153111_496235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of bits transmitted every second, used as a measure of the speed at which a device, such as a modem, can transfer data.</descrip></descripGrp><ntig><termGrp><term id="153111">bits per second</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496235">બિટ્સ પ્રતિ સેકન્ડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2669_153111_496236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of bits transmitted every second, used as a measure of the speed at which a device, such as a modem, can transfer data.</descrip></descripGrp><ntig><termGrp><term id="153111">bits per second</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496236">bps</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2669_153112_496235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of bits transmitted every second, used as a measure of the speed at which a device, such as a modem, can transfer data.</descrip></descripGrp><ntig><termGrp><term id="153112">bps</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496235">બિટ્સ પ્રતિ સેકન્ડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2669_153112_496236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of bits transmitted every second, used as a measure of the speed at which a device, such as a modem, can transfer data.</descrip></descripGrp><ntig><termGrp><term id="153112">bps</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496236">bps</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26690_1347061_1358573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for the Hotmail quick view that displays only the email messages that originate from a social networking service such as Facebook.</descrip></descripGrp><ntig><termGrp><term id="1347061">Social updates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358573">સામાજિક અપડેટ્સ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26691_1347063_1358575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The spam-fighting program that Hotmail runs where actual customers classify email messages as "junk" or "not junk." Because the program is by invitation only, customers who participate are highly engaged. The Hotmail team reported in 2010 that more than half of the spam fighters participate daily. Invitations to the program are extended to a cross-section of customers who reflect the broad population of Hotmail customers in several dimensions, including age of account and country or region. Under the program, Hotmail resends an actual message that was addressed to the spam fighter. One message per day at the most is sent.</descrip></descripGrp><ntig><termGrp><term id="1347063">Spam Fighters program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358575">સ્પામ ફાઇટર્સ પ્રોગ્રામ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26691_1354361_1358575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The spam-fighting program that Hotmail runs where actual customers classify email messages as "junk" or "not junk." Because the program is by invitation only, customers who participate are highly engaged. The Hotmail team reported in 2010 that more than half of the spam fighters participate daily. Invitations to the program are extended to a cross-section of customers who reflect the broad population of Hotmail customers in several dimensions, including age of account and country or region. Under the program, Hotmail resends an actual message that was addressed to the spam fighter. One message per day at the most is sent.</descrip></descripGrp><ntig><termGrp><term id="1354361">Feedback Loop program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358575">સ્પામ ફાઇટર્સ પ્રોગ્રામ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26692_1347064_1358183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rating system for online games.</descrip></descripGrp><ntig><termGrp><term id="1347064">game rating system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358183">ગેમ રેટિંગ સિસ્ટમ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26696_1347068_1358579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conversation that is displayed with other conversations in one window. The conversations are loaded into sections or tabs of the window, rather than in multiple windows.</descrip></descripGrp><ntig><termGrp><term id="1347068">tabbed conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358579">ટૅબ કરેલી વાતચીત</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26697_1347069_1358571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The webpage subheading for the view in Messenger that displays the social activity of friends.</descrip></descripGrp><ntig><termGrp><term id="1347069">social</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358571">સામાજિક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26698_1347070_1358190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label in Messenger for the aspect of the social view that displays prioritized recent social activity of friends.</descrip></descripGrp><ntig><termGrp><term id="1347070">highlights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358190">હાઇલાઇટ્સ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26699_1347071_1358231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email message that has image attachements, inline images, inline video, or an inline album.</descrip></descripGrp><ntig><termGrp><term id="1347071">photo e-mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358231">ફોટો ઈ-મેલ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26700_1347072_1369509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom-created layout of photos in an album.</descrip></descripGrp><ntig><termGrp><term id="1347072">arrangement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1369509">ગોઠવણ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26702_1347074_1358563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets you work on your computer from a different computer.</descrip></descripGrp><ntig><termGrp><term id="1347074">remote connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358563">રિમોટ કનેક્શન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26703_1347075_1358221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tooltip that is displayed when hovering over a personal folder on the Manage Folders webpage.</descrip></descripGrp><ntig><termGrp><term id="1347075">Personal Folder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358221">વ્યક્તિગત ફોલ્ડર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26704_1347076_1358578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The webpage subheading for the list of synced folders.</descrip></descripGrp><ntig><termGrp><term id="1347076">Synced folders</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358578">સિંક્રનાઇઝ્ડ ફોલ્ડર્સ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26705_1347077_1358191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI element that allows users to set permissions for an item or content so that is not made available to anyone else, thus making it private.</descrip></descripGrp><ntig><termGrp><term id="1347077">Just me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358191">ફક્ત મને</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26706_1347078_1358209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for the social activity stream that Windows Live programmatically displays in a collection. Items listed may originate within a Windows Live program, service, or landing page (Messenger, OneDrive, Windows Live Photos), or in third-party activities people connect to their profiles, such as Facebook.</descrip></descripGrp><ntig><termGrp><term id="1347078">Messenger social</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358209">Messenger સામાજિક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26707_1347079_1358077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To manually edit and make adjustments to your photos.</descrip></descripGrp><ntig><termGrp><term id="1347079">fine tune</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358077">સમાયોજિત કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26708_1347080_1358185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A metadata tag that includes GPS latitude and longitude coordinates to specify a location. Geotags are typically used to find and organise photos and videos.</descrip></descripGrp><ntig><termGrp><term id="1347080">geotag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358185">જીઓટૅગ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26709_1347081_1358570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To present items within a set in no established order, as opposed to ordering items by name, by date taken, by size, etc., and typically used with audio and visual media, such as album song order or photo slide shows.</descrip></descripGrp><ntig><termGrp><term id="1347081">shuffle</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358570">શફલ કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26710_1347082_1358577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to share stories with others using their digital photos and photo management software.</descrip></descripGrp><ntig><termGrp><term id="1347082">storytelling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358577">વાર્તા કથન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26714_1347086_1358761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a personal touch to something.</descrip></descripGrp><ntig><termGrp><term id="1347086">personalize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358761">પર્સનલાઇઝ કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26719_1347108_1358253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that provides one-click access to a subset of email messages based on specific criteria, which include: flagged (messages that the customer has designated as requiring follow-up), photos (messages that contain photos), and social updates (messages that originate from a social networking service such as Facebook).</descrip></descripGrp><ntig><termGrp><term id="1347108">quick view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358253">ઝડપી દૃશ્ય</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26720_1347110_1358178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The webpage subheading for the view in Messenger that displays someone's friends and contacts that aren't friends but that can be interacted with in Messenger (those are often legacy entries).</descrip></descripGrp><ntig><termGrp><term id="1347110">friends</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358178">મિત્ર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26728_1354362_1462727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Hotmail that's designed to help people get more done on the web without having to leave their inbox. Active View displays directly in the body of the email message, showing either previews to other web content or interactive elements created by the sender that let the recipient complete core tasks. A preview message example might include a reference to a file on a photo-sharing or video-sharing website that the recipient can view in the message, or package-tracking information that's extracted from a shipping website. Interactive scenarios might include rating movies and updating wish lists on movie-rental websites or responding to invitations or comments on social networking websites.</descrip></descripGrp><ntig><termGrp><term id="1354362">Active View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1462727">સક્રિય દ્રશ્ય</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26731_1354365_1857016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An equation written using a stylus on a Tablet PC.</descrip></descripGrp><ntig><termGrp><term id="1354365">ink equation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1857016">ઇંક સમીકરણ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26735_1354369_1988951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is meant to run on a desktop or laptop computer.</descrip></descripGrp><ntig><termGrp><term id="1354369">desktop application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1988951">ડેસ્કટૉપ પ્રોગ્રામ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26735_1505030_1988951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is meant to run on a desktop or laptop computer.</descrip></descripGrp><ntig><termGrp><term id="1505030">desktop app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1988951">ડેસ્કટૉપ પ્રોગ્રામ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26735_1986256_1988951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is meant to run on a desktop or laptop computer.</descrip></descripGrp><ntig><termGrp><term id="1986256">desktop program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1988951">ડેસ્કટૉપ પ્રોગ્રામ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26737_1354381_1358584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that gives users a rich way to send video messages asynchronously to another user.</descrip></descripGrp><ntig><termGrp><term id="1354381">Video Messages</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358584">વિડિયો સંદેશા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26737_1815478_1358584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that gives users a rich way to send video messages asynchronously to another user.</descrip></descripGrp><ntig><termGrp><term id="1815478">video messages</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358584">વિડિયો સંદેશા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Pro