ech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2327118">ચેતવણી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27852_1465584_2607855"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collective of attack vectors through which a system can be attacked successfully.</descrip></descripGrp><ntig><termGrp><term id="1465584">attack surface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2607855">સંવેદનશીલ ક્ષેત્ર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27934_1468118_2624398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view where the preview area is centered and the thumbnails that immediately precede and follow the current thumbnail are adjacent to the preview area.</descrip></descripGrp><ntig><termGrp><term id="1468118">carousel view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2624398">કરાઉઝલ દૃશ્ય</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2795_60402_1957130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Depending on values embedded in the program code rather than on values that can be input and changed by the user.</descrip></descripGrp><ntig><termGrp><term id="60402">hard-coded</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957130">હાર્ટબીટ ઇન્ટરવલ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2796_3846_495216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Self-propagating malicious software that can automatically distribute itself from one computer to another through network connections. A worm can take harmful action, such as consuming network or local system resources, possibly causing a denial of service attack.</descrip></descripGrp><ntig><termGrp><term id="3846">worm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495216">વર્મ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28_2656622_2657653"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of the user interface (UI) in Outlook Web Access that can be hosted in iframes as part of other Web applications such as SharePoint Portal Server portals. Outlook Web Access exposes a set of Outlook Web Access Web Part URLs that allow other applications to request certain portions of the Outlook Web Access UI. For example, another application can load the Outlook Web Access Web Part URL for the Inbox, Calendar, or Contact folder into an iframe hosted in that application.</descrip></descripGrp><ntig><termGrp><term id="2656622">Outlook Web App Web Part</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2657653">Outlook Web App વેબ પાર્ટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="280_114555_495959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To organize information, such as a list of files, in a particular order. For example, a list of files can be sorted alphabetically by name in ascending or descending order.</descrip></descripGrp><ntig><termGrp><term id="114555">sort</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495959">સૉર્ટ કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2803_232424_1856682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The list of tasks in Calendar.</descrip></descripGrp><ntig><termGrp><term id="232424">TaskPad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856682">ટાસ્કપેડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNot