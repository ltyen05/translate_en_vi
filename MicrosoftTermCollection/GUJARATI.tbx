Selected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33718_1814245_2065614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that appears when a user is signed in to his/her account but elects to appear as if they are offline to any contacts, but that also allows him/her to receive IMs.</descrip></descripGrp><ntig><termGrp><term id="1814245">Invisible</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2065614">અદૃશ્ય</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3372_359704_1215199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type used to hold date and time information.</descrip></descripGrp><ntig><termGrp><term id="359704">Date/Time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1215199">તારીખ/સમય</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3372_374687_1215199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type used to hold date and time information.</descrip></descripGrp><ntig><termGrp><term id="374687">datetime</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1215199">તારીખ/સમય</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33720_1814248_2065620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that indicates a user is signed out of his/her account and that he/she is not able to receive calls or IMs.</descrip></descripGrp><ntig><termGrp><term id="1814248">Offline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2065620">ઑફલાઇન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33721_1814249_2065621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that indicates a user is signed in to his/her account.</descrip></descripGrp><ntig><termGrp><term id="1814249">Online</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2065621">ઑનલાઇન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33722_1814262_2065649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype product that allows a user to call directly to Skype from landlines and mobile phones.</descrip></descripGrp><ntig><termGrp><term id="1814262">Skype Number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2065649">Skype નંબર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33723_1814251_2065650"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An organization that cooperates with Skype; the cooperation ranges from developing mutual software to selling products specially tailored for the organization.</descrip></descripGrp><ntig><termGrp><term id="1814251">Skype partner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2065650">Skype પાર્ટનર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33724_1814252_2065622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To pay for a paid feature at the moment the feature is used. For example, to pay for Skype's calling phones feature with Skype Credit that is either already owned or purchased specially for the occasion.</descrip></descripGrp><ntig><termGrp><term id="1814252">pay as you go</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2065622">તમે જાઓ ત્યારે ચૂકવો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33725_1814253_2065624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To pay once a month for using Skype paid features such as calling phones or sending SMS messages; e.g., to pay for a monthly subscription.</descrip></descripGrp><ntig><termGrp><term id="1814253">pay monthly</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2065624">મહિને ચૂકવો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33726_1814254_2065625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to preview photos and send them to contacts.</descrip></descripGrp><ntig><termGrp><term id="1814254">photo sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2065625">ફોટો સહિયારીકરણ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33727_1814255_2065630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conversation that is open for all Skype users to join.</descrip></descripGrp><ntig><termGrp><term id="1814255">public chat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2065630">સાર્વજનિક ચેટ</term><termNote type="geographicalUsage">IND</t