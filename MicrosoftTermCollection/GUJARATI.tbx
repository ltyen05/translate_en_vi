65 શિક્ષણ E3 તકનીકી પૂર્વાવલોકન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43578_2816012_2955310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Office 365 for education that also includes email, instant messaging, HD video Conferencing, 1 TB personal file storage and sharing, advanced security, analytics and PSTN conferencing and that is targeted at faculty. Includes all the features in A3 plus Microsoft’s best-in-class intelligent security management, advanced compliance, and analytics systems.</descrip></descripGrp><ntig><termGrp><term id="2816012">Office 365 A5 for faculty and staff</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2955310">શિક્ષક અને સ્ટાફ માટે Office 365 A5</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43579_2816011_2955312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Office 365 for Education that also includes email, instant messaging, HD video conferencing, 1 TB personal file storage and sharing, advanced security, analytics and PSTN conferencing and that is targeted at university students.</descrip></descripGrp><ntig><termGrp><term id="2816011">Office 365 A5 for students</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2955312">વિદ્યાર્થી માટે Office 365 A5</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43580_2464259_2955324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Office 365 Education E5 for faculty that does not include PSTN conferencing.</descrip></descripGrp><ntig><termGrp><term id="2464259">Office 365 Education E5 without PSTN Conferencing for faculty</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2955324">શિક્ષક માટે PSTN કૉન્ફરેન્સિંગ વગરનો Office 365 શિક્ષણ E5</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43581_2464274_2955325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Office 365 Education E5 for university students that does not include PSTN conferencing.</descrip></descripGrp><ntig><termGrp><term id="2464274">Office 365 Education E5 without PSTN Conferencing for students</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2955325">વિદ્યાર્થી માટે PSTN કૉન્ફરેન્સિંગ વગરનો Office 365 શિક્ષણ E5</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43582_2464277_2927086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app destination for solutions that extend the capabilities of the technology you already own.</descrip></descripGrp><ntig><termGrp><term id="2464277">Microsoft AppSource</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2927086">Microsoft AppSource</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43582_2464281_2927086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app destination for solutions that extend the capabilities of the technology you already own.</descrip></descripGrp><ntig><termGrp><term id="2464281">AppSource</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2927086">Microsoft AppSource</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43583_2464280_2955328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Office 365 Education Plus that is targeted at students and available for purchase through the User purchase subscription program.</descrip></descripGrp><ntig><termGrp><term id="2464280">Office 365 Education Plus for students (user purchased)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2955328">વિદ્યાર્થી માટે Office 365 શિક્ષણ પ્લસ (ઉપયોગકર્તા ખરીદી)</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43608_2464387_2466641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI screen that appears in the Network flyout when a paid Wi-Fi hotspot is in range and paid Wi-Fi plans are available from Windows Store. A customer can then tap Connect with a data plan to open the Paid Wi-Fi &amp; Cellular app, choose a paid Wi-Fi data plan that’s offered from Windows Store, and then buy a plan using the payment information that’s stored in their Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2464387">Connect with a data plan</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2466641">ડેટા પ્લાન સાથે કનેક્ટ કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4362_153205_496237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-speed Internet connection. Broadband connections are typically 256 kilobytes per second (KBps) or faster.</descrip></descripGrp><ntig><termGrp><term id="153205">broadband connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496237">બ્રૉડબૅંન્ડ કનેક્શન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43627_2465102_2470685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any very simple computer program that outputs or displays the words "Hello World" in some form to the user. Such a program is often created as an example, to introduce the basic syntax of a programming language to students or others new to that language.</descrip></descripGrp><ntig><termGrp><term id="2465102">Hello World</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2470685">Hello World</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43628_2781062_2782325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for OneDrive for Business that includes Office Online and that is available through the User purchase subscription program.</descrip></descripGrp><ntig><termGrp><term id="2781062">OneDrive for Business with Office on the web (user purchased)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2782325">વેબ પર Office ની સાથે OneDrive for Business (ઉપયોગકર્તા ખરીદી)</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43662_2465860_2518787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web application on Xbox.com that allows Xbox One or PC gamers to 