ds.</descrip></descripGrp><ntig><termGrp><term id="2387241">Microsoft Rewards</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2507057">Microsoft Rewards</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42173_2387241_2507059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that rewards users based on their usage of Microsoft products and allows users to manage, redeem, and showcase their rewards.</descrip></descripGrp><ntig><termGrp><term id="2387241">Microsoft Rewards</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2507059">Rewards</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42173_2387242_2507057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that rewards users based on their usage of Microsoft products and allows users to manage, redeem, and showcase their rewards.</descrip></descripGrp><ntig><termGrp><term id="2387242">Rewards</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2507057">Microsoft Rewards</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNot