rp></ntig></langSet></termEntry><termEntry id="15806_319155_496968"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The symbol or character used to indicate that a word, phrase, symbol, or design is a registered trademark.</descrip></descripGrp><ntig><termGrp><term id="319155">REGISTERED SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496968">નોંધાયેલ ટ્રેડમાર્ક પ્રતીક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15814_140706_496145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window that shows the design of these database objects - tables, queries, forms, reports, macros, and data access pages. In Design view, you can create new database objects and modify the design of existing ones.</descrip></descripGrp><ntig><termGrp><term id="140706">Design view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496145">ડિઝાઇન દૃશ્ય</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15817_308348_496818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A label for a geographic selection.</descrip></descripGrp><ntig><termGrp><term id="308348">State/Region</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496818">રાજ્ય/ક્ષેત્ર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15818_234305_496471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form component, such as a template part or ActiveX control, that isn't included with InfoPath by default. Form designers can add or remove custom controls by using the Controls task pane.</descrip></descripGrp><ntig><termGrp><term id="234305">custom control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496471">કસ્ટમ નિયંત્રણ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15834_83662_495798"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of an application window that enables the user to navigate quickly to different parts of the program.</descrip></descripGrp><ntig><termGrp><term id="83662">navigation pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495798">નેવિગેશન ફલક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15842_210445_1428480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that verifies the technology is compatible with the target browser.</descrip></descripGrp><nti