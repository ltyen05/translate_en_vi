ry><termEntry id="1740_231978_1856667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For automatic subtotals and worksheet outlines, all rows or columns that summarize detail data. Summary data usually is adjacent to and below the detail data.</descrip></descripGrp><ntig><termGrp><term id="231978">summary data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856667">સારાંશ ડેટા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1741_128742_2590752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Teleconferencing in which video images are transmitted among the various geographically separated participants in a meeting.</descrip></descripGrp><ntig><termGrp><term id="128742">video conferencing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2590752">વિડિયો કૉન્ફરન્સિંગ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17419_645117_1428487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of reusable settings that describes the shared attributes and behaviors of a list item, a document, or a folder.</descrip></descripGrp><ntig><termGrp><term id="645117">content type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id