">master boot code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1748143">માસ્ટર બૂટ કોડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3117_109079_495933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Protection of a computer system and its data from harm or loss.</descrip></descripGrp><ntig><termGrp><term id="109079">security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495933">સુરક્ષા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3117_747373_495933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Protection of a computer system and its data from harm or loss.</descrip></descripGrp><ntig><termGrp><term id="747373">network security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495933">સુરક્ષા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3127_140864_1856558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone number format for dialing internal, operator, or emergency numbers