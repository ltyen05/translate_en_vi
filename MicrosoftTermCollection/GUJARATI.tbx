></ntig></langSet></termEntry><termEntry id="44609_2509123_2645340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A structured message that captures business data, allows users to respond and interact with the data, and provides an aggregation framework on the data.</descrip></descripGrp><ntig><termGrp><term id="2509123">Kaizala Action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2645340">સંદેશ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44609_2643390_2642689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A structured message that captures business data, allows users to respond and interact with the data, and provides an aggregation framework on the data.</descrip></descripGrp><ntig><termGrp><term id="2643390">Action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2642689">Kaizala સંદેશ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44609_2643390_2645340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A structured message that captures business data, allows users to respond and interact with the data, and provides an aggregation framework on the data.</descrip></descripGrp><ntig><termGrp><term id="2643390">Action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2645340">સંદેશ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44611_2509173_2515071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to compose and save a message as a template, and then reuse it when they want to.</descrip></descripGrp><ntig><termGrp><term id="2509173">Email templates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2515071">ઈમેલ ટેમ્પલેટ્સ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4462_72367_495702"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The core of layered architecture that manages the most basic operations of the operating system and the computer's processor. The kernel schedules different blocks of executing code, called threads, for the processor to keep it as busy as possible and coordinates multiple processors to optimize performance. The kernel also synchronizes activities among Executive-level subcomponents, such as I/O Manager and Process Manager, and handles hardware exceptions and other hardware-dependent functions. The kernel works closely with the hardware abstraction layer.</descrip></descripGrp><ntig><termGrp><term id="72367">kernel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495702">કર્નેલ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44646_2897501_2898008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that helps protect your enterprise hybrid environments from multiple types of advanced targeted cyber attacks and insider threats.</descrip></descripGrp><ntig><termGrp><term id="2897501">Microsoft Defender for Identity</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2898008">Identity માટે Microsoft Defender</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44647_2513424_2519417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To take an existing story in the Photos app and generate a new version of that story with edits to content, style, music, and other options.​</descrip></descripGrp><ntig><termGrp><term id="2513424">remix</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2519417">રિમિક્સ બનાવો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44648_2513444_2519418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Groove Music app, a graphical display that changes colors and shapes on the screen in response to the music that is playing. The user can choose from several different visualizers, which each look different.</descrip></descripGrp><ntig><termGrp><term id="2513444">visualizer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2519418">વિઝ્યુઅલાઇઝર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44668_2515502_2519413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The setting (toggle) on account.microsoft.com/family that, when switched on, requires children to get adult permission for the things they buy in the Windows and Xbox stores — except for what they get with gift cards or money in their Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2515502">Ask a parent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2519413">પેરેન્ટને પૂછવું</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44669_2515503_2519414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of Microsoft Defender Advanced Threat Protection, which helps protect the data in the specified folder locations from modification by suspicious or malicious apps.</descrip></descripGrp><ntig><termGrp><term id="2515503">controlled folder access</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2519414">ફોલ્ડરની નિયંત્રિત ઍક્સેસ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44670_2515507_2519415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Groove Music that allows the sound in specified frequency bands to be amplified or reduced, in order to adjust the quality and character of the sound.​</descrip></descripGrp><ntig><termGrp><term id="2515507">equalizer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2519415">ઇક્વેલાઇઝર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44671_2515527_2568336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of people who uses or shares a common language or dialect and contributes to language-related activities for Windows features.</descrip></descripGrp><ntig><termGrp><term id="2515527">Language Community</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2568336">ભાષા સમુદાય</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44672_2515529_2568337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section in the Feedback Hub app where users can organize language-related activities for their Language community.</descrip></descripGrp><ntig><termGrp><term id="2515529">Language Community tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2568337">ભાષા સમુદાય ટૅબ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44676_2515692_2517635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that generates Office 365 reports using SharePoint on-premises diagnostic and usage logs so that administrators can manage their infrastructure more efficiently.</descrip></descripGrp><ntig><termGrp><term id="2515692">SharePoint Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2517635">SharePoint Insights</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="447_51731_1215788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that lists errors that were encountered during an operation.</descrip></descripGrp><ntig><termGrp><term id="51731">error log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id