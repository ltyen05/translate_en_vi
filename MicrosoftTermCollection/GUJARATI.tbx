oun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2739664">શિફ્ટની ઑફર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42429_2400543_2739667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request from one employee to another to trade shifts with each other.</descrip></descripGrp><ntig><termGrp><term id="2400543">shift swap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2739667">શિફ્ટની અદલાબદલી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42430_2400558_2739671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The StaffHub view where users can ask another employee to do a shift swap with them.</descrip></descripGrp><ntig><termGrp><term id="2400558">Swap my shift</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2739671">મારી શિફ્ટની અદલાબદલી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42431_2400569_2739652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The StaffHub view where users can re