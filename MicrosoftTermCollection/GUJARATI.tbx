ntig><termGrp><term id="397187">offline address book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957226">OAB</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14922_397188_1856725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snapshot of information from an address book that has been downloaded so that an Outlook user can access it while disconnected from the server. It contains the properties of a user, such as email addresses, that Outlook requires to send an email message and display information about the sender.</descrip></descripGrp><ntig><termGrp><term id="397188">OAB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856725">ઑફલાઇન સરનામા પુસ્તિકા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14922_397188_1957226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snapshot of information from an address book that has been downloaded so that an Outlook user can access it while disconnected from the server. It contains the properties of a user, such as email addresses, that Outlook requires to send an email message and display information about the sender.</descrip></descripGrp><ntig><termGrp><term id="397188">OAB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><