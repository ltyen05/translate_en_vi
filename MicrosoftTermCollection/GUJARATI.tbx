ech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2280974">નેવિગેશન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39210_2399532_2280974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway panel that gives users a set of options for changing their sway’s interaction and Structure.</descrip></descripGrp><ntig><termGrp><term id="2399532">Layout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2280974">નેવિગેશન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39211_2276525_2281002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process where an organization defines a subset of employee communications that must be reviewed by an audit group, to ensure that the organization is complying with all relevant laws, regulations, and policies.</descrip></descripGrp><ntig><termGrp><term id="2276525">Supervisory Review</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2281002">સુપર્વાઇઝરી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39212_2276526_2281000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Sway features that are driven by an intelligence platform and that makes suggestions on how to edit, use, or add content based on what’s in the user’s sway.</descrip></descripGrp><ntig><termGrp><term id="2276526">Suggested</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2281000">સૂચવેલ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39213_2276529_2280969"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint site that allows users to publish a collection of responsive pages with embedded document references and organize them with a cover page and permissions.</descrip></descripGrp><ntig><termGrp><term id="2276529">microsite</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2280969">માઇક્રોસાઇટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39229_2277489_2280963"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Structure and Style choice for a sway that is initially made by the user, which Sway will remember and intelligently implement based upon content, prior behavior, and abstract expressions of intent.</descrip></descripGrp><ntig><termGrp><term id="2277489">design lever</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2280963">ડિઝાઇન લીવર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3923_215040_2700974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common interface between transport-level applications, such as Microsoft Remote Procedure Call (RPC), and security support providers (SSPs), such as Windows Distributed Security. SSPI allows a transport application to call one of the SSPs to obtain an authenticated connection. These calls do not require extensive knowledge of the security protocol's details.</descrip></descripGrp><ntig><termGrp><term id="215040">Security Support Provider Interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2700974">SSPI</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3923_215041_2700974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common interface between transport-level applications, such as Microsoft Remote Procedure Call (RPC), and security support providers (SSPs), such as Windows Distributed Security. SSPI allows a transport application to call one of the SSPs to obtain an authenticated connection. These calls do not require extensive knowledge of the security protocol's details.</descrip></descripGrp><ntig><termGrp><term id="215041">SSPI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2700974">SSPI</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39255_2277611_2279773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button on the Sway homepage that takes users to the My Sways webpage.</descrip></descripGrp><ntig><termGrp><term id="2277611">My Sways</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2279773">મારા Sways</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39256_2277617_2287611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pane that holds cross-suite experiences including global notifications, Skype for business conversations, a notification pane, the ​What's New container, and that stays open as long as the user keeps it open even across page navigation.</descrip></descripGrp><ntig><termGrp><term id="2277617">flex pane</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2287611">ફ્લેક્સ ફલક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39267_2277931_2281114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to bookmark webpages and articles to read later.</descrip></descripGrp><ntig><termGrp><term id="2277931">reading list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2281114">પઠન સૂચી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39268_2277946_2322330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit in the Office Graph that represents a connection between one entity and another, or a relationship between entities.</descrip></descripGrp><ntig><termGrp><term id="2277946">Office Graph edge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2322330">Office ગ્રાફ એજ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39269_2277947_2322332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit in the Office Graph that represents an entity, an action or a relationship between people, items, and people and items across Office 365.</descrip></descripGrp><ntig><termGrp><term id="2277947">Office Graph node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2322332">Office ગ્રાફ નોડ</term><termN