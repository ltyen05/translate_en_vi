Set xml:lang="en-US"><descripGrp><descrip type="definition">A setting that adjusts the display to eliminate blue tones that may disrupt your ability to sleep at night.</descrip></descripGrp><ntig><termGrp><term id="2446073">night light</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2449764">રાત્રિ પ્રકાશ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="432_107688_1428414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The timing and sequence of tasks within a project.</descrip></descripGrp><ntig><termGrp><term id="107688">schedule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1428414">શેડ્યૂલ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43202_2447224_2568335"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of similar feedback displayed in search results, instead of showing all the duplicate feedback.</descrip></descripGrp><ntig><termGrp><term id="2447224">collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2568335">સંગ્રહ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gra