>Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495742">લૉગ ફાઇલ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="62_3160_495202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server located on a network between client software, such as a Web browser, and another server. It intercepts all requests to the server to determine whether it can fulfill them itself. If not, it forwards the request to another server.</descrip></descripGrp><ntig><termGrp><term id="3160">proxy server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495202">પ્રૉક્સી સર્વર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6200_50329_495574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To insert information created in one program, such as a chart, an equation, an image, a video or a font, into another program or Web page.</descrip></descripGrp><ntig><termGrp><term id="50329">embed</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495574">એમ્બેડ કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6202_70557_495693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reverse something or change it to its opposite.</descrip></descripGrp><ntig><termGrp><term id="70557">invert</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495693">ઉલટાવો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6208_147957_1856609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that can show formatting and graphics, such as an embedded object, and not just text.</descrip></descripGrp><ntig><termGrp><term id="147957">rich text field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856609">રિચ પાઠ ફીલ્ડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="621_121364_496008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of object within a process that runs program instructions. Using multiple threads allows concurrent operations within a process and enables one process to run different parts of its program on different processors simultaneously. A thread has its own set of registers, its own kernel stack, a thread environment block, and a user stack in the address space of its process.</descrip></descripGrp><ntig><termGrp><term id="121364">thread</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496008">થ્રેડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6215_2282727_2286118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft word processing software designed for use with handheld computing devices.</descrip></descripGrp><ntig><termGrp><term id="2282727">Word Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2286118">Word મોબાઇલ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6215_331740_2286118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft word processing software designed for use with handheld computing devices.</descrip></descripGrp><ntig><termGrp><term id="331740">Microsoft® Office Word Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2286118">Word મોબાઇલ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6217_2282728_2286101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft spreadsheet software designed for use with handheld 