></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496882">ખુલતો શેવ્રન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42971_2435051_2438426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having a layout that groups objects two-dimensionally.</descrip></descripGrp><ntig><termGrp><term id="2435051">bending</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2438426">બેન્ડિંગ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42972_2435052_2438428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic that shows a progression of steps in a task, process, or workflow.</descrip></descripGrp><ntig><termGrp><term id="2435052">bending process</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2438428">બેન્ડિંગ પ્રક્રિયા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42973_2435053_2438427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic type that shows a series of pictures that wrap around in the confines of a box.</descrip></descripGrp><ntig><termGrp><term id="2435053">bending picture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2438427">બેન્ડિંગ ચિત્ર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42974_2435055_2438429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to act on events such as travel reservations and package deliveries captured from email and receive reminders for them.</descrip></descripGrp><ntig><termGrp><term id="2435055">Events from Email</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2438429">ઈમેલમાંથી ઇવેન્ટ્સ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42991_2436154_2439162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud service that uses machine learning.</descrip></descripGrp><ntig><termGrp><term id="2436154">intelligent service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2439162">સમજદાર સેવા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42992_2436155_2439165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word Mobile feature that opens a preview window of the scrolling destination page when the user taps on the Thumb Scroll and that only updates the main view once the user lets go.​</descrip></descripGrp><ntig><termGrp><term id="2436155">Scroll Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2439165">સ્ક્રોલ પૂર્વાવલોકન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42993_2436156_2596045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism to set up clients to the cloud service.</descrip></descripGrp><ntig><termGrp><term id="2436156">onboarding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2596045">ઑનબોર્ડિંગ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42994_2436157_2596044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism to remove clients from the cloud service.</descrip></descripGrp><ntig><termGrp><term id="2436157">offboarding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2596044">ઑફબોર્ડિંગ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNot