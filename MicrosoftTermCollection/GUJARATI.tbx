Speech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="3073089">ટ્રેક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53735_3060421_3064748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of branded assets such as logos, fonts, colors and images that are uploaded to be used in graphic designing or video editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060421">brand kit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="3064748">બ્રાન્ડ કીટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53736_3060422_3073082"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video clip from a library of professional stock assets that is integrated in the Clipchamp video editor for use in editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060422">stock video</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="3073082">સ્ટોક વીડિયો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53737_3060423_3073080"><