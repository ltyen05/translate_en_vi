ts the OLE protocol for object linking and embedding.</descrip></descripGrp><ntig><termGrp><term id="87410">OLE object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495824">OLE ઑબ્જેક્ટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14895_397169_1957153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A third-party hardware device or product that connects a legacy PBX to a LAN. An IP/VoIP gateway translates or converts TDM or telephony circuit-switched protocols to packet switched protocols that can be used on a VoIP-based network.</descrip></descripGrp><ntig><termGrp><term id="397169">IP/VoIP gateway</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957153">IRC</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14897_231964_496428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In statistical or scientific data, a bar that shows the potential error or degree of uncertainty relative to each data marker in a series.</descrip></descripGrp><ntig><termGrp><term id="231964">error bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496428">ત્રુટી પટ્ટી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech"