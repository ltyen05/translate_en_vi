maticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1857177">ફ્લેશ ભરણ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32224_1641036_1945739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Collections of proofing tools for different languages that that are available to users of Office applications.</descrip></descripGrp><ntig><termGrp><term id="1641036">Microsoft Office Proofing Tools</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1945739">Microsoft Office અશુદ્ધિ તપાસ ઉપકરણ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32225_1718117_1857267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of controls that helps users navigate directly to where they want to go in SharePoint, without having to navigate the hierarchy or edit the URL.</descrip></descripGrp><ntig><termGrp><term id="1718117">Search-Driven Navigation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1857267">શોધ-લક્ષી નેવિગેશન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32226_1641038_1857178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables subscription customers to launch Office rich client applications online from a computer on which those applications are not already installed.</descrip></descripGrp><ntig><termGrp><term id="1641038">Office on Demand</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1857178">માંગ પર Office</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32228_1641040_1857179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to edit SharePoint list content directly without opening an edit window.</descrip></descripGrp><ntig><termGrp><term id="1641040">Quick Edit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1857179">ઝડપી સંપાદન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32230_1641042_1857180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An error log that contains errors and exceptions that occur when SharePoint tries to connect to external systems through Business Connectivity Services. It can be retrieved by tenant administrators.</descrip></descripGrp><ntig><termGrp><term id="1641042">tenant-level external data log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig><