_496582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital interface specification for delivering digital content and connecting consumer electronic devices.</descrip></descripGrp><ntig><termGrp><term id="298004">high-definition multimedia interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496582">હાઇ ડેન્સિટી મલ્ટિચિપ ઇંટરકનેક્ટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11734_298004_496584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital interface specification for delivering digital content and connecting consumer electronic devices.</descrip></descripGrp><ntig><termGrp><term id="298004">high-definition multimedia interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496584">HDMI</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11734_298004_496759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital interface specification for delivering digital content and connecting consumer electronic devices.</descrip></descripGrp><ntig><termGrp><term id="298004">high-definition multimedia interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496759">હાઇ ડેફિનેશન મલ્ટિમીડિયા ઇંટરફેસ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11744_38453_495462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person, inside or outside your organization, for whom you have created an entry where you can save several types of information, such as street and email addresses, telephone and fax numbers, and Web page URLs.</descrip></descripGrp><ntig><termGrp><term id="38453">contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495462">સંપર્ક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11748_136786_496098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A display setting that holds up to 256 specific color entries. Any color palette attached to a picture is by definition an 8-bit palette.</descrip></descripGrp><ntig><termGrp><term id="136786">8-bit color</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496098">8-બિટ રંગ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11757_146879_1216384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The device that communicates between your software program and your printer.</descrip></descripGrp><ntig><termGrp><term id="146879">printer driver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1216384">પ્રિન્ટર ડ્રાઇવર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11757_146879_496191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The device that communicates between your software program and your printer.</descrip></descripGrp><ntig><termGrp><term id="146879">printer driver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496191">મુદ્રક ડ્રાઇવર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11758_153847_496238"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object created with one program and embedded into a document created by another. Embedding the object, rather than simply inserting or pasting it, ensures that the object retains its original format. If you double-click the embedded object, you can edit it with the toolbars and menus from the program used to create it.</descrip></descripGrp><ntig><termGrp><term id="153847">embedded object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496238">એમ્બેડેડ ઑબ્જેક્ટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="pa