 type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1428534">SharePoint સૂચી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23727_1088927_1792428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A site element that stores and displays a collection of data that team members and other site users can share.</descrip></descripGrp><ntig><termGrp><term id="1088927">list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1792428">સૂચી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23766_1089518_2768807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer, either physical or virtual, capable of processing information to produce a desired result.</descrip></descripGrp><ntig><termGrp><term id="1089518">machine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2768807">મશીન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2378_17347_1957006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to, or characteristic of, a DNS server that hosts a primary or secondary copy of a DNS zone. When a DNS server is configured to host a zone, it is said to be authoritative for names within that zone.</descrip></descripGrp><ntig><termGrp><term id="17347">authoritative server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957006">અધિકૃત સર્વર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23796_1089872_2700960"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A loop that, because of semantic or logic errors, can never terminate through normal means.</descrip></descripGrp><ntig><termGrp><term id="1089872">infinite loop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2700960">અનંત લૂપ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="238_41773_1957050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Exchange 5.5 and earlier, a custom recipient is a user who is not hosted by Exchange. In Exchange 2003, such users can be added to Active Directory as contacts, Windows users, or users whose Windows accounts are disabled. In any case, they are mail-enabled, but not mailbox-enabled, because their mailboxes are hosted on another messaging system.</descrip></descripGrp><ntig><termGrp><term id="41773">custom recipient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957050">કસ્ટમ પ્રાપ્તકર્તા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2382_231960_1856658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of summarizing values in the data area of a PivotTable report by using the values in other cells in the data area. Use the Show data as list on the PivotTable Field dialog for a data field to create custom calculations.</descrip></descripGrp><ntig><termGrp><term id="231960">custom calculation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856658">કસ્ટમ ગણતરી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23840_1091236_1415486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video clip that has been inserted into another file or Web page.</descrip></descripGrp><ntig><termGrp><term id="1091236">embedded video clip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1415486">એમ્બેડેડ વિડિયો ક્લિપ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23841_1091237_1415487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio clip that has been inserted into another file or Web page.</descrip></descripGrp><ntig><termGrp><term id="1091237">embedded audio clip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1415487">એમ્બેડેડ ઑડિયો ક્લિપ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23864_1091326_1963465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard control that resembles a notebook and lets the user navigate different sections of information without leaving the current element on the screen.</descrip></descripGrp><ntig><termGrp><term id="1091326">tab control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1963465">ટૅબ નિયંત્રણ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23869_1091332_2818378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In mathematics, an item that is multiplied in a multiplication problem; for example, 2 and 3 are factors in the problem 2 x 3. The prime factors of a number are a set of prime numbers that, when multiplied together, produce the number.</descrip></descripGrp><ntig><termGrp><term id="1091332">factor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2818378">અવયવ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23871_1091334_2290005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ability to view data or navigate to or within a physical or virtual computer environment.</descrip></descripGrp><ntig><termGrp><term id="1091334">access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2290005">ઍક્સેસ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23872_1091335_2290020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account holder who is a family member, but not a parent, and who has limited use of the Internet. Children can view their own settings, but they can't change them.</descrip></descripGrp><ntig><termGrp><term id="1091335">child</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2290020">બાળક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23873_1091336_2952445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account holder who is a parent or a child.</descrip></descripGrp><ntig><termGrp><term id="1091336">family member</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2952445">કુટુંબના સદસ્ય</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23874_1091337_2290024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account holder who is the primary administrator (parent) and the family members they manage.</descrip></descripGrp><ntig><termGrp><term id="1091337">family</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2290024">કુટુંબ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23875_1091338_1215600"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To combine thereby increasing the quantity or size of something.</descrip></descripGrp><ntig><termGrp><term id="1091338">add</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1215600">ઍડ કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23876_1091339_2290029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To adjust the action or aspects of a group of items, typically done more than once.</descrip></descripGrp><ntig><termGrp><term id="1091339">manage</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2290029">મેનેજ કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2388_415516_1856732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A name assigned to a cell or group of cells.</descrip></descripGrp><ntig><termGrp><term id="415516">range name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856732">શ્રેણી નામ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="239_252121_1856707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A combination of list formatting options identified by a style name.</descrip></descripGrp><ntig><termGrp><term id="252121">list style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856707">સૂચી શૈલી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23916_1091985_1369511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Storage space provided over the Internet that's allotted to users for keeping digital information, such as photos or documents.</descrip></descripGrp><ntig><termGrp><term id="1091985">online storage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1369511">ઑનલાઇન સંગ્રહણ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23919_1092267_1462793"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A “software-plus-services” platform and experience that enables PCs and other devices to “come alive” by making them aware of each other through the Internet, enabling individuals and organizations to manage, access, and share their files and applications seamlessly on the Web and across their world of devices.</descrip></descripGrp><ntig><termGrp><term id="1092267">Live Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1462793">Windows Live Mesh</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23919_1379736_1462793"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A “software-plus-services” platform and experience that enables PCs and other devices to “come alive” by making them aware of each other through the Internet, enabling individuals and organizations to manage, access, and share their files and applications seamlessly on the Web and across their world of devices.</descrip></descripGrp><ntig><termGrp><term id="1379736">Windows Live Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1462793">Windows Live Mesh</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23935_1092702_1957297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that is to be searched for in a document or any collection of data.</descrip></descripGrp><ntig><termGrp><term id="1092702">search key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957297">શોધ કી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23957_1092760_2847841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In communications, a channel connecting two switching stations. A trunk usually carries a large number of calls at the same time.</descrip></descripGrp><ntig><termGrp><term id="1092760">trunk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2847841">ટ્રંક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23957_1092760_2847842"><langSet xml:lang="e