geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43717_2466997_2470268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 designed for small and medium businesses that includes the features of Windows 10 Pro, plus additional management policies that can be helpful to business customers. This edition is only available through subscription as part of a larger package of services, and is not available as a standalone download.</descrip></descripGrp><ntig><termGrp><term id="2466997">Windows 10 Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2470268">Windows 10 Business</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43734_2467150_2470683"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Mixed Reality and Windows Holographic, an app type or app state in which the app renders as a flat window, not an immersive experience.​</descrip></descripGrp><ntig><termGrp><term id="2467150">2D view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2470683">2D દૃશ્ય</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="437