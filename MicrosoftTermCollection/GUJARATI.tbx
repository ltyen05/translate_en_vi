813">ODBC driver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495819">ODBC ડ્રાઇવર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1171_13558_1856461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technical article, written and distributed by Microsoft, that provides additional information about a Microsoft product or a fix for a known issue.</descrip></descripGrp><ntig><termGrp><term id="13558">application note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856461">એપ્લિકેશન નોંધ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11712_307435_1957162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows access to SharePoint documents and sites and documents on shares inside of a corporate network through Outlook Web Access when it is used remotely.</descrip></descripGrp><ntig><termGrp><term id="307435">LinkAccess</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957162">લિટિગેશન હોલ્ડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11717_343653_497073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To find.</descrip></descripGrp><ntig><termGrp><term id="343653">locate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="497073">શોધો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11727_231965_1856661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Components that can be installed on your computer to add commands and functions to Excel. These add-in programs are specific to Excel. Other add-in programs that are available for Excel or Office are Component Object Model (COM) add-ins.</descrip></descripGrp><ntig><termGrp><term id="231965">Excel add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856661">Excel ઍડ-ઇન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11734_258953_496582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital interface specification for delivering digital content and connecting consumer electronic devices.</descrip></descripGrp><ntig><termGrp><term id="258953">high-density multichip interconnect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496582">હાઇ ડેન