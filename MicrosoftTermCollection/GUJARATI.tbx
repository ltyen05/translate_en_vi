 type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2965220">COVARIANCE.S</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52345_2955557_2965221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Compatibility/Statistical Excel function that returns the smallest value for which the cumulative binomial distribution is less than or equal to a criterion value.</descrip></descripGrp><ntig><termGrp><term id="2955557">CRITBINOM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2965221">CRITBINOM</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52346_2955558_2965222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Math and trigonometry Excel function that returns the cosecant of an angle.</descrip></descripGrp><ntig><termGrp><term id="2955558">CSC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2965222">CSC</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52347_2955559_2965223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Math and trigonometry Excel function that returns the hyperbolic cosecant of an angle.</descrip></descripGrp><ntig><termGrp><term id="2955559">CSCH</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2965223">CSCH</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52348_2955560_2965224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns a key performance indicator (KPI) name, property, and measure, and displays the name and property in the cell. A KPI is a quantifiable measurement, such as monthly gross profit or quarterly employee turnover, used to monitor an organization's performance.</descrip></descripGrp><ntig><termGrp><term id="2955560">CUBEKPIMEMBER</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2965224">CUBEKPIMEMBER</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52349_2955561_2965225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns a member or tuple in a cube hierarchy. Use to validate that the member or tuple exists in the cube.</descrip></descripGrp><ntig><termGrp><term id="2955561">CUBEMEMBER</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2965225">CUBEMEMBER</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52350_2955562_2965226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns the value of a member property in the cube. Use to validate that a member name exists within the cube and to return the specified property for this member.</descrip></descripGrp><ntig><termGrp><term id="2955562">CUBEMEMBERPROPERTY</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2965226">CUBEMEMBERPROPERTY</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52351_2955563_2965227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns the nth, or ranked, member in a set. Use to return one or more elements in a set, such as the top sales performer or top 10 students.</descrip></descripGrp><ntig><termGrp><term id="2955563">CUBERANKEDMEMBER</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2965227">CUBERANKEDMEMBER</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></t