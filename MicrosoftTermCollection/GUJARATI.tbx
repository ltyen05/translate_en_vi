11444_496385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file and folder structure that contains the necessary files and/or configuration settings that control the preinstallation process and define the manufacturers' custom information.</descrip></descripGrp><ntig><termGrp><term id="211444">configuration set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496385">કન્ફિગ સેટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11900_211445_496384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file and folder structure that contains the necessary files and/or configuration settings that control the preinstallation process and define the manufacturers' custom information.</descrip></descripGrp><ntig><termGrp><term id="211445">config set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496384">કન્ફિગરેશન સેટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11900_211445_496385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file and folder structure that contains the necessary files and/or configuration settings that control the preinstallation process and define the manufacturers' custom information.</descrip></descripGrp><ntig><termGrp><term id="211445">config set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="