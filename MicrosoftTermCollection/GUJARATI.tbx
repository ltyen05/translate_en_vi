>Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856620">કાર્યફલક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10544_79231_1216368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains audio, video, or script data.</descrip></descripGrp><ntig><termGrp><term id="79231">media file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1216368">મીડિયા ફાઇલ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10559_32556_1957029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Occurring on the client side of a client-server system. For example, on the World Wide Web, JavaScript scripts are client-side because they are executed by your browser (the client). In contrast, CGI scripts are server-side because they run on the Web server. Java applets can be either server-side or client-side depending on which computer (the server or the client) executes them.</descrip></descripGrp><ntig><termGrp><term id="32556">client-side</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957029">ક્લાયંટ-સાઇડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10560_145705_1856594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data that is contained within a worksheet outline. Outline data includes both the summary and detail rows or columns of an outline.</descrip></descripGrp><ntig><termGrp><term id="145705">outline data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856594">બાહ્યરેખા ડેટા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10561_19019_2290016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task that is part of an operating system or program, and is operating without interaction with the user while the user is working on another task.</descrip></descripGrp><ntig><termGrp><term id="19019">background task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2290016">પૃષ્ઠભૂમિ કાર્ય</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10567_232824_1856690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic or other object that is inserted in the drawing layer so that you can position it precisely on the page or in front of or behind text or other objects.</descrip></descripGrp><ntig><termGrp><term id="232824">floating object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856690">ફ્લોટિંગ ઑબ્જેક્ટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10572_24731_1856464"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar that is part of an application when it's installed on your computer.</descrip></descripGrp><ntig><termGrp><term id="24731">built-in toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856464">બિલ્ટ-ઇન ઉપકરણપટ્ટી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10575_3794_495213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Malware that replicates, commonly by infecting other files in the system, thus allowing the execution of the malware code and its propagation when those files are activated.</descrip></descripGrp><ntig><termGrp><term id="3794">virus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495213">વાયરસ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10579_106311_2768809"><langSet xml:lang="en-US"><descripGrp><descrip type="definitio