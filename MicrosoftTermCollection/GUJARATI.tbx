pe="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2818771">બિન-ભૌગોલિક નંબર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49801_2816516_2818770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of telephone number that is linked to a specific locality, such as with a country code.</descrip></descripGrp><ntig><termGrp><term id="2816516">geographic number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2818770">ભૌગોલિક નંબર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49806_2816522_2818766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft Teams that assesses the Office 365 tenant environment and identifies the most common configurations that may need to be updated or modified, and creates a Service management team with channels for each workload.</descrip></descripGrp><ntig><termGrp><term id="2816522">Advisor for Teams</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2818766">Teams માટે એડ્વાઇઝર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49806_2816698_2818766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft Teams that assesses the Office 365 tenant environment and identifies the most common configurations that may need to be updated or modified, and creates a Service management team with channels for each workload.</descrip></descripGrp><ntig><termGrp><term id="2816698">Advisor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2818766">Teams માટે એડ્વાઇઝર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49808_2816676_2818774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft Teams, as part of Teams rollout done with Advisor for Teams, a workload is a set of features and settings that is used to deploy a specific collection of functions. Workloads are comprised of channels to complete the deployment of the functions.</descrip></descripGrp><ntig><termGrp><term id="2816676">workload</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2818774">વર્કલોડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49810_2816681_2818773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To convert a phone number to a different format, by using a set of rules.</descrip></descripGrp><ntig><termGrp><term id="2816681">translate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2818773">કન્વર્ટ કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49814_2816699_2818768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To forward an urgent message to another person.</descrip></descripGrp><ntig><termGrp><term id="2816699">escalate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2818768">આગળ વધારો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49815_2816700_2818769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype status that allows notifications only for urgent messages and from priority contacts.</descrip></descripGrp><ntig><termGrp><term id="2816700">focusing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2818769">જરૂરી કામમાં વ્યસ્ત</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49831_2817533_2819801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of conditions, implemented through the Data Validation function in Excel, that restricts the permissible content of a cell.</descrip></descripGrp><ntig><termGrp><term id="2817533">data validation rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2819801">ડેટા માન્યતા નિયમ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49832_2817535_2819807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user's perception about the usability and effectiveness of the search function.</descrip></descripGrp><ntig><termGrp><term id="2817535">search experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2819807">શોધ અનુભવ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49833_2817538_2819808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way of expressing a software design, usually in an abstract language such as UML.</descrip></descripGrp><ntig><termGrp><term id="2817538">software model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2819808">સૉફ્ટવેર મૉડલ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Not