mNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1428465">બોલ્ડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11186_59131_1685198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic components that generate the video signal sent through a cable to a video display. The video adapter is usually located on the computer's main system board or on an expansion board, but it is sometimes built into the terminal.</descrip></descripGrp><ntig><termGrp><term id="59131">video card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1685198">પ્રદર્શન એડેપ્ટર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11186_59131_495626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic components that generate the video signal sent through a cable to a video display. The video adapter is usually located on the computer's main system board or on an expansion board, but it is sometimes built into the terminal.</descrip></descripGrp><ntig><termGrp><term id="59131">video card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495626">વિડિયો કાર્ડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11186_59134_1685198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic components that generate the video signal sent through a cable to a video display. The video adapter is usually located on the computer's main system board or on an expansion board, but it is sometimes built into the terminal.</descrip></descripGrp><ntig><termGrp><term id="59134">display adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1685198">પ્રદર્શન એડેપ્ટર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11186_59134_495626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic components that generate the video signal sent through a cable to a video display. The video adapter is usually located on the computer's main system board or on an expansion board, but it is sometimes built into the terminal.</descrip></descripGrp><ntig><termGrp><term id="59134">display adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495626">વિડિયો કાર્ડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11191_173848_1856624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of information transmitted as a whole from one device to another on a network.</descrip></descripGrp><ntig><termGrp><term id="173848">data packet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856624">ડેટા પૅકેટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11192_4042_1856457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Code that is executed by the common language runtime environment rather than directly by the operating system. Managed code applications gain common language runtime services such as automatic garbage collection, runtime type checking and security support, and so on. These services help provide uniform platform- and language-independent behavior of managed-code applications.</descrip></descripGrp><ntig><termGrp><term id="4042">managed code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856457">મેનેજ કરેલ કોડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11192_4043_1856457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Code that is executed by the common language runtime environment rather than directly by the operating system. Managed code applications gain common language runtime services such as automatic garbage collection, runtime type checking and security support, and so on. These services help provide uniform platform- and language-independent behavior of managed-code applications.</descrip></descripGrp><ntig><termGrp><term id="4043">safe code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856457">મેનેજ કરેલ કોડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="112_93994_1693810"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The logon name (and therefore the email address) of an account that is responsible for maintaining email services on a mail server. When an account holder is having trouble with email, a message to postmaster or "postmaster@machine.org.domain.name" will usually reach a human who can solve the problem.</descrip></descripGrp><ntig><termGrp><term id="93994">postmaster</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1693810">પોસ્ટમાસ્ટર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11201_235266_2587879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quantitative measure of performance that is used to compare the company's products, services, or processes to an external standard. Competitive benchmarks are based on industry best, and process benchmarks are based on best in class.</descrip></descripGrp><ntig><termGrp><term id="235266">benchmark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2587879">માનદંડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11206_46548_1957052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An access control list that is controlled by the owner of an object and that specifies the access particular users or groups can have to the object.</descrip></descripGrp><ntig><termGrp><term id="46548">discretionary access control list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957052">DACL</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11206_46548_1957080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An access control list that is controlled by the owner of an object and that specifies the access particular users or groups can have to the object.</descrip></descripGrp><ntig><termGrp><term id="46548">discretionary access control list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957080">ડિસ્ક્રિશનરી ઍક્સેસ નિયંત્રણ સૂચી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11206_46549_1957052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An access control list that is controlled by the owner of an object and that specifies the access particular users or groups can have to the object.</descrip></descripGrp><ntig><termGrp><term id="46549">DACL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957052">DACL</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11206_46549_1957080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An access control list that is controlled by the owner of an object and that specifies the access particular users or groups can have to the object.</descrip></descripGrp><ntig><termGrp><term id="46549">DACL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957080">ડિસ્ક્રિશનરી ઍક્સેસ નિયંત્રણ સૂચી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11208_102176_1216378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Part of the integrated Routing and Remote Access service that provides remote networking for telecommuters, mobile workers, and system administrators who monitor and manage servers at multiple branch offices. Users can use Network Connections to dial in to remotely access their networks for services such as file and printer sharing, electronic mail, scheduling, and SQL database access.</descrip></descripGrp><ntig><termGrp><term id="102176">remote access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1216378">રીમોટ ઍક્સેસ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11208_102176_495912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Part of the integrated Routing and Remote Access service that provides remote networking for telecommuters, mobile workers, and system administrators who monitor and manage servers at multiple branch offices. Users can use Network Connections to dial in to remotely access their networks for services such as file and printer sharing, electronic mail, scheduling, and SQL database access.</descrip></descripGrp><ntig><termGrp><term id="102176">remote access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495912">દૂરસ્થ ઍક્સેસ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11216_564516_1984796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of real-time communication over the Internet in which a sender types a message to one or more recipients and the recipient immediately receives the message in a chat area.</descrip></descripGrp><ntig><termGrp><term id="564516">instant messaging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1984796">ઇન્સ્ટન્ટ મેસેજિંગ</term><termNote type="geographicalUsage">IND</termNote><termNote type="p