maticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25817_1217809_1265173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the user's personal online space, with blog functionality, photo albums, and lists, on Windows Live Spaces.</descrip></descripGrp><ntig><termGrp><term id="1217809">Spaces</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1265173">Spaces</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25819_1217811_1265179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the Windows Live site where users can register their mobile phone and find information about the Windows Live for Mobile services.</descrip></descripGrp><ntig><termGrp><term id="1217811">Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1265179">મોબાઇલ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25820_1217812_1265185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the site to download client versions of Windows Live products such as Windows Live Mail, Windows Live Messenger, etc.</descrip></descripGrp><ntig><termGrp><term id="1217812">Downloads</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1265185">ડાઉનલોડ્સ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25821_1217813_1265190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the overview page of all Windows Live, MSN, and Microsoft products on offer.</descrip></descripGrp><ntig><termGrp><term id="1217813">All services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1265190">બધી સેવાઓ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25822_1217817_1265145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the page where users enter information for the methods by which they can be contacted, such as Messenger, home phone, mobile phone, and email.</descrip></descripGrp><ntig><termGrp><term id="1217817">Contact info</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1265145">સંપર્ક માહિતી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25825_1217869_1856982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that enables the user to see the different parts of a nested formula evaluated in the order the formula is calculated.</descrip></descripGrp><ntig><termGrp><term id="1217869">Evaluate Formula</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856982">સૂત્રનું મૂલ્યાંકન કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25837_1217966_1957100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook Live feature in the Web management interface that enables migration of the contents of user mailboxes from an on-premises IMAP messaging system to Outlook Live (or Exchange Online).</descrip></descripGrp><ntig><termGrp><term id="1217966">Email Migration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957100">ઈ-મેલ પ્રોગ્રામ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2584_235070_1215806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo organizer used to view, manage, and edit digital pictures.</descrip></descripGrp><ntig><termGrp><term id="235070">Windows Photo Gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1215806">Windows ફોટો ગૅલરી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2584_235070_496522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo organizer used to view, manage, and edit digital pictures.</descrip></descripGrp><ntig><termGrp><term id="235070">Windows Photo Gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496522">Windows ફોટો ગેલેરી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2584_725946_1215806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo organizer used to view, manage, and edit digital pictures.</descrip></descripGrp><ntig><termGrp><term id="725946">Photo Gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1215806">Windows ફોટો ગૅલરી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2584_725946_496522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo organizer used to view, manage, and edit digital pictures.</descrip></descripGrp><ntig><termGrp><term id="725946">Photo Gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496522">Windows ફોટો ગેલેરી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25844_1218374_1957267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The domain name of the Outlook Live domain that you are configuring with Outlook Live Directory Sync (OLSync)(previously known as GALSync 2010). When you deploy OLSync, you manually enter at least one provisioning domain, for example, student.contoso.edu, during the ILM 2007 configuration process. The provisioning domain must be an accepted domain in your Outlook Live deployment.</descrip></descripGrp><ntig><termGrp><term id="1218374">provisioning domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957267">પ્રોવિઝનિંગ ડોમેન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25845_1218375_1960856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain or a person that an end user doesn't want to receive email messages from. Messages received from any email address or domain listed in the users' Blocked Senders list are sent directly to the user's Junk E-Mail folder.</descrip></descripGrp><ntig><termGrp><term id="1218375">blocked sender</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1960856">અવરુદ્ધ પ્રેષક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25846_1218376_1957185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Active Directory security principal object that has at least one associated SMTP address</descrip></descripGrp><ntig><termGrp><term id="1218376">mail-enabled user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957185">MAN</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25847_1218377_1957141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrator user interface in Outlook Live used to import new users with a CSV file.</descrip></descripGrp><ntig><termGrp><term id="1218377">Import users</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957141">ઇનબૉક્સ નિયમ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25848_1218378_1957049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A comma separated value (CSV) file used to provision many new users at one time.</descrip></descripGrp><ntig><termGrp><term id="1218378">CSV import file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957049">CSV આયાત ફાઇલ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25849_1218379_1957140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of provisioning new users using a CSV file.</descrip></descripGrp><ntig><termGrp><term id="1218379">import process</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957140">ઉપયોગકર્તાઓને આયાત કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25850_1218380_1957368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrative boundary in which members of an Exchange 2010 role group can make changes. For the Outlook Live hosted service, the write scope is the entire Outlook Live organization. For on-premises implementations of Microsoft Exchange Server 2010, write scopes may be smaller in breadth, such as those defined by a specific organizational unit or a database.</descrip></descripGrp><ntig><termGrp><term id="1218380">write scope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957368">લેખન સ્કોપ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25851_1218381_1957078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users the permissions needed to use Multi-Mailbox Search.</descrip></descripGrp><ntig><termGrp><term id="1218381">Discovery Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957078">આવિષ્કાર મેનેજમેન્ટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25852_1218382_1957133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users the permissions to reset passwords for users and manage settings on the Options page for users' Outlook Live account. To help troubleshoot user issues, members can also view, but not modify, all mailboxes, public groups, and external contacts in the organization.</descrip></descripGrp><ntig><termGrp><term id="1218382">Help Desk</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957133">હોમ સ્ક્રીન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25853_1218383_1957271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users the permissions to create and manage mailboxes, public groups, and external contacts. Members can also import new users, track messages sent and received by users, and manage Exchange ActiveSync settings for the organization.</descrip></descripGrp><ntig><termGrp><term id="1218383">Recipient Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957271">પ્રાપ્તકર્તા મેનેજમેંટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25854_1218384_1957273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users permissions to create and manage organization-wide rules, also known as transport rules. Members of the role group can also track messages sent and received by users.</descrip></descripGrp><ntig><termGrp><term id="1218384">Records Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957273">રેકોર્ડ્સ મેનેજમેંટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25855_1218385_1957346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users the permissions to manage Unified Messaging (UM) server configurations, UM properties on mailboxes, UM prompts, and UM auto attendant configuration.</descrip></descripGrp><ntig><termGrp><term id="1218385">UM Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957346">UM મેનેજમેંટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25856_1218386_1957354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrator role group that gives users permissions to view, but not modify, all mailboxes, public groups, and external contacts in the organization. Members can also view settings for role assignment policies, transport rules, and supervision policies.</descrip></descripGrp><ntig><termGrp><term id="1218386">View-Only Organization Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957354">View-Only Organization Management</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25857_1218387_1961352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain or a person that a user wants to always receive email messages from. Users add recipients and domains to the Safe Senders list.</descrip></descripGrp><ntig><termGrp><term id="1218387">safe sender</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1961352">સુરક્ષિત પ્રેષક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25858_1218388_1957219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Exchange 2010 and Outlook Live that enables users to search the mailboxes in their organization for email and other message types that contain specific keywords. The results of a search are then copied to a mailbox that you have specified so that you can review, organize, and export the search results.</descrip></descripGrp><ntig><termGrp><term id="1218388">Multi-Mailbox Search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957219">મલ્ટિ-મેલબૉક્સ શોધ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25859_1218389_1957350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that can't be indexed for a mailbox search using Multi-Mailbox Search. This includes unrecognized message types and messages that contain attachments that are encrypted or have an unrecognized format.</descrip></descripGrp><ntig><termGrp><term id="1218389">unsearchable item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957350">ન શોધવા યોગ્ય આઇટમ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25860_1218390_1957126"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who is assigned the ability to approve and reject any messages sent to a public group or a dynamic distribution group.</descrip></descripGrp><ntig><termGrp><term id="1218390">group moderator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957126">સમૂહ નામકરણ નીતિ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25862_1223075_1957290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource mailbox that is assigned to a meeting location such as a conference room, auditorium, or training room. Room mailboxes can be included as resources in meeting requests, providing a simple and efficient way of organizing meetings for an organization.</descrip></descripGrp><ntig><termGrp><term id="1223075">room mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957290">રૂમ મેલબૉક્સ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25869_1224269_1957328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Elevated credentials that have rights to access objects that ordinary users without elevated credentials can't access.</descrip></descripGrp><ntig><termGrp><term id="1224269">super-user credentials</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957328">સુપર-યુઝર ઓળખપત્ર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2587_318778_495150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The — character, based on the width of an uppercase M and used primarily to set off sentence elements.</descrip></descripGrp><ntig><termGrp><term id="318778">EM DASH</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495150">એમ ડૅશ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2587_988_495150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The — character, based on the width of an uppercase M and used primarily to set off sentence elements.</descrip></descripGrp><ntig><termGrp><term id="988">em dash</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495150">એમ ડૅશ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25870_1224270_1957253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subscription that gathers messages from POP3 mailboxes and delivers the messages to a designated Outlook Live mailbox so that the Outlook Live end user can centralize their email accounts and only have to check one mailbox.</descrip></descripGrp><ntig><termGrp><term id="1224270">POP subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957253">POP સબ્સ્ક્રિપ્શન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1224271_1957098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1224271">unmanaged Windows Live ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957098">ELMA</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1224271_1957099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1224271">unmanaged Windows Live ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957099">ઈમેલ માઇગ્રેશન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1275550_1957098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1275550">e-mail as sign in ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957098">ELMA</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1275550_1957099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1275550">e-mail as sign in ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957099">ઈમેલ માઇગ્રેશન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1275551_1957098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1275551">EASI ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957098">ELMA</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1275551_1957099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1275551">EASI ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957099">ઈમેલ માઇગ્રેશન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25872_1224272_1957259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of validating data before it is processed. This validation helps detect and exclude some errors from the intended process, which might be the import or migration of users using a CSV file, for example.</descrip></descripGrp><ntig><termGrp><term id="1224272">preliminary data validation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957259">પ્રાથમિક ડેટા માન્યતા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25873_1224273_1957005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A DNS server that is responsible for the DNS records that are associated with a domain.</descrip></descripGrp><ntig><termGrp><term id="1224273">authoritative name server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957005">અધિકૃત સર્વર નામ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25884_1230078_1856983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2010 edition of the Microsoft spreadsheet software with tools for analyzing, charting, and communicating data.</descrip></descripGrp><ntig><termGrp><term id="1230078">Microsoft Excel 2010</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856983">Microsoft Excel 2010</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25885_1230079_1945735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2010 edition of the Microsoft spreadsheet software, with tools for analyzing, charting, and communicating data, designed for home and students.</descrip></descripGrp><ntig><termGrp><term id="1230079">Microsoft Excel Home and Student 2010</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1945735">Microsoft Excel Home and Student 2010</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25886_1230086_1856984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2010 edition of the Microsoft spreadsheet software designed for use with handheld computing devices.</descrip></descripGrp><ntig><termGrp><term id="1230086">Microsoft Excel Mobile 2010</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856984">Microsoft Excel Mobile 2010</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25900_1509435_1650176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The device that runs Windows Phone Operating System.</descrip></descripGrp><ntig><termGrp><term id="1509435">Windows Phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1650176">Windows Phone</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25900_2195811_1650176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The device that runs Windows Phone Operating System.</descrip></descripGrp><ntig><termGrp><term id="2195811">WP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1650176">Windows Phone</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25901_1231845_1265200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu item on the Bing menu that links to http://www.bing.com/cashback/.</descrip></descripGrp><ntig><termGrp><term id="1231845">Cashback</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1265200">કૅશબૅક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25903_1231847_1265202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the free online workspace for accessing, editing, and sharing Excel, Word, PowerPoint and OneNote documents across your PC, smartphone, and web browser.</descrip></descripGrp><ntig><termGrp><term id="1231847">Documents</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1265202">દસ્તાવેજો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25904_1231848_1265198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to bing.com in some regions but to a dropdown list of more Bing options in other regions.</descrip></descripGrp><ntig><termGrp><term id="1231848">Bing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1265198">Bing</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25905_1231849_1267004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Mobile header link that opens a menu that contains more options.</descrip></descripGrp><ntig><termGrp><term id="1231849">Do more</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1267004">વધુ કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25906_1231850_1265201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the website where customers add computers (both PCs and Macs), mobile phones, and digital photo frames so they can access their synced folders and connect remotely to their devices.</descrip></descripGrp><ntig><termGrp><term id="1231850">Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1265201">ઉપકરણો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25907_1231852_1265195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the code of conduct, which contains rules that explain how someone should behave while using a service or product.</descrip></descripGrp><ntig><termGrp><term id="1231852">Code of Conduct</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1265195">આચાર સંહિતા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25912_1231866_1792435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2010 edition of the Microsoft messaging and collaboration client software for personal computers accessing Microsoft Exchange Server-based email and collaboration services.</descrip></descripGrp><ntig><termGrp><term id="1231866">Microsoft Outlook 2010</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1792435">Microsoft Outlook 2010</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25917_1231890_1265204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to photos that only you and people that you select can view (versus public photos that anyone can view).</descrip></descripGrp><ntig><termGrp><term id="1231890">Shared photos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1265204">શેર કરેલા ફોટા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25918_1231891_1265191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the Microsoft service agreement.</descrip></descripGrp><ntig><termGrp><term id="1231891">Terms</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1265191">ટર્મ્સ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25919_1231893_1265193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Mobile footer link to the site that is built for viewing from a PC.</descrip></descripGrp><ntig><termGrp><term id="1231893">PC site</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1265193">PC સાઇટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25921_1231895_1265199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Mobile footer link to the site that is built for viewing from mobile devices.</descrip></descripGrp><ntig><termGrp><term id="1231895">Mobile site</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1265199">મોબાઇલ સાઇટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245016_1984723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245016">Active Directory Management Agent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1984723">Active Directory મેનેજમેંટ એજન્ટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245016_1984726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245016">Active Directory Management Agent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1984726">ADMA</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245017_1984723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245017">ADMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1984723">Active Directory મેનેજમેંટ એજન્ટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245017_1984726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245017">ADMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1984726">ADMA</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25959_1247422_1957355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mailbox folder structure on some IMAP servers in which mail folders are accessed with the administrator username and password, and shell login access to the mail server is not allowed. Access to specific mailboxes is managed by access control lists. This means that users are assigned the permissions to only access their mailbox folder, while an administrator has access to all mailboxes. This allows organizations to use administrative credentials to migrate email from an IMAP server to Outlook Live.</descrip></descripGrp><ntig><termGrp><term id="1247422">virtual shared folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957355">વર્ચ્યુઅલ શેર કરેલ ફોલ્ડર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2596_335540_2855511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To provide your name and contact information to an organization so that you can receive product information, updates, and special offers.</descrip></descripGrp><ntig><termGrp><term id="335540">register</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2855511">રજિસ્ટર કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25961_1248981_1369524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Photo Gallery feature that replaces a section of one photo with a similar section of another, providing there are areas of overlap in both. For example, if someone has two photos of a group of people, and in Photo 1 everyone is smiling but one person has their eyes closed, they can include the section of Photo 2 where that person has their eyes open.</descrip></descripGrp><ntig><termGrp><term id="1248981">Photo Fuse</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1369524">ફોટો ફ્યૂઝ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25978_1251313_1957107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To place a windows Live ID in a forced rename state, while the Windows Live ID and all of its existing settings, including the password, Xbox Live points, or Zune points are preserved. The user can sign in using the Windows Live ID and its password, but they're immediately asked to rename the Windows Live ID. They must specify an email address that's outside the Outlook Live domain.</descrip></descripGrp><ntig><termGrp><term id="1251313">evict</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957107">અપવાદ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25985_1253605_2340589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical representation of data where the intensity of color corresponds to the related analytical data. For example, low values in a range appear as blue (cold) and high values as red (hot).</descrip></descripGrp><ntig><termGrp><term id="1253605">heat map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2340589">ગરમી નકશો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25985_2593079_2340589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical representation of data where the intensity of color corresponds to the related analytical data. For example, low values in a range appear as blue (cold) and high values as red (hot).</descrip></descripGrp><ntig><termGrp><term id="2593079">heatmap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2340589">ગરમી નકશો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2599_211415_496380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Intel microprocessor that uses explicitly parallel instruction set computing and 64-bit memory addressing. "Itanium-based" refers to systems or platforms that are based on the Itanium processor. "Itanium2-based" refers to systems or platforms that are based on the Itanium2 processor. "Itanium architecture-based" refers to systems or platforms that are based on the Itanium and Itanium2 processors.</descrip></descripGrp><ntig><termGrp><term id="211415">Itanium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496380">ઇટેનિયમ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25992_1253847_1650618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online community where members can virtually socialize by posting and commenting on a newsfeed, by chatting, and by sharing photos, images, articles, and other content.</descrip></descripGrp><ntig><termGrp><term id="1253847">social network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1650618">સામાજિક નેટવર્ક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25992_1253847_2797510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online community where members can virtually socialize by posting and commenting on a newsfeed, by chatting, and by sharing photos, images, articles, and other content.</descrip></descripGrp><ntig><termGrp><term id="1253847">social network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2797510">સોશિઅલ નેટવર્ક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25992_2696313_1650618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online community where members can virtually socialize by posting and commenting on a newsfeed, by chatting, and by sharing photos, images, articles, and other content.</descrip></descripGrp><ntig><termGrp><term id="2696313">network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1650618">સામાજિક નેટવર્ક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25992_2696313_2797510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online community where members can virtually socialize by posting and commenting on a newsfeed, by chatting, and by sharing photos, images, articles, and other content.</descrip></descripGrp><ntig><termGrp><term id="2696313">network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2797510">સોશિઅલ નેટવર્ક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26000_1256398_3175388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft program designed to provide a consistent experience for Microsoft partners to obtain real-world customer feedback on Microsoft pre-release products.</descrip></descripGrp><ntig><termGrp><term id="1256398">Technology Adoption Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="3175388">TAP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26000_1256398_3183290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft program designed to provide a consistent experience for Microsoft partners to obtain real-world customer feedback on Microsoft pre-release products.</descrip></descripGrp><ntig><termGrp><term id="1256398">Technology Adoption Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="3183290">Technology Adoption Program</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26000_1256411_3175388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft program designed to provide a consistent experience for Microsoft partners to obtain real-world customer feedback on Microsoft pre-release products.</descrip></descripGrp><ntig><termGrp><term id="1256411">TAP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="3175388">TAP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26000_1256411_3183290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft program designed to provide a consistent experience for Microsoft partners to obtain real-world customer feedback on Microsoft pre-release products.</descrip></descripGrp><ntig><termGrp><term id="1256411">TAP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="3183290">Technology Adoption Program</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26004_1256406_1428547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short summary of the contents of a document that gives the reader a quick overview of its topic and purpose.</descrip></descripGrp><ntig><termGrp><term id="1256406">abstract</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1428547">સારાંશ</term><termNote type="geographicalUsage">IND<