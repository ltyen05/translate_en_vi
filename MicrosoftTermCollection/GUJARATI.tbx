mEntry><termEntry id="43044_2438784_2440758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The drawing app you can use to create simple or elaborate drawings. These drawings can be either black-and-white or color. You can also use Paint to work with pictures, such as .jpg, .gif, or .bmp files.</descrip></descripGrp><ntig><termGrp><term id="2438784">Paint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2440758">Microsoft પેઇન્ટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43044_2438784_2440759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The drawing app you can use to create simple or elaborate drawings. These drawings can be either black-and-white or color. You can also use Paint to work with pictures, such as .jpg, .gif, or .bmp files.</descrip></descripGrp><ntig><termGrp><term id="2438784">Paint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2440759">પેઇન્ટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43053_2439180_2440760"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar, appearing at the top, that displays a small preview image (thumbnail) of the content in each open tab.</descrip></descripGrp><ntig><termGrp><term id="2439180">preview bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2440760">પૂર્વાવલોકન પટ્ટી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43054_2439181_2440762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to see a small preview of the content in each open tab, shown in a persistent bar (not just on mouseover)​.</descrip></descripGrp><ntig><termGrp><term id="2439181">tab preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2440762">ટૅબ પૂર્વાવલોકન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43055_2439182_2440761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To clear or remove all tabs that are currently displayed, and save them as a set of tabs that you can restore later.</descrip></descripGrp><ntig><termGrp><term id="2439182">set aside</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2440761">કાઢી દો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43056_2439225_2450061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The low-code, back-end data platform that includes data storage, a set of common entities with built-in data models, security management, AI, and scalable integration. Its shared data storage provides single-source data consistency that customers can build apps, flows, bots, and AI models on, of varying complexity at scale.</descrip></descripGrp><ntig><termGrp><term id="2439225">Common Data Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2450061">Common Data Service</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43056_2715882_2450061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The low-code, back-end data platform that includes data storage, a set of common entities with built-in data models, security management, AI, and scalable integration. Its shared data storage provides single-source data consistency that customers can build apps, flows, bots, and AI models on, of varying complexity at scale.</descrip></descripGrp><ntig><termGrp><term id="2715882">CDS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2450061">Common Data Service</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43056_2907430_2450061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The low-code, back-end data platform that includes data storage, a set of common entities with built-in data models, security management, AI, and scalable integration. Its shared data storage provides single-source data consistency that customers can build apps, flows, bots, and AI models on, of varying complexity at scale.</descrip></descripGrp><ntig><termGrp><term id="2907430">Dataverse</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2450061">Common Data Service</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43059_2439287_2445115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office tool that erases a portion of an ink stroke up to where it intersects with itself or another ink stroke.</descrip></descripGrp><ntig><termGrp><term id="2439287">Segment Eraser</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2445115">સેગમેન્ટ ઇરેઝર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43060_2439288_2445112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office Lens feature that uses voice guidance to help users with visual impairments center objects in the frame of their camera when taking pictures.</descrip></descripGrp><ntig><termGrp><term id="2439288">Frame Guide</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">