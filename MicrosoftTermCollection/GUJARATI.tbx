type="definition">A feature that a developer provides in an app for consumers to buy from within the app through an in-app purchase transaction.</descrip></descripGrp><ntig><termGrp><term id="1612737">in-app offer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1639760">ઇન-એપ્લિકેશન ઑફર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31689_1612739_1639763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transaction performed by a consumer from within the context of an app to buy additional features for that app.</descrip></descripGrp><ntig><termGrp><term id="1612739">in-app purchase</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1639763">ઇન-એપ્લિકેશન ખરીદી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3169_232421_1856680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of shortcuts to folders that can be displayed in the Shortcuts pane.</descrip></descripGrp><ntig><termGrp><term id="232421">shortcut group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856680">શૉર્ટકટ સમૂહ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="gramma