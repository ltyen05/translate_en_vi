75920">Class Schedule</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1857242">વર્ગ શેડ્યૂલ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31736_1618203_1857077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To publish grades and feedback so that they are available to students.</descrip></descripGrp><ntig><termGrp><term id="1618203">post grades</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1857077">પોસ્ટ ગ્રેડ્સ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31737_1618204_1857078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who is enrolled in a class.</descrip></descripGrp><ntig><termGrp><term id="1618204">student</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1857078">વિદ્યાર્થી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31738_1618205_1857079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A summary of class information, such as the course name and description, a schedule of lessons and assignments, and evaluation criteria.</descrip></descripGrp><ntig><termGrp><term id="1618205">syllabus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1857079">અભ્યાસક્રમ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31739_1618206_1857080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text-based workflow editor that enables users to create and edit workflows by using declarative statements.</descrip></descripGrp><ntig><termGrp><term id="1618206">Text-Based Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1857080">પાઠ-આધારિત ડિઝાઇનર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31740_1707155_1945741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that displays an Office event log in Excel format and helps the user to find and resolve known compatibility issues for Office files and solutions.</descrip></descripGrp><ntig><termGrp><term id="1707155">Office Telemetry Log</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1945741">Office ટેલિમેટ્રી લૉગ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote>