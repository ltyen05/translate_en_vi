termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496123">સુમેળ ફાઇલ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15795_160318_496269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To assign a drive letter, port, or computer name to a shared resource so that you can use it.</descrip></descripGrp><ntig><termGrp><term id="160318">connect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496269">કનેક્ટ કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15796_233422_1944469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To automatically remove items to another folder periodically or delete them, based on the amount of time that they have been in the folder.</descrip></descripGrp><ntig><termGrp><term id="233422">AutoArchive</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1944469">ઑટોઆર્કાઇવ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15804_346948_497087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Possessing improved, advanced,