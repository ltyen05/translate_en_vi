rip type="definition">The Outlook feature that allows users to create cloud attachments either as a link or as a traditional attachment, and that allows users to set permissions for that attachment when it is sent.</descrip></descripGrp><ntig><termGrp><term id="2450822">Modern Attachments</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2454435">આધુનિક જોડાણ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43285_2451017_2454434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pane in Office 365 applications that shows the user information such as previous editors and historical versions of the file they have opened.</descrip></descripGrp><ntig><termGrp><term id="2451017">Activity</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2454434">પ્રવૃત્તિ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43293_2451801_2453311"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Windows Defender app that contains app install rule, SmartScreen settings, and exploit protection settings.​​​</descrip></descripGrp><ntig><termGrp><term id="2451801">App &amp; browser control</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2453311">એપ્લિકેશન અને બ્રાઉઝર નિયંત્રણ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43294_2451802_2453312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Windows Defender app that contains information and actions related to performance and PC health.​​</descrip></descripGrp><ntig><termGrp><term id="2451802">Computer performance &amp; health</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2453312">કમ્પ્યુટર પર્ફોર્મન્સ અને હેલ્થ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43295_2451803_2453313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Windows Defender app for ​family features, linking o the Family tab of the Microsoft account portal.​​</descrip></descripGrp><ntig><termGrp><term id="2451803">Family options</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2453313">કુટુંબ માટેના વિકલ્પો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43296_2451804_2453314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Windows Defender app that contains​ Windows Firewall and other network settings.​​</descrip></descripGrp><ntig><termGrp><term id="2451804">Firewall &amp; network protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2453314">ફાયરવૉલ અને નેટવર્ક સુરક્ષા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43297_2451805_2453315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Windows Defender app that contains all functionalities related to antivirus and threat protection.​​</descrip></descripGrp><ntig><termGrp><term id="2451805">Virus &amp; threat protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2453315">વાયરસ અને જોખમ સામે સુરક્ષા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43299_2451996_2454441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The OneNote feature that allows users to set a picture as a background in their notebooks, type over it,​​ and annotate it.</descrip></descripGrp><ntig><termGrp><term id="2451996">Background pictures</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2454441">પૃષ્ઠભૂમિ ચિત્રો</te