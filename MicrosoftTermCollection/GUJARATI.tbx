ો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4963_67684_495674"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to hardware, to physically connect the device to your computer, to load device drivers onto your computer, and to configure device properties and settings.</descrip></descripGrp><ntig><termGrp><term id="67684">install</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495674">સ્થાપિત કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4964_232406_496437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital address book that is automatically created from contacts in the Contacts folder.</descrip></descripGrp><ntig><termGrp><term id="232406">Outlook Address Book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496437">Outlook સરનામા પુસ્તિકા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4972_75877_1215225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In information processing, an operation performed by the computer at hand rather than by a remote computer.</descrip></descripGrp><