AN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1216396">વ્યક્તિગ ક્ષેત્ર નેટવર્ક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13210_262700_496634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small, Internet Protocol (IP)-based network. It is usually used for short-range, ad-hoc communication between devices and computers. A PAN may also be used to enable connectivity to a larger Local Area Network (LAN), Wide-Area Network (WAN), or the Internet. Windows XP supports the Bluetooth PAN service so you can create Personal Area Networks using Bluetooth.</descrip></descripGrp><ntig><termGrp><term id="262700">PAN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496634">પર્સનલ એરિયા નેટવર્ક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13210_262700_496635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small, Internet Protocol (IP)-based network. It is usually used for short-range, ad-hoc communication between devices and computers. A PAN may also be used to enable connectivity to a larger Local Area Network (LAN), Wide-Area Network (WAN), or the Internet. Windows XP supports the Bluetooth PAN service so you can create Personal Area Networks using Bluetooth.</descrip></descripGrp><ntig><termGrp><term id="262700">PAN</term><termNote type="partOfSpeech