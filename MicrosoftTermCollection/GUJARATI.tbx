="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495486">કસ્ટમ સ્થાપના</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11926_41721_495486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of installation that allows the user to specify certain installation settings and options, such as which components will be installed.</descrip></descripGrp><ntig><termGrp><term id="41721">custom install</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495486">કસ્ટમ સ્થાપના</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11936_23875_495344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of light that is emitted by a computer monitor or picture displayed on the monitor.</descrip></descripGrp><ntig><termGrp><term id="23875">brightness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495344">તેજ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11940_298006_1856715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application that is used to open an attachment for Attachment Previewing.</descrip></descripGrp><ntig><termGrp><term id="298006">Attachment Previewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856715">જોડાણ પ્રીવ્યૂઅર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11947_65138_495664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an environment capable of displaying multiple on-screen windows, any window other than the one currently being used for work. An inactive window can be partially or entirely hidden behind another window, and it remains inactive until the user selects it.</descrip></descripGrp><ntig><termGrp><term id="65138">inactive window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495664">નિષ્ક્રિય વિંડો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11961_180264_2855495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trust relationship between two or more SIP domains that permits users in separate organizations to communicate in real time across network boundaries.</descrip></descripGrp><ntig><termGrp><term id="180264">federation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2855495">ફેડ