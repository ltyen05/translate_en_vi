y forum for Windows Insiders.</descrip></descripGrp><ntig><termGrp><term id="2254408">Windows Insider Community Forum</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2258459">Windows ઇનસાઇડર સમુદાય ફૉરમ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3871_232400_1415546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to time when an individual has nothing scheduled and appears as  available.</descrip></descripGrp><ntig><termGrp><term id="232400">free</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1415546">ખાલી</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38721_2255320_2258449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A catalog of information for apps, games, movies and TV shows based on dynamic information such as new or fastest rising, top free, best rated, and top paid.</descrip></descripGrp><ntig><termGrp><term id="2255320">chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2258449">ચાર્ટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammatic