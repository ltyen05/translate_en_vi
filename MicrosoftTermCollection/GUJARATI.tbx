69"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to link two Xbox controllers together in a game and use them as one, with both controllers maintaining full control.</descrip></descripGrp><ntig><termGrp><term id="3181769">controller assist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="3182269">Xbox કન્ટ્રોલર આસિસ્ટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45068_3182031_3182264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to link two Xbox controllers together in a game and use them as one, with both controllers maintaining full control.</descrip></descripGrp><ntig><termGrp><term id="3182031">Xbox controller assist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="3182264">કન્ટ્રોલર આસિસ્ટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45068_3182031_3182269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to link two Xbox controllers together in a game and use them as one, with both controllers maintaining full control.</descrip></descripGrp><ntig><termGrp><term id="3182031">Xbox controller assist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet>