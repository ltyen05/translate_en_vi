></ntig></langSet></termEntry><termEntry id="6977_340130_2748158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To switch between active calls.</descrip></descripGrp><ntig><termGrp><term id="340130">swap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2748158">સ્વૅપ કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6985_58943_495625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gradual progression.</descrip></descripGrp><ntig><termGrp><term id="58943">gradient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495625">ગ્રેડિઅન્ટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6987_1354392_1961347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of attributes that provides an indication of a person's status, activity, location, willingness to communicate, and contact information.</descrip></descripGrp><ntig><termGrp><term id="1354392">presence information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1961347">ઉપસ્થિતિ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="