riteria.</descrip></descripGrp><ntig><termGrp><term id="2357846">Quick Filters for message list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2359675">સંદેશ સૂચી માટે ઝડપી ફિલ્ટર્સ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39857_2312655_2322321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that intelligently presorts email across all email accounts.</descrip></descripGrp><ntig><termGrp><term id="2312655">Focused Inbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2322321">ફોકસ કરાયેલ ઇનબૉક્સ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39858_2312656_2322325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu selection that allows users to move emails from the focused inbox into the Other category.</descrip></descripGrp><ntig><termGrp><term id="2312656">Move to Non-Focused Inbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2322325">ફોકસ ન કરાયેલ ઇનબૉક્સ પર ખસેડો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39864_2322624_2328056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The wireless personal area network technology, launched in 2010 and marketed as Bluetooth Smart, used for transmitting data over distances as much as 100 meters. Cost and power consumption are low while maintaining a communication range similar to Bluetooth BR/EDR, the other widely-used version of Bluetooth</descrip></descripGrp><ntig><termGrp><term id="2322624">Bluetooth Smart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2328056">Bluetooth Smart</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39866_2315181_2321790"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Bluetooth Low Energy device that sends static information, such as location or ID, to devices within its area.</descrip></descripGrp><ntig><termGrp><term id="2315181">beacon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2321790">બીકન</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3987_141789_1856562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A placeholder text that included the field character, field type, and instructions, and that that shows where specified information from a data source will appear such that the elements in a field that generate a field's result.</descrip></descripGrp><ntig><termGrp><term id="141789">field code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856562">ફીલ્ડ કોડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39877_2315966_2321796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature for maps of the interior of some public places, such as the businesses inside a mall, or the gates, businesses, and other services inside an airport.</descrip></descripGrp><ntig><termGrp><term id="2315966">venue map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2321796">સ્થાનનો નકશો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39878_2316274_2321794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of apps or services made available in an enterprise to help with particular business and process needs.</descrip></descripGrp><ntig><termGrp><term id="2316274">line-of-business</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2321794">લાઇન-ઑફ-બિઝનેસ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39878_2316274_2321795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of apps or services made available in an enterprise to help with particular business and process needs.</descrip></descripGrp><ntig><termGrp><term id="2316274">line-of-business</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2321795">LOB</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39878_2316275_2321794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of apps or services made available in an enterprise to help with particular business and process needs.</descrip></descripGrp><ntig><termGrp><term id="2316275">LOB</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2321794">લાઇન-ઑફ-બિઝનેસ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39878_2316275_2321795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of apps or services made available in an enterprise to help with particular business and process needs.</descrip></descripGrp><ntig><termGrp><term id="2316275">LOB</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2321795">LOB</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39880_2320100_2325557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for PC and Surface Hub that helps you connect a phone or PC to the Surface Hub display, or to another PC. On Surface Hub, it also allows you to switch between devices that are connected to the Surface Hub.​</descrip></descripGrp><ntig><termGrp><term id="2320100">Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2325557">કનેક્ટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39882_2320437_2321797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for purchasing cellular data that is packaged with cellular enabled Dell devices that include a Microsoft SIM card.</descrip></descripGrp><ntig><termGrp><term id="2320437">Dell NetReady</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2321797">Dell NetReady</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39889_2321509_2325564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of TV shows that are in the top N% of ratings.</descrip></descripGrp><ntig><termGrp><term id="2321509">Top-rated TV shows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2325564">ટોચના રેટ કરેલ ટીવી શોઝ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39890_2321510_2325558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of items emphasized to the customer through placement on the site.</descrip></descripGrp><ntig><termGrp><term id="2321510">Featured collections</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2325558">વૈશિષ્ટિકૃત સંગ્રહો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39891_2321511_2325561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make your search results more relevant by excluding unwanted and extraneous items.</descrip></descripGrp><ntig><termGrp><term id="2321511">refine</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2325561">રિફાઇન કરો</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39892_2321518_2325560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows customers to temporarily connect to available free Wi-Fi hotspots in order to find and buy Wi-Fi services from the Windows Store.</descrip></descripGrp><ntig><termGrp><term id="2321518">paid Wi-Fi services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2325560">સશુલ્ક Wi-Fi સેવાઓ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39932_2323787_2331193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To create a sway.</descrip></descripGrp><ntig><termGrp><term id="2323787">sway</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2331193">sway</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39933_2323799_2329099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets users link their inbox for one email account with an inbox for another account, so they can see the messages from both accounts in a single place.</descrip></descripGrp><ntig><termGrp><term id="2323799">Linked Inboxes</term>