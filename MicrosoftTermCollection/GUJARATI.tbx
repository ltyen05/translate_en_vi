">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4097_87181_495823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that uses multidimensional structures to provide rapid access to data for analysis. The source data for OLAP is commonly stored in data warehouses in a relational database.</descrip></descripGrp><ntig><termGrp><term id="87181">OLAP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495823">ઑનલાઇન વિશ્લેષણાત્મક પ્રક્રિયાકરણ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4097_87182_495822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that uses multidimensional structures to provide rapid access to data for analysis. The source data for OLAP is commonly stored in data warehouses in a relational database.</descrip></descripGrp><ntig><termGrp><term id="87182">online analytical processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495822">OLAP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4097_87182_495823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that uses multidimensional structures to provide rapid access to data for analysis. The source data for OLAP is commonly stored in data warehouses in a relational database.</descrip></descripGrp><ntig><termGrp><term id="87182">online analytical processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="495823">ઑનલાઇન વિશ્લેષણાત્મક પ્રક્રિયાકરણ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41_340083_497066"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to open any XAML file on your hard disk (or a hyperlink on a web page) and run it within a browser without compilation.</descrip></descripGrp><ntig><termGrp><term id="340083">Loose XAML</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="497066">લૂઝ XAML</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4103_232523_496451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slide view or page on which you define formatting for all slides or pages in your presentation. Each presentation has a master for each key component: slides, title slides, speaker's notes, and audience handouts.</descrip></descripGrp><ntig><termGrp><term id="232523">master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496451">માસ્ટર</term><termNote type="geographi