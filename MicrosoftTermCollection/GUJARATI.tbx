mber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1216360">કાર્યક્ષમતા બોનસ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="947_233127_1856701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agreement between a service provider and a customer that specifies the amount and type of service the provider will deliver.</descrip></descripGrp><ntig><termGrp><term id="233127">service agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856701">સેવા કરાર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9478_138885_496120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The horizontal bar at the top of a column. You can click a column selector to select an entire column in the query design grid or the filter design grid.</descrip></descripGrp><ntig><termGrp><term id="138885">column selector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496120">હરોળ ચયનકર્તા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9483_55065_3074259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change the orientation of a selected object horizontally, vertically, or in both directions.</descrip></descripGrp><ntig><termGrp><term id="55065">flip</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="3074259">ફ્લિપ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9488_115096_1856509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that is not found on your keyboard and must be inserted from within the software or by pressing a combination of keys on your keyboard.</descrip></descripGrp><ntig><termGrp><term id="115096">special character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856509">વિશેષ વર્ણ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9502_307442_1957243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The prefix that is used to access an outside line. In the United States, this prefix is typically 9.</descrip></descripGrp><ntig><termGrp><term id="307442">outside line access code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957243">આઉટસાઇડ લાઇન ઍક્સેસ કોડ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">