/ntig></langSet></termEntry><termEntry id="16775_1049762_1748212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Remote Desktop Services that enables the user to access a program remotely through Remote Desktop Services but have it appear as if it is running on the user's local computer. Users can run RemoteApp programs side by side with their local programs.</descrip></descripGrp><ntig><termGrp><term id="1049762">RemoteApp</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1748212">RemoteApp</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16775_616468_1748212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Remote Desktop Services that enables the user to access a program remotely through Remote Desktop Services but have it appear as if it is running on the user's local computer. Users can run RemoteApp programs side by side with their local programs.</descrip></descripGrp><ntig><termGrp><term id="616468">Terminal Services RemoteApp</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1748212">RemoteApp</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16775_616469_1748212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Remote Desktop Services that enables the user to access a program remotely through Remote Desktop Services but have it appear as if it is running on the user's local computer. Users can run RemoteApp programs side by side with their local programs.</descrip></descripGrp><ntig><termGrp><term id="616469">TS RemoteApp</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1748212">RemoteApp</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1679_1370400_496575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The W3C standard language used for writing XML schema documents.</descrip></descripGrp><ntig><termGrp><term id="1370400">XSD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496575">XML સ્કીમા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1679_1536620_496575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The W3C standard language used for writing XML schema documents.</descrip></descripGrp><ntig><termGrp><term id="1536620">XML schema definition language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496575">XML સ્કીમા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1679_1536621_496575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The W3C standard language used for writing XML schema documents.</descrip></descripGrp><ntig><termGrp><term id="1536621">XSDL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496575">XML સ્કીમા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1679_257436_496575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The W3C standard language used for writing XML schema documents.</descrip></descripGrp><ntig><termGrp><term id="257436">XML schema</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496575">XML સ્કીમા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16798_616805_1856779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft implementation of an integrity level. In particular, a protection level, refers to an integrity label that contains only level information, without the additional information traditionally contained within integrity level.</descrip></descripGrp><ntig><termGrp><term id="616805">protection level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856779">રક્ષણ સ્તર</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1682_114990_1856508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An array (arrangement of items) in which many of the entries are identical, commonly zero. It is not possible to define precisely when an array is sparse, but it is clear that at some point, usually when about one-third of the array consists of identical entries, it becomes worthwhile to redefine the array.</descrip></descripGrp><ntig><termGrp><term id="114990">sparse array</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856508">સ્પાર્સ અરે</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16829_2460878_1358035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of user account that allows complete access to the computer or program. Administrators can make any desired changes. This account type is not recommended for daily use, and should only be used when necessary.</descrip></descripGrp><ntig><termGrp><term id="2460878">admin account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358035">વ્યવસ્થાપક ખાતું</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16829_621421_1358035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of user account that allows complete access to the computer or program. Administrators can make any desired changes. This account type is not recommended for daily use, and should only be used when necessary.</descrip></descripGrp><ntig><termGrp><term id="621421">administrator account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1358035">વ્યવસ્થાપક ખાતું</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1685_42287_3027243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of creating a link between a property and a source. The source can be local or external.</descrip></descripGrp><ntig><termGrp><term id="42287">data binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="3027243">ડેટા બાઇન્ડિંગ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1685_494335_3027243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of creating a link between a property and a source. The source can be local or external.</descrip></descripGrp><ntig><termGrp><term id="494335">binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Ma