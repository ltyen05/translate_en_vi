rsions of Office to exist on the same computer to provide a seamless transition for users in supported scenarios.</descrip></descripGrp><ntig><termGrp><term id="1644697">Office Side-by-Side</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1857191">Office સાથે-સાથે</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32270_1645770_1857192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint document library that administrators can use to distribute apps for Office and SharePoint to their end users.</descrip></descripGrp><ntig><termGrp><term id="1645770">App Catalog</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1857192">એપ કૅટલૉગ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32271_1645771_1857193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual page in a topic series, or any page that is primarily search-driven.</descrip></descripGrp><ntig><termGrp><term id="1645771">dynamic landing page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1857193">ડાયનામિક લેન્ડિંગ પૃષ્ઠ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammati