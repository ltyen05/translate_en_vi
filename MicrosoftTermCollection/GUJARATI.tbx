rip type="definition">An application that consolidates a user's voice mail, fax, and email into one mailbox, so that the user only needs to check a single location for messages, regardless of type. The email server is used as the platform for all types of messages, making it unnecessary to maintain separate voice mail and email infrastructures.</descrip></descripGrp><ntig><termGrp><term id="1230148">UM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957347">યુનિફાઇડ મેસેજિંગ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12314_234514_1957345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that consolidates a user's voice mail, fax, and email into one mailbox, so that the user only needs to check a single location for messages, regardless of type. The email server is used as the platform for all types of messages, making it unnecessary to maintain separate voice mail and email infrastructures.</descrip></descripGrp><ntig><termGrp><term id="234514">Unified Messaging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1957345">UM</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12314_234514_1957347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that consolidates a user's voice mail, fax, and email into one mailbox, so that