"partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2955296">Microsoft 365 A1</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49797_2816504_2955297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 Education offering for mid-size to large schools. It includes all the features of A1 plus Office client applications, Minecraft, Delve, management and security features, and server and CAL benefits.</descrip></descripGrp><ntig><termGrp><term id="2816504">Microsoft 365 A3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2955297">Microsoft 365 A3</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49798_2816505_2955299"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 Education offering for large schools. It includes all the features of A1 and A3 plus additional analytics and advanced security features.</descrip></descripGrp><ntig><termGrp><term id="2816505">Microsoft 365 A5</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2955299">Microsoft 365 A5</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSele