Usage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11225_477232_1856662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that helps you create or edit a formula and also provides information about functions and their arguments.</descrip></descripGrp><ntig><termGrp><term id="477232">Formula Builder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856662">સૂત્ર પૅલેટ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11225_477232_1856740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that helps you create or edit a formula and also provides information about functions and their arguments.</descrip></descripGrp><ntig><termGrp><term id="477232">Formula Builder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856740">સૂત્ર સર્જક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11229_231980_1856669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Query window that displays the tables in a query. Each table displays the fields from which you can retrieve data.</descrip></descripGrp><ntig><termGrp><term id="231980">table pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="1856669">કોષ્ટક ફલક</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11232_231971_496432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a PivotTable report, the summarized data calculated from the data fields of a source list or table.</descrip></descripGrp><ntig><termGrp><term id="231971">PivotTable data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="496432">PivotTable ડેટા</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1124_49642_2290012"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of routines that an application uses to request and carry out lower-level services performed by a computer's or device's operating system. These routines usually carry out maintenance tasks such as managing files and displaying information.</descrip></descripGrp><ntig><termGrp><term id="49642">API</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="gu"><ntig><termGrp><term id="2290012">એપ્લિકેશન પ્રોગ્રામિંગ ઇન્ટરફેસ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular