><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2852877">CSPM</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50273_2843780_2852875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of security tools that assures a continuous process of cloud security improvement and adaptation to reduce the likelihood of a successful attack, including use cases for compliance monitoring, DevOps integration, incident response, risk assessment, and risk visualization.</descrip></descripGrp><ntig><termGrp><term id="2843780">CSPM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2852875">bulut xavfsizligi holatini boshqarish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50273_2843780_2852877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of security tools that assures a continuous process of cloud security improvement and adaptation to reduce the likelihood of a successful attack, including use cases for compliance monitoring, DevOps integration, incident response, risk assessment, and risk visualization.</descrip></descripGrp><ntig><termGrp><term id="2843780">CSPM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2852877">CSPM</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><term