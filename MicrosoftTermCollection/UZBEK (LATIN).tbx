935917">matn atributlari</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="803_44794_1684474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The work area on a computer screen that simulates the top of an actual desk. The desktop contains the Recycle Bin and other icons (shortcuts to programs, files, folders, and various types of documents such as letters, reports, or pictures) that you can arrange on the electronic desktop just as you would arrange real objects on top of a desk.</descrip></descripGrp><ntig><termGrp><term id="44794">desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1684474">ishchi stol</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8030_37385_1935775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To join sequentially (for example, to combine the two strings "hello" and "there" into the single string "hello there").</descrip></descripGrp><ntig><termGrp><term id="37385">concatenate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1935775">matashtirmoq</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8036_116444_469880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A horizontal window at the bottom of a parent window in which an application can display various kinds of status information. The status bar can be divided into parts to display more than one type of information.</descrip></descripGrp><ntig><termGrp><term id="116444">status bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469880">holat satri</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8040_149410_470121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that uses the UNION operator to combine the results of two or more select queries.</descrip></descripGrp><ntig><termGrp><term id="149410">union query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470121">birlashgan so‘rovlar</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8043_94462_1181825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In word processors and other applications, the feature that formats a document for printing but displays it on the video monitor rather than sending it directly to the printer.</descrip></descripGrp><ntig><termGrp><term id="94462">preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1181825">dastlabki ko‘rib chiqish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8058_125224_469930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The _ character.</descrip></descripGrp><ntig><termGrp><term id="125224">underscore</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469930">pastki chiziqcha</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8058_319169_469930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The _ character.</descrip></descripGrp><ntig><termGrp><term id="319169">LOW LINE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469930">pastki chiziqcha</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="807_22891_1181727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of starting or resetting a computer or a device. When first turned on (cold boot) or reset (warm boot), the computer runs the software that loads and starts the computer's operating system, which prepares it for use.</descrip></descripGrp><nti