icalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3029486">Izlanish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50441_2855883_3025798"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any content that is linked from the Internet or an intranet to a workbook or presentation. Some examples of external content are images, linked media, data connections, and templates.</descrip></descripGrp><ntig><termGrp><term id="2855883">external content</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3025798">tashqi kontent</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50442_2855884_3027303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Office applications, a small bar beneath the ribbon or in another location on the UI that shows messages.</descrip></descripGrp><ntig><termGrp><term id="2855884">business bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3027303">biznes paneli</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50443_2855885_3025794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Excel, a rectangular window that appears when the user clicks an icon in either a Stocks or Geography data cell and displays information that was retrieved from Bing or another source.</descrip></descripGrp><ntig><termGrp><term id="2855885">card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3025794">kartochka</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50446_2855888_3029502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In contrast to live tiles, an icon that does not pull information from the internet (news feeds, etc.)</descrip></descripGrp><ntig><termGrp><term id="2855888">static icon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3029502">statik belgi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50447_3053601_3053765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that enforces policy settings for Microsoft 365 apps on a user’s device, even if the device isn’t domain joined or otherwise managed.</descrip></descripGrp><ntig><termGrp><term id="3053601">Cloud Policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><t