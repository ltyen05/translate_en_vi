id="1836416">saqlash kartasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20542_725949_1836429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of visual elements and sounds for your computer desktop or device User Interface. A theme determines the look of the various visual elements of your User Interface, such as windows, icons, fonts, and colors, and it can include sounds.</descrip></descripGrp><ntig><termGrp><term id="725949">theme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1836429">mavzu</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20542_725950_1836429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of visual elements and sounds for your computer desktop or device User Interface. A theme determines the look of the various visual elements of your User Interface, such as windows, icons, fonts, and colors, and it can include sounds.</descrip></descripGrp><ntig><termGrp><term id="725950">desktop theme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1836429">mavzu</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20543_760171_1771268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Internet Explorer feature that allows users to surf the Web without leaving a browsing history, cookies or other information on the PC so they can do online banking on a shared computer, for example.</descrip></descripGrp><ntig><termGrp><term id="760171">InPrivate</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1771268">InPrivate</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20548_2777447_3088546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security capability designed to protect users if they try to visit websites previously reported as phishing or containing malware, or if they try to download potentially malicious files​.</descrip></descripGrp><ntig><termGrp><term id="2777447">Microsoft Defender SmartScreen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3088546">Microsoft Defender SmartScreen</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20560_725996_1770434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service for wireless products that allows users to send and receive brief messages consisting of text and numbers to and from mobile phones and devices.</descrip></des