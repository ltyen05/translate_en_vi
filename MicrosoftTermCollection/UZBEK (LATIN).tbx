69539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability of many programs and operating systems to display advice or instructions for using their features when so requested by the user, as by a screen button or menu item or a function key.</descrip></descripGrp><ntig><termGrp><term id="61011">online help</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469539">yordam</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13863_107546_469828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In facsimile and other optical technologies, to move a light-sensitive device across an image-bearing surface such as a page of text, converting the light and dark areas on the surface to binary digits that can be interpreted by a computer.</descrip></descripGrp><ntig><termGrp><term id="107546">scan</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469828">skanerlamoq</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13865_185672_1375203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small graphical symbol the user can insert into instant messages.</descrip></descripGrp><ntig><termGrp><term id="185672">emoticon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1375203">hissiyot ikonachalari</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13865_185672_2061535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small graphical symbol the user can insert into instant messages.</descrip></descripGrp><ntig><termGrp><term id="185672">emoticon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2061535">kayfiyat tasvirchasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13865_185672_2083291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small graphical symbol the user can insert into instant messages.</descrip></descripGrp><ntig><termGrp><term id="185672">emoticon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083291">hissiyot ikonchasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13873_122536_469924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual song or other discrete piece of audio content.</descrip></descripGrp><ntig><termGrp><term id="122536">track</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469924">yo‘lakcha</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13873_640881_469924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual song or other discrete piece of audio content.</descrip></descripGrp><ntig><termGrp><term id="640881">audio track</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469924">yo‘lakcha</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13874_120089_469903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that represents an item or program that is open and running on your computer. For example, if you open Microsoft Word, and then minimize it, it will be displayed as a taskbar button, which you can then click when you want to maximize it.</descrip></descripGrp><ntig><termGrp><term id="120089">taskbar button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469903">vazifalar paneli tugmachasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13883_43673_469402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To detect, locate, and correct logical or syntactical errors in a program or malfunctions in hardware. In hardware contexts, the term troubleshoot is the term more often used, especially when the problem is a major one.</descrip></descripGrp><ntig><termGrp><term id="43673">debug</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469402">tuzatmoq</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13888_237793_2852407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A testing process that supplies structured but invalid input to software application programming interfaces (APIs) and network interfaces to maximize the likelihood of detecting errors that might lead to software vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="237793">fuzz testing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2852407">fazz test</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13888_237793_2852409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A testing process that supplies structured but invalid input to software application programming interfaces (APIs) and network interfaces to maximize the likelihood of detecting errors that might lead to software vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="237793">fuzz testing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2852409">fazzing</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13888_767358_2852407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A testing process that supplies structured but invalid input to software application programming interfaces (APIs) and network interfaces to maximize the likelihood of detecting errors that might lead to software vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="767358">fuzzing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2852407">fazz test</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13888_767358_2852409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A testing process that supplies structured but invalid input to software application programming interfaces (APIs) and network interfaces to maximize the likelihood of detecting errors that might lead to software vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="767358">fuzzing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2852409">fazzing</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13894_297011_470650"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that installs other potentially unwanted software, such as adware or spyware. The license agreement of the bundling program may require these other components in order to function.</descrip></descripGrp><ntig><termGrp><term id="297011">software bundler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470650">joylovchi dastur</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13902_142582_1935869"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microphone feature that allows your input to be amplified so that it is made louder for use by the system.</descrip></descripGrp><ntig><termGrp><term id="142582">gain adjustment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1935869">olishni sozlash</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13907_109815_1935808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An executable program file that contains one or more compressed text or data files. When a user runs the program, it uncompresses the compressed files and stores them on the user's hard drive.</descrip></descripGrp><ntig><termGrp><term id="109815">self-extracting file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1935808">o'zi ochiladigan fayl</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13920_23913_469248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of or relating to communications systems in which the medium of transmission (such as a wire or fiber-optic cable) carries multiple messages at a time, each message modulated on its own carrier frequency by a modem.</descrip></descripGrp><ntig><termGrp><term id="23913">broadband</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469248">keng yo‘lli</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13926_299909_470672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows technology that collects data when the system crashes or stops responding and sends it to Microsoft.</descrip></descripGrp><ntig><termGrp><term id="299909">Windows Error Reporting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470672">Windows xatolari haqida hisobotlar</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13926_558472_470672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows technology that collects data when the system crashes or stops responding and sends it to Microsoft.</descrip></descripGrp><ntig><termGrp><term id="558472">WER</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470672">Windows xatolari haqida hisobotlar</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13932_186191_470248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the presets for 3D rotation effects. When selected, specifies that the object will be rotated isometrically.</descrip></descripGrp><ntig><termGrp><term id="186191">isometric</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470248">izometrik</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13946_109605_469842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark text, cells, and similar items that will be subject to a user action, such as copying text.</descrip></descripGrp><ntig><termGrp><term id="109605">select</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469842">tanlamoq</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13947_545693_2579058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides a home for the Office Scrapbook, Compatibility Report, Project Palette and Reference Pane and is shown as a floating palette.</descrip></descripGrp><ntig><termGrp><term id="545693">Toolbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2579058">asboblar paneli</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13951_308301_470706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The price at which a buyer has offered to purchase an item.</descrip></descripGrp><ntig><termGrp><term id="308301">bid</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470706">taklif qilingan narx</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13955_1509