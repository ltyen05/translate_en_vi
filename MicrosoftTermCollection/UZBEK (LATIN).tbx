te type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38416_2226110_2230941"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that is installed as part of the MultiPoint role on server and ensures that some MultiPoint configuration settings remain set to keep Windows MultiPoint Server running smoothly.</descrip></descripGrp><ntig><termGrp><term id="2226110">Windows MultiPoint Server Repair Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2230941">Windows MultiPoint Server ta’mirlash xizmati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38418_2226112_2230926"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in the Messaging app that detects whether an SMS message is spam, based on its content.</descrip></descripGrp><ntig><termGrp><term id="2226112">smart blocking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2230926">smart bloklash</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38419_2227157_2230912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keypad that is available in Programmer mode, which allows the user to look at numbers represented as various combinations of 1s and 0s, and to toggle between 1 and 0 for each binary bit to form a new number.</descrip></descripGrp><ntig><termGrp><term id="2227157">bit toggling keypad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2230912">ikkilik klaviatura</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38420_2227158_2230913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of thematically related apps, games, music tracks, videos, or other items available for purchase or download in the Store. A thematic group of editorially chosen apps and games for merchandising or marketing purposes.</descrip></descripGrp><ntig><termGrp><term id="2227158">Collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2230913">To‘plam</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38421_2227159_2230914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to select a color and increase or decrease the vibrancy of that color in an image.</descrip></descripGrp><ntig><termGrp><term id="2227159">color boost</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2230914">rangni o‘zgartirish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38422_2227160_2792360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu invoked with a shortcut key (Windows + G) when gaming that allows users to take a screenshot, take a 30 second clip of a game, and adjust volume controls.</descrip></descripGrp><ntig><termGrp><term id="2227160">Game Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2792360">Game Bar</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2227161_2230920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2227161">IoT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2230920">IoT</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2227161_2269773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2227161">IoT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2269773">Internet vositasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2268355_2230920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2268355">Internet of Things</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2230920">IoT</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2268355_2269773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2268355">Internet of Things</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2269773">Internet vositasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38424_2227162_2230924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A broad set of all the user's local and cloud-based content, including documents, apps, settings, photos, videos, music, and email.  Cortana or Bing can search this content and return it in search results.</descrip></descripGrp><ntig><termGrp><term id="2227162">my stuff</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2230924">mening narsalarim</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38426_2227164_2230929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A note, handwritten or typed, that can be added by the user directly on webpages from within the browser.</descrip></descripGrp><ntig><termGrp><term id="2227164">Web Note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2230929">Veb-eslatma</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38427_2227165_2230930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 available through volume licensing, that is designed for education institutions, and includes all of the features of Windows 10 Pro, plus some other features like virtualization, management, DirectAccess, and BranchCache.</descrip></descripGrp><ntig><termGrp><term id="2227165">Windows 10 Education</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2230930">Windows 10 Education</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38428_2227166_2230931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 that is available only through volume licensing, is designed for businesses, and includes all of the features of Windows 10 Pro, plus some other features like virtualization, management, DirectAccess, and BranchCache.</descrip></descripGrp><ntig><termGrp><term id="2227166">Windows 10 Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2230931">Windows 10 Enterprise</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38429_2227167_2230933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 designed for HoloLens.</descrip></descripGrp><ntig><termGrp><term id="2227167">Windows 10 Holographic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2230933">Windows 10 Holographic</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38430_2227168_2230934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 designed for home users.</descrip></descripGrp><ntig><termGrp><term id="2227168">Windows 10 Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2230934">Windows 10 Home</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38431_2227169_2230936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 optimized for fixed function IoT devices.</descrip></descripGrp><ntig><termGrp><term id="2227169">Windows 10 IoT Core</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2230936">Windows 10 IoT Core</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38432_2227170_2230937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 for a range of powerful IoT devices that provides granular lockdown capabilities, Win32 and modern app support.</descrip></descripGrp><ntig><termGrp><term id="2227170">Windows 10 IoT Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><te