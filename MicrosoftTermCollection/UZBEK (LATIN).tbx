th respect to a set of axes (or a row and column).</descrip></descripGrp><ntig><termGrp><term id="39765">coordinate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469378">koordinat</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4190_125903_1817074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An external bus that supports Plug and Play installation, which enables you to connect and disconnect devices without shutting down or restarting your computer.</descrip></descripGrp><ntig><termGrp><term id="125903">universal serial bus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1817074">USB</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4190_125904_1817074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An external bus that supports Plug and Play installation, which enables you to connect and disconnect devices without shutting down or restarting your computer.</descrip></descripGrp><ntig><termGrp><term id="125904">USB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1817074">USB</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatica