 type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469413">ko‘chirish joyi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="308_475234_2490383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who is responsible for a particular record in the system and is frequently allowed to perform actions on the record that other users cannot.</descrip></descripGrp><ntig><termGrp><term id="475234">owner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2490383">javobgar shaxs</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3084_77397_1859502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location where email is delivered.</descrip></descripGrp><ntig><termGrp><term id="77397">mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1859502">xabarlar qutisi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3084_77397_469656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location where email is deli