6555_470802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To translate all the source code of a program from a high-level language into object code prior to execution of the program.</descrip></descripGrp><ntig><termGrp><term id="36555">compile</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470802">yig‘moq</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9521_253747_2708196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account provided in a local domain for a user whose regular account is not in a trusted domain. A local account cannot be used to log on interactively. Further, a local account created in one domain cannot be used in a trusted domain.</descrip></descripGrp><ntig><termGrp><term id="253747">local account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2708196">mahalliy hisob</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9534_258951_470487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of precision and exactness with which one entity represents another.</descrip></descripGrp><ntig><termGrp><term id="258951">fidelity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470487">aniqlik</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9536_61276_469540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For a computer system, to be in an inactive state, but not shut off. When the computer is switched back on, the desktop is restored exactly as it was.</descrip></descripGrp><ntig><termGrp><term id="61276">hibernate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469540">kutish tartibiga o‘tmoq</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9543_415057_1936031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of a dimension whose value is calculated at run time by using an expression. Calculated member values can be derived from the values of other members.</descrip></descripGrp><ntig><termGrp><term id="415057">calculated member</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936031">hisoblangan a'zo</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9547_177819_470203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document that contains general release information and late changes. It is one of the deliverables leading to the release readiness approved milestone.</descrip></descripGrp><ntig><termGrp><term id="177819">release notes</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470203">nashr eslatmalari</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9552_266832_1936013"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A secondary data source that is accessible to users who fill out forms offline. When a user is online, data from the data source is stored on the user’s computer so that it can appear in controls when the form is offline.</descrip></descripGrp><ntig><termGrp><term id="266832">offline data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936013">oflayn ma'lumot manbai</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9555_139836_1181842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field you can create. A custom field can be a blank, combination, or formula field.</descrip></descripGrp><ntig><termGrp><term id="139836">custom field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1181842">foydalanuvchi maydoni</term><termN