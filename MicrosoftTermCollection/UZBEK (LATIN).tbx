4">Office Intelligent Services</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43042_2438463_2442262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">​​The Editor feature that detects potentially incorrect verbal conjugation and offers suggestions to correct the error.​</descrip></descripGrp><ntig><termGrp><term id="2438463">Incorrect Verb Form</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2442262">Fe’l shakli xato</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43043_2438464_2442261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Editor feature that detects potentially incorrect pronoun use and offers suggestions to correct the error.</descrip></descripGrp><ntig><termGrp><term id="2438464">Incorrect Pronoun Case</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2442261">Olmosh xato ishlatilgan</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43044_2438783_2440582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The drawing app you can use to create simple or elaborate drawings. These drawings can be either black-and-white or color. You can also use Paint to work with pictures, such as .jpg, .gif, or .bmp files.</descrip></descripGrp><ntig><termGrp><term id="2438783">Microsoft Paint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2440582">Microsoft Paint</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43044_2438783_2440583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The drawing app you can use to create simple or elaborate drawings. These drawings can be either black-and-white or color. You can also use Paint to work with pictures, such as .jpg, .gif, or .bmp files.</descrip></descripGrp><ntig><termGrp><term id="2438783">Microsoft Paint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2440583">Paint</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43044_2438784_2440582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The drawing app you can use to create simple or elaborate drawings. These drawings can be either black-and-white or color. You can also use Paint to work with pictures, such as .jpg, .gif, or .bmp files.</descrip></descripGrp><ntig><termGrp><term id="2438784">Paint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2440582">Microsoft Paint</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43044_2438784_2440583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The drawing app you can use to create simple or elaborate drawings. These drawings can be either black-and-white or color. You can also use Paint to work with pictures, such as .jpg, .gif, or .bmp files.</descrip></descripGrp><ntig><termGrp><term id="2438784">Paint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2440583">Paint</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43046_2438994_2672001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool in Paint 3D for selecting part of an image. The tool automatically detects the contours of a key area within a selected rectangle, and adjusts the selection to just that area. Once a user creates a cutout, it is popped off of the picture and becomes a new layer to work with. The background that it was selected from magically fills in.​</descrip></descripGrp><ntig><termGrp><term id="2438994">magic select</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2672001">sehrli belgilash</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43053_2439180_2440584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar, appearing at the top, that displays a small preview image (thumbnail) of the content in each open tab.</descrip></descripGrp><ntig><termGrp><term id="2439180">preview bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2440584">eskiz ko‘rsatish paneli</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43054_2439181_2440586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to see a small preview of the content in each open tab, shown in a persistent bar (not just on mouseover)​.</descrip></descripGrp><ntig><termGrp><term id="2439181">tab preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2440586">ilova eskizi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43055_2439182_2440585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To clear or remove all tabs that are currently displayed, and save them as a set of tabs that you can restore later.</descrip></descripGrp><ntig><termGrp><term id="2439182">set aside</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2440585">chetga olib qo‘yish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43056_2439225_2450101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The low-code, back-end data platform that includes data storage, a set of common entities with built-in data models, security management, AI, and scalable integration. Its shared data storage provides single-source data consistency that customers can build apps, flows, bots, and AI models on, of varying complexity at scale.</descrip></descripGrp><ntig><termGrp><term id="2439225">Common Data Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2450101">Common Data Service</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43056_2715882_2450101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The low-code, back-end data platform that includes data storage, a set of common entities with built-in data models, security management, AI, and scalable integration. Its shared data storage provides single-source data consistency that customers can build apps, flows, bots, and AI models on, of varying complexity at scale.</descrip></descripGrp><ntig><termGrp><term id="2715882">CDS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2450101">Common Data Service</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43056_2907430_2450101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The low-code, back-end data platform that includes data storage, a set of common entities with built-in data models, security management, AI, and scalable integration. Its shared data storage provides single-source data consistency that customers can build apps, flows, bots, and AI models on, of varying complexity at scale.</descrip></descripGrp><ntig><termGrp><term id="2907430">Dataverse</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2450101">Common Data Service</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43059_2439287_2445079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office tool that erases a portion of an ink stroke up to where it intersects with itself or another ink stroke.</descrip></descripGrp><ntig><termGrp><term id="2439287">Segment Eraser</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2445079">Segment o‘chirg‘ich</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43060_2439288_2445075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office Lens feature that uses voice guidance to help users with visual impairments center objects in the frame of their camera when taking pictures.</descrip></descripGrp><ntig><termGrp><term id="2439288">Frame Guide</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2445075">Kadrga solish vositasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43060_2505368_2445075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office Lens feature that uses voice guidance to help users with visual impairments center objects in the frame of their camera when taking pictures.</descrip></descripGrp><ntig><termGrp><term id="2505368">VoiceOver</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2445075">Kadrga solish vositasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43061_2439289_2445081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Graph tool that populates a graph from a set of input entities (documents, people, etc.) and the relationship