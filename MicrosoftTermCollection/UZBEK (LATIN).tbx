><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2815_1421_1181753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security solution that segregates one portion of a network from another portion, allowing only authorized network traffic to pass through according to traffic filtering rules.</descrip></descripGrp><ntig><termGrp><term id="1421">firewall</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1181753">brandmauer</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2815_362568_1181753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security solution that segregates one portion of a network from another portion, allowing only authorized network traffic to pass through according to traffic filtering rules.</descrip></descripGrp><ntig><termGrp><term id="362568">security-edge gateway</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1181753">brandmauer</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28152_1468775_2061517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tax on products at each stage of their production based on the value added during that stage.</descrip></descripGrp><ntig><termGrp><term id="1468775">VAT</term><termNote type="partOfSpeech">