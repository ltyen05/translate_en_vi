igned certificate.</descrip></descripGrp><ntig><termGrp><term id="105840">root authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1655605">ildiz CA</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3576_105841_1655605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The most trusted certification authority (CA), which is at the top of a certification hierarchy. The root CA has a self-signed certificate.</descrip></descripGrp><ntig><termGrp><term id="105841">root certification authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1655605">ildiz CA</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3576_1513452_1655605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The most trusted certification authority (CA), which is at the top of a certification hierarchy. The root CA has a self-signed certificate.</descrip></descripGrp><ntig><termGrp><term id="1513452">root CA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1655605">ildiz CA</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type