mEntry id="42326_2394553_2398648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">After a build update, to load an app with domain data (such as data from a database, from the network, or from a file system), during the download process. Before this step, the app cannot be used.</descrip></descripGrp><ntig><termGrp><term id="2394553">hydrate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2398648">qaytadan yuklash</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42327_2394727_2422459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for multi-factor authentication, device registration to Azure AD, and SSO/certificate-based authentication against Azure AD that generates a security code the user must enter to verify his/her identity or, for enterprise users, a QR code to scan.</descrip></descripGrp><ntig><termGrp><term id="2394727">Microsoft Authenticator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2422459">Authenticator</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42327_2422386_2422459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for multi-factor authentication, device registration to Azure AD, and SSO/certificate-based authentication against Azure AD that generates a securi