<descripGrp><descrip type="definition">A group of people who uses or shares a common language or dialect and contributes to language-related activities for Windows features.</descrip></descripGrp><ntig><termGrp><term id="2515527">Language Community</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2518485">Til hamjamiyati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44672_2515529_2518486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section in the Feedback Hub app where users can organize language-related activities for their Language community.</descrip></descripGrp><ntig><termGrp><term id="2515529">Language Community tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2518486">Til hamjamiyati paneli</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44674_2515571_2518487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of tools that provides data-driven insights that can reduce the cost of deploying, servicing, and supporting Windows 10. It uses telemetry data to provide rich, actionable information to help assess the operational efficiency and health of Windows 10 devices in a user's environment.</descrip></descripGrp><ntig><termGrp><term id="2515571">Windows Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2518487">Windows Analytics</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44676_2515692_2517867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that generates Office 365 reports using SharePoint on-premises diagnostic and usage logs so that administrators can manage their infrastructure more efficiently.</descrip></descripGrp><ntig><termGrp><term id="2515692">SharePoint Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2517867">SharePoint Insights</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="447_51731_469485"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that lists errors that were encountered during an operation.</descrip></descripGrp><ntig><termGrp><term id="51731">error log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469485">xatolar jurnali</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4470_54362_469502"><langSet xml:l