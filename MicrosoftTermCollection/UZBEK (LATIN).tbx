termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1183442">Printerdan chiqarish va suratga ishlov berish moslamalari</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8751_418607_1520970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prevent another user from initiating a conversation and from viewing your presence or other information, such as your personal information.</descrip></descripGrp><ntig><termGrp><term id="418607">block</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1520970">bloklamoq</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8777_24948_469251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list in which each item or block of text is preceded by a bullet.</descrip></descripGrp><ntig><termGrp><term id="24948">bulleted list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469251">ko‘rsatkichlar ro‘yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8780_100131_469810"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The temporary storage place on Windows where deleted files are transferred and remain until manually emptied and files are permanently deleted, which allows users to retrieve files until that point.</descrip></descripGrp><ntig><termGrp><term id="100131">Recycle Bin</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469810">Savat</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8790_232417_470349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of domain names and email addresses that you want to receive messages from. E-mail addresses in Contacts and in the Global Address Book are included in this list by default. People you sent messages to will be added to the list.</descrip></descripGrp><ntig><termGrp><term id="232417">Safe Senders List</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470349">ishonchli jo‘natuvchilar ro‘yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8792_359700_1798653"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field size or data type that can hold positive integer numbers ranging from 0 to 255.</descrip></descripGrp><ntig><termGrp><term id="359700">byte</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig><