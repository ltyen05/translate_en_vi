<termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2076141">ulanishni uzish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21658_779139_1836371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To call the last person called from a phone or device.</descrip></descripGrp><ntig><termGrp><term id="779139">redial</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1836371">qayta terish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21660_779144_1836428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To send text messages from a mobile phone or device.</descrip></descripGrp><ntig><termGrp><term id="779144">text</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1836428">matn</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21755_779690_1936151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression, a timeline, or sequential steps in a task, process, or workflow. Works well for illustrating both Level 1 and Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779690">Accent Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936151">Urg'ulash jarayoni</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21756_779691_1936152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of information or sequential steps in a task, process, or workflow. Emphasizes the interaction or relationships among the groups of information.</descrip></descripGrp><ntig><termGrp><term id="779691">Alternating Flow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936152">O'zgaruvchan oqim</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21757_779692_1936153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show either related or contrasting concepts with some connection, such as opposing forces. The first two lines of Level 1 text are used for text in the arrows. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779692">Arrow Ribbon</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936153">Mill tasma</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21758_779693_1182083"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to compare or show the relationship between two ideas. Each of the first two lines of Level 1 text corresponds to text at the top of one side of the center point. Emphasizes Level 2 text, which is limited to four shapes on each side of the center point. The balance tips towards the side with the most shapes containing Level 2 text. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779693">Balance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1182083">Balans</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21759_779694_1936154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Maximizes both horizontal and vertical display space for shapes.</descrip></descripGrp><ntig><termGrp><term id="779694">Basic Bending Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936154">Asosiy buklash jarayoni</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21760_779695_1936155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. Maximizes both horizontal and vertical display space for shapes.</descrip></descripGrp><ntig><termGrp><term id="779695">Basic Block List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936155">Asosiy bloklangan ro'yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21761_779696_1936156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression; a timeline; sequential steps in a task, process, or workflow; or to emphasize movement or direction. Level 1 text appears inside an arrow shape while Level 2 text appears below the arrow shapes.</descrip></descripGrp><ntig><termGrp><term id="779696">Basic Chevron Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936156">Asosiy shevron jarayoni</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21762_779697_1936157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Emphasizes the stages or steps rather than the connecting arrows or flow. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779697">Basic Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936157">Asosiy sikl</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21763_779698_1936158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationship of components to a whole in quadrants. The first four lines of Level 1 text appear in the quadrants. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779698">Basic Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936158">Asosiy matritsa</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21764_779699_1936159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show how individual parts form a whole. The first seven lines of Level 1 text correspond to the evenly distributed wedge or pie shapes. The top Level 1 text shape appears outside of the rest of the pie for emphasis. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779699">Basic Pie</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936159">Asosiy aylanma</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21765_779700_1936160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow.</descrip></descripGrp><ntig><termGrp><term id="779700">Basic Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936160">Asosiy jarayon</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21766_779701_1936161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show proportional, interconnected, or hierarchical relationships with the largest component on the bottom and narrowing up. Level 1 text appears in the pyramid segments and Level 2 text appears in shapes alongside each segment.</descrip></descripGrp><ntig><termGrp><term id="779701">Basic Pyramid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936161">Asosiy piramida</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21767_779702_1936162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationship to a central idea in a cycle. The first line of Level 1 text corresponds to the central shape, and its Level 2 text corresponds to the surrounding circular shapes. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779702">Basic Radial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936162">Asosiy radial</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21768_779703_1936163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show containment, gradations, or hierarchical relationships. The first five lines of Level 1 text are associated with a circle. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779703">Basic Target</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936163">Asosiy nishon</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21769_779704_1936164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show sequential steps in a task, process, or workflow, or to show timeline information. Works well with both Level 1 and Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779704">Basic Timeline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936164">Asosiy vaqt shkalasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21770_779705_1936165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show overlapping or interconnected relationships. The first seven lines of Level 1 text correspond with a circle. If there are four or fewer lines of Level 1 text, the text is inside the circles. If there are more than four lines of Level 1 text, the text is outside of the circles. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779705">Basic Venn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936165">Asosiy Venn</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21772_779707_1936166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Emphasizes the stages or steps rather than the connecting arrows or flow.</descrip></descripGrp><ntig><termGrp><term id="779707">Block Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936166">Blok sikli</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21773_779708_1936167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression through several processes that make up an overall workflow. Also works for illustrating contrasting processes. The Level 1 text corresponds to the first arrow shape on the left, while the Level 2 text corresponds to horizontal sub-steps for each shape that contains Level 1 text.</descrip></descripGrp><ntig><termGrp><term id="779708">Chevron List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936167">Shevron ro'yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21774_779709_1936168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a long or non-linear sequence or steps in a task, process, or workflow. Works best with Level 1 text only. Maximizes both horizontal and vertical display space for shapes.</descrip></descripGrp><ntig><termGrp><term id="779709">Circular Bending Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936168">Doira sinish jarayoni</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21775_779710_1936169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression, a timeline, or sequential steps in a task, process, or workflow, or to emphasize movement or direction. Can be used to emphasize information in the starting shape. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779710">Closed Chevron Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936169">Yopiq shevron jarayoni</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21776_779711_1936170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a timeline or sequential steps in a task, process, or workflow. Works best with Level 1 text because each line of Level 1 text appears inside the arrow shape. Level 2 text appears outside the arrow shape.</descrip></descripGrp><ntig><termGrp><term id="779711">Continuous Arrow Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936170">Davomiy mil jarayoni</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21777_779712_1936171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Works best with minimal Level 1 and Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779712">Continuous Block Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936171">Davomiy bloklash jarayoni</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21778_779713_1936172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Emphasizes the connection between all components. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779713">Continuous Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936172">Davomiy sikl</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21779_779714_1936173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of interconnected information. The circular shapes are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779714">Continuous Picture List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936173">Davomiy rasm ro'yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21780_779715_1936174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show ideas or concepts that converge to a central point. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779715">Converging Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936174">Kesishgan millar</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21781_779716_1936175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show relationships of concepts or components to a central idea in a cycle. The first line of Level 1 text corresponds to the central circular shape and the lines of Level 2 text correspond to the surrounding rectangular shapes. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779716">Converging Radial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936175">Kesishgan radial</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21782_779717_1936176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show two opposing ideas or concepts. Each of the first two lines of Level 1 text corresponds to an arrow and works well with Level 2 text. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779717">Counterbalance Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936176">Tenglashtiradigan millar</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21783_779718_1936177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationship to a central idea in a cyclical progression. Each of the first four lines of Level 1 text corresponds to a wedge or pie shape, and Level 2 text appears in a rectangular shape to the side of the wedge or pie shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779718">Cycle Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936177">Sikl matritsasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21784_779719_1936178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used with large amounts of Level 2 text to show a progression through stages.</descrip></descripGrp><ntig><termGrp><term id="779719">Detailed Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936178">Batafsil jarayon</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21785_779720_1936179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show ideas or concepts that progress outward from a central source. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779720">Diverging Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936179">Ayrilish millar</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21786_779721_1936180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show relationships to a central idea in a cycle. The first Level 1 line of text corresponds to the central circular shape. Emphasizes the surrounding circles rather than the central idea. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779721">Diverging Radial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936180">Ayrilish radial</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21787_779722_1182084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show sequential steps or tasks that depict a plan or result. The last Level 1 line of text appears after the equals sign (=).Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779722">Equation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1182084">Tenglama</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21788_779723_1936181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the filtering of information or how parts merge into a whole. Emphasizes the final outcome. Can contain up to four lines of Level 1 text; the last of these four Level 1 text lines appears below the funnel and the other lines correspond to a circular shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779723">Funnel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936181">Quyun</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21789_779724_1936182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show interlocking ideas. Each of the first three lines of Level 1 text corresponds to a gear shape, and their corresponding Level 2 text appears in rectangles next to the gear shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779724">Gear</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936182">Tishli g'ildirak</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21790_779725_1936183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the placement of concepts along two axes. Emphasizes the individual components rather than the whole. The first four lines of Level 1 text appear in the quadrants. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779725">Grid Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936183">To'rsimon matritsa</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21791_779726_1936184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups and sub-groups of information, or steps and sub-steps in a task, process, or workflow. Level 1 text corresponds to the top-level horizontal shapes, and Level 2 text corresponds to vertical sub-steps under each related top-level shape. Works well for emphasizing sub-groups or sub-steps, hierarchical information, or multiple lists of information.</descrip></descripGrp><ntig><termGrp><term id="779726">Grouped List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936184">Guruhlangan ro'yxat</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21792_779727_1936185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing from top to bottom.</descrip></descripGrp><ntig><termGrp><term id="779727">Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936185">Iyerarxiya</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21793_779728_1936186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing across groups. Can also be used to group or list information.</descrip></descripGrp><ntig><termGrp><term id="779728">Hierarchy List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936186">Iyerarxiya ro'yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21794_779729_1936187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped lists of information. Works well with large amounts of text. All text has the same level of emphasis, and direction is not implied.</descrip></descripGrp><ntig><termGrp><term id="779729">Horizontal Bullet List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936187">Gorizontal raqamlangan ro'yxat</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21795_779730_1936188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing horizontally. Works well for decision trees.</descrip></descripGrp><ntig><termGrp><term id="779730">Horizontal Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936188">Gorizontal iyerarxiya</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21796_779731_1936189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped information with an emphasis on related pictures. The top shapes are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779731">Horizontal Picture List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936189">Gorizontal rasm ro'yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21797_779732_1936190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing horizontally and grouped hierarchically. Emphasizes heading or level 1 text. The first line of Level 1 text appears in the shape at the beginning of the hierarchy, and the second and all subsequent lines of Level 1 text appear at the top of the tall rectangles.</descrip></descripGrp><ntig><termGrp><term id="779732">Horizontal Labeled Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936190">Gorizontal belgilangan iyerarxiya</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21798_779733_1936191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show proportional, or interconnected, or hierarchical relationships with the largest component on the top and narrowing down. Level 1 text appears in the pyramid segments and Level 2 text appears in shapes alongside each segment.</descrip></descripGrp><ntig><termGrp><term id="779733">Inverted Pyramid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936191">To'ntarilgan piramida</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21799_779734_1936192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing from top to bottom and grouped hierarchically. Emphasizes heading or level 1 text. The first line of Level 1 text appears in the shape at the beginning of the hierarchy, and all subsequent lines of Level 1 text appear to the left of the tall rectangles.</descrip></descripGrp><ntig><termGrp><term id="779734">Labeled Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936192">Yorliqlangan iyerarxiya</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21800_779735_1936193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show overlapping relationships in a sequence. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779735">Linear Venn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936193">Chiziqli Venna</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21801_779736_1936194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events that can occur in any direction.</descrip></descripGrp><ntig><termGrp><term id="779736">Multidirectional Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936194">Ko'p taraflama sikl</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21802_779737_1936195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show containment relationships. Each of the first three lines of Level 1 text correspond to the upper left text in the shapes, and Level 2 text corresponds to the smaller shapes. Works best with minimal Level 2 lines of text. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779737">Nested Target</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936195">Joylashtirilgan nishon</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21803_779738_1936196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Each shape has the same level of importance. Works well when direction does not need to be indicated.</descrip></descripGrp><ntig><termGrp><term id="779738">Nondirectional Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936196">Qaratilmagan sikl</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21804_779739_1936197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show two opposing ideas, or ideas that diverge from a central point. Each of the first two lines of Level 1 text corresponds to an arrow. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779739">Opposing Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936197">Qarama-qarshi millar</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21805_779740_1936198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical information or reporting relationships in an organization. The assistant shape and the Org Chart hanging layouts are available with this layout.</descrip></descripGrp><ntig><termGrp><term id="779740">Organization Chart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936198">Tashkilot diagrammasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21807_779742_1936199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show sequential steps in a task, process, or workflow. The rectangular shapes in the background are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779742">Picture Accent Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936199">Surilgan rasmli jarayon</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21808_779743_1936200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. The top shapes are designed to contain pictures and pictures are emphasized over text. Works well for pictures with short text captions.</descrip></descripGrp><ntig><termGrp><term id="779743">Picture Caption List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936200">Rasm nomlari ro‘yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21809_779744_1936201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show information illustrating a process or workflow. Level 1 text appears in the circular shapes and Level 2 text appears in the arrow shapes. Works best for minimal text and to emphasize movement or direction.</descrip></descripGrp><ntig><termGrp><term id="779744">Process Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936201">Jarayon millari</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21810_779745_1936202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show multiple groups of information or steps and sub-steps in a task, process, or workflow. Level 1 text corresponds to the top horizontal shapes, and Level 2 text corresponds to vertical sub-steps under each related top-level shape.</descrip></descripGrp><ntig><termGrp><term id="779745">Process List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936202">Jarayon ro'yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21811_779746_1936203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show proportional, interconnected, or hierarchical relationships. Text appears in the rectangular shapes on top of the pyramid background</descrip></descripGrp><ntig><termGrp><term id="779746">Pyramid List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936203">Piramidasimon ro'yxat</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21812_779747_1936204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationship to a central idea. Emphasizes both information in the center circle and how information in the outer ring of circles contributes to the central idea. The first Level 1 line of text corresponds to the central circle, and its Level 2 text corresponds to the outer ring of circles. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779747">Radial Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936204">Radial sikl</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21813_779748_1936205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show relationships to a central idea in a cycle. The center shape can contain a picture. Level 1 text appears in the smaller circles and any related Level 2 text appears to the side of the smaller circles.</descrip></descripGrp><ntig><termGrp><term id="779748">Radial List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936205">Radial ro'yxat</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21814_779749_1936206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show both overlapping relationships and the relationship to a central idea in a cycle. The first line of Level 1 text corresponds to the central shape and the lines of Level 2 text correspond to the surrounding circular shapes. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779749">Radial Venn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936206">Radial Venn</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21815_779750_1936207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Maximizes both horizontal and vertical display space for shapes. Does not emphasize directionality.</descrip></descripGrp><ntig><termGrp><term id="779750">Repeating Bending Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936207">Qaytariluvchi bukilgan jarayon</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21816_779751_1936208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or a sequence of stages, tasks, or events in a circular flow. Emphasizes the interconnected pieces. Each of the first seven lines of Level 1 text corresponds to a wedge or pie shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779751">Segmented Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936208">Segmentlangan sikl</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21817_779752_1936209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Emphasizes Level 2 text, since each line appears in a separate shape.</descrip></descripGrp><ntig><termGrp><term id="779752">Segmented Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936209">Segmentlangan jarayon</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21818_779753_1936210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show containment, proportional, or interconnected relationships. The first nine lines of Level 1 text appear in the triangular shapes. Unused text does not appear, but remains available if you switch layouts. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779753">Segmented Pyramid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936210">Segmentlangan piramida</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21819_779754_1936211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of information or steps in a task, process, or workflow. Circular shapes contain Level 1 text, and the corresponding rectangles contain Level 2 text. Works well for numerous details and minimal Level 1 text.</descrip></descripGrp><ntig><termGrp><term id="779754">Stacked List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936211">Ustuncha ro'yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21820_779755_1936212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a downward progression through stages. Each of the first five lines of Level 1 text corresponds with a rectangle. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779755">Staggered Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936212">Pog‘onali jarayon</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21821_779756_1936213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of information built from top to bottom, and the hierarchies within each group. This layout does not contain connecting lines.</descrip></descripGrp><ntig><termGrp><term id="779756">Table Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936213">Jadval iyerarxiyasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21822_779757_1182085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show grouped or related information of equal value. The first Level 1 line of text corresponds to the top shape and its Level 2 text is used for the subsequent lists.</descrip></descripGrp><ntig><termGrp><term id="779757">Table List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1182085">Jadval ro‘yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21823_779758_1936214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show interrelated or overlapping information. Each of the first seven lines of Level 1 text appears in the rectangular shape. Unused text does not appear, but remains available if you switch layouts. Works well with both Level 1 and Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779758">Target List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936214">Nishon ro'yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21824_779759_1936215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Emphasizes the arrows or flow rather than the stages or steps. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779759">Text Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936215">Matn sikli</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21825_779760_1936216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationships of four quadrants to a whole. The first line of Level 1 text corresponds to the central shape, and the first four lines of Level 2 text appear in the quadrants. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779760">Titled Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936216">Nomlangan matritsa</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21826_779761_1936217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show grouped or related information of equal value. Works well with large amounts of text.</descrip></descripGrp><ntig><termGrp><term id="779761">Trapezoid List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936217">Trapetsiyasimon ro'yxat</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21827_779762_1936218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or steps that trend upward in a task, process, or workflow. Each of the first five lines of Level 1 text corresponds to a point on the arrow. Works best with minimal text. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779762">Upward Arrow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936218">Tepaga qaragan mil</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21828_779763_1936219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow that move toward a common goal. Works well for bulleted lists of information.</descrip></descripGrp><ntig><termGrp><term id="779763">Vertical Arrow List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936219">Vertikal mil ro'yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21829_779764_1936220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Maximizes both horizontal and vertical display space for shapes. Places more emphasis on the interrelationships among the shapes than on direction or movement.</descrip></descripGrp><ntig><termGrp><term id="779764">Vertical Bending Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936220">Vertikal bukish jarayoni</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21830_779765_1936221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of information or steps in a task, process, or workflow. Works well with large amounts of Level 2 text. A good choice for text with a main point and multiple sub-points.</descrip></descripGrp><ntig><termGrp><term id="779765">Vertical Block List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936221">Vertikal bloklash ro'yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21831_779766_1936222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show several groups of information, especially groups with large amounts of Level 2 text. A good choice for bulleted lists of information.</descrip></descripGrp><ntig><termGrp><term id="779766">Vertical Box List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936222">Vertikal quti ro'yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21832_779767_1936223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. Works well for lists with long headings or top-level information.</descrip></descripGrp><ntig><termGrp><term id="779767">Vertical Bullet List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936223">Vertikal raqamlangan ro'yxat</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21833_779768_1936224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow, or to emphasize movement or direction. Emphasizes Level 2 text over Level 1 text, and is a good choice for large amounts of Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779768">Vertical Chevron List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936224">Vertikal Shevron ro'yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21834_779769_1936225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show sequential steps or tasks that depict a plan or result. The last Level 1 line of text appears after the arrow. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779769">Vertical Equation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936225">Vertikal tenglama</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21835_779770_1936226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. The small circles are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779770">Vertical Picture Accent List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936226">Vertikal surat urg'u ro'yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21836_779771_1936227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. The small shapes on the left are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779771">Vertical Picture List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936227">Vertikal surat ro'yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21837_779772_1936228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow from top to bottom. Works best with Level 1 text, since the vertical space is limited.</descrip></descripGrp><ntig><termGrp><term id="779772">Vertical Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936228">Vertikal jarayon</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21838_779838_1936229"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show overlapping relationships. A good choice for emphasizing growth or gradation. Works best with Level 1 text only. The first seven lines of Level 1 text correspond to a circular shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779838">Stacked Venn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936229">Ustunli Venna</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21839_779839_2629783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having the ability to make decisions based on predictions driven by machine learning analysis.</descrip></descripGrp><ntig><termGrp><term id="779839">intelligent</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2629783">intellektual</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21847_779972_2435928"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Marked by the use of serifs. For example, Goudy is a serif typeface, whereas Helvetica is a sans serif typeface.</descrip></descripGrp><ntig><termGrp><term id="779972">serif</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2435928">kertikli</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21873_780192_1936230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula giving the roots of a quadratic equation.</descrip></descripGrp><ntig><termGrp><term id="780192">quadratic formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936230">kvadrat tenglama</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21876_780202_1489907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Not able to be delivered to an intended recipient. If an email message is undeliverable, it is returned to the sender with information added by the mail server explaining the problem; for example, the email address may be incorrect, or the recipient's mailbox may be full.</descrip></descripGrp><ntig><termGrp><term id="780202">undeliverable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1489907">yetkazib bo'lmaydigan</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21880_780207_3030313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to information that a user has received but has not yet read.</descrip></descripGrp><ntig><termGrp><term id="780207">unread</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3030313">o‘qilmagan</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21894_780443_1836235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To turn off a system notification such as a reminder, a new message alert or an alarm.</descrip></descripGrp><ntig><termGrp><term id="780443">dismiss</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1836235">o'tkazib yuborish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21900_780462_1836315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A telephone call the user has failed to answer.</descrip></descripGrp><ntig><termGrp><term id="780462">missed call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1836315">O'tkazilgan qo'ng'iroq</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21905_780472_1836356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules defined by an administrator.</descrip></descripGrp><ntig><termGrp><term id="780472">policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1836356">siyosat</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21906_780474_1182086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A company that provides services or content for its customers.</descrip></descripGrp><ntig><termGrp><term id="780474">provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1182086">ta’minotchi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21906_780474_1883668"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A company that provides services or content for its customers.</descrip></descripGrp><ntig><termGrp><term id="780474">provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1883668">provayder</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21926_780637_1836205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is both a digital still camera and a digital video camera.</descrip></descripGrp><ntig><termGrp><term id="780637">camera</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1836205">kamera</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21930_780755_1836245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scheduled occurrence of an activity where multiple people are in attendance.</descrip></descripGrp><ntig><termGrp><term id="780755">event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1836245">hodisa</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21932_780759_1836292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The on-screen representation of the phone keypad or dial pad on the device.</descrip></descripGrp><ntig><termGrp><term id="780759">keypad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1836292">klaviatura</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21936_780772_1836370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A password (or key) provided by Exchange Server (through OWA) that will be used during the process of resetting the PIN/password of the mobile devices.</descrip></descripGrp><ntig><termGrp><term id="780772">recovery password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1836370">tiklash paroli</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21937_780778_1836380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mechanical part that makes the phone ring to indicate an incoming call.</descrip></descripGrp><ntig><termGrp><term id="780778">ringer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1836380">jiringlovchi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21938_780781_1836399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of personal identification number (PIN) for the SIM card, consisting of 4 digits, that is used to gain access to your mobile phone.</descrip></descripGrp><ntig><termGrp><term id="780781">SIM PIN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1836399">SIM PIN kodi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2194_126360_469937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characterized by capital letters.</descrip></descripGrp><ntig><termGrp><term id="126360">uppercase</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469937">yuqori registr</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21948_781514_1182087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of hardware that supports multiple discrete capabilities, such as audio, mixer, and music, on a single card. This device is sometimes treated as a bus that can be enumerated to locate the devices on that bus.</descrip></descripGrp><ntig><termGrp><term id="781514">multifunction device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1182087">ko‘p funktsiyali qurilma</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21948_781515_1182087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of hardware that supports multiple discrete capabilities, such as audio, mixer, and music, on a single card. This device is sometimes treated as a bus that can be enumerated to locate the devices on that bus.</descrip></descripGrp><ntig><termGrp><term id="781515">MFD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1182087">ko‘p funktsiyali qurilma</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><te