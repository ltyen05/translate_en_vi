nition">A named collection of contacts in the Contacts list.</descrip></descripGrp><ntig><termGrp><term id="2362007">group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2368008">guruh</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40749_2362008_2368009"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove yourself from a conference call that will continue without you.</descrip></descripGrp><ntig><termGrp><term id="2362008">leave call</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2368009">tark etish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40751_2362010_2368011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To rejoin a window back into an original window which it had been popped out from previously.</descrip></descripGrp><ntig><termGrp><term id="2362010">pop in</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2368011">biriktirish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40751_2362010_2746272"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To rejoin a window back into an original window which it had been popped out from previously.</descrip></descripGrp><ntig><termGrp><term id="2362010">pop in</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2746272">joyiga qaytarish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40752_2362011_2368012"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To separate an area of a UI into a new window.</descrip></descripGrp><ntig><termGrp><term id="2362011">pop out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2368012">ajratib olish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40752_2362011_2746273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To separate an area of a UI into a new window.</descrip></descripGrp><ntig><termGrp><term id="2362011">pop out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2746273">chiqarib olish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termN