gSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows servicing option in which new feature upgrades are available for installation around 4 months after they were first published by Microsoft and the minimum length of servicing lifetime is approximately 8 months.</descrip></descripGrp><ntig><termGrp><term id="2541062">Semi-Annual Channel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2546261">Semi-Annual Channel</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40477_2733044_3011362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The servicing option in which new feature upgrades are available for installation after first published by Microsoft, enabling long-term deployment of selected releases in low-change configurations. The minimum length of servicing lifetime is approximately 10 years.</descrip></descripGrp><ntig><termGrp><term id="2733044">Long Term Servicing Channel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3011362">LTSC</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40477_2733044_3013349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The servicing option in which new feature upgrades are available for installation after first published by Microsoft, enabling long-term deployment of selected releases in low-change configurations. The minimum length of servicing lifetime is approximately 10 years.</descrip></descripGrp><ntig><termGrp><term id="2733044">Long Term Servicing Channel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3013349">Uzoq muddatli xizmat ko‘rsatish kanali</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40477_2733045_3011362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The servicing option in which new feature upgrades are available for installation after first published by Microsoft, enabling long-term deployment of selected releases in low-change configurations. The minimum length of servicing lifetime is approximately 10 years.</descrip></descripGrp><ntig><termGrp><term id="2733045">LTSC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3011362">LTSC</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40477_2733045_3013349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The servicing option in which new feature upgrades are available for installation after first published by Microsoft, enabling long-term deployment of selected releases in low-change configurations. The minimum length of servicing lifetime is approximately 10 years.</descrip></descripGrp><ntig><termGrp><term id="2733045">LTSC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3013349">Uzoq muddatli xizmat ko‘rsatish kanali</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40497_2352186_2353618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature set that integrates data protection at the platform level so as to protect corporate data against inadvertent disclosure to unauthorized users and public services through email, social media and public cloud. It includes encryption of enterprise data when it enters the device or is created on the device, such that data stays protected against disclosure to applications and endpoints outside enterprise control.</descrip></descripGrp><ntig><termGrp><term id="2352186">Enterprise data protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2353618">EDP</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40497_2352186_2353620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature set that integrates data protection at the platform level so as to protect corporate data against inadvertent disclosure to unauthorized users and public services through email, social media and public cloud. It includes encryption of enterprise data when it enters the device or is created on the device, such that data stays protected against disclosure to applications and endpoints outside enterprise control.</descrip></descripGrp><ntig><termGrp><term id="2352186">Enterprise data protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2353620">Tashkilot ma’lumotlari himoyasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40497_2352186_2413073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature set that integrates data protection at the platform level so as to protect corporate data against inadvertent disclosure to unauthorized users and public services through email, social media and public cloud. It includes encryption of enterprise data when it enters the device or is created on the device, such that data stays protected against disclosure to applications and endpoints outside enterprise control.</descrip></descripGrp><ntig><termGrp><term id="2352186">Enterprise data protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2413073">Windows ma’lumotlar himoyasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40497_2352187_2353618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature set that integrates data protection at the platform level so as to protect corporate data against inadvertent disclo