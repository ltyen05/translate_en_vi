Note><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="866_312761_470755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A System Audio Effects (SYSFX) component used to provide a more immersive audio experience in the Windows Media Player and thus an improved listening experience by utilizing the available speakers that a user has attached to his/her PC by sending audio to all of the speakers, regardless of the number of channels the content contains. This will provide a better sounding experience for stereo and quadraphonic content being rendered on multi-channel playback systems.</descrip></descripGrp><ntig><termGrp><term id="312761">speaker fill</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470755">tovushni to‘ldirish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8664_55395_469510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The stylistic attributes of a font — such as bold, italic, and underline.</descrip></descripGrp><ntig><termGrp><term id="55395">font style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469510">shrift turi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8688_228749_2800386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of users, accounts, Web sites, etc. that are permitted to perform certain actions on a network.</descrip></descripGrp><ntig><termGrp><term id="228749">Allow list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2800386">Ruxsat etilganlar</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8688_228749_470324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of users, accounts, Web sites, etc. that are permitted to perform certain actions on a network.</descrip></descripGrp><ntig><termGrp><term id="228749">Allow list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470324">ijozatlar ro‘yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8688_276556_2800386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of users, accounts, Web sites, etc. that are permitted to perform certain actions on a network.</descrip></descripGrp><ntig><termGrp><term id="276556">allow list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2800386">Ruxsat etilganlar</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8688_276556_470324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of users, accounts, Web sites, etc. that are permitted to perform certain actions on a network.</descrip></descripGrp><ntig><termGrp><term id="276556">allow list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470324">ijozatlar ro‘yxati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="869_557910_1936049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optional Microsoft Exchange 2000 Server component that is installed on a designated server in an administrative group. It provides centralized administration and archival of private keys, and maintains every user s private encryption key in an encrypted database. The keys are used for encrypting email messages and signing messages with digital signatures.</descrip></descripGrp><ntig><termGrp><term id="557910">Key Management Service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936049">Key Management xizmati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8696_183901_1935932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slide template that defines default formatting or the position of placeholders for one or more slides in a presentation.</descrip></descripGrp><ntig><termGrp><term id="183901">content master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1935932">tarkib ustasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8706_186134_470247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of rules on a computer and a portable device that allow digital media files and other information to be synchronized.</descrip></descripGrp><ntig><termGrp><term id="186134">partnership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470247">hamkorlik</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8712_64603_2690640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file containing graphics (illustrations, photographs, etc.) or other visual information.</descrip></descripGrp><ntig><termGrp><term id="64603">image file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2690640">tasvir fayli</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><te