nt.</descrip></descripGrp><ntig><termGrp><term id="2067024">workplace</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083383">ish joyi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35720_2067025_2083384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account provided by a company that allows users to install apps or hubs provided by that company, and that governs the company policies applied to the phone.</descrip></descripGrp><ntig><termGrp><term id="2067025">workplace account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083384">ish joyi qayd hisobi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35721_2067026_2083364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Local public transportation; the vehicles used for such transport.</descrip></descripGrp><ntig><termGrp><term id="2067026">transit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083364">jamoat transporti</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelect