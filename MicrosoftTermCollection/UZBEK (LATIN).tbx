0140_702751_2101332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of shapes arranged in a tree structure that helps analyze and summarize data in a visual, easy-to-understand format. It starts out as a single shape, called a top node, that contains information imported from a worksheet, table, view, or cube.</descrip></descripGrp><ntig><termGrp><term id="702751">PivotDiagram</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2101332">Jamlama chizmasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20141_703430_2182713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy that specifies the length of time during which items such as data, documents, builds, and releases are to be retained.</descrip></descripGrp><ntig><termGrp><term id="703430">retention policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2182713">saqlash siyosati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20149_704965_1936140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of data such as numbers, number and text combinations, dates, or time periods, based on an established pattern and used to automatically fill data into worksheet cells.</descrip></descripGrp><ntig><termGrp><term id="704965">fill se