="44832_2524734_2529176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft interactive livestreaming platform for gaming communities.</descrip></descripGrp><ntig><termGrp><term id="2524734">Mixer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2529176">Mixer</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44833_2524736_2529179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that brings together friends, games, and accomplishments across Xbox One and Windows 10 devices. It allows users to stay connected to the Xbox Live community, see what their friends are playing, share game clips and screenshots, and view achievements across devices.</descrip></descripGrp><ntig><termGrp><term id="2524736">Xbox app</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2529179">Xbox ilovasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4484_252109_2623631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authorized simulated attack on a computer system that evaluates the security of a system by identifying weaknesses and strengths.</descrip></descripGrp><ntig><termGrp><term id="252109">penetration test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2623631">tizim xavfsizligi tekshiruvi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4484_252109_2751930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authorized simulated attack on a computer system that evaluates the security of a system by identifying weaknesses and strengths.</descrip></descripGrp><ntig><termGrp><term id="252109">penetration test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2751930">qamrov testi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4484_2621910_2623631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authorized simulated attack on a computer system that evaluates the security of a system by identifying weaknesses and strengths.</descrip></descripGrp><ntig><termGrp><term id="2621910">pen test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2623631">tizim xavfsizligi tekshiruvi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4484_2621910_2751930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authorized simulated attack on a computer system that evaluates the security of a system by identifying weaknesses and strengths.</descrip></descripGrp><ntig><termGrp><term id="2621910">pen test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2751930">qamrov testi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44842_2524849_2593754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presentation of visual elements in an image, especially the placement of the subject in relation to other objects.</descrip></descripGrp><ntig><termGrp><term id="2524849">frame</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2593754">ramka</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44843_2524926_2529171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays mixed reality experiences. Used inclusively to denote both Microsoft HoloLens and OEM devices, whether they blend virtual content within the physical world (holographic headsets), or display virtual content with a degree (big or small) of environmental awareness (immersive headsets)​. Plus, these headsets can either be self-contained (like Microsoft HoloLens - the whole computing power is contained into the headset) or PC-connected (the computing power comes from the PC and the headset cannot work without that associated PC).</descrip></descripGrp><ntig><termGrp><term id="2524926">mixed reality headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2529171">aralash reallik quloqligi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44843_2526431_2529171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays mixed reality experiences. Used inclusively to denote both Microsoft HoloLens and OEM devices, whether they blend virtual content within the physical world (holographic headsets), or display virtual content with a degree (big or small) of environmental awareness (immersive headsets)​. Plus, these headsets can either be self-contained (like Microsoft HoloLens - the whole computing power is contained into the headset) or PC-connected (the computing power comes from the PC and the headset cannot work without that associated PC).</descrip></descripGrp><ntig><termGrp><term id="2526431">headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2529171">aralash reallik quloqligi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44844_2524930_2529168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays virtual content only and with a degree (big or small) of environmental awareness. This is a subset of "mixed reality headset."​ This is to be looked at in contrast with "holographic headsets".</descrip></descripGrp><ntig><termGrp><term id="2524930">immersive headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2529168">immersiv quloqlik</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44845_2524937_2529172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of moving from a lower version of a system to a higher version. A configuration shift where the user becomes able to change default settings which were locked before the shift.</descrip></descripGrp><ntig><termGrp><term id="2524937">switch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2529172">almashtirish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44846_2524939_2529173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move from a lower version of a system to a higher one, or to shift system configuration in order to change default settings locked before the shift.</descrip></descripGrp><ntig><termGrp><term id="2524939">switch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2529173">almashtirish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44861_2528507_2593755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To arrange visual elements in an image, especially the subject.</descrip></descripGrp><ntig><termGrp><term id="2528507">frame</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2593755">ramkaga solish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44863_2529677_2530308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft marketing campaign that emphasizes seamless use of Microsoft applications across all devices because users have just one account no matter what device they are using.</descrip></descripGrp><ntig><termGrp><term id="2529677">One Microsoft</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2530308">One Microsoft</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44869_2530865_2540025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A state of an application when no docume