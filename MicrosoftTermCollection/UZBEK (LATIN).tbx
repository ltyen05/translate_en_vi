76312">Windows Mixed Reality harakat nazoratchisi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44823_2531456_2576310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware accessory that allows you to take action in mixed reality. It tracks a precise position in space, allowing for fine-grained interaction with digital objects. When using a Windows Mixed Reality immersive headset, the motion controller is the primary way to take action.</descrip></descripGrp><ntig><termGrp><term id="2531456">Windows Mixed Reality motion controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2576310">harakat nazoratchisi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44823_2531456_2576312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware accessory that allows you to take action in mixed reality. It tracks a precise position in space, allowing for fine-grained interaction with digital objects. When using a Windows Mixed Reality immersive headset, the motion controller is the primary way to take action.</descrip></descripGrp><ntig><termGrp><term id="2531456">Windows Mixed Reality motion controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2576312">Windows Mixed Reality harakat nazoratchisi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44824_2524653_2529174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows 10 update announced at Build 2017 and being released in the Sept-Nov 2017 timeframe.</descrip></descripGrp><ntig><termGrp><term id="2524653">Windows 10 Fall Creators Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2529174">Windows 10 Fall Creators Update</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44825_2524668_2529167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Windows Defender Security Center that monitors your device and provides you with information and recommendations in a Health report to address common issues with your storage capacity, device drivers, battery life, or Windows Update.</descrip></descripGrp><ntig><termGrp><term id="2524668">Health Advisor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2529167">Salomatlik maslahatchisi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44826_2524671_2529166"><langSet xml:lang="en-US"><descripGrp><descrip type="defi