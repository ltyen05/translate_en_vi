">UZB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35724_2067030_2083308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera option that enables users to capture moving subjects by snapping multiple photos on shutter press and allowing the user to pick the best one or just accept the photo recommended by the software.</descrip></descripGrp><ntig><termGrp><term id="2067030">burst mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083308">qatorasiga rejimi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35725_2067031_2083371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone's LED light used during video capture to help exposure in dark conditions.</descrip></descripGrp><ntig><termGrp><term id="2067031">video light</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083371">yoritqich</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35726_2067032_2083354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows you to sync some of the settings on your phone across all of your Windows 8 devices.</descrip></