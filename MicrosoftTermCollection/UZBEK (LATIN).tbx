te></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083348">SmartScreen Filtri</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20867_2676671_2678838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows the user to fill cells with data that follows a pattern or that is based on data in other cells.</descrip></descripGrp><ntig><termGrp><term id="2676671">AutoFill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2678838">Avtomatik kiritish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20867_752822_2678838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows the user to fill cells with data that follows a pattern or that is based on data in other cells.</descrip></descripGrp><ntig><termGrp><term id="752822">Auto Fill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2678838">Avtomatik kiritish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2087_22056_1798652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page where there is no information displayed</descrip></descripGrp><ntig><termGrp><term id="22056">blank page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1798652">bo'sh sahifa</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20874_757176_1936146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool used to turn on language-specific options for the languages one wants to use with a product.</descrip></descripGrp><ntig><termGrp><term id="757176">Language Settings tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936146">Til sozlamalari asbobi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20884_759071_1182003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any hardware or software that can detect events or environmental changes, such as your current location or the amount of light around your computer. For example, a notebook with a location sensor, such as a Global Positioning System (GPS) receiver, can determine your exact location. An ambient light sensor can detect when there is a change in lighting, and then a program can use that information to adjust the brightness of your screen.</descrip></descripGrp><ntig><termGrp><term id="759071">sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1182003">sensor</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20888_759108_1182004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that includes an antenna, a radio receiver, and a processor for use with the worldwide GPS (Global Positioning System). A GPS receiver uses position and time information from four GPS satellites to calculate precise information about its current location, its speed of travel, and the current time.</descrip></descripGrp><ntig><termGrp><term id="759108">GPS receiver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1182004">GPS priyomnigi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20889_759109_1182005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that can detect the current location of your computer.</descrip></descripGrp><ntig><termGrp><term id="759109">location sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1182005">joylashish sensori</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20894_759503_1182006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Technologies that measure and analyze physical and behavioral human characteristics, such as fingerprints, eye retinas and irises, voice patterns, facial patterns, hand measurements, typing patterns and signatures, to recognize or authenticate identity.</descrip></descripGrp><ntig><termGrp><term id="759503">biometrics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1182006">biometriya</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20907_759640_1182007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area within the Windows Control Panel that provides support for sensors such as enabling, disabling or uninstalling sensors and sensor-enabled applications, changing sensor settings, etc.</descrip></descripGrp><ntig><termGrp><term id="759640">Location and Other Sensors</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1182007">Joylashish va boshqa sensorlar</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20908_759641_1182008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A light sensor that tracks light in the surroundings and therefore the amount of backlight needed for the LCD screen to be adjusted accordingly.</descrip></descripGrp><ntig><termGrp><term id="759641">ambient light sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1182008">ekran yorug‘ligi sensori</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2091_50057_469473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of information within a markup language that is defined by a tag, or a pair of tags surrounding some content, and includes any attributes defined within the initial tag.</descrip></descripGrp><ntig><termGrp><term id="50057">element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469473">element</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20910_759643_1182009"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A package of market-specific content delivered in Windows for 20 target markets. A Local Pack contains market-customized themes (wallpapers, sound schemes, etc.) and locally flavored Internet Explorer favorites and RSS feeds.</descrip></descripGrp><ntig><termGrp><term id="759643">Local Pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1182009">Mahalliy pak