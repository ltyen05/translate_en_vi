partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936577">Birlashtirilgan jurnal yuritish xizmati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32908_1722438_1936571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instrumentation and logging platform that provides monitoring, reporting and log viewing capabilities for Office servers and services.</descrip></descripGrp><ntig><termGrp><term id="1722438">Unified Logging Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936571">ULS platformasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32908_1722438_1936577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instrumentation and logging platform that provides monitoring, reporting and log viewing capabilities for Office servers and services.</descrip></descripGrp><ntig><termGrp><term id="1722438">Unified Logging Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936577">Birlashtirilgan jurnal yuritish xizmati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32909_1718122_1936572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application-hosting architecture that relies on cloud-based services. Application logic and data are typically hosted on a distributed set of services on the Internet, connected through web APIs, and authenticated with server-to-server authentication technologies such as OAuth.</descrip></descripGrp><ntig><termGrp><term id="1718122">Cloud App Model</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936572">Bulutli ilova modeli</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32925_1718267_1936574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item that lets the user open a document using a different application than the one associated with the document type.</descrip></descripGrp><ntig><termGrp><term id="1718267">Open with</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936574">Quyidagi bilan ochish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3293_83637_469701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On a Web page, a grouping of hyperlinks for getting around in that particular Web site.</d