ng="en-US"><descripGrp><descrip type="definition">The restarting of a running computer without first turning off the power.</descrip></descripGrp><ntig><termGrp><term id="331658">soft restart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470943">iliq qayta ishga solish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15111_331658_470944"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The restarting of a running computer without first turning off the power.</descrip></descripGrp><ntig><termGrp><term id="331658">soft restart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470944">iliq qayta yuklash</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15125_415472_1181908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special visual or sound effect added to text or an object. For instance, a user can have the text bullet points fly in from the left, one word at a time, or hear the sounds of applause when a picture is uncovered.</descrip></descripGrp><ntig><termGrp><term id="415472">animation effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1181908">animatsiya effekti</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15136_493916_2579057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of penetrating system security by tricking individuals into divulging passwords and information about network vulnerabilities. Often done by calling the individual on phone and pretending to be another employee of company with a computer-related question.</descrip></descripGrp><ntig><termGrp><term id="493916">social engineering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2579057">ijtimoiy muhandislik</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15140_320449_470889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The € character.</descrip></descripGrp><ntig><termGrp><term id="320449">euro symbol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470889">yevro ramzi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15140_320450_470889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The € character.</descrip></descripGrp><ntig><termGrp><term id="320450">EURO SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470889">yevro ramzi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15144_346594_470987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time for which a dry or alkaline cell is able to produce an electric current before it needs to be replaced.</descrip></descripGrp><ntig><termGrp><term id="346594">battery life</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470987">batareyaning ishlash muddati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15151_68314_469586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Characterized by conversational exchange of input and output, as when a user enters a question or command and the system immediately responds. The interactivity of microcomputers is one of the features that makes them approachable and easy to use.</descrip></descripGrp><ntig><termGrp><term id="68314">interactive</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469586">o‘zaro faol</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15153_304427_1181909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An exponentiation operator used in some programming languages. For example, the expression 3^2 represents the number 3 raised to the second power.</descrip></descripGrp><ntig><termGrp><term id="304427">caret</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1181909">qo‘shib qo‘yish belgisi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15154_2421378_1543917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work item that records a possible event with an undesirable outcome.</descrip></descripGrp><ntig><termGrp><term id="2421378">risk event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1543917">xavf</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15154_2421378_2731467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work item that records a possible event with an undesirable outcome.</descrip></descripGrp><ntig><termGrp><term id="2421378">risk event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2731467">risk hodisasi</term><termNote type="geographicalUsage">UZB</ter