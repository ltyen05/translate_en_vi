rammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3702_86682_469721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of translating images of printed text into machine-encoded text.</descrip></descripGrp><ntig><termGrp><term id="86682">optical character recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469721">OCR</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3702_86682_469722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of translating images of printed text into machine-encoded text.</descrip></descripGrp><ntig><termGrp><term id="86682">optical character recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469722">belgilarni optik o‘qish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37033_2816013_2834694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription, hosted in the Government Community Cloud environment, for government organizations that need communication and collaboration tools and the ability to read and do lightweight editing of documents with the Office Online. It includes all the features of Exchange Online Government Plan 1 plus cloud file storage and sharing, online meetings and instant messaging, HD videoconferencing, intranet and team sites, and other services.</descrip></descripGrp><ntig><termGrp><term id="2816013">Office 365 Government G1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2834694">Office 365 Government G1</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37034_2816014_2834695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription, hosted in the Government Community Cloud environment, that is the best plan for government organizations that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Online. It includes all the features of Office 365 Government Community G1 plus Office desktop applications, personalized search and discovery, self-service business intelligence, enterprise management of apps, eDiscovery tools, hosted voicemail with auto-attendant capabilities, and other services.</descrip></descripGrp><ntig><termGrp><term id="2816014">Office 365 Government G3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2834695">Office 365 Government G3</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37041_2113983_2182732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app used to provide product feedback that results from the Windows Insider Program.</descrip></descripGrp><ntig><termGrp><term id="2113983">Windows Feedback</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2182732">Windows fikr-mulohaza</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37042_2106691_3018765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-release build containing the latest features and updates that are not yet widely available.</descrip></descripGrp><ntig><termGrp><term id="2106691">preview build</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3018765">nashr dastlabki ko‘rinishi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37043_2113317_2571506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The external program that enables participants (called "Insiders") to provide feedback on Windows new features.</descrip></descripGrp><ntig><termGrp><term id="2113317">Insider Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2571506">Insider dasturi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNot