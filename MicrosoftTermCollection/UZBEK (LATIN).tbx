9580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advanced endpoint security solution optimized for small- and medium-sized businesses.</descrip></descripGrp><ntig><termGrp><term id="3178799">Defender for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3179580">Biznes uchun Defender</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53035_3014861_3016901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program for nonprofit organizations with the goal of enhancing their security protections and capacity that will include notification in the event of a nation-state attack or compromise and free security assessments to help them understand and action their security vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="3014861">Security Program for Nonprofits</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3016901">Notijorat tashkilotlar uchun xavfsizlik dasturi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53036_3014863_3016885"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collaborative web-app (MetaOS-based) which lets Office.com users convert Word/Excel/PowerPoint documents to PDF format.</descrip></descripGrp><ntig><termGrp><term id="3014863">PDF Tools</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3016885">PDF vositalari</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53037_3014864_3016873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A paid feature within the Microsoft 365 admin center that enables admins to do fast, at-scale point-in-time restore across OneDrive, SharePoint, and Exchange in Microsoft 365, beyond our default retention limits.</descrip></descripGrp><ntig><termGrp><term id="3014864">enhanced restore</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3016873">yaxshilangan tiklash</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53038_3014879_3091058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Teams that provides different experiences for attendees and presenters when joining an event/meeting. Attendees will see a waiting screen and will stay on that screen till presenters activate the event/meeting. Presenters will join the meeting in a separate space where they can prepare together before the event goes live for attendees.</descrip></descripGrp><ntig><termGrp><term id="3014879">green room</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3091058">kutish xonasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53039_3014880_3016872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The first party eCDN solution that alleviates limited corporate network downlink bandwidth to deliver high-quality video streaming and broadcasting for large audiences of employees.</descrip></descripGrp><ntig><termGrp><term id="3014880">eCDN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3016872">eCDN</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5304_232831_1181788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An add-in that stores macros, AutoText entries, and custom toolbar, menu, and shortcut key settings that you can use while you work with documents based on any template. By default, the Normal template is a global template.</descrip></descripGrp><ntig><termGrp><term id="232831">global template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1181788">umumiy qolip</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53040_3014881_3016914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within Microsoft Teams Admin Center that provides a comprehensive integrated view of Microsoft Teams Rooms (MTR) together with its related devices and connected peripherals to provide reports on room health, utilization and compliance.</descrip></descripGrp><ntig><termGrp><term id="3014881">workspace management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3016914">ish sohasini boshqarish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53041_3014882_3016887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PowerPoint feature that helps make your presentations more impactful through the recording of narrated videos.</descrip></descripGrp><ntig><termGrp><term id="3014882">recording studio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3016887">ovoz yozish studiyasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53042_3014883_3016875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability that allows customers to see all the feedback they’ve provided about Microsoft 365 and Windows products and services, the status of that feedback, and any official responses from Microsoft about the feedback. Users can also participate in community discussion with other users by upvoting and commenting.</descrip></descripGrp><ntig><termGrp><term id="3014883">feedback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3016875">fikr-mulohaza</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53043_3014884_3016871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The experience designed in PowerPoint and delivered in Microsoft Teams that helps you create inclusive and engaging presentations by providing a PowerPoint user full access to seamlessly integrate and personalize their camera feed directly into their presentation prior to joining a meeting.</descrip></descripGrp><ntig><termGrp><term id="3014884">cameo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3016871">kameya</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53044_3014885_3109585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows organizations to provide secure, trusted, and auditable remote assistance for work related apps and endpoints to workers on the frontline and/or in hybrid work environments.</descrip></descripGrp><ntig><termGrp><term id="3014885">Remote Help</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="31095