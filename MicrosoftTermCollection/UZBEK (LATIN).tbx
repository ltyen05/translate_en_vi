rols that are organized in groups. Typically, ribbon tabs are labeled.</descrip></descripGrp><ntig><termGrp><term id="1309629">ribbon tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936313">tasma ilovasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1975_73133_469616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A designation used to conduct sorting or searching operations.</descrip></descripGrp><ntig><termGrp><term id="73133">keyword</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469616">muhim so‘z</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1978_45320_1859492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enter numbers on a device, such as telephone or mobile, in order to make a phone call.</descrip></descripGrp><ntig><termGrp><term id="45320">dial</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1859492">raqam terish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry 