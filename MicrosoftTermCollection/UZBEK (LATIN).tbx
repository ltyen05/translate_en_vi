lang="en-US"><descripGrp><descrip type="definition">The phone's volume mode when in a call.</descrip></descripGrp><ntig><termGrp><term id="2071066">In-Call</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083323">Qo'ng'iroqda</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36779_2071067_2083315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of data connection in a roaming area. Generally making phone calls or using your data connection when the phone is roaming is more expensive, and the user will be charged additional fees for voice roaming calls.</descrip></descripGrp><ntig><termGrp><term id="2071067">data roaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083315">ma'lumotlar roumingi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36780_2071068_2083374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The connection on your phone that allows you to make phone calls.</descrip></descripGrp><ntig><termGrp><term id="2071068">voice connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083374">ovozli aloqa</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36781_2071069_2083376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone call made in a roaming area. Generally making phone calls or using your data connection when the phone is roaming is more expensive, and the user will be charged additional fees for voice roaming calls.</descrip></descripGrp><ntig><termGrp><term id="2071069">voice roaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083376">ovozli rouming</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36782_2238946_2083316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The setting to minimize distractions while driving.</descrip></descripGrp><ntig><termGrp><term id="2238946">Driving mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083316">Haydash rejimi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36783_2071243_2083345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The setting that determines if the screen will rotate automatically when the phone is rotated.</descrip></descripGrp><ntig><termGrp><term id="2071243">screen rotation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083345">ekran aylanishi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36784_2071244_2083380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft operating system designed for handheld portable devices.</descrip></descripGrp><ntig><termGrp><term id="2071244">Windows Embedded Handheld</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083380">Windows Embedded Handheld</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36785_2071245_2083379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft operating system built on Windows Phone 8 designed for handheld portable devices.</descrip></descripGrp><ntig><termGrp><term id="2071245">Windows Embedded 8 Handheld</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083379">Windows Embedded 8 Handheld</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36786_2071246_2083357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predetermined text reply that can be automatically sent in response to incoming calls, text messages, or both when Driving Mode is turned on. The text reply is sent with no action on the part of the user.</descrip></descripGrp><ntig><termGrp><term id="2071246">text reply</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083357">matnli javob</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36787_2071247_2083358"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A response to an incoming call using a text message when the caller is a contact calling from a mobile phone.</descrip></descripGrp><ntig><termGrp><term id="2071247">text reply</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083358">matnli javob</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36790_2071376_2083347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera option to capture just one image when the user presses the camera button.</descrip></descripGrp><ntig><termGrp><term id="2071376">single photo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083347">bitta fotosurat</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36791_2071377_2083350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo you can choose to use as the background for some Live Tiles on the Start screen.</descrip></descripGrp><ntig><termGrp><term id="2071377">Start background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083350">Bosh ekran foni</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36792_2071378_2083372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Phone feature to upgrade a phone call into a Skype video call.</descrip></descripGrp><ntig><termGrp><term id="2071378">video upgrade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083372">videoga o'tkazish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36793_2071379_2083378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual setting that enables app screen content to display in a window.</descrip></descripGrp><ntig><termGrp><term id="2071379">windowed mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083378">oyna rejimi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36794_2071380_2083319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual setting that is similar to “stretch” - the resolution of the phone screen is refitted to fill as much of the external screen as possible without compromising its dimensionality.</descrip></descripGrp><ntig><termGrp><term id="2071380">expanded screen mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083319">yoyiq ekran rejimi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36795_2071381_2083339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows desktop application that is required to enable users to project their phone screen to a Windows device using a USB connection.</descrip></descripGrp><ntig><termGrp><term id="2071381">Project My Screen App</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2083339">Ekranimni Proyeksiyalash ilovasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2072311_2086055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2072311">Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2086055">Guruhlar</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2072311_2383561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig>