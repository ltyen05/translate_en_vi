3022555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The magnitude of a number, irrespective of its sign (+ or -). An absolute value is always greater than or equal to zero. For example, 10 is the absolute value of 10 and of -10. Programming languages and spreadsheet programs commonly include functions that return the absolute value of a number.</descrip></descripGrp><ntig><termGrp><term id="6483">absolute value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3022555">mutlaq qiymat</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="820_210484_1935955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove the digital signature added to the document.</descrip></descripGrp><ntig><termGrp><term id="210484">un-sign</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1935955">imzoni olib tashlash</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8200_41830_469390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar that you create for your application.</descrip></descripGrp><ntig><termGrp><term id="41830">custom toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469390">buyurtm