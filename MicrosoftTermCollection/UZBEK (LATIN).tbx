ed</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833956">oʻqish tartibi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49928_2825758_2833949"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Translation option in Outlook that automatically translates messages that are received in languages other than the default language.</descrip></descripGrp><ntig><termGrp><term id="2825758">Always translate</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833949">Doim tarjima qilinsin</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49929_2825759_2833950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The translation option in Outlook that asks the user before automatically translating messages that are received in languages other than the default language.</descrip></descripGrp><ntig><termGrp><term id="2825759">Ask me before translating</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833950">Tarjimadan oldin mendan ruxsat olinsin</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49930_2825763_2833952"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The translation option in Outlook that never translates messages that are received in languages other than the default language.</descrip></descripGrp><ntig><termGrp><term id="2825763">Never translate</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833952">Hech qachon tarjima qilinmasin</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49931_2825767_2833957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Outlook Calendar that allows users to search for nearby schools and add the school calendar to their list of calendars.</descrip></descripGrp><ntig><termGrp><term id="2825767">Schools</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833957">Maktablar</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49932_2825770_2833958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Header in the Outlook Settings UI for the three options: Always translate, Ask me before translating, and Never translate.</descrip></descripGrp><ntig><termGrp><term id="2825770">Translation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833958">Tarjima</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49934_2825778_2833953"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Outlook that allows the user to stop messages from being delivered to the inbox for a specified amount of time.</descrip></descripGrp><ntig><termGrp><term id="2825778">Pause inbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833953">Kiruvchi xatlarni pauza qilish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49935_2825779_2833959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Outlook that allows the user to turn off the Pause inbox feature.</descrip></descripGrp><ntig><termGrp><term id="2825779">Unpause</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833959">Pauzadan chiqarish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49936_2825788_2833955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams that turns off notifications to the user's mobile phone for selected hours.</descrip></descripGrp><ntig><termGrp><term id="2825788">Quiet hours</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833955">Bezovta qilinmaydigan vaqt</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49936_2825788_3021135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams that turns off notifications to the user's mobile phone for selected hours.</descrip></descripGrp><ntig><termGrp><term id="2825788">Quiet hours</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3021135">Sokin vaqt</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49936_3020525_2833955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams that turns off notifications to the user's mobile phone for selected hours.</descrip></descripGrp><ntig><termGrp><term id="3020525">Quiet time</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833955">Bezovta qilinmaydigan vaqt</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49936_3020525_3021135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams that turns off notifications to the user's mobile phone for selected hours.</descrip></descripGrp><ntig><termGrp><term id="3020525">Quiet time</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3021135">Sokin vaqt</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49937_2825791_2833954"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams that turns off notifications to the user's mobile phone for selected days.</descrip></descripGrp><ntig><termGrp><term id="2825791">Quiet days</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833954">Bezovta qilinmaydigan kunlar</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49938_2825798_2833948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To accept an invitation (such as to a meeting) or a request.</descrip></descripGrp><ntig><termGrp><term id="2825798">accept</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833948">qabul qilish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49950_2827269_2833789"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mathematical process used for removing subexpressions from a mathematical expression, when this removal does not change the meaning or the value of the expression because the subexpressions have equal and opposing effects. For example, a fraction is put in lowest terms by cancelling out the common factors of the numerator and the denominator.</descrip></descripGrp><ntig><termGrp><term id="2827269">cancel out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833789">qisqartirish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49951_2827271_2833795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To calculate the value of.</descrip></descripGrp><ntig><termGrp><term id="2827271">evaluate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833795">hisoblash</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49953_2827274_2833805"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To convert a radical in the denominator of an algebraic fraction to a rational number.</descrip></descripGrp><ntig><termGrp><term id="2827274">rationalize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833805">irratsionallikdan qutqarish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49954_2827278_3113351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy in the form of an if-then statement that allows you to apply access controls to access your resources.</descrip></descripGrp><ntig><termGrp><term id="2827278">conditional access policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3113351">shartli kirish siyosati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49955_2827280_2833796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of removing (through division) the common factor of the terms of an algebraic expression in order to simplify the algebraic expression. For example, the expression 2y + 6 can be simplified by "factoring out" the factor 2 to produce 2(y + 3).</descrip></descripGrp><ntig><termGrp><term id="2827280">factor out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833796">qavsdan tashqariga chiqarish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49957_2827282_2833800"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number written in front of the variable with the largest exponent. For example, in the equation -7x^4 + 2x^3 - 11, the highest exponent is 4. The coefficient for that term is -7, which means that -7 is the leading coefficient.</descrip></descripGrp><ntig><termGrp><term id="2827282">leading coefficient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833800">yetakchi koeffitsiyent</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49958_2827286_2833801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An algebraic expression that contains one term, such as: 3xy.</descrip></descripGrp><ntig><termGrp><term id="2827286">monomial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833801">birhad</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49959_2827288_2833808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Either a single number or variable, or numbers and variables multiplied together. For example, the expression 4x - 7 + y = 5 contains four terms: 4x, 7, y, and 5.</descrip></descripGrp><ntig><termGrp><term id="2827288">term</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833808">had</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49960_2827297_2833788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An algebraic expression of the sum or the difference of two terms.</descrip></descripGrp><ntig><termGrp><term id="2827297">binomial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833788">ikkihad</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49960_2827297_2834054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An algebraic expression of the sum or the difference of two terms.</descrip></descripGrp><ntig><termGrp><term id="2827297">binomial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2834054">binom</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49961_2827299_2833791"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The property of multiplication whereby when a number is multiplied by the sum of two numbers, the first number can be distributed to both of those numbers and multiplied by each of them separately, and the two products can then be added together for the same result as multiplying the first number by the sum. For example: 2 x (3 + 5) = 2 x 3 + 2 x 5</descrip></descripGrp><ntig><termGrp><term id="2827299">distributive property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833791">taqsimot qonuni</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49962_2827300_2833802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that is the square of an integer; it is the product of some integer with itself. For example, 9 is a perfect square, since it can be written as 3 × 3. Any number multiplied by itself creates a perfect square.</descrip></descripGrp><ntig><termGrp><term id="2827300">perfect square</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833802">toʻliq kvadrat</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49962_2827300_2833807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that is the square of an integer; it is the product of some integer with itself. For example, 9 is a perfect square, since it can be written as 3 × 3. Any number multiplied by itself creates a perfect square.</descrip></descripGrp><ntig><termGrp><term id="2827300">perfect square</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833807">butun sonning kvadrati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49962_2827301_2833802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that is the square of an integer; it is the product of some integer with itself. For example, 9 is a perfect square, since it can be written as 3 × 3. Any number multiplied by itself creates a perfect square.</descrip></descripGrp><ntig><termGrp><term id="2827301">square number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833802">toʻliq kvadrat</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49962_2827301_2833807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that is the square of an integer; it is the product of some integer with itself. For example, 9 is a perfect square, since it can be written as 3 × 3. Any number multiplied by itself creates a perfect square.</descrip></descripGrp><ntig><termGrp><term id="2827301">square number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833807">butun sonning kvadrati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49963_2827302_2833803"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The result of multiplying, or an expression that identifies factors to be multiplied. For example, 15 is the product of 3 and 5, and x(2+x) is the product of x and 2+x.</descrip></descripGrp><ntig><termGrp><term id="2827302">product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833803">koʻpaytma</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49964_2827303_2833792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In mathematics, the operation which is the opposite of multiplication.</descrip></descripGrp><ntig><termGrp><term id="2827303">division</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833792">boʻlish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49965_2827304_2833797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A theorem linking factors and zeros of a polynomial.</descrip></descripGrp><ntig><termGrp><term id="2827304">Factor Theorem</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833797">Bezu teoremasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49966_2827305_2833804"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Theorem that for a polynomial equation in one variable with integer coefficients to have a solution (root) that is a rational number, the leading coefficient (the coefficient of the highest power) must be divisible by the denominator of the fraction and the constant term (the one without a variable) must be divisible by the numerator.</descrip></descripGrp><ntig><termGrp><term id="2827305">Rational Root Theorem</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833804">Ratsional ildiz teoremasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49967_2827314_2833806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value or values which, when substituted for a variable in an equation, make the equation true.</descrip></descripGrp><ntig><termGrp><term id="2827314">solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833806">yechim</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49968_2827731_2833799"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of financial reward offered to partners who help customers successfully deploy and adopt Microsoft 365 services.</descrip></descripGrp><ntig><termGrp><term id="2827731">incentive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833799">mukofot</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49970_2827739_2833809"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An incentive that are based on the usage of Microsoft 365 services.</descrip></descripGrp><ntig><termGrp><term id="2827739">usage incentive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833809">foydalanish uchun mukofot</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49971_2827744_2833810"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined level of usage that determines a usage incentive.</descrip></descripGrp><ntig><termGrp><term id="2827744">usage milestone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833810">belgilangan foydalanish chegarasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49976_2827830_2833936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Title of the pane that includes emojis and gifs that the user can select to include in an email.</descrip></descripGrp><ntig><termGrp><term id="2827830">Expressions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833936">Yuz ifodalari</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49977_2827837_2833943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text in search bar of Microsoft Teams where the user searches for team members.</descrip></descripGrp><ntig><termGrp><term id="2827837">Search for members</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833943">Ishtirokchilarni qidirish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49978_2827838_2833942"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text in search bar of Microsoft Teams where the user searches for channels.</descrip></descripGrp><ntig><termGrp><term id="2827838">Search for channels</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833942">Kanallarni qidirish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49979_2827839_2833944"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text in search bar of Microsoft Teams (Teams --&gt; Settings) where the user searches for a team.</descrip></descripGrp><ntig><termGrp><term id="2827839">Search teams</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833944">Jamoalarni qidirish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49983_2827856_2833947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The title of a scheduled call in Skype.</descrip></descripGrp><ntig><termGrp><term id="2827856">Title</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833947">Nom</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49984_2827858_2833946"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code that allows a user to join a team.</descrip></descripGrp><ntig><termGrp><term id="2827858">Team code</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833946">jamoa kodi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49989_2828378_2833940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A label (tag) used to filter visibility of Intune policies, devices, and apps. Users in an Azure AD security group who are also admins can see the resources that have the same scope tags. Scope tags can be assigned to a role and to objects. People with that role can see the objects with the associated tag.</descrip></descripGrp><ntig><termGrp><term id="2828378">scope tag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833940">soha kodi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49990_2828385_2833934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To create programmatically, as in AI, by applying rules to a set of data without human intervention or human judgment.</descrip></descripGrp><ntig><termGrp><term id="2828385">autogenerate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833934">avtomatik yaratish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49990_2828387_2833934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To create programmatically, as in AI, by applying rules to a set of data without human intervention or human judgment.</descrip></descripGrp><ntig><termGrp><term id="2828387">automatically generate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833934">avtomatik yaratish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49991_2828404_2833937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Status of a Microsoft Managed Desktop device that has synced with Intune in the last 28 days (or less).</descrip></descripGrp><ntig><termGrp><term id="2828404">in sync</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833937">sinxronlangan</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50_234319_2781298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The movement of information from one location to another, either within a computer (as from a disk drive to memory), between a computer and an external device (as between a file server and a computer on a network), or between separate computers.</descrip></descripGrp><ntig><termGrp><term id="234319">transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2781298">axborot uzatish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50_234319_469047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The movement of information from one location to another, either within a computer (as from a disk drive to memory), between a computer and an external device (as between a file server and a computer on a network), or between separate computers.</descrip></descripGrp><ntig><termGrp><term id="234319">transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469047">ma’lumotlar uzatish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50_234319_470378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The movement of information from one location to another, either within a computer (as from a disk drive to memory), between a computer and an external device (as between a file server and a computer on a network), or between separate computers.</descrip></descripGrp><ntig><termGrp><term id="234319">transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470378">uzatish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50_665_2781298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The movement of information from one location to another, either within a computer (as from a disk drive to memory), between a computer and an external device (as between a file server and a computer on a network), or between separate computers.</descrip></descripGrp><ntig><termGrp><term id="665">data transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2781298">axborot uzatish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50_665_469047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The movement of information from one location to another, either within a computer (as from a disk drive to memory), between a computer and an external device (as between a file server and a computer on a network), or between separate computers.</descrip></descripGrp><ntig><termGrp><term id="665">data transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469047">ma’lumotlar uzatish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50_665_470378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The movement of information from one location to another, either within a computer (as from a disk drive to memory), between a computer and an external device (as between a file server and a computer on a network), or between separate computers.</descrip></descripGrp><ntig><termGrp><term id="665">data transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470378">uzatish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="500_1538479_469359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In reference to a single microcomputer, the sum of a system's internal and external components, including memory, disk drives, keyboard, video, and generally less critical add-on hardware, such as a mouse, modem, or printer. Software (the operating system and various device drivers), the user's choices established through configuration files such as the AUTOEXEC.BAT and CONFIG.SYS files on IBM PCs and compatibles, and sometimes hardware (switches and jumpers) are needed to "configure the configuration" to work correctly. Although system configuration can be changed, as by adding more memory or disk capacity, the basic structure of the system--its architecture--remains the same.</descrip></descripGrp><ntig><termGrp><term id="1538479">system configuration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469359">konfiguratsiya fayli</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="500_37690_469359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In reference to a single microcomputer, the sum of a system's internal and external components, including memory, disk drives, keyboard, video, and generally less critical add-on hardware, such as a mouse, modem, or printer. Software (the operating system and various device drivers), the user's choices established through configuration files such as the AUTOEXEC.BAT and CONFIG.SYS files on IBM PCs and compatibles, and sometimes hardware (switches and jumpers) are needed to "configure the configuration" to work correctly. Although system configuration can be changed, as by adding more memory or disk capacity, the basic structure of the system--its architecture--remains the same.</descrip></descripGrp><ntig><termGrp><term id="37690">configuration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469359">konfiguratsiya fayli</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50000_2829752_2833935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An input device which captures the handwriting or brush strokes of a user and converts handwritten analog information created using "pen and paper" into digital data, enabling the data to be utilized in various applications.</descrip></descripGrp><ntig><termGrp><term id="2829752">digital pen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833935">elektron qalam</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50001_2829757_2833938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An animated GIF that repeats its motion in a continuous loop. A looping GIF ends up exactly where it started so that the continuous action is smooth, as if it genuinely was repeating itself. A looping GIF is made by adding still images to an animated GIF in reverse order.</descrip></descripGrp><ntig><termGrp><term id="2829757">looping GIF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2833938">davriy GIF</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5002_1276279_1183424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that is related to the active window or item, accessible by right-clicking the mouse.</descrip></descripGrp><ntig><termGrp><term id="1276279">right-click menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1183424">kontekst menyusi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5002_1276279_1183425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that is related to the active window or item, accessible by right-clicking the mouse.</descrip></descripGrp><ntig><termGrp><term id="1276279">right-click menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1183425">qalqiydigan menyu</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5002_1276279_1936048"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that is related to the active window or item, accessible by right-clicking the mouse.</descrip></descripGrp><ntig><termGrp><term id="1276279">right-click menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936048">kontekstli menyu</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5002_1276279_469367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that is related to the active window or it