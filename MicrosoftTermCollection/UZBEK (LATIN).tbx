<termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41957_2375041_2378630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who informally represents their feature team by sharing their expertise with the community in activities such as listening and responding to customer feedback, contributing to community forums, blogging about tips and tricks, and more.</descrip></descripGrp><ntig><termGrp><term id="2375041">community champion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2378630">uyushma chempioni</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41957_2751151_2378630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who informally represents their feature team by sharing their expertise with the community in activities such as listening and responding to customer feedback, contributing to community forums, blogging about tips and tricks, and more.</descrip></descripGrp><ntig><termGrp><term id="2751151">community champ</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2378630">uyushma chempioni</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4196_213534_470306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of colors or levels of gray that can be displayed at one time. The amount or memory in the computer's graphics controller card controls the display. An 8-bit controller can display 256 colors or levels of gray; a 16-bit controller, 64,000 colors; and a 24-bit controller, 16.8 million colors.</descrip></descripGrp><ntig><termGrp><term id="213534">bit specification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470306">rang uzatish sifati</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41961_2375458_3113350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The basic amount of the guaranteed ingress/egress of events sent to an Event Hub that can be dynamically scaled according to stream processing, to pay only for compute needs and handle jobs with gigabytes/sec of streamed data.</descrip></descripGrp><ntig><termGrp><term id="2375458">capacity unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3113350">sig‘im o‘lchov birligi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41961_2766779_3113350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The basic amount of the guaranteed ingress/egress of events sent to an Event Hub that can be dynamically scaled according to stream processing, to pay only for compute needs and handle jobs with gigabytes/sec of streamed data.</descrip></descripGrp><ntig><termGrp><term id="2766779">CU</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3113350">sig‘im o‘lchov birligi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4197_113668_469860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A power-saving state that allows the computer or device to quickly resume full-power operation (typically within several seconds) when you want to start working again. All open documents and programs are saved to memory before the computer or device enters the low-power state.</descrip></descripGrp><ntig><termGrp><term id="113668">sleep</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469860">kutish tartibi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4197_312080_469860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A power-saving state that allows the computer or device to quickly resume full-power operation (typically within several seconds) when you want to start working again. All open documents and programs are saved to memory before the computer or device enters the low-power state.</descrip></descripGrp><ntig><termGrp><term id="312080">sleep mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469860">kutish tartibi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41978_2375534_2378633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The nickname for Windows 10, version 1607​, used by marketing and executives in announcements about this update, but not in the product.​</descrip></descripGrp><ntig><termGrp><term id="2375534">Windows 10 Anniversary Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2378633">Windows 10 yillik yangilanish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41989_2375550_2378634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action performed on a Windows device that affects or is reflected on other devices associated with the same Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2375550">cross-device action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2378634">qurilma bo‘ylab bajariladigan amal</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42013_2376461_2380841"><langSet xml:lang="en-US"><descripGrp><