ll area of a display screen. Applications running in windowing environments, although they might use the entire area of the screen, commonly allocate different areas to different windows, any of which can be enlarged to fill the entire screen.</descrip></descripGrp><ntig><termGrp><term id="57264">full screen</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469520">butun ekranga</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1902_779009_2617642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Capable of using or being displayed on the full area of a display screen. Applications running in windowing environments, although they might use the entire area of the screen, commonly allocate different areas to different windows, any of which can be enlarged to fill the entire screen.</descrip></descripGrp><ntig><termGrp><term id="779009">full-screen</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="2617642">butun ekran</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1902_779009_469520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Capable of using or being displayed on the full area of a display screen. Applications running in windowing environments, although they might use the entire area of the screen, commonly allocate different areas to different windows, any of which can be enlarged to fill the entire screen.</descrip></descripGrp><ntig><termGrp><term id="779009">full-screen</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469520">butun ekranga</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1914_1060965_1183414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make an entity nonfunctional.</descrip></descripGrp><ntig><termGrp><term id="1060965">turn off</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1183414">o‘chirmoq</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1914_46388_1183414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make an entity nonfunctional.</descrip></descripGrp><ntig><termGrp><term id="46388">disable</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1183414">o‘chirmoq</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1918_183941_470231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to check and remove personal and other sensitive information from a document.</descrip></descripGrp><ntig><termGrp><term id="183941">Document Inspector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="470231">hujjatlar inspektori</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19188_652160_1936113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of PivotTable view that contains row fields.</descrip></descripGrp><ntig><termGrp><term id="652160">row area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936113">satr sohasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19189_652161_1936114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The numbered gray area to the left of each row.</descrip></descripGrp><ntig><termGrp><term id="652161">row heading</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936114">satr sarlavhasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1919_46463_469435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A round, flat piece of nonmagnetic, shiny metal encased in a plastic coating, designed to be read from and written to by optical (laser) technology.</descrip></descripGrp><ntig><termGrp><term id="46463">disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="469435">disk</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19191_652163_1936115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An accessibility aid for people who are blind or have learning disabilities, such as dyslexia. These aids make on-screen information available as synthesized speech or a refreshable Braille display.</descrip></descripGrp><ntig><termGrp><term id="652163">screen review utility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936115">ekranni ko'rish dasturi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19196_652168_1936116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that is displayed in the series area of a chart and that contains series items. A series is a group of related data points.</descrip></descripGrp><ntig><termGrp><term id="652168">series field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936116">qator maydoni</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19203_652175_1936117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cell that has been linked to a non-repeating element in an XML map.</descrip></descripGrp><ntig><termGrp><term id="652175">single-mapped cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936117">yagona-taqqoslangan uya</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19205_652177_1462419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change the dimensions of a shape by dragging one of its handles after it has been selected with the pointer tool.</descrip></descripGrp><ntig><termGrp><term id="652177">size</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1462419">o‘lcham</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19212_652184_1462420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small overlap that extends the shape of the upper of two differently colored, abutting objects. A spread extends beyond the area that it knocks out.</descrip></descripGrp><ntig><termGrp><term id="652184">spread</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1462420">spred</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19213_652185_1936118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Office Web Component that provides the interactive functionality of a spreadsheet on a Web page. You can enter data, add formulas and functions, apply filters, change formatting, and recalculate.</descrip></descripGrp><ntig><termGrp><term id="652185">Spreadsheet Component</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936118">Elektron jadval qismi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19215_652187_1181958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default text font for worksheets. The standard font determines the default font for the Normal cell style.</descrip></descripGrp><ntig><termGrp><term id="652187">standard font</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1181958">standart shrift</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19219_652191_1462421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A date that you set [rather than the current date] for reporting the time, cost, or performance condition of a project.</descrip></descripGrp><ntig><termGrp><term id="652191">status date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1462421">holat sanasi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19221_652193_1181959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A description of the status of a member's project work and related work.</descrip></descripGrp><ntig><termGrp><term id="652193">status report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1181959">holat haqida hisobot</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19229_652201_1462422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task that is made up of subtasks and summarizes those subtasks. Use outlining to create summary tasks. Project automatically determines summary task information [such as duration and cost] by using information from the subtasks.</descrip></descripGrp><ntig><termGrp><term id="652201">summary task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1462422">jamlama topshiriq</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19232_652204_1462423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An horizontal or vertical line that divides a diagram into partitions and which is used to arrange related parts of a process.</descrip></descripGrp><ntig><termGrp><term id="652204">swimlane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1462423">svimleyn</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19234_652206_1798711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any application or process that you want to model. Examples of systems include a computer game, a process for assembling microchips, and a library information system.</descrip></descripGrp><ntig><termGrp><term id="652206">system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1798711">tizim</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19250_652222_1936119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of a set of major and minor fonts that is applied to a file. Theme fonts, theme colors, and theme effects compose a theme.</descrip></descripGrp><ntig><termGrp><term id="652222">theme font</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936119">mavzu shrifti</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19251_652223_1936120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of pane that presents the current scanned document as one or more small images.</descrip></descripGrp><ntig><termGrp><term id="652223">thumbnail pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936120">eskiz paneli</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19254_652226_1462424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time period indicator at the top of the Gantt views, the Resource Graph view, the Task Usage view, and the Resource Usage view. You can customize it to show up to three tiers that can display various time units: top, middle, and bottom.</descrip></descripGrp><ntig><termGrp><term id="652226">timescale</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1462424">vaqt masshtabi</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19258_652230_1936121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special row in a list or table that provides a selection of aggregate functions useful for working with numerical data.</descrip></descripGrp><ntig><termGrp><term id="652230">total row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936121">jami qatorlar</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19258_760167_1936121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special row in a list or table that provides a selection of aggregate functions useful for working with numerical data.</descrip></descripGrp><ntig><termGrp><term id="760167">totals row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936121">jami qatorlar</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19261_652233_1936122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An arrow that shows the relationship between the active cell and its related cells. Tracer arrows are blue when pointing from a cell that provides data to another cell, and red if a cell contains an error value, such as #DIV/0!.</descrip></descripGrp><ntig><termGrp><term id="652233">tracer arrow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936122">trassirovka mili</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19264_652236_1936123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Optional text for a trendline, including either the regression equation or the R-squared value, or both. A trendline label can be formatted and moved; it cannot be sized.</descrip></descripGrp><ntig><termGrp><term id="652236">trendline label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936123">trend chizig‘ining yorlig‘i</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19265_652237_1181960"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder or file path on your computer or a location on your intranet from which it is safe to run code. Default trusted locations include the Templates, Addins, and Startup folders, and you can specify your own trusted locations.</descrip></descripGrp><ntig><termGrp><term id="652237">trusted location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1181960">ishonchli joylashuv</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19266_652238_1936124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of software publisher certificates used to digitally sign code, such as macros. Because you explicitly trust the software publishers, their code is allowed to run on your computer without needing to prompt for permission.</descrip></descripGrp><ntig><termGrp><term id="652238">trusted publisher store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1936124">ishonchli noshir do'koni</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19271_652243_1462425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The percentage of a work resource’s time that is assigned to a task.</descrip></descripGrp><ntig><termGrp><term id="652243">unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="1462425">birliklar</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelect