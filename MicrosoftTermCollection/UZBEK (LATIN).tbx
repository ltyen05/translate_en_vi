:lang="en-US"><descripGrp><descrip type="definition">A policy template that helps detect personal data that has not been used for more than 90 days and trigger remediation actions, including sending notifications to data owners to apply retention labels or disposing of the information immediately.</descrip></descripGrp><ntig><termGrp><term id="3031834">data minimization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3032892">ma’lumotni minimallashtirish</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53224_3031835_3032888"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The metered service that enables licensed M365 commercial, consumer, and education users to use Office Online to view, edit, and coauthor documents stored on cloud storage providers other than SharePoint or OneDrive.</descrip></descripGrp><ntig><termGrp><term id="3031835">Coauthoring</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="uz-Latn"><ntig><termGrp><term id="3032888">Hammualliflik</term><termNote type="geographicalUsage">UZB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53225_3053615_3053768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cross-industry experience app in Microsoft Teams that provides seamless scheduling, analytics, and premium experiences for business-to-customer meetings, bringing together current virtual appointment exper