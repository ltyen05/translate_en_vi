rip></descripGrp><ntig><termGrp><term id="51300">entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1463784">entitet</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10048_51300_1463785"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object (such as a customer, item, or employee) that shares a set of defined attributes or characteristics, and that is used to manage rules for data.</descrip></descripGrp><ntig><termGrp><term id="51300">entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1463785">tipi i përmbajtjes së jashtme</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10052_58226_480301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quick movement of a finger or pen on a screen that the computer interprets as a command, rather than as a mouse movement, writing, or drawing.</descrip></descripGrp><ntig><termGrp><term id="58226">gesture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480301">gjest</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1006_318140_481584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of four fields of an SCODE. It is a unique number that is assigned to represent the error or warning.</descrip></descripGrp><ntig><termGrp><term id="318140">error code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481584">kodi i gabimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10066_122471_2818389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sum of the diagonal entries of a square matrix.</descrip></descripGrp><ntig><termGrp><term id="122471">trace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2818389">gjurmë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10069_338533_481738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In printing, the process of eliminating white lines between colors by printing small areas of overlapping color where colors touch.</descrip></descripGrp><ntig><termGrp><term id="338533">trapping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481738">zbukurim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech"