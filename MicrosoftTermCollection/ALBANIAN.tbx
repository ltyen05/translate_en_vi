d to-do list app that helps people capture their ideas, things to do and places to see.</descrip></descripGrp><ntig><termGrp><term id="2320890">Wunderlist</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2330443">Wunderlist</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39889_2321509_2323490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of TV shows that are in the top N% of ratings.</descrip></descripGrp><ntig><termGrp><term id="2321509">Top-rated TV shows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2323490">Shfaqjet televizive me vlerësim më të mirë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39890_2321510_2323284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of items emphasized to the customer through placement on the site.</descrip></descripGrp><ntig><termGrp><term id="2321510">Featured collections</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2323284">Koleksionet e spikatura</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote t