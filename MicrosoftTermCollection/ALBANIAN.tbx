Grp><descrip type="definition">A set of software that provides access to a particular type of OLAP database. This software can include a data source driver and other client software that is necessary to connect to a database.</descrip></descripGrp><ntig><termGrp><term id="145441">OLAP provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914802">ofruesi OLAP</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6279_26739_2060893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To attempt to establish a voice conversation with another person or other people from a phone, computer, or mobile device.</descrip></descripGrp><ntig><termGrp><term id="26739">call</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2060893">thirr</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6279_26739_480045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To attempt to establish a voice conversation with another person or other people from a phone, computer, or mobile device.</descrip></descripGrp><ntig><termGrp><term id="26739">call</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480045">thërras</term><termNote type="geographicalUsage">A