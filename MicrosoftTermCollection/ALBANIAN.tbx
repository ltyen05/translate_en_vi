9"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams that enables users to join a meeting from a conference room with their own personal device.</descrip></descripGrp><ntig><termGrp><term id="3059305">companion device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3060259">pajisje shoqëruese</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53728_3059306_3060266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows you to share content from physical whiteboards and documents in a high-quality way during meetings.</descrip></descripGrp><ntig><termGrp><term id="3059306">intelligent content capture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3060266">regjistrim inteligjent përmbajtjeje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53729_3059307_3060262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables Microsoft 365 Enterprise users to streamline communication, collaboration, and meeting-related tasks using spoken natural language.</descrip></descripGrp><ntig><termGrp><term id="3059307">Cortana voice assistance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSe