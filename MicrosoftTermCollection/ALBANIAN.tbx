Note type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2753639">Administratori i vërtetimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48459_2737172_2753646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrator role that can approve Microsoft support requests to access customer organizational data.</descrip></descripGrp><ntig><termGrp><term id="2737172">Customer Lockbox access approver</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2753646">Miratuesi për qasjen në arkivin e mbrojtur të klientit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4846_215978_480016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location or selection of text in a file that you name for reference purposes. Bookmarks identify a location within your file that you can later refer or link to.</descrip></descripGrp><ntig><termGrp><term id="215978">anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480016">shenja e referimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber"