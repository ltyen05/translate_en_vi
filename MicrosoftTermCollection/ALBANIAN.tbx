">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1538562">program</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10498_168444_1914934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who can schedule meetings, send invitations, do all the sharing activities in a meeting, and admit participants from the lobby.</descrip></descripGrp><ntig><termGrp><term id="168444">Organizer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914934">organizuesi i takimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10498_168444_2326857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who can schedule meetings, send invitations, do all the sharing activities in a meeting, and admit participants from the lobby.</descrip></descripGrp><ntig><termGrp><term id="168444">Organizer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2326857">organizuesi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10498_168445_1914934"><langSet xml:lang="en-US"><descripG