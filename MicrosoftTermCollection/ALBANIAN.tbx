ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915247">Shiriti i veglave të formatimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29464_1508812_1915248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Visual Basic identifier that's defined in the host application or by using the #Const compiler directive, and used by other compiler directives to determine when or if certain blocks of code are compiled.</descrip></descripGrp><ntig><termGrp><term id="1508812">conditional compiler constant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915248">konstantja e kompiluesit të kushtëzuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29465_1508813_1915249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Naskh script that enriches the display of Arabic text. This script uses object linking and embedding (OLE) to create and add objects to a document.</descrip></descripGrp><ntig><termGrp><term id="1508813">DecoType Naskh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915249">DecoType Naskh</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termN