rip></descripGrp><ntig><termGrp><term id="2569603">pencil effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2577380">efekti i lapsit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45589_2570254_2913002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app in Office 365 Education SKUs that provides data aggregation, analytics, dashboards, and reporting to education personas (Students, Teachers, Parents, System Administrator, and IT).</descrip></descripGrp><ntig><termGrp><term id="2570254">Microsoft Education Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2913002">Education Analytics</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45589_2570254_2913014"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app in Office 365 Education SKUs that provides data aggregation, analytics, dashboards, and reporting to education personas (Students, Teachers, Parents, System Administrator, and IT).</descrip></descripGrp><ntig><termGrp><term id="2570254">Microsoft Education Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2913014">Microsoft Education Analytics</term><termNo