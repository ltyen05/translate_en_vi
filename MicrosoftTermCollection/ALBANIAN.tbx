p, the paid plan that offers access to premium features for everyday editors.</descrip></descripGrp><ntig><termGrp><term id="3187998">Premium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3064272">Esencialet</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53733_3060419_3071874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area in Clipchamp's video editor where all components are assembled and arranged on tracks.</descrip></descripGrp><ntig><termGrp><term id="3060419">timeline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3071874">vija kohore</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53734_3060420_3071875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of the timeline where editing elements such as videos, images, audio, stickers, text blocks, etc. are placed and arranged to create a video.</descrip></descripGrp><ntig><termGrp><term id="3060420">track</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3071875">kanal</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNo