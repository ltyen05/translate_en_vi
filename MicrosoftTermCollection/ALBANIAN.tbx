71_1993382_1996292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of importing prepared data using a software procedure rather than the end user entering the information.</descrip></descripGrp><ntig><termGrp><term id="1993382">prepopulation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1996292">paraplotësim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34572_1993404_2003561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An IRS tax rule in the United States that requires notified payers to withhold a set percentage from payments made to payees who cannot be identified due to missing or incorrect taxpayer identification numbers on tax forms.</descrip></descripGrp><ntig><termGrp><term id="1993404">backup withholding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2003561">pritje rezervë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34573_1993405_2003568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An United States tax law designation given to any corporation that is a unique entity apart from and taxed separately from its owners.</descrip></descripGrp><ntig><termGrp><term id="1993405">C corporation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></