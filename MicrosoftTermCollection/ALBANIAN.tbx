ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2515029">GitHub</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42317_2394284_2554308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal approach used by organizations to orchestrate, prioritize and benefit from projects by examining the risk-reward of each project, the available funds, the likelihood of a project's duration, and the expected outcomes.</descrip></descripGrp><ntig><termGrp><term id="2394284">project portfolio management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2554308">PPM</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42317_2394284_2554309"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal approach used by organizations to orchestrate, prioritize and benefit from projects by examining the risk-reward of each project, the available funds, the likelihood of a project's duration, and the expected outcomes.</descrip></descripGrp><ntig><termGrp><term id="2394284">project portfolio management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2554309">menaxhimi i portofolit të projektit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42317_2394292_2554308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal approach used by organizations to orchestrate, prioritize and benefit from projects by examining the risk-reward of each project, the available funds, the likelihood of a project's duration, and the expected outcomes.</descrip></descripGrp><ntig><termGrp><term id="2394292">PPM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2554308">PPM</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42317_2394292_2554309"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal approach used by organizations to orchestrate, prioritize and benefit from projects by examining the risk-reward of each project, the available funds, the likelihood of a project's duration, and the expected outcomes.</descrip></descripGrp><ntig><termGrp><term id="2394292">PPM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2554309">menaxhimi i portofolit të projektit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42326_2394553_2397120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">After a build update, to load an app with domain data (such as data from a database, from the network, or from a file system), during the download process. Before this step, the app cannot be used.</descrip></descripGrp><ntig><termGrp><term id="2394553">hydrate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2397120">plotësoj të dhënat</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42327_2394727_2422447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for multi-factor authentication, device registration to Azure AD, and SSO/certificate-based authentication against Azure AD that generates a security code the user must enter to verify his/her identity or, for enterprise users, a QR code to scan.</descrip></descripGrp><ntig><termGrp><term id="2394727">Microsoft Authenticator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2422447">Authenticator</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42327_2422386_2422447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for multi-factor authentication, device registration to Azure AD, and SSO/certificate-based authentication against Azure AD that generates a security code the user must enter to verify his/her identity or, for enterprise users, a QR code to scan.</descrip></descripGrp><ntig><termGrp><term id="2422386">Authenticator</term><termNote type="partOfSpeech">Pr