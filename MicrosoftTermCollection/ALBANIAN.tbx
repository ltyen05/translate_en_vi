247565">upvote</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2251189">votë pro</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38636_2247566_2251190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To agree with similar feedback sent by someone else. Rather than resubmit the same feedback, you can tap "Upvote," which means that you agree with the feedback that has been previously submitted.</descrip></descripGrp><ntig><termGrp><term id="2247566">upvote</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2251190">votoj pro</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38638_2247833_2252037"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user accounts that are connected as a family. This feature allows adults to manage kids’ experiences within the kids’ user account.</descrip></descripGrp><ntig><termGrp><term id="2247833">Microsoft family</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2252037">familja e Microsoft</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</ter