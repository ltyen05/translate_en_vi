></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2677498">ruajtja e të dhënave</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46301_2676908_2677503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The storage of data for meeting regulatory and business data archival requirements.</descrip></descripGrp><ntig><termGrp><term id="2676908">retention</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2677503">ruajtje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4631_158674_1188397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu for a group of ready-made shapes that includes basic shapes, such as rectangles and circles, plus a variety of lines and connectors, block arrows, flowchart symbols, stars and banners, and callouts.</descrip></descripGrp><ntig><termGrp><term id="158674">AutoShapes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188397">Forma automatike</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46310_2608183_2609500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web part that is offered as default for the design of a SharePoint communication site.</descrip></descripGrp><ntig><termGrp><term id="2608183">default hero</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2609500">heroi i parazgjedhur</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46325_2608792_2609499"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint site created or managed by few people to broadcast information out to a broad audience.</descrip></descripGrp><ntig><termGrp><term id="2608792">communication site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2609499">sajti i komunikimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46330_2609539_2663765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that enables Cortana to take over your mouse pointer and literally show you how to change a setting when you ask her to "show me (how to do something)." She performs each step for you in a sequence of clicks needed to make a particular change in Windows Settings.</descrip></descripGrp><ntig><termGrp><term id="2609539">Cortana Show Me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp>