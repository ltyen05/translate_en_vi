">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188432">çelësi i enkriptimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7115_162589_1188432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bit string that is used in conjunction with an encryption algorithm to encrypt and decrypt data.</descrip></descripGrp><ntig><termGrp><term id="162589">encryption key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188432">çelësi i enkriptimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7131_27602_1914674"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Written or printed with an initial capital or in capitals.</descrip></descripGrp><ntig><termGrp><term id="27602">capitalized</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914674">i kapitalizuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7132_307423_2291184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables a caller to enter a