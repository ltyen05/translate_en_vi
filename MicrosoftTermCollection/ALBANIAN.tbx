:lang="en-US"><descripGrp><descrip type="definition">The categories of assignments for a given class, along with a percentage value that indicates how much each category weighs into the overall grade. Other factors, such as class participation, may also be considered.</descrip></descripGrp><ntig><termGrp><term id="1623978">evaluation criteria</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915295">kriteret e vlerësimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31795_1623979_1915296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of refining a search for information by filtering on individual properties or facets of the items being searched.</descrip></descripGrp><ntig><termGrp><term id="1623979">faceted navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915296">navigim me filtrim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31796_1623980_1915297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Comments about a completed assignment that an educator makes during review and grading and that are available to the student once the grade is posted.</descrip></descripGrp><ntig><termGrp><term id="1623980">feedback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langS