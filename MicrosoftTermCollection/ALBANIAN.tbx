ition">A Windows feature on select devices with the proper sensor to detect motion as someone walks away from their device so it powers down/sleeps to save power.</descrip></descripGrp><ntig><termGrp><term id="3055385">lock on leave</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3055747">kyçje gjatë ikjes</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53671_3055386_3059469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that dims or brightens the display in response to lighting conditions.</descrip></descripGrp><ntig><termGrp><term id="3055386">adaptive dimming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3059469">zbehje adaptive</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53673_3055633_3059513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Gaming Runtime utility that helps ensure a MSIXVC packaged PC game is in healthy state before the game process starts.</descrip></descripGrp><ntig><termGrp><term id="3055633">PC Bootstrapper</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3059513">PC Bootstrapper</term><termNote type="geographicalUsage">ALB</termNote><termNote typ