computer, server farm, or server cluster.</descrip></descripGrp><ntig><termGrp><term id="1508552">safe mode parser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915242">analizuesi i regjimit të sigurt</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29440_1508555_1915243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Help window that contains a Help topic.</descrip></descripGrp><ntig><termGrp><term id="1508555">topic pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915243">paneli i temës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29442_1508557_1915244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that identifies which assemblies and types are allowed to run on Web Parts pages in a server farm. The list is stored in the web.config file for the server farm.</descrip></descripGrp><ntig><termGrp><term id="1508557">SafeControl list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915244">lista e kontrollit të sigurt</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="gramm