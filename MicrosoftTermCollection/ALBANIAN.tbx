ype="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918326">Video Kinect</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34364_1991474_2918117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect based guide that appears over a game and allows for social interactions (friends, invites, chat, etc.).</descrip></descripGrp><ntig><termGrp><term id="1991474">Kinect Guide</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918117">Udhëzuesi i Kinect</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34365_1991475_2918128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect based troubleshooter that helps users with common problems related to the play space, lighting, speech/audio, setup, and hardware errors.</descrip></descripGrp><ntig><termGrp><term id="1991475">Kinect Tuner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918128">Konfiguruesi i Kinect</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34366_1991476_2919933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Disc used for playing games.</descrip></descripGrp><ntig><termGrp><term id="1991476">game disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2919933">disk loje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34367_1991477_2918002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a permanent attachment between a wireless controller and the console.</descrip></descripGrp><ntig><termGrp><term id="1991477">connect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918002">lidhu</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34368_1991478_2918006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When in vertical orientation, the stabilizers at the bottom of the console.</descrip></descripGrp><ntig><termGrp><term id="1991478">console feet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918006">këmbë konsole</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></nti