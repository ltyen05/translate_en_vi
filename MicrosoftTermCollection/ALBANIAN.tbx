term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49854_2819397_2821269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">a set of entities and the relationships between the entities</descrip></descripGrp><ntig><termGrp><term id="2819397">entity schema</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821269">skema e entiteteve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49855_2819402_2821307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In OAuth authentication, a token that is used by the Consumer to ask the User to authorize access to the Protected Resources. The User-authorized Request Token is exchanged for an Access Token, MUST only be used once, and MUST NOT be used for any other purpose. It is RECOMMENDED that Request Tokens have a limited lifetime.</descrip></descripGrp><ntig><termGrp><term id="2819402">request token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821307">kodi i kërkesës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49856_2819416_2821323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common cache source that can be accessed by multiple processes and machines.</descrip></descripGrp><ntig><termGrp><term id="2819416">shared cache</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821323">memorie specifike e përbashkët</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49857_2819428_2821316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of users based on Azure AD attributes (such as location or department), or shared resources such as SharePoint sites. For example, you can have the segment "corporate advisory" and have "corporate advisory users" and "corporate advisory sites." In some cases, users in one segment may not be allowed to discover or communicate with users in another segment.</descrip></descripGrp><ntig><termGrp><term id="2819428">segment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821316">segment</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49858_2819429_2821339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in M365 admin center, which provides data, insights and recommendations related to optimization of devices, software, and other technology in your organization.</descrip></descripGrp><ntig><termGrp><term id="2819429">technology experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821339">Përvoja e teknologjisë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49858_2831275_2821339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in M365 admin center, which provides data, insights and recommendations related to optimization of devices, software, and other technology in your organization.</descrip></descripGrp><ntig><termGrp><term id="2831275">Technology experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821339">Përvoja e teknologjisë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49859_2819431_2821304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">MMD device profile that provides local administrator privileges for users who need more control of their issued devices.</descrip></descripGrp><ntig><termGrp><term id="2819431">Privileged access device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821304">Profili i pajisjes së qasjes së privilegjuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4986_37166_1188405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device capable of processing information, storing data, and producing a desired result based on instructions provided.</descrip></descripGrp><ntig><termGrp><term id="37166">computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188405">kompjuter</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49860_2819434_2821302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The MMD device profile that offers the greatest power to the local user (ability to install apps, etc.). Intended for use typically by developers, field engineers, etc.</descrip></descripGrp><ntig><termGrp><term id="2819434">Power user device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821302">profili i pajisjes së përdoruesit të përparuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49861_2819436_2821318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The MMD device profile that is more &amp;quot;locked down&amp;quot; to preserve the security of sensitive data. Intended for handling sensitive data such as medical records.</descrip></descripGrp><ntig><termGrp><term id="2819436">Sensitive data device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821318">Profili i pajisjes së të dhënave të ndjeshme</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49862_2819437_2821326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The MMD device profile that has the most balance of user privileges and data security--expected to be the most common profile and used by typical information workers.</descrip></descripGrp><ntig><termGrp><term id="2819437">Standard device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821326">Profili i pajisjes standarde</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49863_2911838_2912457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft Managed Desktop device profile optimized for use by frontline workers. Limited power for the user; intended for scenarios with multiple users sharing the same device, such as at a nurses' station. Likely to be operating under the F1 license.</descrip></descripGrp><ntig><termGrp><term id="2911838">frontline device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2912457">profil pajisjeje parësore</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49864_2819441_2821281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the proposed MMD device profiles. This would support a single app without requiring a user sign in.</descrip></descripGrp><ntig><termGrp><term id="2819441">Kiosk device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821281">Profili i pajisjes së kioskës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49865_2819443_2821268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in Microsoft 365, which includes insights and recommendations about usage of Microsoft 365 products that are related to employee productivity, engagement, wellbeing, and related concepts.</descrip></descripGrp><ntig><termGrp><term id="2819443">employee experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821268">Përvoja e punonjësit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49865_2831277_2821268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in Microsoft 365, which includes insights and recommendations about usage of Microsoft 365 products that are related to employee productivity, engagement, wellbeing, and related concepts.</descrip></descripGrp><ntig><termGrp><term id="2831277">Employee experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821268">Përvoja e punonjësit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49866_2819444_2821313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of Microsoft-recommended configuration settings along with an explanation of their security impact. These settings are based on feedback from Microsoft security engineering teams, product groups, partners, and customers.</descrip></descripGrp><ntig><termGrp><term id="2819444">security baseline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821313">vija bazë e sigurisë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49867_2819445_2821335"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that the customer defines, which represents a goal.</descrip></descripGrp><ntig><termGrp><term id="2819445">target</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821335">objektiv</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49868_2819447_2821240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft 365 scores, a recommendation based on data from your organization, which, if completed, results directly or indirectly in points earned to improve your score. This can be a direct action like changing a setting, or an indirect action like providing training to users that encourages them to use a feature more.</descrip></descripGrp><ntig><termGrp><term id="2819447">action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821240">veprim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49868_2819447_2821280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft 365 scores, a recommendation based on data from your organization, which, if completed, results directly or indirectly in points earned to improve your score. This can be a direct action like changing a setting, or an indirect action like providing training to users that encourages them to use a feature more.</descrip></descripGrp><ntig><termGrp><term id="2819447">action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821280">veprim për përmirësimin</term><termNote type="geographicalUsage">ALB</te