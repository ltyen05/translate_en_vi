d="2506553">state token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2512006">kodi i gjendjes</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44567_2506560_2511972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of data about a resource that contains complex values, generally indicating behaviors or capabilities of an item.</descrip></descripGrp><ntig><termGrp><term id="2506560">facet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2511972">me faqe</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44568_2506562_2511971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of data related to Outlook MAPI properties not already exposed in the Microsoft Graph API metadata.</descrip></descripGrp><ntig><termGrp><term id="2506562">extended property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2511971">vetia e zgjeruar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44569_2506611_2509715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that enables Wi-Fi devices to connect directly, without a router or other mechanism, making it simpler to do things like print, share, sync, and display.​</descrip></descripGrp><ntig><termGrp><term id="2506611">Wi-Fi Direct</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2509715">Wi-Fi Direct</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44586_2506886_2509681"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that enables members of a Language community to provide translation and language-related feedback about features. The app is currently available only for Windows Desktop.</descrip></descripGrp><ntig><termGrp><term id="2506886">Language Community app</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2509681">aplikacioni Komuniteti gjuhësor</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44587_2506888_2509685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request to gather and send language feedback using quests in Feedback Hub and the Language Community app.​</descrip></descripGrp><ntig><termGrp><term id="2506888">language quest</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2509685">kërkesë gjuhësore</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4459_148656_480885"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The slide that stores information about the design template applied, including font styles, placeholder sizes and positions, background design, and color schemes.</descrip></descripGrp><ntig><termGrp><term id="148656">slide master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480885">modeli i pamjes rrëshqitëse</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44608_2573054_2577378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of the expanded view of the profile card that contains LinkedIn profile information.</descrip></descripGrp><ntig><termGrp><term id="2573054">LinkedIn profile in Microsoft</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2577378">Profili i LinkedIn në Microsoft</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44611_2509173_2514852"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to compose and save a message as a template, and then reuse it when they want to.</descrip></descripGrp><ntig><termGrp><term id="2509173">Email templates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2514852">Shabllonet e emailit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4462_72367_480382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The core of layered architecture that manages the most basic operations of the operating system and the computer's processor. The kernel schedules different blocks of executing code, called threads, for the processor to keep it as busy as possible and coordinates multiple processors to optimize performance. The kernel also synchronizes activities among Executive-level subcomponents, such as I/O Manager and Process Manager, and handles hardware exceptions and other hardware-dependent functions. The kernel works closely with the hardware abstraction layer.</descrip></descripGrp><ntig><termGrp><term id="72367">kernel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480382">bërthamë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44639_2512914_2729272"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack in which attackers attempt to increase existing privileges and use them multiple times in order to eventually gain full control over the victim’s environment.</descrip></descripGrp><ntig><termGrp><term id="2512914">privilege escalation attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2729272">sulm për shkallëzimin e privilegjeve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44646_2897501_3088118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that helps protect your enterprise hybrid environments from multiple types of advanced targeted cyber attacks and insider threats.</descrip></descripGrp><ntig><termGrp><term id="2897501">Microsoft Defender for Identity</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3088118">Microsoft Defender for Identity</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44647_2513424_2518532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To take an existing story in the Photos app and generate a new version of that story with edits to content, style, music, and other options.​</descrip></descripGrp><ntig><termGrp><term id="2513424">remix</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2518532">krijo një remiks</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44648_2513444_2518534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Groove Music app, a graphical display that changes colors and shapes on the screen in response to the music that is playing. The user can choose from several different visualizers, which each look different.</descrip></descripGrp><ntig><termGrp><term id="2513444">visualizer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2518534">vizualizuesi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44651_2513850_2736330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The extension that enables access to data across Office 365 services and Azure Active Directory through Microsoft Graph.</descrip></descripGrp><ntig><termGrp><term id="2513850">Microsoft Office 365 Connected Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2736330">Shërbimet e lidhura të Microsoft Office 365</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44660_2514598_2517167"><langSet xml:lan