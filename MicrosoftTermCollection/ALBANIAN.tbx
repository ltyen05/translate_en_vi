p customized Microsoft SharePoint deployment plans, and that is part of software assurance coverage.</descrip></descripGrp><ntig><termGrp><term id="1673938">SDPS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2726424">Shërbimet e planifikimit të shpërndarjes së SharePoint</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28406_1484854_2726260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Software Assurance benefit delivered by Microsoft Certified Partner that consists of one to fifteen days of planning the deployment of Microsoft Office Software for a specific organization.</descrip></descripGrp><ntig><termGrp><term id="1484854">Microsoft Desktop Deployment Planning Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2726260">Shërbimet e planifikimit të shpërndarjes së desktopit të Microsoft</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28426_1486692_2687422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that represents a service at the Key Distribution Center (KDC). The service principal has a name and an associated key. A subclass of principal, a service principal generally does not correspond to a human user of the system, but rather to an automated service providing a resource, such as a file server.</descrip></descripGrp><ntig><termGrp><term id="1486692">service principal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2687422">entiteti i shërbimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2846_297003_481423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trojan that captures and/or transmits passwords to an attacker.</descrip></descripGrp><ntig><termGrp><term id="297003">password stealer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481423">grabitësi i fjalëkalimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28462_1488403_2291281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows the preservation of items in user mailboxes and the protection of the items from deletion by users or automated processes.</descrip></descripGrp><ntig><termGrp><term id="1488403">Litigation Hold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2291281">Mbajtje në ruajtje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28541_1489075_1744330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service under which customers can acquire and redeem points for certain online services and digital products.</descrip></descripGrp><ntig><termGrp><term id="1489075">Microsoft Points</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1744330">Pikë Microsoft</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28541_1489075_2354705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service under which customers can acquire and redeem points for certain online services and digital products.</descrip></descripGrp><ntig><termGrp><term id="1489075">Microsoft Points</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2354705">Pikët Microsoft</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28593_1489612_2078558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of repeated installation of a product, feature, tool, kit, pack, etc.</descrip></descripGrp><ntig><termGrp><term id="1489612">reinstallation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2078558">riinstalim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28619_1489914_1834850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a request for payment.</descrip></descripGrp><ntig><termGrp><term id="1489914">billing</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1834850">faturim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2865_19878_479997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The special identification code printed as a set of vertical bars of differing widths on books, grocery products, and other merchandise. Used for rapid, error-free input in such facilities as libraries, hospitals, and grocery stores, bar codes represent binary information that can be read by an optical scanner. The coding can include numbers, letters, or a combination of the two; some codes include built-in error checking and can be read in either direction.</descrip></descripGrp><ntig><termGrp><term id="19878">bar code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="479997">kod me shirita</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2865_237346_479997"><langSe