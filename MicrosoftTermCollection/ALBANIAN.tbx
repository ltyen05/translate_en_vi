termEntry id="2763_297184_481432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that monitors activity, such as keystrokes or screen images. These programs are often installed by the computer owner or administrator, and are only a threat if they are unexpected.</descrip></descripGrp><ntig><termGrp><term id="297184">monitoring software</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481432">softuer monitorimi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2767_226560_1479049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that is used in Microsoft Points to enable efficient micropayments and prepaid purchase for cash based consumers (including kids/teens, as well as emerging and developing markets) and provide a mechanism to directly reward loyal customers.</descrip></descripGrp><ntig><termGrp><term id="226560">point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1479049">pikë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2767_226560_2918192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that is used in Microsoft Points to enable efficient micropayments and prepaid purchase for cash based consumers (including kids/teens, as well as emerging and developing markets) and provide a mechanism to directly reward loyal customers.</descrip></descripGrp><ntig><termGrp><term id="226560">point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918192">p</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2767_226561_1479049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that is used in Microsoft Points to enable efficient micropayments and prepaid purchase for cash based consumers (including kids/teens, as well as emerging and developing markets) and provide a mechanism to directly reward loyal customers.</descrip></descripGrp><ntig><termGrp><term id="226561">p</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1479049">pikë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2767_226561_2918192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that is used in Microsoft Points to enable efficient micropayments and prepaid purchase for cash based consumers (including kids/teens, as well as emerging and developing markets) and provide a mechanism to directly reward loyal customers.</descrip></descripGrp><ntig><termGrp><term id="226561">p</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918192">p</term><termNote type="geographica