Note type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2917904">çmim me avatar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34289_1991399_2917919"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A clothing item or prop associated with an avatar.</descrip></descripGrp><ntig><termGrp><term id="1991399">avatar item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2917919">artikull avatari</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34290_1991400_2917922"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person to whom a gamer has given a negative player review.</descrip></descripGrp><ntig><termGrp><term id="1991400">avoided player</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2917922">lojtar i anashkaluar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34291_1991401_2917976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An invitation to communicate with another player on Xbox Live.</descrip></descripGrp><ntig><termGrp><term id