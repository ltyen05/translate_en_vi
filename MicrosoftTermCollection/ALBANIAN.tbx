rp></ntig></langSet></termEntry><termEntry id="42885_2432491_2437026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that allows users to use ink to highlight content using their mouse, finger, or an inking tool, and whose ink resembles a traditional highlighter.</descrip></descripGrp><ntig><termGrp><term id="2432491">highlighter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2437026">theksues</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42886_2432492_2437025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To create, highlight, or erase content using ink.</descrip></descripGrp><ntig><termGrp><term id="2432492">draw</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2437025">vizato</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42887_2432493_2437028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that allows users to use ink to draw using their mouse, finger, or an inking tool, and whose ink resembles pencil graphite.</descrip></descripGrp><ntig><termGrp><term id="2432493">pencil</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2437028">lapsi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42888_2432494_2437027"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that allows users to use ink to draw using their mouse, finger, or an inking tool, and whose ink resembles traditional pen ink.</descrip></descripGrp><ntig><termGrp><term id="2432494">pen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2437027">pena</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42889_2432495_2437031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that is activated when clicked once, and when clicked a second time, opens a menu that allows the user to modify the mode of the selected tool.</descrip></descripGrp><ntig><termGrp><term id="2432495">secondary action button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2437031">butoni i veprimit dytësor</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42890_2432497_2437032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that is opened via a secondary action button and that gives users one or more options for changing the mode of the selected tool.</descrip></descripGrp><ntig><termGrp><term id="2432497">secondary action menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2437032">menuja e veprimit dytësor</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42891_2432499_2437030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An in-ribbon container that holds a collection of buttons and where the user can add additional buttons, reorganize buttons, and scroll through them when they are not all visible within the container.</descrip></descripGrp><ntig><termGrp><term id="2432499">scrollable button group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2437030">grupi i butonave të lëvizshëm</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42895_2433212_2437029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The contextual ribbon tab that appears when users select a picture.​</descrip></descripGrp><ntig><termGrp><term id="2433212">Picture</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2437029">Imazhi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammatic