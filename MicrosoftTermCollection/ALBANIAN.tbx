e type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915253">ofruesi i krijimit të sajtit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29476_1508830_2291121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Office program that you can use to organize related documents. You can check spelling, number pages consecutively across all documents in the binder, and print the documents.</descrip></descripGrp><ntig><termGrp><term id="1508830">Binder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2291121">Bashkues</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29480_1508864_1915255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contiguous piece of text or string of characters sharing the same attributes. All characters in a run have the same directional properties.</descrip></descripGrp><ntig><termGrp><term id="1508864">run</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915255">varg</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29481_1508936_1915256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reading order and alignment setting that is commonly used in controls that display text. When you select the Context setting, the reading order is determined by the first strong character (not a numeral or special character) that you type.</descrip></descripGrp><ntig><termGrp><term id="1508936">Context</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915256">Konteksti</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29483_1508938_1915257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an outline, to change a heading to body text or to a lower heading level: for example, to change from Heading 5 to Heading 6.</descrip></descripGrp><ntig><termGrp><term id="1508938">demote</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915257">ul nivelin</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29491_1509011_1639863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A demonstration of a product or service that a customer interacts with to see how features work.</descrip></descripGrp><ntig><termGrp><term id="1509011">demo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></term