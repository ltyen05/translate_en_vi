p><ntig><termGrp><term id="2364764">feature update</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2367205">përditësim i tipareve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41775_2364765_2367204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An incremental update that includes bug fixes and security issue resolutions, but no new features.</descrip></descripGrp><ntig><termGrp><term id="2364765">quality update</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2367204">përditësim i cilësisë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41776_2377731_2380460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A screen capture that you can write on, save, and share as an image. ​​​</descrip></descripGrp><ntig><termGrp><term id="2377731">screen sketch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2380460">skica e ekranit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41777_2364788_2367134"><langSet xml:lang="en-