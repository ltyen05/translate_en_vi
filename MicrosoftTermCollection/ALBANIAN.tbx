ntributes to language-related activities for Windows features.</descrip></descripGrp><ntig><termGrp><term id="2515527">Language Community</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2518561">Komuniteti gjuhësor</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44672_2515529_2518566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section in the Feedback Hub app where users can organize language-related activities for their Language community.</descrip></descripGrp><ntig><termGrp><term id="2515529">Language Community tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2518566">skeda e Komunitetit gjuhësor</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44674_2515571_2518569"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of tools that provides data-driven insights that can reduce the cost of deploying, servicing, and supporting Windows 10. It uses telemetry data to provide rich, actionable information to help assess the operational efficiency and health of Windows 10 devices in a user's environment.</descrip></descripGrp><ntig><termGrp><term id="2515571">Windows Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2518569">Windows Analytics</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44676_2515692_2517859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that generates Office 365 reports using SharePoint on-premises diagnostic and usage logs so that administrators can manage their infrastructure more efficiently.</descrip></descripGrp><ntig><termGrp><term id="2515692">SharePoint Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2517859">SharePoint Insights</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="447_51731_1186984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that lists errors that were encountered during an operation.</descrip></descripGrp><ntig><termGrp><term id="51731">error log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1186984">evidenca e gabimeve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4470_54362_480279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A format of a file, commonly indicated by its file name extension, and indicates which program the file was created in and can be opened with.</descrip></descripGrp><ntig><termGrp><term id="54362">file type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480279">tipi i skedarit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44725_2519063_2523069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business that is either small or mid-sized.</descrip></descripGrp><ntig><termGrp><term id="2519063">SMB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2523069">BVM</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44738_2519484_2523065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The preview version of Microsoft Whiteboard.</descrip></descripGrp><ntig><termGrp><term id="2519484">Microsoft Whiteboard Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2523065">Microsoft Whiteboard Preview</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44751_2520236_2523043"><l