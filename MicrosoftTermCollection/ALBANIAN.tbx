 type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2708822">Shënimi me bojë në tekst</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48016_2706915_2708819"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Message Encryption option button that surfaces different encryption and restriction options for sending emails.</descrip></descripGrp><ntig><termGrp><term id="2706915">Encryption</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2708819">Enkriptim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48017_2706916_2708820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Encryption option that ensures that an email stays encrypted if it is forwarded, but that does not place any additional restrictions on the email.</descrip></descripGrp><ntig><termGrp><term id="2706916">Encrypt-Only</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2708820">Vetëm enkripto</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48018_2706