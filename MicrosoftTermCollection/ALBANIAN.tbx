><descrip type="definition">The menu option in Sway under the “Add Content” button that analyzes the user’s Sway to suggest useful content that can be browsed or added as desired.</descrip></descripGrp><ntig><termGrp><term id="2139127">Suggested Content</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2351229">Përmbajtje e sugjeruar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37525_2139445_2351231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu option in Sway under the “Add Content” button that allows users to upload images, Word documents, or PowerPoint presentations from their computer or mobile device into their Sway.</descrip></descripGrp><ntig><termGrp><term id="2139445">Upload Content</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2351231">Ngarko përmbajtje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37527_2139460_2351225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows users to share a sway with other Sway users via social media or Docs.com, add additional authors to a sway, or generate the HTML embed code for a sway.</descrip></descripGrp><ntig><termGrp><term id="2139460">Share</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammatica