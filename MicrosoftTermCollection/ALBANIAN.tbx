36">Microsoft Office Proofing Tools</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1954391">Veglat e kontrollit gjuhësor të Microsoft Office</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32225_1718117_1915471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of controls that helps users navigate directly to where they want to go in SharePoint, without having to navigate the hierarchy or edit the URL.</descrip></descripGrp><ntig><termGrp><term id="1718117">Search-Driven Navigation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915471">Navigimi i kontrolluar nga kërkimi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32226_1641038_1915383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables subscription customers to launch Office rich client applications online from a computer on which those applications are not already installed.</descrip></descripGrp><ntig><termGrp><term id="1641038">Office on Demand</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915383">Office sipas kërkesës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32228_1641040_1915384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to edit SharePoint list content directly without opening an edit window.</descrip></descripGrp><ntig><termGrp><term id="1641040">Quick Edit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915384">Redaktimi i shpejtë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32230_1641042_1915385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An error log that contains errors and exceptions that occur when SharePoint tries to connect to external systems through Business Connectivity Services. It can be retrieved by tenant administrators.</descrip></descripGrp><ntig><termGrp><term id="1641042">tenant-level external data log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915385">evidenca e të dhënave të jashtme në nivelin e qiramarrësit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32232_1641044_1915386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook calendar feature that can be enabled to display the weather forecast for a selected location.</descrip></descr