ed</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40315_2345366_2346727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Universal Windows app that allows a person to add credit cards that can be used to pay for things with their phones using NFC. The app can also be used to save loyalty cards, coupons, boarding passes, and event tickets.</descrip></descripGrp><ntig><termGrp><term id="2345366">Microsoft Wallet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2346727">Portofoli</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40315_2354807_2346727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Universal Windows app that allows a person to add credit cards that can be used to pay for things with their phones using NFC. The app can also be used to save loyalty cards, coupons, boarding passes, and event tickets.</descrip></descripGrp><ntig><termGrp><term id="2354807">Wallet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2346727">Portofoli</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40340_2345583_2350129"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The functionality that translates the drawing speed of an object on a touch-screen device into thickness of the line on the screen--the higher the speed, the thicker the line.</descrip></descripGrp><ntig><termGrp><term id="2345583">Velocity Ink</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2350129">Boja e shpejtësisë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40341_2345591_2346726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark a location on a map by interacting directly with the map, instead of searching for an address or place name.</descrip></descripGrp><ntig><termGrp><term id="2345591">drop a pin</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2346726">vë një pineskë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40342_2345592_2346725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location marker that users can manually add to a map, so they can see it on the map and get additional location info and directions.</descrip></descripGrp><ntig><termGrp><term id="2345592">pin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2346725">pineskë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="g