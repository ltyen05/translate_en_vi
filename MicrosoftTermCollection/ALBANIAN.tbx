rmNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1187023">tasti i kontrollit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3715_39387_1187024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key that, when pressed in combination with another key, gives the other key an alternative meaning.</descrip></descripGrp><ntig><termGrp><term id="39387">CTRL key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1187024">tasti CTRL</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3715_39387_480151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key that, when pressed in combination with another key, gives the other key an alternative meaning.</descrip></descripGrp><ntig><termGrp><term id="39387">CTRL key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480151">CTRL</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37240_2113073_2169983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transient, contextual UI element that appears near to the user’s focus and appears as an ellipsis within a square.</descrip></descripGrp><ntig><termGrp><term id="2113073">Mini Toolbar Indicator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2169983">treguesi i shiritit të vogël të veglave</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37242_2113075_2170028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A callout in a UI that contains help information for a new feature, is context-sensitive, and contains information in the form of text, graphics, or animations.</descrip></descripGrp><ntig><termGrp><term id="2113075">Teaching callout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2170028">shpjegim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37244_2113077_2169984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter in the context of a particular channel that shows only the videos uploaded or owned by the user who is currently logged in.</descrip></descripGrp><ntig><termGrp><term id="2113077">My videos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2169984">videot e mia</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37249_2113090_2214677"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user account and associated credentials that is used to access Microsoft’s and 3rd parties’ business services, such as Office 365. Work or school accounts are usually assigned to end users by their organization (work, school, non-profit) and managed by the admin. However, some business services like Yammer support work or school accounts that were created by end users, without IT involvement. We sometimes refer to these accounts as “viral” AAD accounts but we don’t use this term externally. Work or school accounts are stored in Azure Active Directory (AAD) and managed by Microsoft on behalf of the organization. One of the key difference with a Microsoft account is that users don’t own the account and will typically loose access to it if they leave the organization. Other aspects like password policies are imposed by admins.</descrip></descripGrp><ntig><termGrp><term id="2113090">work or school account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2214677">llogaria e punës ose e shkollës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37250_2113091_2214675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user account and associated credentials that is used to access Microsoft’s and 3rd parties’ business services, such as Office 365. Work or school accounts are usually assigned to end users by their organization (work, school, non-profit) and managed by the admin. However, some business services like Yammer support work or school accounts that were created by end users, without IT involvement. We sometimes refer to these accounts as “viral” AAD accounts but we don’t use this term externally. Work or school accounts are stored in Azure Active Directory (AAD) and managed by Microsoft on behalf of the organization. One of the key difference with a Microsoft account is that users don’t own the account and will typically loose access to it if they leave the organization. Other aspects like password policies are imposed by admins.</descrip></descripGrp><ntig><termGrp><term id="2113091">work account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2214675">llogaria e punës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37255_2113318_2182459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Terminal Services session.</descrip></descripGrp><ntig><termGrp><term id="2113318">TS session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2182459">sesion i Shërbimeve terminale</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37255_2113319_2182459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Terminal Services session.</descrip></descripGrp><ntig><termGrp><term id="2113319">Terminal Services session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2182459">sesion i Shërbimeve terminale</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37261_2113977_2180695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that takes the user to the previous item or page.</descrip></descripGrp><ntig><termGrp><term id="2113977">Back button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2180695">butoni Prapa</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37262_2113979_2181481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button pressed to update displayed information with current data.</descrip></descripGrp><ntig><termGrp><term id="2113979">Refresh button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2181481">butoni Fresko</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37264_2113981_2176900"><langSet xml:lang="en-US"><descripGrp><descrip type="