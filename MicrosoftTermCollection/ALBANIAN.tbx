"en-US"><descripGrp><descrip type="definition">A grouping of dimension members or items from a data source that are named and treated as a single unit and can be referenced or reused multiple times.</descrip></descripGrp><ntig><termGrp><term id="530462">named set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915158">bashkësi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12505_131084_480741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a graphical user interface such as Windows, a pattern or picture in the screen background that can be chosen by the user.</descrip></descripGrp><ntig><termGrp><term id="131084">wallpaper</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480741">letra e murit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1251_52930_480268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation of printed paper where the printed side is against a surface. For example, paper is face down when it is placed in a copier with the printed side against the copying surface.</descrip></descripGrp><ntig><termGrp><term id="52930">face down</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480268">faqe kokëposhtë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12520_1296_479836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the TCP/IP suite of protocols, used to copy files between two computers on the Internet. Both computers must support their respective FTP roles: one must be an FTP client and the other an FTP server.</descrip></descripGrp><ntig><termGrp><term id="1296">File Transfer Protocol</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="479836">Protokolli i transferimit të skedarëve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12520_1296_479837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the TCP/IP suite of protocols, used to copy files between two computers on the Internet. Both computers must support their respective FTP roles: one must be an FTP client and the other an FTP server.</descrip></descripGrp><ntig><termGrp><term id="1296">File Transfer Protocol</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="479837">FTP</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12520_1297_479836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the TCP/IP suite of protocols, used to copy files between two computers on the Internet. Both computers must support their respective FTP roles: one must be an FTP client and the other an FTP server.</descrip></descripGrp><ntig><termGrp><term id="1297">FTP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="479836">Protokolli i transferimit të skedarëve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12520_1297_479837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the TCP/IP suite of protocols, used to copy files between two computers on the Internet. Both computers must support their respective FTP roles: one must be an FTP client and the other an FTP server.</descrip></descripGrp><ntig><termGrp><term id="1297">FTP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="479837">FTP</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12524_73352_1187128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of binaries that can be installed on top of the core product and enables users to select a preferred language so that the user interface and Help files appear in that preferred language.</descrip></descripGrp><ntig><termGrp><term id="73352">language pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1187128">paketa e gjuhës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12530_262704_481319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common programming interface to the lower-level system area network (SAN) implementations, developed by Microsoft. WSD sits underneath the standard WinSock application programming interface (API), but bypasses the kernel networking layers to talk directly to the SAN hardware. Because WSD sits underneath the existing WinSock API, IT departments can deploy applications in a SAN environment without modifying the applications.</descrip></descripGrp><ntig><termGrp><term id="262704">WinSock direct</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481319">WinSock i drejtpërdrejtë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12530_262704_481320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common programming interface to the lower-level system area network (SAN) implementations, developed by Microsoft. WSD sits underneath the standard WinSock application programming interface (API), but bypasses the kernel networking layers to talk directly to the SAN hardware. Because WSD sits underneath the existing WinSock API, IT departments can deploy applications in a SAN environment without modifying the applications.</descrip></descripGrp><ntig><termGrp><term id="262704">WinSock direct</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481320">WSD</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12530_262705_481319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common programming interface to the lower-level system area network (SAN) implementations, developed by Microsoft. WSD sits underneath the standard WinSock application programming interface (API), but bypasses the kernel networking layers to talk directly to the SAN hardware. Because WSD sits underneath the existing WinSock API, IT departments can deploy applications in a SAN environment without modifying the applications.</descrip></descripGrp><ntig><termGrp><term id="262705">WSD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481319">WinSock i drejtpërdrejtë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12530_262705_481320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common programming interface to the lower-level system area network (SAN) implementations, developed by Microsoft. WSD sits underneath the standard WinSock application programming interface (API), but bypasses the kernel networking layers to talk directly to the SAN hardware. Because WSD sits underneath the existing WinSock API, IT departments can deploy applications in a SAN environment without modifying the applications.</descrip></descripGrp><ntig><termGrp><term id="262705">WSD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481320">WSD</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12531_232862_1188487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of files, managed by a manifest.xml file, that add functionality to a Microsoft Office Word or Microsoft Office Excel document by specifying custom display or actions.</descrip></descripGrp><ntig><termGrp><term id="232862">XML expansion pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188487">paketa e zgjerimit XML</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12537_95084_480568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of declarations and statements that are executed as a unit.</descrip></descripGrp><ntig><termGrp><term id="95084">procedure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480568">procedurë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote>