ition">A certificate that has been cancelled by a certificate authority (CA) and is no longer valid.</descrip></descripGrp><ntig><termGrp><term id="651267">revoked certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915016">certifikatë e revokuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18926_651277_1463824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A representation of the communication path between actors.</descrip></descripGrp><ntig><termGrp><term id="651277">binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1463824">lidhje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18927_651278_1915017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A default flag that is assigned to an item when you click the Flag Status column in your Inbox or other table view. You set the default time, date, or other criteria for the flag from the Follow Up menu.</descrip></descripGrp><ntig><termGrp><term id="651278">Quick Click flag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915017">flamuri i klikimit të shpejtë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18936_651287_2629712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business application that provides private, customizable websites that allow users to collaborate on projects and documents anyone to whom you grant permission.</descrip></descripGrp><ntig><termGrp><term id="651287">workspace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2629712">hapësira e punës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1894_234827_1186995"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows that checks for problems associated with network connections.</descrip></descripGrp><ntig><termGrp><term id="234827">Diagnostics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1186995">Diagnostikime</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1894_234827_481242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows that checks for problems associated with network connections.</descrip></descripGrp><ntig><termGrp><term id="234827">Diagnostics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalN