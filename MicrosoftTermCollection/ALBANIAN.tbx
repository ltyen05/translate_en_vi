ntig></langSet></termEntry><termEntry id="141_89979_480521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard key (often labeled "PgDn") that is often used to move the cursor down to the top of the next page or a specific number of lines. Its function may vary in different programs.</descrip></descripGrp><ntig><termGrp><term id="89979">PAGE DOWN key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480521">tasti FAQE POSHTË</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14101_334507_1834841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The User Interface (UI) element that initiates the process of accepting an incoming telephone call.</descrip></descripGrp><ntig><termGrp><term id="334507">answer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1834841">përgjigjem</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14106_234578_1914911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A room, computer, or any equipment needed at a meeting.</descrip></descripGrp><ntig><termGrp><term id="234578">resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914911">burim</term><termNote typ