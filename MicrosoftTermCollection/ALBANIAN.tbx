rches through on-premises file shares and SharePoint document libraries and folders for sensitive items that meet the criteria of a data loss prevention policy.</descrip></descripGrp><ntig><termGrp><term id="2956708">scanner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998215">skaner</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52731_2956709_2998185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To calculate the derivative, or rate of change, or a function.</descrip></descripGrp><ntig><termGrp><term id="2956709">differentiate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998185">diferencoj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52732_2956710_2998182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To multiply on the left by one element and on the right by its inverse.</descrip></descripGrp><ntig><termGrp><term id="2956710">conjugate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998182">zgjedhoj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52733_2956711_2998212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Denoting different kinds of mutual relation, often with reference to the substitution of reciprocals for given quantities.</descrip></descripGrp><ntig><termGrp><term id="2956711">reciprocal</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998212">reciprok</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52734_2956714_2998202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To subject to the operation of finding the integral of a function.</descrip></descripGrp><ntig><termGrp><term id="2956714">Integrate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998202">integroj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52735_2956715_2998196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The largest positive integer that is a factor/divisor of each of a given set of integers.</descrip></descripGrp><ntig><termGrp><term id="2956715">greatest common factor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998196">faktori më i madh i përbashkët</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52736_2956716_2998213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of a number or expression, a number which, when raised to a specified power, yields the specified number or expression.</descrip></descripGrp><ntig><termGrp><term id="2956716">root</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998213">rrënjë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52737_2956717_2998223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An expression consisting of three terms.</descrip></descripGrp><ntig><termGrp><term id="2956717">trinomial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998223">trinom</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52738_2956718_2998207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A polynomial equation of the second degree.</descrip></descripGrp><ntig><termGrp><term id="2956718">quadratic equation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998207">ekuacion kuadrati</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52739_2956719_2998201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A multiplicative factor consisting of a whole number.</descrip></descripGrp><ntig><termGrp><term id="2956719">Integer coefficient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998201">koeficient numri të plotë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5274_168784_480968"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To go back to a previous state by reversing the effects of one or more commands.</descrip></descripGrp><ntig><termGrp><term id="168784">undo</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480968">zhbëj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52741_2956721_2998211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solution that is a rational number, that is any number that can be represented in the form of p/q where q=/=0.</descrip></descripGrp><ntig><termGrp><term id="2956721">rational solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998211">zgjidhje racionale</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52742_2956722_2998184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scalar value that is a function of the entries of a square matrix.</descrip></descripGrp><ntig><termGrp><term id="2956722">determinant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998184">përcaktor</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52743_2956723_2998200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statement that of two quantities one is specifically less than or greater than another.</descrip></descripGrp><ntig><termGrp><term id="2956723">inequality</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998200">mosbarazim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52744_2956724_2998221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The replacement of the variables in an algebraic expression by their values in terms of another set of variables.</descrip></descripGrp><ntig><termGrp><term id="2956724">transformation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998221">shndërrim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52745_2956725_2998178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The derived function of a function.</descrip></descripGrp><ntig><termGrp><term id="2956725">derivative</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998178">derivat</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52746_2956726_2998203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The coordinate of the point at which a curve intersects an axis.</descrip></descripGrp><ntig><termGrp><term id="2956726">intercept</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998203">interceptoj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52747_2956727_2998183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a right triangle, the reciprocal of the sine of an angle.</descrip></descripGrp><ntig><termGrp><term id="2956727">cosecant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998183">kosekante</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52748_2956728_2998187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disjunction which is true if only one, but not both, of its disjuncts is true.</descrip></descripGrp><ntig><termGrp><term id="2956728">exclusive disjunction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998187">shkëputje ekskluzive</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52749_2956729_2998217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The symbol of the trigonometric function tangent.</descrip></descripGrp><ntig><termGrp><term id="2956729">tan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998217">tan</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52750_2956730_2998194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To show what part of the number line contains values that will “satisfy” the given inequality.</descrip></descripGrp><ntig><termGrp><term id="2956730">Graph Inequality</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998194">paraqes mosbarazimin në grafik</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52751_2956731_2998205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of a function, the state of either never decreasing or never increasing as its independent variable increases.</descrip></descripGrp><ntig><termGrp><term id="2956731">Monotonicity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998205">monotonicitet</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52752_2956732_2998199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A complex number, usually denoted with i, that is defined by i2=-1.</descrip></descripGrp><ntig><termGrp><term id="2956732">imaginary unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998199">njësi imagjinare</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52753_2956733_2998198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of a complex number a+bi, where a and b are real numbers, the value b.</descrip></descripGrp><ntig><termGrp><term id="2956733">imaginary part</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998198">pjesë imagjinare</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52754_2956734_2998177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function whose derivative is a given function, an indefinite integral.</descrip></descripGrp><ntig><termGrp><term id="2956734">antiderivative</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998177">kundërderivat</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52755_2956735_2998206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identity that expresses the Pythagorean theorem in terms of trigonometric functions.</descrip></descripGrp><ntig><termGrp><term id="2956735">Pythagorean Identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998206">identitet pitagorean</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52756_2956736_2998214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mnemonic device for computing the determinant of a 3x3 matrix named after the French mathematician Pierre Frédéric Sarrus.</descrip></descripGrp><ntig><termGrp><term id="2956736">Sarrus' Rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998214">rregulli i Sarusë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52757_2956737_2998220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For a polynomial sorted by degree, the last monomial term.</descrip></descripGrp><ntig><termGrp><term id="2956737">trailing term</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998220">kufizë fundore</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52758_2956738_2998188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way of representing repeated multiplications of the same number by writing the number as a base with the number of repeats written as a small number to its upper right.</descrip></descripGrp><ntig><termGrp><term id="2956738">exponential form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998188">formë eksponenciale</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52759_2956739_2998209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mathematical root expressed with a radical sign, generally a square root or cube root.</descrip></descripGrp><ntig><termGrp><term id="2956739">radical form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998209">forma e rrënjës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52760_2956740_2998204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability that gives the user instantaneous access to a device by using a remote shell connection, granting them the power to do in-depth investigative work and take immediate response actions to promptly contain identified threats in real time.</descrip></descripGrp><ntig><termGrp><term id="2956740">Live Response</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998204">përgjigje në kohë reale</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52773_2997773_2997778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Information Excel function that returns TRUE if the value is any error value.</descrip></descripGrp><ntig><termGrp><term id="2997773">ISERROR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2997778">ISERROR</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52774_2997860_2999455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Edge that allows the user to keep track of their ideas on the web by adding pages, images, links, or text to a nameable collection that can be saved and synced across signed-in devices.</descrip></descripGrp><ntig><termGrp><term id="2997860">Collections</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2999455">Koleksione</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52775_2997861_2999454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of pages, notes, images, or other content saved by the user in the Collections feature in Microsoft Edge.</descrip></descripGrp><ntig><termGrp><term id="2997861">collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2999454">koleksion</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52776_2997862_2999466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">SDK for developers to leverage features and capabilities that are part of the core OS code.</descrip></descripGrp><ntig><termGrp><term id="2997862">Windows Platform SDK</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2999466">Platforma SDK e Windows</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52777_2997863_2999465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">SDK for developers to leverage features and capabilities that have been decoupled from the core OS code.</descrip></descripGrp><ntig><termGrp><term id="2997863">Windows App SDK</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2999465">Windows SDK për aplikacione</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig