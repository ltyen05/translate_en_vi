 is expected to complete.</descrip></descripGrp><ntig><termGrp><term id="1618161">assignment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915277">detyrë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31729_2672149_1915277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of work that a student is expected to complete.</descrip></descripGrp><ntig><termGrp><term id="2672149">lab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915277">detyrë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3173_10708_479942"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule or procedure for solving a problem.</descrip></descripGrp><ntig><termGrp><term id="10708">algorithm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="479942">algoritëm</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31731_1618171_1915278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who is responsible for teaching a class.</descrip></descripGrp><ntig><termGrp><term id="1618171">educator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915278">mësues</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31732_1618173_1915279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric or non-numeric score that represents a student's performance on an assignment.</descrip></descripGrp><ntig><termGrp><term id="1618173">grade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915279">vlerësimi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31733_1618200_1915280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A worksheet that contains the collection of grades for all students enrolled in a particular class.</descrip></descripGrp><ntig><termGrp><term id="1618200">Gradebook</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915280">Regjistri i vlerësimeve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31734_1618201_1915281"><langSet xml:l