managing data in relational database systems.</descrip></descripGrp><ntig><termGrp><term id="115736">Structured Query Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480650">Gjuha e pyetësorit e strukturuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11991_39848_480157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To duplicate data and reproduce it in another part of a document, in a different file or memory location, or in a different medium.</descrip></descripGrp><ntig><termGrp><term id="39848">copy</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480157">kopjoj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11997_214868_481086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Tiny Japanese kana characters written above or next to kanji characters. The kana characters indicate the correct pronunciation of the word written in kanji.</descrip></descripGrp><ntig><termGrp><term id="214868">furigana</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481086">furigana</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11999_233421_1187120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory that you can use to store names, email addresses, fax numbers, and distribution lists.</descrip></descripGrp><ntig><termGrp><term id="233421">Address Book</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1187120">Kontaktet e Windows</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11999_233421_481147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory that you can use to store names, email addresses, fax numbers, and distribution lists.</descrip></descripGrp><ntig><termGrp><term id="233421">Address Book</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481147">Libri i adresave</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11999_347906_1187120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory that you can use to store names, email addresses, fax numbers, and distribution lists.</descrip></descripGrp><ntig><termGrp><term id="347906">Windows Contacts</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang