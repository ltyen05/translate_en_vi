p><term id="1915146">para ngjarjes</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24106_1098540_1915146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A synchronous event whose handler runs completely before the action that raised the event starts.</descrip></descripGrp><ntig><termGrp><term id="1098540">pre-event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915146">para ngjarjes</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24108_1098542_1475096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A script-based applet that is stored as a favorite or bookmark in a web browser, or is accessed through a hyperlink on a webpage.</descrip></descripGrp><ntig><termGrp><term id="1098542">bookmarklet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1475096">programthi i faqeshenjuesit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24124_1098902_2687370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transfer of certain properties, such as open files, from a parent program or process to another program or process that the parent causes to run.</descrip></descripGrp><ntig><termGrp><term id="1098902">inheritance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2687370">trashëgim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24138_1098950_1945258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the form where a user can report violations of the terms of use. Contextually, it's understood that the abuse in question is poor conduct, such as obscene language or threats.</descrip></descripGrp><ntig><termGrp><term id="1098950">Report Abuse</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1945258">Raporto abuzimin</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24139_1098951_2917992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Rules that explain how someone should behave while using a service or product.</descrip></descripGrp><ntig><termGrp><term id="1098951">code of conduct</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2917992">kod i sjelljes</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote