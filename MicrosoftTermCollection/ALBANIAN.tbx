scripGrp><descrip type="definition">In Microsoft 365 scores, a recommendation based on data from your organization, which, if completed, results directly or indirectly in points earned to improve your score. This can be a direct action like changing a setting, or an indirect action like providing training to users that encourages them to use a feature more.</descrip></descripGrp><ntig><termGrp><term id="2819449">recommendation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821305">rekomandim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49869_2819450_2821242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Status of a Microsoft Managed Desktop device if it meets all of these criteria: synced with Intune in the last 5 days AND at least 6 hours powered on and connected to Internet AND at least 2 hours continuously powered on and connected to Internet.</descrip></descripGrp><ntig><termGrp><term id="2819450">active</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821242">aktiv</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49870_2819451_2821248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A minimum or starting point used for comparisons.</descrip></descripGrp><ntig><termGrp><term id="2819451">baseline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821248">vijë bazë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49871_2819453_2821311"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A summary page in Microsoft 365 admin center showing all scores for your organization side by side.</descrip></descripGrp><ntig><termGrp><term id="2819453">score overview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821311">përmbledhje e pikëve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49872_2819454_2821310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subcategory within a larger score such as Security Score, Compliance Score, Productivity Score, or User Experience Score.</descrip></descripGrp><ntig><termGrp><term id="2819454">score category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821310">kategoria e pikëve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49873_2819455_2821255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard or point of reference against which things may be compared or assessed.</descrip></descripGrp><ntig><termGrp><term id="2819455">benchmark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821255">pikë referimi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49874_2819456_2821308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Percentage of points achieved out of total points achievable. Based on measured data about your organization and/or known actions your organization has taken to improve on a particular outcome for your organization.</descrip></descripGrp><ntig><termGrp><term id="2819456">score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821308">pikët</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49875_2819457_2821292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Status of a Microsoft Managed Desktop device that has not synced with Intune in the last 28 days (or more).</descrip></descripGrp><ntig><termGrp><term id="2819457">out of sync</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2821292">nuk po sinkronizohet</term><termNote type="geographicalUsage">ALB</termNote