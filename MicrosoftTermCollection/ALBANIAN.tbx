.</descrip></descripGrp><ntig><termGrp><term id="2071245">Windows Embedded 8 Handheld</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081921">Windows Embedded 8 Handheld</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36786_2071246_2081899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predetermined text reply that can be automatically sent in response to incoming calls, text messages, or both when Driving Mode is turned on. The text reply is sent with no action on the part of the user.</descrip></descripGrp><ntig><termGrp><term id="2071246">text reply</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081899">përgjigje me sms</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36787_2071247_2081900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A response to an incoming call using a text message when the caller is a contact calling from a mobile phone.</descrip></descripGrp><ntig><termGrp><term id="2071247">text reply</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081900">përgjigje me sms</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36790_2071376_2081890"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera option to capture just one image when the user presses the camera button.</descrip></descripGrp><ntig><termGrp><term id="2071376">single photo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081890">shkrepje teke</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36791_2071377_2081892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo you can choose to use as the background for some Live Tiles on the Start screen.</descrip></descripGrp><ntig><termGrp><term id="2071377">Start background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081892">sfondi i Nisjes</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36792_2071378_2081914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Phone feature to upgrade a phone call into a Skype video call.</descrip></descripGrp><ntig><termGrp><term id="2071378">video upgrade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081914">thirrje video</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36793_2071379_2081920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual setting that enables app screen content to display in a window.</descrip></descripGrp><ntig><termGrp><term id="2071379">windowed mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081920">modaliteti në dritare</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36794_2071380_2081862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual setting that is similar to “stretch” - the resolution of the phone screen is refitted to fill as much of the external screen as possible without compromising its dimensionality.</descrip></descripGrp><ntig><termGrp><term id="2071380">expanded screen mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081862">modaliteti i ekranit të zgjeruar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36795_2071381_2081882"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows desktop application that is required to enable users to project their phone screen to a Windows device using a USB connection.</descrip></descripGrp><ntig><termGrp><term id="2071381">Project My Screen App</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081882">Aplikacioni Projekto ekranin tim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2072311_2085509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2072311">Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2085509">Grupet</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2072311_2383407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across app