ech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3137858">turbullim sfondi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50047_2849656_2834318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect applied to the background of a design, image or video call where the background is obscured but the speaker's image remains clear.</descrip></descripGrp><ntig><termGrp><term id="2849656">background blur</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2834318">mjegullim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50047_2849656_3137858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect applied to the background of a design, image or video call where the background is obscured but the speaker's image remains clear.</descrip></descripGrp><ntig><termGrp><term id="2849656">background blur</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3137858">turbullim sfondi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50078_2834844_2953232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode used when you are giving a presentation that unmutes your microphone for the duration of the presentation.</descrip></descripGrp><ntig><termGrp><term id="2834844">presenter mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2953232">modalitet prezantimi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5008_139790_1914759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A modal, custom pop-up form that asks users for additional information or to display a message.</descrip></descripGrp><ntig><termGrp><term id="139790">custom dialog box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914759">kuti dialogimi e përshtatur</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50089_2834942_2835206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Outlook for mobile that helps users listen, triage and reply to emails while on the go (such as when travelling in a car).</descrip></descripGrp><ntig><termGrp><term id="2834942">Play My Emails</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2835206">Lexo emailet e mia</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50090_2834944_2835200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Excel for the web that enables users to create, run and record automated scripts in Excel and use them across platforms. By creating an Office Script, users can create background tasks that run automatically in the cloud and update their spreadsheet automatically, enabling information to continuously be up-to-date with no action required on the user's part. This helps users to run their businesses more efficiently anytime and anywhere - without needed coding knowledge.</descrip></descripGrp><ntig><termGrp><term id="2834944">Office Scripts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2835200">Skriptet e Office</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50091_2834946_2835102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Set of audit features and capabilities offered within our Microsoft 365 E3 SKU. These include providing audit logs of high-level events to help compliance reporting needs and additional features from new non-Office 365 products such as Microsoft Defender Advanced Threat Protection.</descrip></descripGrp><ntig><termGrp><term id="2834946">Audit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2835102">Auditi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50092_2834947_2835104"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template within Advanced eDiscovery that enables compliance officers to monitor communications for certain roles within the organization, making it easier to meet regulatory requirements or internal policies.</descrip></descripGrp><ntig><termGrp><term id="2834947">Communication compliance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2835104">Pajtueshmëria e komunikimeve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50093_2834948_2835103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 feature that calls out a person’s most important to-dos and consolidates them in one convenient email to help the person better prepare for the day ahead (or specific part of the day/week depending on the settings for receiving email).</descrip></descripGrp><ntig><termGrp><term id="2834948">Briefing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2835103">Përmbledhje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50094_2834949_2835107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft Teams, a digital bulletin board where you can pin notes, ideas, and inspiration to share in your team space.</descrip></descripGrp><ntig><termGrp><term id="2834949">Corkboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2835107">Tabela e shënimeve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50095_2834950_2835204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that work across tenant (and hybrid) boundaries, including cross-tenant people search, cross-tenant identity and data migration and data migration to/from on-premises deployments.</descrip></descripGrp><ntig><termGrp><term id="2834950">Organization Relationships</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2835204">Marrëdhëniet e organizatës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50096_2834951_2836370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An offering/program that gives end users the ability to get the full Microsoft Teams experience that their company may already have for other licensed users in their organization.</descrip></descripGrp><ntig><termGrp><term id="2834951">Microsoft Teams Exploratory</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2836370">Microsoft Teams Exploratory</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50097_2834952_2835108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within the Microsoft 365 security portfolio that helps prevent inappropriate or accidental copying or sharing of sensitive information that lives on endpoints (i.e. devices, specifically Windows 10 devices).</descrip></descripGrp><ntig><termGrp><term id="2834952">Endpoint Data Loss Prevention</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2835108">Parandalimi i humbjes së të dhënave të pikës përfundimtare</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50098_2834953_2835213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within Microsoft Outlook and Microsoft Teams that helps users quickly close the loop on an e-mail, either by sending a quick response or by taking a suggested action, such as scheduling a meeting, creating a task, sending a file etc.</descrip></descripGrp><ntig><termGrp><term id="2834953">Suggested Actions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2835213">Veprimet e sugjeruara</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50099_2834954_2835199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device-based license of Office 365 that will allow commercial IT admins to assign an Office 365 ProPlus license to a device rather than to a user with an AAD identity. This solution provides a device-based subscription model that mirrors the user-based subscription model in ease of management and sign-in.</descrip></descripGrp><ntig><termGrp><term id="2834954">Office 365 ProPlus (device)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2835199">Office 365 ProPlus (pajisje)</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="501_140730_1914763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The range of cells that you select to hold the summarized data in a consolidation. The destination area can be on the same worksheet as the source data or on a different worksheet. A worksheet can contain only one consolidation.</descrip></descripGrp><ntig><termGrp><term id="140730">destination area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914763">zona e vendmbërritjes</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50100_2834955_2835207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within Microsoft Teams that helps a teacher make a Reading Assignment, lets the student record themselves reading, and then submit to the teacher for miscue analysis. Additionally, the computer will “listen” to the person read, and then gives computer generated “miscue analysis” feedback automatically to the teacher.</descrip></descripGrp><ntig><termGrp><term id="2834955">Reading Progress</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2835207">Progresi i leximit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50101_2834956_2835211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of a podcast that will provide stories and advice from experts in the trenches, and give listeners access to the best of security analytics, security personalities, and security researchers.</descrip></descripGrp><ntig><termGrp><term id="2834956">Security Unlocked</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2835211">Siguria e zhbllokuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834957_2835099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834957">MSIX app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2835099">bashkëngjitje e aplikacioneve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834957_2836371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834957">MSIX app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2836371">bashkëngjitje e aplikacioneve MSIX</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834958_2835099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834958">app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2835099">bashkëngjitje e aplikacioneve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834958_2836371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834958">app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2836371">bashkëngjitje e aplikacioneve MSIX</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50103_2834961_2835109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service offering that enables enterprise customers to become the controller (GDPR) for Windows diagnostic data collected from devices enrolled under this service. With this service, data will be governed by Microsoft’s Online Services Terms, and stored in a high compliance boundary, separate from Windows diagnostic data that Microsoft collects as controller.</descrip></descripGrp><ntig><termGrp><term id="2834961">Enterprise Data Processor Service for Windows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2835109">Shërbimi i përpunimit të të dhënave të ndërmarrjes për Windows</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50105_2834963_2835209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 feature that detects when a reply-all or conversation mail storm is brewing in your mail service and temporarily blocks subsequent reply-alls to the thread while issuing a bounce back message (NDR) to the sender who is attempting to reply all. After a "cool down" period (e.g. 2 to 4 hours), the feature will remove the block and allow emails on the thread again (some exceptions can be made during the cool down).</descrip></descripGrp><ntig><termGrp><term id="2834963">Reply-All Storm Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2835209">Mbrojtje ndaj përgjigjjes së të gjithëve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50115_2835484_2836459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page in the Office 365 Security &amp; Compliance Center where the user can turn on audit logging and search the unified audit log to view user and administrator activity in the Office 365 organization.</descrip></descripGrp><ntig><termGrp><term id="2835484">Audit log search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2836459">Kërkimi i evidencave të auditit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50116_2835485_2836465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To tap a device screen twice and on the second tap, hold one's finger or stylus in place.</descrip></descripGrp><ntig><termGrp><term id="2835485">double tap and hold</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2836465">trokit dy herë dhe mbaj të shtypur</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50117_2835490_2836497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A regular telephone number meant for a single user to receive and place calls. User numbers can be assigned to any PSTN Calling user.</descrip></descripGrp><ntig><termGrp><term id="2835490">user number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2836497">numri i përdoruesit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50118_2835492_2836488"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype telephone number that is used for audio conferencing, auto attendants, or a call queue</descrip></descripGrp><ntig><termGrp><term id="2835492">service number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2836488">numri i shërbimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50122_2835501_2836482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Chat running during the meeting and related to the meeting topic.</descrip></descripGrp><ntig><termGrp><term id="2835501">meeting chat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2836482">biseda e takimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835509_2836468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835509">emergency location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2836468">vendndodhja e urgjencës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun<