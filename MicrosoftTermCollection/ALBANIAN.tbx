q"><ntig><termGrp><term id="481688">format</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9459_67998_480359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A natural number, zero, or the negative of a natural number.</descrip></descripGrp><ntig><termGrp><term id="67998">integer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480359">numër i plotë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9464_126524_2918320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A narrow, rectangular connection point on a computer or other device (such as a keyboard) where you can connect a universal serial bus (USB) device.</descrip></descripGrp><ntig><termGrp><term id="126524">USB port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918320">fole USB</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9466_3739_1187090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transfer a copy of a file from a local computer to a remote computer by means of a modem or network.</descrip></descripGrp><ntig><termGrp><term id="3739">upload</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1187090">ngarkoj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9468_297006_481425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computer games, an additional score or points given for efficient play.</descrip></descripGrp><ntig><termGrp><term id="297006">efficiency bonus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481425">shpërblimi i efikasitetit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="947_233127_1914909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agreement between a service provider and a customer that specifies the amount and type of service the provider will deliver.</descrip></descripGrp><ntig><termGrp><term id="233127">service agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914909">marrëveshja e shërbimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9478_138885_2086915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The horizontal bar at the top of a column. You can click a column selector to select an entire column in the query design grid or the filter design grid.</descrip></descripGrp><ntig><termGrp><term id="138885">column selector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2086915">përzgjedhësi i kolonës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9481_85612_2515040"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, the set of symbols and formats used to describe the elements of programming, mathematics, or a scientific field. A language's syntax is defined in part by notation.</descrip></descripGrp><ntig><termGrp><term id="85612">notation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2515040">simbolet</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9483_55065_2418436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change the orientation of a selected object horizontally, vertically, or in both directions.</descrip></descripGrp><ntig><termGrp><term id="55065">flip</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2418436">përmbys</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9488_115096_1914718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that is not found on your keyboard and must be inserted from within the software or by pressing a combination of keys on your keyboard.</descrip></descripGrp><ntig><termGrp><term id="115096">special character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914718">karakter i veçantë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9502_307442_2291359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The prefix that is used to access an outside line. In the United States, this prefix is typically 9.</descrip></descripGrp><ntig><termGrp><term id="307442">outside line access code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2291359">kodi i qasjes së linjës së jashtme</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9509_80732_480457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move files or data from one software product, format, or protocol, to another.</descrip></descripGrp><ntig><termGrp><term id="80732">migrate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480457">migroj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9510_162790_2723669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An experience that is presented to end users the first time they start a new computer.</descrip></descripGrp><ntig><termGrp><term id="162790">first-run experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2723669">përvoja e ekzekutimit të parë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9510_214541_2723669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An experience that is presented to end users the first time they start a new computer.</descrip></descripGrp><ntig><termGrp><term id="214541">out-of-box experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2723669">përvoja e ekzekutimit të parë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9510_214542_2723669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An experience that is presented to end users the first time they start a new computer.</descrip></descripGrp><ntig><termGrp><term id="214542">OOBE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2723669">përvoja e ekzekutimit të parë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9510_2713702_2723669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An experience that is presented to end users the first time they start a new computer.</descrip></descripGrp><ntig><termGrp><term id="2713702">FRE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2723669">përvoja e ekzekutimit të parë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9513_58732_480303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical representation of either a character, a part of a character, or a sequence of characters.</descrip></descripGrp><ntig><termGrp><term id="58732">glyph</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480303">glif</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9517_156998_1187091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change to an older, and/or less powerful or sophisticated version of a product.</descrip></descripGrp><ntig><termGrp><term id="156998">downgrade</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1187091">ul një nivel</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="952_318124_480128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To translate all the source code of a program from a high-level language into object code prior to execution of the program.</descrip></descripGrp><ntig><termGrp><term id="318124">build</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480128">kompiloj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="952_318124_481578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To translate all the source code of a program from a high-level language into object code prior to execution of the program.</descrip></descripGrp><ntig><termGrp><term id="318124">build</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481578">ndërtoj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="952_36555_480128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To translate all the source code of a program from a high-level language into object code prior to execution of the program.</descrip></descripGrp><ntig><termGrp><term id="36555">compile</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480128">kompiloj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="952_36555_481578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To translate all the source code of a program from a high-level language into object code prior to execution of the program.</descrip></descripGrp><ntig><termGrp><term id="36555">compile</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481578">ndërtoj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9521_253747_2709087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account provided in a local domain for a user whose regular account is not in a trusted domain. A local account cannot be used to log on interactively. Further, a local account created in one domain cannot be used in a trusted domain.</descrip></descripGrp><ntig><termGrp><term id="253747">local account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2709087">llogari lokale</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9534_258951_481263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of precision and exactness with which one entity represents another.</descrip></descripGrp><ntig><termGrp><term id="258951">fidelity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481263">përpikëri</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9536_61276_480317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For a computer system, to be in an inactive state, but not shut off. When the computer is switched back on, the desktop is restored exactly as it was.</descrip></descripGrp><ntig><termGrp><term id="61276">hibernate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480317">përgjum</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9543_415057_1914937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of a dimension whose value is calculated at run time by using an expression. Calculated member values can be derived from the values of other members.</descrip></descripGrp><ntig><termGrp><term id="415057">calculated member</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914937">anëtar i llogaritur</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9547_177819_480979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document that contains general release information and late changes. It is one of the deliverables leading to the release readiness approved milestone.</descrip></descripGrp><ntig><termGrp><term id="177819">release notes</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480979">shënimet e versionit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9552_266832_1914920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A secondary data source that is accessible to users who fill out forms offline. When a user is online, data from the data source is stored on the user’s computer so that it can appear in controls when the form is offline.</descrip></descripGrp><ntig><termGrp><term id="266832">offline data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914920">burimi i të dhënave jashtë linje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9555_139836_1188461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field you can create. A custom field can be a blank, combination, or formula field.</descrip></descripGrp><ntig><termGrp><term id="139836">custom field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188461">fushë e përshtatur</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9561_179696_480991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A selection technique that involves dragging out a bounding outline (also referred to as a marquee) to define the selected objects.</descrip></descripGrp><ntig><termGrp><term id="179696">region selection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480991">përzgjedhja e zonës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9566_323154_481700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To start or reset a computer by turning the power on, by pressing a reset button on the computer case, or by issuing a software command to restart.</descrip></descripGrp><ntig><termGrp><term id="323154">start</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481700">nis</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="957_117447_2323928"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Dialog from film or video displayed on the screen (usually at the bottom) and typically used to provide translation from a foreign language.</descrip></descripGrp><ntig><termGrp><term id="117447">subtitle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2323928">titër</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9570_3951_1914664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The engine at the core of managed code execution. The runtime supplies managed code with services such as cross-language integration, code access security, object lifetime management, and debugging and profiling support.</descrip></descripGrp><ntig><termGrp><term id="3951">common language runtime</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914664">koha e ekzekutimit të gjuhës së zakonshme</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9570_3952_1914664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The engine at the core of managed code execution. The runtime supplies managed code with services such as cross-language integration, code access security, object lifetime management, and debugging and profiling support.</descrip></descripGrp><ntig><termGrp><term id="3952">CLR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914664">koha e ekzekutimit të gjuhës së zakonshme</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9570_714923_1914664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The engine at the core of managed code execution. The runtime supplies managed code with services such as cross-language integration, code access security, object lifetime management, and debugging and profiling support.</descrip></descripGrp><ntig><termGrp><term id="714923">Common Language Runtime support</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914664">koha e ekzekutimit të gjuhës së zakonshme</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termG