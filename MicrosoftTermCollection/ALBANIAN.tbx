ype="definition">A category of objects that share a common set of characteristics.</descrip></descripGrp><ntig><termGrp><term id="86004">object class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481728">klasë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10909_127144_480719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quantity assigned to an element such as a variable, symbol, or label.</descrip></descripGrp><ntig><termGrp><term id="127144">value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480719">vlerë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10916_338545_481739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To store data in such a way that it can be retrieved later by the same security support component, and only by that security support component.</descrip></descripGrp><ntig><termGrp><term id="338545">seal</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481739">vulos</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10918_20790_2846524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To measure the performance of something according to specified standards in order to improve it.</descrip></descripGrp><ntig><termGrp><term id="20790">benchmark</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2846524">vlerëso performancën</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10928_359996_481832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A table, query, form, report, macro, or module that remains in the replica or Design Master where it was created. Neither the object nor changes to the object are copied to other members in the replica set.</descrip></descripGrp><ntig><termGrp><term id="359996">local object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481832">objekt lokal</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10934_237291_481233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that applies a read-only state to a document inside client applications.</descrip></descripGrp><ntig><termGrp><term id="237291">Mark as Final</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termG