oice commands (such as comma and period) to create punctuation in their document.</descrip></descripGrp><ntig><termGrp><term id="2505358">Manual Punctuation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2506074">Manual Punctuation</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44538_2505363_2506075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office Dictate mode that interprets users' pauses as punctuation and adds them into the document.</descrip></descripGrp><ntig><termGrp><term id="2505363">Automatic Punctuation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2506075">Automatic Punctuation</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44546_2506467_2509693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A record of all purchases made by a user from an online store or portal.</descrip></descripGrp><ntig><termGrp><term id="2506467">order history</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2509693">historia e porosive</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termN