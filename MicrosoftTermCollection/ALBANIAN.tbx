3"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subset of settings and features that can be assigned to one of four slots in action center for quick, one-tap access. In addition, they can provide useful, actionable, or critical info regarding the setting or feature.</descrip></descripGrp><ntig><termGrp><term id="2070563">quick action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081883">veprim i shpejtë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36775_2070564_2081910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that is built using the Windows universal app platform. Developers can create a Windows universal app that runs on all Windows-based device types, or they can choose to limit an app to specific devices.</descrip></descripGrp><ntig><termGrp><term id="2070564">universal app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081910">aplikacion universal</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36775_2247950_2081910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that is built using the Windows universal app platform. Developers can create a Windows universal app that runs on all Windows-based device types, or they can choose to limit an app to specific devices.</descrip></descripGrp><ntig><termGrp><term id="2247950">Windows universal app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081910">aplikacion universal</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36776_2070565_2081861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To provide Wi-Fi credentials to Outlook.com contacts, Skype contacts, and Facebook friends.</descrip></descripGrp><ntig><termGrp><term id="2070565">exchange</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081861">shkëmbej</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36778_2071066_2081866"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone's volume mode when in a call.</descrip></descripGrp><ntig><termGrp><term id="2071066">In-Call</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081866">Në thirrje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36779_2071067_2081855"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of data connection in a roaming area. Generally making phone calls or using your data connection when the phone is roaming is more expensive, and the user will be charged additional fees for voice roaming calls.</descrip></descripGrp><ntig><termGrp><term id="2071067">data roaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081855">të dhëna në roaming</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36780_2071068_2081916"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The connection on your phone that allows you to make phone calls.</descrip></descripGrp><ntig><termGrp><term id="2071068">voice connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081916">lidhje zanore</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36781_2071069_2081918"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone call made in a roaming area. Generally making phone calls or using your data connection when the phone is roaming is more expensive, and the user will be charged additional fees for voice roaming calls.</descrip></descripGrp><ntig><termGrp><term id="2071069">voice roaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:l