ripGrp><descrip type="definition">The horizontal reference line on a grid, chart, or graph that has horizontal and vertical dimensions.</descrip></descripGrp><ntig><termGrp><term id="674572">horizontal axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1463787">boshti x</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10110_674572_1463788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The horizontal reference line on a grid, chart, or graph that has horizontal and vertical dimensions.</descrip></descripGrp><ntig><termGrp><term id="674572">horizontal axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1463788">boshti horizontal</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10113_308303_1187099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To publish or write entries for a blog.</descrip></descripGrp><ntig><termGrp><term id="308303">blog</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1187099">publikoj në ueb</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singu