urve that is part of a path object by using the control handles that represent the tangent of the curve.</descrip></descripGrp><ntig><termGrp><term id="660033">tangent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998509">tangjente</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19526_660055_2418699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To release objects that have been combined together as a single object.</descrip></descripGrp><ntig><termGrp><term id="660055">ungroup</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2418699">zhgrupoj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19538_660183_1806121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that stores an image as graphical objects (lines, circles, polygons) rather than as pixels. Metafiles preserve an image more accurately than pixels when the image is resized.</descrip></descripGrp><ntig><termGrp><term id="660183">metafile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1806121">metaskedar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19542_660559_1806081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page that you can assign to another page to create multiple layers in a drawing.</descrip></descripGrp><ntig><termGrp><term id="660559">background page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1806081">sfond</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19542_660560_1806081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page that you can assign to another page to create multiple layers in a drawing.</descrip></descripGrp><ntig><termGrp><term id="660560">background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1806081">sfond</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1958_184137_1463751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that allows users to digitally sign a form or document.</descrip></descripGrp><ntig><termGrp><term id="184137">signature line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1463751">rreshti i nënshkrimit</term><termNote type="geographicalUsage">ALB</ter