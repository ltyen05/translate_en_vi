oun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3067046">hyrje me zbehje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53745_3060432_3067047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transition effect placed at the end of a video clip that gradually decreases the visibility of the image or the sound of an audio track.</descrip></descripGrp><ntig><termGrp><term id="3060432">fade out</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3067047">dalje me zbehje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53745_3060433_3067047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transition effect placed at the end of a video clip that gradually decreases the visibility of the image or the sound of an audio track.</descrip></descripGrp><ntig><termGrp><term id="3060433">fade-out</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3067047">dalje me zbehje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53746_3060434_3067048"><l