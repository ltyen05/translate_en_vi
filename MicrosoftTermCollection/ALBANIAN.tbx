="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1835084">temë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20542_725950_1835084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of visual elements and sounds for your computer desktop or device User Interface. A theme determines the look of the various visual elements of your User Interface, such as windows, icons, fonts, and colors, and it can include sounds.</descrip></descripGrp><ntig><termGrp><term id="725950">desktop theme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1835084">temë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20543_760171_2280443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Internet Explorer feature that allows users to surf the Web without leaving a browsing history, cookies or other information on the PC so they can do online banking on a shared computer, for example.</descrip></descripGrp><ntig><termGrp><term id="760171">InPrivate</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2280443">InPrivate</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20548_2777447_3088121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security capability designed to protect users if they try to visit websites previously reported as phishing or containing malware, or if they try to download potentially malicious files​.</descrip></descripGrp><ntig><termGrp><term id="2777447">Microsoft Defender SmartScreen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3088121">Microsoft Defender SmartScreen</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20560_725996_1767215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service for wireless products that allows users to send and receive brief messages consisting of text and numbers to and from mobile phones and devices.</descrip></descripGrp><ntig><termGrp><term id="725996">SMS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1767215">SMS</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20595_726386_2021015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual community that provides people with opportunities to interact (via blogs, chats, newsgroups, webcasts, user groups, and forums) with Microsoft employees, experts, and peers in order to share knowledge and news about Microsoft technology.</descrip></descripGrp><ntig><termGrp><term id="726386">Microsoft community</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2021015">komuniteti i Microsoft</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20600_726850_1188593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sound made by a mobile device or other phone to indicate an incoming call or message, for example, a series of beeps or an audio recording.</descrip></descripGrp><ntig><termGrp><term id="726850">ringtone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188593">zile telefoni</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20600_726850_1883707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sound made by a mobile device or other phone to indicate an incoming call or message, for example, a series of beeps or an audio recording.</descrip></descripGrp><ntig><termGrp><term id="726850">ringtone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1883707">toni i ziles</term><termNote type="geographicalUsage">ALB</termNote><termNote type="p