on">A computer game that is put into a window that can be moved around and resized depending on what the user wants, also allowing for other things (like the Game Bar, overlays, or notifications) to be displayed on top of the game.</descrip></descripGrp><ntig><termGrp><term id="3041361">windowed game</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3041739">lojë në dritare</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53367_3041362_3041740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Gaming that utilizes a display format in which the game is put into a window that can be moved around and resized.</descrip></descripGrp><ntig><termGrp><term id="3041362">windowed gaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3041740">lojëra në dritare</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53368_3041363_3041733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Gaming that utilizes a display format in which the game/application is run in a window at full-screen size without a border, creating the experience of full-screen gaming while also allowing for other overlays on top of the game, similar to the windowed gaming experience.</descrip></descripGrp><ntig><termGrp><term id="3041363">borderless-windowed gaming</term><termNote type="partOfSpeech"