cient File Storage</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915399">Arkivimi i efektshëm i skedarëve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32273_1645773_1915400"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables SharePoint customers to build their site navigation around a metadata term set, and that enables friendly URLs for pages in the navigation structure.</descrip></descripGrp><ntig><termGrp><term id="1645773">managed navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915400">navigim i menaxhuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32275_1645776_1915401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that displays a preview of item content when a user hovers over a search result in SharePoint. The preview is optimized for the content type.</descrip></descripGrp><ntig><termGrp><term id="1645776">Quick Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915401">Paraafishimi i shpejtë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote>