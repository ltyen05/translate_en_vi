Speech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914886">Dosjet e kërkimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7874_7041_479911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string of characters entered by a user to verify his or her identity to a network or to a local computer, device, or client, or to sign in to an account, app, and so on.</descrip></descripGrp><ntig><termGrp><term id="7041">access code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="479911">kodi i qasjes</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7874_7041_479912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string of characters entered by a user to verify his or her identity to a network or to a local computer, device, or client, or to sign in to an account, app, and so on.</descrip></descripGrp><ntig><termGrp><term id="7041">access code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="479912">fjalëkalim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7874_7042_479911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string of characters entered by a user to verify his or her identity to a network or to a local computer, device, or client, or to sign in to an account, app, and so on.</descrip></descripGrp><ntig><termGrp><term id="7042">password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="479911">kodi i qasjes</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7874_7042_479912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string of characters entered by a user to verify his or her identity to a network or to a local computer, device, or client, or to sign in to an account, app, and so on.</descrip></descripGrp><ntig><termGrp><term id="7042">password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="479912">fjalëkalim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7875_307417_2291111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows Outlook and mobile devices to automatically discover and connect to the correct Exchange server without requiring the user to know the Exchange server name or other details, even if the mailbox has been moved or a server has failed.</descrip></descripGrp><ntig><termGrp><term id="307417">AutoConnect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2291111">Lidhje automatike</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7878_236973_481217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Parental Controls that allows users to block Web sites that they don't want to view.</descrip></descripGrp><ntig><termGrp><term id="236973">Web restrictions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481217">kufizimet e uebit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7885_48295_480236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move an item on the screen (1) by touching the item on a screen and then sliding the finger across the screen or (2) by pressing and holding down the left mouse button while moving the mouse.</descrip></descripGrp><ntig><termGrp><term id="48295">drag</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480236">zvarrit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7904_234775_481178"><l