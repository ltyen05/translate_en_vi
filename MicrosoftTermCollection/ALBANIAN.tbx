e type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481361">Protokolli i qasjes së mesazhit në internet</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13180_268854_481362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method computers use to send and receive email messages. It allows you to access email without downloading it to your computer or device.</descrip></descripGrp><ntig><termGrp><term id="268854">Internet Message Access Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481362">IMAP</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13180_268863_481361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method computers use to send and receive email messages. It allows you to access email without downloading it to your computer or device.</descrip></descripGrp><ntig><termGrp><term id="268863">IMAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481361">Protokolli i qasjes së mesazhit në internet</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13180_268863_481362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method computers use to send and receive email messages. It allows you to access email without downloading it to your computer or device.</descrip></descripGrp><ntig><termGrp><term id="268863">IMAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481362">IMAP</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13181_232398_1914881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Exchange mailbox that allocates a specific number of connections. The resource serves as a virtual room for your online meeting. You invite the resource to an online meeting just as you would reserve a room for a meeting.</descrip></descripGrp><ntig><termGrp><term id="232398">conference resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914881">burim i konferencës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13196_318732_481622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu choice or remote button that offers access to the user's video library.</descrip></descripGrp><ntig><termGrp><term id="318732">My Videos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481622">Videot e mia</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13210_262699_481316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small, Internet Protocol (IP)-based network. It is usually used for short-range, ad-hoc communication between devices and computers. A PAN may also be used to enable connectivity to a larger Local Area Network (LAN), Wide-Area Network (WAN), or the Internet. Windows XP supports the Bluetooth PAN service so you can create Personal Area Networks using Bluetooth.</descrip></descripGrp><ntig><termGrp><term id="262699">Personal Area Network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481316">Rrjeti i zonës personale</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13210_262699_481317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small, Internet Protocol (IP)-based network. It is usually used for short-range, ad-hoc communication between devices and computers. A PAN may also be used to enable connectivity to a larger Local Area Network (LAN), Wide-Area Network (WAN), or the Internet. Windows XP supports the Bluetooth PAN service so you can create Personal Area Networks using Bluetooth.</descrip></descripGrp><ntig><termGrp><term id="262699">Personal Area Network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp>