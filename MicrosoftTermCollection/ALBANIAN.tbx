g></langSet></termEntry><termEntry id="5440_95667_1538563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a Web Parts connection, a server control that sends data to a consumer control. A provider can be a WebPart control or any type of server control, but must be designed to function as a provider. A provider must have a special callback method marked with a ConnectionProviderAttribute attribute in the source code. This method provides data to consumer controls in the form of an interface instance.</descrip></descripGrp><ntig><termGrp><term id="95667">provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1538563">ofrues</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5444_144872_1914795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An animated border that appears around a worksheet range that has been cut or copied. To cancel a moving border, press ESC.</descrip></descripGrp><ntig><termGrp><term id="144872">moving border</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914795">kufizuesi zhvendosës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5452_25722_480035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of memory measurement that consists of eight bits.</descrip></descripGrp><ntig><termGrp><term id="25722">byte</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480035">bajt</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54539_3099039_3099241"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The holiday that commemorates the birthday of His Majesty King Charles III.</descrip></descripGrp><ntig><termGrp><term id="3099039">King’s Birthday</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3099241">Ditëlindja e mbretit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54540_3099040_3099240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The holiday that commemorates the crowning of His Majesty King Charles III.</descrip></descripGrp><ntig><termGrp><term id="3099040">Coronation Day for King Charles III</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3099240">Dita e kurorëzimit e mbretit Charles III</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54541_3099042_3101650"><langSet xml:lang="en-