ote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2181387">dosje prind</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37317_2114594_2181452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location of a user's profile on the local drive, for example C:\Users\jason. The user profile could be a local profile, which is stored on a single computer, or a roaming user profile, which is synchronized with a file server so that multiple PCs can use the same profile settings.</descrip></descripGrp><ntig><termGrp><term id="2114594">profile path</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2181452">shtegu i profilit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3732_15888_479968"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The separator between account names and domain names in Internet email addresses.</descrip></descripGrp><ntig><termGrp><term id="15888">at sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="479968">shenja @</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry