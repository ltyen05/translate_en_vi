nd a received content either modified or in its entirety, to a new recipient.</descrip></descripGrp><ntig><termGrp><term id="56172">forward</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188496">paso</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13564_56172_1883811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To send a received content either modified or in its entirety, to a new recipient.</descrip></descripGrp><ntig><termGrp><term id="56172">forward</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1883811">transferoj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13569_92850_480546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client program or control that receives digital media content streamed from a server or played from local files. Windows Media Player is an example of a player.</descrip></descripGrp><ntig><termGrp><term id="92850">player</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480546">lexues</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber"