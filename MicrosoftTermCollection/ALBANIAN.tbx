tion">The New Zealand holiday celebrated on February 6 that commemorates the signing of the Treaty of Waitangi in 1840, signed by representatives of the British Crown and Maori chiefs and often considered to be New Zealand's founding document.</descrip></descripGrp><ntig><termGrp><term id="2929999">Waitangi Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2947210">Dita e Vaitangit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52033_2930000_2947211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The day on which Waitangi Day is celebrated if the official holiday itself falls on a weekend.</descrip></descripGrp><ntig><termGrp><term id="2930000">Waitangi Day Bank Holiday</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2947211">Pushimi bankar për Ditën e Vaitangit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52034_2930002_2931283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of SharePoint Server that a customer can run on-premises, for which Microsoft will provide ongoing support and updates for as long as the subscription is current/valid.</descrip></descripGrp><ntig><termGrp><term id="2930002">SharePoint Server Subscription Edition</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote