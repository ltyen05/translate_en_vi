>kompjuter</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2400_1030794_1815731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microcomputer designed for use by one person at a time. Personal computers do not need to share the processing, disk, and printer resources of another computer.</descrip></descripGrp><ntig><termGrp><term id="1030794">single-user computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1815731">kompjuter personal</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2400_91272_1815693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microcomputer designed for use by one person at a time. Personal computers do not need to share the processing, disk, and printer resources of another computer.</descrip></descripGrp><ntig><termGrp><term id="91272">PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1815693">kompjuter</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2400_91272_1815731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microcomputer designed for use by one person at a time. Personal computers do not need to share the processing, disk, and printer resources of another computer.</descrip></descripGrp><ntig><termGrp><term id="91272">PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1815731">kompjuter personal</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2400_91273_1815693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microcomputer designed for use by one person at a time. Personal computers do not need to share the processing, disk, and printer resources of another computer.</descrip></descripGrp><ntig><termGrp><term id="91273">personal computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1815693">kompjuter</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2400_91273_1815731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microcomputer designed for use by one person at a time. Personal computers do not need to share the processing, disk, and printer resources of another computer.</descrip></descripGrp><ntig><termGrp><term id="91273">personal computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1815731">kompjuter personal</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24002_1093138_1996294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI or media segment that can display on top of or play concurrently with another UI or media segment.</descrip></descripGrp><ntig><termGrp><term id="1093138">overlay</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1996294">mbivendosje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24016_1093171_2591792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A powerful stand-alone computer of the sort used in computer-aided design and other applications requiring a high-end, usually expensive, machine with considerable calculating or graphics capability.</descrip></descripGrp><ntig><termGrp><term id="1093171">workstation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2591792">stacioni i punës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24039_1097320_2640030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On retailer websites, a collection of desired products or items a customer saves to their user account for future reference.</descrip></descripGrp><ntig><termGrp><term id="109732