="definition">A logical grouping of managed folders. When a managed folder mailbox policy is applied to a user’s mailbox, all the managed folders that are linked to the policy are deployed in a single operation, thereby making the deployment of messaging records management (MRM) easier.</descrip></descripGrp><ntig><termGrp><term id="397203">managed folder mailbox policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2291309">politika e kutisë postare të dosjes së menaxhuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1500_7883_479922"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an entity such as the device, program, file, record or portion of the screen that is currently operational or subject to command operations.</descrip></descripGrp><ntig><termGrp><term id="7883">active</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="479922">aktiv</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15015_184144_481014"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The title for a dialog that specifies how a signature line should be signed, including instructions for signers.</descrip></descripGrp><ntig><termGrp><term id="184144">Signature Setup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammati