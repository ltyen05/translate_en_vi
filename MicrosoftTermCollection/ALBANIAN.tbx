roup is created. Local groups can have any user accounts that are local to the computer as members, as well as users, groups, and computers from a domain to which the computer belongs.</descrip></descripGrp><ntig><termGrp><term id="76022">local group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480420">grup lokal</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12547_155493_480925"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technical document in the Microsoft Knowledge Base accessible through Microsoft.com.</descrip></descripGrp><ntig><termGrp><term id="155493">KB article</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480925">artikull KB</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12548_139813_480811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user dictionary that contains a list of words not in the application dictionary that an author wants the spelling checker to accept as correct.</descrip></descripGrp><ntig><termGrp><term id="139813">custom dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480811">fjalor i përshtatur</term><termNote type="geographicalUsage">ALB</termNote><termNote type="p