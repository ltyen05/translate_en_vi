56230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that supplies callers with information and performs an action without the intervention of a human operator, automatically routing calls based on selections made by the caller.</descrip></descripGrp><ntig><termGrp><term id="2754105">auto attendant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2756230">centrali automatik telefonik</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10637_2754105_2756233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that supplies callers with information and performs an action without the intervention of a human operator, automatically routing calls based on selections made by the caller.</descrip></descripGrp><ntig><termGrp><term id="2754105">auto attendant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2756233">Centrali automatik telefonik i resë kompjuterike</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10637_2754779_2756230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that supplies callers with information and performs an action without the intervention of a human operator, automatically routing calls based on selections made by the caller.</descrip></descripGrp><ntig><termGrp><term id="2754779