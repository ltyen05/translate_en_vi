><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11734_298004_481266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital interface specification for delivering digital content and connecting consumer electronic devices.</descrip></descripGrp><ntig><termGrp><term id="298004">high-definition multimedia interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481266">HDMI</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11734_298004_481441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital interface specification for delivering digital content and connecting consumer electronic devices.</descrip></descripGrp><ntig><termGrp><term id="298004">high-definition multimedia interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481441">ndërfaqja e multimedias me përcaktim të lartë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11744_38453_480142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person, inside or outside your organization, for whom you have created an entry where you can save several types of information, such as street and email addresses, telephone and fax numbers, and Web page URLs.</descrip></descripGrp><ntig><termGrp><term id="38453">contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480142">kontakt</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11748_136786_480779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A display setting that holds up to 256 specific color entries. Any color palette attached to a picture is by definition an 8-bit palette.</descrip></descripGrp><ntig><termGrp><term id="136786">8-bit color</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480779">ngjyrë 8-bitëshe</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11757_146879_480872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The device that communicates between your software program and your printer.</descrip></descripGrp><ntig><termGrp><term id="146879">printer driver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480872">drejtuesi i printerit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11758_153847_480919"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object created with one program and embedded into a document created by another. Embedding the object, rather than simply inserting or pasting it, ensures that the object retains its original format. If you double-click the embedded object, you can edit it with the toolbars and menus from the program used to create it.</descrip></descripGrp><ntig><termGrp><term id="153847">embedded object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480919">objekt i ngulitur</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11759_307436_2291312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mechanism used to help a caller differentiate between users with names that match the touch-tone or speech input.</descrip></descripGrp><ntig><termGrp><term id="307436">Matched Name Selection Method</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2291312">Metoda e përzgjedhjes së emrit të përputhur</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11765_2795839_3085805"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft's antimalware solution that provides next generation protection for desktops, portable computers, and servers.</descrip></descripGrp><ntig><termGrp><term id="2795839">Microsoft De