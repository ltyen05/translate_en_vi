rmGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915430">grupi i përditësimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32342_1653526_1915431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed property that can be queried against. The query must contain the managed property field name, either in the query itself or programmatically.</descrip></descripGrp><ntig><termGrp><term id="1653526">queryable managed property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915431">veti e menaxhuar e përdorshme në pyetje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32343_1653528_1915432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed property that can be used as the basis for a refiner for search results.</descrip></descripGrp><ntig><termGrp><term id="1653528">refinable managed property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915432">veti e menaxhuar e përdorshme në kërkim të përpunuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32344_1653529_1915433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed property that can be displayed in search results.</descrip></descripGrp><ntig><termGrp><term id="1653529">retrievable managed property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915433">veti e menaxhuar që mund të rinxirret</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32345_1653531_1915434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed property whose value can be returned by a query.</descrip></descripGrp><ntig><termGrp><term id="1653531">searchable managed property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915434">veti e menaxhuar e përdorshme në kërkim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32346_1653533_1915435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed property whose result set can be sorted based on the property before the result set is returned.</descrip></descripGrp><ntig><termGrp><term id="1653533">sortable managed property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915435">veti e menaxhuar që mund të renditet</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32350_1656127_1915436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user defined dictionary that lists single words or phrases that the system matches to words in the content in either a case-sensitive way or a case-insensitive way, depending on the type of dictionary that is used.</descrip></descripGrp><ntig><termGrp><term id="1656127">custom extraction dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915436">fjalor i përshtatur ekstraktimi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32351_1656134_1915437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom extraction dictionary that lists words or phrases that are matched to exact words in the content in a case-sensitive way. For example, the system matches "anchor" to "anchor," but not to "Anchor" or "Anchorage."</descrip></descripGrp><ntig><termGrp><term id="1656134">exact word extraction dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915437">fjalor i ekstraktimit të fjalëve të sakta</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32352_1656137_1915438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom extraction dictionary that lists words or phrases that are matched anywhere in the content in a case-sensitive way. For example, the system matches "anchor" and "anchorage," but not "Anchor."</descrip></descripGrp><ntig><termGrp><term id="1656137">exact word part extraction dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915438">fjalor i ekstraktimit të pjesëve të sakta të fjalëve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32353_1656140_1915439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom extraction dictionary that lists words or phrases that are matched to exact words in the content in a case-insensitive way. For example, the entry "anchor" will match "anchor" and "Anchor," but not "anchorage."</descrip></descripGrp><ntig><termGrp><term id="1656140">word extraction dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915439">fjalori i ekstraktimit të fjalëve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32354_1656141_1915440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom extraction dictionary that lists words or phrases that are matched anywhere in the content in a case-insensitive way. For example, the entry "anchor" will match "anchor," "Anchor," and "anchorage."</descrip></descripGrp><ntig><termGrp><term id="1656141">word part extraction dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915440">Fjalor i ekstraktimit të pjesëve të fjalëve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32355_1656142_1915441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure that describes crawled properties, managed properties, and the mapping between them.</descrip></descripGrp><ntig><termGrp><term id="1656142">search schema</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915441">skema e kërkimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32356_1656144_1915442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical portion of the search index.</descrip></descripGrp><ntig><termGrp><term id="1656144">index partition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915442">ndarja e indeksit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32359_1657886_1664750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of apps that includes Messenger, Photo Gallery, Movie Maker, OneDrive, Mail, Writer, and Family Safety. (Family Safety is only included in Windows 7 downloads; it's built in to Windows 8.)</descrip></descripGrp><ntig><termGrp><term id="1657886">Windows Essentials 2012</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1664750">Windows Essentials 2012</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3236_80090_1834968"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of computers and data communication equipment to convey messages from one person to another, as by email, voice mail, or fax.</descrip></descripGrp><ntig><termGrp><term id="80090">messaging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1834968">mesazhet</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32362_1658249_1915444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode in which SharePoint Server is the primary source for all the project details. Project Server scheduling, time and status, and advanced functionality are disabled.</descrip></descripGrp><ntig><termGrp><term id="1658249">visibility mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915444">regjimi i dukshmërisë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32367_1666384_1686910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that enables users to connect computers with a simple tap gesture or by browsing for computers within wireless range. If two computers come within 3-4 centimeters of each other, or are tapped together, the operating system of each computer becomes aware of the other computer. Also, a user can browse for computers within wireless range that are advertising for a peer connection. The user can then connect the two computers to share content such as photos or links, or create a multi-player experience. If the connection is made using a tap gesture, the user can also publish and subscribe to messages transmitted during the tap.</descrip></descripGrp><ntig><termGrp><term id="1666384">proximity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1686910">afërsi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3239_1513455_1639894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certification authority that has the ability to issue the intermediate certificates needed to certify the subject identified by the end certificate.</descrip></descripGrp><ntig><termGrp><term id="1513455">intermediate CA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1639894">autoriteti i certifikimit të ndërmjetëm</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3239_68764_1639894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certification authority that has the ability to issue the intermediate certificates needed to certify the subject identified by the end certificate.</descrip></descripGrp><ntig><termGrp><term id="68764">intermediate certification authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1639894">autoriteti i certifikimit të ndërmjetëm</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32395_1667479_1676730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows where a user's credentials are securely stored.</descrip></descripGrp><ntig><termGrp><term id="1667479">Credential Locker</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1676730">Kutia e sigurisë e kredencialeve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32397_1667525_1680375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To take action on a message by either replying to the sender, to the sender and all recipients, or by forwarding the message to someone else.</descrip></descripGrp><ntig><termGrp><term id="1667525">respond</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1680375">përgjigjem</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32398_1672123_1915445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pane in the Outlook window that contains folders for each view, such as Mail or Calendar.</descrip></descripGrp><ntig><termGrp><term id="1672123">Folder Pane</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915445">paneli i dosjeve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32399_1672771_1676742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows that provide right-click access from taskbar program buttons to the documents, pictures, songs, or websites a user frequently accesses.</descrip></descripGrp><ntig><termGrp><term id="1672771">Jump List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1676742">Lista e qasjes së drejtpërdrejtë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32399_1672771_2181339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows that provide right-click access from taskbar program buttons to the documents, pictures, songs, or websites a user frequently accesses.</descrip></descripGrp><ntig><termGrp><term id="1672771">Jump List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2181339">lista e qasjes së drejtpërdrejtë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32399_2145328_1676742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows that provide right-click access from taskbar program buttons to the documents, pictures, songs, or websites a user frequently accesses.</descrip></descripGrp><ntig><termGrp><term id="2145328">jump list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1676742">Lista e qasjes së drejtpërdrejtë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32399_2145328_2181339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows that provide right-click access from taskbar program buttons to the documents, pictures, songs, or websites a user frequently accesses.</descrip></descripGrp><ntig><termGrp><term id="2145328">jump list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2181339">lista e qasjes së drejtpërdrejtë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32402_1673093_1678589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A nonfinal release of Internet Explorer 10.</descrip></descripGrp><ntig><termGrp><term id="1673093">Internet Explorer 10 Consumer Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1678589">Internet Explorer 10 Consumer Preview</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32403_1673106_1680542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short video sent as an email message to someone in the contact list.</descrip></descripGrp><ntig><termGrp><term id="1673106">video mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1680542">videomesazh</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammatica