rip type="definition">To change a message filter verdict and move an unread message after it has been deemed appropriate and delivered, as performed by ZAP.</descrip></descripGrp><ntig><termGrp><term id="2748848">zap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2750236">hiq automatikisht</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4859_295625_481417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A letter that serves to introduce accompanying documents to the recipient. Often refers to a letter sent with a resume when applying for a job.</descrip></descripGrp><ntig><termGrp><term id="295625">cover letter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481417">letër përkrahëse</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48592_2749595_2750566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web-based management portal for administrators of a service or set of services.​</descrip></descripGrp><ntig><termGrp><term id="2749595">admin center</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2750566">qendra e administratorëve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech