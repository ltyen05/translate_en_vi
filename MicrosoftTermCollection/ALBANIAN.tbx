Note></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2595244">parametrizuesi i klientëve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42994_2436157_2595243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism to remove clients from the cloud service.</descrip></descripGrp><ntig><termGrp><term id="2436157">offboarding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2595243">larguesi i klientëve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42995_2436354_2440244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows Office users wanting to use a third-party app or plug in within Office to provide their credentials or permission so that the app within Office can perform actions on their behalf. ​</descrip></descripGrp><ntig><termGrp><term id="2436354">App to App sign in</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2440244">Hyrje nga aplikacioni në aplikacion</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42996_2436355_2440248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to trim the start and end of a video file by specifying the location to start playing and the location to end playing.</descrip></descripGrp><ntig><termGrp><term id="2436355">Media Trim</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2440248">Prerje e medias</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42997_2436365_3113685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud-based solution that enables organizations to control user access to apps and data in the cloud and on-premises, to ensure only authorized users have access.</descrip></descripGrp><ntig><termGrp><term id="2436365">Azure AD Identity Governance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3113685">Microsoft Entra ID Governance</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42997_2436368_3113685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud-based solution that enables organizations to control user access to apps and data in the cloud and on-premises, to ensure only authorized users have access.</descrip></descripGrp><ntig><termGrp><term id="2436368">Azure Active Directory Identity Governance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote