<descrip type="definition">An interactive tool that makes it easier to set up commonly used accessibility features by specifying options by type of disability, rather than by numeric value changes.</descrip></descripGrp><ntig><termGrp><term id="157455">Accessibility Wizard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1187098">Eksperti i qasshmërisë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10095_339958_1835016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status message displayed when the caller ID of an incoming call is blocked.</descrip></descripGrp><ntig><termGrp><term id="339958">Private</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1835016">Privat</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10100_149094_1914824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color that is defined by the operating system for a specific type of monitor and video adapter and that is associated with a specific part of the user interface, such as a window title or a menu.</descrip></descripGrp><ntig><termGrp><term id="149094">system color</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term i