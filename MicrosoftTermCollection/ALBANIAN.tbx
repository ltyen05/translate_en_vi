><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33733_1814264_2060742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A picture taken with the webcam (during the call or any time).</descrip></descripGrp><ntig><termGrp><term id="1814264">snapshot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2060742">pamje çasti nga video</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33734_1814266_2060733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that increases or decreases the volume of the speaker in a group call to match the position of the speaker (i.e right or left).</descrip></descripGrp><ntig><termGrp><term id="1814266">true sound</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2060733">tingulli real</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33735_1814267_2060734"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera that can be used with a television set to make video calls.</descrip></descripGrp><ntig><termGrp><term id="1814267">TV cam</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</term