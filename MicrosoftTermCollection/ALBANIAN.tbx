ig></langSet></termEntry><termEntry id="42526_2410029_2416898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition of being protected from danger or risk.</descrip></descripGrp><ntig><termGrp><term id="2410029">safety</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2416898">siguria</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42529_2410032_2416893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A failure of a program operation that causes the operation to stop completely.</descrip></descripGrp><ntig><termGrp><term id="2410032">hard fail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2416893">dështim i plotë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42530_2410033_2416899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A failure of a program operation where the failure is recorded and the operation continues on.</descrip></descripGrp><ntig><termGrp><term id="2410033">soft fail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2416899">dështim i vogël</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42531_2410034_2416890"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PowerPoint button that opens a tab with a specialized version of the app store where users can find materials related to education so that those materials can be included in their deck.</descrip></descripGrp><ntig><termGrp><term id="2410034">Apps and Quizzes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2416890">Aplikacione dhe kuize</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42550_2410359_2411712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft laptop computer, announced to the public in October 2015.</descrip></descripGrp><ntig><termGrp><term id="2410359">Surface Book</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2411712">Surface Book</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42551_2410363_2411713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft tablet computer, announced to the public in October 2015.</descrip></descripGrp><ntig><termGrp><term id="2410363">Surface Pro 4</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type=