 type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3098485">incident sigurie</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54313_3097235_3098483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An automated notification resulting from a detection.</descrip></descripGrp><ntig><termGrp><term id="3097235">security alert</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3098483">sinjalizim sigurie</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54314_3097236_3098484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Engagement of the Microsoft incident response team via formal engagement procedures indicating a potential security issue that requires investigation.</descrip></descripGrp><ntig><termGrp><term id="3097236">security escalation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3098484">përshkallëzim sigurie</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54315_3097237_3098477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical analytical process for identifying security-impacting, anomalous, or suspicious activity.</descrip></descripGrp><ntig><termGrp><term id="3097237">detection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3098477">detektim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54316_3097238_3098482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operational issue (i.e. configuration setting, deployment task, etc.) that adversely impacts the security posture of a service.</descrip></descripGrp><ntig><termGrp><term id="3097238">hygiene issue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3098482">problem higjiene</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54317_3097239_3098481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A detection, alert, or escalation that incorrectly indicates that malicious activity is occurring.</descrip></descripGrp><ntig><termGrp><term id="3097239">false positive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3098481">sinjalizim fals</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</ter