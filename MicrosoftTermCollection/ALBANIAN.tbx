ip type="definition">A photo that illustrates motion by blurring together multiple frames of a short video to create the effect of motion in the still image.</descrip></descripGrp><ntig><termGrp><term id="2157427">motion focus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2177973">efekti i lëvizjes</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37781_2157428_2181750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The top level view in File Explorer that shows the user's most frequently used and most recently used files and folders or folders pinned by the user for quick access.</descrip></descripGrp><ntig><termGrp><term id="2157428">Quick access</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2181750">Qasja e shpejtë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37782_2157429_2181757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides unending stream of music based not on the user's library, but on an artist or song selected by the user.</descrip></descripGrp><ntig><termGrp><term id="2157429">Radio</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2181757">Radioja</term><termNote 