.</descrip></descripGrp><ntig><termGrp><term id="1047918">Picture Presentation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188744">Prezantimi i imazhit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22561_1048326_2291225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A viewer that allows users to display Excel workbooks on a phone’s browser. A file is rendered as an HTML page with sufficient fidelity to convey important data or charts and illustrations.</descrip></descripGrp><ntig><termGrp><term id="1048326">Excel Mobile Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2291225">Paraqitësi i Excel Mobile</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22562_1048367_1428634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A viewer that allows users to display Word documents on a phone’s browser. A file is rendered as an HTML page with sufficient fidelity to convey text and images on a small screen.</descrip></descripGrp><ntig><termGrp><term id="1048367">Word Mobile Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1428634">Paraqitësi i Word Mobile</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2257_183896_1188367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to compact or collapse rows when viewing several levels of data.</descrip></descripGrp><ntig><termGrp><term id="183896">compact row axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188367">boshti i rreshtave kompaktë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22571_1049734_2418680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pencil tool that simulates the look and feel of drawing lines with a pencil.</descrip></descripGrp><ntig><termGrp><term id="1049734">line pencil</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2418680">laps</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22571_1050935_2418680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pencil tool that simulates the look and feel of drawing lines with a pencil.</descrip></descripGrp><ntig><termGrp><term id="1050935">pencil</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumbe