><descripGrp><descrip type="definition">Pertaining to a type of access to data in a database that is shared over a network. When you open a database in exclusive mode, you prevent others from opening the database.</descrip></descripGrp><ntig><termGrp><term id="52156">exclusive</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480265">përjashtuese</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13776_5615_479899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A supplemental program that can extend the capabilities of an application program.</descrip></descripGrp><ntig><termGrp><term id="5615">add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="479899">shtesë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13787_397179_2291302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of recipients that are created to expedite the mass emailing of messages and other information. Unlike a mail-enabled universal distribution group, a mail-enabled USG can also be used to assign permissions. When email is sent to a mail-enabled USG, all members of that group receive a copy of the message.</descrip></descripGrp><ntig><termGrp><term id="397179">mail-enabled universal security group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2291302">grupi i sigurisë universale që mbështet postën</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13788_213533_1961612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To tap twice quickly on a screen or touchpad.</descrip></descripGrp><ntig><termGrp><term id="213533">double-tap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1961612">trokas dy herë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1379_120227_480680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suite of networking protocols arranged in four layers, which are called the link layer, internet layer, transport layer, and application layer, and that includes IP in the internet layer and TCP in the transport layer.</descrip></descripGrp><ntig><termGrp><term id="120227">TCP/IP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480680">TCP/IP</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1379_120227_480681"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suite of networking protocols arranged in four layers, which are called the link layer, internet layer, transport layer, and application layer, and that includes IP in the internet layer and TCP in the transport layer.</descrip></descripGrp><ntig><termGrp><term id="120227">TCP/IP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480681">Protokolli i kontrollit të transmetimit/Protokolli i internetit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1379_120228_480680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suite of networking protocols arranged in four layers, which are called the link layer, internet layer, transport layer, and application layer, and that includes IP in the internet layer and TCP in the transport layer.</descrip></descripGrp><ntig><termGrp><term id="120228">Transmission Control Protocol/Internet Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480680">TCP/IP</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1379_120228_480681"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suite of networking protocols arranged in four layers, which are called the link layer, internet layer, transport layer, and application layer, and that includes IP in the internet layer and TCP in the transport layer.</descrip></descripGrp><ntig><termGrp><term id="120228">Transmission Control Protocol/Internet Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480681">Protokolli i kontrollit të transmetimit/Protokolli i internetit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13805_135723_480770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To adjust the perspective of an image or document in order to view a larger area on the screen at one time, as if viewed from farther away.</descrip></descripGrp><ntig><termGrp><term id="135723">zoom out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480770">zvogëlim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13809_88455_480514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu choice that allows a user to customize application behavior.</descrip></descripGrp><ntig><termGrp><term id="88455">Options</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480514">Opsione</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13821_137076_1188499"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sheet that you're working on in a workbook. The name on the tab of the active sheet is bold.</descrip></descripGrp><ntig><termGrp><term id="137076">active sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188499">fletë aktive</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13829_237385_481239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customizable toolbar that provides one-click access to commands.</descrip></descripGrp><ntig><termGrp><term id="237385">Quick Access Toolbar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481239">Shiriti i veglave i qasjes së shpejtë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13835_141250_480835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control on a menu, toolbar, dialog box, or data access page that displays a list of options when you click the small arrow next to the list box.</descrip></descripGrp><ntig><termGrp><term id="141250">drop-down list box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480835">kutia e listës me lëshim poshtë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13838_306445_480364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card, plug, or other device that connects pieces of hardware with the computer so that information can be moved from place to place. For example, standardized interfaces such as RS-232-C standard and SCSI enable communications between computers and printers or disks.</descrip></descripGrp><ntig><termGrp><term id="306445">hardware interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480364">ndërfaqe</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13838_306445_481470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card, plug, or other device that connects pieces of hardware with the computer so that information can be moved from place to place. For example, standardized interfaces such as RS-232-C standard and SCSI enable communications between computers and printers or disks.</descrip></descripGrp><ntig><termGrp><term id="306445">hardware interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481470">ndërfaqja e harduerit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13838_68604_480364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card, plug, or other device that connects pieces of hardware with the computer so that information can be moved from place to place. For example, standardized interfaces such as RS-232-C standard and SCSI enable communications between computers and printers or disks.</descrip></descripGrp><ntig><termGrp><term id="68604">interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480364">ndërfaqe</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13838_68604_481470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card, plug, or other device that connects pieces of hardware with the computer so that information can be moved from place to place. For example, standardized interfaces such as RS-232-C standard and SCSI enable communications between computers and printers or disks.</descrip></descripGrp><ntig><termGrp><term id="68604">interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481470">ndërfaqja e harduerit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13842_253769_1188500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A setting in which existing characters are replaced with newly typed characters.</descrip></descripGrp><ntig><termGrp><term id="253769">overtype mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188500">mënyra e mbishtypjes</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13846_61010_480316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability of many programs and operating systems to display advice or instructions for using their features when so requested by the user, as by a screen button or menu item or a function key.</descrip></descripGrp><ntig><termGrp><term id="61010">help</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480316">ndihmë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13846_61011_480316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability of many programs and operating systems to display advice or instructions for using their features when so requested by the user, as by a screen button or menu item or a function key.</descrip></descripGrp><ntig><termGrp><term id="61011">online help</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480316">ndihmë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13863_107546_480604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In facsimile and other optical technologies, to move a light-sensitive device across an image-bearing surface such as a page of text, converting the light and dark areas on the surface to binary digits that can be interpreted by a computer.</descrip></descripGrp><ntig><termGrp><term id="107546">scan</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480604">skanoj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13865_185672_1372774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small graphical symbol the user can insert into instant messages.</descrip></descripGrp><ntig><termGrp><term id="185672">emoticon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1372774">Ikonë emocionesh</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13865_185672_2060895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small graphical symbol the user can insert into instant messages.</descrip></descripGrp><ntig><termGrp><term id="185672">emoticon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2060895">emotikonë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13865_185672_2081834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small graphical symbol the user can insert into instant messages.</descrip></descripGrp><ntig><termGrp><term id="185672">emoticon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081834">ikona e emocionit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13873_122536_1690180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual song or other discrete piece of audio content.</descrip></descripGrp><ntig><termGrp><term id="122536">track</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1690180">pjesë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13873_640881_1690180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual song or other discrete piece of audio content.</descrip></descripGrp><ntig><termGrp><term id="640881">audio track</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1690180">pjesë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13874_120089_480679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that represents an item or program that is open and running on your computer. For example, if you open Microsoft Word, and then minimize it, it will be displayed as a taskbar button, which you can then click when you want to maximize it.</descrip></descripGrp><ntig><termGrp><term id="120089">taskbar button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480679">butoni i shiritit të detyrave</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13875_397173_2291289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mail-enabled Active Directory contact that contains information about people or organizations that exist outside an Exchange Server organization. Each mail contact has an external email address.</descrip></descripGrp><ntig><termGrp><term id="397173">mail contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2291289">kontakti i postës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13883_43673_480179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To detect, locate, and correct logical or syntactical errors in a program or malfunctions in hardware. In hardware contexts, the term troubleshoot is the term more often used, especially when the problem is a major one.</descrip></descripGrp><ntig><termGrp><term id="43673">debug</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480179">korrigjoj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13888_237793_1188501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A testing process that supplies structured but invalid input to software application programming interfaces (APIs) and network interfaces to maximize the likelihood of detecting errors that might lead to software vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="237793">fuzz testing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188501">testim arbitrar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13888_237793_2843213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A testing process that supplies structured but invalid input to software application programming interfaces (APIs) and network interfaces to maximize the likelihood of detecting errors that might lead to software vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="237793">fuzz testing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2843213">testim me të dhëna rastësore</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13888_767358_1188501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A testing process that supplies structured but invalid input to software application programming interfaces (APIs) and network interfaces to maximize the likelihood of detecting errors that might lead to software vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="767358">fuzzing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188501">testim arbitrar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13888_767358_2843213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A testing process that supplies structured but invalid input to software application programming interfaces (APIs) and network interfaces to maximize the likelihood of detecting errors that might lead to software vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="767358">fuzzing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2843213">testim me të dhëna rastësore</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13894_297011_481426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that installs other potentially unwanted software, such as adware or spyware. The license agreement of the bundling program may require these other components in order to function.</descrip></descripGrp><ntig><termGrp><term id="297011">software bundler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481426">softuer me veprim të padëshiruar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13902_142582_1914776"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microphone feature that allows your input to be amplified so that it is made louder for use by the system.</descrip></descripGrp><ntig><termGrp><term id="142582">gain adjustment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914776">rregullimi i fitimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13907_109815_1914714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An executable program file that contains one or more compressed text or data files. When a user runs the program, it uncompresses the compressed files and stores them on the user's hard drive.</descrip></descripGrp><ntig><termGrp><term id="109815">self-extracting file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914714">skedar vetekstraktues</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13920_23913_480025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of or relating to communications systems in which the medium of transmission (such as a wire or fiber-optic cable) carries multiple messages at a time, each message modulated on its own carrier frequency by a modem.</descrip></descripGrp><ntig><termGrp><term id="23913">broadband</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480025">brezgjerë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13926_299909_1187142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows technology that collects data when the system crashes or stops responding and sends it to Microsoft.</descrip></descripGrp><ntig><termGrp><term id="299909">Windows Error Reporting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1187142">Raportimi i gabimeve të Windows</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13926_558472_1187142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows technology that collects data when the system crashes or stops responding and sends it to Microsoft.</descrip></descripGrp><ntig><termGrp><term id="558472">WER</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1187142">Raportimi i gabimeve të Windows</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13932_186191_481024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the presets for 3D rotation effects. When selected, specifies that the object will be rotated isometrically.</descrip></descripGrp><ntig><termGrp><term id="186191">isometric</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481024">izometrik</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13946_109605_480618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark text, cells, and similar items that will be subject to a user action, such as copying text.</descrip></descripGrp><ntig><termGrp><term id="109605">select</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480618">përzgjedh</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13947_545693_2577382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides a home for the Office Scrapbook, Compatibility Report, Project Palette and Reference Pane and is shown as a floating palette.</descrip></descripGrp><ntig><termGrp><term id="545693">Toolbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2577382">Kutia e veglave</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13951_308301_481482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The price at which a buyer has offered to purchase an item.</descrip></descripGrp><ntig><termGrp><term id="308301">bid</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481482">ofertë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13955_1509436_1835050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu item that allows the play back all of the items in a playlist once, in random order. Playback ends when all of the items in the list have been played one time.</descrip></descripGrp><ntig><termGrp><term id="1509436">shuffle all</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1835050">përziej të gjitha</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13955_1509436_481628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu item that allows the play back all of the items in a playlist once, in random order. Playback ends when all of the items in the list have been played one time.</descrip></descripGrp><ntig><termGrp><term id="1509436">shuffle all</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481628">përziej</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13955_318745_1835050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu item that allows the play back all of the items in a playlist once, in random order. Playback ends when all of the items in the list have been played one time.</descrip></descripGrp><ntig><termGrp><term id="318745">shuffle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1835050">përziej të gjitha</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13955_318745_481628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu item that allows the play back all of the items in a playlist once, in random order. Playback ends when all of the items in the list have been played one time.</descrip></descripGrp><ntig><termGrp><term id="318745">shuffle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481628">përziej</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1396_107623_480605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optical input device that uses light-sensing equipment to capture an image on paper or some other object. Captured image data is converted into binary files that can be stored and manipulated by computer programs.</descrip></descripGrp><ntig><termGrp><term id="107623">scanner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480605">skaner</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masc