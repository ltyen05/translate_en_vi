nd name for the wireless controller for Xbox One.</descrip></descripGrp><ntig><termGrp><term id="2903831">Xbox Wireless Controller</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918424">pult Xbox me valë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38779_2259028_2548216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The brand name for the wireless controller + play &amp; charge kit for Xbox One.</descrip></descripGrp><ntig><termGrp><term id="2259028">Xbox One Wireless Controller + Play &amp; Charge Kit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2548216">Xbox One Wireless Controller + Play &amp; Charge Kit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38782_3132875_3132878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The premium paid online service from Xbox.</descrip></descripGrp><ntig><termGrp><term id="3132875">Xbox Game Pass Core</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3132878">Xbox Game Pass Core</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNo