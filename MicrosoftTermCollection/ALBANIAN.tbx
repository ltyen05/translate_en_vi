ly publish their games on Xbox One or Windows 10 through a short and simplified certification process.</descrip></descripGrp><ntig><termGrp><term id="3145078">Xbox Creators Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918396">Programi Xbox Live Creators</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4512_145048_480857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search method that lets you direct your search using conversational language.</descrip></descripGrp><ntig><termGrp><term id="145048">natural language searching</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480857">kërkim në gjuhë natyrale</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4512_145048_481594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search method that lets you direct your search using conversational language.</descrip></descripGrp><ntig><termGrp><term id="145048">natural language searching</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481594">sintaksa natyrale e pyetësorit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Fem