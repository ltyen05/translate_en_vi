ition">A transfer of personal data across a geographic border (such as country or regional borders).</descrip></descripGrp><ntig><termGrp><term id="3031832">cross-border transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3032722">transferim ndërkufitar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53222_3031833_3032728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy template that helps detect personal data with external, excessive, and idle access and trigger remediation actions including sending notifications to the data or site owners to remove unnecessary accesses.</descrip></descripGrp><ntig><termGrp><term id="3031833">data overexposure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3032728">mbiekspozimi i të dhënave</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53223_3031834_3032726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy template that helps detect personal data that has not been used for more than 90 days and trigger remediation actions, including sending notifications to data owners to apply retention labels or disposing of the information immediately.</descrip></descripGrp><ntig><termGrp><term id="3031834">data minimization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="gramma