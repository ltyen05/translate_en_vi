p></ntig></langSet></termEntry><termEntry id="9590_134813_480767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prevent the writing (recording) of information, usually on a disk.</descrip></descripGrp><ntig><termGrp><term id="134813">write-protect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480767">mbroj nga shkrimi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9596_340142_1900302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option that causes the device to vibrate instead of playing an audible notification or alert tone.</descrip></descripGrp><ntig><termGrp><term id="340142">Vibrate</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1900302">Dridhje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9597_347918_481789"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter effect in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="347918">Grayscale</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481789">Nuancat e së hirtës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type