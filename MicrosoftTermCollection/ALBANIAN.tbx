7441_1188685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that enables users to share pictures, music, videos, documents, and printers with other people on a home network.</descrip></descripGrp><ntig><termGrp><term id="777441">Windows HomeGroup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188685">Grupi i shtëpisë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21417_779020_1188685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that enables users to share pictures, music, videos, documents, and printers with other people on a home network.</descrip></descripGrp><ntig><termGrp><term id="779020">HomeGroup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188685">Grupi i shtëpisë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21430_3007378_3010565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to draw an irregular line, such as a circle or a triangle, around an object that you want to capture.</descrip></descripGrp><ntig><termGrp><term id="3007378">Free-form mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><