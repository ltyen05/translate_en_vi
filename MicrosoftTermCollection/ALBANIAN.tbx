eech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34577_1993411_2003678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business entity allowed for by state statutes in the United States that protects each owner (member) from personal liabilities but is not taxed since it passes all profits and losses to each member who is taxed accordingly.</descrip></descripGrp><ntig><termGrp><term id="1993411">LLC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2003678">shoqëri me përgjegjësi të kufizuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34578_1993412_2003732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An United States tax law designation given to any corporation that elects to pass corporate income, losses, deductions, and credit through to shareholders for federal tax purposes.</descrip></descripGrp><ntig><termGrp><term id="1993412">S corporation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2003732">korporatë S</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34579_1993413_2003741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An official form issued by the US Internal Revenue Service that is 