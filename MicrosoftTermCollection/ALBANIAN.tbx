ile name. When the macro is used, all of the recorded steps are performed automatically. Macros save time by replacing a series of frequently performed steps with a simple key combination or name.</descrip></descripGrp><ntig><termGrp><term id="77118">macro</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480429">makro</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54050_3080961_3081864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in the DATEVALUE Excel function that represents a date in an Excel date format, or a reference to a cell that contains text that represents a date in an Excel date format.</descrip></descripGrp><ntig><termGrp><term id="3080961">date_text</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3081864">date_text</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54051_3080962_3081921"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies a number in the date-time code used by Excel.</descrip></descripGrp><ntig><termGrp><term id="3080962">serial_number</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3081921">serial_number</