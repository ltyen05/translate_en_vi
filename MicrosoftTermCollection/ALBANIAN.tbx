ng="sq"><ntig><termGrp><term id="2878133">raporto</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50926_2878203_2878292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Business solution designed for small businesses and powered by Microsoft 365 and Windows 10, with device management and security features.</descrip></descripGrp><ntig><termGrp><term id="2878203">Microsoft 365 Small Business Premium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2878292">Microsoft 365 Small Business Premium</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50963_2879286_2879842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An inspection of devices, mailboxes, and other types of entities performed automatically in response to various detections, after which remediation actions might be taken on malicious and suspicious items found during the investigation.</descrip></descripGrp><ntig><termGrp><term id="2879286">automated investigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2879842">shqyrtim i automatizuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50964_2879287_2879843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A threat remediation mechanism that automatically applies various actions, such as file quarantine or deletion of persistence mechanism in the registry, based on the results of a corresponding automated investigation.</descrip></descripGrp><ntig><termGrp><term id="2879287">automatic remediation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2879843">masa automatike</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50965_2879288_2879841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query-based proactive threat hunting capability that provides flexible options for locating undetected breach activity as well as network assets that require attention.</descrip></descripGrp><ntig><termGrp><term id="2879288">advanced hunting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2879841">gjurmim i avancuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50966_2879289_2879845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository of reports about emerging threats, including specific incidents and campaigns, threat techniques, and vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="2879289">threat analytics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2879845">analizë rreziku</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50967_2879290_2879844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A malware detonation service that customers can use to submit suspicious files for automated analysis.</descrip></descripGrp><ntig><termGrp><term id="2879290">deep analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2879844">analizë e thelluar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5099_26714_2081850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of establishing predictable behavior in a device.</descrip></descripGrp><ntig><termGrp><term id="26714">calibration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081850">kalibrim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50990_2880077_2880326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability for Game Pass titles to be streamed through the Game Pass ap