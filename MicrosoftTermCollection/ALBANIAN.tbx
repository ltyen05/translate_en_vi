h">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481084">PC pllakë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7949_1671013_1740559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portable computer that allows you to write on or interact with the screen.</descrip></descripGrp><ntig><termGrp><term id="1671013">tablet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1740559">tablet</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7949_1671013_1740564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portable computer that allows you to write on or interact with the screen.</descrip></descripGrp><ntig><termGrp><term id="1671013">tablet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1740564">kompjuter tablet</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7949_1671013_481084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portable computer that allows you to write on or interact with the screen.</descrip></descripGrp><ntig><termGrp><term id="1671013">tablet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481084">PC pllakë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7955_152534_480914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any significant occurrence in the system or an application that requires a user to be notified or an entry to be added to a log.</descrip></descripGrp><ntig><termGrp><term id="152534">event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480914">ngjarje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7956_358359_2291445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that is configured in a Private Branch eXchange (PBX) that allows a subscriber to access their Microsoft Exchange mailbox over the telephone.</descrip></descripGrp><ntig><termGrp><term id="358359">subscriber access number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2291445">numri i qasjes së pajtimtarit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7960_262487_481290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The speed at which the CD drive will record the data.</descrip></descripGrp><ntig><termGrp><term id="262487">CD burner speed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481290">shpejtësia e shkruesit të CD-së</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7967_184982_3014055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item on the Actions menu that displays additional actions the user can select.</descrip></descripGrp><ntig><termGrp><term id="184982">More</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3014055">Më shumë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7971_121145_480687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to technologies for converting textual (ASCII) information into synthetic speech output. Used in voice-processing applications requiring production of broad, unrelated, and unpredictable vocabularies, such as products in a catalog or names and addresses. This technology is appropriate when system design constraints prevent the more efficient use of speech concatenation alone.</descrip></descripGrp><ntig><termGrp><term id="121145">text-to-speech</term><termNote type="p