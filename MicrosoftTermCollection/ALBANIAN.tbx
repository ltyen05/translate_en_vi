35250">manufacturer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2736328">prodhuesi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48375_2735255_2736333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A company that creates software.</descrip></descripGrp><ntig><termGrp><term id="2735255">publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2736333">publikuesi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48376_2735256_2736337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A company that creates drivers.</descrip></descripGrp><ntig><termGrp><term id="2735256">vendor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2736337">shitës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48377_2735257_2736325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To use a session to retrieve a file from a remote computer.</descrip></descripGrp><ntig><termGrp><term id="2735257">get</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2736325">marr</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48378_2735258_2736322"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To use a session to put a file in a remote computer.</descrip></descripGrp><ntig><termGrp><term id="2735258">drop</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2736322">lësho</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48379_2735259_2736336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyword that admins can add to a bookmark such that if it is used in a query, only that specific bookmark will display.</descrip></descripGrp><ntig><termGrp><term id="2735259">reserved keyword</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2736336">fjalë kyçe e rezervuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48388_2735720_2736326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view that allows users to hunt for security threats by reviewing suspicious email and accounts and by searching devices for harmful content.</descrip></descripGrp><ntig><termGrp><term id="2735720">Hunting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2736326">Kërkimi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48389_2735730_2736318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rectangular UI element on a dashboard that contains a report, alerts, and/or related actions and that can be moved or customized by the user.</descrip></descripGrp><ntig><termGrp><term id="2735730">card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2736318">kartë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48390_2735736_2736331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view contains a set of cards that contain information on security and compliance trends and that track the protection status of an organization’s identities, data, devices, apps, and infrastructure.</descrip></descripGrp><ntig><termGrp><term id="2735736">Monitoring &amp; reports</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2736331">Monitorimi dhe raportet</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48405_2736256_2738655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that initiates a proactive search for security threats.</descrip></descripGrp><ntig><termGrp><term id="2736256">Start hunting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2738655">Nis kërkimin</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48406_2736257_2738398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The card that allows users to hunt for email related activities that put users and data at risk, and take action against the threats.</descrip></descripGrp><ntig><termGrp><term id="2736257">Email &amp; data</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2738398">Emaili dhe të dhënat</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48407_2736262_2738392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The card that allows users to hunt for activity that poses a security threat across devices using customizable queries.</descrip></descripGrp><ntig><termGrp><term id="2736262">Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2738392">Pajisjet</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48408_2736263_2738400"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The card that allows users to hunt for suspicious account activity on your network.</descrip></descripGrp><ntig><termGrp><term id="2736263">Identity</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2738400">Identitet</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48409_2736264_2738648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view that allows users to create policies and set up alerts regarding device usage, activities, security, data governance, and device management.</descrip></descripGrp><ntig><termGrp><term id="2736264">Policies</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2738648">Politikat</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected<