nder">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14895_397169_2291274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A third-party hardware device or product that connects a legacy PBX to a LAN. An IP/VoIP gateway translates or converts TDM or telephony circuit-switched protocols to packet switched protocols that can be used on a VoIP-based network.</descrip></descripGrp><ntig><termGrp><term id="397169">IP/VoIP gateway</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2291274">Portëkalimi IP/VoIP</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14897_231964_481109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In statistical or scientific data, a bar that shows the potential error or degree of uncertainty relative to each data marker in a series.</descrip></descripGrp><ntig><termGrp><term id="231964">error bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481109">shiriti i gabimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14901_152051_480913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The points where playback of a file or clip begins and ends. There are two trim points: start trim point and end trim point.</descrip></descripGrp><n