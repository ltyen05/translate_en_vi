"definition">A camera option that enables users to capture moving subjects by snapping multiple photos on shutter press and allowing the user to pick the best one or just accept the photo recommended by the software.</descrip></descripGrp><ntig><termGrp><term id="2067030">burst mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081848">modaliteti në seri</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35725_2067031_2081913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone's LED light used during video capture to help exposure in dark conditions.</descrip></descripGrp><ntig><termGrp><term id="2067031">video light</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081913">drita e videos</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35726_2067032_2081896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows you to sync some of the settings on your phone across all of your Windows 8 devices.</descrip></descripGrp><ntig><termGrp><term id="2067032">sync my settings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2081896">sinkronizo parametrat e mi</term><termNote type="geog