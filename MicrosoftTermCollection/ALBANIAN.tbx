<descripGrp><descrip type="definition">A supplemental program with the filename extension .dll or .exe that extends the capabilities of a program by adding custom commands and specialized features.</descrip></descripGrp><ntig><termGrp><term id="1507691">Component Object Model add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188548">shtesa COM</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17816_650176_1188548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A supplemental program with the filename extension .dll or .exe that extends the capabilities of a program by adding custom commands and specialized features.</descrip></descripGrp><ntig><termGrp><term id="650176">COM add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188548">shtesa COM</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1782_130364_2627335"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The representation of information and data in the form of an image, diagram, or animation. For example, some databases can interpret and show data in the form of a two- or three-dimensional model.</descrip></descripGrp><ntig><termGrp><term id="130364">visualization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2627335">vizualizimi i të dhënave</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1782_2396693_2627335"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The representation of information and data in the form of an image, diagram, or animation. For example, some databases can interpret and show data in the form of a two- or three-dimensional model.</descrip></descripGrp><ntig><termGrp><term id="2396693">visual</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2627335">vizualizimi i të dhënave</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1782_2626823_2627335"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The representation of information and data in the form of an image, diagram, or animation. For example, some databases can interpret and show data in the form of a two- or three-dimensional model.</descrip></descripGrp><ntig><termGrp><term id="2626823">data visualization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2627335">vizualizimi i të dhënave</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></