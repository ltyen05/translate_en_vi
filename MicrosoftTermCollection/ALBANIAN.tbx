al work station or surface during different time periods.</descrip></descripGrp><ntig><termGrp><term id="2816023">hot desking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2817240">sistem me hapësirë pune të përbashkët</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49787_2816024_2817240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An office organization system which involves multiple workers using a single physical work station or surface during different time periods.</descrip></descripGrp><ntig><termGrp><term id="2816024">hot-desking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2817240">sistem me hapësirë pune të përbashkët</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49788_2816025_2817235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that protects against harmful links (URLs) in incoming emails.</descrip></descripGrp><ntig><termGrp><term id="2816025">URL threat protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2817235">mbrojtja ndaj kërcënimeve të URL-ve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammat