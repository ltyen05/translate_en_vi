Grp><descrip type="definition">The Windows 10 update announced at Build 2017 and being released in the Sept-Nov 2017 timeframe.</descrip></descripGrp><ntig><termGrp><term id="2524653">Windows 10 Fall Creators Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2527190">Windows 10 Fall Creators Update</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44825_2524668_2527166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Windows Defender Security Center that monitors your device and provides you with information and recommendations in a Health report to address common issues with your storage capacity, device drivers, battery life, or Windows Update.</descrip></descripGrp><ntig><termGrp><term id="2524668">Health Advisor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2527166">Këshilluesi i integritetit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44826_2524671_2527160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Windows Defender Security Center that helps you refresh your device by reinstalling and updating Windows — for example, if your device has performance issues or you have too many unnecessary apps.</descrip></descripGrp><ntig><termGrp><term id="2524671">Fresh Start</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2527160">Nisja nga fillimi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44827_2524676_2527179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft Remote Desktop app.</descrip></descripGrp><ntig><termGrp><term id="2524676">Microsoft Remote Desktop Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2527179">Paraafishimi i desktopit në largësi të Microsoft</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44827_2524676_2610989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft Remote Desktop app.</descrip></descripGrp><ntig><termGrp><term id="2524676">Microsoft Remote Desktop Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2610989">Paraafishimi i desktopit në largësi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44827_2609623_2527179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft Remote Desktop app.</descrip></descripGrp><ntig><termGrp><term id="2609623">Remote Desktop Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2527179">Paraafishimi i desktopit në largësi të Microsoft</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44827_2609623_2610989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft Remote Desktop app.</descrip></descripGrp><ntig><termGrp><term id="2609623">Remote Desktop Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2610989">Paraafishimi i desktopit në largësi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44828_2524681_2527138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The period of time when users are required to schedule a restart.</descrip></descripGrp><ntig><termGrp><term id="2524681">Engaged restart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2527138">Rinisja e përcaktuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44829_2524692_2527196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system service that enables spatial perception, spatial input, and holographic rendering.</descrip></descripGrp><ntig><termGrp><term id="2524692">Windows Perception Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2527196">Shërbimi i perceptimit i Windows</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4483_55751_1187034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A structured document or template with spaces reserved for entering information and often containing special coding (e.g. to trigger data processing).</descrip></descripGrp><ntig><termGrp><term id="55751">form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1187034">formular</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44832_2524734_2527110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft interactive livestreaming platform for gaming communities.</descrip></descripGrp><ntig><termGrp><term id="2524734">Mixer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2527110">Mixer</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44833_2524736_2527122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that brings together friends, games, and accomplishments across Xbox One and Windows 10 devices. It allows users to stay connected to the Xbox Live community, see what their friends are playing, share game clips and screenshots, and view achievements across devices.</descrip></descripGrp><ntig><termGrp><term id="2524736">Xbox app</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2527122">aplikacioni Xbox</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4484_252109_2622155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authorized simulated attack on a computer system that evaluates the security of a system by identifying weaknesses and strengths.</descrip></descripGrp><ntig><termGrp><term id="252109">penetration test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2622155">testi i depërtimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4484_2621910_2622155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authorized simulated attack on a computer system that evaluates the security of a system by identifying weaknesses and strengths.</descrip></descripGrp><ntig><termGrp><term id="2621910">pen test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2622155">testi i depërtimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44842_2524849_2531177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presentation of visual elements in an image, especially the placement of the subject in relation to other objects.</descrip></descripGrp><ntig><termGrp><term id="2524849">frame</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2531177">kornizë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44843_2524926_2527182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays mixed reality experiences. Used inclusively to denote both Microsoft HoloLens and OEM devices, whether they blend virtual content within the physical world (holographic headsets), or display virtual content with a degree (big or small) of environmental awareness (immersive headsets)​. Plus, these headsets can either be self-contained (like Microsoft HoloLens - the whole computing power is contained into the headset) or PC-connected (the computing power comes from the PC and the headset cannot work without that associated PC).</descrip></descripGrp><ntig><termGrp><term id="2524926">mixed reality headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2527182">kufje e realitetit të përzier</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44843_2524926_2575067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays mixed reality experiences. Used inclusively to denote both Microsoft HoloLens and OEM devices, whether they blend virtual content within the physical world (holographic headsets), or display virtual content with a degree (big or small) of environmental awareness (immersive headsets)​. Plus, these headsets can either be self-contained (like Microsoft HoloLens - the whole computing power is contained into the headset) or PC-connected (the computing power comes from the PC and the headset cannot work without that associated PC).</descrip></descripGrp><ntig><termGrp><term id="2524926">mixed reality headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2575067">kufje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44843_2526431_2527182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays mixed reality experiences. Used inclusively to denote both Microsoft HoloLens and OEM devices, whether they blend virtual content within the physical world (holographic headsets), or display virtual content with a degree (big or small) of environmental awareness (immersive headsets)​. Plus, these headsets can either be self-contained (like Microsoft HoloLens - the whole computing power is contained into the headset) or PC-connected (the computing power comes from the PC and the headset cannot work without that associated PC).</descrip></descripGrp><ntig><termGrp><term id="2526431">headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2527182">kufje e realitetit të përzier</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44843_2526431_2575067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays mixed reality experiences. Used inclusively to denote both Microsoft HoloLens and OEM devices, whether they blend virtual content within the physical world (holographic headsets), or display virtual content with a degree (big or small) of environmental awareness (immersive headsets)​. Plus, these headsets can either be self-contained (like Microsoft HoloLens - the whole computing power is contained into the headset) or PC-connected (the computing power comes from the PC and the headset cannot work without that associated PC).</descrip></descripGrp><ntig><termGrp><term id="2526431">headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2575067">kufje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44844_2524930_2527172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays virtual content only and with a degree (big or small) of environmental awareness. This is a subset of "mixed reality headset."​ This is to be looked at in contrast with "holographic headsets".</descrip></descripGrp><ntig><termGrp><term id="2524930">immersive headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2527172">kufje kredhëse</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44845_2524937_2527185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of moving from a lower version of a system to a higher version. A configuration shift where the user becomes able to change default settings which were locked before the shift.</descrip></descripGrp><ntig><termGrp><term id="2524937">switch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2527185">ndryshim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44846_2524939_2527189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move from a lower version of a system to a higher one, or to shift system configuration in order to change default settings locked before the shift.</descrip></descripGrp><ntig><termGrp><term id="2524939">switch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2527189">ndërroj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44861_2528507_2531178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To arrange visual elements in an image, especially the subject.</descrip></descripGrp><ntig><termGrp><term id="2528507">frame</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2531178">kuadroj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44863_2529677_2530296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft marketing campaign that emphasizes seamless use of Microsoft applications across all devices because users have just one account no matter what device they are using.</descrip></descripGrp><ntig><termGrp><term id="2529677">One Microsoft</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="253029