e><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49934_2825778_2828413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Outlook that allows the user to stop messages from being delivered to the inbox for a specified amount of time.</descrip></descripGrp><ntig><termGrp><term id="2825778">Pause inbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2828413">Pezullo kutinë mbërritëse</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49935_2825779_2828419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Outlook that allows the user to turn off the Pause inbox feature.</descrip></descripGrp><ntig><termGrp><term id="2825779">Unpause</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2828419">Anulo pezullimin</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49936_2825788_2828415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams that turns off notifications to the user's mobile phone for selected hours.</descrip></descripGrp><ntig><termGrp><term id="2825788">Quiet hours</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2828415">Orët e qeta</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49936_2825788_3021151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams that turns off notifications to the user's mobile phone for selected hours.</descrip></descripGrp><ntig><termGrp><term id="2825788">Quiet hours</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3021151">Koha e qetë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49936_3020525_2828415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams that turns off notifications to the user's mobile phone for selected hours.</descrip></descripGrp><ntig><termGrp><term id="3020525">Quiet time</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2828415">Orët e qeta</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49936_3020525_3021151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams that turns off notifications to the user's mobile phone for selected hours.</descrip></descripGrp><ntig><termGrp><term id="3020525">Quiet time</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3021151">Koha e qetë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49937_2825791_2828414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams that turns off notifications to the user's mobile phone for selected days.</descrip></descripGrp><ntig><termGrp><term id="2825791">Quiet days</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2828414">Ditët e qeta</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49938_2825798_2828407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To accept an invitation (such as to a meeting) or a request.</descrip></descripGrp><ntig><termGrp><term id="2825798">accept</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2828407">prano</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49950_2827269_2831428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mathematical process used for removing subexpressions from a mathematical expression, when this removal does not change the meaning or the value of the expression because the subexpressions have equal and opposing effects. For example, a fraction is put in lowest terms by cancelling out the common factors of the numerator and the denominator.</descrip></descripGrp><ntig><termGrp><term id="2827269">cancel out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2831428">thjeshto</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49951_2827271_2831432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To calculate the value of.</descrip></descripGrp><ntig><termGrp><term id="2827271">evaluate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2831432">llogarit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49953_2827274_2831448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To convert a radical in the denominator of an algebraic fraction to a rational number.</descrip></descripGrp><ntig><termGrp><term id="2827274">rationalize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2831448">racionalizo</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49954_2827278_3113224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy in the form of an if-then statement that allows you to apply access controls to access your resources.</descrip></descripGrp><ntig><termGrp><term id="2827278">conditional access policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3113224">politika e aksesit të kushtëzuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49955_2827280_2831433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of removing (through division) the common factor of the terms of an algebraic expression in order to simplify the algebraic expression. For example, the expression 2y + 6 can be simplified by "factoring out" the factor 2 to produce 2(y + 3).</descrip></descripGrp><ntig><termGrp><term id="2827280">factor out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2831433">faktorizo</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49957_2827282_2831436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number written in front of the variable with the largest exponent. For example, in the equation -7x^4 + 2x^3 - 11, the highest exponent is 4. The coefficient for that term is -7, which means that -7 is the leading coefficient.</descrip></descripGrp><ntig><termGrp><term id="2827282">leading coefficient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2831436">koeficient kryesor</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49958_2827286_2831437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An algebraic expression that contains one term, such as: 3xy.</descrip></descripGrp><ntig><termGrp><term id="2827286">monomial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2831437">monom</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49959_2827288_2831452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Either a single number or variable, or numbers and variables multiplied together. For example, the expression 4x - 7 + y = 5 contains four terms: 4x, 7, y, and 5.</descrip></descripGrp><ntig><termGrp><term id="2827288">term</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2831452">kufizë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49960_2827297_2831427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An algebraic expression of the sum or the difference of two terms.</descrip></descripGrp><ntig><termGrp><term id="2827297">binomial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2831427">binom</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49961_2827299_2831429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The property of multiplication whereby when a number is multiplied by the sum of two numbers, the first number can be distributed to both of those numbers and multiplied by each of them separately, and the two products can then be added together for the same result as multiplying the first number by the sum. For example: 2 x (3 + 5) = 2 x 3 + 2 x 5</descrip></descripGrp><ntig><termGrp><term id="2827299">distributive property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2831429">vetia e shpërndarjes</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49962_2827300_2831438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that is the square of an integer; it is the product of some integer with itself. For example, 9 is a perfect square, since it can be written as 3 × 3. Any number multiplied by itself creates a perfect square.</descrip></descripGrp><ntig><termGrp><term id="2827300">perfect square</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2831438">katror i plotë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49962_2827301_2831438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that is the square of an integer; it is the product of some integer with itself. For example, 9 is a perfect square, since it can be written as 3 × 3. Any number multiplied by itself creates a perfect square.</descrip></descripGrp><ntig><termGrp><term id="2827301">square number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2831438">katror i plotë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49963_2827302_2831439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The result of multiplying, or an expression that identifies factors to be multiplied. For example, 15 is the product of 3 and 5, and x(2+x) is the product of x and 2+x.</descrip></descripGrp><ntig><termGrp><term id="2827302">product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2831439">prodhim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49964_2827303_2831430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In mathematics, the operation which is the opposite of multiplication.</descrip></descripGrp><ntig><termGrp><term id="2827303">division</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2831430">pjesëtim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49965_2827304_2831434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A theorem linking factors and zeros of a polynomial.</descrip></descripGrp><ntig><termGrp><term id="2827304">Factor Theorem</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2831434">Teorema e faktorëve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49966_2827305_2831441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Theorem that for a polynomial equation in one variable with integer coefficients to have a solution (root) that is a rational number, the leading coefficient (the coefficient of the highest power) must be divisible by the denominator of the fraction and the constant term (the one without a variable) must be divisible by the numerator.</descrip></descripGrp><ntig><termGrp><term id="2827305">Rational Root Theorem</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2831441">Teorema e rrënjëve racionale</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49967_2827314_2831449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value or values which, when substituted for a variable in an equation, make the equation true.</descrip></descripGrp><ntig><termGrp><term id="2827314">solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2831449">zgjidhje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49968_2827731_2831435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of financial reward offered to partners who help customers successfully deploy and adopt Microsoft 365 services.</descrip></descripGrp><ntig><termGrp><term id="2827731">incentive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2831435">stimul</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49970_2827739_2831453"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An incentive that are based on the usage of Microsoft 365 services.</descrip></descripGrp><ntig><termGrp><term id="2827739">usage incentive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2831453">stimul për përdorimin</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49971_2827744_2831454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined level of usage that determines a usage incentive.</descrip></descripGrp><ntig><termGrp><term id="2827744">usage milestone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2831454">etapë e rëndësishme për përdorimin</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49976_2827830_2832110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Title of the pane that includes emojis and gifs that the user can select to include in an email.</descrip></descripGrp><ntig><termGrp><term id="2827830">Expressions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2832110">Shprehje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49977_2827837_2832230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text in search bar of Microsoft Teams where the user searches for team members.</descrip></descripGrp><ntig><termGrp><term id="2827837">Search for members</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2832230">Kërko për anëtarë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49978_2827838_2832116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text in search bar of Microsoft Teams where the user searches for channels.</descrip></descripGrp><ntig><termGrp><term id="2827838">Search for channels</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2832116">Kërko për kanale</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49979_2827839_2832244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text in search bar of Microsoft Teams (Teams --&gt; Settings) where the user searches for a team.</descrip></descripGrp><ntig><termGrp><term id="2827839">Search teams</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2832244">Kërko ekipet</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4998_38616_2291163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that can logically contain other objects. For example, a folder is a container object.</descrip></descripGrp><ntig><termGrp><term id="38616">container object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2291163">objekti i kontejnerit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49983_2827856_2832247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The title of a scheduled call in Skype.</descrip></descripGrp><ntig><termGrp><term id="2827856">Title</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2832247">Titulli</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><te