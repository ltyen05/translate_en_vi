0_3007198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The in-browser VPN service built into Microsoft Edge that allows  users to add additional protection by  hiding  their IP address as  traffic is routed  through an encrypted tunnel.</descrip></descripGrp><ntig><termGrp><term id="3006850">Microsoft Edge Secure Network</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3007198">Rrjeti i sigurt i Microsoft Edge</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52937_3007291_3007401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard layout for Japanese characters that places keys in a 3x4 grid.</descrip></descripGrp><ntig><termGrp><term id="3007291">12-key layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="3007401">strukturë me 12 taste</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52938_3007292_3007402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard layout for Japanese characters that places keys in a grid with 5 rows, making it easier for Japanese speakers to find a specific Hiragana character.</descrip></descripGrp><ntig><termGrp><term id="3007292">50-on layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></la