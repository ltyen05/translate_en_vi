-US"><descripGrp><descrip type="definition">A method of blocking access to websites based on their content. For example, In Windows Live Family Safety, parents can specify a filtering level, such as Strict or Basic, for their child.</descrip></descripGrp><ntig><termGrp><term id="1045704">web filtering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1519807">filtrim i uebit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22482_1045718_2291249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person authorized to manage and make certain changes to a group, such as to approve a membership request.</descrip></descripGrp><ntig><termGrp><term id="1045718">group owner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2291249">pronari i grupit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22490_1045759_1188737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio or video file that you rent from an online store, typically for a monthly fee.</descrip></descripGrp><ntig><termGrp><term id="1045759">subscription file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188737">skedari i pajtimit</term><termNote type="geogra