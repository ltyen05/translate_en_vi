n">A portion of a software window bounded by and separated from other portions by vertical or horizontal bars and having a separate function.</descrip></descripGrp><ntig><termGrp><term id="1546384">window pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480523">pjesë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5077_90456_480523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portion of a software window bounded by and separated from other portions by vertical or horizontal bars and having a separate function.</descrip></descripGrp><ntig><termGrp><term id="90456">pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480523">pjesë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50777_2873906_2874214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The interface in Microsoft Edge that allows users to customize their browser's appearance, privacy &amp; security options, and other configuration options.</descrip></descripGrp><ntig><termGrp><term id="2873906">Settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2874214">Parametrat</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50778_2873907_2874215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The video camera capture mode for in which users can take slow-motion videos.</descrip></descripGrp><ntig><termGrp><term id="2873907">Slow-mo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2874215">Ngadalësim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50779_2873908_2874217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information stream in MS Launcher relating to the user's work profile that contains information from their calendar, tasks to be completed, notes, etc.</descrip></descripGrp><ntig><termGrp><term id="2873908">work feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2874217">buletini i punës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5083_148996_1914823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shape in an organization chart that is placed below and connected to a superior (or manager) shape.</descrip></descripGrp><ntig><termGrp><term id="148996">subordinate shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914823">forma e varur</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5085_27452_480049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An (API) that is provided as part of Microsoft Windows. CryptoAPI provides a set of functions that allow applications to encrypt or digitally sign data in a flexible manner while providing protection for the user's sensitive private key data. Actual cryptographic operations are performed by independent modules known as (CSPs).</descrip></descripGrp><ntig><termGrp><term id="27452">CAPI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480049">CAPI</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5085_27452_480050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An (API) that is provided as part of Microsoft Windows. CryptoAPI provides a set of functions that allow applications to encrypt or digitally sign data in a flexible manner while providing protection for the user's sensitive private key data. Actual cryptographic operations are performed by independent modules known as (CSPs).</descrip></descripGrp><ntig><termGrp><term id="27452">CAPI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480050">CryptoAPI</term><termNote type="geographi