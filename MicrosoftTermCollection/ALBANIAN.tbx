es to read later.</descrip></descripGrp><ntig><termGrp><term id="2277931">reading list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2280440">lista e leximit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39268_2277946_2322062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit in the Office Graph that represents a connection between one entity and another, or a relationship between entities.</descrip></descripGrp><ntig><termGrp><term id="2277946">Office Graph edge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2322062">Skaji i grafit të Office</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39269_2277947_2322063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit in the Office Graph that represents an entity, an action or a relationship between people, items, and people and items across Office 365.</descrip></descripGrp><ntig><termGrp><term id="2277947">Office Graph node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2322063">Nyja e grafit të Office</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><ter