g></langSet></termEntry><termEntry id="50493_2857916_2859738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Generic term for solutions that can detect and block mobile cybersecurity threats from harming an organization through mobile devices (iOS and Android).</descrip></descripGrp><ntig><termGrp><term id="2857916">MTD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2859738">mbrojtje nga rreziqet portative</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50494_2857917_2859743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A linked object that could contain a virus or other threat.</descrip></descripGrp><ntig><termGrp><term id="2857917">unsafe linked object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2859743">objekt i lidhur, i pasigurt</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50496_2858214_2859746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Office app for mobile devices that allows users to dictate and record their dictation in MSWord.</descrip></descripGrp><ntig><termGrp><term id="2858214">Word Dictation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2859746">Diktim në "Word"</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50497_2858228_2866161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component-based document model for developers who create collaborative text editing apps that includes options for real-time sharing of edits within documents, shared editable templates, and rich content editing options.</descrip></descripGrp><ntig><termGrp><term id="2858228">Microsoft Fluid Framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2866161">Kuadër fluid</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50497_2858228_2866164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component-based document model for developers who create collaborative text editing apps that includes options for real-time sharing of edits within documents, shared editable templates, and rich content editing options.</descrip></descripGrp><ntig><termGrp><term id="2858228">Microsoft Fluid Framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2866164">Kuadri fluid i "Microsoft"</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50497_2858231_2866161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component-based document model for developers who create collaborative text editing apps that includes options for real-time sharing of edits within documents, shared editable templates, and rich content editing options.</descrip></descripGrp><ntig><termGrp><term id="2858231">Fluid Framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2866161">Kuadër fluid</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50497_2858231_2866164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component-based document model for developers who create collaborative text editing apps that includes options for real-time sharing of edits within documents, shared editable templates, and rich content editing options.</descrip></descripGrp><ntig><termGrp><term id="2858231">Fluid Framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2866164">Kuadri fluid i "Microsoft"</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50498_2858264_2859737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of hours the person spent in meetings with at least one other person.</descrip></descripGrp><ntig><termGrp><term id="2858264">meeting hours</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2859737">orë në takime</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50499_2858268_2859732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of hours the person spent sending and reading email.</descrip></descripGrp><ntig><termGrp><term id="2858268">email hours</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2859732">orët e emailit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50500_2858270_2859748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The lack of opposition between work and other life roles. It is the state of equilibrium in which demands of personal life, professional life, and family life are equal.</descrip></descripGrp><ntig><termGrp><term id="2858270">work-life balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2859748">ekulibër punë-jetë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50501_2858273_2859742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a manager, or to a meeting involving a manager, "skip-level" refers to the employee's manager's manager, sometimes referred to as "second line manager". A skip-level manager is the manager of the employee's manager. A skip-level meeting is a meeting between an employee and the manager of his or her manager.</descrip></descripGrp><ntig><termGrp><term id="2858273">skip-level</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2859742">përgjegjës më i lartë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50502_2858291_2859731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collective name for character images with multiple poses, emotions and props.</descrip></descripGrp><ntig><termGrp><term id="2858291">cutout people</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2859731">poza njerëzish</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50507_2860396_2861354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function in Office apps for mobile phones that allows users to make content (text, buttons, etc.) larger.</descrip></descripGrp><ntig><termGrp><term id="2860396">large content viewer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2861354">shikues i përmbajtjes së zmadhuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50508_2860488_2860870"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to import their financial transactions into Excel so they can view and organize their finances in one place and obtain personalized insights.</descrip></descripGrp><ntig><termGrp><term id="2860488">Money in Excel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2860870">Financa në "Excel"</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50509_2860564_2860873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft marketing campaign to promote The Art of Teamwork [50467], a framework, toolkit, and digital curriculum to equip our customers with the tools to practice the five key dynamics to successful teamwork.</descrip></descripGrp><ntig><termGrp><term id="2860564">The Art of Teamwork Campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2860873">Fushata e aftësisë së punës në grup</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50510_2860565_2860871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Collaboration between members of a group organized around a common responsibility, interest, or objective.</descrip></descripGrp><ntig><termGrp><term id="2860565">teamwork</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2860871">punë në grup</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50512_2860581_2860875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to enter into situations that involve risk and emotional exposure.</descrip></descripGrp><ntig><termGrp><term id="2860581">vulnerability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2860875">cenueshmëri</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50513_2860582_2860874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feeling that ensues from knowing you can be vulnerable with someone without being put down or hurt.</descrip></descripGrp><ntig><termGrp><term id="2860582">trust</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2860874">besim</term><termNote type="geographicalUsage">ALB</termNote><te