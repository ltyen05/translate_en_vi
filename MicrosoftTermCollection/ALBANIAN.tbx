em</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2508663">driveItem</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44558_2506546_2511966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of code that application developers can use to make calls to an API in an easier way than using the raw transport.</descrip></descripGrp><ntig><termGrp><term id="2506546">client library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2511966">biblioteka e klientit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44559_2506547_2511978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The client library that can be used to make calls to Microsoft Graph.</descrip></descripGrp><ntig><termGrp><term id="2506547">Microsoft Graph Client Library</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2511978">Biblioteka e klientit të Microsoft Graph</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44560_2506548_2512009"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A packet of bytes meant to transfer a small amount of data between programs.</descrip></descripGrp><ntig><termGrp><term id="2506548">token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2512009">kodi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44561_2506549_2512013"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An opaque token provided by Microsoft Graph to a notification URL that needs to be provided back to Microsoft Graph in order to validate ownership of the notification URL.</descrip></descripGrp><ntig><termGrp><term id="2506549">validation token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2512013">kodi i miratimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44562_2506550_2511970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A querying functionality that enables applications to discover newly created, updated, or deleted entities without performing a full read of the target resource with every request.</descrip></descripGrp><ntig><termGrp><term id="2506550">delta query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><ter