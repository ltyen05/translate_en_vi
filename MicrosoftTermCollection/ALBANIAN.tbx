Grp><term id="2505368">VoiceOver</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2445034">Udhëzuesi i kornizës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43061_2439289_2445040"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Graph tool that populates a graph from a set of input entities (documents, people, etc.) and the relationships between them.</descrip></descripGrp><ntig><termGrp><term id="2439289">Sets</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2445040">Bashkësitë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43062_2439290_2449219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Graph tool that allows developers to create and explore sets, create and manage permissions on sets, perform queries on sets, and manage sets and their relationships.</descrip></descripGrp><ntig><termGrp><term id="2439290">Sets Studio</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2449219">Studioja e bashkësive</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43063_2439291_2442191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables users to discover the usage level of their Office productivity apps compared with non-Office productivity apps and get high level insights of productivity application usage within their organization over time.</descrip></descripGrp><ntig><termGrp><term id="2439291">Productivity App Discovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2442191">Productivity App Discovery</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43064_2439292_2445033"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud-based set of security features that identify high-risk and abnormal usage and that provide granular control over security policies.</descrip></descripGrp><ntig><termGrp><term id="2439292">Office 365 Advanced Security Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2445033">Menaxhimi i përparuar i sigurisë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43064_2439292_2445037"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud-based set of security features that identify high-risk and abnormal usage and that provide granular control over security policies.</descrip></descripGrp><ntig><termGrp><term id="2439292">Office 365 Advanced Security Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2445037">Menaxhimi i përparuar i sigurisë i Office 365</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43064_2439293_2445033"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud-based set of security features that identify high-risk and abnormal usage and that provide granular control over security policies.</descrip></descripGrp><ntig><termGrp><term id="2439293">Advanced Security Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2445033">Menaxhimi i përparuar i sigurisë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43064_2439293_2445037"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud-based set of security features that identify high-risk and abnormal usage and that provide granular control over security policies.</descrip></descripGrp><ntig><termGrp><term id="2439293">Advanced Security Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lan