="en-US"><descripGrp><descrip type="definition">A row or column that uses a summary function to display the total of detail items in a PivotTable field.</descrip></descripGrp><ntig><termGrp><term id="231975">PivotTable subtotal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914874">nëntotali i PivotTable</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15317_126865_480717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Easy to learn and easy to use.</descrip></descripGrp><ntig><termGrp><term id="126865">user-friendly</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480717">i lehtë në përdorim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15319_52477_2998502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The operation in which a number is raised to a given power, as in 23. In computer programs and programming languages, exponentiation is often shown by a caret (^), as in 2^3.</descrip></descripGrp><ntig><termGrp><term id="52477">exponentiation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2998502">fuqizim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</t