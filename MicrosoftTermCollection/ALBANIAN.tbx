">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34419_1991529_2918026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The audio speaker on the headset.</descrip></descripGrp><ntig><termGrp><term id="1991529">earpiece</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918026">kufje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34420_1991530_2918100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cable attached to the headset.</descrip></descripGrp><ntig><termGrp><term id="1991530">headset cable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918100">kabllo kufjesh</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34421_1991531_2918104"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button on the wireless headset used to make a permanent attachment between the headset and console. Connect button acceptable.</descrip></descripGrp><ntig><termGrp><term id="1991531">headset connect button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918104">buton për lidhjen e kufjeve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34422_1991532_2918105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The connector at the end of the headset cable.</descrip></descripGrp><ntig><termGrp><term id="1991532">headset connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918105">konektor kufjesh</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34423_1991533_2918189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The muting control on the headset.</descrip></descripGrp><ntig><termGrp><term id="1991533">mute button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918189">butoni i heshtjes</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34424_1991534_2918340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The volume dial on the headset.</descrip></descripGrp><ntig><termGrp><term id="1991534">volume control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918340">komandë volumi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34425_1991535_2918364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox 360 wired audio headset.</descrip></descripGrp><ntig><termGrp><term id="1991535">Xbox 360 Headset</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918364">kufje për Xbox 360</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34426_1991536_2918349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox 360 text input device that attaches to the controller, allowing text communication between players.</descrip></descripGrp><ntig><termGrp><term id="1991536">Xbox 360 Chatpad</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918349">pult bisede për Xbox 360</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34427_1991537_2918377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox 360 rechargeable audio headset.</descrip></descripGrp><ntig><termGrp><term id="1991537">Xbox 360 Wireless Headset</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918377">kufje me valë për Xbox 360</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34428_1991538_2918378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox 360 wireless microphone.</descrip></descripGrp><ntig><termGrp><term id="1991538">Xbox 360 Wireless Microphone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918378">mikrofon me valë për Xbox 360</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34429_1991539_2918370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The universal Xbox 360 remote control. Works with the console and can be programmed to be used with your TV.</descrip></descripGrp><ntig><termGrp><term id="1991539">Xbox 360 Universal Media Remote</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918370">telekomandë universale multimediale për Xbox 360</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34430_1991540_2918386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The system display that appears at start-up, and outside of games, media, etc.</descrip></descripGrp><ntig><termGrp><term id="1991540">Xbox Dashboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918386">paneli i Xbox</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34431_1991541_2918389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The heads-up display that appears in-game, in-media, etc.</descrip></descripGrp><ntig><termGrp><term id="1991541">Xbox Guide</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918389">Udhëzuesi i Xbox</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34432_1991542_2918051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Settings that allow parents/guardians to manage the content allowed on the console.</descrip></descripGrp><ntig><termGrp><term id="1991542">family settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918051">cilësimet e familjes</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34433_1991543_2917896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The height, weight, year of birth, and gender that a user chooses to enter as their personal physical characteristics for fitness tracking.</descrip></descripGrp><ntig><termGrp><term id="1991543">attributes</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2917896">atributet</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34434_1991544_2918039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Estimates of the results of your physical activity, including calories burned, time spent playing, and physical intensity of movements.</descrip></descripGrp><ntig><termGrp><term id="1991544">exercise stats</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918039">statistika të ushtrimeve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34435_1991545_2918059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of game that supports the monitoring and recording of exercise stats from a fitness tracking device worn by a player.</descrip></descripGrp><ntig><termGrp><term id="1991545">fitness tracking game</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918059">lojë gjurmimi fizkulture</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34436_1991546_2918057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of device worn during exercise that estimates your exercise stats based on your level of physical activity.</descrip></descripGrp><ntig><termGrp><term id="1991546">fitness tracking device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918057">pajisje gjurmimi fizkulture</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34437_1991547_2918268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A legal notice that describes the properties of the system.</descrip></descripGrp><ntig><termGrp><term id="1991547">system information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918268">informacion i sistemit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34438_1991548_2918270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A legal notice that establishes the terms under which service is provided.</descrip></descripGrp><ntig><termGrp><term id="1991548">terms of use</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918270">kushte përdorimi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34439_1991549_2918255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that applications must display when unable to establish a connection to a required non-Xbox Live server or web service.</descrip></descripGrp><ntig><termGrp><term id="1991549">Sorry, [video service name/web service name] isn't available right now. Please try again later. For more information, go to www.xbox.com/status.</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918255">Na vjen keq, [video service name/web service name] nuk ofrohet për momentin. Provo sërish më vonë. Për më shumë informacion, shko te www.xbox.com/status.</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3444_14266_479957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move selected items to another location for long term storage.</descrip></descripGrp><ntig><termGrp><term id="14266">archive</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="479957">arkivoj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34440_1991550_2918275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that applications must display when Xbox privacy and online settings prevent the sharing of video status.</descrip></descripGrp><ntig><termGrp><term id="1991550">The Video and Music Status setting for [gamertag1, gamertag2, gamertag3, gamertags4] is set to allow apps to show titles of videos you watch in your Xbox Live online status.</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918275">Cilësimi i statusit të videos dhe të muzikës për [gamertag1, gamertag2, gamertag3, gamertags4] është caktuar t’u lejojë aplikacioneve të t’i shfaqin në statusin e linjës së Xbox Live titujt e videove që je duke parë.</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34441_1991551_2917889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that applications must display if they will serve third-party advertising and cannot contractually guarantee that they will meet the Xbox Creative Acceptance Policy (CAP) for advertising content. The need for this disclaimer will be determined contractually prior to certification, and the inability to comply should be indicated during application submission. Talk to your Developer Account Manager for additional details.</descrip></descripGrp><ntig><termGrp><term id="1991551">All content in this Application, including advertising content, is provided by [video service name].</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2917889">E gjithë përmbajtja në këtë aplikacion, duke përfshirë përmbajtjen reklamuese, ofrohet [video service name].</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34442_1991552_2918273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that game titles must display when unable to establish a connection to a required non-Xbox Live server or web service. This message also applies to Xbox games on Windows Phone.</descrip></descripGrp><ntig><termGrp><term id="1991552">The [game name] service is not available. Please try again later.</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2918273">Shërbimi [game name] nuk disponohet. Provo sërish më vonë.</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34443_1991553_2922035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live Arcade menu item.</descrip></descripGrp><ntig><termGrp><term id="1991553">leaderboards</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lan