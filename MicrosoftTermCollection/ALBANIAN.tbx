Usage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16469_1373758_1914972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that plots numerical data along two value axes (x,y).</descrip></descripGrp><ntig><termGrp><term id="1373758">point chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914972">grafik me shpërndarje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16469_1373758_1914973"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that plots numerical data along two value axes (x,y).</descrip></descripGrp><ntig><termGrp><term id="1373758">point chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914973">grafik XY</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16469_588932_1914972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that plots numerical data along two value axes (x,y).</descrip></descripGrp><ntig><termGrp><term id="588932">scatter chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1