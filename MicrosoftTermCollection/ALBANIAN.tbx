ctive Directory replication, and controls access to network resources.</descrip></descripGrp><ntig><termGrp><term id="47632">domain controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1186994">kontrolluesi i domenit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1848_47632_481514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an Active Directory forest, a server that contains a writable copy of the Active Directory database, participates in Active Directory replication, and controls access to network resources.</descrip></descripGrp><ntig><termGrp><term id="47632">domain controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481514">DC</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1850_232861_1914908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Office Word document that contains hyperlinks to another location. You can use hyperlinks to go to another location in the same document or to another file on your hard disk, your network, an intranet, or the Internet.</descrip></descripGrp><ntig><termGrp><term id="232861">Word publication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914908">publikim në Word</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18517_2199065_1915001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A picture that is stored within a document rather than being linked to a source file outside of the document.</descrip></descripGrp><ntig><termGrp><term id="2199065">embedded image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915001">imazh i trupëzuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18517_650871_1915001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A picture that is stored within a document rather than being linked to a source file outside of the document.</descrip></descripGrp><ntig><termGrp><term id="650871">embedded picture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915001">imazh i trupëzuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18523_650877_1188555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An address similar to a URL that provides network access to an event, such as a live broadcast. Attendees go to this address to view the event from their computers.</descrip></descripGrp><ntig><termGrp><term id="650877">event address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188555">adresa e ngjarjes</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18525_650879_1806108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text string that unambiguously refers to a hardware or software component under a certain context and can be used to access the data in that component.</descrip></descripGrp><ntig><termGrp><term id="650879">identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1806108">identifikues</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18529_650883_1188556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that is stored outside of the application that is currently in use.</descrip></descripGrp><ntig><termGrp><term id="650883">external data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188556">të dhënat e jashtme</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18530_650884_1188557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range of data that is brought into a worksheet but that originates outside of Excel, such as in a database or text file.</descrip></descripGrp><ntig><termGrp><term id="650884">external data range</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188557">diapazoni i të dhënave të jashtme</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18535_650889_1915002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pane located on top of the Navigation Pane that has copies of your Inbox, Sent Items, and so on. You can add, remove, and arrange folders in this pane. Collapse or expand the pane by clicking the arrow in the Favorite Folders header.</descrip></descripGrp><ntig><termGrp><term id="650889">Favorite Folders</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915002">Dosjet e parapëlqyera</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18536_650890_1188558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that identifies a field in a PivotTable or PivotChart report. You can drag the field buttons to change the layout of the report, or click the arrows next to the buttons to change the level of detail displayed in the report.</descrip></descripGrp><ntig><termGrp><term id="650890">field button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188558">butoni i fushës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18538_650892_1188559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of PivotTable or PivotChart view that contains filter fields.</descrip></descripGrp><ntig><termGrp><term id="650892">filter area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188559">zona e filtrit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18539_650893_1188560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field in the filter area that you can use to filter data displayed in PivotTable or PivotChart view. Filter fields perform the same functions as page fields in Microsoft Excel PivotTable reports.</descrip></descripGrp><ntig><termGrp><term id="650893">filter field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188560">fusha e filtrit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18542_650896_1463817"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date that a project or task is scheduled to be completed. This date is based on the task's start date, duration, calendars, predecessor dates, task dependencies, and constraints.</descrip></descripGrp><ntig><termGrp><term id="650896">finish date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1463817">data e përfundimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18549_650903_1188561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Internet Web page or intranet page that is associated with an Outlook folder. If a page has been associated with the folder and the option is set, the Web page appears in the Outlook window whenever you select the folder.</descrip></descripGrp><ntig><termGrp><term id="650903">folder home page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188561">faqja bazë e dosjeve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1855_307383_481474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of validating software with the manufacturer. Activation confirms the genuine status of a product and that the product key has not been compromised. It establishes a relationship between the software’s product key and a particular installation of that software on a device.</descrip></descripGrp><ntig><termGrp><term id="307383">activation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481474">aktivizim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18551_650905_1188562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location on a computer's hard drive to store a local copy of a form to improve performance when opening a form subsequent times.</descrip></descripGrp><ntig><termGrp><term id="650905">forms cache</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188562">memorie për formularë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18558_650912_1188563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method to find a specific value for a cell by adjusting the value of one other cell. When goal seeking, Excel varies the value in a cell that you specify until a formula that's dependent on that cell returns the result you want.</descrip></descripGrp><ntig><termGrp><term id="650912">goal seek</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188563">kërkimi i vlerës hyrëse</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18559_650913_1806107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rank or category assigned to a material resource that denotes functional use but not level of quality. A low-grade resource is not necessarily a low-quality resource.</descrip></descripGrp><ntig><termGrp><term id="650913">grade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1806107">gradë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1856_52994_1914689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Expressed as n! (n factorial), the result of multiplying the successive integers from 1 through n; n! equals n x (n - 1) x (n - 2) x ... x 1.</descrip></descripGrp><ntig><termGrp><term id="52994">factorial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1914689">faktorial</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18560_650914_1188564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The faint vertical and horizontal lines that appear in the drawing window when the grid is turned on. You can use grid lines to help position shapes precisely.</descrip></descripGrp><ntig><termGrp><term id="650914">grid lines</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188564">vijat e rrjetës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18561_650915_1188565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The point that defines the layout of grid lines on the drawing page. A vertical grid line and a horizontal grid line pass through the grid origin, and all other grid lines are drawn at specified intervals from these reference lines.</descrip></descripGrp><ntig><termGrp><term id="650915">grid origin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188565">origjina e rrjetës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128261_480722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128261">vertical bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480722">shirit vertikal</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128261_480723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128261">vertical bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480723">vijë vertikale</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128262_480722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128262">VERTICAL LINE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480722">shirit vertikal</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128262_480723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128262">VERTICAL LINE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480723">vijë vertikale</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128263_480722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128263">pipe</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480722">shirit vertikal</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128263_480723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128263">pipe</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480723">vijë vertikale</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18583_650937_1915003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone number format for dialing any call from any location or with a calling card.</descrip></descripGrp><ntig><termGrp><term id="650937">international format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915003">format ndërkombëtar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18585_650939_1188567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that connects fields between two tables and shows how the data is related. The type of join indicates which records are selected for the query's result set.</descrip></descripGrp><ntig><termGrp><term id="650939">join line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188567">vija e bashkimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18587_650941_1188568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The special characters used to extend the joiner between two Arabic characters. Used to improve the appearance of justified text by visually lengthening words rather than increasing the spacing between words. Can also function like a hyphen.</descrip></descripGrp><ntig><termGrp><term id="650941">kashidas</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188568">kashidas</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18590_650944_1463818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Resolving resource conflicts or overallocations by delaying or splitting certain tasks. When Project levels a resource, its selected assignments are distributed and rescheduled.</descrip></descripGrp><ntig><termGrp><term id="650944">leveling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1463818">nivelim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18594_650948_1188569"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of cascading style sheet that exists in a separate file and is referenced throughout one or more Web pages.</descrip></descripGrp><ntig><termGrp><term id="650948">linked style sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188569">stili i lidhur i fletës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18598_650952_1915004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character, usually a comma or semicolon, that separates elements in a list.</descrip></descripGrp><ntig><termGrp><term id="650952">list-separator character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915004">karakteri ndarës i listës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="186_3712_1186980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change to a newer, and/or more powerful or sophisticated version of a product.</descrip></descripGrp><ntig><termGrp><term id="3712">upgrade</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1186980">përmirësoj</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18601_650955_1915005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendar that is based on cycles of the moon phase.</descrip></descripGrp><ntig><termGrp><term id="650955">Lunar calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915005">kalendar hënor</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18604_650958_1915006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range in an XML list that has been linked to an element in an XML map.</descrip></descripGrp><ntig><termGrp><term id="650958">mapped range</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915006">rang i shoqëruar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18605_650959_1463819"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shape on a stencil that you use repeatedly to create drawings. When you drag a shape from a stencil onto the drawing page, the shape becomes an instance of that master.</descrip></descripGrp><ntig><termGrp><term id="650959">master shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1463819">formë model</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18614_650968_1915007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tone in a picture that is in the middle of the tonal range, between the lightest and darkest tones</descrip></descripGrp><ntig><termGrp><term id="650968">midtone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915007">nuancë e ndërmjetme</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1881_68580_480363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that enables a program to work with the user (the user interface, which can be a command-line interface, menu-driven, or a graphical user interface), with another program such as the operating system, or with the computer's hardware.</descrip></descripGrp><ntig><termGrp><term id="68580">interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480363">ndërfaqe</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1883_318780_481635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The = character.</descrip></descripGrp><ntig><termGrp><term id="318780">equal sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481635">Shenja e barazimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18831_651182_1915008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that does not have strong right-to-left or left-to-right language attributes.</descrip></descripGrp><ntig><termGrp><term id="651182">neutral character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915008">karakter neutral</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18840_651191_1915009"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file you create on your hard disk or a network share to store OLAP source data for a PivotTable or PivotChart report. Offline cube files allow you to keep working when you are not connected to the OLAP server.</descrip></descripGrp><ntig><termGrp><term id="651191">offline cube file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915009">skedari i kubit jashtë linje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1885_69963_1188361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability for two or more software applications to work together with little effort from the user.</descrip></descripGrp><ntig><termGrp><term id="69963">interoperability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188361">ndërveprueshmëri</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18851_651202_1463820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The result of assigning more tasks to a resource than the resource can accomplish in the working time available.</descrip></descripGrp><ntig><termGrp><term id="651202">overallocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1463820">mbirezervim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18860_651211_1806128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Principles that guide developers as they assign responsibilities to software classes and design system behavior. They are most useful when creating collaboration diagrams where messages imply responsibility.</descrip></descripGrp><ntig><termGrp><term id="651211">patterns</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1806128">kritere</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18862_651213_1915010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that you use to enter or display how much of a task has been completed. This value is expressed as the percentage of the task duration that has been completed.</descrip></descripGrp><ntig><termGrp><term id="651213">percent complete</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915010">përqindja e përfunduar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18865_651216_1188570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of a list, SharePoint document library, or Web Part Page that is available only to a particular user.</descrip></descripGrp><ntig><termGrp><term id="651216">personal view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188570">pamje personale</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18873_651224_1463821"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A schedule of task start and finish dates and resource and cost data.</descrip></descripGrp><ntig><termGrp><term id="651224">plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1463821">plan</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18876_651227_1915011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of projects within an organization that may share common management of scope, budget, or resources.</descrip></descripGrp><ntig><termGrp><term id="651227">portfolio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915011">portofol</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18877_651228_1463822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Placing elements, such as text and graphics, on a page to let the page author control the exact location and layer order of a page element.</descrip></descripGrp><ntig><termGrp><term id="651228">positioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1463822">pozicionim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18878_651229_1915012"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bookmark that Microsoft Word automatically sets in each document.</descrip></descripGrp><ntig><termGrp><term id="651229">predefined bookmark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915012">shenjë e referimit e parapërcaktuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18891_651242_1463823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of excellence, or the desired standards, in a product, process, or project.</descrip></descripGrp><ntig><termGrp><term id="651242">quality</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1463823">cilësi</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18892_651243_1915013"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A default color category that is assigned to an item when you click the Categories column for the item in your Inbox or other table view. You set this color category from the Categorize menu.</descrip></descripGrp><ntig><termGrp><term id="651243">Quick Click category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915013">kategoria e klikimit të shpejtë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18894_651245_1806110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move a task to a lower outline level [to the right] in the Task Name field. When you indent a task, it becomes a subtask of the nearest preceding task at a higher outline level.</descrip></descripGrp><ntig><termGrp><term id="651245">indent</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1806110">zhvendos një nivel më poshtë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18895_651246_1915014"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task that occurs repeatedly during the course of a project. For example, you might define the weekly status meeting as a recurring task.</descrip></descripGrp><ntig><termGrp><term id="651246">recurring task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNot