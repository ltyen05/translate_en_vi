="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2060712">Kredite të Skype</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33613_1805604_2060646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to see Skype activity, change settings, and purchase Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1805604">Skype account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2060646">llogari</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33613_1805604_2060708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to see Skype activity, change settings, and purchase Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1805604">Skype account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2060708">llogari në Skype</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33613_1805605_2060646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to see Skype activity, change settings, and purchase Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1805605">account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2060646">llogari</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33613_1805605_2060708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to see Skype activity, change settings, and purchase Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1805605">account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2060708">llogari në Skype</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33614_1805607_2060652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Skype feature that enables automatic payments so that the user doesn't run out of Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1805607">auto top-up</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2060652">rimbushje automatike</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33614_1805608_2060652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Skype feature that enables automatic payments so that the user doesn't run out of Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1805608">auto-recharge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2060652">rimbushje automatike</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33615_1805609_2060653"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that repeatedly redials the desired number until the user gets through.</descrip></descripGrp><ntig><termGrp><term id="1805609">auto-redial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2060653">rithirrje automatike</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33616_1805610_2060654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that indicates a user is not at his/her computer and that either automatically appears when he/she has not been active for a long period of time or when it has been manually selected.</descrip></descripGrp><ntig><termGrp><term id="1805610">Away</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></lan