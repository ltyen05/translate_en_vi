">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25907_1231852_1372833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the code of conduct, which contains rules that explain how someone should behave while using a service or product.</descrip></descripGrp><ntig><termGrp><term id="1231852">Code of Conduct</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1372833">Kodi i sjelljes</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25912_1231866_1806123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2010 edition of the Microsoft messaging and collaboration client software for personal computers accessing Microsoft Exchange Server-based email and collaboration services.</descrip></descripGrp><ntig><termGrp><term id="1231866">Microsoft Outlook 2010</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1806123">Microsoft Outlook 2010</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25917_1231890_1995300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to photos that only you and people that you select can view (versus public photos that anyone can view).</descrip><