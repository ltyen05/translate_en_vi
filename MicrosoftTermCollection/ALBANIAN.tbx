707154_2088130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that enables IT pros to monitor usage, error, and compatibility issue information from Office related solutions on client machines across an organization.</descrip></descripGrp><ntig><termGrp><term id="1707154">Office Telemetry Dashboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2088130">Tabela e kontrollit të telemetrisë së Office</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32308_1648801_1915409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A metadata column or field in a Key Filters control.</descrip></descripGrp><ntig><termGrp><term id="1648801">key filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915409">filtër i çelësit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32309_1649246_1915410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dashboard where admins can track the overall health of the apps in a site collection or tenancy.</descrip></descripGrp><ntig><termGrp><term id="1649246">App Monitor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915410">Monitorimi i aplikacioneve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32311_1649249_1915411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gallery of objects that provides different ways of visualizing data.</descrip></descripGrp><ntig><termGrp><term id="1649249">interactive view gallery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915411">galeria e pamjeve ndërvepruese</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32312_1649250_1915412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual summary of the user's favorite contacts and People search functionality, which is displayed in a callout without switching to the People view.</descrip></descripGrp><ntig><termGrp><term id="1649250">People peek</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915412">Vështrim i shpejtë i Kontakteve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32313_1649252_2761447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule that an administrator can configure and apply to query processing to help optimize results and create an enhanced user experience.</descrip