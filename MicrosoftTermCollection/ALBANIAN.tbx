atje dinamike</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32126_1636485_1915353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To adjust content layout dynamically based on the available window or device size.</descrip></descripGrp><ntig><termGrp><term id="1636485">reflow</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915353">përshtas dinamikisht</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32127_1636489_1915354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">​A feature that enables the user to start a web search from text that is selected within a document.</descrip></descripGrp><ntig><termGrp><term id="1636489">Search on Web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1915354">Kërkimi në ueb</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32128_1636497_1915355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that helps make smart routing decisions, based on routing rules that relate the nature of requests to the dynamic topology of its farm.</descrip></descripGrp><ntig><