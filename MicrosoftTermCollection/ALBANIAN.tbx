ëm</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23532_1087134_1188770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specification according to which each open document occupies its own window in the UI, though only a single instance of the program application is running.</descrip></descripGrp><ntig><termGrp><term id="1087134">single-document interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188770">SDI</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23532_1087135_1188769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specification according to which each open document occupies its own window in the UI, though only a single instance of the program application is running.</descrip></descripGrp><ntig><termGrp><term id="1087135">SDI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188769">ndërfaqja e dokumentit të vetëm</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23532_1087135_1188770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specification according to which each open document 