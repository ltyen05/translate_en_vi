mGrp><term id="397215">transaction log file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2291461">skedari i evidencës së transaksionit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="648_234820_481183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that gives a general indication of the performance capability of your computer's hardware.</descrip></descripGrp><ntig><termGrp><term id="234820">system rating</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481183">klasifikimi i sistemit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6484_136942_1463771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A ready-made button that the user can insert into his/her presentation and define hyperlinks for.</descrip></descripGrp><ntig><termGrp><term id="136942">action button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1463771">butoni i veprimit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6486_310254_481508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity at one end of a point-to-point LAN/WLAN segment that is requesting authenticated access to the network.</descrip></descripGrp><ntig><termGrp><term id="310254">supplicant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481508">kërkues</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6490_183384_2176663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agreement between two owners to promote content in different places.</descrip></descripGrp><ntig><termGrp><term id="183384">affiliate marketing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2176663">reklamim në partneritet</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6502_315144_481543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A word, symbol, or other group of characters used to identify a file, a storage medium, an element defined in a computer program, or a specific item in a document such as a spreadsheet or a chart.</descrip></descripGrp><ntig><termGrp><term id="315144">label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481543">etiketë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6507_130126_480731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of measures to protect a machine from being infected by a virus.</descrip></descripGrp><ntig><termGrp><term id="130126">virus protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480731">mbrojtje nga viruset</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6513_45147_480192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any piece of equipment that can be attached physically or wirelessly to a network or computer, for example, printers, keyboards, external disk drives, or other peripheral equipment.</descrip></descripGrp><ntig><termGrp><term id="45147">device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480192">pajisje</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6514_397180_2291304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Settings that are applied to the managed folders in users' mailboxes to control the retention and journaling of messages for messaging records management (MRM). Managed content settings define when messages that are no longer needed are to be removed or journaled (copied) to a separate storage location outside the mailbox.</descrip></descripGrp><ntig><termGrp><term id="397180">managed content settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2291304">parametrat e përmbajtjes së menaxhuar</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6516_50772_1187062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of turning data into a stream of bits. Encoding is part of the serialization process that converts data into a stream of ones and zeros.</descrip></descripGrp><ntig><termGrp><term id="50772">encoding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1187062">enkodim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6520_91124_480531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect created by simple, repeating designs such as vertical or horizontal lines.</descrip></descripGrp><ntig><termGrp><term id="91124">pattern</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="480531">motiv</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6533_62030_1188426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A postal address at which a person is normally resident.</descrip></descripGrp><ntig><termGrp><term id="62030">home address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188426">adresa e shtëpisë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6538_360134_2072144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that shows a graphical analysis of data in a datasheet or form. You can see different levels of detail or specify the layout by dragging fields and items or by showing and hiding items in the drop-down lists for the fields.</descrip></descripGrp><ntig><termGrp><term id="360134">PivotChart view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2072144">Pamja e PivotChart</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6540_8001_479923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Interactive or animated content used on the Internet. Active content includes ActiveX controls and web browser add-ons.</descrip></descripGrp><ntig><termGrp><term id="8001">active content</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="479923">përmbajtje aktive</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6554_112160_1806142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The paper that a publication is printed on.</descrip></descripGrp><ntig><termGrp><term id="112160">sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1806142">fletë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6563_123499_1187063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure containing zero or more nodes that are linked together in a hierarchy. If any nodes are present, one node is the root; each node except the root is the child of one and only one other node, and each node has zero or more nodes as children.</descrip></descripGrp><ntig><termGrp><term id="123499">tree</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1187063">degëzim</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6573_5678_479901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compressed file.</descrip></descripGrp><ntig><termGrp><term id="5678">archive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="479901">arkiv</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6576_232820_1187064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A vertical pane along the left edge of the document window that displays an outline of the document's headings, and enables the user to navigate to or manipulate different parts of the document.</descrip></descripGrp><ntig><termGrp><term id="232820">Document Map</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1187064">Skema e dokumenteve</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6579_232399_1188427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The small calendar that displays the current month in Calendar and that provides a quick and easy way to move appointments and to view other dates.</descrip></descripGrp><ntig><termGrp><term id="232399">Date Navigator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="1188427">Naviguesi i datës</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6583_20710_2291120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snippet of software placed in an advertisement or email message, or on a Web page to help measure delivery of the item to a Web browser and to track a user's actions in general.</descrip></descripGrp><ntig><termGrp><term id="20710">beacon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2291120">sinjal me dritë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6583_20710_2797741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snippet of software placed in an advertisement or email message, or on a Web page to help measure delivery of the item to a Web browser and to track a user's actions in general.</descrip></descripGrp><ntig><termGrp><term id="20710">beacon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2797741">sinjalizues i uebit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6583_2795510_2291120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snippet of software placed in an advertisement or email message, or on a Web page to help measure delivery of the item to a Web browser and to track a user's actions in general.</descrip></descripGrp><ntig><termGrp><term id="2795510">web beacon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2291120">sinjal me dritë</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6583_2795510_2797741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snippet of software placed in an advertisement or email message, or on a Web page to help measure delivery of the item to a Web browser and to track a user's actions in general.</descrip></descripGrp><ntig><termGrp><term id="2795510">web beacon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="2797741">sinjalizues i uebit</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6586_347949_481797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that contains other controls.</descrip></descripGrp><ntig><termGrp><term id="347949">section</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sq"><ntig><termGrp><term id="481797">seksion</term><termNote type="geographicalUsage">ALB</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><t