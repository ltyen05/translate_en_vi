о снимање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2905_136564_1371427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of CD-ROM that can be written (only once) on a CD recorder and read on a CD-ROM drive.</descrip></descripGrp><ntig><termGrp><term id="136564">CD-R</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371427">ЦД-Р</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2905_136564_442079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of CD-ROM that can be written (only once) on a CD recorder and read on a CD-ROM drive.</descrip></descripGrp><ntig><termGrp><term id="136564">CD-R</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442079">компакт-диск за еднократно снимање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29075_1506403_1943237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical grouping of users, groups, and content permissions for a third-party security or content system that is accessed by FAST Search Authorization.</descrip></descripGrp><ntig><termGrp><term id="1506403">user store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943237">кориснички склад</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29076_1506404_1943238"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The search security filter in FSA that finds documents that all users have access to.</descrip></descripGrp><ntig><termGrp><term id="1506404">public filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943238">јавен филтер</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29077_1506405_1943239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of mapping a user or a group in one user store to a user or a group in another user store for the purpose of returning all documents that the user or group has rights to view, regardless of which user store the user or group is authenticated to.</descrip></descripGrp><ntig><termGrp><term id="1506405">principal aliasing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943239">поврзување корисници</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29078_1506406_1943240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A word or phrase that is added to a SharePoint item, either as a value in the Managed Keyword column or as a social tag.</descrip></descripGrp><ntig><termGrp><term id="1506406">managed keyword</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943240">управуван клучен збор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29079_1506407_1943241"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows service that generates user search security filters in FAST Search Authorization.</descrip></descripGrp><ntig><termGrp><term id="1506407">FSA worker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943241">FSA-работник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29079_1680037_1943241"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows service that generates user search security filters in FAST Search Authorization.</descrip></descripGrp><ntig><termGrp><term id="1680037">security worker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943241">FSA-работник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2908_38136_441443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of hardware devices, software packages, or a computer itself to work with network devices or with other hardware devices, software packages, or a computer over a network connection.</descrip></descripGrp><ntig><termGrp><term id="38136">connectivity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441443">поврзливост</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29080_1506408_1943242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows service that provides administration functionality for FAST Search Authorization.</descrip></descripGrp><ntig><termGrp><term id="1506408">FSA Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943242">FSA-управник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29081_1506409_1943243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user store supplied as a starting point for expanding group membership when a user store is not already specified in FAST Search Authorization.</descrip></descripGrp><ntig><termGrp><term id="1506409">default user store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943243">зададен склад на корисници</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29082_1506410_1523046"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The internal URL that is used by a crawler to identify and access an item.</descrip></descripGrp><ntig><termGrp><term id="1506410">access URL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523046">УРЛ за пристап</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29083_1506411_1943244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The current selection of cells, rows, or columns that includes the active cell in a datasheet.</descrip></descripGrp><ntig><termGrp><term id="1506411">active selection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943244">активен избор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29084_1506412_1943245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A running instance of a workflow that consists of a sequence of action instances and/or activity model instances. Action instances and activity model instances can be sequenced in any order to create a single activity flow.</descrip></descripGrp><ntig><termGrp><term id="1506412">activity flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943245">тек на активност</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29085_1506413_1943246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A worksheet function that is provided by an add-in, instead of being built-in.</descrip></descripGrp><ntig><termGrp><term id="1506413">add-in function</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943246">функција на додаток</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29086_1506415_1523048"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cell that is in the same row as and adjoins the current cell in a worksheet.</descrip></descripGrp><ntig><termGrp><term id="1506415">adjacent cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523048">соседна ќелија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29087_1506416_1943247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection that uses the ActiveX Data Objects (ADO) data access interface.</descrip></descripGrp><ntig><termGrp><term id="1506416">ADO connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943247">Врска АДО</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29088_1506431_1943248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data and the information that is needed to access that data from applications and databases that support the ActiveX Data Objects (ADO) data access interface.</descrip></descripGrp><ntig><termGrp><term id="1506431">ADO data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943248">Извор на податоци АДО</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29089_1506432_1943249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request to receive an Internet message automatically when user-defined criteria are met. Such messages are generated automatically when items such as documents, Web pages, list items, sites, or other resources on a server are changed.</descrip></descripGrp><ntig><termGrp><term id="1506432">alert subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943249">претплата за предупредувања</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29090_1506433_1943250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An additional user account that is in a different domain, but within the same forest as the primary account.</descrip></descripGrp><ntig><termGrp><term id="1506433">alternate account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943250">алтернативна сметка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29091_1506434_1943251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A content source that is used to import the anchor text from links between items into the full-text index catalog.</descrip></descripGrp><ntig><termGrp><term id="1506434">anchor content source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943251">извор за содржина на сидро</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29092_1506435_1523049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of adding anchor text that is in links between items to the full-text index catalog.</descrip></descripGrp><ntig><termGrp><term id="1506435">anchor crawl</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523049">индексирање вкотвен текст</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29093_1506436_1943252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The period of time when an application is running. When an application starts, the session starts. When an application quits, the session ends.</descrip></descripGrp><ntig><termGrp><term id="1506436">application session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943252">сесија на апликација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29094_1506437_1943253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A GUID or string that is used to uniquely identify an audience.</descrip></descripGrp><ntig><termGrp><term id="1506437">audience identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943253">идентификатор на публика</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29095_1506438_1523051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of logical conditions that determine whether a user profile can be a member of an audience.</descrip></descripGrp><ntig><termGrp><term id="1506438">audience rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523051">правило за публика</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29096_1506439_1943254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A floating-point number that designates that a specific Web page is more relevant than other Web pages. Allowed values are 0, 1, or 2. Zero (0) signifies the most valuable authoritative page level.</descrip></descripGrp><ntig><termGrp><term id="1506439">authority level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943254">ниво на овластување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29097_1506440_1523053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based collection of predefined or user-defined settings that are stored as a site definition configuration or a site template, and can be used when creating a site.</descrip></descripGrp><ntig><termGrp><term id="1506440">available site template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523053">достапен шаблон за локација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29098_1506441_1523054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text or number that identifies the categories or the scaling of an axis. The axis label usually appears below or to the left of the axis.</descrip></descripGrp><ntig><termGrp><term id="1506441">axis label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523054">ознака на оска</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29099_1506442_1943255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition of a handwritten signature, in an image or .ink file, that specifies the direction of the characters in the signature, right-to-left or left-to-right.</descrip></descripGrp><ntig><termGrp><term id="1506442">backward signing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943255">потпишување наназад</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29100_1506443_1523055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Parts page that contains only one Web Part zone and, by default, a Content Editor Web Part.</descrip></descripGrp><ntig><termGrp><term id="1506443">basic page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523055">основна страница</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29101_1506444_1523057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A site that was created by using the "Blank" site template.</descrip></descripGrp><ntig><termGrp><term id="1506444">blank site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523057">празна локација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29102_1506445_1523059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based language that is used to describe various elements, such as queries and views, in sites that are based on Microsoft® SharePoint® Products and Technologies.</descrip></descripGrp><ntig><termGrp><term id="1506445">Collaborative Application Markup Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523059">ЦАМЛ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29102_1506445_1943256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based language that is used to describe various elements, such as queries and views, in sites that are based on Microsoft® SharePoint® Products and Technologies.</descrip></descripGrp><ntig><termGrp><term id="1506445">Collaborative Application Markup Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943256">Маркирачки јазик на колаборативни апликации</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29102_1506446_1523059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based language that is used to describe various elements, such as queries and views, in sites that are based on Microsoft® SharePoint® Products and Technologies.</descrip></descripGrp><ntig><termGrp><term id="1506446">CAML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523059">ЦАМЛ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29102_1506446_1943256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based language that is used to describe various elements, such as queries and views, in sites that are based on Microsoft® SharePoint® Products and Technologies.</descrip></descripGrp><ntig><termGrp><term id="1506446">CAML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943256">Маркирачки јазик на колаборативни апликации</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29103_1506447_1943257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of removing information about all crawled items from a full-text index catalog.</descrip></descripGrp><ntig><termGrp><term id="1506447">catalog reset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943257">повторно поставување каталог</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29104_1506449_1943258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of properties that, as a whole, specify the appearance of a cell, such as font characteristics and fill color.</descrip></descripGrp><ntig><termGrp><term id="1506449">cell formatting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943258">форматирање ќелии</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29105_1506636_1943259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A package of XML-formatted files that is used to migrate content between site collections, sites, and lists.</descrip></descripGrp><ntig><termGrp><term id="1506636">content migration package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943259">пакет за миграција на содржина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29106_1506637_1943260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A region within a page layout that is populated dynamically with the value of the publishing page field to which it is bound.</descrip></descripGrp><ntig><termGrp><term id="1506637">content placeholder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943260">резервирано место за содржина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29107_1506638_1523070"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A named category of content types that is used to organize content types of a similar purpose.</descrip></descripGrp><ntig><termGrp><term id="1506638">content type group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523070">група на тип содржина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29108_1506639_1943261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifier that is assigned to a content type.</descrip></descripGrp><ntig><termGrp><term id="1506639">content type identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943261">идентификатор на тип на содржина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29109_1506640_1523071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sequence in which content types are displayed.</descrip></descripGrp><ntig><termGrp><term id="1506640">content type order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523071">редослед на тип содржина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29110_1506641_1943262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder that stores the resource files that are associated with a content type.</descrip></descripGrp><ntig><termGrp><term id="1506641">content type resource folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943262">папка за извори на типови на  содржина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29111_1506642_1943263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML definition that describes the contents of a content type.</descrip></descripGrp><ntig><termGrp><term id="1506642">content type schema</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943263">шема на тип на содржина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29112_1506643_1943264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that is associated with a particular content type that is associated with a folder.</descrip></descripGrp><ntig><termGrp><term id="1506643">content type specific view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943264">одреден приказ за тип на содржина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29113_1506645_1943265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A site that corresponds to the context of the current request.</descrip></descripGrp><ntig><termGrp><term id="1506645">context site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943265">локација на контекст</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29114_1506647_1943266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A GUID that is used as a classification for an event receiver.</descrip></descripGrp><ntig><termGrp><term id="1506647">context type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943266">тип на контекст</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29115_1506649_1943267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system-defined restriction that can optionally be added to a query to restrict the query results to items that are from a specific site or list.</descrip></descripGrp><ntig><termGrp><term id="1506649">contextual search scope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943267">контекстуален пребарувачки опсег</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29116_1506651_1523075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of properties that provides information about the results of crawling a display URL. The information includes whether the crawl was successful, the content source to which the display URL belongs, and the level, message, time, and identifier for any errors that occur.</descrip></descripGrp><ntig><termGrp><term id="1506651">crawl log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523075">дневник на индексирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29117_1506655_1523076"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure that stores the list of items to crawl next.</descrip></descripGrp><ntig><termGrp><term id="1506655">crawl queue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523076">ред на индексирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29118_1506657_1523077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state of a crawl operation.</descrip></descripGrp><ntig><termGrp><term id="1506657">crawl status</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523077">статус на индексирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29119_1506659_1523078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A setting that specifies whether to evaluate all of the users and member groups in the directory service that is crawled, or only those users and member groups that were modified after the last crawl.</descrip></descripGrp><ntig><termGrp><term id="1506659">crawl type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523078">тип индексирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2912_132835_2305773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search for data in a table or field using placeholders (such as * or ?).</descrip></descripGrp><ntig><termGrp><term id="132835">wildcard search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305773">пребарување со џокери</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29120_1506661_1943268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure that stores a list of URLs and their properties, such as when a URL was last crawled.</descrip></descripGrp><ntig><termGrp><term id="1506661">crawl URL history</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943268">историја на индексирање на УРЛ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29121_1506663_1523079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of metadata that can be discovered during a crawl and applied to one or more items. It can be mapped to a managed property.</descrip></descripGrp><ntig><termGrp><term id="1506663">crawled property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523079">индексирано својство</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29122_1506664_1943269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of crawled properties for a specific type of item.</descrip></descripGrp><ntig><termGrp><term id="1506664">crawled property category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943269">категорија на индексирани својства</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29123_1506665_1943270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifier that associates one or more crawled properties with a crawled property category.</descrip></descripGrp><ntig><termGrp><term id="1506665">crawled property set identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943270">идентификатор на група со индексирани својства</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29124_1506666_1523080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The authenticated user during processing operations in a front-end Web server and a back-end database server.</descrip></descripGrp><ntig><termGrp><term id="1506666">current user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523080">тековен корисник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</te