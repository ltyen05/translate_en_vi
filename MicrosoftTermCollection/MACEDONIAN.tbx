72">easily</term><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="443087">лесно</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45305_2556986_2557325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of the premium experience for mixed reality when used with PC hardware that can support higher resolution/quality graphics.</descrip></descripGrp><ntig><termGrp><term id="2556986">Windows Mixed Reality Ultra</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2557325">Windows Mixed Reality Ultra</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45308_2558356_2740613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service for administrators to detect anomalous or high-risk user activity, discover 3rd-party cloud apps that are being used in their organization that have similar functionality to Office 365, and block 3rd-party application's access to Office 365 information.</descrip></descripGrp><ntig><termGrp><term id="2558356">Office 365 Cloud App Security</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2740613">Безбедност за апликации во облак</term><termNote type="geographicalUsage">MKD</term