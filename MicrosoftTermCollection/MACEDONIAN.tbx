rmNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2101759">Лента со пораки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36834_2085430_2101762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that shows the progress of an operation.</descrip></descripGrp><ntig><termGrp><term id="2085430">Progress UI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2101762">Корисничка врска за напредок</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36835_2085431_2101761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recurring meeting that does not have a standard pattern of daily, weekly, monthly, etc.</descrip></descripGrp><ntig><termGrp><term id="2085431">custom repeat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2101761">прилагодено повторување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36836_2086047_2101758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The icon on the upper-left corner of the Office 365 suite. The icon is the entry point to all Office 365 services for which the user has a valid subscription, and to the Admin center (only if the user is an admin).</descrip></descripGrp><ntig><termGrp><term id="2086047">app launcher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2101758">Извршувач на апликации</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36872_2093287_2106351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of OneNote for Android that allows you to create notes, audio notes, and picture notes right from your phone’s home screen.</descrip></descripGrp><ntig><termGrp><term id="2093287">widget</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2106351">графичка контрола</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36873_2093298_2106349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual tab on the Ribbon that enables the user to modify the appearance, size, and other aspects of the container controls in a form.</descrip></descripGrp><ntig><termGrp><term id="2093298">Control Tools</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2106349">Алатки за контрола</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36880_2099681_2182507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The on-screen keyboard key that traditionally (as in word processing) is used to insert tab characters into a document.</descrip></descripGrp><ntig><termGrp><term id="2099681">Tab</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2182507">Tab</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36882_2099685_2948394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A GUI tool used to create and manage lists that tell Internet Explorer 11 which websites to run in Enterprise Mode.</descrip></descripGrp><ntig><termGrp><term id="2099685">Enterprise Mode Site List Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2948394">Управник со списокот на веб-локации во деловен режим</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36887_2099902_2184010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Street level imagery that enables users to experience Bing Maps from the street level. Streetside supplements maps, directions and local search.</descrip></descripGrp><ntig><termGrp><term id="2099902">Streetside</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2184010">Streetside</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3690_18204_441284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel feature that automatically creates a sum formula based on user selection.</descrip></descripGrp><ntig><termGrp><term id="18204">AutoSum</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441284">автоматско сумирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36900_2101411_2106347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook email filter that moves low priority messages out of the Inbox to the Clutter folder based on individual user preferences.</descrip></descripGrp><ntig><termGrp><term id="2101411">Clutter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2106347">Небитно</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp><