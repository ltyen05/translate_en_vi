"2931195">Анализа на податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52044_2930013_2931200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service of expert assistance that helps very small businesses get the most out of their Microsoft 365 subscription, including migration help, end-user support, and personalized advice from small business specialists.</descrip></descripGrp><ntig><termGrp><term id="2930013">Business Assist for Microsoft 365</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2931200">Деловна поддршка за Microsoft 365</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52046_2930015_2931232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category name for a group of features that enable collaboration with external users in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="2930015">Microsoft Teams Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2931232">Поврзување за Microsoft Teams</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52046_2930015_3060394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category name for a group of features that enable collaboration with external users in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="2930015">Microsoft Teams Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3060394">Поврзување за Teams</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52046_3059193_2931232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category name for a group of features that enable collaboration with external users in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="3059193">Teams Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2931232">Поврзување за Microsoft Teams</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52046_3059193_3060394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category name for a group of features that enable collaboration with external users in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="3059193">Teams Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3060394">Поврзување за Teams</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52048_2930017_2931238"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Office perpetual for Consumer and SMB that includes the traditional suite of classic apps such as Word, Excel, PowerPoint, and other apps, sold as a one-time purchase without any major feature updates.</descrip></descripGrp><ntig><termGrp><term id="2930017">Office 2021</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2931238">Office 2021</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52049_2930018_2931243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that allows customers to configure operator dial-in phone numbers on a Microsoft Audio Conferencing bridge and provides customers the ability to maintain their existing operator contracts and relationships as they migrate to the cloud, diversify their PSTN infrastructure to include multiple operators, expand dial-in coverage and enterprise-grade reliability and support.</descrip></descripGrp><ntig><termGrp><term id="2930018">Operator Connect Conferencing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2931243">Конференција преку поврзување со оператори</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52050_2930019_2931208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of the Exchange Server software that a customer can run on-premises, for which Microsoft provides ongoing support and updates for as long as the subscription is current/valid.</descrip></descripGrp><ntig><termGrp><term id="2930019">Microsoft Exchange Server Subscription Edition</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2931208">Претплатничко издание на Microsoft Exchange Server</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52051_2930020_2931206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Teams, the feature that moves all video feeds to the top of the meeting window, allowing more natural eye contact with meeting attendees.</descrip></descripGrp><ntig><termGrp><term id="2930020">Gallery at top</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2931206">Галерија на врвот</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52052_2930022_2931254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option in Presenter Mode in which the content is shown as a visual aid above the presenter's shoulder, like a television reporter.</descrip></descripGrp><ntig><termGrp><term id="2930022">Reporter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2931254">Репортер</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52054_2930025_2931211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that enables IT managed secure control and customization by allowing customers to bring consistent organizational experiences and have enhanced control and management across the organization.</descrip></descripGrp><ntig><termGrp><term id="2930025">Microsoft Teams Advanced Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2931211">Напредно управување за Microsoft Teams</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52055_2930026_2931248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PowerPoint experience with features exclusive to Microsoft Teams, in which users can see their notes, upcoming slides, audience member videos and chat, and more.</descrip></descripGrp><ntig><termGrp><term id="2930026">PowerPoint Live</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2931248">PowerPoint во живо</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52057_2930028_2931203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability that makes it easy to plan and schedule quality, feature, and driver updates through powerful, cloud-based controls and leverages cloud capabilities to protect commercial customers from update-related issues through automatic pilot rings, ML-based issue detection, and tenant monitoring.</descrip></descripGrp><ntig><termGrp><term id="2930028">deployment service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2931203">услуга за имплементација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5206_421002_2305845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To associate data with a specified location in memory.</descrip></descripGrp><ntig><termGrp><term id="421002">map</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305845">мапа</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52067_2931691_2932664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of Windows to adapt the way your colors render based on the type of content you consume and/or the environment you are in (dark vs bright, or an environment of a specific color - e.g. a coffee shop with green walls or a theatre with a predominance of red).</descrip></descripGrp><ntig><termGrp><term id="2931691">adaptive color</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2932664">приспособлива боја</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52069_2932124_2934094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2021 version of Microsoft Office Project Standard that utilizes the LTSC servicing model.</descrip></descripGrp><ntig><termGrp><term id="2932124">Microsoft Office LTSC Project Standard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2934094">Microsoft Office LTSC Project Standard</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52069_2932124_2934095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2021 version of Microsoft Office Project Standard that utilizes the LTSC servicing model.</descrip></descripGrp><ntig><termGrp><term id="2932124">Microsoft Office LTSC Project Standard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2934095">Microsoft Office 