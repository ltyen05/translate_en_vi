="11229_231980_1868166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Query window that displays the tables in a query. Each table displays the fields from which you can retrieve data.</descrip></descripGrp><ntig><termGrp><term id="231980">table pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868166">окно на табела</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11232_231971_442417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a PivotTable report, the summarized data calculated from the data fields of a source list or table.</descrip></descripGrp><ntig><termGrp><term id="231971">PivotTable data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442417">PivotTabble-податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11239_90209_1943037"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The request by a user's browser for a Web page. The number of requests to view a page can indicate the frequency with which an ad is viewed.</descrip></descripGrp><ntig><termGrp><term id="90209">page view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943037">приказ на страница</term><termNote ty