ed.</descrip></descripGrp><ntig><termGrp><term id="4400">Web Services Description Language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305771">Јазик за опис на услугите преку веб</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3273_4400_2305777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML format for describing Web services. WSDL allows Web service providers and users of such services to work together easily by enabling the separation of the description of the abstract functionality offered by a service from concrete details of a service description such as "how" and "where" that functionality is offered.</descrip></descripGrp><ntig><termGrp><term id="4400">Web Services Description Language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305777">WSDL</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3273_4401_2305771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML format for describing Web services. WSDL allows Web service providers and users of such services to work together easily by enabling the separation of the description of the abstract functionality offered by a service from concrete details of a service description such as "how" and "where" that functionality is offered.</descrip></descripGrp><ntig><termGrp><term id="4401">WSDL<