ogram for security software providers, security service providers, antimalware testing organizations, and other organizations involved in fighting cybercrime.</descrip></descripGrp><ntig><termGrp><term id="2842114">VIA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2851643">АИВ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50252_2842116_2842692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A nonprofit consortium of industry leaders, including Microsoft, that develops open standards for simpler, stronger authentication.</descrip></descripGrp><ntig><termGrp><term id="2842116">Fast Identity Online Alliance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2842692">Fast Identity Online Alliance</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50252_2842116_2842693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A nonprofit consortium of industry leaders, including Microsoft, that develops open standards for simpler, stronger authentication.</descrip></descripGrp><ntig><termGrp><term id="2842116">Fast Identity Online Alliance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2842693">FIDO Alliance</term><termN