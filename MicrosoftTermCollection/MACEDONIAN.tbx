termEntry><termEntry id="19425_659082_3041486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interface control for setting the color of a brush or the color of a property on an object (such as Background).</descrip></descripGrp><ntig><termGrp><term id="659082">color picker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3041486">избирач на боја</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1943_494725_1465402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control designed to contain content such as placeholder or sample text or images that is updated by the user, or pre-defined lists of items from which users can select.</descrip></descripGrp><ntig><termGrp><term id="494725">content control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1465402">контрола на содржината</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19436_659694_2775201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that can contain one or more child objects.</descrip></descripGrp><ntig><termGrp><term id="659694">container</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2775201">контејнер</term><termNote t