mation added to the header, footer, watermark, or subject line of emails or documents for classification purposes.</descrip></descripGrp><ntig><termGrp><term id="2409896">visual marking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2752456">визуелен знак</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42526_2410029_2416688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition of being protected from danger or risk.</descrip></descripGrp><ntig><termGrp><term id="2410029">safety</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2416688">безбедност</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42529_2410032_2416683"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A failure of a program operation that causes the operation to stop completely.</descrip></descripGrp><ntig><termGrp><term id="2410032">hard fail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2416683">непоправлива грешка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></nti