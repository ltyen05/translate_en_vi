icles are stored on a server in a central database, thus enabling a user to select specific items to read.</descrip></descripGrp><ntig><termGrp><term id="84649">NNTP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305847">Протокол за трансфер на вестите во мрежа</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48941_2766782_2769859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A persistent set of parameters that defines a data source and any modifications to it so that it can be presented to the user in a table.</descrip></descripGrp><ntig><termGrp><term id="2766782">query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2769859">прашалник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48942_2766792_2769858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The GroupMe mode that silences notifications from group chats.</descrip></descripGrp><ntig><termGrp><term id="2766792">Office Mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2769858">Режим на канцеларија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine