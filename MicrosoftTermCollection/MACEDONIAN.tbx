in the Windows market.</descrip></descripGrp><ntig><termGrp><term id="1608239">App Summary</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1643123">Резиме на апликацијата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31664_1608240_1643150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Store service that enables end users to update apps one at a time or all at the same time for all apps purchased through the Windows Store.</descrip></descripGrp><ntig><termGrp><term id="1608240">App Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1643150">Ажурирање апликации</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31668_1611161_1779657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The stage of an app in the certification process.</descrip></descripGrp><ntig><termGrp><term id="1611161">certification status</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1779657">статус на сертификација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">No