aphicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="728_484_441123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity, such as a device or program, that connects to another entity over a network.</descrip></descripGrp><ntig><termGrp><term id="484">client computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441123">клиент</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="728_484_441124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity, such as a device or program, that connects to another entity over a network.</descrip></descripGrp><ntig><termGrp><term id="484">client computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441124">компјутер-клиент</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7280_502936_1519923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presence status the user can select, while signed in, to make it appear to other users that he or she is currently willing to be contacted.</descrip></descripGrp><ntig><termGrp><term id="502936">available</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1519923">достапен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7286_226559_1485344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital micropayment and loyalty service that enables efficient micropayments and prepaid purchase for cash based consumers (including kids/teens, as well as emerging and developing markets), and provides a mechanism to directly reward loyal customers.</descrip></descripGrp><ntig><termGrp><term id="226559">Microsoft Points</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1485344">Microsoft Points</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7290_60173_1371572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any token that a program can use to identify and access an object such as a device, a file, a window, or a dialog box.</descrip></descripGrp><ntig><termGrp><term id="60173">handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371572">рачка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><t