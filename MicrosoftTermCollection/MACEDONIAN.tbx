">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37590_2144846_2179843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect that adds gradual dark shading at the edges of a photo.</descrip></descripGrp><ntig><termGrp><term id="2144846">vignette</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2179843">вињета</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37592_2144861_2570574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app in the operating system where the user can manage the builds in the Windows Insider Program.</descrip></descripGrp><ntig><termGrp><term id="2144861">Windows Insider Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2570574">Центар на Insider</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37592_2144861_2570578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app in the operating system where the user can manage the builds in the Windows Insider Program.</descrip></descripGrp><ntig><termGrp><term id="2144861">Windows Insider Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2570578">Центар на Windows Insider</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37592_2144862_2570574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app in the operating system where the user can manage the builds in the Windows Insider Program.</descrip></descripGrp><ntig><termGrp><term id="2144862">Insider Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2570574">Центар на Insider</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37592_2144862_2570578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app in the operating system where the user can manage the builds in the Windows Insider Program.</descrip></descripGrp><ntig><termGrp><term id="2144862">Insider Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2570578">Центар на Windows Insider</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37612_2146201_2169060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The full-screen pane in Office Universal Apps that shows a list of previous versions of the file that is currently open, and that provides the ability to preview and create a copy of an older versions or restore the current document to an older version.</descrip></descripGrp><ntig><termGrp><term id="2146201">History</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2169060">Историја</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37619_2147250_2342420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dual-component app that can be installed on a user's mobile device for secure access to work and school accounts through account sign-in verification.</descrip></descripGrp><ntig><termGrp><term id="2147250">Azure Authenticator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2342420">Azure Authenticator</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37637_2148953_2155496"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Books &amp; reference subcategory containing apps to help you to read electronic copies of books.</descrip></descripGrp><ntig><termGrp><term id="2148953">E-reader</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2155496">Е-читач</term><termNote type="geographicalUsage">MKD</termNote><termNote t