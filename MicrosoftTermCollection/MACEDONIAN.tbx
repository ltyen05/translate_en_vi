</termEntry><termEntry id="7967_184982_3014205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item on the Actions menu that displays additional actions the user can select.</descrip></descripGrp><ntig><termGrp><term id="184982">More</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3014205">Повеќе</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7971_121145_1371588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to technologies for converting textual (ASCII) information into synthetic speech output. Used in voice-processing applications requiring production of broad, unrelated, and unpredictable vocabularies, such as products in a catalog or names and addresses. This technology is appropriate when system design constraints prevent the more efficient use of speech concatenation alone.</descrip></descripGrp><ntig><termGrp><term id="121145">text-to-speech</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371588">ТТС</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7971_121145_441991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to technologies for converting textual (ASCII) information into synthetic speech output. Used in voice-processing applications requiring production of broad, unrelated, and unpredictable vocabularies, such as products in a catalog or names and addresses. This technology is appropriate when system design constraints prevent the more efficient use of speech concatenation alone.</descrip></descripGrp><ntig><termGrp><term id="121145">text-to-speech</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441991">од текст во говор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7971_262703_1371588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to technologies for converting textual (ASCII) information into synthetic speech output. Used in voice-processing applications requiring production of broad, unrelated, and unpredictable vocabularies, such as products in a catalog or names and addresses. This technology is appropriate when system design constraints prevent the more efficient use of speech concatenation alone.</descrip></descripGrp><ntig><termGrp><term id="262703">TTS</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371588">ТТС</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7971_262703_441991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to technologies for converting textual (ASCII) information into synthetic speech output. Used in voice-processing applications requiring production of broad, unrelated, and unpredictable vocabularies, such as products in a catalog or names and addresses. This technology is appropriate when system design constraints prevent the more efficient use of speech concatenation alone.</descrip></descripGrp><ntig><termGrp><term id="262703">TTS</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441991">од текст во говор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7972_234577_1372385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option that allows the user to specify the intervals at which an appointment or task will be repeated.</descrip></descripGrp><ntig><termGrp><term id="234577">Recurrence</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372385">Повторливост</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7972_780209_1372385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option that allows the user to specify the intervals at which an appointment or task will be repeated.</descrip></descripGrp><ntig><termGrp><term id="780209">Repeat</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372385">Повторливост</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7976_346946_443072"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Capable of producing successful results.</descrip></descripGrp><ntig><termGrp><term id="346946">effective</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="443072">ефективен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7980_83948_2692851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To embed one construct inside another. For example, a database may contain a nested table (a table within a table), a program may contain a nested procedure (a procedure declared within a procedure), and a data structure may include a nested record (a record containing a field that is itself a record).</descrip></descripGrp><ntig><termGrp><term id="83948">nest</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2692851">вгнездува</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7997_690899_2305848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an application on a local server or client computer, which usually hosts users for business/commercial usage.</descrip></descripGrp><ntig><termGrp><term id="690899">on-premises</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305848">капацитет</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="800_2598351_2600528"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An electronic publication distributed primarily through the World Wide Web, rather than as an ink-on-paper magazine.</descrip></descripGrp><ntig><termGrp><term id="2598351">magazine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2600528">електронски часопис</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="800_2598351_2600534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An electronic publication distributed primarily through the World Wide Web, rather than as an ink-on-paper magazine.</descrip></descripGrp><ntig><termGrp><term id="2598351">magazine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2600534">часопис</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote