</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46292_2607094_2608948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability that provides Windows Hello with additional security for PIN, fingerprint, and facial recognition.​​</descrip></descripGrp><ntig><termGrp><term id="2607094">enhanced sign-in security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2608948">подобрена безбедност при најавување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46293_2607097_2608949"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of Windows Defender System Guard that protects a device from compromised firmware.​</descrip></descripGrp><ntig><termGrp><term id="2607097">firmware protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2608949">заштита на фирмверот</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46294_2607107_2608951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The consumer-friendly name for trusted platform module (TPM)​.</descrip></descripGrp><ntig><termGrp><term id="2607107">security processor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2608951">безбедносен процесор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46299_2607706_2608950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows 10 app that helps users get online easily and in more places on their Windows 10 PC. Users sign up for a data plan and connect with mobile operators in their area using a supported SIM card.</descrip></descripGrp><ntig><termGrp><term id="2607706">Mobile Plans</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2608950">Мобилни планови</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="463_75391_441721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that is inserted into a document from a source file and that is updated when the original source file is updated.</descrip></descripGrp><ntig><termGrp><term id="75391">linked object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441721">поврзан објект</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46301_2607760_2678139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The storage of data for meeting regulatory and business data archival requirements.</descrip></descripGrp><ntig><termGrp><term id="2607760">data retention</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2678139">задржување на податоците</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46301_2607760_2678151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The storage of data for meeting regulatory and business data archival requirements.</descrip></descripGrp><ntig><termGrp><term id="2607760">data retention</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2678151">задржување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46301_2676908_2678139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The storage of data for meeting regulatory and business data archival requirements.</descrip></descripGrp><ntig><termGrp><term id="2676908">retention</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2678139">задржување на податоците</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46301_2676908_2678151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The storage of data for meeting regulatory and business data archival requirements.</descrip></descripGrp><ntig><termGrp><term id="2676908">retention</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2678151">задржување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4631_158674_1372338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu for a group of ready-made shapes that includes basic shapes, such as rectangles and circles, plus a variety of lines and connectors, block arrows, flowchart symbols, stars and banners, and callouts.</descrip></descripGrp><ntig><termGrp><term id="158674">AutoShapes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372338">Автоматски форми</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46310_2608183_2611105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web part that is offered as default for the design of a SharePoint communication site.</descrip></descripGrp><ntig><termGrp><term id="2608183">default hero</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2611105">зададено место на вебот</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46325_2608792_2611104"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint site created or managed by few people to broadcast information out to a broad audience.</descrip></descripGrp><ntig><termGrp><term id="2608792">communication site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2611104">локација за комуникација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46330_2609539_2663805"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that enables Cortana to take over your mouse pointer and literally show you how to change a setting when you ask her to "show me (how to do something)." She performs each step for you in a sequence of clicks needed to make a particular change in Windows Settings.</descrip></descripGrp><ntig><termGrp><term id="2609539">Cortana Show Me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2663805">Cortana Show Me</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46331_2609624_2610930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The downloadable tool that runs a series of tests to diagnose and help fix problems with Surface hardware.</descrip></descripGrp><ntig><termGrp><term id="2609624">Surface Diagnostic Toolkit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2610930">Комплет дијагностички алатки за Surface</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46337_2609835_2786105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To plan an event for a specific time slot.</descrip></descripGrp><ntig><termGrp><term id="2609835">schedule</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2786105">закажи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46341_2610077_2610925"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The consumer-facing name for Hypervisor Code Integrity (HVCI). The HVCI service in Windows 10 determines whether code executing in kernel mode is securely designed and trustworthy, and helps ensure that all software running in kernel mode, including drivers, securely allocate memory and operate as they are intended.</descrip></descripGrp><ntig><termGrp><term id="2610077">memory integrity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2610925">интегритет на меморијата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46344_2834959_2840463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The desktop-only sync app for OneDrive that enables on-demand file sharing and navigation in File Explorer and that comes pre-installed on PCs.</descrip></descripGrp><ntig><termGrp><term id="2834959">Microsoft OneDrive sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2840463">Синхронизација на Microsoft OneDrive</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46344_2834959_2840468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The desktop-only sync app for OneDrive that enables on-demand file sharing and navigation in File Explorer and that comes pre-installed on PCs.</descrip></descripGrp><ntig><termGrp><term id="2834959">Microsoft OneDrive sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2840468">Синхронизација на OneDrive</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46344_2834960_2840463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The desktop-only sync app for OneDrive that enables on-demand file sharing and navigation in File Explorer and that comes pre-installed on PCs.</descrip></descripGrp><ntig><termGrp><term id="2834960">OneDrive sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2840463">Синхронизација на Microsoft OneDrive</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46344_2834960_2840468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The desktop-only sync app for OneDrive that enables on-demand file sharing and navigation in File Explorer and that comes pre-installed on PCs.</descrip></descripGrp><ntig><termGrp><term id="2834960">OneDrive sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2840468">Синхронизација на OneDrive</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4635_318145_1371474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any combination of keys that must be pressed sequentially.</descrip></descripGrp><ntig><termGrp><term id="318145">access key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371474">комбинација на копчиња</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4635_318145_1372339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any combination of keys that must be pressed sequentially.</descrip></descripGrp><ntig><termGrp><term id="318145">access key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372339">клуч за пристап</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4635_72848_1371474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any combination of keys that must be pressed sequentially.</descrip></descripGrp><ntig><termGrp><term id="72848">key sequence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371474">комбинација на копчиња</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4635_72848_1372339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any combination of keys that must be pressed sequentially.</descrip></descripGrp><ntig><termGrp><term id="72848">key sequence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372339">клуч за пристап</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46353_2612185_2612437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The consumer-friendly name for virtualization-based security (VBS). The VBS service in Windows 10 uses hardware virtualization features to create and isolate a secure region of memory from the normal operating system.</descrip></descripGrp><ntig><termGrp><term id="2612185">Core isolation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2612437">Изолација на јадрото</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46354_2612186_2612439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of open tabs, including applications, files, pages, or websites, which can be saved together and re-opened together when you want to continue with that set of tabs.</descrip></descripGrp><ntig><termGrp><term id="2612186">set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2612439">група</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46355_2612189_2612441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The most important person in a video that you create using the video remix feature in Microsoft Photos. When ​the user selects a person as the "star," then photos and video clip​s of that person will be featured more prominently than other content in the video.​</descrip></descripGrp><ntig><termGrp><term id="2612189">star</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2612441">ѕвезда</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46356_2612191_2614122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft People app.</descrip></descripGrp><ntig><termGrp><term id="2612191">People Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2614122">Преглед на Microsoft луѓе</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46356_2612191_2614123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft People app.</descrip></descripGrp><ntig><termGrp><term id="2612191">People Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2614123">Преглед на луѓе</term><termNote type="geogr