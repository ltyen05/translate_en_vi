и на Microsoft Office</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25427_1177410_1953746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Microsoft Office that allows the user to view and edit image document formats like .TIF, which is the format most traditionally used in fax transmissions (IOs, T&amp;Cs, etc.).</descrip></descripGrp><ntig><termGrp><term id="1177410">MODI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1953746">МОДИ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25447_1606736_1868554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A free online service that enables Office users to share presentations with people who view them on the web.</descrip></descripGrp><ntig><termGrp><term id="1606736">Office Presentation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868554">Услуга за презентации на Office</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25451_1176752_1868464"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A converter that supports dynamic viewing of Pow