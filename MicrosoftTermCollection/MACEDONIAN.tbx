ote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53676_3055645_3056398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Champion Management Platform that allows users to track campaigns across the champion group to see their ranking from a global perspective.</descrip></descripGrp><ntig><termGrp><term id="3055645">Leaderboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3056398">Ранг-листа на прваци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53676_3055645_3056427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Champion Management Platform that allows users to track campaigns across the champion group to see their ranking from a global perspective.</descrip></descripGrp><ntig><termGrp><term id="3055645">Leaderboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3056427">Ранг-листа</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53677_3055646_3056422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Champion Management Platform that allows users to overlay a teamwork champion badge over a profile image for display across the Microsoft 365 solutions.</descrip></descripGrp><ntig><termGrp><term id="3055646">Digital Badge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3056422">Дигитален беџ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53678_3055647_3056436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Champion Management Platform that enables adoption themed tournaments for the entire organization to participate in.</descrip></descripGrp><ntig><termGrp><term id="3055647">Tournament of Teams</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3056436">Турнир на тимови</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53679_3055653_3056433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The group of community champions that participate in the Microsoft 365 Champion Program.</descrip></descripGrp><ntig><termGrp><term id="3055653">Microsoft 365 Champion Community</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3056433">Заедница на прваци во Microsoft 365</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53680_3055658_3056435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The centralized location for sharing resources and services to facilitate the adoption of Microsoft 365 solutions with other users.</descrip></descripGrp><ntig><termGrp><term id="3055658">Microsoft Adoption Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3056435">Центар за усвојување на Microsoft</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53688_3056784_3057330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The group within an organization that offers a specialized form of customer service in which the company focus on what is deemed to be best for the customer.</descrip></descripGrp><ntig><termGrp><term id="3056784">Customer Advocacy Group</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3057330">Група за заштита на клиентите</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53689_3056785_3057327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A badge displayed on a profile image to identify a champion.</descrip></descripGrp><ntig><termGrp><term id="3056785">champion badge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3057327">беџ за првак</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5369_34870_441417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special symbol that breaks a column when inserted into a document. It ends the current column and starts the next column.</descrip></descripGrp><ntig><termGrp><term id="34870">column break</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441417">прелом на колона</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53690_3056787_3060898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, pertaining to a development method that uses a drag-and-drop approach and doesn’t require any coding knowledge.</descrip></descripGrp><ntig><termGrp><term id="3056787">no-code</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3060898">без кодирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53691_3056788_3060897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, pertaining to a development method that uses a drag-and-drop approach and requires basic knowledge of coding to finish the building and deploying process.</descrip></descripGrp><ntig><termGrp><term id="3056788">low-code</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3060897">минимално кодирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53692_3056798_3057749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In gaming, a method by which games just read and write from their desired save directory, using the standard Win32 file IO APIs, and synchronization is handled automatically.</descrip></descripGrp><ntig><termGrp><term id="3056798">cloud save</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3057749">зачувување во облакот</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53693_3056864_3057326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that launches the ink editing experience in Word, allowing the users to edit documents with ink gestures.</descrip></descripGrp><ntig><termGrp><term id="3056864">Action Pen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3057326">Акционо пенкало</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53694_3056893_3057334"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operational setup designed to meet both the physical and technological needs of a business and its workers.</descrip></descripGrp><ntig><termGrp><term id="3056893">modern workplace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3057334">современо работно место</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53695_3056894_3057332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The scalable mechanism by which a mail-originating organization can express domain-level policies and preferences for message validation, disposition, and reporting, that a mail-receiving organization can use to improve mail handling.</descrip></descripGrp><ntig><termGrp><term id="3056894">Domain-based Message Authentication, Reporting, and Conformance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3057332">DMARC</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53695_3056894_3057333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The scalable mechanism by which a mail-originating organization can express domain-level policies and preferences for message validation, disposition, and reporting, that a mail-receiving organization can use to improve mail handling.</descrip></descripGrp><ntig><termGrp><term id="3056894">Domain-based Message Authentication, Reporting, and Conformance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3057333">Проверка на автентичноста на пораките, известување и усогласеност врз основа на домен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53695_3056895_3057332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The scalable mechanism by which a mail-originating organization can express domain-level policies and preferences for message validation, disposition, and reporting, that a mail-receiving organization can use to improve mail handling.</descrip></descripGrp><ntig><termGrp><term id="3056895">DMARC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3057332">DMARC</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53695_3056895_3057333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The scalable mechanism by which a mail-originating organization can express domain-level policies and preferences for message validation, disposition, and reporti