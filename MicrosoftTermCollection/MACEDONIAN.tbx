 resource.</descrip></descripGrp><ntig><termGrp><term id="2341009">breach</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1485346">нарушување на безбедноста</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9698_2341009_2588240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event that compromises the security of a computer, application, network or other resource.</descrip></descripGrp><ntig><termGrp><term id="2341009">breach</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2588240">пробој</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9699_150362_1371636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The measurement of the area in front of and behind the subject that is in focus.</descrip></descripGrp><ntig><termGrp><term id="150362">depth of field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371636">длабочина на полето</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9707_237833_1465433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of masters associated with a particular Visio drawing type, or template. By default, stencils that open with a template are docked on the left side of the drawing window.</descrip></descripGrp><ntig><termGrp><term id="237833">stencil</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1465433">матрица</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9709_144267_1868078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fundamental data type that holds large integers. A Long variable is stored as a 32-bit number ranging in value from -2,147,483,648 to 2,147,483,647.</descrip></descripGrp><ntig><termGrp><term id="144267">Long data type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868078">Тип на долги податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9718_17587_1996172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Internet Explorer that remembers the information you have typed into the Address bar, web forms, or password fields, and which automatically fills in that information if you start to type the same thing again later.</descrip></descripGrp><ntig><termGrp><term id="17587">AutoComplete</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1996172">автоматско пополнување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9726_210054_2696039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of reports or other data that is arranged in a panel format on a single page, or series of pages, in a web browser or SharePoint site.</descrip></descripGrp><ntig><termGrp><term id="210054">dashboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2696039">табла со информации</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9733_1981778_2622338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-released version of a product that is sent to customers and partners for evaluation and feedback.</descrip></descripGrp><ntig><termGrp><term id="1981778">technical preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2622338">технички преглед</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9733_694772_2622338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-released version of a product that is sent to customers and partners for evaluation and feedback.</descrip></descripGrp><ntig><termGrp><term id="694772">beta product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2622338">технички преглед</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9734_42848_441478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The manipulation of data to transform it into some desired result.</descrip></descripGrp><ntig><termGrp><term id="42848">data processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441478">обработка на податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9753_141881_1868059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text or graphics inserted in a document when Microsoft Word carries out a field's instructions. When you print the document or hide field codes, the field results replace the field codes.</descrip></descripGrp><ntig><termGrp><term id="141881">field results</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868059">резултати на поле</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9767_319131_1371637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to text that is aligned along the left margin.</descrip></descripGrp><ntig><termGrp><term id="319131">left-aligned</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371637">порамнет од лево</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9768_652644_1096089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique name that identifies a user account to operating system. An account's user name must be unique among the other group names and user names within its own domain or workgroup.</descrip></descripGrp><ntig><termGrp><term id="652644">Windows user name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1096089">Windows корисничко име</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9775_142952_1868064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A drop-down list box control on a data access page that retrieves records from an underlying recordset based on the value you select from the list. On a grouped page, the control retrieves a specific group of records.</descrip></descripGrp><ntig><termGrp><term id="142952">group filter control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868064">контрола за филтер на група</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9789_158215_442247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The company placing, and often paying for, a promotional message, or advertisement.</descrip></descripGrp><ntig><termGrp><term id="158215">advertiser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442247">огласувач</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9800_30472_441383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In text-based computer graphics, a block of memory addresses that correspond to character spaces on a display screen. The memory allocated to each character space is used to hold the description of the character to be displayed in that space.</descrip></descripGrp><ntig><termGrp><term id="30472">character map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441383">знаковна мапа</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9805_262641_442608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A title animation in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="262641">Subtitle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442608">Поднаслов</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9820_2727454_1371638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory or folder made available to users over the network.</descrip></descripGrp><ntig><termGrp><term id="2727454">file share</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371638">споделен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9820_298002_1371638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory or folder made available to users over the network.</descrip></descripGrp><ntig><termGrp><term id="298002">share</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371638">споделен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9828_558613_2700399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who takes part in an online interaction such as conference call or meeting.</descrip></descripGrp><ntig><termGrp><term id="558613">participant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2700399">учесник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9830_13827_1832152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An activity represented by a time interval that has a start time, an end time, and a duration.</descrip></descripGrp><ntig><termGrp><term id="13827">appointment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832152">состанок</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9831_235026_442498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of confirming that data passing into the system is correct and complies with predefined rules, definitions, or parameters.</descrip></descripGrp><ntig><termGrp><term id="235026">validation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442498">проверка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9837_23010_441323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The partition that contains the Windows operating system and its support files. The boot partition can be, but does not have to be, the same as the system partition.</descrip></descripGrp><ntig><termGrp><term id="23010">boot partition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441323">партиција за подигање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9839_503120_1832191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standardized service agreement between a user and a mobile operator that establishes data service details such as pricing, types of services, and bandwidth.</descrip></descripGrp><ntig><termGrp><term id="503120">data plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832191">план на податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9843_54256_2910504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of computer files on networks, wherein files are stored on a central computer or a server and are requested, reviewed, and modified by more than one individual. When a file is used with different programs or different computers, file sharing can require conversion to a mutually acceptable format. When a single file is shared by many people, access can be regulated through such means as password protection, security clearances, or file locking to prohibit changes to a file by more than one person at a time.</descrip></descripGrp><ntig><termGrp><term id="54256">file sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2910504">споделување датотеки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9849_20127_441302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the printing and display of characters on the screen, an imaginary horizontal line with which the base of each character, excluding descenders, is aligned.</descrip></descripGrp><ntig><termGrp><term id="20127">base line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441302">основна линија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9849_20128_441302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the printing and display of characters on the screen, an imaginary horizontal line with which the base of each character, excluding descenders, is aligned.</descrip></descripGrp><ntig><termGrp><term id="20128">baseline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441302">основна линија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="985_226537_1522820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection, storing, and sharing of information in a single system where many users can access it.</descrip></descripGrp><ntig><termGrp><term id="226537">content management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1522820">управување со содржина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9856_307429_2305561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of time that can elapse before the Exchange server asks a mobile device running Exchange ActiveSync to connect again.</descrip></descripGrp><ntig><termGrp><term id="307429">heartbeat interval</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305561">интервал на отчукување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9865_145487_1372405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component database architecture that provides efficient network and Internet access to many types of data sources, including relational data, mail files, flat files, and spreadsheets. OLE DB comprises a specialized set of COM interfaces that expose data from a variety of data stores, both relational and nonrelational.</descrip></descripGrp><ntig><termGrp><term id="145487">OLE DB</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372405">ОЛЕ ДБ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9865_2072504_1372405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component database architecture that provides efficient network and Internet access to many types of data sources, including relational data, mail files, flat files, and spreadsheets. OLE DB comprises a specialized set of COM interfaces that expose data from a variety of data stores, both relational and nonrelational.</descrip></descripGrp><ntig><termGrp><term id="2072504">Object Linking and Embedding Database</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372405">ОЛЕ ДБ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9865_2440377_1372405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component database architecture that provides efficient network and Internet access to many types of data sources, including relational data, mail files, flat files, and spreadsheets. OLE DB comprises a specialized set of COM interfaces that expose data from a variety of data stores, both relational and nonrelational.</descrip></descripGrp><ntig><termGrp><term id="2440377">OLEDB</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372405">ОЛЕ ДБ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9880_142307_1868062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A substitution that occurs when Windows or your printer uses a font similar to the one you used in your publication to display or print your publication.</descrip></descripGrp><ntig><termGrp><term id="142307">font substitution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868062">замена на фонт</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9884_84006_441784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of devices that communicate either wirelessly or via a physical connection.</descrip></descripGrp><ntig><termGrp><term id="84006">network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441784">мрежа</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9889_262434_1371639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio effect setting that allows users with stereo headphones to experience stereo and multi-channel content without the need to set up an extensive multi-channel speaker system.</descrip></descripGrp><ntig><termGrp><term id="262434">Headphone Virtualization mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371639">Режим за звук на слушалки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9889_262434_442581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio effect setting that allows users with stereo headphones to experience stereo and multi-channel content without the need to set up an extensive multi-channel speaker system.</descrip></descripGrp><ntig><termGrp><term id="262434">Headphone Virtualization mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442581">Режим на виртуелизација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9889_262435_1371639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio effect setting that allows users with stereo headphones to experience stereo and multi-channel content without the need to set up an extensive multi-channel speaker system.</descrip></descripGrp><ntig><termGrp><term id="262435">Virtualization Mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371639">Режим за звук на слушалки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9889_262435_442581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio effect setting that allows users with stereo headphones to experience stereo and multi-channel content without the need to set up an extensive multi-channel speaker system.</descrip></descripGrp><ntig><termGrp><term id="262435">Virtualization Mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442581">Режим на виртуелизација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="989_210451_1372291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A command that will use a print driver installed by OneNote to create an image of a wide variety of filetypes. Files are printed to the print driver and inserted as images into OneNote.</descrip></descripGrp><ntig><termGrp><term id="210451">File as Printout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372291">Датотека како отпечаток</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9891_269336_442676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event triggered by Windows system components that is recorded in the system log, such as the failure of a driver or other system component to load during startup.</descrip></descripGrp><ntig><termGrp><term id="269336">system event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442676">системски настан</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="990_26447_1953715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system of programs and workstations used in designing engineering, architectural, and scientific models ranging from simple tools to buildings, aircraft, integrated circuits, and molecules.</descrip></descripGrp><ntig><termGrp><term id="26447">CAD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1953715">КАД</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="990_26448_1953715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system of programs and workstations used in designing engineering, architectural, and scientific models ranging from simple tools to buildings, aircraft, integrated circuits, and molecules.</descrip></descripGrp><ntig><termGrp><term id="26448">computer-aided design</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1953715">КАД</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9900_185600_1373887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that users can select to indicate that they are currently busy.</descrip></descripGrp><ntig><termGrp><term id="185600">Busy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1373887">Зафатен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9911_33170_441401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The » character.</descrip></descripGrp><ntig><termGrp><term id="33170">closing chevron</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441401">затворен шеврон</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><term