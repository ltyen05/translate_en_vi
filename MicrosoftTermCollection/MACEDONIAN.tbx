ronment that share a common database, directory database, or tree and that is administered as a unit with common rules and procedures, which can include security policies.</descrip></descripGrp><ntig><termGrp><term id="47604">domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441531">домен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16117_347943_1522851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group that is associated with another group so that their properties and the properties of the groups and fields they contain always match. If the properties of one group are changed, the other group is updated automatically.</descrip></descripGrp><ntig><termGrp><term id="347943">reference group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1522851">референтна група</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16119_329894_443021"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request for payment for products and/or services sold.</descrip></descripGrp><ntig><termGrp><term id="329894">bill</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="443021">сметка</term><termNote type="geographicalUsage">MKD</termNote><te