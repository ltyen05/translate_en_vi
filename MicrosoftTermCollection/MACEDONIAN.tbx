1943110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool for functional analysis that shows the general flow of information through a system or program.</descrip></descripGrp><ntig><termGrp><term id="674639">data flow diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943110">дијаграм на тек на податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17851_650211_1868291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that is used to separate the day, month, and year when date values are formatted. The characters are determined by system settings or by the Format function.</descrip></descripGrp><ntig><termGrp><term id="650211">date separator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868291">разделник за датуми</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17854_650214_1372493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The font that a program uses by default to display text.</descrip></descripGrp><ntig><termGrp><term id="650214">default font</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372493">стандарден фонт</term><termNote type="geographicalUsage">MKD</term