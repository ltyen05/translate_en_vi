95928"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special type of folder that enables users to manage a deliverable or work product spanning multiple documents as a single entity.</descrip></descripGrp><ntig><termGrp><term id="773461">document set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1095928">збир документи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21372_773462_1095929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint document library where users can upload files that are then routed automatically to the correct library or folder in the site based upon rules defined by the site administrator.</descrip></descripGrp><ntig><termGrp><term id="773462">Drop Off Library</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1095929">Привремена библиотека</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2138_165180_442266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single character that represents a sequence of characters, usually a combination of a base character and one or more diacritics.</descrip></descripGrp><ntig><termGrp><term id="165180">precomposed character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><