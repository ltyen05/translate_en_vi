</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37003_2105997_2113708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application that either takes advantage of the ability to set a dynamic wallpaper or that takes advantage of the new lock extensibility framework.</descrip></descripGrp><ntig><termGrp><term id="2105997">Live Lock Screen app</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2113708">апликација за заклучување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37003_2106003_2113707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application that either takes advantage of the ability to set a dynamic wallpaper or that takes advantage of the new lock extensibility framework.</descrip></descripGrp><ntig><termGrp><term id="2106003">lock app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2113707">апликација за Динамичен екран при заклучување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37003_2106003_2113708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application that either takes advantage of the ability to set a dynamic wallpaper or that takes advantage of the new lock extensibility framework.</descrip></descripGrp><ntig><termGrp><term id="2106003">lock app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2113708">апликација за заклучување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37004_2105998_2113713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The software update to Windows Phone 8.1.</descrip></descripGrp><ntig><termGrp><term id="2105998">Windows Phone 8.1 Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2113713">Windows Phone 8.1 Update</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37005_2105999_2113712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gesture where the user interacts with the side of the phone to use an experience.</descrip></descripGrp><ntig><termGrp><term id="2105999">side gesture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2113712">страничен гест</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37006_2106000_2113709"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view displaying a mix of the most relevant content and shortcuts for a Live Tile.</descrip></descripGrp><ntig><termGrp><term id="2106000">mix view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2113709">измешан приказ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37007_2106001_2113705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows small business and consumers to lock down the phone or tablet running Windows to only allow the use of specific apps.</descrip></descripGrp><ntig><termGrp><term id="2106001">Apps Corner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2113705">Катче за апликации</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37008_2106002_2113711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A surface that appears on the phone screen with a “soft” key for the Back, Start and Search button. User gets to choose whether it should be visible or not.</descrip></descripGrp><ntig><termGrp><term id="2106002">nav bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2113711">лента за навигација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37017_2844863_2867812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft 365 Apps for business (formerly Office 365 Business) is a small business-level subscription offering that includes Office applications (e.g., Outlook, Word, Excel, PowerPoint, Access (PC only), Publisher (PC only) and cloud file storage and sharing (OneDrive).</descrip></descripGrp><ntig><termGrp><term id="2844863">Microsoft 365 Apps for business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2867812">Апликации на Microsoft 365 за бизнис</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3702_86681_1371444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of translating images of printed text into machine-encoded text.</descrip></descripGrp><ntig><termGrp><term id="86681">OCR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371444">ОЦР</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3702_86681_441802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of translating images of printed text into machine-encoded text.</descrip></descripGrp><ntig><termGrp><term id="86681">OCR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441802">оптичко препознавање знаци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3702_86682_1371444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of translating images of printed text into machine-encoded text.</descrip></descripGrp><ntig><termGrp><term id="86682">optical character recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371444">ОЦР</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3702_86682_441802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of translating images of printed text into machine-encoded text.</descrip></descripGrp><ntig><termGrp><term id="86682">optical character recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441802">оптичко препознавање знаци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37033_2816013_2835201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription, hosted in the Government Community Cloud environment, for government organizations that need communication and collaboration tools and the ability to read and do lightweight editing of documents with the Office Online. It includes all the features of Exchange Online Government Plan 1 plus cloud file storage and sharing, online meetings and instant messaging, HD videoconferencing, intranet and team sites, and other services.</descrip></descripGrp><ntig><termGrp><term id="2816013">Office 365 Government G1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2835201">Office 365 за Влада G1</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37034_2816014_2835203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription, hosted in the Government Community Cloud environment, that is the best plan for government organizations that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Online. It includes all the features of Office 365 Government Community G1 plus Office desktop applications, personalized search and discovery, self-service business intelligence, enterprise management of apps, eDiscovery tools, hosted voicemail with auto-attendant capabilities, and other services.</descrip></descripGrp><ntig><termGrp><term id="2816014">Office 365 Government G3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2835203">Office 365 за Влада G3</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37041_2113983_2182526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app used to provide product feedback that results from the Windows Insider Program.</descrip></descripGrp><ntig><termGrp><term id="2113983">Windows Feedback</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2182526">Windows повратни информации</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37043_2113317_2570576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The external program that enables participants (called "Insiders") to provide feedback on Windows new features.</descrip></descripGrp><ntig><termGrp><term id="2113317">Insider Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2570576">Програма Insider</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37043_2113317_2570579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The external program that enables participants (called "Insiders") to provide feedback on Windows new features.</descrip></descripGrp><ntig><termGrp><term id="2113317">Insider Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2570579">Програма Windows Insider</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37043_2129699_2570576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The external program that enables participants (called "Insiders") to provide feedback on Windows new features.</descrip></descripGrp><ntig><termGrp><term id="2129699">Windows Insider Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2570576">Програма Insider</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37043_2129699_2570579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The external program that enables participants (called "Insiders") to provide feedback on Windows new features.</descrip></descripGrp><ntig><termGrp><term id="2129699">Windows Insider Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2570579">Програма Windows Insider</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNo