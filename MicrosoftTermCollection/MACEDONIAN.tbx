Grp><term id="2399531">Navigation layout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2284851">Навигација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39210_2399532_2284851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway panel that gives users a set of options for changing their sway’s interaction and Structure.</descrip></descripGrp><ntig><termGrp><term id="2399532">Layout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2284851">Навигација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39211_2276525_2284872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process where an organization defines a subset of employee communications that must be reviewed by an audit group, to ensure that the organization is complying with all relevant laws, regulations, and policies.</descrip></descripGrp><ntig><termGrp><term id="2276525">Supervisory Review</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2284872">Надзорен преглед</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNot