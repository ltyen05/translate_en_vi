Set><langSet xml:lang="mk"><ntig><termGrp><term id="2631740">заштитено со права</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46686_2626817_2631714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A storage type that is specifically for computer files.</descrip></descripGrp><ntig><termGrp><term id="2626817">file storage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2631714">склад за датотеки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46687_2626848_2631724"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file storage type where files are stored online and not on the user's hardware.</descrip></descripGrp><ntig><termGrp><term id="2626848">online file storage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2631724">мрежен склад за датотеки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46698_2627238_2631760"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar in mobile apps which has commands that depend on what is on the screen.</descrip></descripGrp><ntig><termGrp><term id="2627238">contextual toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2631760">контекстуален алатник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46699_2627240_3006841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chat that occurs among a subset of the people in a group chat and that cannot be seen by other members of the group.</descrip></descripGrp><ntig><termGrp><term id="2627240">private chat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3006841">приватен разговор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4670_83613_1371476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move around in a document.</descrip></descripGrp><ntig><termGrp><term id="83613">navigate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371476">навигација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46700_2627242_2997399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that returns an array only containing the items from an input array where a second Boolean array contains true.</descrip></descripGrp><ntig><termGrp><term id="2627242">FILTER</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2997399">FILTER</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46708_2627265_2636333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An array formula that can return multiple values.</descrip></descripGrp><ntig><termGrp><term id="2627265">dynamic formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2636333">динамична формула</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4671_87049_441805"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In reference to a computing device or a program, unable to communicate with a primary database or controlling computer.</descrip></descripGrp><ntig><termGrp><term id="87049">offline</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441805">исклучен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46717_2628468_2634587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The open authentication standard developed by the FIDO Alliance which allows online services to strengthen the security of their existing password infrastructure by adding a strong second factor to sign in. The user signs in with the user name and password and then is required to present a second factor device for secure authentication.</descrip></descripGrp><ntig><termGrp><term id="2628468">U2F</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2634587">U2F</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46717_2628468_2634588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The open authentication standard developed by the FIDO Alliance which allows online services to strengthen the security of their existing password infrastructure by adding a strong second factor to sign in. The user signs in with the user name and password and then is required to present a second factor device for secure authentication.</descrip></descripGrp><ntig><termGrp><term id="2628468">U2F</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2634588">Universal 2nd Factor</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46717_2628469_2