otSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29138_1506701_1943280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The definition that is obtained by an index server during a crawl, to identify if any sentences in the item match the pattern for defining a term.</descrip></descripGrp><ntig><termGrp><term id="1506701">extracted definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943280">извлечена дефиниција</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29139_1506703_1943281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A term that an extracted definition applies to.</descrip></descripGrp><ntig><termGrp><term id="1506703">extracted term</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943281">извлечен термин</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29140_1506704_1523093"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of users that has permission to manage all of the servers in a server farm. Members of the Farm Administrators group can perform command-line operations and all of the administrative tasks in Central Administration for the server or server farm.</descrip></descripGrp><ntig><termGrp><term id="1506704">Farm Administrators group</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523093">група администратори на фарма</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29141_1506705_1523095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML fragment that defines a feature and its attributes.</descrip></descripGrp><ntig><termGrp><term id="1506705">feature definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523095">дефиниција на карактеристиката</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29143_1506707_1943282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A GUID that identifies a feature.</descrip></descripGrp><ntig><termGrp><term id="1506707">feature identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943282">идентификатор на карактеристика</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29144_1506709_1943283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A property that is associated with an active feature at a particular scope.</descrip></descripGrp><ntig><termGrp><term id="1506709">feature property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943283">својство на карактеристика</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29145_1506710_1943284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The scope at which a feature can be activated.</descrip></descripGrp><ntig><termGrp><term id="1506710">feature scope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943284">опсег на карактеристика</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29146_1636440_1868638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A source that returns a set of search results for a given search query. The source can be a search service in the local server farm or another server farm, or another search engine that is compliant with the OpenSearch protocol.</descrip></descripGrp><ntig><termGrp><term id="1636440">result source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868638">извор на резултати</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote>