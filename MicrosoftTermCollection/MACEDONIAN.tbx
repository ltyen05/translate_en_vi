geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22040_782586_1372643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sensor that uses ultrasound, infrared, heat or vibration stimuli to detect movement.</descrip></descripGrp><ntig><termGrp><term id="782586">motion sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372643">сензор за движење</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22041_782588_1372644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A biometric sensor that analyses your eye retina to recognize or authenticate identity.</descrip></descripGrp><ntig><termGrp><term id="782588">retinal scanner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372644">скенер на мрежницата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22042_782589_1372645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that can respond to an applied stimulus by generating an electrical signal.</descrip></descripGrp><ntig><termGrp><term id="782589">electrical sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372645">електричен сензор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22043_782590_1372646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that is used for mechanical measurement of force, scale, pressure, strain, etc.</descrip></descripGrp><ntig><termGrp><term id="782590">mechanical sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372646">механички сензор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22044_782669_1372647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that tracks environmental changes such as temperature, atmospheric pressure, humidity, wind speed and wind direction.</descrip></descripGrp><ntig><termGrp><term id="782669">environmental sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372647">метереолошки сензор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22045_782671_1372648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of sensor that can determine without physical contact if an object/person is nearby, or can be used to measure the distance between the object/person and the sensor device.</descrip></descripGrp><ntig><termGrp><term id="782671">proximity sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372648">сензор за близина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22047_1053912_1372649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of sensor (such as a proximity sensor) that uses radio frequency identification (RFID) for a numerous purposes, such as identification of physical items, automatic log on, location of people, etc.</descrip></descripGrp><ntig><termGrp><term id="1053912">radio frequency identification sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372649">РФИД-сензор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22047_1053912_1372650"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of sensor (such as a proximity sensor) that uses radio frequency identification (RFID) for a numerous purposes, such as identification of physical items, automatic log on, location of people, etc.</descrip></descripGrp><ntig><termGrp><term id="1053912">radio frequency identification sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372650">сензор за идентификација на радиофреквенции</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22047_782676_1372649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of sensor (such as a proximity sensor) that uses radio frequency identification (RFID) for a numerous purposes, such as identification of physical items, automatic log on, location of people, etc.</descrip></descripGrp><ntig><termGrp><term id="782676">RFID sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372649">РФИД-сензор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22047_782676_1372650"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of sensor (such as a proximity sensor) that uses radio frequency identification (RFID) for a numerous purposes, such as identification of physical items, automatic log on, location of people, etc.</descrip></descripGrp><ntig><termGrp><term id="782676">RFID sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372650">сензор за идентификација на радиофреквенции</term><termNote type="geographicalUsage">MKD</termNote><termNo