rm id="3030951">Терминал</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48674_2753773_2757675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based version of Kaizala that allows users to access Kaizala via a browser and that gives them many of the same features as the mobile Kaizala-app.</descrip></descripGrp><ntig><termGrp><term id="2753773">Kaizala Web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2757675">веб-страница на Kaizala</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48675_2753774_2757677"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A means of spreading multiple incoming calls to a single telephone number, to multiple lines.</descrip></descripGrp><ntig><termGrp><term id="2753774">line hunting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2757677">лов на линии</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48677_2753779_2757694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The second argument in a VLOOKUP or HLOOKUP function.</descrip></descripGrp><ntig><termGrp><term id="2753779">table_array</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2757694">матрица на табела</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48678_2753781_2757679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A state of having different changes made to the same document in multiple locations that can prevent the document from being saved until they are reconciled.</descrip></descripGrp><ntig><termGrp><term id="2753781">page conflict</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2757679">конфликт на страница</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48679_2753782_2757665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A total amount of time spent at work emailing, in meetings, and on chats or calls.</descrip></descripGrp><ntig><termGrp><term id="2753782">collaboration time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2757665">време на соработка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48682_2753813_2757688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies a row in an Excel sheet in order, starting at 1.</descrip></descripGrp><ntig><termGrp><term id="2753813">row index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2757688">индекс на ред</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48683_2753814_2757668"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A letter that identifies a column in an Excel sheet in order, starting at A.</descrip></descripGrp><ntig><termGrp><term id="2753814">column index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2757668">индекс на колона</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48684_2753815_2757687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A root of a polynomial that is a rational number.</descrip></descripGrp><ntig><termGrp><term id="2753815">rational root</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2757687">рационален корен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNo