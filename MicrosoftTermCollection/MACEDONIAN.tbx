</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32057_1632109_1868627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A font rendering technique that takes advantage of partial pixels to make text appear sharper on the screen.</descrip></descripGrp><ntig><termGrp><term id="1632109">subpixel rendering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868627">изострено позиционирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3206_231966_442414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar at the top of the Excel window that you use to enter or edit values or formulas in cells or charts. Displays the constant value or formula stored in the active cell.</descrip></descripGrp><ntig><termGrp><term id="231966">formula bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442414">лента за формули</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32061_1632111_1868628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of XML mapping that links WordprocessingML content directly to the backing data in the custom XML part.</descrip></descripGrp><ntig><termGrp><term id="1632111">rich text XML mapping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868628">XML-мапирање на богат текст</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32062_1632112_1643919"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A price that reflects a representative value in other currencies. The specific price of a price tier that is shown in one currency will be close to the corresponding price in another currency. Foreign exchange, differences in taxation policies, and other market factors influence the determination of a price tier’s price that is shown in another currency.</descrip></descripGrp><ntig><termGrp><term id="1632112">price tier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1643919">ценовно ниво</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32066_1632116_1832379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The screen in the Store that highlights new and updated games, apps, and music.</descrip></descripGrp><ntig><termGrp><term id="1632116">spotlight</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832379">актуелно</term><termNote type="g