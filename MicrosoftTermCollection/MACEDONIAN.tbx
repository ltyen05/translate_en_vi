и</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41781_2365464_2369822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Learning Tools feature that transcribes what the user says into the open application.​​</descrip></descripGrp><ntig><termGrp><term id="2365464">Enhanced dictation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2369822">Диктат</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41781_2365464_2369823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Learning Tools feature that transcribes what the user says into the open application.​​</descrip></descripGrp><ntig><termGrp><term id="2365464">Enhanced dictation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2369823">Подобрен диктат</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41781_2365465_2369822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Learning Tools feature that transcribes what the user says into the open application.​​</descrip></descripGrp><ntig><termGrp><term id="2365465">Dictate</term><termNote