">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2175481">Спореди</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37264_2113982_2175489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in the Clock app that allows the user to input any time and see it converted to the equivalent time in another time zone.</descrip></descripGrp><ntig><termGrp><term id="2113982">Compare</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2175489">Споредба на времето</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37265_2113985_2176553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To automatically correct and improve the user's photos with adjustments to color, contrast, red eye, straightening, and more.</descrip></descripGrp><ntig><termGrp><term id="2113985">enhance</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2176553">подобри</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37266_2114005_2182417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tab in a file or folder Properties dialog box that allows the user to set, view, change, or remove file and folder permissions.</descrip></descripGrp><ntig><termGrp><term id="2114005">Security tab</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2182417">картичка Безбедност</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37267_2114067_2180975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of the Store that contains a selection of products presented to the customer in a group. The products may be purchased individually.</descrip></descripGrp><ntig><termGrp><term id="2114067">Collections</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2180975">Колекции</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37268_2114068_2161152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of the Store that includes the top apps, games, movies, and TV charts (Free, Paid, New and rising, Grossing, and Best rated).</descrip></descripGrp><ntig><termGrp><term id="2114068">Top charts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2161152">Топ листи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37269_2114069_2180948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of the Store that shows subgroups of apps and games, grouped by intended use or function.</descrip></descripGrp><ntig><termGrp><term id="2114069">Categories</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2180948">Категории</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37270_2114070_2180772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of the Store where account holders can manage their account.</descrip></descripGrp><ntig><termGrp><term id="2114070">Account</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2180772">Сметка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37271_2114071_2181755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of the Store showing the group of apps that the user owns.</descrip></descripGrp><ntig><termGrp><term id="2114071">My apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2181755">Мои апликации</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37272_2114072_2181727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of the Store where the user can set and update the Store account settings.</descrip></descripGrp><ntig><termGrp><term id="2114072">My account</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2181727">Моја сметка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37274_2114074_2182388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An assessment of a Store item on a scale that corresponds to the user's opinion of the content.</descrip></descripGrp><ntig><termGrp><term id="2114074">rating</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2182388">рејтинг</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37275_2114075_2785764"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A critical evaluation of an item by the customers.</descrip></descripGrp><ntig><termGrp