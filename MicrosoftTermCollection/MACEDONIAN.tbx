try id="3715_39387_1371445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key that, when pressed in combination with another key, gives the other key an alternative meaning.</descrip></descripGrp><ntig><termGrp><term id="39387">CTRL key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371445">копче Control</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3715_39387_1371446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key that, when pressed in combination with another key, gives the other key an alternative meaning.</descrip></descripGrp><ntig><termGrp><term id="39387">CTRL key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371446">копче CTRL</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3715_39387_441454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key that, when pressed in combination with another key, gives the other key an alternative meaning.</descrip></descripGrp><ntig><termGrp><term id="39387">CTRL key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441454">CTRL</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37240_2113073_2161324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transient, contextual UI element that appears near to the user’s focus and appears as an ellipsis within a square.</descrip></descripGrp><ntig><termGrp><term id="2113073">Mini Toolbar Indicator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2161324">Индикатор за мини алатник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37242_2113075_2161330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A callout in a UI that contains help information for a new feature, is context-sensitive, and contains information in the form of text, graphics, or animations.</descrip></descripGrp><ntig><termGrp><term id="2113075">Teaching callout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2161330">Објаснување за подучување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37244_2113077_2161325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter in the context of a particular channel that shows only the videos uploaded or owned by the user who is currently logged in.</descrip></descripGrp><ntig><termGrp><term id="2113077">My videos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2161325">Мои видеа</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37249_2113090_2214881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user account and associated credentials that is used to access Microsoft’s and 3rd parties’ business services, such as Office 365. Work or school accounts are usually assigned to end users by their organization (work, school, non-profit) and managed by the admin. However, some business services like Yammer support work or school accounts that were created by end users, without IT involvement. We sometimes refer to these accounts as “viral” AAD accounts but we don’t use this term externally. Work or school accounts are stored in Azure Active Directory (AAD) and managed by Microsoft on behalf of the organization. One of the key difference with a Microsoft account is that users don’t own the account and will typically loose access to it if they leave the organization. Other aspects like password policies are imposed by admins.</descrip></descripGrp><ntig><termGrp><term id="2113090">work or school account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2214881">Службена или училишна сметка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37250_2113091_2214878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user account and associated credentials that is used to access Microsoft’s and 3rd parties’ business services, such as Office 365. Work or school accounts are usually assigned to end users by their organization (work, school, non-profit) and managed by the admin. However, some business services like Yammer support work or school accounts that were created by end users, without IT involvement. We sometimes refer to these accounts as “viral” AAD accounts but we don’t use this term externally. Work or school accounts are stored in Azure Active Directory (AAD) and managed by Microsoft on behalf of the organization. One of the key difference with a Microsoft account is that users don’t own the account and will typically loose access to it if they leave the organization. Other aspects like password policies are imposed by admins.</descrip></descripGrp><ntig><termGrp><term id="2113091">work account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2214878">Службена сметка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37255_2113318_2182522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Terminal Services session.</descrip></descripGrp><ntig><termGrp><term id="2113318">TS session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2182522">ТС-сесија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37255_2113319_2182522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Terminal Services session.</descrip></descripGrp><ntig><termGrp><term id="2113319">Terminal Services session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2182522">ТС-сесија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37261_2113977_2180914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that takes the user to the previous item or page.</descrip></descripGrp><ntig><termGrp><term id="2113977">Back button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2180914">копче Назад</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37262_2113979_2182397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button pressed to update displayed information with current data.</descrip></descripGrp><ntig><termGrp><term id="2113979">Refresh button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2182397">копче Освежи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalG