316">давател на интернет-пристап</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27850_1465579_2324148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of notification that is generated by user-defined rules meant to inform him/her of events, conditions, and status changes.</descrip></descripGrp><ntig><termGrp><term id="1465579">alert</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2324148">внимание</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27852_1465584_2608834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collective of attack vectors through which a system can be attacked successfully.</descrip></descripGrp><ntig><termGrp><term id="1465584">attack surface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2608834">површина за напад</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27934_1468118_2624500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view where the preview area is centered and the thumbnails that immediately precede and follow the current thumbnail are adjacent to the preview area.</descrip></descripGrp><ntig><termGrp><term id="1468118">carousel view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2624500">приказ како вртелешка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2795_60402_2305842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Depending on values embedded in the program code rather than on values that can be input and changed by the user.</descrip></descripGrp><ntig><termGrp><term id="60402">hard-coded</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305842">со силни кодови</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2796_3846_441199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Self-propagating malicious software that can automatically distribute itself from one computer to another through network connections. A worm can take harmful action, such as consuming network or local system resources, possibly causing a denial of service attack.</descrip></descripGrp><ntig><termGrp><term id="3846">worm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441199">црв</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28_2656622_2657316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of the user interface (UI) in Outlook Web Access that can be hosted in iframes as part of other Web applications such as SharePoint Portal Server portals. Outlook Web Access exposes a set of Outlook Web Access Web Part URLs that allow other applications to request certain portions of the Outlook Web Access UI. For example, another application can load the Outlook Web Access Web Part URL for the Inbox, Calendar, or Contact folder into an iframe hosted in that application.</descrip></descripGrp><ntig><termGrp><term id="2656622">Outlook Web App Web Part</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2657316">Елемент на веб за апликацијата Outlook преку веб</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="280_114555_441944"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To organize information, such as a list of files, in a particular order. For example, a list of files can be sorted alphabetically by name in ascending or descending order.</descrip></descripGrp><ntig><termGrp><term id="114555">sort</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441944">сортирај</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote 