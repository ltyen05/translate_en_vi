.</descrip></descripGrp><ntig><termGrp><term id="3117503">Electronic Product Environmental Assessment Tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3117901">Алатка за еколошка проценка на електронски производи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54981_3117503_3117902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The global ecolabel for the Information Technology sector that helps purchasers, manufacturers, resellers, and others buy and sell environmentally preferable electronic products.</descrip></descripGrp><ntig><termGrp><term id="3117503">Electronic Product Environmental Assessment Tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3117902">EPEAT</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54981_3117504_3117901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The global ecolabel for the Information Technology sector that helps purchasers, manufacturers, resellers, and others buy and sell environmentally preferable electronic products.</descrip></descripGrp><ntig><termGrp><term id="3117504">EPEAT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3117901">Алатка за еколошка проценка на електронски производи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54981_3117504_3117902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The global ecolabel for the Information Technology sector that helps purchasers, manufacturers, resellers, and others buy and sell environmentally preferable electronic products.</descrip></descripGrp><ntig><termGrp><term id="3117504">EPEAT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3117902">EPEAT</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54982_3117505_3117920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of identifying, conducting negotiations with, and forming agreements with suppliers of goods and services that are socially, legally, and ethically responsible.</descrip></descripGrp><ntig><termGrp><term id="3117505">responsible sourcing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3117920">одговорно обезбедување на добавувачи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55010_3118062_3118624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A deployment strategy that provides employees the flexibility to access corporate applications, services, and data from the device of their choice.</descrip></descripGrp><ntig><termGrp><term id="3118062">Bring Your Own PC</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3118624">Користење на својот компјутер</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55010_3118062_3118625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A deployment strategy that provides employees the flexibility to access corporate applications, services, and data from the device of their choice.</descrip></descripGrp><ntig><termGrp><term id="3118062">Bring Your Own PC</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3118625">BYOPC</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55010_3118063_3118624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A deployment strategy that provides employees the flexibility to access corporate applications, services, and data from the device of their choice.</descrip></descripGrp><ntig><termGrp><term id="3118063">BYOPC</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3118624">Користење на својот компјутер</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55010_3118063_3118625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A deployment strategy that provides employees the flexibility to access corporate applications, services, and data from the device of their choice.</descrip></descripGrp><ntig><termGrp><term id="3118063">BYOPC</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3118625">BYOPC</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55011_3118476_3118912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of water that is socially equitable, environmentally sustainable, and economically beneficial.</descrip></descripGrp><ntig><termGrp><term id="3118476">water stewardship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3118912">одговорно користење на водата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55012_3118479_3118627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The disclosure of information such as suppliers, processing conditions and purchasing practices to consumers and other companies in the supply chain.</descrip></descripGrp><ntig><termGrp><term id="3118479">supply chain transparency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3118627">транспарентност на синџирот за снабдување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55013_3118483_3118626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An environmental standard that sets specified levels of performance in order to claim that a product or service is environmentally preferable.</descrip></descripGrp><ntig><termGrp><term id="3118483">eco-standard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3118626">еколошки стандард</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55023_3118515_3122892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft Teams, a meeting view that users can switch into in order to use a Mesh space for the meeting.</descrip></descripGrp><ntig><termGrp><term id="3118515">immersive space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3122892">сеопфатен простор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55026_3118923_3118970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The different services and products that are accessible to users within Microsoft Fabric.</descrip></descripGrp><ntig><termGrp><term id="3118923">analytics artifacts</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3118970">артефакти за аналитика</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55027_3119009_3119056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of comprehensive systems, tools, and services that organizations use for their unique analytics efforts.</descrip></descripGrp><ntig><termGrp><term id="3119009">analytics estate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3119056">комплет за аналитика</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55028_3119095_3119142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The different systems and tools that users can access and use immediately through the SaaS experience within Microsoft Fabric.</descrip></descripGrp><ntig><termGrp><term id="3119095">data artifacts</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3119142">артефакти за податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55029_3119181_3119228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An inventory of the data in an organization that uses metadata and enables users to find relevant data.</descrip></descripGrp><ntig><termGrp><term id="3119181">data catalog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3119228">каталог на податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55030_3119267_3119314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of attesting data sets within OneLake as being trusted and authoritative.</descrip></descripGrp><ntig><termGrp><term id="3119267">data certification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3119314">сертификација на податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55031_3119353_3120243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of storage volume that improves performance for developer workloads.</descrip></descripGrp><ntig><termGrp><term id="3119353">dev drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3120243">податочна единица за развивачи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55032_3119357_3119406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The costs associated with organizations having to integrate different analytics products and services together to develop a full solution.</descrip></descripGrp><ntig><termGrp><term id="3119357">integration tax</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3119406">трошок за интеграција</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55033_3119445_3119492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of storage architecture that uses a data lake to hold all relevant data for an organization, rather than a data warehouse or other relational database.</descrip></descripGrp><ntig><termGrp><term id="3119445">lake-first</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3119492">приоритет на езеро со податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55034_3119531_3119878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability that enables administrators to secure specific tables or columns from specific report viewers who do not have appropriate access levels.</descrip></descripGrp><ntig><termGrp><term id="3119531">object-level security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3119878">безбедност на ниво на објект</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55035_3119825_3119964"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of structuring information models and associated data schemas such that every data element is mastered (or edited) in only one place.</descrip></descripGrp><ntig><termGrp><term id="3119825">single source of truth</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3119964">единствен извор на вистината</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55036_3119828_3120049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The enterprise-grade data lake as a service provided within each tenant of Microsoft Fabric.</descrip></descripGrp><ntig><termGrp><term id="3119828">OneLake</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3120049">OneLake</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55037_3119830_3120134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft Fabric, the virtualized copy of data in the lake that all analytical engines can access.</descrip></descripGrp><ntig><termGrp><term id="3119830">One Copy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3120134">One Copy</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55048_3129686_3132040"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Unity plugin provided by the Mesh Toolkit for uploading a Mesh environment to a Mesh world.</descrip></descripGrp><ntig><termGrp><term id="3129686">Mesh Toolkit Uploader</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3132040">Mesh Toolkit Uploader</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termG