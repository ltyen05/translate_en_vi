ine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56105_3155926_3157726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The highest or lowest level that has ever been reached.</descrip></descripGrp><ntig><termGrp><term id="3155926">record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3157726">рекорд</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56108_3156010_3157727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An unsurpassed achievement in a particular sport or activity.</descrip></descripGrp><ntig><termGrp><term id="3156010">record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3157727">рекорд</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56110_3156311_3156849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Defender feature that enables customers to be alerted when they connect to public Wi-Fi and prompt them to turn on Defender VPN for a secure connection.</descrip></descripGrp><ntig><termGrp><term id="3156311">safer Wi-Fi</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3156849">побезбедна Wi-Fi мрежа</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56111_3156312_3156847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in the Edge management service that will give admins the controls to manage settings for enterprise AI features, including Copilot in Edge.</descrip></descripGrp><ntig><termGrp><term id="3156312">enterprise secure AI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3156847">безбедна ВИ за претпријатија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56112_3156313_3156845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Edge management service that gives admins the controls to use Copilot in Edge to manage profile switching for Enterprise AI users.</descrip></descripGrp><ntig><termGrp><term id="3156313">automatic profile switching</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3156845">автоматска промена на профил</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56113_3156314_3156848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An opt-in feature in Edge that allows users to receive browser updates as soon as they become available and the computer is idle.</descrip></descripGrp><ntig><termGrp><term id="3156314">instant update</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3156848">инстант ажурирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56114_3156315_3157700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A destination on the Edge update page and the Copilot onboarding page with chat prompt suggestions to hep users get started using Copilot in Edge and other Copilot experiences.</descrip></descripGrp><ntig><termGrp><term id="3156315">prompt hub</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3157700">центар за прашања</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56115_3156316_3156846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to search the web with two search engines simultaneously.</descrip></descripGrp><ntig><termGrp><term id="3156316">dual search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3156846">двојно пребарување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammati