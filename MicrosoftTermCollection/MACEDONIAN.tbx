oun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868469">биномна дистрибуција</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25538_1176985_1943199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server technology that enables users to load, and display Visio drawings on Microsoft SharePoint Server 2010.</descrip></descripGrp><ntig><termGrp><term id="1176985">Visio Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943199">Visio Services in Microsoft SharePoint Server 2010</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25538_1231905_1943199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server technology that enables users to load, and display Visio drawings on Microsoft SharePoint Server 2010.</descrip></descripGrp><ntig><termGrp><term id="1231905">Visio Services in Microsoft SharePoint Server 2010</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943199">Visio Services in Microsoft SharePoint Server 2010</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNo