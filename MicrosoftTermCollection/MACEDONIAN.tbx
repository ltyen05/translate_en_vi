 administrator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2755228">Администратор на компанија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48440_2737132_2755239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unlimited administrator role that can manage all aspects of Azure Active Directory and Microsoft services that use Azure Active Directory identities.</descrip></descripGrp><ntig><termGrp><term id="2737132">Global administrator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2755239">Глобален администратор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48440_2737132_2828012"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unlimited administrator role that can manage all aspects of Azure Active Directory and Microsoft services that use Azure Active Directory identities.</descrip></descripGrp><ntig><termGrp><term id="2737132">Global administrator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2828012">глобален администратор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termN