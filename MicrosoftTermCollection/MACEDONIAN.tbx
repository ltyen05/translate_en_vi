n">The app in Microsoft Teams that allows organizations to create basic check-in forms for a range of processes (end of shift, store evaluations, recurring action items) based off out-of-the-box tools.</descrip></descripGrp><ntig><termGrp><term id="3052180">Updates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3052821">Ажурирања</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53613_3052187_3052820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that connects business owners with payment providers in Microsoft Teams and helps them receive payments from customers while they register for a webinar and during a meeting.</descrip></descripGrp><ntig><termGrp><term id="3052187">Payments</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3052820">Плаќања</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53614_3052229_3052815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The free Microsoft-owned domain used by default for some automatic user creation and domain transfer scenarios when the tenant hasn't added a custom domain.</descrip></descripGrp><ntig><termGrp><term id="3052229">fallback domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:l