cribe or add additional information when users hover over, focus on, or click an interactive element.</descrip></descripGrp><ntig><termGrp><term id="3106186">popover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3107252">скок-прозорец</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54696_3106187_3107241"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within GroupMe app that helps users connect with the various clubs and organizations at college or university.</descrip></descripGrp><ntig><termGrp><term id="3106187">Campus Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3107241">Поврзување во универзитетски комплекс</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54697_3106189_3107243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Designer as well as a "mini app" that uses AI to generate images from a customer's text description.</descrip></descripGrp><ntig><termGrp><term id="3106189">Image Creator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3107243">Алатка за создавање слики</term><termNote type="geographicalUsage">MKD</termNote><termNote type="pa