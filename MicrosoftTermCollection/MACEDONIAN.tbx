en-US"><descripGrp><descrip type="definition">The Excel function that returns TRUE if the value argument is an error (except #N/A), otherwise it returns FALSE.</descrip></descripGrp><ntig><termGrp><term id="2646637">ISERR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2997402">ISERR</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4697_39890_1867969"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cells that you copy when you want to paste data into another location. After you copy cells, a moving border appears around them to indicate that they've been copied.</descrip></descripGrp><ntig><termGrp><term id="39890">copy area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1867969">област за копирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46978_2646849_2997404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that returns TRUE if the value argument contains a logical value, otherwise it returns FALSE.</descrip></descripGrp><ntig><termGrp><term id="2646849">ISLOGICAL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2997404">ISLOGICAL</term><termNote type="geographic