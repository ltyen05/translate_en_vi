oun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442749">комплексен број</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33147_1762377_1767217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report generated by OEMs for each OA 3.0 manufactured computer which is then sent to Microsoft for processing. This report includes the hardware hash value and Product Key ID.</descrip></descripGrp><ntig><termGrp><term id="1762377">computer build report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1767217">CBR</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33147_1762377_1767679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report generated by OEMs for each OA 3.0 manufactured computer which is then sent to Microsoft for processing. This report includes the hardware hash value and Product Key ID.</descrip></descripGrp><ntig><termGrp><term id="1762377">computer build report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1767679">извештај за верзијата на компјутерот</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singul