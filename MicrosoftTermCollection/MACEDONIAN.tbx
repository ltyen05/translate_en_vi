arm-wide service that either responds to query requests from front-end Web servers or crawls items.</descrip></descripGrp><ntig><termGrp><term id="1506784">Office SharePoint Server Search service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943323">Услуга за пребарување на сервер на Office SharePoint</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29199_1506785_1523133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authorization that allows a user to retrieve an entire file.</descrip></descripGrp><ntig><termGrp><term id="1506785">Open Item permission</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523133">Дозвола за отворање ставка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29200_1506786_1943324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A requisite permission during the import or export of a SharePoint site.</descrip></descripGrp><ntig><termGrp><term id="1506786">Open Web permission</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943324">Отворена веб-дозвола</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote