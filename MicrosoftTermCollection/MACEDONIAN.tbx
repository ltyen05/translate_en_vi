mber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40392_2347434_2350238"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart, resembling a funnel, that displays values as progressively decreasing proportions.</descrip></descripGrp><ntig><termGrp><term id="2347434">funnel chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2350238">графикон во форма на инка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40398_2347587_2350243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that reflects fluctuation of data.</descrip></descripGrp><ntig><termGrp><term id="2347587">stock chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2350243">дијаграм за берза</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40399_2347588_2350237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Docs.com online portfolio on a user's profile site that displays resume content as rendered by Sway.</descrip></descripGrp><ntig><termGrp><term id="2347588">About</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2350237">За</term><termNote type="geographicalUsage">MKD</termNote><termNote typ