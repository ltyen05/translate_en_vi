, depending on the case.</descrip></descripGrp><ntig><termGrp><term id="2685310">cutoff score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2687084">граничен резултат</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47706_2685311_2688951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams' feature that allows users to obscure their surroundings to remove distraction during video calls.</descrip></descripGrp><ntig><termGrp><term id="2685311">Background blur in Microsoft Teams</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2688951">Замаглување на заднина во Microsoft Teams</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47706_2685311_2727902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams' feature that allows users to obscure their surroundings to remove distraction during video calls.</descrip></descripGrp><ntig><termGrp><term id="2685311">Background blur in Microsoft Teams</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2727902">замаглување на мојата заднина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun