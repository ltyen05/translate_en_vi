:lang="en-US"><descripGrp><descrip type="definition">The online community where IT professionals, developers, and end-users, as well as Microsoft employees can interact, ask questions, share ideas or observations on Office 365 and many other Microsoft technologies.</descrip></descripGrp><ntig><termGrp><term id="3054295">Microsoft Technical Community</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3055223">Microsoft Technical Community</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53663_3054432_3055918"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows 365 capability that allows the user to work offline in your Cloud PC environment and sync when reconnected.</descrip></descripGrp><ntig><termGrp><term id="3054432">Windows 365 Offline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3055918">Работење офлајн преку Windows 365</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53664_3054433_3055917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows 365 capability that allows the user to boot directly to your Cloud PC.</descrip></descripGrp><ntig><termGrp><term id="3054433">Windows 365 Boot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3055917">Подигање преку Windows 365</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53665_3054434_3055921"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows 365 capability that allows the user to swipe between desktop and a Cloud PC/Windows 365 environment as part of task view.</descrip></descripGrp><ntig><termGrp><term id="3054434">Windows 365 Switch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3055921">Промена на околината преку Windows 365</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53668_3055383_3059557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to device features that can detect if someone is coming or going from a device, triggering the device to wake or lock.</descrip></descripGrp><ntig><termGrp><term id="3055383">presence sensing</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3059557">откривање на присуство</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53669_3055384_3055915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature on select devices with a sensor to detect motion as someone approaches so the device powers back on.</descrip></descripGrp><ntig><termGrp><term id="3055384">wake on approach</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3055915">будење при приближување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53670_3055385_3055914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature on select devices with the proper sensor to detect motion as someone walks away from their device so it powers down/sleeps to save power.</descrip></descripGrp><ntig><termGrp><term id="3055385">lock on leave</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3055914">заклучување при оддалечување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53671_3055386_3059544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that dims or brightens the display in response to lighting conditions.</descrip></descripGrp><ntig><termGrp><term id="3055386">adaptive dimming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3059544">приспособливо затемнување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53673_3055633_3059554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Gaming Runtime utility that helps ensure a MSIXVC packaged PC game is in healthy state before the game process starts.</descrip></descripGrp><ntig><termGrp><term id="3055633">PC Bootstrapper</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3059554">PC Bootstrapper</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53674_3055637_3056400"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The toolkit within Microsoft Teams designed to help organizations onboard, manage and inspire teamwork champions to achieve more.</descrip></descripGrp><ntig><termGrp><term id="3055637">Champion Management Platform</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3056400">Платформа за управување со прваци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53675_3055638_3056347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A role performed by an employee in an organization that helps driving engagement and business transformation.</descrip></descrip