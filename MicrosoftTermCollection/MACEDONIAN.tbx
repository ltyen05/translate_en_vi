ech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868467">еднокрак тест</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25485_1176837_1868468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test in which the null hypothesis is rejected if the value of the test statistic falls into a specific tail of the probability distribution (e.g. the test statistic must be greater than a critical value in order to reject the null hypothesis).</descrip></descripGrp><ntig><termGrp><term id="1176837">one-tailed test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868468">едностран тест</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25485_1176838_1868467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test in which the null hypothesis is rejected if the value of the test statistic falls into a specific tail of the probability distribution (e.g. the test statistic must be greater than a critical value in order to reject the null hypothesis).</descrip></descripGrp><ntig><termGrp><term id="1176838">one-sided test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868467">еднокрак тест</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25485_1176838_1868468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test in which the null hypothesis is rejected if the value of the test statistic falls into a specific tail of the probability distribution (e.g. the test statistic must be greater than a critical value in order to reject the null hypothesis).</descrip></descripGrp><ntig><termGrp><term id="1176838">one-sided test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868468">едностран тест</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2550_9793_441240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode of setup that allows network administrators to silently deploy to client computers.</descrip></descripGrp><ntig><termGrp><term id="9793">administrative setup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441240">административни параметри</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2550_9794_441240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode of setup that allows network administrators to silently deploy to client computers.</descrip></descripGrp><ntig><termGrp><term