Grp><term id="1868102">релативно позиционирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42822_2428420_2775184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual personification created by a player to represent them in social spaces in an app.</descrip></descripGrp><ntig><termGrp><term id="2428420">avatar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2775184">аватар</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42828_2428470_2431685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Learning Tools feature that allows users to change letter, word, line, and column spacing to reduce visual crowding.</descrip></descripGrp><ntig><termGrp><term id="2428470">Text Spacing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2431685">Растојание во текст</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42829_2428723_2466566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The task pane (in Office and other programs) where users can view a translation of other content and control the settings for that translation.</descrip></descripGrp><ntig><termGrp><term id="2428723">Translator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2466566">Преведувач</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42832_2429234_2433715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word feature that supports the use of LaTeX math equations.​​</descrip></descripGrp><ntig><termGrp><term id="2429234">LaTeX Equations</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2433715">Равенки на LaTeX</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42833_2429242_2433716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SharePoint feature that allows users to post news articles to a team site or a group, so that those articles show up on the homepage and News page of the site or group.</descrip></descripGrp><ntig><termGrp><term id="2429242">News</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2433716">Вести</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42836_2429486_2765708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft service that provides business leaders with information on organizational trends on how employees as a whole allocate their work time as well as trends on networking, communication, and collaboration within an organization.</descrip></descripGrp><ntig><termGrp><term id="2429486">Microsoft Workplace Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2765708">Аналитика на работно место</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42836_2759974_2765708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft service that provides business leaders with information on organizational trends on how employees as a whole allocate their work time as well as trends on networking, communication, and collaboration within an organization.</descrip></descripGrp><ntig><termGrp><term id="2759974">Workplace Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2765708">Аналитика на работно место</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42845_2429854_3031114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure of attrition or loss.</descrip>