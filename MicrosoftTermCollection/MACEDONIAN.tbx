term id="32059">clear</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441394">исчисти</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8178_237383_1943077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security feature that allows for greater granularity and customization of user permissions.</descrip></descripGrp><ntig><termGrp><term id="237383">Fine-Grained Permissions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943077">Фино филтрирани дозволи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8180_319923_1371593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To suppress the sound produced by a device or application.</descrip></descripGrp><ntig><termGrp><term id="319923">mute</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371593">исклучи го звукот</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8180_319923_442967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To suppress the sound produced by a device or application.</descrip></descripGrp><ntig><termGrp><term id="319923">mute</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442967">исклучи звук</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8188_46307_1943034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that provides access to data and objects in a directory or network environment.</descrip></descripGrp><ntig><termGrp><term id="46307">directory service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943034">услуга на директориум</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8196_146580_1953752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic file format that is supported by some World Wide Web browsers. PNG supports variable transparency of images (alpha channels) and control of image brightness on different computers (gamma correction). PNG files are compressed bitmaps.</descrip></descripGrp><ntig><termGrp><term id="146580">Portable Network Graphics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1953752">ПНГ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8196_146581_1953752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic file format that is supported by some World Wide Web browsers. PNG supports variable transparency of images (alpha channels) and control of image brightness on different computers (gamma correction). PNG files are compressed bitmaps.</descrip></descripGrp><ntig><termGrp><term id="146581">PNG</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1953752">ПНГ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="82_6483_2998546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The magnitude of a number, irrespective of its sign (+ or -). An absolute value is always greater than or equal to zero. For example, 10 is the absolute value of 10 and of -10. Programming languages and spreadsheet programs commonly include functions that return the absolute value of a number.</descrip></descripGrp><ntig><termGrp><term id="6483">absolute value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2998546">апсолутна вредност</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="820_210484_1868151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove the digital signature added to the document.</descrip></descripGrp><ntig><termGrp><term id="210484">un-sign</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868151">отстранување потпис</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8200_41830_441470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar that you create for your application.</descrip></descripGrp><ntig><termGrp><term id="41830">custom toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441470">прилагодлив алатник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8206_346965_1371594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Strength exerted; might.</descrip></descripGrp><ntig><termGrp><term id="346965">power</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371594">моќност</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="821_39300_441452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Management of a computer and its processing abilities so as to maintain order as tasks and activities are carried out. Control applies to measures designed to ensure error-free actions carried out at the right time and in the right order relative to other data-handling or hardware-based activities.</descrip></descripGrp><ntig><termGrp><term id="39300">control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441452">управување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8218_231957_442410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PivotTable report that supplies the source data to the PivotChart report. It is created automatically when you create a new PivotChart report. When you change the layout of either report, the other also changes.</descrip></descripGrp><ntig><termGrp><term id="231957">associated PivotTable report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442410">associated PivotTable-извештај</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="822_174503_1943057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The address of the local computer used for routing outgoing packets back to the source computer. This address is used primarily for testing.</descrip></descripGrp><ntig><termGrp><term id="174503">loopback address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943057">адреса на неуспешен обид за остварување на врска</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="824_129372_442033"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of or pertaining to a device or service that appears to the user as something it actually is not or that does not physically exist.</descrip></descripGrp><ntig><termGrp><term id="129372">virtual</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442033">виртуелен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8245_334528_443031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a check to a check box to specify a desired feature or option.</descrip></descripGrp><ntig><termGrp><term id="334528">select</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="443031">избери</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8250_211554_1371595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that is added to the base computer system to increase functionality, such as audio, networking, graphics, or SCSI controller.</descrip></descripGrp><ntig><termGrp><term id="211554">add-on device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371595">додаток</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8250_5650_1371595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that is added to the base computer system to increase functionality, such as audio, networking, graphics, or SCSI controller.</descrip></descripGrp><ntig><termGrp><term id="5650">add-on</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371595">додаток</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8251_170244_2528564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft program that invites customers to provide Microsoft with more detailed information about how the software is used including the type and frequency of errors, software and hardware performance, and feature usage. This information is anonymous and voluntary, and is used strictly for the purposes of software development.</descrip></descripGrp><ntig><termGrp><term id="170244">Customer Experience Improvement Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2528564">Програма за подобрување на корисничкото искуство</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8251_170245_2528564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft program that invites customers to provide Microsoft with more detailed information about how the software is used including the type and frequency of errors, software and hardware performance, and feature usage. This information is anonymous and voluntary, and is used strictly for the purposes of software development.</descrip></descripGrp><ntig><termGrp><term id="170245">CEIP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2528564">Програма за подобрување на корисничкото искуство</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8257_115925_2305854"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or being a device that does not require support from another device or system, for example, a computer that is not connected to a network.</descrip></descripGrp><ntig><termGrp><term id="115925">stand-alone</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305854">самостојно</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSp