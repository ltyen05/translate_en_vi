ies to.</descrip></descripGrp><ntig><termGrp><term id="2685803">workload</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2690884">работа</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4772_17201_1372343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who creates or edits a document.</descrip></descripGrp><ntig><termGrp><term id="17201">author</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372343">автор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47723_2685850_2689471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An accepted domain for which an Exchange organization receives mail and then relays it to a different email server.</descrip></descripGrp><ntig><termGrp><term id="2685850">relay domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2689471">релеен домен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47724_2685851_2689458"><langSet xml:lang="en-US"><descripGrp><descrip type="