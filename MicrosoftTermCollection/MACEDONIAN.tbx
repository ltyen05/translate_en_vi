="en-US"><descripGrp><descrip type="definition">An object that supports the OLE protocol for object linking and embedding.</descrip></descripGrp><ntig><termGrp><term id="87410">OLE object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441808">ОПВ-објект</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14893_397167_2794345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filtering list that is used by the Connection Filter agent in Exchange Server 2007. IP addresses on the IP Allow list are considered "safe" and are exempted from processing by other anti-spam agents.</descrip></descripGrp><ntig><termGrp><term id="397167">IP Allow list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2794345">Список со дозволени ИП-адреси</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14895_397169_2305581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A third-party hardware device or product that connects a legacy PBX to a LAN. An IP/VoIP gateway translates or converts TDM or telephony circuit-switched protocols to packet switched protocols that can be used on a VoIP-based network.</descrip></descripGrp><ntig><termGrp><term id="397169">IP/VoIP gateway</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305581">Капија за ИП/VoIP</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14897_231964_442413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In statistical or scientific data, a bar that shows the potential error or degree of uncertainty relative to each data marker in a series.</descrip></descripGrp><ntig><termGrp><term id="231964">error bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442413">лента за (пријава на) грешки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14901_152051_1371810"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The points where playback of a file or clip begins and ends. There are two trim points: start trim point and end trim point.</descrip></descripGrp><ntig><termGrp><term id="152051">trim points</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371810">гранични точки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14905_318357_442914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &gt; character.</descrip></descripGrp><ntig><