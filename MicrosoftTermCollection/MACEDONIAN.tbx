on</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442197">преклопно копче</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11305_2766794_2769860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An on/off control within a graphical user interface that when clicked remains "down" (appearing to be pressed) until it is clicked again.</descrip></descripGrp><ntig><termGrp><term id="2766794">toggle switch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2769860">прекинувач за преклопување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11305_2766794_442197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An on/off control within a graphical user interface that when clicked remains "down" (appearing to be pressed) until it is clicked again.</descrip></descripGrp><ntig><termGrp><term id="2766794">toggle switch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442197">преклопно копче</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11310_232414_442426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to items that occur repeatedly. For example, an appointment or task that occurs on a regular basis, such as a weekly status meeting or a monthly haircut, can be designated as recurring.</descrip></descripGrp><ntig><termGrp><term id="232414">recurring</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442426">повторлив</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11311_297189_442738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that changes settings without adequate consent.</descrip></descripGrp><ntig><termGrp><term id="297189">settings modifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442738">модификатор на параметри</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11312_149466_442202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action query that changes a set of records according to criteria you specify. An update query does not return any records.</descrip></descripGrp><ntig><termGrp><term id="149466">update query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442202">прашалник з