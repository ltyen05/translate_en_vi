6">снимање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7641_50797_1371581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To programmatically disguise content to hide its substance.</descrip></descripGrp><ntig><termGrp><term id="50797">encrypt</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371581">шифрирај</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7641_50797_441560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To programmatically disguise content to hide its substance.</descrip></descripGrp><ntig><termGrp><term id="50797">encrypt</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441560">кодирај</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7641_764958_1371581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To programmatically disguise content to hide its substance.</descrip></descripGrp><ntig><termGrp><term id="764958">encipher</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371581">шифрирај</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7641_764958_441560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To programmatically disguise content to hide its substance.</descrip></descripGrp><ntig><termGrp><term id="764958">encipher</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441560">кодирај</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7642_217268_1867982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fixed-size result that is obtained by applying a one-way mathematical function (sometimes called a hash algorithm) to an arbitrary amount of data. If there is a change in the input data, the hash changes. The hash can be used in many operations, including authentication and digital signing.</descrip></descripGrp><ntig><termGrp><term id="217268">hash code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1867982">хаш</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7642_2479571_1867982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fixed-size result that is obtained by applying a one-way mathematical function (sometimes called a hash algorithm) to an arbitrary amount of data. If there is a change in the input data, the hash changes. The hash can be used in many operations, including authentication and digital signing.</descrip></descripGrp><ntig><termGrp><term id="2479571">digest</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1867982">хаш</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7642_60536_1867982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fixed-size result that is obtained by applying a one-way mathematical function (sometimes called a hash algorithm) to an arbitrary amount of data. If there is a change in the input data, the hash changes. The hash can be used in many operations, including authentication and digital signing.</descrip></descripGrp><ntig><termGrp><term id="60536">hash</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1867982">хаш</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7642_60537_1867982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fixed-size result that is obtained by applying a one-way mathematical function (sometimes called a hash algorithm) to an arbitrary amount of data. If there is a change in the input data, the hash changes. The hash can be used in many operations, including authentication and digital signing.</descrip></descripGrp><ntig><termGrp><term id="60537">message digest</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1867982">хаш</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7647_17669_441281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software feature that allows users to filter records in a spreadsheet or database by selecting filter criteria right in the working window rather than going through complex views and features.</descrip></descripGrp><ntig><termGrp><term id="17669">AutoFilter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441281">Автоматско филтрирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7653_318733_2386808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tab in Windows Media Player that enables the user to view the digital media item that is currently playing.</descrip></descripGrp><ntig><termGrp><term id="318733">Now Playing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2386808">тековна репродукција</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7657_316308_442861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image-bearing surface such as a single page or multi-page of text or picture that is passed through a scanner and has become a computer file.</descrip></descripGrp><ntig><termGrp><term id="316308">scan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442861">скенирана копија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7667_130635_1883688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The loudness of an audio signal.</descrip></descripGrp><ntig><termGrp><term id="130635">volume</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1883688">гласност</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7667_130635_442038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The loudness of an audio signal.</descrip></descripGrp><ntig><termGrp><term id="130635">volume</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442038">јачина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7672_397222_2305705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ordered set of rules for the purpose of implementing a messaging policy. The number of rule collections is set at design time.</descrip></descripGrp><ntig><termGrp><term id="397222">rule collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305705">колекција со правила</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7677_2413122_1095876"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of technologies in the Microsoft .NET Framework for building Web applications and XML Web services. ASP.NET pages execute on the server and generate markup (such as HTML, WML, or XML) that is sent to a desktop or mobile browser. ASP.NET pages use a compiled, event-driven programming model that improves performance and enables the separation of application logic and user interface. ASP.NET pages and XML Web services files created using ASP.NET contain server-side (rather than client-side) logic written in Visual Basic .NET, C# .NET, or any .NET-compatible language. Web applications and XML Web services take advantage of the features of the common language runtime, such as type safety, inheritance, language interoperability, versioning, and integrated security.</descrip></descripGrp><ntig><termGrp><term id="2413122">Microsoft ASP.NET</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1095876">ASP.NET</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7677_3927_1095876"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of technologies in the Microsoft .NET Framework for building Web applications and XML Web services. ASP.NET pages execute on the server and generate markup (such as HTML, WML, or XML) that is sent to a desktop or mobile browser. ASP.NET pages use a compiled, event-driven programming model that improves performance and enables the separation of application logic and user interface. ASP.NET pages and XML Web services files created using ASP.NET contain server-side (rather than client-side) logic written in Visual Basic .NET, C# .NET, or any .NET-compatible language. Web applications and XML Web services take advantage of the features of the common language runtime, such as type safety, inheritance, language interoperability, versioning, and integrated security.</descrip></descripGrp><ntig><termGrp><term id="3927">ASP.NET</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1095876">ASP.NET</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7682_34631_441411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer printer that can print full-color output. Most color printers can also produce black-and-white output.</descrip></descripGrp><ntig><termGrp><term id="34631">color printer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441411">печатач во боја</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7690_128035_1372383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To confirm either that a result is correct or that a procedure or sequence of operations has been performed.</descrip></descripGrp><ntig><termGrp><term id="128035">verify</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372383">провери</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7691_156523_2775305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An organization's requirements for complying with privacy regulations and directives.</descrip></descripGrp><ntig><termGrp><term id="156523">privacy policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2775305">правила за приватност</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7697_145302_1868087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any expression that evaluates to a number. The expression can be any combination of variables, constants, functions, and operators.</descrip></descripGrp><ntig><termGrp><term id="145302">numeric expression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868087">нумерички израз</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="770_76394_441728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To gain access to a specific computer, program, or network by identifying oneself with a username and a password.</descrip></descripGrp><ntig><termGrp><term id="76394">log on</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441728">пријавување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="770_76395_441728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To gain access to a specific computer, program, or network by identifying oneself with a username and a password.</descrip></descripGrp><ntig><termGrp><term id="76395">log in</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441728">пријавување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7702_1510294_441874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions that a computer or device uses to perform a specific task, such as word processing, accounting, or data management.</descrip></descripGrp><ntig><termGrp><term id="1510294">app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441874">програма</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7702_1510294_441875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions that a computer or device uses to perform a specific task, such as word processing, accounting, or data management.</descrip></descripGrp><ntig><termGrp><term id="1510294">app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441875">апликација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7702_95380_441874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions that a computer or device uses to perform a specific task, such as word processing, accounting, or data management.</descrip></descripGrp><ntig><termGrp><term id="95380">program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441874">програма</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7702_95380_441875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions that a computer or device uses to perform a specific task, such as word processing, accounting, or data management.</descrip></descripGrp><ntig><termGrp><term id="95380">program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441875">апликација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7702_95381_441874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions that a computer or device uses to perform a specific task, such as word processing, accounting, or data management.</descrip></descripGrp><ntig><termGrp><term id="95381">application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441874">програма</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7702_95381_441875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions that a computer or device uses to perform a specific task, such as word processing, accounting, or data management.</descrip></descripGrp><ntig><termGrp><term id="95381">application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441875">апликација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7703_145418_1868088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The file on your hard disk that contains offline folders. The offline folder file has an .ost extension. You can create it automatically when you set up Outlook, or when you first make a folder available offline.</descrip></descripGrp><ntig><termGrp><term id="145418">offline folder file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868088">локална датотека во папка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7712_130661_442039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of storage on a hard disk. A volume is formatted by using a file system, such as NTFS, and has a drive letter assigned to it. A single hard disk can have multiple volumes. Some volumes can span multiple hard disks.</descrip></descripGrp><ntig><termGrp><term id="130661">volume</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442039">волумен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7719_175788_1372384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle (often, a tall, thin rectangle) that appears on a rebar or command band. By touching and dragging a gripper bar with a stylus or mouse, a user can reposition or resize a rebar or command band.</descrip></descripGrp><ntig><termGrp><term id="175788">gripper bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372384">граничник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7719_770797_1372384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle (often, a tall, thin rectangle) that appears on a rebar or command band. By touching and dragging a gripper bar with a stylus or mouse, a user can reposition or resize a rebar or command band.</descrip></descripGrp><ntig><termGrp><term id="770797">gripper</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372384">граничник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7720_54389_2418196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computer graphics, the colored or patterned "paint" inside an enclosed figure, such as a circle. The portion of the shape that can be colored or patterned is the fill area. Drawing programs commonly offer tools for creating filled or nonfilled shapes; the user can specify color or pattern.</descrip></descripGrp><ntig><termGrp><term id="54389">fill</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2418196">пополнување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7726_373353_1522862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of following a link from one Web site to a site or page on another server when crawling for content.</descrip></descripGrp><ntig><termGrp><term id="373353">site hop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1522862">скок на локација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7735_1136138_442875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of UI controls that appear in context when an object is selected and contain actions that act upon the object.</descrip></descripGrp><ntig><termGrp><term id="1136138">mini-toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442875">Мини алатник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7735_317879_442875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of UI controls that appear in context when an object is selected and contain actions that act upon the object.</descrip></descripGrp><ntig><termGrp><term id="317879">Mini toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442875">Мини алатник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7738_50933_2181403"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tag that closes an element: &lt;/&gt;. An end tag follows the syntax &lt;/Name&gt;, where Name matches the element name declared in the start tag.</descrip></descripGrp><ntig><termGrp><term id="50933">end tag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2181403">крајна ознака</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7749_294442_441889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of related fields (columns) of information treated as a unit and arranged in a horizontal line in a table or spreadsheet.</descrip></descripGrp><ntig><termGrp><