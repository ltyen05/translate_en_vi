/descrip></descripGrp><ntig><termGrp><term id="3078309">follow</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3080007">следење</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54010_3078310_3080036"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app in Teams Consumer mobile app (TFL) that helps parents and guardians engage with their children’s educators and school.</descrip></descripGrp><ntig><termGrp><term id="3078310">School Connection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3080036">Врска со училиштето</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54012_3078312_3080028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams feature that enables users to be present in Teams meetings without turning on a camera by customizing a digital twin of themselves that interacts on their behalf using animated and expressive reactions.</descrip></descripGrp><ntig><termGrp><term id="3078312">Mesh avatars</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3080028">аватари за Mesh</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote