ext blocks, etc. are placed and arranged to create a video.</descrip></descripGrp><ntig><termGrp><term id="3060420">track</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3071925">лента</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53735_3060421_3064351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of branded assets such as logos, fonts, colors and images that are uploaded to be used in graphic designing or video editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060421">brand kit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3064351">комплет со брендирани средства</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53736_3060422_3071906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video clip from a library of professional stock assets that is integrated in the Clipchamp video editor for use in editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060422">stock video</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3071906">видео од библиотеката</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53737_3060423_3071904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio clip from a library of professional stock assets that is integrated in the Clipchamp video editor for use in editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060423">stock audio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3071904">аудио од библиотеката</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53738_3060424_3071905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image/photo from a library of professional stock assets that is integrated in the Clipchamp video editor for use in editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060424">stock image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3071905">слика од библиотеката</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53739_3060425_3067238"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of visual elements such as animated clips, GIFs, images, colored backgrounds or overlays that are used in video editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060425">graphics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3067238">графика</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53740_3060426_3071898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An animated or still image such as a cartoon figure that can be inserted in video editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060426">sticker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3071898">налепница</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53741_3060427_3069949"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of an aspect ratio preset in Clipchamp that lets users create videos that have the correct height and width to be uploaded as videos on popular social media platforms.</descrip></descripGrp><ntig><termGrp><term id="3060427">Social</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3069949">Социјални мрежи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53742_3060428_3064398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video editing transition effect used to move from one video clip to another.</descrip></descripGrp><ntig><termGrp><term id="3060428">fade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3064398">исчезнување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53743_3060429_3067201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Clipchamp, to break assets on the timeline of a video editing project into multiple smaller segments.</descrip></descripGrp><ntig><termGrp><term id="3060429">cut</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3067201">отсечи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53744_3060430_3067211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transition effect placed at the beginning of a video clip that gradually increases the visibility of the image or the sound of an audio track.</descrip></descripGrp><ntig><termGrp><term id="3060430">fade in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3067211">постепено појавување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatica