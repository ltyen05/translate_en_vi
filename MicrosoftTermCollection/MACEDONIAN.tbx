<termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943286">Канта за отпадоци од прва фаза</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29150_1506734_1943287"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of files that contain all index keys that are extracted from a set of items.</descrip></descripGrp><ntig><termGrp><term id="1506734">full-text index component</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943287">компонента за индексирање на цел текст</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29151_1506735_1943288"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of propagating of one full-text index component.</descrip></descripGrp><ntig><termGrp><term id="1506735">full-text index propagation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943288">дистрибуција на индексирање на цел текст</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29152_1506736_1943289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list whose base type is Generic List.</descrip></descripGrp><ntig><termGrp><term id="1506736">generic list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943289">генерички список</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29153_1506737_1943290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The condition of a document whose content is stored in a location other than the content database. If a document is ghosted, the front-end Web server determines the location of the content by using the SetupPath value for the document.</descrip></descripGrp><ntig><termGrp><term id="1506737">ghosted</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943290">контурно</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29154_1506738_1943291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that represents a chart and the datasheet that contains the data for the chart.</descrip></descripGrp><ntig><termGrp><term id="1506738">graph object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943291">објект на графикон</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29155_1506739_1943292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that uniquely identifies a document that is subject to the policies defined for a Group Approval workflow. The string is generated and assigned automatically to a document by a protocol server.</descrip></descripGrp><ntig><termGrp><term id="1506739">Group Approval document identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943292">Идентификатор за документ на Групно одобрување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29156_1506740_1523103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cell that no longer appears in a worksheet view because it is contained within a hidden row or a hidden column.</descrip></descripGrp><ntig><termGrp><term id="1506740">hidden cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523103">скриена ќелија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29157_1506741_1943293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column that does not appear in a worksheet view because its width is set to zero (0). A column can be hidden if an outline is collapsed.</descrip></descripGrp><ntig><termGrp><term id="1506741">hidden column</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943293">скриена колона</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29158_1506742_1943294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A row that does not appear in a worksheet view because its height is set to zero (0). A row can be hidden if a user is filtering or if an outline is collapsed.</descrip></descripGrp><ntig><termGrp><term id="1506742">hidden row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943294">скриен ред</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29159_1506743_1943295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed property from the metadata index that the administrator identifies as a good indicator of a highly relevant item. It is used to produce a high confidence result.</descrip></descripGrp><ntig><termGrp><term id="1506743">high confidence property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943295">својство со висока доверба</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="g