90_3021654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram that shows how industrial process equipment is interconnected by a system of pipelines, including instruments and valves that monitor and control the flow of materials through the pipelines.</descrip></descripGrp><ntig><termGrp><term id="1162890">P&amp;ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3021654">P&amp;ID</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24863_1162890_3022959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram that shows how industrial process equipment is interconnected by a system of pipelines, including instruments and valves that monitor and control the flow of materials through the pipelines.</descrip></descripGrp><ntig><termGrp><term id="1162890">P&amp;ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3022959">дијаграм на цевководи и инструменти</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24863_1166063_3021654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram that shows how industrial process equipment is interconnected by a system of pipelines, including instruments and valves that monitor and control the flow of materials through the pipelines.</descrip></descripGrp><ntig><termGrp><term id="1166063">piping and instrumentation diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3021654">P&amp;ID</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24863_1166063_3022959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram that shows how industrial process equipment is interconnected by a system of pipelines, including instruments and valves that monitor and control the flow of materials through the pipelines.</descrip></descripGrp><ntig><termGrp><term id="1166063">piping and instrumentation diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3022959">дијаграм на цевководи и инструменти</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24868_1162904_1868451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portion of data distribution that is determined to be more or less than some critical value. For example, the far left and far right areas of a bell curve.</descrip></descripGrp><ntig><termGrp><term id="1162904">tail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868451">крак</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24869_1162906_1868452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test in which the null hypothesis is rejected if the value of the test statistic falls into either tail of the probability distribution (i.e. is either less than a first critical value or greater than a second critical value).</descrip></descripGrp><ntig><termGrp><term id="1162906">two-tailed test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868452">двокрак тест</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24869_1162906_1868466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test in which the null hypothesis is rejected if the value of the test statistic falls into either tail of the probability distribution (i.e. is either less than a first critical value or greater than a second critical value).</descrip></descripGrp><ntig><termGrp><term id="1162906">two-tailed test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868466">двостран тест</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24869_1176836_1868452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test in which the null hypothesis is rejected if the value of the test statistic falls into either tail of the probability distribution (i.e. is either less than a first critical value or greater than a second critical value).</descrip></descripGrp><ntig><termGrp><term id="1176836">two-sided test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868452">двокрак тест</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24869_1176836_1868466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test in which the null hypothesis is rejected if the value of the test statistic falls into either tail of the probability distribution (i.e. is either less than a first critical value or greater than a second critical value).</descrip></descripGrp><ntig><termGrp><term id="1176836">two-sided test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868466">двостран тест</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24889_1164971_2305568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product for managing the entire lifecycle of user identities and their associated credentials. It provides identity synchronization, certificate and password management, and user provisioning in a single solution that works across Microsoft Windows and other organizational systems.</descrip></descripGrp><ntig><termGrp><term id="1164971">Microsoft Identity Lifecycle Manager 2007</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305568">ILM</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24889_1164971_2305846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product for managing the entire lifecycle of user identities and their associated credentials. It provides identity synchronization, certificate and password management, and user provisioning in a single solution that works across Microsoft Windows and other organizational systems.</descrip></descripGrp><ntig><termGrp><term id="1164971">Microsoft Identity Lifecycle Manager 2007</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305846">Управник со животниот циклус на идентитетите на Microsoft 2007</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24889_1275553_2305568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product for managing the entire lifecycle of user identities and their associated credentials. It provides identity synchronization, certificate and password management, and user provisioning in a single solution that works across Microsoft Windows and other organizational systems.</descrip></descripGrp><ntig><termGrp><term id="1275553">ILM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Si