termGrp><term id="1177084">attorney-client privilege</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305434">привилегија на адвокат-клиент</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25576_1177085_2305413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that corresponds to the "Then" part of a rule (If-Then) and is used to specify what is to be done when a condition evaluates as true.</descrip></descripGrp><ntig><termGrp><term id="1177085">action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305413">дејство</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25577_1177086_2305445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specific word or phrase that is specified on the basis of an organization's messaging policy and used in keyword filtering (content filtering) to identify and prevent unwanted email messages from being delivered to users in the organization.</descrip></descripGrp><ntig><termGrp><term id="1177086">bad word</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305445">лош збор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote ty