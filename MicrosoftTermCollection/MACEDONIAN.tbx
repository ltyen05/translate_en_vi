><ntig><termGrp><term id="3079527">sort_by</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3080043">sort_by</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54031_3080853_3082092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Editor that utilizes intelligence to populate with the click of a button a short and fluent summary of a longer text document which helps readers to consume relevant information faster.</descrip></descripGrp><ntig><termGrp><term id="3080853">summarization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3082092">резимирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54032_3080854_3082098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Editor that helps users make thoughtful decisions about the way a message is delivered in emails, chats, and documents.</descrip></descripGrp><ntig><termGrp><term id="3080854">tone suggestion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3082098">предлог за степен на формалност</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGende