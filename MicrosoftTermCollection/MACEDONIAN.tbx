><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47071_2652277_2654422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graph that contains the people who are most likely to email a user based on historic mail flow patterns.</descrip></descripGrp><ntig><termGrp><term id="2652277">contact graph</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2654422">графикон со контакти</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47073_2652282_2654428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount of time (two hours or longer) free of appointments or meetings intended to be used by employees to focus on tasks outside of meetings, emails, chats, and calls.</descrip></descripGrp><ntig><termGrp><term id="2652282">focus time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2654428">фокусирано време</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47075_2652308_2654473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An environment where software is put into operation for their intended uses by end users.</descrip></descripGrp><ntig><termGrp><term id="2652308">production environment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2654473">средина на работа</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47077_2652497_2654434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that is displayed when a cell that requires validation is selected and that gives instructions to the people using the spreadsheet on valid input.</descrip></descripGrp><ntig><termGrp><term id="2652497">input message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2654434">влезна порака</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47078_2652498_2654458"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software system that determines the likelihood of incoming emails being a phishing attempt due to analysis of previous emailing history.</descrip></descripGrp><ntig><termGrp><term id="2652498">mailbox intelligence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2654458">анализа на поштенското сандаче</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47092_2652805_2687709"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that tells users when their contacts were last logged in to the application.</descrip></descripGrp><ntig><termGrp><term id="2652805">Last seen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2687709">Последен пат виден</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="471_536631_1943097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In ASP.NET, a variable store created on the server for the current user; each user maintains a separate Session state on the server. Session state is typically used to store user-specific information between postbacks.</descrip></descripGrp><ntig><termGrp><term id="536631">session state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943097">состојба за сесија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47110_2653636_2689462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Located on a customer's own facilities.</descrip></descripGrp><ntig><termGrp><term id="2653636">on-premises</term><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2689462">локално</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4713_29105_1371482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that reads the information stored on a compact disc. A compact disc player contains the optical equipment necessary for reading a disc's contents and the electronic circuitry for interpreting the data as it is read.</descrip></descripGrp><ntig><termGrp><term id="29105">CD player</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371482">ЦД-уред</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4713_29105_441371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that reads the information stored on a compact disc. A compact disc player contains the optical equipment necessary for reading a disc's contents and the electronic circuitry for interpreting the data as it is read.</descrip></descripGrp><ntig><termGrp><term id="29105">CD player</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441371">компакт-диск плеер</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4713_29106_1371482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that reads the information stored on a compact disc. A compact disc player contains the optical equipment necessary for reading a disc's contents and the electronic circuitry for interpreting the data as it is read.</descrip></descripGrp><ntig><termGrp><term id="29106">compact disc player</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371482">ЦД-уред</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4713_29106_441371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that reads the information stored on a compact disc. A compact disc player contains the optical equipment necessary for reading a disc's contents and the electronic circuitry for interpreting the data as it is read.</descrip></descripGrp><ntig><termGrp><term id="29106">compact disc player</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441371">компакт-диск плеер</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4715_98780_2305685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email feature providing feedback to the sender that a message has been read by the recipient.</descrip></descripGrp><ntig><termGrp><term id="98780">read notification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305685"