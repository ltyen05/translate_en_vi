 со кодови (CAS)</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24059_1508832_1943141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules that defines security permissions for a collection of assemblies by associating attributes of those assemblies, such as location and signature, with a set of code access security permissions.</descrip></descripGrp><ntig><termGrp><term id="1508832">code access security policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943141">CAS-правила</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2407_73729_441706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, the order and sequence of input and output.</descrip></descripGrp><ntig><termGrp><term id="73729">layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441706">распоред</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24072_1098446_1943142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that monitors and collects statistics about a system. Those statistics can be compared to a set of thresholds to assess system performance, identify and resolve problems, and perform other diagnostic and administrative tasks.</descrip></descripGrp><ntig><termGrp><term id="1098446">diagnostic provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943142">давател на дијагностика</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24076_1098449_2689479"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time during which a program is running. In most interactive programs, a session is the time during which the program accepts input and processes information.</descrip></descripGrp><ntig><termGrp><term id="1098449">session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2689479">сесија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24102_1098534_1523047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feed that provides users with information, notifications and updates based on people, documents, and tags they are following.</descrip></descripGrp><ntig><termGrp><term id="1098534">activity feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523047">активности за навестување на содржина</term><termNote type="geographicalUsage">MKD</termN