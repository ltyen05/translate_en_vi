p><descrip type="definition">A document that is generated by an application.</descrip></descripGrp><ntig><termGrp><term id="1373977">report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2775308">извештај</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2747_37894_2596404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graph where for any two nodes in the graph, there is a path between them by following edges.</descrip></descripGrp><ntig><termGrp><term id="37894">connected graph</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2596404">поврзан графикон</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27472_1375432_1519925"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The checkbox customers select to include their spaces blog in the updates that they share about themselves. This text links to Spaces.</descrip></descripGrp><ntig><termGrp><term id="1375432">Blog</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1519925">Блог</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumbe