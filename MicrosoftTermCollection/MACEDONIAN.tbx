>An area in a window on a small-screen device that contains a group of commands and controls displayed in functionally related groups.</descrip></descripGrp><ntig><termGrp><term id="2276485">palette</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2284855">палета</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39204_2276495_2284856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button in the hint bar that opens a palette.</descrip></descripGrp><ntig><termGrp><term id="2276495">Palette Launcher</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2284856">Копче за палетата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39205_2276501_2284838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that shows the set of potential colors and which elements they will be applied to.</descrip></descripGrp><ntig><termGrp><term id="2276501">Color palette</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2284838">Палета со бои</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="gr