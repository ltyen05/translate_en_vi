p><descrip type="definition">A content processing feature that extracts information from unstructured text in an item and stores that information as additional managed properties for the item. The additional managed properties can be used to refine results.</descrip></descripGrp><ntig><termGrp><term id="1359720">property extractor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868714">издвојувач на ентитет</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26965_1653098_1868714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A content processing feature that extracts information from unstructured text in an item and stores that information as additional managed properties for the item. The additional managed properties can be used to refine results.</descrip></descripGrp><ntig><termGrp><term id="1653098">entity extractor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868714">издвојувач на ентитет</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26977_1361740_1519929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label in Messenger for the results list of a contacts search.</descrip></descripGrp><ntig><termGrp><term id="1361740">Contacts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</ter