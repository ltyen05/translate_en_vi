45_441222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that copies or changes data.</descrip></descripGrp><ntig><termGrp><term id="7745">action query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441222">прашалник за дејствие</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38541_2239657_2242454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The quota of words the user can dictate to the phone in a period of 24 hours.</descrip></descripGrp><ntig><termGrp><term id="2239657">dictation time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2242454">време за диктирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38560_2242119_2263403"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A polished, interactive, web-based canvas created using Sway.</descrip></descripGrp><ntig><termGrp><term id="2242119">sway</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2263403">Нишање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termE