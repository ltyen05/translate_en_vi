 корисничките податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54302_3096554_3096978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An issue that has potential to result in a customer data breach, including violations of security policies, acceptable use policies, or standard security practices.</descrip></descripGrp><ntig><termGrp><term id="3096554">security incident</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3096978">безбедносен инцидент</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54303_3096555_3096974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mitigation of violations of security policies and recommended practices.</descrip></descripGrp><ntig><termGrp><term id="3096555">incident handling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3096974">решавање инциденти</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54304_3096556_3096976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security incident that involves the accidental or unauthorized exposure or alteration of customer content and end-user identifiable information (EUII) in Microsoft 365 services.</descrip></descripGrp><ntig><termGrp><term id="3096556">privacy issue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3096976">проблем со приватноста</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54312_3097234_3098101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An observable change to the normal behavior of a system, environment, process, workflow or person; any observable occurrence in a system or network.</descrip></descripGrp><ntig><termGrp><term id="3097234">security event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3098101">безбедносен настан</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54313_3097235_3098099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An automated notification resulting from a detection.</descrip></descripGrp><ntig><termGrp><term id="3097235">security alert</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3098099">безбедносно предупредување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54314_3097236_3098100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Engagement of the Microsoft incident response team via formal engagement procedures indicating a potential security issue that requires investigation.</descrip></descripGrp><ntig><termGrp><term id="3097236">security escalation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3098100">ескалација на безбедносен проблем</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54315_3097237_3098033"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical analytical process for identifying security-impacting, anomalous, or suspicious activity.</descrip></descripGrp><ntig><termGrp><term id="3097237">detection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3098033">откривање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54316_3097238_3098098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operational issue (i.e. configuration setting, deployment task, etc.) that adversely impacts the security posture of a service.</descrip></descripGrp><ntig><termGrp><term id="3097238">hygiene issue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</ter