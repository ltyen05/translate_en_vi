un</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3067214">постепено исчезнување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53746_3060434_3067229"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Clipchamp, to accommodate an oversized image or video into the height of the frame of an editing project, preserving the full image.</descrip></descripGrp><ntig><termGrp><term id="3060434">fit</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3067229">приспособи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53747_3060435_3064399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Clipchamp, to cover a frame with an image or video so that there are no visible empty spaces horizontal or vertically.</descrip></descripGrp><ntig><termGrp><term id="3060435">fill</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3064399">исполни</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53748_3060436_3069951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Clipchamp, to divide an asset on the video editing timeline into multiple parts.</descrip></descripGrp><ntig><termGrp><term id="3060436">split</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3069951">подели</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53749_3060437_3067288"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Clipchamp feature that places a smaller video/image on top of a larger video/image in a video editing project.</descrip></descripGrp><ntig><termGrp><term id="3060437">picture in picture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3067288">слика во слика</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53749_3060438_3067288"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Clipchamp feature that places a smaller video/image on top of a larger video/image in a video editing project.</descrip></descripGrp><ntig><termGrp><term id="3060438">picture-in-picture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3067288">слика во слика</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termN