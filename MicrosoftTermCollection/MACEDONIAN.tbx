485334">Компонента за слики на Windows</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21635_779036_1693012"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that provides a direct connection to a corporate network for people working outside of the office. It is a superior alternative to VPN.</descrip></descripGrp><ntig><termGrp><term id="779036">DirectAccess</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1693012">DirectAccess</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21637_779040_1989377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A PC (desktop and beyond) search platform that allows search of the local hard drive plus network locations like SharePoint sites and the Internet.</descrip></descripGrp><ntig><termGrp><term id="779040">Windows Search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1989377">Windows Search</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21638_1276167_1372628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of attributes that define a user's access to a given service or application.</descrip></descripGrp><ntig><termGrp><term id="1276167">identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372628">сметка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21638_779054_1372628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of attributes that define a user's access to a given service or application.</descrip></descripGrp><ntig><termGrp><term id="779054">account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372628">сметка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21640_779056_1832198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To break a connection.</descrip></descripGrp><ntig><termGrp><term id="779056">disconnect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832198">исклучи врска</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21645_779064_1095959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to something, such as a signal or connection, that is not unbroken but occurs at periodic or occasional intervals.</descrip></descripGrp><ntig><termGrp><term id="779064">intermittent</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1095959">повремен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21658_779139_1832337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To call the last person called from a phone or device.</descrip></descripGrp><ntig><termGrp><term id="779139">redial</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832337">бирај повторно</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21660_779144_1832396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To send text messages from a mobile phone or device.</descrip></descripGrp><ntig><termGrp><term id="779144">text</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832396">испраќање порака</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21755_779690_1868352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression, a timeline, or sequential steps in a task, process, or workflow. Works well for illustrating both Level 1 and Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779690">Accent Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868352">Нагласен процес</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21756_779691_1868353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of information or sequential steps in a task, process, or workflow. Emphasizes the interaction or relationships among the groups of information.</descrip></descripGrp><ntig><termGrp><term id="779691">Alternating Flow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868353">Променлив проток</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21757_779692_1868354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show either related or contrasting concepts with some connection, such as opposing forces. The first two lines of Level 1 text are used for text in the arrows. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779692">Arrow Ribbon</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868354">Лента со стрелка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21758_779693_1372629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to compare or show the relationship between two ideas. Each of the first two lines of Level 1 text corresponds to text at the top of one side of the center point. Emphasizes Level 2 text, which is limited to four shapes on each side of the center point. The balance tips towards the side with the most shapes containing Level 2 text. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779693">Balance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372629">Баланс</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21759_779694_1868355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Maximizes both horizontal and vertical display space for shapes.</descrip></descripGrp><ntig><termGrp><term id="779694">Basic Bending Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868355">Основен процес на виткање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21760_779695_1868356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. Maximizes both horizontal and vertical display space for shapes.</descrip></descripGrp><ntig><termGrp><term id="779695">Basic Block List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868356">Основен список за блокирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21761_779696_1868357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression; a timeline; sequential steps in a task, process, or workflow; or to emphasize movement or direction. Level 1 text appears inside an arrow shape while Level 2 text appears below the arrow shapes.</descrip></descripGrp><ntig><termGrp><term id="779696">Basic Chevron Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868357">Процес на основен шеврон</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21762_779697_1868358"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Emphasizes the stages or steps rather than the connecting arrows or flow. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779697">Basic Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868358">Основен циклус</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21763_779698_1868359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationship of components to a whole in quadrants. The first four lines of Level 1 text appear in the quadrants. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779698">Basic Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868359">Основна матрица</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21764_779699_1868360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show how individual parts form a whole. The first seven lines of Level 1 text correspond to the evenly distributed wedge or pie shapes. The top Level 1 text shape appears outside of the rest of the pie for emphasis. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779699">Basic Pie</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868360">Основна пита</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21765_779700_1868361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow.</descrip></descripGrp><ntig><termGrp><term id="779700">Basic Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868361">Основен процес</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21766_779701_1868362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show proportional, interconnected, or hierarchical relationships with the largest component on the bottom and narrowing up. Level 1 text appears in the pyramid segments and Level 2 text appears in shapes alongside each segment.</descrip></descripGrp><ntig><termGrp><term id="779701">Basic Pyramid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868362">Основна пирамида</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21767_779702_1868363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationship to a central idea in a cycle. The first line of Level 1 text corresponds to the central shape, and its Level 2 text corresponds to the surrounding circular shapes. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779702">Basic Radial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868363">Основен радијал</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21768_779703_1868364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show containment, gradations, or hierarchical relationships. The first five lines of Level 1 text are associated with a circle. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779703">Basic Target</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868364">Основна цел</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21769_779704_1868365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show sequential steps in a task, process, or workflow, or to show timeline information. Works well with both Level 1 and Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779704">Basic Timeline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868365">Основна временска линија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21770_779705_1868366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show overlapping or interconnected relationships. The first seven lines of Level 1 text correspond with a circle. If there are four or fewer lines of Level 1 text, the text is inside the circles. If there are more than four lines of Level 1 text, the text is outside of the circles. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779705">Basic Venn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868366">Основен венов</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21771_779706_1868367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. The small circular shapes are designed to contain pictures. Works well for illustrating both Level 1 and Level 2 text. Maximizes both horizontal and vertical display space for shapes.</descrip></descripGrp><ntig><termGrp><term id="779706">Bending Picture Accent List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868367">Виткање список нагласен со слики</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21772_779707_1868368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Emphasizes the stages or steps rather than the connecting arrows or flow.</descrip></descripGrp><ntig><termGrp><term id="779707">Block Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868368">Циклус на блок</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21773_779708_1868369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression through several processes that make up an overall workflow. Also works for illustrating contrasting processes. The Level 1 text corresponds to the first arrow shape on the left, while the Level 2 text corresponds to horizontal sub-steps for each shape that contains Level 1 text.</descrip></descripGrp><ntig><termGrp><term id="779708">Chevron List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868369">Список со шеврони</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21774_779709_1868370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a long or non-linear sequence or steps in a task, process, or workflow. Works best with Level 1 text only. Maximizes both horizontal and vertical display space for shapes.</descrip></descripGrp><ntig><termGrp><term id="779709">Circular Bending Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868370">Кружен процес на виткање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21775_779710_1868371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression, a timeline, or sequential steps in a task, process, or workflow, or to emphasize movement or direction. Can be used to emphasize information in the starting shape. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779710">Closed Chevron Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868371">Процес на затворен шеврон</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21776_779711_1868372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a timeline or sequential steps in a task, process, or workflow. Works best with Level 1 text because each line of Level 1 text appears inside the arrow shape. Level 2 text appears outside the arrow shape.</descrip></descripGrp><ntig><termGrp><term id="779711">Continuous Arrow Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868372">Процес со континуирана стрелка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21777_779712_1868373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Works best with minimal Level 1 and Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779712">Continuous Block Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868373">Процес со континуиран блок</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21778_779713_1868374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Emphasizes the connection between all components. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779713">Continuous Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868374">Континуиран циклус</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21779_779714_1868375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of interconnected information. The circular shapes are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779714">Continuous Picture List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868375">Континуиран список со слики</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21780_779715_1868376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show ideas or concepts that converge to a central point. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779715">Converging Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868376">Конвергентни стрели</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21781_779716_1868377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show relationships of concepts or components to a central idea in a cycle. The first line of Level 1 text corresponds to the central circular shape and the lines of Level 2 text correspond to the surrounding rectangular shapes. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779716">Converging Radial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868377">Конвергентен радијал</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21782_779717_1868378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show two opposing ideas or concepts. Each of the first two lines of Level 1 text corresponds to an arrow and works well with Level 2 text. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779717">Counterbalance Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868378">Стрелки за противтежа</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21783_779718_1868379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationship to a central idea in a cyclical progression. Each of the first four lines of Level 1 text corresponds to a wedge or pie shape, and Level 2 text appears in a rectangular shape to the side of the wedge or pie shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779718">Cycle Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868379">Матрица на циклус</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21784_779719_1868380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used with large amounts of Level 2 text to show a progression through stages.</descrip></descripGrp><ntig><termGrp><term id="779719">Detailed Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868380">Детален процес</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21785_779720_1868381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show ideas or concepts that progress outward from a central source. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779720">Diverging Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868381">Дивергентни стрелки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21786_779721_1868382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show relationships to a central idea in a cycle. The first Level 1 line of text corresponds to the central circular shape. Emphasizes the surrounding circles rather than the central idea. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779721">Diverging Radial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868382">Дивергентен радијал</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21787_779722_1372630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show sequential steps or tasks that depict a plan or result. The last Level 1 line of text appears after the equals sign (=).Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779722">Equation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372630">Равенка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21788_779723_1868383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the filtering of information or how parts merge into a whole. Emphasizes the final outcome. Can contain up to four lines of Level 1 text; the last of these four Level 1 text lines appears below the funnel and the other lines correspond to a circular shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779723">Funnel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868383">Инка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21789_779724_1868384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show interlocking ideas. Each of the first three lines of Level 1 text corresponds to a gear shape, and their corresponding Level 2 text appears in rectangles next to the gear shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779724">Gear</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868384">Запченик</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21790_779725_1868385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the placement of concepts along two axes. Emphasizes the individual components rather than the whole. The first four lines of Level 1 text appear in the quadrants. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779725">Grid Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868385">Матрица на мрежа</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21791_779726_1868386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups and sub-groups of information, or steps and sub-steps in a task, process, or workflow. Level 1 text corresponds to the top-level horizontal shapes, and Level 2 text corresponds to vertical sub-steps under each related top-level shape. Works well for emphasizing sub-groups or sub-steps, hierarchical information, or multiple lists of information.</descrip></descripGrp><ntig><termGrp><term id="779726">Grouped List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868386">Групиран список</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21792_779727_1868801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing from top to bottom.</descrip></descripGrp><ntig><termGrp><term id="779727">Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868801">Хиерархија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21793_779728_1868387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing across groups. Can also be used to group or list information.</descrip></descripGrp><ntig><termGrp><term id="779728">Hierarchy List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868387">Хиерархиски список</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21794_779729_1868388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped lists of information. Works well with large amounts of text. All text has the same level of emphasis, and direction is not implied.</descrip></descripGrp><ntig><termGrp><term id="779729">Horizontal Bullet List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868388">Список со хоризонтални знаци за подредување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21795_779730_1868389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing horizontally. Works well for decision trees.</descrip></descripGrp><ntig><termGrp><term id="779730">Horizontal Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868389">Хоризонтална хиерархија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21796_779731_1868390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped information with an emphasis on related pictures. The top shapes are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779731">Horizontal Picture List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868390">Хоризонтален список со слики</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21797_779732_1868391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing horizontally and grouped hierarchically. Emphasizes heading or level 1 text. The first line of Level 1 text appears in the shape at the beginning of the hierarchy, and the second and all subsequent lines of Level 1 text appear at the top of the tall rectangles.</descrip></descripGrp><ntig><termGrp><term id="779732">Horizontal Labeled Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868391">Хоризонтална означена хиерархија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21798_779733_1868392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show proportional, or interconnected, or hierarchical relationships with the largest component on the top and narrowing down. Level 1 text appears in the pyramid segments and Level 2 text appears in shapes alongside each segment.</descrip></descripGrp><ntig><termGrp><term id="779733">Inverted Pyramid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868392">Превртена пирамида</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21799_779734_1868393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing from top to bottom and grouped hierarchically. Emphasizes heading or level 1 text. The first line of Level 1 text appears in the shape at the beginning of the hierarchy, and all subsequent lines of Level 1 text appear to the left of the tall rectangles.</descrip></descripGrp><ntig><termGrp><term id="779734">Labeled Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868393">Означена хиерархија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21800_779735_1868394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show overlapping relationships in a sequence. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779735">Linear Venn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868394">Линиски венов</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21801_779736_1868395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events that can occur in any direction.</descrip></descripGrp><ntig><termGrp><term id="779736">Multidirectional Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868395">Повеќенасочен циклус</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21802_779737_1868396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show containment relationships. Each of the first three lines of Level 1 text correspond to the upper left text in the shapes, and Level 2 text corresponds to the smaller shapes. Works best with minimal Level 2 lines of text. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779737">Nested Target</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868396">Вгнездена цел</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21803_779738_1868397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Each shape has the same level of importance. Works well when direction does not need to be indicated.</descrip></descripGrp><ntig><termGrp><term id="779738">Nondirectional Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868397">Ненасочен циклус</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21804_779739_1868398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show two opposing ideas, or ideas that diverge from a central point. Each of the first two lines of Level 1 text corresponds to an arrow. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779739">Opposing Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868398">Спротивставени стрелки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21805_779740_1868817"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical information or reporting relationships in an organization. The assistant shape and the Org Chart hanging layouts are available with this layout.</descrip></descripGrp><ntig><termGrp><term id="779740">Organization Chart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868817">Oрганизациски графикон</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21806_779741_1868399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show grouped or related information. The small shapes on the upper corners are designed to contain pictures. Emphasizes Level 2 text over Level 1 text, and is a good choice for large amounts of Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779741">Picture Accent List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868399">Список со нагласени слики</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21807_779742_1868400"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show sequential steps in a task, process, or workflow. The rectangular shapes in the background are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779742">Picture Accent Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868400">Процес на нагласени сликички</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21808_779743_1868401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. The top shapes are designed to contain pictures and pictures are emphasized over text. Works well for pictures with short text captions.</descrip></descripGrp><ntig><termGrp><term id="779743">Picture Caption List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868401">Список со објаснувања за слики</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21809_779744_1868402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show information illustrating a process or workflow. Level 1 text appears in the circular shapes and Level 2 text appears in the arrow shapes. Works best for minimal text and to emphasize movement or direction.</descrip></descripGrp><ntig><termGrp><term id="779744">Process Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868402">Стрелки за процес</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21810_779745_1868403"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show multiple groups of information or steps and sub-steps in a task, process, or workflow. Level 1 text corresponds to the top horizontal shapes, and Level 2 text corresponds to vertical sub-steps under each related top-level shape.</descrip></descripGrp><ntig><termGrp><term id="779745">Process List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868403">Список со процеси</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21811_779746_1868404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show proportional, interconnected, or hierarchical relationships. Text appears in the rectangular shapes on top of the pyramid background</descrip></descripGrp><ntig><termGrp><term id="779746">Pyramid List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868404">Список со пирамиди</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21812_779747_1868405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationship to a central idea. Emphasizes both information in the center circle and how information in the outer ring of circles contributes to the central idea. The first Level 1 line of text corresponds to the central circle, and its Level 2 text corresponds to the outer ring of circles. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779747">Radial Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868405">Радијален циклус</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21813_779748_1868406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show relationships to a central idea in a cycle. The center shape can contain a picture. Level 1 text appears in the smaller circles and any related Level 2 text appears to the side of the smaller circles.</descrip></descripGrp><ntig><termGrp><term id="779748">Radial List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868406">Радијален список</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21814_779749_1868407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show both overlapping relationships and the relationship to a central idea in a cycle. The first line of Level 1 text corresponds to the central shape and the lines of Level 2 text correspond to the surrounding circular shapes. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779749">Radial Venn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868407">Радијален венов</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21815_779750_1868408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Maximizes both horizontal and vertical display space for shapes. Does not emphasize directionality.</descrip></descripGrp><ntig><termGrp><term id="779750">Repeating Bending Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868408">Повторлив процес на виткање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21816_779751_1868409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or a sequence of stages, tasks, or events in a circular flow. Emphasizes the interconnected pieces. Each of the first seven lines of Level 1 text corresponds to a wedge or pie shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779751">Segmented Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868409">Сегментиран циклус</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21817_779752_1868410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Emphasizes Level 2 text, since each line appears in a separate shape.</descrip></descripGrp><ntig><termGrp><term id="779752">Segmented Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868410">Сегментиран процес</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21818_779753_1868411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show containment, proportional, or interconnected relationships. The first nine lines of Level 1 text appear in the triangular shapes. Unused text does not appear, but remains available if you switch layouts. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779753">Segmented Pyramid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868411">Сегментирана пирамида</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21819_779754_1868412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of information or steps in a task, process, or workflow. Circular shapes contain Level 1 text, and the corresponding rectangles contain Level 2 text. Works well for numerous details and minimal Level 1 text.</descrip></descripGrp><ntig><termGrp><term id="779754">Stacked List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868412">Напластен список</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21820_779755_1868413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a downward progression through stages. Each of the first five lines of Level 1 text corresponds with a rectangle. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779755">Staggered Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868413">Непостојан процес</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21821_779756_1868414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of information built from top to bottom, and the hierarchies within each group. This layout does not contain connecting lines.</descrip></descripGrp><ntig><termGrp><term id="779756">Table Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868414">Хиерархија на табела</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21822_779757_1372631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show grouped or related information of equal value. The first Level 1 line of text corresponds to the top shape and its Level 2 text is used for the subsequent lists.</descrip></descripGrp><ntig><termGrp><term id="779757">Table List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372631">Табеларен список</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21823_779758_1868415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show interrelated or overlapping information. Each of the first seven lines of Level 1 text appears in the rectangular shape. Unused text does not appear, but remains available if you switch layouts. Works well with both Level 1 and Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779758">Target List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868415">Список со цели</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21824_779759_1868416"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Emphasizes the arrows or flow rather than the stages or steps. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779759">Text Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868416">Циклус на текст</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21825_779760_1868417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationships of four quadrants to a whole. The first line of Level 1 text corresponds to the central shape, and the first four lines of Level 2 text appear in the quadrants. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779760">Titled Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868417">Матрица со наслов</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21826_779761_1868418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show grouped or related information of equal value. Works well with large amounts of text.</descrip></descripGrp><ntig><termGrp><term id="779761">Trapezoid List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868418">Список со трапезоиди</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21827_779762_1868419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or steps that trend upward in a task, process, or workflow. Each of the first five lines of Level 1 text corresponds to a point on the arrow. Works best with minimal text. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779762">Upward Arrow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868419">Стрелка нагоре</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21828_779763_1868420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow that move toward a common goal. Works well for bulleted lists of information.</descrip></descripGrp><ntig><termGrp><term id="779763">Vertical Arrow List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868420">Список со вертикални стрелки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21829_779764_1868421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Maximizes both horizontal and vertical display space for shapes. Places more emphasis on the interrelationships among the shapes than on direction or movement.</descrip></descripGrp><ntig><termGrp><term id="779764">Vertical Bending Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868421">Процес на вертикално виткање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21830_779765_1868422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of information or steps in a task, process, or workflow. Works well with large amounts of Level 2 text. A good choice for text with a main point and multiple sub-points.</descrip></descripGrp><ntig><termGrp><term id="779765">Vertical Block List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868422">Список со вертикални блокови</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21831_779766_1868423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show several groups of information, especially groups with large amounts of Level 2 text. A good choice for bulleted lists of information.</descrip></descripGrp><ntig><termGrp><term id="779766">Vertical Box List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868423">Список со вертикални полиња</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21832_779767_1868424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. Works well for lists with long headings or top-level information.</descrip></descripGrp><ntig><termGrp><term id="779767">Vertical Bullet List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868424">Список со вертикални знаци за подредување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21833_779768_1868425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow, or to emphasize movement or direction. Emphasizes Level 2 text over Level 1 text, and is a good choice for large amounts of Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779768">Vertical Chevron List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868425">Список со вертикални шеврони</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21834_779769_1868426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show sequential steps or tasks that depict a plan or result. The last Level 1 line of text appears after the arrow. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779769">Vertical Equation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868426">Вертикална равенка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21835_779770_1868427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. The small circles are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779770">Vertical Picture Accent List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868427">Вертикален список нагласен со слики</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21836_779771_1868428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. The small shapes on the left are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779771">Vertical Picture List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868428">Вертикален список со слики</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21837_779772_1868429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow from top to bottom. Works best with Level 1 text, since the vertical space is limited.</descrip></descripGrp><ntig><termGrp><term id="779772">Vertical Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868429">Вертикален процес</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21838_779838_1868430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show overlapping relationships. A good choice for emphasizing growth or gradation. Works best with Level 1 text only. The first seven lines of Level 1 text correspond to a circular shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779838">Stacked Venn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868430">Напластен венов</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21839_779839_2626614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having the ability to make decisions based on predictions driven by machine learning analysis.</descrip></descripGrp><ntig><termGrp><term id="779839">intelligent</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2626614">интелигентен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21847_779972_2434911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Marked by the use of serifs. For example, Goudy is a serif typeface, whereas Helvetica is a sans serif typeface.</descrip></descripGrp><ntig><termGrp><term id="779972">serif</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2434911">сериф</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21853_779994_2305471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of customizing the look and feel of a product to support marketing or promotion of another company.</descrip></descripGrp><ntig><termGrp><term id="779994">co-branding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305471">кобрендирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21869_780135_1943116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A classification of words, labels, tags, etc. into groups based on similarities.</descrip></descripGrp><ntig><termGrp><term id="780135">taxonomy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943116">таксономија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21870_780136_1943117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of policies, roles, responsibilities, and processes that are established in an enterprise to guide, direct, and control how the organization uses technologies to accomplish business goals.</descrip></descripGrp><ntig><termGrp><term id="780136">governance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943117">владеење</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21873_780192_1868431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula giving the roots of a quadratic equation.</descrip></descripGrp><ntig><termGrp><term id="780192">quadratic formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868431">формула за квадратна равенка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21876_780202_2305857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Not able to be delivered to an intended recipient. If an email message is undeliverable, it is returned to the sender with information added by the mail server explaining the problem; for example, the email address may be incorrect, or the recipient's mailbox may be full.</descrip></descripGrp><ntig><termGrp><term id="780202">undeliverable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305857">неиспорачливо</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21880_780207_2926803"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to information that a user has received but has not yet read.</descrip></descripGrp><ntig><termGrp><term id="780207">unread</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2926803">непрочитано</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21894_780443_1832200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To turn off a system notification such as a reminder, a new message alert or an alarm.</descrip></descripGrp><ntig><termGrp><term id="780443">dismiss</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832200">отфрли</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21900_780462_1832281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A telephone call the user has failed to answer.</descrip></descripGrp><ntig><termGrp><term id="780462">missed call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832281">пропуштен повик</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21905_780472_1832322"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules defined by an administrator.</descrip></descripGrp><ntig><termGrp><term id="780472">policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832322">правила</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21906_780474_1372632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A company that provides services or content for its customers.</descrip></descripGrp><ntig><termGrp><term id="780474">provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372632">давател</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21906_780474_1883682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A company that provides services or content for its customers.</descrip></descripGrp><ntig><termGrp><term id="780474">provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1883682">провајдер</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21926_780637_1832171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is both a digital still camera and a digital video camera.</descrip></descripGrp><ntig><termGrp><term id="780637">camera</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832171">камера</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21930_780755_1832211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scheduled occurrence of an activity where multiple people are in attendance.</descrip></descripGrp><ntig><termGrp><term id="780755">event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832211">настан</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21932_780759_1832258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The on-screen representation of the phone keypad or dial pad on the device.</descrip></descripGrp><ntig><termGrp><term id="780759">keypad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832258">тастатура</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21936_780772_1832336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A password (or key) provided by Exchange Server (through OWA) that will be used during the process of resetting the PIN/password of the mobile devices.</descrip></descripGrp><ntig><termGrp><term id="780772">recovery password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832336">лозинка за обнова</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21937_780778_1832346"><langSet xml:lang="en-US"><de