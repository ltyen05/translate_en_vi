</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33613_1805604_2058609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to see Skype activity, change settings, and purchase Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1805604">Skype account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058609">сметка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33613_1805604_2058669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to see Skype activity, change settings, and purchase Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1805604">Skype account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058669">сметка на Skype</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33613_1805605_2058609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to see Skype activity, change settings, and purchase Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1805605">account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058609">сметка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33613_1805605_2058669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to see Skype activity, change settings, and purchase Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1805605">account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058669">сметка на Skype</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33614_1805607_2058615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Skype feature that enables automatic payments so that the user doesn't run out of Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1805607">auto top-up</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058615">автоматско плаќање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33614_1805608_2058615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Skype feature that enables automatic payments so that the user doesn't run out of Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1805608">auto-recharge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058615">автоматско плаќање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33615_1805609_2058616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that repeatedly redials the desired number until the user gets through.</descrip></descripGrp><ntig><termGrp><term id="1805609">auto-redial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058616">автоматско избирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33616_1805610_2058617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that indicates a user is not at his/her computer and that either automatically appears when he/she has not been active for a long period of time or when it has been manually selected.</descrip></descripGrp><ntig><termGrp><term id="1805610">Away</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058617">Не сум тука</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termN