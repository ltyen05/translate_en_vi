US"><descripGrp><descrip type="definition">The first-party Windows app for playing commercial and homemade DVD-Video discs.</descrip></descripGrp><ntig><termGrp><term id="2259500">DVD Player</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2261278">ДВД-уред</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38860_2259500_2261532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The first-party Windows app for playing commercial and homemade DVD-Video discs.</descrip></descripGrp><ntig><termGrp><term id="2259500">DVD Player</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2261532">Windows ДВД-уред</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38860_2259501_2261278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The first-party Windows app for playing commercial and homemade DVD-Video discs.</descrip></descripGrp><ntig><termGrp><term id="2259501">Windows DVD Player</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2261278">ДВД-уред</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38860_2259501_2261532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The first-party Windows app for playing commercial and homemade DVD-Video discs.</descrip></descripGrp><ntig><termGrp><term id="2259501">Windows DVD Player</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2261532">Windows ДВД-уред</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38866_2259535_2261562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The variable default lock screen image that shows beautiful images on lock combined with hotspots containing fun facts, Windows tips/trick, and more. Users can switch from this default lock screen to a personal picture.</descrip></descripGrp><ntig><termGrp><term id="2259535">Windows spotlight</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2261562">Актуелно на Windows</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38878_2259608_2261637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code used to remove Reset protection without having the Microsoft account credentials that were used to turn it on.</descrip></descripGrp><ntig><termGrp><term id="2259608">recovery key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2261637">клуч за обнова</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38879_2259611_2434906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a shortcut to an application or part of an application or contact by fixing its tile to the Start screen (the full screen view of Start) or Start menu.</descrip></descripGrp><ntig><termGrp><term id="2259611">pin to Start</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2434906">прикачи на Старт</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3888_25223_441332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication line used for data transfer among the components of a computer system.</descrip></descripGrp><ntig><termGrp><term id="25223">bus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441332">магистрала</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38880_2259632_2261180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Windows Store for Business and Education Store, to get apps and other digital goods into the hands of employees or students.</descrip></descripGrp><ntig><termGrp><term id="2259632">distribute</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2261180">дистрибуирај</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38881_2259633_2261583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode that allows using one app on your mobile screen while using a different app on a second screen that you're projecting from the mobile device.</descrip></descripGrp><ntig><termGrp><term id="2259633">dual-screen mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2261583">режим на двоен екран</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38882_2259634_2261329"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets customers extend their gaming experience across multiple devices, play with other users, and show off scores and achievements.</descrip></descripGrp><ntig><termGrp><term id="2259634">game hub</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2261329">центар за игри</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38883_2259635_2261333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default browser in Windows 10, which provides a more interoperable, reliable, and discoverable experience with advanced features including the ability to annotate on web pages, a distraction-free reading experience, and integration of Cortana. Also available on iOS and Android.</descrip></descripGrp><ntig><termGrp><term id="2259635">Microsoft Edge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2261333">Microsoft Edge</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38884_2259636_2261390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The source location of files that are stored on OneDrive and not synced to the local device. This is different from other OneDrive files (just called "OneDrive"), where a copy is synced and stored locally as well as in the cloud.</descrip></descripGrp><ntig><termGrp><term id="2259636">OneDrive (cloud only)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2261390">OneDrive (само во облакот)</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38885_2259637_2261409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user role within Windows Store for Business that allows the user to acquire apps from Windows Store for Business on behalf of his company.</descrip></descripGrp><ntig><termGrp><term id="2259637">purchaser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2261409">купувач</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38886_2259638_2261492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of a set of photos that displays them one at a time, sequentially.</descrip></descripGrp><ntig><termGrp><term id="2259638">slideshow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2261492">приказ на слајдови</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38887_2259809_2261376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section in the Settings app for Windows 10 desktop, containing network and Internet settings.</descrip></descripGrp><ntig><termGrp><term id="2259809">Network &amp; Internet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2261376">Мрежа и интернет</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38888_2259810_2261614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section in the Settings app for Windows 10 Mobile, containing network and wireless (mobile) settings.</descrip></descripGrp><ntig><termGrp><term id="2259810">Network &amp; wireless</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2261614">Мрежа и безжично</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38892_2897506_2897633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft cloud-based filtering system that detects and blocks malicious files, attachments, malware, and links in team sites, document libraries, as well as in team collaboration and email apps.</descrip></descripGrp><ntig><termGrp><term id="2897506">Microsoft Defender for Office 365</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2897633">Microsoft Defender за Office 365</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38892_2897506_2910498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft cloud-based filtering system that