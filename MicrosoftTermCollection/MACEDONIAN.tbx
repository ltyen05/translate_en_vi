Ракописни анотации</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46851_2637200_2642109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that returns a list of unique values in a list or range and that uses a language code (ll-CC) provided as an argument to determine sorting behavior.</descrip></descripGrp><ntig><termGrp><term id="2637200">UNIQUE.INTL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2642109">ЕДИНСТВЕНА ВРЕДНОСТ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46852_2637201_2642106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that sorts the contents of a range based on the values in a corresponding range and that uses a language code (ll-CC) provided as an argument to determine sorting behavior.</descrip></descripGrp><ntig><termGrp><term id="2637201">SORTBY.INTL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2642106">СОРТИРАЊЕ ПО ВРЕДНОСТИ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46855_2638181_2644211"><langSet xml:lang="en-US"><descripGrp><descrip 