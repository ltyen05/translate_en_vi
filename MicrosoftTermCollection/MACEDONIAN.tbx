Note type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45211_2579517_2582706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The readiness reporting feature that is used to scan devices and Office documents to determine their readiness to support the Click-to-Run version of Office.</descrip></descripGrp><ntig><termGrp><term id="2579517">Readiness Toolkit for Office add-ins and VBA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2582706">Readiness Toolkit for Office add-ins and VBA</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4523_146682_1868095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to run a presentation over the Web. The presentation is saved in HTML format and can contain audio and video. It can also be recorded and saved to be viewed later.</descrip></descripGrp><ntig><termGrp><term id="146682">presentation broadcast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868095">емитување на презентација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4525_5939_1096023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The protocol that improves the security of data communication by using a combination of data encryption, digital certificates, and public key cryptography. SSL enables authentication and increases data integrity and privacy over networks. SSL does not provide authorization or nonrepudiation.</descrip></descripGrp><ntig><termGrp><term id="5939">Secure Sockets Layer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1096023">Слој безбедни приклучоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4525_5939_1522869"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The protocol that improves the security of data communication by using a combination of data encryption, digital certificates, and public key cryptography. SSL enables authentication and increases data integrity and privacy over networks. SSL does not provide authorization or nonrepudiation.</descrip></descripGrp><ntig><termGrp><term id="5939">Secure Sockets Layer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1522869">ССЛ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4525_5940_1096023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The protocol that improves the security of data communication by using a combination of data encryption, digital certificates, and public key cryptography. SSL enables authentication and increases data integrity and privacy over networks. SSL does not provide authorization or nonrepudiation.</descrip></descripGrp><ntig><termGrp><term id="5940">SSL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1096023">Слој безбедни приклучоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4525_5940_1522869"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The protocol that improves the security of data communication by using a combination of data encryption, digital certificates, and public key cryptography. SSL enables authentication and increases data integrity and privacy over networks. SSL does not provide authorization or nonrepudiation.</descrip></descripGrp><ntig><termGrp><term id="5940">SSL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1522869">ССЛ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45253_2555759_2557966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measurement used in traditional tabletop role-playing games and role-playing video games to quantify a player character's progression through the game. Experience points are awarded for the completion of quests, overcoming obstacles and opponents, and for successful role-playing.</descrip></descripGrp><ntig><termGrp><term id="2555759">XP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2557966">XP</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45256_2555925_2557963"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category in the Settings app where developers can configure their Xbox Live accounts in order to take advantage of the Xbox Live features and services.</descrip></descripGrp><ntig><termGrp><term id="2555925">Xbox Networking</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2557963">Xbox вмрежување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45266_2556358_2752446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of technologies brought together to provide a holistic view of an organization’s information technology (IT) security infrastructure.</descrip></descripGrp><ntig><termGrp><term id="2556358">Security Information and Event Management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2752446">Управување со безбедносни информации и настани</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Si