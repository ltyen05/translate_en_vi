><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11655_780638_2786102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital video device that is used for recording moving images and audio in a digital format.</descrip></descripGrp><ntig><termGrp><term id="780638">digital video camera</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2786102">камера</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11672_27099_1995518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera for use with a computer to transmit a video picture.</descrip></descripGrp><ntig><termGrp><term id="27099">webcam</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1995518">веб-камера</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11680_234309_1096006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To bring a form, service, server farm, or form template offline gradually by not accepting new user sessions and allowing existing sessions to finish.</descrip></descripGrp><ntig><termGrp><term id="234309">quiesce</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1096006">гаснење<