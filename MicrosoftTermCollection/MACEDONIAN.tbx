">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2718688">анализа за однесување на корисници и ентитети</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48135_2717013_2718686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cybersecurity process that looks at normal user and entity behavior and patterns and that detects any abnormal behavior or instances where there is a deviation from normal patterns.</descrip></descripGrp><ntig><termGrp><term id="2717013">UEBA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2718686">анализа на однесувањето на корисници и ентитети</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48135_2717013_2718687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cybersecurity process that looks at normal user and entity behavior and patterns and that detects any abnormal behavior or instances where there is a deviation from normal patterns.</descrip></descripGrp><ntig><termGrp><term id="2717013">UEBA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2718687">АОКЕ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48135_2717013_2718688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cybersecurity process that looks at normal user and entity behavior and patterns and that detects any abnormal behavior or instances where there is a deviation from normal patterns.</descrip></descripGrp><ntig><termGrp><term id="2717013">UEBA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2718688">анализа за однесување на корисници и ентитети</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48136_2717034_2718680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A means of bypassing normal security and authentication protocols on a device or in software that was intentionally designed that way.</descrip></descripGrp><ntig><termGrp><term id="2717034">backdoor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2718680">задна врата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48137_2717038_2718681"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Potential damage to the interests of an organization by a person or persons regarded, inaccurately, as loyally working for or on behalf of the organization, or who inadvertently commits security breaches.</descrip></descripGrp><ntig><termGrp><term id="2717038">insider threat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2718681">внатрешна закана</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48138_2717322_2718689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A breach of an account.</descrip></descripGrp><ntig><termGrp><term id="2717322">account breach</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2718689">пробив на сметка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48139_2717335_2718693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container that holds a list of documents within a case where they can be indexed and analyzed by Advanced eDiscovery to identify the most important documents for litigation, investigation, public data request, or government inquiry.</descrip></descripGrp><ntig><termGrp><term id="2717335">working set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2718693">работен збир</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></te