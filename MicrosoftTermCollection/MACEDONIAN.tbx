lected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29271_1506868_1523164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option for a site collection that allows administrators to set levels for maximum storage allowed, maximum number of users allowed, and warnings that are associated with the maximum levels.</descrip></descripGrp><ntig><termGrp><term id="1506868">site collection quota</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523164">квота на колекцијата на локации</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29272_1506869_1523165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that can be associated with a content type or list within a site or site collection.</descrip></descripGrp><ntig><termGrp><term id="1506869">site column</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523165">колона на локацијата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29273_1506870_1523166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A named and uniquely identifiable collection of settings and fields that store metadata for lists within individual sites.</descrip></descripGrp><ntig><termGrp><term id="1506870">site content type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523166">тип содржина на локацијата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29274_1506871_1523167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A family of site definition configurations. Each site definition specifies a name and contains a list of the site definition configurations.</descrip></descripGrp><ntig><termGrp><term id="1506871">site definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523167">дефиниција на локацијата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29275_1506872_1943377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based definition of lists, features, modules, and other data, that collectively define a type of SharePoint site. Site definition configurations are stored in the ONET.xml file.</descrip></descripGrp><ntig><termGrp><term id="1506872">site definition configuration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943377">конфигурација на дефиниција за локација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29276_1506873_1523168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A zero-based integer that indicates the version number of the site definition. Every time a site definition is updated, it is suggested that the version number be increased.</descrip></descripGrp><ntig><termGrp><term id="1506873">site definition version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523168">верзија на дефиницијата на локацијата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29277_1506874_1943378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 4-byte unsigned integer bit mask that specifies properties that are unique to a site.</descrip></descripGrp><ntig><termGrp><term id="1506874">site flag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943378">знаменце за локација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29278_1506875_1943379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A GUID that is used to identify a site in a SharePoint site collection.</descrip></descripGrp><ntig><termGrp><term id="1506875">site identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943379">идентификатор за локација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29278_1506875_1943395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A GUID that is used to identify a site in a SharePoint site collection.</descrip></descripGrp><ntig><termGrp><term id="1506875">site identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943395">Веб-идентификатор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29278_1507084_1943379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A GUID that is used to identify a site in a SharePoint site collection.</descrip></descripGrp><ntig><termGrp><term id="1507084">Web identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943379">идентификатор за локација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29278_1507084_1943395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A GUID that is used to identify a site in a SharePoint site collection.</descrip></descripGrp><ntig><termGrp><term id="1507084">Web identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943395">Веб-идентификатор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29279_1506876_1943380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status of being a member of a site and having a defined set of user rights for accessing or managing content on that site.</descrip></descripGrp><ntig><termGrp><term id="1506876">site membership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943380">членство на локација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29280_1506877_1523169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A name/value pair of strings that serves as metadata for a site, such as the title or default language.</descrip></descripGrp><ntig><termGrp><term id="1506877">site property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523169">својство на локацијата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29281_1506878_1943381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A deployable, reusable package that contains a set of features, site definitions, and assemblies that apply to sites, and that can be enabled or disabled individually.</descrip></descripGrp><ntig><termGrp><term id="1506878">site solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943381">решение за локација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29282_1506879_1523170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based definition of site settings, including formatting, lists, views, and elements such as text, graphics, page layout, and styles. Site templates are stored in .stp files in the content database.</descrip></descripGrp><ntig><termGrp><term id="1506879">site template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523170">шаблон на локацијата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29287_1506884_1523175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A URL that identifies a point at which to start a crawl. Administrators specify start addresses when they create or edit a content source.</descrip></descripGrp><ntig><termGrp><term id="1506884">start address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523175">почетна адреса</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29288_1506885_1943382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The component of a rank that does not depend on the search query. It represents the perceived importance of an item and may be related to the origin of the item and relationships between the item and other items or business rules that are defined in the search application.</descrip></descripGrp><ntig><termGrp><term id="1506885">static rank</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943382">статичен ранг</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29289_1507069_1943383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column that uses a summary or subtotal function to display the total of detail items in a PivotTable® field.</descrip></descripGrp><ntig><termGrp><term id="1507069">subtotal column</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943383">колона на подзбир</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29290_1507070_1943384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A row that uses a summary or subtotal function to display the total of detail items in a PivotTable® field.</descrip></descripGrp><ntig><termGrp><term id="1507070">subtotal row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943384">ред на подзбир</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29291_1507071_1943385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism whereby a user account or a process account can be used to perform operations on behalf of the current user.</descrip></descripGrp><ntig><termGrp><term id="1507071">trusted authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943385">доверлива автентикација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29292_1507072_1943386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of communication in which two-way trust is established between two server components. Each server component communicates with the other component by using an account that is authorized to perform privileged actions such as retrieving files and settings.</descrip></descripGrp><ntig><termGrp><term id="1507072">trusted subsystem</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943386">доверлив потсистем</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29293_1507073_1523179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The language that is used to display strings and other graphical elements in a user interface.</descrip></descripGrp><ntig><termGrp><term id="1507073">UI culture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523179">култура на УИ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29294_1507074_1943387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user profile property that can contain the preferred name of a user.</descrip></descripGrp><ntig><termGrp><term id="1507074">user display name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943387">корисничко име за прикажување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29295_1507075_1943388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository that logs all of the changes that take place in a user profile.</descrip></descripGrp><ntig><termGrp><term id="1507075">user profile change entry log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943388">дневник на изменети записи на кориснички профил</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29296_1507076_1943389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event that occurs when a property of any user profile is changed.</descrip></descripGrp><ntig><termGrp><term id="1507076">user profile change event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943389">изменет настан на кориснички профил</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29297_1507077_1943390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of importing records from a directory service to the user profile store.</descrip></descripGrp><ntig><termGrp><term id="1507077">user profile import</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943390">увоз на кориснички профил</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gramma