ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943144">мапа на апликации</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24108_1098542_1488473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A script-based applet that is stored as a favorite or bookmark in a web browser, or is accessed through a hyperlink on a webpage.</descrip></descripGrp><ntig><termGrp><term id="1098542">bookmarklet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1488473">апликација за обележување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24109_1098543_1943209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of associating a feature with a site definition, without modifying the site definition itself or using code routines. The associated feature is added automatically to new sites that are based on that site definition.</descrip></descripGrp><ntig><termGrp><term id="1098543">feature stapling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943209">поврзување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24109_1275537_1943209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of associating a feature with a site definition, without modifying the site definition itself or using code routines. The associated feature is added automatically to new sites that are based on that site definition.</descrip></descripGrp><ntig><termGrp><term id="1275537">stapling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943209">поврзување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24110_1098544_1943145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of statistics that indicates the degree to which a computer, server farm, or server cluster meets security, capacity, performance, usage, and other demands.</descrip></descripGrp><ntig><termGrp><term id="1098544">health status</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943145">статус на состојба</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24124_1098902_2687103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transfer of certain properties, such as open files, from a parent program or process to another program or process that the parent causes to run.</descrip></descripGrp><ntig><termGrp><term id="1098902">inheritance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2687103">наследство</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24138_1098950_1373905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the form where a user can report violations of the terms of use. Contextually, it's understood that the abuse in question is poor conduct, such as obscene language or threats.</descrip></descripGrp><ntig><termGrp><term id="1098950">Report Abuse</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1373905">Пријави злоупотреба</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24142_1098959_2512984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code that grants rights to an individual, for example to use a system or access stored data.</descrip></descripGrp><ntig><termGrp><term id="1098959">authorization code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2512984">код за авторизација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24192_1112946_1943146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control on a page or master page that can be replaced with another control or content.</descrip></descripGrp><ntig><termGrp><term id="1112946">delegate control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943146">контрола на делегат</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24193_1112947_1943147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that can be used to set the properties for and to manipulate Web Parts on a Web Parts page.</descrip></descripGrp><ntig><termGrp><term id="1112947">Editor Part</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943147">Дел на уредник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24194_1112948_1943148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A relationship in which a feature is activated automatically when another feature is activated or a feature must be activated manually before another feature can be activated.</descrip></descripGrp><ntig><termGrp><term id="1112948">feature activation dependency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943148">зависност на карактеристика за активирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24196_1115313_2775217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program or program module that adds functionality to or extends the effectiveness of a program.</descrip></descripGrp><ntig><termGrp><term id="1115313">extension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2775217">проширување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24197_1115314_1523109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text-based, data interchange format that is used to transmit structured data, typically in Ajax Web applications.</descrip></descripGrp><ntig><termGrp><term id="1115314">JavaScript Object Notation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523109">JSON</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24197_1115314_1943149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text-based, data interchange format that is used to transmit structured data, typically in Ajax Web applications.</descrip></descripGrp><ntig><termGrp><term id="1115314">JavaScript Object Notation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943149">Означување објекти на JavaScript</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24197_1115315_1523109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text-based, data interchange format that is used to transmit structured data, typically in Ajax Web applications.</descrip></descripGrp><ntig><termGrp><term id="1115315">JSON</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523109">JSON</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24197_1115315_1943149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text-based, data interchange format that is used to transmit structured data, typically in Ajax Web applications.</descrip></descripGrp><ntig><termGrp><term id="1115315">JSON</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943149">Означување објекти на JavaScript</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24198_1115316_1943150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operation that requires more resources than are allowed by a threshold, based on the number of items or amount of information that is processed during the operation.</descrip></descripGrp><ntig><termGrp><term id="1115316">privileged task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943150">привилегирана задача</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="242_184035_1522845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special storage location of templatized pages for performance enhancement.</descrip></descripGrp><ntig><termGrp><term id="184035">page output cache</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1522845">кеш на страниците</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2420_308318_1371410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date after which information or a resource is no longer valid.</descrip></descripGrp><ntig><termGrp><term id="308318">expiration date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371410">рок на важење</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24202_1115320_1868439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process, thread, or set of related processes or threads that requires significant system resources or time, or requires exclusive access to large amounts of data.</descrip></descripGrp><ntig><termGrp><term id="1115320">resource-intensive task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868439">задача што користи многу извори</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24205_1115323_1943151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extensible programming model and components that can be used to design and implement custom applications for common business processes, such as document approval. Components include version control, tracking, and reporting.</descrip></descripGrp><ntig><termGrp><term id="1115323">workflow foundation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943151">основа на работен тек</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24206_1115324_1523062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The object that is used to initiate any actions with the client-side object model. It is the primary entry point for the client object model, and the primary object for coordinating requests against corresponding objects in a site collection.</descrip></descripGrp><ntig><termGrp><term id="1115324">client context</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523062">клиентски контекст</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24208_1115326_1943152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server-side code routine that is called when a feature is activated, deactivated, installed, uninstalled, or upgraded on a computer, server farm, or server cluster.</descrip></descripGrp><ntig><termGrp><term id="1115326">feature event receiver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943152">примач на карактеристика на настан</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24209_1115327_1943153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statistic that indicates the degree to which a computer, server farm, or server cluster meets a specific demand for that configuration. It also indicates which log information to copy to a central location for review.</descrip></descripGrp><ntig><termGrp><term id="1115327">health tracking indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943153">индикатор за следење на состојба</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24210_1115328_1943154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A content type that inherits settings from a base content type that was designed for any type of SharePoint list item.</descrip></descripGrp><ntig><termGrp><term id="1115328">item-based content type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943154">тип на содржина заснован на ставки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24211_1115329_1943155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A content type that inherits settings from a base content type that was designed for document libraries.</descrip></descripGrp><ntig><termGrp><term id="1115329">document-based content type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943155">тип на содржина заснован на документи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24212_1119987_1523154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom solution that can be deployed to a site by a site collection administrator, without approval from the farm administrator. Without that approval, the solution has full access to the immediate site and restricted access to system resources and other sites.</descrip></descripGrp><ntig><termGrp><term id="1119987">sandboxed solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523154">изолирано решение</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24213_1115331_1523108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A persistent container that defines and stores instructions for a job to be run on a server, server farm, or server cluster. To run, a job must have an associated job definition, and a definition must be associated with a service or a Web application.</descrip></descripGrp><ntig><termGrp><term id="1115331">job definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523108">дефиниција на работата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24214_1115332_1943156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dedicated, administrator-level user account that performs scheduled administrative tasks.</descrip></descripGrp><ntig><termGrp><term id="1115332">timer account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943156">сметка со тајмер</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24215_1115333_1523173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compressed file that can be deployed to a server farm or a site. It can contain assemblies, resource files, site and feature definitions, templates, code access security policies, and Web Parts.</descrip></descripGrp><ntig><termGrp><term id="1115333">solution package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523173">пакет-решение</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24216_1115334_1523172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom keyword or description and shortcut to a Web page or item on a SharePoint site or the Internet. All of these tags can be viewed, managed, and shared by using My Site.</descrip></descripGrp><ntig><termGrp><term id="1115334">social tag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523172">социјална ознака</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24217_1115335_1868440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of features that can be used to store and share comments, shortcuts, descriptions, and other information about Web pages and items on a SharePoint site or the Internet.</descrip></descripGrp><ntig><termGrp><term id="1115335">social data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868440">социјални податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24218_1115336_1943157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reserved time for performing administrative tasks on a computer, server farm, or server cluster.</descrip></descripGrp><ntig><termGrp><term id="1115336">service window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943157">прозорец за услуги</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24219_1115337_1943158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An administrative setting that limits the number of query results for SharePoint lists, sites, and site collections that contain a large number of items.</descrip></descripGrp><ntig><termGrp><term id="1115337">query-size threshold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943158">праг за големина на прашалник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24220_1115338_1943159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reserved time for performing large, resource-intensive queries for a computer, server farm, or server cluster.</descrip></descripGrp><ntig><termGrp><term id="1115338">query window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943159">прозорец на прашалник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24221_1115339_1523110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solution package that contains only a DLL that stores localized versions of strings in another solution package. After a language pack is deployed to a site, users can display the corresponding user interface in that language.</descrip></descripGrp><ntig><termGrp><term id="1115339">language pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523110">јазичен пакет</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24222_1115340_1523130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area for storing comments about a Web page. A note board can appear on a Web page or in a separate dialog box. The notes can be viewed, managed, and shared by using My Site.</descrip></descripGrp><ntig><termGrp><term id="1115340">note board</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523130">табла за белешки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24223_1115341_1523119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft SQL Server, MSDE, or WMSDE database that stores health monitoring and usage data temporarily, and can be used for reporting and diagnostics.</descrip></descripGrp><ntig><termGrp><term id="1115341">logging database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523119">база на податоци за евидентирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24224_1115342_1868441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statistic that indicates the degree to which a computer, server farm, or server cluster meets usage demands for that configuration.</descrip></descripGrp><ntig><termGrp><term id="1115342">quality-of-service indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868441">индикатор за квалитет на услуга</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24245_1117153_1519930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An installation package that the user downloads from http://download.live.com/?mkt=en-us.</descrip></descripGrp><ntig><termGrp><term id="1117153">download</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1519930">преземање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24247_1117155_1373906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The main landing or start page on Windows Live.</descrip></descripGrp><ntig><termGrp><term id="1117155">Windows Live Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1373906">Windows Live почетна страница</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2425_34681_441413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined set of harmonized colors that you can apply to text and objects. Text and objects with an applied scheme color will change automatically when you switch to a new color scheme or modify the current color scheme.</descrip></descripGrp><ntig><termGrp><term id="34681">color scheme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441413">шема на бои</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24254_1117166_2775185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that connects networks using the same communications protocols so that information can be passed from one to the other.</descrip></descripGrp><ntig><termGrp><term id="1117166">bridge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2775185">мост</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24284_1119138_2387985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-defined and annotated group of points of interest on a map.</descrip></descripGrp><ntig><termGrp><term id="1119138">collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2387985">колекција</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><te