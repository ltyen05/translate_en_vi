termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11543_346954_443077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The high definition optical disc format which uses a smaller focus blue-violet 405 nm laser allowing higher precision and storage density. A competitor to Blu-ray Disc.</descrip></descripGrp><ntig><termGrp><term id="346954">HD movie</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="443077">ВД-филм</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1155_145640_442167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A frame that can contain check boxes, toggle buttons, and option buttons on a form, report, or data access page. You use an option group to present alternatives from which the user can select a single option.</descrip></descripGrp><ntig><termGrp><term id="145640">option group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442167">изборна група</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11558_181384_2305679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that displays information about an object in the interface.</descrip></descripGrp><ntig><termGrp><term id="181384">properties page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305679">страница со својства</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11563_109159_1943042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure that contains security information associated with a protected object. Security descriptors include information about who owns the object, who can access it and in what way, and what types of access are audited.</descrip></descripGrp><ntig><termGrp><term id="109159">security descriptor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943042">опишувач на безбедност</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11564_235069_442506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows for ease of creating a new or expanding an existing wireless network. This setup can be done automatically using a USB flash driver or manually through a Wireless Network Setup wizard.</descrip></descripGrp><ntig><termGrp><term id="235069">Windows Connect Now</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442506">Windows Connect Now</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11567_216558_442394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To arrange to receive a product or use a service regularly.</descrip></descripGrp><ntig><termGrp><term id="216558">subscribe</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442394">претплати се</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11576_358360_2305754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of components and services that enable voice, fax, and email messages to be stored in a user's single mailbox. Users can also access their Microsoft Exchange Server 2007 mailbox from a telephone or a computer.</descrip></descripGrp><ntig><termGrp><term id="358360">Unified Messaging server role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305754">улога на сервер при унифицирана размена на пораки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11584_308343_442799"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic ad that is the full height of a page and normally 120 pixels wide.</descrip></descripGrp><ntig