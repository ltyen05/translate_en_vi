ntry><termEntry id="52349_2955561_2972729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns a member or tuple in a cube hierarchy. Use to validate that the member or tuple exists in the cube.</descrip></descripGrp><ntig><termGrp><term id="2955561">CUBEMEMBER</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2972729">CUBEMEMBER</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52350_2955562_2972730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns the value of a member property in the cube. Use to validate that a member name exists within the cube and to return the specified property for this member.</descrip></descripGrp><ntig><termGrp><term id="2955562">CUBEMEMBERPROPERTY</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2972730">CUBEMEMBERPROPERTY</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52351_2955563_2972731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns the nth, or ranked, member in a set. Use to return one or more elements in a set, such as the top sales performer or top 10 students.</descrip></descripGrp><ntig><termGrp><term id="2955563">CUBERANKEDMEMBER</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2972731">CUBERANKEDMEMBER</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52352_2955564_2972732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that defines a calculated set of members or tuples by sending a set expression to the cube on the server, which creates the set, and then returns that set to Microsoft Office Excel.</descrip></descripGrp><ntig><termGrp><term id="2955564">CUBESET</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2972732">CUBESET</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52353_2955565_2972733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns the number of items in a set.</descrip></descripGrp><ntig><termGrp><term id="2955565">CUBESETCOUNT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2972733">CUBESETCOUNT</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52354_2955566_2972734"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns an aggregated value from a cube.</descrip></descripGrp><ntig><termGrp><term id="2955566">CUBEVALUE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2972734">CUBEVALUE</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52355_2955567_2972735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Financial Excel function that returns the cumulative interest paid between two periods.</descrip></descripGrp><ntig><termGrp><term id="2955567">CUMIPMT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2972735">CUMIPMT</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52356_2955568_2972736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Financial Excel function that returns the cumulative principal paid on a loan between two periods.</descrip></descripGrp><ntig><termGrp><term id="2955568">CUMPRINC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2972736">CUMPRINC</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</