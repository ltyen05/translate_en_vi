>ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2455692">Движење низ страници</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43312_2452714_2455691"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presentation of a document for a particular mode of navigation.</descrip></descripGrp><ntig><termGrp><term id="2452714">navigation layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2455691">Распоред за навигација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43316_2453745_2456262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An established relationship with a data source that allows an app to acquire data from it.</descrip></descripGrp><ntig><termGrp><term id="2453745">connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2456262">поврзување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43318_2453751_2456263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PowerApps connection that allows apps to access user profiles in an organization, as well as the profiles of their managers and direct reports.</descrip></descripGrp><ntig><termGrp><term id="2453751">Office 365 Users</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2456263">Корисници на Office 365</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4332_141858_1372334"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of a category of information in a mail-merge data source. For example, "City," "State," and "PostalCode" are commonly used field names in an address list.</descrip></descripGrp><ntig><termGrp><term id="141858">field name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372334">име на полето</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43324_2454174_2456265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that launches a digital ruler that allows users to draw straight ink and align shapes against​ it.</descrip></descripGrp><ntig><termGrp><term id="2454174">Ruler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2456265">Линијар</term><termNote type="geographicalUsage">MKD</termNote><ter