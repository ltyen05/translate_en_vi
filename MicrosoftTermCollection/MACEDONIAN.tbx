g the route to their destination.</descrip></descripGrp><ntig><termGrp><term id="2459049">guided navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2460679">навигација со насоки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35715_2065925_2081461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sound the phone makes when the user receives a text message.</descrip></descripGrp><ntig><termGrp><term id="2065925">text tone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2081461">тон за текстуална порака</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35716_2065926_2081451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature where users can add contacts that they call frequently so that they can get to their numbers quickly rather than going through the Contact list in People.</descrip></descripGrp><ntig><termGrp><term id="2065926">speed dial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2081451">брзо бирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35718_2067023_2081440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of contacts users can call (i.e. only shows contacts that have phone numbers associated with them).</descrip></descripGrp><ntig><termGrp><term id="2067023">phone book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2081440">именик</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35719_2067024_2081484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature on the phone to enroll in and manage a workplace account.</descrip></descripGrp><ntig><termGrp><term id="2067024">workplace</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2081484">работно место</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35720_2067025_2081485"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account provided by a company that allows users to install apps or hubs provided by that company, and that governs the company policies applied to the phone.</descrip></descripGrp><ntig><termGrp><term id="2067025">workplace account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termG