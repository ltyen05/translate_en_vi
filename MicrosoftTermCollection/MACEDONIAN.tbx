ough Copilot, Designer, Paint, Windows or other services. Some features may require more than one credit.</descrip></descripGrp><ntig><termGrp><term id="3187524">AI credit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3187860">кредит</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5649_140798_1868052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that displays all rows, or records, from the underlying record source.</descrip></descripGrp><ntig><termGrp><term id="140798">detail field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868052">детално поле</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56490_3175489_3175884"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that suppresses unwanted background noise in your audio and video files​.</descrip></descripGrp><ntig><termGrp><term id="3175489">noise suppression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3175884">потиснување на шум</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></t