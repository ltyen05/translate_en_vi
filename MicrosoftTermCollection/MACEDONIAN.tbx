</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3177856">уредување на транскрипција</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56499_3177426_3177841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that finds and cuts together video highlights based on a transcript​.</descrip></descripGrp><ntig><termGrp><term id="3177426">highlights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3177841">најважни моменти</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="565_144149_1868076"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page of information about the broadcast that is displayed in the viewer's browser before the broadcast begins. It can contain a title, subject, host's name, information about the broadcast, and a countdown to the time of the broadcast.</descrip></descripGrp><ntig><termGrp><term id="144149">lobby page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868076">воведна страница</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></