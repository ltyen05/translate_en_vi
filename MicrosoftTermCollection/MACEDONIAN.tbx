ehension and speed.</descrip></descripGrp><ntig><termGrp><term id="2441981">Focus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2443522">Фокус</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43102_2441983_2443527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The font style that applies a particular font to the book that is being read, resembling a newspaper or other news source.</descrip></descripGrp><ntig><termGrp><term id="2441983">News</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2443527">Вести</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43103_2441984_2443532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The font style that applies a particular font to the book that is being read to minimize clutter and create a clean look.</descrip></descripGrp><ntig><termGrp><term id="2441984">Pure</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2443532">Чист</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></nt