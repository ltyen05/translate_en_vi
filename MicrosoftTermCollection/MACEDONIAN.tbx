ermNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2406837">ФТП-тројанец</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1133_1520_1465395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type used in some programming languages, notably C, to declare variables that can store floating-point numbers.</descrip></descripGrp><ntig><termGrp><term id="1520">float</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1465395">лебдач</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11330_360145_443143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program you use to view, print, and electronically mail a snapshot, such as a report snapshot.</descrip></descripGrp><ntig><termGrp><term id="360145">Snapshot Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="443143">Прикажувач на снимки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11332_397182_2305611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed folder that appears in Outlook by default, to which messaging records management has been applied, and whose the retention and journaling is controlled by managed content settings that are applied to the folder.</descrip></descripGrp><ntig><termGrp><term id="397182">managed default folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305611">управувана зададена папка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1134_36967_441433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reduce the size of a set of data, such as a file or a communications message, so that it can be stored in less space or transmitted with less bandwidth.</descrip></descripGrp><ntig><termGrp><term id="36967">compress</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441433">компримирај</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11351_10952_441248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The consistent positioning of text, graphics, and other objects.</descrip></descripGrp><ntig><termGrp><term id="10952">alignment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441248">порамнување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfS