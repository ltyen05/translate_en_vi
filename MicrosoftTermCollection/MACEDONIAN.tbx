in Name Service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1485342">Услуга за име на домен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10175_604846_1485342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Internet utility that implements the Domain Name System. DNS servers, also called name servers, maintain databases containing the addresses and are accessed transparently to the user.</descrip></descripGrp><ntig><termGrp><term id="604846">DNS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1485342">Услуга за име на домен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10179_143328_1868069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar marked off in units of measure (such as inches) that is displayed across the top of the document window.</descrip></descripGrp><ntig><termGrp><term id="143328">horizontal ruler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868069">хоризонтален линијар</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1018_32207_441396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To press and release a mouse button once without moving the mouse, usually to select or deselect an item or to activate a program or program feature.</descrip></descripGrp><ntig><termGrp><term id="32207">click</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441396">кликни</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10180_131401_1371651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image that appears as the background to a document. Generally faded and transparent, so that text can be clearly read over it.</descrip></descripGrp><ntig><termGrp><term id="131401">watermark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371651">воден знак</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10186_126193_2308064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove oneself as a recipient on a mailing list.</descrip></descripGrp><ntig><termGrp><term id="126193">unsubscribe</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2308064">Откажете претплата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10188_42237_441474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A representation of concepts such as facts or instructions in a formalized manner, suitable for communication, interpretation or processing.</descrip></descripGrp><ntig><termGrp><term id="42237">data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441474">податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10189_110172_1953761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that separates groups of controls (on a surface) or commands (on a menu).</descrip></descripGrp><ntig><termGrp><term id="110172">separator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1953761">разделник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10189_722343_1953761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that separates groups of controls (on a surface) or commands (on a menu).</descrip></descripGrp><ntig><termGrp><term id="722343">separator bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1953761">разделник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1019_36322_441428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree to which a computer, an attached device, a data file, or a program can work with or understand the same commands, formats, or language as another. True compatibility means that any operational differences are invisible to people and programs alike.</descrip></descripGrp><ntig><termGrp><term id="36322">compatibility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441428">компатибилност</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10190_122191_442002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A command button used in a toolbar (or status bar).</descrip></descripGrp><ntig><termGrp><term id="122191">toolbar button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442002">копче од алатник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1020_184061_1943064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container for storing native SharePoint objects and custom data from first and third parties.</descrip></descripGrp><ntig><termGrp><term id="184061">property bag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943064">контејнер на својства</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10206_718_1485336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any technology used to protect the interests of owners of digital content and services (such as copyright owners). Typically, authorized recipients or users must acquire a license in order to use the content.</descrip></descripGrp><ntig><termGrp><term id="718">digital rights management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1485336">Управување со дигиталните права (УДП)</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10206_719_1485336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any technology used to protect the interests of owners of digital content and services (such as copyright owners). Typically, authorized recipients or users must acquire a license in order to use the content.</descrip></descripGrp><ntig><termGrp><term id="719">DRM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSe