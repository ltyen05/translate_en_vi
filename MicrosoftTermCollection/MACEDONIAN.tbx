ermEntry id="53715_3057909_3058456"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Philanthropies program that provides technology grants and discounts to nonprofit organizations all over the world.</descrip></descripGrp><ntig><termGrp><term id="3057909">Tech for Social Impact</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3058456">Технологија за општествено влијание</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53716_3057910_3058457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of games or contests in Microsoft Teams that make up a single unit of competition to promote new learnings and healthy usage of tools and scenarios across the organization.</descrip></descripGrp><ntig><termGrp><term id="3057910">tournament</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3058457">турнир</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53717_3057911_3058405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams feature that intelligently arranges meeting elements for optimal viewing by automatically adjusting the layout when people join, turn on the video, or present.</descrip></descripGrp><ntig><termGrp><term id="3057911">Dynamic view</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3058405">Динамички приказ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53718_3057912_3058427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft Teams, a one-touch experience for joining third-party online meetings.</descrip></descripGrp><ntig><termGrp><term id="3057912">one-touch join</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3058427">придружување со еден допир</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53719_3057913_3058399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in the Microsoft Teams calls app that allows users to combine calls together.</descrip></descripGrp><ntig><termGrp><term id="3057913">call merge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3058399">спојување повици</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53720_3057914_3058410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams feature that allows users to seamlessly move their calls between different devices, such as from the laptop to a mobile phone and vice-versa, without any interruption in call service or quality.</descrip></descripGrp><ntig><termGrp><term id="3057914">endpoint transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3058410">пренос помеѓу крајни точки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53721_3057915_3058430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conversation method that uses a button to switch a device from the voice transmission mode to the voice reception mode.</descrip></descripGrp><ntig><termGrp><term id="3057915">push-to-talk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3058430">притисни за зборување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53721_3057916_3058430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conversation method that uses a button to switch a device from the voice transmission mode to the voice reception mode.</descrip></descripGrp><ntig><termGrp><term id="3057916">push to talk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3058430">притисни за зборување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53722_3059076_3059559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides a direct path to Windows 365 from the Task Bar or Start menu, with a personal, customized experience that can be tailored to each individual.</descrip></descripGrp><ntig><termGrp><term id="3059076">Windows 365 app</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3059559">Апликација Windows 365</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53723_3059078_3059560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of AI-powered audiovisual effects available on Windows.</descrip></descripGrp><ntig><termGrp><term id="3059078">Windows Studio effects</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3059560">студиски ефекти во Windows</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53725_3059304_3060387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to share different types of content with others in an online meeting.</descrip></descripGrp><ntig><termGrp><term id="3059304">content sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3060387">споделување содржина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53727_3059305_3060386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams that enables users to join a meeting from a conference room with their own personal device.</descrip></descripGrp><ntig><termGrp><term id="3059305">companion device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3060386">придружен уред</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53728_3059306_3060393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows you to share content from physical whiteboards and documents in a high-quality way during meetings.</descrip></descripGrp><ntig><termGrp><term id="3059306">intelligent content capture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3060393">интелигентно снимање на содржина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></l