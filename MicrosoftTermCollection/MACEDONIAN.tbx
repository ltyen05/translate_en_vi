rver Manager and the IIS console trees. In the IIS console tree an application is either at the root directory level of the Web site or at a subdirectory level of the Web site.</descrip></descripGrp><ntig><termGrp><term id="188094">Commerce application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1543818">апликација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7365_188095_1543818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Commerce Server application is a logical representation of an application in Microsoft Internet Information Services (IIS); it appears in both Commerce Server Manager and the IIS console trees. In the IIS console tree an application is either at the root directory level of the Web site or at a subdirectory level of the Web site.</descrip></descripGrp><ntig><termGrp><term id="188095">Commerce Server application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1543818">апликација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7369_80126_1371575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information about the properties or structure of data that is not part of the values the data contains.</descrip></descripGrp><ntig><termGrp><term id="80126">metadata</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371575">метаподатоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7373_87506_1372380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An association between two tables in which the primary key value of each record in the primary table corresponds to the value in the matching field or fields of many records in the related table.</descrip></descripGrp><ntig><termGrp><term id="87506">one-to-many relationship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372380">однос еден-повеќе</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7376_1146759_441601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of computer programs in which one or more users interact with the computer as a form of entertainment.</descrip></descripGrp><ntig><termGrp><term id="1146759">video game</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441601">игра</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7376_57639_441601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of computer programs in which one or more users interact with the computer as a form of entertainment.</descrip></descripGrp><ntig><termGrp><term id="57639">game</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441601">игра</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7376_730281_441601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of computer programs in which one or more users interact with the computer as a form of entertainment.</descrip></descripGrp><ntig><termGrp><term id="730281">computer game</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441601">игра</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7384_46146_1371576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows certain devices, such as hard disks and CD or DVD drives, to transfer information directly through the computer's memory without using the computer's processor. DMA improves the performance of the device and frees the computer's processor so it can perform other tasks.</descrip></descripGrp><ntig><termGrp><term id="46146">direct memory access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371576">ДМА</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7384_46146_441511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows certain devices, such as hard disks and CD or DVD drives, to transfer information directly through the computer's memory without using the computer's processor. DMA improves the performance of the device and frees the computer's processor so it can perform other tasks.</descrip></descripGrp><ntig><termGrp><term id="46146">direct memory access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441511">директен мемориски пристап</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7384_46147_1371576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows certain devices, such as hard disks and CD or DVD drives, to transfer information directly through the computer's memory without using the computer's processor. DMA improves the performance of the device and frees the computer's processor so it can perform other tasks.</descrip></descripGrp><ntig><termGrp><term id="46147">DMA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371576">ДМА</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNot