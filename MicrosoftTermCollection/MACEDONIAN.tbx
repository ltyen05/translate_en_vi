a on a computer screen that contains different groups of apps or content open and available for different tasks or aspects of your life.</descrip></descripGrp><ntig><termGrp><term id="2247562">virtual desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2250322">работна површина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38633_2247562_2250848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work area on a computer screen that contains different groups of apps or content open and available for different tasks or aspects of your life.</descrip></descripGrp><ntig><termGrp><term id="2247562">virtual desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2250848">виртуелна работна површина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38633_2247563_2250322"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work area on a computer screen that contains different groups of apps or content open and available for different tasks or aspects of your life.</descrip></descripGrp><ntig><termGrp><term id="2247563">desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2250322">работна површина</term><termNote type="geographica