er">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29217_1506803_1943337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A share that is located on a query server and whose purpose is to allow files to be copied to it by an indexer.</descrip></descripGrp><ntig><termGrp><term id="1506803">propagation share</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943337">споделување на дистрибуција</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29218_1506804_1523142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an object that was created and deployed successfully.</descrip></descripGrp><ntig><termGrp><term id="1506804">provisioned</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523142">обезбеден</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29219_1506805_1943338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that facilitates saving a document or portions of a document to a Web server.</descrip></descripGrp><ntig><termGrp><term id="1506805">publish to server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943338">објавување на сервер</ter