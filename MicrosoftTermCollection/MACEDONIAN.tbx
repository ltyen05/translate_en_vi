S"><descripGrp><descrip type="definition">Occurring on the client side of a client-server system. For example, on the World Wide Web, JavaScript scripts are client-side because they are executed by your browser (the client). In contrast, CGI scripts are server-side because they run on the Web server. Java applets can be either server-side or client-side depending on which computer (the server or the client) executes them.</descrip></descripGrp><ntig><termGrp><term id="32556">client-side</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305829">страна на клиент</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10560_145705_1868090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data that is contained within a worksheet outline. Outline data includes both the summary and detail rows or columns of an outline.</descrip></descripGrp><ntig><termGrp><term id="145705">outline data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868090">податоци на контура</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10561_19019_1832155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task that is part of an operating system or program, and is operating without interaction with the user while the user is working on another task.</descrip></descripGrp><ntig><termGrp><term id="19019">background task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832155">задача во заднина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10567_232824_1868187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic or other object that is inserted in the drawing layer so that you can position it precisely on the page or in front of or behind text or other objects.</descrip></descripGrp><ntig><termGrp><term id="232824">floating object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868187">слободен објект</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10572_24731_1867962"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar that is part of an application when it's installed on your computer.</descrip></descripGrp><ntig><termGrp><term id="24731">built-in toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1867962">вграден алатник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termE