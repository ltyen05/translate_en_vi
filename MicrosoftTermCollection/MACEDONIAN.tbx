term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371837">регистриран трговски заштитен знак</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15806_319155_1371837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The symbol or character used to indicate that a word, phrase, symbol, or design is a registered trademark.</descrip></descripGrp><ntig><termGrp><term id="319155">REGISTERED SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371837">регистриран трговски заштитен знак</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15814_140706_1371838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window that shows the design of these database objects - tables, queries, forms, reports, macros, and data access pages. In Design view, you can create new database objects and modify the design of existing ones.</descrip></descripGrp><ntig><termGrp><term id="140706">Design view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371838">Приказ на дизајнот</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15817_308348_442804"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A label for a geographic selection.</descrip></descripGrp><ntig><termGrp><term id="308348">State/Region</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442804">Држава/Област</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15818_234305_1371839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form component, such as a template part or ActiveX control, that isn't included with InfoPath by default. Form designers can add or remove custom controls by using the Controls task pane.</descrip></descripGrp><ntig><termGrp><term id="234305">custom control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371839">кориснички приспособена контрола</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15834_83662_441782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of an application window that enables the user to navigate quickly to different parts of the program.</descrip></descripGrp><ntig><termGrp><term id="83662">navigation pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig