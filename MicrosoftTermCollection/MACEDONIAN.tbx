44693_1868687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web experience on Office.com that enables users to manage their Office licenses and subscriptions.</descrip></descripGrp><ntig><termGrp><term id="1644693">My Account</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868687">Моја сметка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32269_1644697_1868688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Click-to-Run feature that enables two versions of Office to exist on the same computer to provide a seamless transition for users in supported scenarios.</descrip></descripGrp><ntig><termGrp><term id="1644697">Office Side-by-Side</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868688">Office едно до друго</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32270_1645770_1868689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint document library that administrators can use to distribute apps for Office and SharePoint to their end users.</descrip></descripGrp><ntig><termGrp><term id="1645770">App Catalog</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868689">К