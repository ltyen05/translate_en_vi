Number">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2488525">#БЛОКИРАНО!</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44245_2485904_2487542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A website that customers can go to for help with Microsoft products.</descrip></descripGrp><ntig><termGrp><term id="2485904">Microsoft Support</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2487542">Поддршка на Microsoft</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4425_232401_1868170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Calendar, time status and user defined labels are indicated by colors and patterns.</descrip></descripGrp><ntig><termGrp><term id="232401">free/busy time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868170">слободно/зафатено време</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44250_2486129_2496836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In mixed reality, an app view in which the app takes over the full display and becomes the only app you see.</descrip></descripGrp><ntig><termGrp><term id="2486129">immersive view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2496836">сеопфатен приказ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44253_2486136_2496840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Mixed Reality​, the desktop app that allows the user to manage their mixed reality headset, get status on their mixed reality hardware, see a live stream of what's visible in the headset, and complete system setup.​</descrip></descripGrp><ntig><termGrp><term id="2486136">Mixed Reality Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2496840">Портал на мешана реалност</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44259_2486144_2496844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mixed reality experience built into Windows that powers a compatible virtual reality headset or head-mounted display.</descrip></descripGrp><ntig><termGrp><term id="2486144">Windows Mixed Reality</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2496844">Windows Mixed Reality</term><termNote type="geographicalUsage">MKD</t