 10</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2353341">Windows 10</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37459_2138003_2687731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions that uses the methods of the HTTP protocol (GET, POST, PUT, DELETE) for distributed hypertext systems to perform operations using URIs as parameters.</descrip></descripGrp><ntig><termGrp><term id="2138003">REST API</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2687731">REST API</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37465_2138907_2176544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The result of projecting an image onto a cylinder.</descrip></descripGrp><ntig><termGrp><term id="2138907">cylindrical projection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2176544">цилиндрична проекција</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37466_2138908_2178637"><langSet xml:l