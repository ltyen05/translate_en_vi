te type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2720012">Сертифицирано од Skype</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48088_2713700_2720003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To start recording the amount of time worked on a shift.</descrip></descripGrp><ntig><termGrp><term id="2713700">clock in</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2720003">снимај работно време</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48089_2713701_2720004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To stop recording the amount of time worked during a shift.</descrip></descripGrp><ntig><termGrp><term id="2713701">clock out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2720004">сопри снимање работно време</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48090_2713973_2720015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To pick up a call that has been parked.</descrip></descripGrp><ntig><termGrp><term id="2713973">unpark</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2720015">отпаркирај</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4810_169828_1745103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical card that represents a specific value or amount of service for which the user has paid in advance.</descrip></descripGrp><ntig><termGrp><term id="169828">prepaid card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1745103">припејд картичка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48105_2715521_2717144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item, such as devices, apps, macros, add-ins and drivers, which Desktop Analytics tests in a deployment plan.</descrip></descripGrp><ntig><termGrp><term id="2715521">asset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2717144">средство</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48106_2715522_2717147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A metric that describes the degree to which a proposed pilot deployment represents the diversity of assets in the total deployment, where 100% coverage signifies that all possible device and asset combinations have been included in the deployment plan.</descrip></descripGrp><ntig><termGrp><term id="2715522">coverage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2717147">опфатеност</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48114_2715871_2717156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that delivers emails with attachments to a recipient’s inbox along with a “placeholder” attachment and that then reattaches the original after it is scanned and deemed safe.</descrip></descripGrp><ntig><termGrp><term id="2715871">Dynamic Delivery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2717156">Динамична испорака</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48115_2715872_2720025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to clock in and out of a shift and that produces reports based on that information.</descrip></descripGrp><ntig><termGrp><term id="2715872">Time Clock</term><termNote type="partOfSpeech">P