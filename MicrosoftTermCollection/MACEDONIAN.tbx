t and that reflects the likelihood that the message is phishing.</descrip></descripGrp><ntig><termGrp><term id="307443">phishing confidence level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2726867">ниво на доверба при кражба на идентитет</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4280_592553_2726860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value between 1 and 8 that is assigned to a message based on its content and that reflects the likelihood that the message is phishing.</descrip></descripGrp><ntig><termGrp><term id="592553">PCL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2726860">НДКИ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4280_592553_2726867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value between 1 and 8 that is assigned to a message based on its content and that reflects the likelihood that the message is phishing.</descrip></descripGrp><ntig><termGrp><term id="592553">PCL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2726867">ниво на доверба при кражба на идентитет</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="gram