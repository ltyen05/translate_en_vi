ermNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="719_47296_1371358"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operating system feature that allows executable routines (generally serving a specific function or set of functions) to be stored separately as files with .dll extensions. These routines are loaded only when needed by the program that calls them.</descrip></descripGrp><ntig><termGrp><term id="47296">DLL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371358">ДЛЛ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="719_47296_441523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operating system feature that allows executable routines (generally serving a specific function or set of functions) to be stored separately as files with .dll extensions. These routines are loaded only when needed by the program that calls them.</descrip></descripGrp><ntig><termGrp><term id="47296">DLL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441523">библиотека со динамична врска</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="719_47297_1371358"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operating system feature that allows executable routines (generally serving a specific function or set of functions) to be stored separately as files with .dll extensions. These routines are loaded only when needed by the program that calls them.</descrip></descripGrp><ntig><termGrp><term id="47297">dynamic-link library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371358">ДЛЛ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="719_47297_441523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operating system feature that allows executable routines (generally serving a specific function or set of functions) to be stored separately as files with .dll extensions. These routines are loaded only when needed by the program that calls them.</descrip></descripGrp><ntig><termGrp><term id="47297">dynamic-link library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441523">библиотека со динамична врска</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7190_73009_441694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calculator-style block of keys, usually at the right side of a keyboard, that can be used to enter numbers.</descrip></descripGrp><ntig><termGrp><term id="73009">keypad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441694">нумеричка тастатура</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7190_73010_441694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calculator-style block of keys, usually at the right side of a keyboard, that can be used to enter numbers.</descrip></descripGrp><ntig><termGrp><term id="73010">numeric keypad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441694">нумеричка тастатура</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7199_146292_1372373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rectangle that represents an imported graphic in your document. You can increase scrolling speed by temporarily replacing graphics with picture placeholders.</descrip></descripGrp><ntig><termGrp><term id="146292">picture placeholder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372373">резервирано место за слика</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="720_139724_1372287"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The block of filled-in cells that includes the currently selected cell or cells. The region extends in all directions to the first empty row or column.</descrip></descripGrp><ntig><termGrp><term id="139724">current region</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372287">тековен регион</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7201_147134_1372374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">independent attributes associated with items, or members, in an OLAP cube. For example, if city items have size and population properties stored in the server cube, a PivotTable report can display the size and population of each city.</descrip></descripGrp><ntig><termGrp><term id="147134">property fields</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372374">полиња за својства</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7204_2066257_2078437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification for sharing items, such as calendars, documents or folders, with others.</descrip></descripGrp><ntig><termGrp><term id="2066257">invitation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2078437">покана</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7204_2066257_2078438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification for sharing items, such as calendars, documents or folders, with others.</descrip></descripGrp><ntig><termGrp><term id="2066257">invitation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2078438">покана за споделување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7204_234808_2078437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification for sharing items, such as calendars, documents or folders, with others.</descrip></descripGrp><ntig><termGrp><term id="234808">sharing invitation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2078437">покана</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7204_234808_2078438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification for sharing items, such as calendars, documents or folders, with others.</descrip></descripGrp><ntig><termGrp><term id="234808">sharing invitation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2078438">покана за споделување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7205_123123_1371570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sending of information over a communications line or a circuit.</descrip></descripGrp><ntig><termGrp><term id="123123">transmission</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371570">пренос</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7207_121617_1465423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of a number of separately printed parts of an oversized publication, such as a banner or poster, that cannot be printed as a single sheet. Separate tiles can be assembled to recreate the whole publication.</descrip></descripGrp><ntig><termGrp><term id="121617">tile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1465423">плочка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="721_295549_442713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A circular or pamphlet for distribution, normally used for advertisements.</descrip></descripGrp><ntig><termGrp><term id="295549">flyer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442713">леток</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7212_34816_441416"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of items arranged vertically within some type of framework--for example, a continuous series of cells running from top to bottom in a spreadsheet, a set of lines of specified width on a printed page, a vertical line of pixels on a video screen, or a set of values aligned vertically in a table or matrix.</descrip></descripGrp><ntig><termGrp><term id="34816">column</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441416">колона</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7221_231974_442419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive, cross tabulated Excel report that summarizes and analyzes data, such as database records, from various sources including ones external to Excel.</descrip></descripGrp><ntig><termGrp><term id="231974">PivotTable report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442419">PivotTable-извештај</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7230_308260_1371571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programming interface used to build and maintain unattended installation answer files and configuration sets by adding security fixes, changing drivers, and so forth.</descrip></descripGrp><ntig><termGrp><term id="308260">Component Platform Interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371571">ЦПИ-интерфејс</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7230_308260_1372375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programming interface used to build and maintain unattended installation answer files and configuration sets by adding security fixes, changing drivers, and so forth.</descrip></descripGrp><ntig><termGrp><term id="308260">Component Platform Interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372375">ЦПИ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7230_308261_1371571"><l