378_1996149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single-threaded apartment the thread of which is the core UI thread for an application window.</descrip></descripGrp><ntig><termGrp><term id="1993378">application single-threaded apartment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1996149">АСТА</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34569_1993379_1996148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single-threaded apartment the thread of which is the core UI thread for an application window.</descrip></descripGrp><ntig><termGrp><term id="1993379">ASTA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1996148">апартман со една нишка за апликацијата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34569_1993379_1996149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single-threaded apartment the thread of which is the core UI thread for an application window.</descrip></descripGrp><ntig><termGrp><term id="1993379">ASTA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1996149">АСТА</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNo