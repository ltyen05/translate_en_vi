<term id="1275658">speed dial key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832378">брзо бирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5437_1275658_2305724"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single- or double-digit number associated with telephone numbers, or email or Web addresses, that enables users to quickly access the numbers or addresses.</descrip></descripGrp><ntig><termGrp><term id="1275658">speed dial key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305724">копче за брзо избирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5437_616102_1832378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single- or double-digit number associated with telephone numbers, or email or Web addresses, that enables users to quickly access the numbers or addresses.</descrip></descripGrp><ntig><termGrp><term id="616102">speed dial number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832378">брзо бирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</te