8589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that turns on change tracking and lets you set a password to prevent unauthorized users from turning it off.</descrip></descripGrp><ntig><termGrp><term id="1624316">Lock Tracking</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868589">Следење на заклучување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31803_1624317_1868590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A guide that is created and edited in Slide Master view, and that applies to slides that use the master layout in which it was created.</descrip></descripGrp><ntig><termGrp><term id="1624317">master-level guide</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868590">водич на главно ниво</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31804_1624318_1868591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A guide that applies to all slides in a presentation.</descrip></descripGrp><ntig><termGrp><term id="1624318">presentation-level guide</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868591">водич на презентациско ниво</term><termNote type="geographicalUsa