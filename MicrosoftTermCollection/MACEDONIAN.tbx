ammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2308065">темелен преглед</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39487_2300132_2308071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the access level for Office Web Apps in which consumers who are not signed in with a license or can view existing documents, but can't edit them or create new documents.</descrip></descripGrp><ntig><termGrp><term id="2300132">view-only</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2308071">само за преглед</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39488_2300148_2308067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ideogram originating in Japanese electronic messages or websites and used to express an idea, emotion, etc. in electronic communication.</descrip></descripGrp><ntig><termGrp><term id="2300148">emoji</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2308067">фаца</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39489_2300781_2308068"><