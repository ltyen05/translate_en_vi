и клуч</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11515_27557_441355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of a capital letter in writing or printing.</descrip></descripGrp><ntig><termGrp><term id="27557">capitalization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441355">употреба на големи букви</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11518_232393_1372421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined combination of grouped and sorted messages in table view.</descrip></descripGrp><ntig><termGrp><term id="232393">arrangement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372421">подредување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1152_52942_1371376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation of printed paper where the printed side is away from a surface. For example, paper is face up when it is placed in a copier with the printed side away from the copying surface.</descrip></descripGrp><ntig><termGrp><term id="52942">face up</term><termNote type="pa