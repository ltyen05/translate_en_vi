ingular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442422">Outlook-адресар</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4972_75877_1372344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In information processing, an operation performed by the computer at hand rather than by a remote computer.</descrip></descripGrp><ntig><termGrp><term id="75877">local</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372344">локален</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4973_141204_442137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In line and area charts, lines that extend from a data point to the category (x) axis. Useful in area charts to clarify where one data marker ends and the next begins.</descrip></descripGrp><ntig><termGrp><term id="141204">drop lines</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442137">паѓачки линии</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49748_2815101_2840459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides a dedicated cache solution that complements Delivery Optimization distributed peer-to-peer system.</descrip></descripGrp><ntig><termGrp><term id="2815101">Connected Cache</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2840459">Поврзан кеш</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49754_2815537_2815825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Microsoft 365 that includes business services—email, file storage and sharing, Office Online, meetings and IM, and more. Office applications not included.</descrip></descripGrp><ntig><termGrp><term id="2815537">Office 365 E1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2815825">Office 365 E1</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49755_2815538_2815846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Microsoft 365 that includes Skype for Business integrations with telephone system, Office 365 Advanced Threat Protection, Customer Lockbox,Power BI Pro, as well as both the Microsoft Office desktop apps and the online versions. It includes all the features of ProPlus and Office 365 E1 plus security and compliance tools, such as legal hold, data loss prevention, and more.</descrip></descripGrp><ntig><termGrp><term id="2815538">Office 365 E3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2815846">Office 365 E3</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49756_2815539_2815867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Microsoft 365 that includes Skype for Business integrations with telephone system, Office 365 Advanced Threat Protection, Customer Lockbox,Power BI Pro, as well as both the Microsoft Office desktop apps and the online versions. It includes all the features of Office 365 E3 plus advanced security, analytics, and voice capabilities.</descrip></descripGrp><ntig><termGrp><term id="2815539">Office 365 E5</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2815867">Office 365 E5</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49764_2815600_2819596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of user account attributes, segments, "block" and/or "allow" policies, and policy application definitions that together establish information barriers within an organization.</descrip></descripGrp><ntig><termGrp><term id="2815600">information barrier policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2819596">политика за препреки за информации</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49768_2815606_2819608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An IT tool which enables business users to collect signals from their products and services and gain actionable insights into their customers’ usage and experiences.</descrip></descripGrp><ntig><termGrp><term id="2815606">telemetry collection service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2819608">услуга за прибирање телеметриски податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49780_2816016_2817421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software tool that enables business users to collect signals from their products and services and gain actionable insights into their customers’ usage and experiences.</descrip></descripGrp><ntig><termGrp><term id="2816016">Product Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2817421">Product Insights</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49780_2816016_2820501"><langSet xml:l