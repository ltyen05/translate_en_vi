/term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2881740">позната папка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5103_312764_1371499"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Internet Explorer, a set of tabs you can store in your Favorites or as Home Page to reopen all tabs in the set in one go.</descrip></descripGrp><ntig><termGrp><term id="312764">tab set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371499">група картички</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51095_2884686_2884909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An unpatched software vulnerability that is unknown to, or unaddressed by, the software's vendor that can be exploited to attack the computer system or network.</descrip></descripGrp><ntig><termGrp><term id="2884686">zero-day</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2884909">ранливост на 0-ден</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51095_2884686_2884911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An unpatched software vulnerability that is unknown to, or unaddressed by, the software's vendor that can be exploited to attack the computer system or network.</descrip></descripGrp><ntig><termGrp><term id="2884686">zero-day</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2884911">ранливост на нулта ден</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51095_2884687_2884909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An unpatched software vulnerability that is unknown to, or unaddressed by, the software's vendor that can be exploited to attack the computer system or network.</descrip></descripGrp><ntig><termGrp><term id="2884687">0-day</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2884909">ранливост на 0-ден</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51095_2884687_2884911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An unpatched software vulnerability that is unknown to, or unaddressed by, the software's vendor that can be exploited to attack the computer system or network.</descrip></descripGrp><ntig><termGrp><term id="2884687">0-day</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2884911">ранливост на нулта ден</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51096_2884688_2884910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Descriptive of any content or feature available to a customer who upgrades from a free service to a paid service, as part of that larger offering.</descrip></descripGrp><ntig><termGrp><term id="2884688">premium</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2884910">премиум</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51104_2884921_2885487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of background images for the Windows lock screen and/or the Windows desktop, with hotspots overlaying linking to information about the image, in-product marketing, experiences, or tips and tricks.</descrip></descripGrp><ntig><termGrp><term id="2884921">spotlight collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2885487">актуелна збирка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51108_2885547_2886299"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To stream the content of a user's device screen or a separate window to the screens of other users' devices, so these users could remotely see the screen of the user who shares it.</descrip></descripGrp><ntig><termGrp><term id="2885547">share</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2886299">сподели</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51109_2885548_2886298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that helps users be more productive at work, such as Office apps.</descrip></descripGrp><ntig><termGrp><term id="2885548">productivity app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2886298">апликација за продуктивност</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51113_2886072_2886292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The United States holiday celebrated on June 14 that commemorates the adoption of the flag of the United States.</descrip></descripGrp><ntig><termGrp><term id="2886072">Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2886292">Ден на знамето</term><termNote type="geographicalUsage">MKD</termNote><termNote t