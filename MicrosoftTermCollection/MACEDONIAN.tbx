termNote></termGrp></ntig></langSet></termEntry><termEntry id="44553_2506807_2512935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agreement that a contributor to a repository must sign before their contribution is accepted, and that allows the owner of the repository to distribute the contribution with their own license.</descrip></descripGrp><ntig><termGrp><term id="2506807">contribution license agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2512935">договор за лиценца за соработка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44554_2506505_2512957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having the property that it is possible to set the value to null.</descrip></descripGrp><ntig><termGrp><term id="2506505">nullable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2512957">може да биде нула</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44555_2506506_2512959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list which prefixes its items with numbers or letters in ascending order.</descrip></descripGrp><ntig><termGrp><term id="2506506">ordered list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:la