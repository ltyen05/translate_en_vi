s.</descrip></descripGrp><ntig><termGrp><term id="2866254">ASR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2866435">НПН</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48153_2718213_2721928"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email that Office 365 classifies as statistically most likely spam.</descrip></descripGrp><ntig><termGrp><term id="2718213">high confidence spam</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2721928">спам со голем степен на веродостојност</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48154_2718229_2721927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A move of a service from one geo to another.</descrip></descripGrp><ntig><termGrp><term id="2718229">geo move</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2721927">географско преместување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48158_2718508_2721933"><langSet xml:lang="en-US"><descripGrp><descrip type="definiti