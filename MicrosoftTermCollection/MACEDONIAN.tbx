4267_2058694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera that can be used with a television set to make video calls.</descrip></descripGrp><ntig><termGrp><term id="1814267">TV cam</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058694">ТВ-камера</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33736_1814672_2058696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A part of a Skype subscription offer that allows a user to call to selected destination(s) within limits defined by the Fair Usage Policy.</descrip></descripGrp><ntig><termGrp><term id="1814672">unlimited calls</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058696">неограничени повици</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33737_1814673_2058695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Characteristic of a subscription which gives you, for a per-month fee, unlimited calls to a selected country/region; e.g. Unlimited Portugal.</descrip></descripGrp><ntig><termGrp><term id="1814673">Unlimited</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058695">Неограничено</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33738_1814780_2058699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A free internet call between two Skype users seeing each other via webcam.</descrip></descripGrp><ntig><termGrp><term id="1814780">video call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058699">видеоразговор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33738_1815075_2058699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A free internet call between two Skype users seeing each other via webcam.</descrip></descripGrp><ntig><termGrp><term id="1815075">video chat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058699">видеоразговор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33744_1816419_1832178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The signal between a cellular phone and the mobile operator's network that allows the user to access the Internet and make phone calls using a cellular phone. A telecommunications standard that lets users send and receive messages that include rich text, images, audio, and video.</descrip></descripGrp><ntig><termGrp><term id="1816419">cellular signal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832178">мобилен сигнал</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33748_1816736_1832319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of playback of selected music/videos</descrip></descripGrp><ntig><termGrp><term id="1816736">playback order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832319">редослед на плејбек</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33757_1817022_1832144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An accomplishment that is formally recognized by a game, site, or app.</descrip></descripGrp><ntig><termGrp><term id="1817022">achievement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832144">постигнување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33757_2686037_1832144"><langSet xml:lang="en-US"><descripGrp><descrip t