63_2505977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office Dictate mode that interprets users' pauses as punctuation and adds them into the document.</descrip></descripGrp><ntig><termGrp><term id="2505363">Automatic Punctuation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2505977">Automatic Punctuation</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44546_2506467_2509246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A record of all purchases made by a user from an online store or portal.</descrip></descripGrp><ntig><termGrp><term id="2506467">order history</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2509246">историја на нарачки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44547_2506496_2512958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extension that allows the addition of untyped properties.</descrip></descripGrp><ntig><termGrp><term id="2506496">open extension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2512958">отворена наставка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="g