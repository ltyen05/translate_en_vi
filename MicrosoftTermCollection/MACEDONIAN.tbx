49_2910394_2910509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft Teams suite designed for education facilities.</descrip></descripGrp><ntig><termGrp><term id="2910394">Microsoft Teams for Education</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2910509">Teams за образование</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51849_2910395_2910508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft Teams suite designed for education facilities.</descrip></descripGrp><ntig><termGrp><term id="2910395">Teams for Education</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2910508">Microsoft Teams за образование</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51849_2910395_2910509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft Teams suite designed for education facilities.</descrip></descripGrp><ntig><termGrp><term id="2910395">Teams for Education</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2910509">Teams за образование</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">O