icalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55167_3127759_3128269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams add-on license that allows offices to designate devices as shared devices, including common area phones, Teams displays for hot-desks, and Teams panels for meeting spaces.</descrip></descripGrp><ntig><termGrp><term id="3127759">Teams Shared Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3128269">Споделени уреди на Teams</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55170_3127858_3128263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft Viva Goals, to pass on OKRs from one level to the next, allowing employees and teams to see how their work directly contributes to the ultimate goals of their organization.</descrip></descripGrp><ntig><termGrp><term id="3127858">cascade</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3128263">каскадно проследување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55171_3128244_3128792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service in Windows, available through Azure, that adds digital signatures to application binaries and packages, and thereby providing security promises of authenticity and integrity used to establish trust in software that you are distributing.</descrip></descripGrp><ntig><termGrp><term id="3128244">Trusted Signing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3128792">Доверливо потпишување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55172_3128313_3128790"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Intune that allows users to refresh a device's configuration.</descrip></descripGrp><ntig><termGrp><term id="3128313">Config Refresh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3128790">Освежување на конфигурација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55173_3128440_3128791"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of NFTs, crypto currencies, and other Web 3 properties that the user keeps in their Microsoft Wallet.</descrip></descripGrp><ntig><termGrp><term id="3128440">crypto assets</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3128791">криптографски средства</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><ter