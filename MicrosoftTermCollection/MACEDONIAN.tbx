ig><termGrp><term id="442304">блиц-извештај</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10531_760070_441758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A command button that is clicked to display a drop-down menu instead of performing a command.</descrip></descripGrp><ntig><termGrp><term id="760070">drop-down button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441758">мени копче</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10531_79731_441758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A command button that is clicked to display a drop-down menu instead of performing a command.</descrip></descripGrp><ntig><termGrp><term id="79731">menu button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441758">мени копче</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10532_36444_441429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of a computer or operating system that allows it to run programs written for a different system.</descrip></descripGrp><ntig><termGrp><term id="36444">compatibility mode</term><termNo