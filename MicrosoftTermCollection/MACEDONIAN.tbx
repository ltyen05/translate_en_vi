erm><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827977">навигација и филтрирање со метаподатоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49850_2819348_2827981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that allows users to configure a filter list to use metadata tree view hierarchies and set filter controls to improve navigation and filtering of the list items.</descrip></descripGrp><ntig><termGrp><term id="2819348">metadata navigation filtering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827981">филтрирање на навигацијата со метаподатоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49850_2819349_2827977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that allows users to configure a filter list to use metadata tree view hierarchies and set filter controls to improve navigation and filtering of the list items.</descrip></descripGrp><ntig><termGrp><term id="2819349">metadata navigation and filtering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827977">навигација и филтрирање со метаподатоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49850_2819349_2827981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that allows users to configure a filter list to use metadata tree view hierarchies and set filter controls to improve navigation and filtering of the list items.</descrip></descripGrp><ntig><termGrp><term id="2819349">metadata navigation and filtering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827981">филтрирање на навигацијата со метаподатоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49851_2819360_2827974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that enables users to dynamically filter and find content in lists and libraries by using a navigation hierarchy tree control to apply different metadata-based filters to the view.</descrip></descripGrp><ntig><termGrp><term id="2819360">metadata navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827974">навигација со метаподатоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49852_2819372_2828005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The type of web part, for example, Search box web part or Content Editor web part.</descrip></descripGrp><ntig><termGrp><term id="2819372">webpart type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2828005">тип на веб-дел</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49853_2819381_2827957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The execution of arbitrary commands or code on a target machine or in a target process.</descrip></descripGrp><ntig><termGrp><term id="2819381">arbitrary code execution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827957">извршување на произволен код</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49853_2819381_2827958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The execution of arbitrary commands or code on a target machine or in a target process.</descrip></descripGrp><ntig><termGrp><term id="2819381">arbitrary code execution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827958">ИПК</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49853_2819385_2827957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The execution of arbitrary commands or code on a target machine or in a target process.</descrip></descripGrp><ntig><termGrp><term id="2819385">ACE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827957">извршување на произволен код</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49853_2819385_2827958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The execution of arbitrary commands or code on a target machine or in a target process.</descrip></descripGrp><ntig><termGrp><term id="2819385">ACE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827958">ИПК</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49854_2819397_2827967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">a set of entities and the relationships between the entities</descrip></descripGrp><ntig><termGrp><term id="2819397">entity schema</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827967">шема на ентитети</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49855_2819402_2827991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In OAuth authentication, a token that is used by the Consumer to ask the User to authorize access to the Protected Resources. The User-authorized Request Token is exchanged for an Access Token, MUST only be used once, and MUST NOT be used for any other purpose. It is RECOMMENDED that Request Tokens have a limited lifetime.</descrip></descripGrp><ntig><termGrp><term id="2819402">request token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827991">токен за барање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49856_2819416_2827999"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common cache source that can be accessed by multiple processes and machines.</descrip></descripGrp><ntig><termGrp><term id="2819416">shared cache</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827999">споделен кеш</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49857_2819428_2827996"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of users based on Azure AD attributes (such as location or department), or shared resources such as SharePoint sites. For example, you can have the segment "corporate advisory" and have "corporate advisory users" and "corporate advisory sites." In some cases, users in one segment may not be allowed to discover or communicate with users in another segment.</descrip></descripGrp><ntig><termGrp><term id="2819428">segment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827996">сегмент</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49858_2819429_2828004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in M365 admin center, which provides data, insights and recommendations related to optimization of devices, software, and other technology in your organization.</descrip></descripGrp><ntig><termGrp><term id="2819429">technology experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2828004">искуство со технологијата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49858_2819429_2835198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in M365 admin center, which provides data, insights and recommendations related to optimization of devices, software, and other technology in your organization.</descrip></descripGrp><ntig><termGrp><term id="2819429">technology experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2835198">Искуство со технологијата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49858_2831275_2828004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in M365 admin center, which provides data, insights and recommendations related to optimization of devices, software, and other technology in your organization.</descrip></descripGrp><ntig><termGrp><term id="2831275">Technology experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2828004">искуство со технологијата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49858_2831275_2835198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in M365 admin center, which provides data, insights and recommendations related to optimization of devices, software, and other technology in your organization.</descrip></descripGrp><ntig><termGrp><term id="2831275">Technology experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2835198">Искуство со технологијата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49859_2819431_2827989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">MMD device profile that provides local administrator privileges for users who need more control of their issued devices.</descrip></descripGrp><ntig><termGrp><term id="2819431">Privileged access device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827989">профил на уредот „Привилегиран пристап“</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4986_37166_1372345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device capable of processing information, storing data, and producing a desired result based on instructions provided.</descrip></descripGrp><ntig><termGrp><term id="37166">computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372345">компјутер</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49860_2819434_2827988"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The MMD device profile that offers the greatest power to the local user (ability to install apps, etc.). Intended for use typically by developers, field engineers, etc.</descrip></descripGrp><ntig><termGrp><term id="2819434">Power user device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827988">профил на уредот „Искусен корисник“</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49861_2819436_2827997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The MMD device profile that is more &amp;quot;locked down&amp;quot; to preserve the security of sensitive data. Intended for handling sensitive data such as medical records.</descrip></descripGrp><ntig><termGrp><term id="2819436">Sensitive data device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827997">профил на уредот “Осетливи информации“</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49862_2819437_2828000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The MMD device profile that has the most balance of user privileges and data security--expected to be the most common profile and used by typical information workers.</descrip></descripGrp><ntig><termGrp><term id="2819437">Standard device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2828000">профил на уредот „Стандард“</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49863_2911838_2912275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft Managed Desktop device profile optimized for use by frontline workers. Limited power for the user; intended for scenarios with multiple users sharing the same device, such as at a nurses' station. Likely to be operating under the F1 license.</descrip></descripGrp><ntig><termGrp><term id="2911838">frontline device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2912275">профил на уредот за работниците од прва линија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49864_2819441_2827971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the proposed MMD device profiles. This would support a single app without requiring a user sign in.</descrip></descripGrp><ntig><termGrp><term id="2819441">Kiosk device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827971">профил на уредот „Киоск“</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49865_2819443_2827966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in Microsoft 365, which includes insights and recommendations about usage of Microsoft 365 products that are related to employee productivity, engagement, wellbeing, and related concepts.</descrip></descripGrp><ntig><termGrp><term id="2819443">employee experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827966">искуство на вработените</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49865_2819443_2835196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in Microsoft 365, which includes insights and recommendations about usage of Microsoft 365 products that are related to employee productivity, engagement, wellbeing, and related concepts.</descrip></descripGrp><ntig><termGrp><term id="2819443">employee experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2835196">Искуство на вработените</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49865_2831277_2827966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in Microsoft 365, which includes insights and recommendations about usage of Microsoft 365 products that are related to employee productivity, engagement, wellbeing, and related concepts.</descrip></descripGrp><ntig><termGrp><term id="2831277">Employee experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827966">искуство на вработените</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49865_2831277_2835196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in Microsoft 365, which includes insights and recommendations about usage of Microsoft 365 products that are related to employee productivity, engagement, wellbeing, and related concepts.</descrip></descripGrp><ntig><termGrp><term id="2831277">Employee experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2835196">Искуство на вработените</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49866_2819444_2827995"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of Microsoft-recommended configuration settings along with an explanation of their security impact. These settings are based on feedback from Microsoft security engineering teams, product groups, partners, and customers.</descrip></descripGrp><ntig><termGrp><term id="2819444">security baseline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827995">основна линија за безбедност</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49867_2819445_2828003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that the customer defines, which represents a goal.</descrip></descripGrp><ntig><termGrp><term id="2819445">target</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2828003">цел</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49868_2819447_2827959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft 365 scores, a recommendation based on data from your organization, which, if completed, results directly or indirectly in points earned to improve your score. This can be a direct action like changing a setting, or an indirect action like providing training to users that encourages them to use a feature more.</descrip></descripGrp><ntig><termGrp><term id="2819447">action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2827959">дејство</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49868_2819447_2827970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft 365 scores, a recommendation based on data from your organization, which, if completed, results directly or indirectly in 