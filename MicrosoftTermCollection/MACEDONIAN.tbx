30762_2431379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that separates the syllables of each word with a dot, making content more easily readable for some people.</descrip></descripGrp><ntig><termGrp><term id="2430762">syllables</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2431379">слогови</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42878_2430908_2433718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that analyzes editing notations made with ink and makes the corresponding changes to the document.</descrip></descripGrp><ntig><termGrp><term id="2430908">Ink Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2433718">Уредник за ракопис</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4288_346910_443069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To join or link.</descrip></descripGrp><ntig><termGrp><term id="346910">connect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="443069">поврзи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42885_2432491_2436897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that allows users to use ink to highlight content using their mouse, finger, or an inking tool, and whose ink resembles a traditional highlighter.</descrip></descripGrp><ntig><termGrp><term id="2432491">highlighter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2436897">маркер</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42886_2432492_2436896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To create, highlight, or erase content using ink.</descrip></descripGrp><ntig><termGrp><term id="2432492">draw</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2436896">цртај</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42887_2432493_2436899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that allows users to use ink to draw using their mouse, finger, or an inking tool, and whose ink resembles pencil graphite.</descrip></descripGrp><ntig><termGrp><term id="2432493">pencil</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2436899">молив</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42888_2432494_2436898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that allows users to use ink to draw using their mouse, finger, or an inking tool, and whose ink resembles traditional pen ink.</descrip></descripGrp><ntig><termGrp><term id="2432494">pen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2436898">пенкало</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42889_2432495_2436902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that is activated when clicked once, and when clicked a second time, opens a menu that allows the user to modify the mode of the selected tool.</descrip></descripGrp><ntig><termGrp><term id="2432495">secondary action button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2436902">копче за секундарни дејствија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42890_2432497_2436903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that is opened via a secondary action button and that gives users one or more options for changing the mode of the selected tool.</descrip></descripGrp><ntig><termGrp><term id="2432497">secondary action menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2436903">мени за секундарни дејствија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42891_2432499_2436901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An in-ribbon container that holds a collection of buttons and where the user can add additional buttons, reorganize buttons, and scroll through them when they are not all visible within the container.</descrip></descripGrp><ntig><termGrp><term id="2432499">scrollable button group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2436901">група копчиња со преглед на лизгање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42895_2433212_2436900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The contextual ribbon tab that appears when users select a picture.​</descrip></descripGrp><ntig><termGrp><term id="2433212">Picture</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2436900">Слика</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42900_2433217_2434909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Literally, "without stroke"; describes any typeface in which the characters have no serifs (the short lines or ornaments at the upper and lower ends of the strokes.) A sans serif typeface usually possesses a more straightforward, geometric appearance than a typeface with serifs and typically lacks the contrast between thick and thin strokes found in serif faces.</descrip></descripGrp><ntig><termGrp><term id="2433217">sans serif</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2434909">без серифи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4293_37521_441436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state of an expression or a variable (for example, when a result can be either true or false, or equal or not equal).</descrip></descripGrp><ntig><termGrp><term id="37521">condition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441436">услов</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4296_309439_442808"><langSet xml:lang="en-US"><descripGrp><d