="7347_68157_441665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-speed digital technology that uses existing telephone lines to provide Internet access.</descrip></descripGrp><ntig><termGrp><term id="68157">ISDN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441665">ISDN</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7350_56471_441596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small part, amount, or proportion of something.</descrip></descripGrp><ntig><termGrp><term id="56471">fraction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441596">дропка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7353_522111_2786104"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An anonymous user who connects to an account from outside the firewall.</descrip></descripGrp><ntig><termGrp><term id="522111">external user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2786104">надворешен корисник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote>