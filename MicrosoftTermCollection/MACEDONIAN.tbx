></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2280481">список за читање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39268_2277946_2324136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit in the Office Graph that represents a connection between one entity and another, or a relationship between entities.</descrip></descripGrp><ntig><termGrp><term id="2277946">Office Graph edge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2324136">Раб од графикон на Office</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39269_2277947_2324137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit in the Office Graph that represents an entity, an action or a relationship between people, items, and people and items across Office 365.</descrip></descripGrp><ntig><termGrp><term id="2277947">Office Graph node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2324137">Јазол во графикон на Office</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39270_2277948_2324123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of Office Graph node that represents actual entities in the Office Graph, such as a person or a document.</descrip></descripGrp><ntig><termGrp><term id="2277948">entity node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2324123">јазол на ентитет</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39271_2277949_2324142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of Office Graph node that represents a relationship between two or more nodes with their own set of properties in the Office Graph.</descrip></descripGrp><ntig><termGrp><term id="2277949">relationship node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2324142">јазол на релации</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39272_2277950_2324121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of relationship node that represents an action performed by a person entity in the Office Graph.</descrip></descripGrp><ntig><termGrp><term id="2277950">action node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2324121">јазол на дејство</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun<