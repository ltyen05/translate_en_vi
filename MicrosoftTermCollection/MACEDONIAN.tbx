inition">To reset a system using a method that restores PC settings to defaults but retains a user's files and personalization touches.</descrip></descripGrp><ntig><termGrp><term id="1764505">refresh your PC</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1767658">освежи го компјутерот</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33278_1764509_1767661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reset a system so that all user customizations are removed.</descrip></descripGrp><ntig><termGrp><term id="1764509">reset your PC</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1767661">ресетирање на компјутерот</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33281_1764780_1775521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service run by the Windows Store team that supports the end-to-end process for registering Windows Store developers and onboarding apps into the Windows Store catalog.</descrip></descripGrp><ntig><termGrp><term id="1764780">dashboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1775521">Информациска табла</term><termNote type="geographicalUsage">MKD</termNote><termNote type