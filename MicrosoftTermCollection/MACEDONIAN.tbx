<langSet xml:lang="mk"><ntig><termGrp><term id="1371708">ХДМИ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11734_298004_1372422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital interface specification for delivering digital content and connecting consumer electronic devices.</descrip></descripGrp><ntig><termGrp><term id="298004">high-definition multimedia interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372422">мултимедиумски интерфејс за висока дефиниција</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11744_38453_441445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person, inside or outside your organization, for whom you have created an entry where you can save several types of information, such as street and email addresses, telephone and fax numbers, and Web page URLs.</descrip></descripGrp><ntig><termGrp><term id="38453">contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441445">контакт</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11748_136786_442083"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A display setting that holds up to 256 specific color entries. Any color palette attached to a picture is by definition an 8-bit palette.</descrip></descripGrp><ntig><termGrp><term id="136786">8-bit color</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442083">8-битна боја</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11757_146879_1371709"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The device that communicates between your software program and your printer.</descrip></descripGrp><ntig><termGrp><term id="146879">printer driver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371709">двигател за печатач</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11758_153847_442223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object created with one program and embedded into a document created by another. Embedding the object, rather than simply inserting or pasting it, ensures that the object retains its original format. If you double-click the embedded object, you can edit it with the toolbars and menus from the program used to create it.</descrip></descripGrp><ntig><termGrp><term id="153847">embedded object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442223">вметнат објект</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11759_307436_2305616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mechanism used to help a caller differentiate between users with names that match the touch-tone or speech input.</descrip></descripGrp><ntig><termGrp><term id="307436">Matched Name Selection Method</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305616">Метод за избор на спарени имиња</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11765_2795839_3179459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft's antimalware solution that provides next generation protection for desktops, portable computers, and servers.</descrip></descripGrp><ntig><termGrp><term id="2795839">Microsoft Defender Antivirus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3179459">Антивирус на Defender</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11765_3178800_3179459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft's antimalware solution that provides next generation protection for desktops, portable computers, and servers.</descrip></descripGrp><ntig><termGrp><term id="3178800">Defender Antivirus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3179459">Антивирус на Defender</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11767_140546_1868049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file containing data where individual field values are separated by a character, such as a comma or a tab.</descrip></descripGrp><ntig><termGrp><term id="140546">delimited text file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868049">датотека со разграничен текст</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11777_64765_1371710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that lets you enter complex characters and symbols, such as those used in East Asian written languages, using a standard keyboard.</descrip></descripGrp><ntig><termGrp><term id="64765">IME</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371710">ИМЕ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11777_64765_441645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that lets you enter complex characters and symbols, such as those used in East Asian written languages, using a standard keyboard.</descrip></descripGrp><ntig><termGrp><term id="64765">IME</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441645">Уредувач на методот за внесување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11777_64766_1371710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that lets you enter complex characters and symbols, such as those used in East Asian written languages, using a standard keyboard.</descrip></descripGrp><ntig><termGrp><term id="64766">input method editor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371710">ИМЕ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11777_64766_441645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that lets you enter complex characters and symbols, such as those used in East Asian written languages, using a standard keyboard.</descrip></descripGrp><ntig><termGrp><term id="64766">input method editor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441645">Уредувач на методот за внесување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11782_149770_442203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram that is used to show areas of overlap between and among elements.</descrip></descripGrp><ntig><termGrp><term id="149770">Venn diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442203">Венов дијаграм</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11795_147980_1953758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to keyboard settings, document views, user interface objects, languages, etc. for which text is displayed in a right-to-left direction.</descrip></descripGrp><ntig><termGrp><term id="147980">right-to-left</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1953758">РТЛ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11795_147980_442186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to keyboard settings, document views, user interface objects, languages, etc. for which text is displayed in a right-to-left direction.</descrip></descripGrp><ntig><termGrp><term id="147980">right-to-left</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442186">оддесно-налево</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11795_661874_1953758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to keyboard settings, document views, user interface objects, languages, etc. for which text is displayed in a right-to-left direction.</descrip></descripGrp><ntig><termGrp><term id="661874">RTL</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1953758">РТЛ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11795_661874_442186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to keyboard settings, document views, user interface objects, languages, etc. for which text is displayed in a right-to-left direction.</descrip></descripGrp><ntig><termGrp><term id="661874">RTL</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442186">оддесно-налево</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11796_331741_1485340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft set of business productivity services that provides a secure online workspace for organizing and managing information and a complete set of tools that integrate with existing Microsoft Office programs.</descrip></descripGrp><ntig><termGrp><term id="331741">Microsoft Office Live</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1485340">Microsoft Office Live</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11797_149448_1372423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that includes the name of the person who originally sent a task request plus the names of everyone who received the task request, reassigned the task to someone else, or chose to keep an updated copy of the task in their task list.</descrip></descripGrp><ntig><termGrp><term id="149448">update list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372423">ажуриран список</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11798_106558_2106350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line printed above, below, or to the side of some element, either to set that item off from the remainder of the page or to improve the look of the page. Footnotes, for example, often appear below a short rule that sets them off from the main text on the page. The thickness of a rule is typically measured in points. (A point is approximately 1/72 inch.)</descrip></descripGrp><ntig><termGrp><term id="106558">rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2106350">линија за правила</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11798_2085540_2106350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line printed above, below, or to the side of some element, either to set that item off from the remainder of the page or to improve the look of the page. Footnotes, for example, often appear below a short rule that sets them off from the main text on the page. The thickness of a rule is typically measured in points. (A point is approximately 1/72 inch.)</descrip></descripGrp><ntig><termGrp><term id="2085540">rule line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2106350">линија за правила</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11799_234773_1371711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows deletion of the files created during hibernation.</descrip></descripGrp><ntig><termGrp><term id="234773">Hibernation File Cleaner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371711">Отстранувач на хибернациска датотека</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1180_89323_1372295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To extend over and cover a part of something.</descrip></descripGrp><ntig><termGrp><term id="89323">overlap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372295">преклопува</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11800_118815_1644084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information about a computer that's derived from the System Information program.</descrip></descripGrp><ntig><termGrp><term id="118815">system info</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1644084">информации за системот</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11803_89506_2308059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A role that controls how permissions are set and can grant permissions to others.</descrip></descripGrp><ntig><termGrp><term id="89506">owner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2308059">сопственик</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11804_118547_441973"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of entities working together to accomplish a task.</descrip></descripGrp><ntig><termGrp><term id="118547">system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441973">систем</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11805_121970_1868017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The slide that stores information from the design template pertaining to styles on title slides, including placeholder sizes and positions, background design, and color schemes.</descrip></descripGrp><ntig><termGrp><term id="121970">title master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868017">матрица за наслов</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1181_144723_1868080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Margins of the left page are a mirror image of those of the right page. That is, the inside margins are the same width, and the outside margins are the same width.</descrip></descripGrp><ntig><termGrp><term id="144723">mirror margins</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868080">маргини на огледало</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11810_210490_442351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A networking standard that uses cables to provide network access. Ethernet is the most widely installed technology for connecting computers.</descrip></descripGrp><ntig><termGrp><term id="210490">Ethernet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442351">Етернет</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11820_125350_442011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character-encoding standard developed by the Unicode Consortium that represents almost all of the written languages of the world. The Unicode character repertoire has multiple representation forms, including UTF-8, UTF-16, and UTF-32. Most Windows interfaces use the UTF-16 form.</descrip></descripGrp><ntig><termGrp><term id="125350">Unicode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442011">Unicode</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11821_77656_1371712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of display that uses a liquid compound having a polar molecular structure, sandwiched between two transparent electrodes. When an electric field is applied, the molecules align with the field, forming a crystalline arrangement that polarizes the light passing through it. A polarized filter laminated over the electrodes blocks polarized light. In this way, a grid of electrodes can selectively "turn on" a cell, or a pixel, containing the liquid crystal material, turning it dark.</descrip></descripGrp><ntig><termGrp><term id="77656">LCD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371712">ЛЦД</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11821_77656_1371713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of display that uses a liquid compound having a polar molecular structure, sandwiched between two transparent electrodes. When an electric field is applied, the molecules align with the field, forming a crystalline arrangement that polarizes the light passing through it. A polarized filter laminated over the electrodes blocks polarized light. In this way, a grid of electrodes can selectively "turn on" a cell, or a pixel, containing the liquid crystal material, turning it dark.</descrip></descripGrp><ntig><termGrp><term id="77656">LCD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371713">екран со течни кристали</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11821_77658_1371712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of display that uses a liquid compound having a polar molecular structure, sandwiched between two transparent electrodes. When an electric field is applied, the molecules align with the field, forming a crystalline arrangement that polarizes the light passing through it. A polarized filter laminated over the electrodes blocks polarized light. In this way, a grid of electrodes can selectively "turn on" a cell, or a pixel, containing the liquid crystal material, turning it dark.</descrip></descripGrp><ntig><termGrp><term id="77658">liquid crystal display</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371712">ЛЦД</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11821_77658_1371713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of display that uses a liquid compound having a polar molecular structure, sandwiched between two transparent electrodes. When an electric field is applied, the molecules align with the field, forming a crystalline arrangement that polarizes the light passing through it. A polarized filter laminated over the electrodes blocks polarized light. In this way, a grid of electrodes can selectively "turn on" a cell, or a pixel, containing the liquid crystal material, turning it dark.</descrip></descripGrp><ntig><termGrp><term id="77658">liquid crystal display</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371713">екран со течни кристали</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1183_346957_443080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that cannot be found or recovered.</descrip></descripGrp><ntig><termGrp><term id="346957">lost data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="443080">изгубени податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11832_231956_442409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference to a range that spans two or more worksheets in a workbook.</descrip></descripGrp><ntig><termGrp><term id="231956">3-D reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442409">3-Д референца</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11847_23740_441326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location in a program at which execution is halted so that a programmer can examine the program's status, the contents of variables, and so on.</descrip></descripGrp><ntig><termGrp><term id="23740">breakpoint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441326">точка на прекин</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11859_1468785_2008604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique bank registration number that a bank uses to identify itself.</descrip></descripGrp><ntig><termGrp><term id="1468785">transit number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2008604">код на банка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11859_1468785_2008611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique bank registration number that a bank uses to identify itself.</descrip></descripGrp><ntig><termGrp><term id="1468785">transit number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2008611">идентификациски број на банка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11859_1993199_2008604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique bank registration number that a bank uses to identify itself.</descrip></descripGrp><ntig><termGrp><term id="1993199">bank transit number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2008604">код на банка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11859_1993199_2008611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique bank registration number that a bank uses to identify itself.</descrip></descripGrp><ntig><termGrp><term id="1993199">bank transit number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2008611">идентификациски број на банка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</t