et></termEntry><termEntry id="3566_134897_442072"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a disk to which content cannot be recorded.</descrip></descripGrp><ntig><termGrp><term id="134897">write-protected</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442072">заштитен од зaпишување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3567_320423_442968"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The × character.</descrip></descripGrp><ntig><termGrp><term id="320423">multiplication sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442968">знак за множење</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3567_320424_442968"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The × character.</descrip></descripGrp><ntig><termGrp><term id="320424">MULTIPLICATION SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442968">знак за множење</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3568_234787_442483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file backup feature that performs scheduled incremental backups of data to the target media. It also allows the user to restore an individual file or a group of files.</descrip></descripGrp><ntig><termGrp><term id="234787">Windows Backup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442483">Windows Backup</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35685_2052902_2067983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A licensing mode that enables Office 365 subscribers to access their account from different computers and that allows multiple users belonging to the same subscription to log in and use their account from the same computer.</descrip></descripGrp><ntig><termGrp><term id="2052902">shared computer activation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2067983">активација на споделен компјутер</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35685_2052902_2498553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A licensing mode that enables Office 365 subscribers to access their account from different computers and that allows multiple users belonging to the same subscription to log in and use their account from the same computer.</descrip></descripGrp><ntig><termGrp><term id="2052902">shared computer activation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2498553">АСК</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35685_2488791_2067983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A licensing mode that enables Office 365 subscribers to access their account from different computers and that allows multiple users belonging to the same subscription to log in and use their account from the same computer.</descrip></descripGrp><ntig><termGrp><term id="2488791">SCA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2067983">активација на споделен компјутер</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35685_2488791_2498553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A licensing mode that enables Office 365 subscribers to access their account from different computers and that allows multiple users belonging to the same subscription to log in and use their account from the same computer.</descrip></descripGrp><ntig><termGrp><term id="2488791">SCA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2498553">АСК</ter