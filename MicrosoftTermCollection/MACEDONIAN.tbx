ech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2662523">Неодамнешни промени</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47241_2660318_2662525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual effect applied to an SVG image or object in an SVG image.</descrip></descripGrp><ntig><termGrp><term id="2660318">SVG filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2662525">Филтер SVG</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47243_2660321_2662518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SVG filter that displaces the geometry of an image.</descrip></descripGrp><ntig><termGrp><term id="2660321">Displacement Map</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2662518">Разместена геометрија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47244_2660322_2662520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SVG filter that layers an offset copy of an image on top of another so that the images can be layered.</descrip></descripGrp><ntig><termGrp><term id="2660322">Offset</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2662520">Отстапување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47245_2660323_2662524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SVG filter that creates a bright spot of lighting in the image, creating a stark contrast between the lit and unlit parts.</descrip></descripGrp><ntig><termGrp><term id="2660323">Specular Light</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2662524">Светло во одраз</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47246_2660324_2662517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SGV filter that adds light that is reflected in many directions, which produces a more uniform lighting effect with a smooth transition from lit to unlit parts.</descrip></descripGrp><ntig><termGrp><term id="2660324">Diffuse Lighting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2662517">Распрснато светло</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termN