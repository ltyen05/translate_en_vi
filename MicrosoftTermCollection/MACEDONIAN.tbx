umber</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058629">Број за директно избирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33714_1814228_2058627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message asking to add or adding a Skype user to another user's contact list.</descrip></descripGrp><ntig><termGrp><term id="1814228">contact request</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058627">барање за контакт</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33716_1814230_2058634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A voice call with up to 25 participants in Skype.</descrip></descripGrp><ntig><termGrp><term id="1814230">group call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058634">групен повик</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33717_1814244_2058641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video call quality standard.</descrip></descripGrp><ntig><termGrp><term id="1814244">High Quality Video</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058641">Висококвалитетно видео</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33718_1814245_2058645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that appears when a user is signed in to his/her account but elects to appear as if they are offline to any contacts, but that also allows him/her to receive IMs.</descrip></descripGrp><ntig><termGrp><term id="1814245">Invisible</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058645">Невидлив</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3372_359704_1095916"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type used to hold date and time information.</descrip></descripGrp><ntig><termGrp><term id="359704">Date/Time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1095916">Датум/Време</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet