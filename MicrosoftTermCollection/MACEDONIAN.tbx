985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A networking feature that lets one computer directly place information into the memory of another computer.</descrip></descripGrp><ntig><termGrp><term id="1592185">RDMA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1643985">Далечински директен пристап до меморијата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31087_1624465_1643943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A storage pool that exposes physical disks that are currently available for inclusion in a storage pool on a particular storage subsystem.</descrip></descripGrp><ntig><termGrp><term id="1624465">primordial pool</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1643943">примарни ресурси</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31087_1707243_1643943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A storage pool that exposes physical disks that are currently available for inclusion in a storage pool on a particular storage subsystem.</descrip></descripGrp><ntig><termGrp><term id="1707243">available disks</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1643943">примар