1289183_1465521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view for delivering a presentation that displays it as the audience will see it.</descrip></descripGrp><ntig><termGrp><term id="1289183">Slide Show</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1465521">Приказ на слајдови</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26611_1303513_1465522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that is used to select a sheet within a workbook.</descrip></descripGrp><ntig><termGrp><term id="1303513">sheet tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1465522">картичка за лист</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26614_1303965_1868505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A note that displays the translation of a word in a document when the user moves the mouse pointer over the word.</descrip></descripGrp><ntig><termGrp><term id="1303965">Translation ScreenTip</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868505">ScreenTip со превод</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNou