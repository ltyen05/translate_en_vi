escripGrp><ntig><termGrp><term id="3114827">row-level security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3115231">безбедност на ниво на ред</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44774_2520527_2523513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A blog whose content is  smaller in both actual and aggregated file size and that allows users to exchange small elements of content such as short sentences, individual images, or video links.</descrip></descripGrp><ntig><termGrp><term id="2520527">microblog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2523513">микроблог</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44776_2520537_2523501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that contains an actionable message card.</descrip></descripGrp><ntig><termGrp><term id="2520537">actionable message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2523501">порака со понудени дејствија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44795_2520655_2522869"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of Microsoft Defender Advanced Threat Protection, which helps protect against malware that uses exploits to infect devices and spread.</descrip></descripGrp><ntig><termGrp><term id="2520655">Exploit Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2522869">Exploit Protection</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44799_2520749_2522894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer file format designed to store three-dimensional data that are described as a collection of polygons.</descrip></descripGrp><ntig><termGrp><term id="2520749">PLY</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2522894">PLY</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="448_93293_441855"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An input device used to control an on-screen cursor for such actions as "pressing" on-screen buttons in dialog boxes, choosing menu items, and selecting ranges of cells in spreadsheets or groups of words in a document.</descrip></descripGrp><ntig><termGrp><term id="93293">pointing device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441855">покажувач</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44800_2520756_2522892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An open file format created as a simple way to import and export geometry from different 3D applications.</descrip></descripGrp><ntig><termGrp><term id="2520756">OBJ</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2522892">OBJ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44803_2521100_2675149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The framework that consists of a web part and a page that provides full support for client-side SharePoint development, easy integration with SharePoint data, and support for open source tooling so that developers can use their preferred tools and technologies.</descrip></descripGrp><ntig><termGrp><term id="2521100">SharePoint Framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2675149">SPFx</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44803_2673786_2675149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The framework that consists of a web part and a page that provides full support for client-side SharePoint development, easy integration with SharePoint data, and support for open source tooling so that developers can use their preferred tools and technologies.</descrip></descripGrp><ntig><termGrp><term id="2673786">SPFx</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2675149">SPFx</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44804_2521102_2523510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of benefits provided to developers for creating software on a particular platform after they register for membership, and which may include access to software and information not available to people who have not registered.</descrip></descripGrp><ntig><termGrp><term id="2521102">developer program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2523510">програма за развивачи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44805_2521104_2523522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The developer program for Microsoft Office that provides members access to trainings and office hours with Microsoft engineers, plus chances to win tickets to events.</descrip></descripGrp><ntig><termGrp><term id="2521104">Microsoft Office Developer Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2523522">Програма за развивачи на Microsoft Office</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44809_2521577_2523982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel add-in that finds functions needed to transform and format data when the user gives it examples of the desired output.</descrip></descripGrp><ntig><termGrp><term id="2521577">Transform Data by Example</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2523982">Transform Data by Example</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4481_1133582_1993278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that allows users to connect remotely to a computer and access programs, files, and network resources as though they were sitting at the computer.</descrip></descripGrp><ntig><termGrp><term id="1133582">RD</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1993278">Оддалечена работна површина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4481_543804_1993278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that allows users to connect remotely to a computer and access programs, files, and network resources as though they were sitting at the computer.</descrip></descripGrp><ntig><termGrp><term id="543804">Remote Desktop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1993278">Оддалечена работна површина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44810_2521581_2528579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A membership where admittance is based on rules, making it easy for administrators to manage large groups.</descrip></descripGrp><ntig><termGrp><term id="2521581">dynamic membership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2528579">динамичко членство</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44811_2521582_2528578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group where membership is maintained by a set of rules created by an administrator.</descrip></descripGrp><ntig><termGrp><term id="2521582">dynamic group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2528578">динамичка група</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44814_2522595_2528580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sudden burst of light used to illuminate a dark scene so that features are visible in the captured image.</descrip></descripGrp><ntig><termGrp><term id="2522595">flash</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2528580">блиц</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44815_2522648_2528584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An element in a vector graphic.</descrip></descripGrp><ntig><termGrp><term id="2522648">vector object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2528584">објект на вектор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44816_2522672_2528577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office Lens mode that recognizes pictures of business cards so that when they are saved to OneNote, Office Lens will automatically recognize the card’s contact information and format it nicely into a OneNote notebook.</descrip></descripGrp><ntig><termGrp><term id="2522672">Business Card</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2528577">Бизнис-картичка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44818_2522794_2528581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pointing in the direction of the user of the device.</descrip></descripGrp><ntig><termGrp><term id="2522794">front facing</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2528581">напред</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44819_2522797_2528576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pointing away from the direction of the user of the device.</descrip></descripGrp><ntig><termGrp><term id="2522797">back facing</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2528576">обратно</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4482_151787_1371471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of the workspace that displays the sequence of your clips.</descrip></descripGrp><ntig><termGrp><term id="151787">storyboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371471">илустриран приказ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44820_2522800_2528583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of code incorporated into a project that was not written by the owners of the project.</descrip></descripGrp><ntig><termGrp><term id="2522800">third-party code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2528583">код на трето лице</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44821_2522807_2528582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform used by Microsoft products for payment integration.</descrip></descripGrp><ntig><termGrp><term id="2522807">Microsoft Seller Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2528582">Продажен центар на Microsoft</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44823_2524057_2578226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware accessory that allows you to take action in mixed reality. It tracks a precise position in space, allowing for fine-grained interaction with digital objects. When using a Windows Mixed Reality immersive headset, the motion controller is the primary way to take action.</descrip></descripGrp><ntig><termGrp><term id="2524057">motion controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2578226">контролер на движење</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44823_2524057_2578227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware accessory that allows you to take action in mixed reality. It tracks a precise position in space, allowing for fine-grained interaction with digital objects. When using a Windows Mixed Reality immersive headset, the motion controller is the primary way to take action.</descrip></descripGrp><ntig><termGrp><term id="2524057">motion controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2578227">Контролер на движење на Windows Mixed Reality</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44823_2531456_2578226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware accessory that allows you to take action in mixed reality. It tracks a precise position in space, allowing for fine-grained interaction with digital objects. When using a Windows Mixed Reality immersive headset, the motion controller is the primary way to take action.</descrip></descripGrp><ntig><termGrp><term id="2531456">Windows Mixed Reality motion controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2578226">контролер на движење</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44823_2531456_2578227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware accessory that allows you to take action in mixed reality. It tracks a precise position in space, allowing for fine-grained interaction with digital objects. When using a Windows Mixed Reality immersive headset, the motion controller is the primary way to take action.</descrip></descripGrp><ntig><termGrp><term id="2531456">Windows Mixed Reality motion controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2578227">Контролер на движење на Windows Mixed Reality</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44824_2524653_2526245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows 10 update announced at Build 2017 and being released in the Sept-Nov 2017 timeframe.</descrip></descripGrp><ntig><termGrp><term id="2524653">Windows 10 Fall Creators Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2526245">Windows 10 Fall Creators Update</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44825_2524668_2526206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Windows Defender Security Center that monitors your device and provides you with information and recommendations in a Health report to address common issues with your storage capacity, device drivers, battery life, or Windows Update.</descrip></descripGrp><ntig><termGrp><term id="2524668">Health Advisor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2526206">Советник за состојба на системот</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44826_2524671_2526205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Windows Defender Security Center that helps you refresh your device by reinstalling and updating Windows — for example, if your device has performance issues or you have too many unnecessary apps.</descrip></descripGrp><ntig><termGrp><term id="2524671">Fresh Start</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2526205">Нов почеток</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44827_2524676_2526218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft Remote Desktop app.</descrip></descripGrp><ntig><termGrp><term id="2524676">Microsoft Remote Desktop Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2526218">Преглед на оддалечената работна површина на Microsoft</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44827_2524676_2610928"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft Remote Desktop app.</descrip></descripGrp><ntig><termGrp><term id="2524676">Microsoft Remote Desktop Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2610928">Преглед на оддалечената работна површина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44827_2609623_2526218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft Remote Desktop app.</descrip></descripGrp><ntig><termGrp><term id="2609623">Remote Desktop Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2526218">Преглед на оддалечената работна површина на Microsoft</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44827_2609623_2610928"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft Remote Desktop app.</descrip></descripGrp><ntig><termGrp><term id="2609623">Remote Desktop Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2610928">Преглед на оддалечената работна површина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44828_2524681_2526200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The period of time when users are required to schedule a restart.</descrip></descripGrp><ntig><termGrp><term id="2524681">Engaged restart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2526200">Ангажирано престартување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44829_2524692_2526246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system service that enables spatial perception, spatial input, and holographic rendering.</descrip></descripGrp><ntig><termGrp><term id="2524692">Windows Perception Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2526246">Услуга за перцепција на Windows</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4483_55751_441592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A structured document or template with spaces reserved for entering information and often containing special coding (e.g. to trigger data processing).</descrip></descripGrp><ntig><termGrp><term id="55751">form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441592">образец</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44832_2524734_2526280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft interactive livestreaming platform for gaming communities.</descrip></descripGrp><ntig><termGrp><term id="2524734">Mixer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2526280">Mixer</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44833_2524736_2526284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that brings together friends, games, and accomplishments across Xbox One and Windows 10 devices. It allows users to stay connected to the Xbox Live community, see what their friends are playing, share game clips and screenshots, and view achievements across devices.</descrip></descripGrp><ntig><termGrp><term id="2524736">Xbox app</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2526284">апликација Xbox</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4484_252109_2623392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authorized simulated attack on a computer system that evaluates the security of a system by identifying weaknesses and strengths.</descrip></descripGrp><ntig><termGrp><term id="252109">penetration test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2623392">тест за пенетрација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4484_252109_2748657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authorized simulated attack on a computer system that evaluates the security of a system by identifying weaknesses and strengths.</descrip></descripGrp><ntig><termGrp><term id="252109">penetration test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2748657">тест за продор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4484_2621910_2623392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authorized simulated attack on a computer system that evaluates the security of a system by identifying weaknesses and strengths.</descrip></descripGrp><ntig><termGrp><term id="2621910">pen test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2623392">тест за пенетрација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4484_2621910_2748657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authorized simulated attack on a computer system that evaluates the security of a system by identifying weaknesses and strengths.</descrip></descripGrp><ntig><termGrp><term id="2621910">pen test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2748657">тест за продор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44842_2524849_2530093"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presentation of visual elements in an image, especially the placement of the subject in relation to other objects.</descrip></descripGrp><ntig><termGrp><term id="2524849">frame</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2530093">рамка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44843_2524926_2526222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays mixed reality experiences. Used inclusively to denote both Microsoft HoloLens and OEM devices, whether they blend virtual content within the physical world (holographic headsets), or display virtual content with a degree (big or small) of environmental awareness (immersive headsets)​. Plus, these headsets can either be self-contained (like Microsoft HoloLens - the whole computing power is contained into the headset) or PC-connected (the computing power comes from the PC and the headset cannot work without that associated PC).</descrip></descripGrp><ntig><termGrp><term id="2524926">mixed reality headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2526222">слушалки за мешана реалност</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44843_2524926_2578225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays mixed reality experiences. Used inclusively to denote both Microsoft HoloLens and OEM devices, whether they blend virtual content within the physical world (holographic headsets), or display virtual content with a degree (big or small) of environmental awareness (immersive headsets)​. Plus, these headsets can either be self-contained (like Microsoft HoloLens - the whole computing power is contained into the headset) or PC-connected (the computing power comes from the PC and the headset cannot work without that associated PC).</descrip></descripGrp><ntig><termGrp><term id="2524926">mixed reality headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2578225">слушалки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44843_2526431_2526222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays mixed reality experiences. Used inclusively to denote both Microsoft HoloLens and OEM devices, whether they blend virtual content within the physical world (holographic headsets), or display virtual content with a degree (big or small) of environmental awareness (immersive headsets)​. Plus, these headsets can either be self-contained (like Microsoft HoloLens - the whole computing power is contained into the headset) or PC-connected (the computing power comes from the PC and the headset cannot work without that associated PC).</descrip></descripGrp><ntig><termGrp><term id="2526431">headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2526222">слушалки за мешана реалност</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44843_2526431_2578225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays mixed reality experiences. Used inclusively to denote both Microsoft HoloLens and OEM devices, whether they blend virtual content within the physical world (holographic headsets), or display virtual content with a degree (big or small) of environmental awareness (immersive headsets)​. Plus, these headsets can either be self-contained (like Microsoft HoloLens - the whole computing power is contained into the headset) or PC-connected (the computing power comes from the PC and the headset cannot work without that associated PC).</descrip></descripGrp><ntig><termGrp><term id="2526431">headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2578225">слушалки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44844_2524930_2526208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays virtual content only and with a degree (big or small) of environmental awareness. This is a subset of "mixed reality headset."​ This is to be looked at in contrast with "holographic headsets".</descrip></descripGrp><ntig><termGrp><term id="2524930">immersive headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2526208">сеопфатни слушалки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44845_2524937_2526243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of moving from a lower version of a system to a higher version. A configuration shift where the user becomes able to change default settings which were locked before the shift.</descrip></descripGrp><ntig><termGrp><term id="2524937">switch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2526243">промена</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44846_2524939_2526244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move from a lower version of a system to a higher one, or to shift system configuration in order to change default settings locked before the shift.</descrip></descripGrp><ntig><termGrp><term id="2524939">switch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2526244">промени</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44847_2525542_2687707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The a web-based application that provides management, reporting, and capabilities for Kaizala, as well as the ability to integrate internal and external applications with Kaizala using REST APIs.</descrip></descripGrp><ntig><termGrp><term id="2525542">Kaizala Management Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2687707">Портал за управување на Kaizala</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44861_2528507_2528845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To arrange visual elements in an image, especially the subject.</descrip></descripGrp><ntig><termGrp><term id="2528507">frame</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2528845">врами</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44862_2528515_2687708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The paid version of Kaizala that includes access to the Kaizala Management Portal, gives IT the rights to manage users through group management, and data analytics.</descrip></descripGrp><ntig><termGrp><term id="2528515">Kaizala Pro</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2687708">Kaizala Pro</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44863_2529677_2530278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft marketing campaign that emphasizes seamless use of Microsoft applications across all devices because users have just one account no matter what device they are using.</descrip></descripGrp><ntig><termGrp><term id="2529677">One Microsoft</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2530278">One Microsoft</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44869_2530865_2539651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A state of an application when no documents or content is open.</descrip></descripGrp><ntig><termGrp><term id="2530865">zero state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2539651">нулта состојба</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOf