p></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371475">податок изразен во бауди</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4660_20603_1371475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The speed at which a modem can transmit data, measured by the number of events, or signal changes, that occur in one second.</descrip></descripGrp><ntig><termGrp><term id="20603">baud rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371475">податок изразен во бауди</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46600_2621935_2623393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test that reveals flaws in the security mechanisms of a computer systems, showing if they protect data and maintain functionality as intended.</descrip></descripGrp><ntig><termGrp><term id="2621935">security test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2623393">безбедносен тест</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46601_2621936_2624498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 portal that contains Microsoft 365 security and compliance features.</descrip></descripGrp><ntig><termGrp><term id="2621936">Security &amp; Compliance Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2624498">Центар за безбедност и усогласеност</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46602_2621937_2624497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in the Microsoft 365 admin center where admins can manage desktop related workloads, policy controls, user groups, software updates, device enrolment, as well as where they can update analytics.</descrip></descripGrp><ntig><termGrp><term id="2621937">Device Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2624497">Управување со уреди</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46602_2621937_2692847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in the Microsoft 365 admin center where admins can manage desktop related workloads, policy controls, user groups, software updates, device enrolment, as well as where they can update analytics.</descrip></descripGrp><ntig><termGrp><term id="2621937">Device Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2692847">Управување со уреди на Microsoft 365</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46602_2690753_2624497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in the Microsoft 365 admin center where admins can manage desktop related workloads, policy controls, user groups, software updates, device enrolment, as well as where they can update analytics.</descrip></descripGrp><ntig><termGrp><term id="2690753">Microsoft 365 device management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2624497">Управување со уреди</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46602_2690753_2692847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in the Microsoft 365 admin center where admins can manage desktop related workloads, policy controls, user groups, software updates, device enrolment, as well as where they can update analytics.</descrip></descripGrp><ntig><termGrp><term id="2690753">Microsoft 365 device management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2692847">Управување со уреди на Microsoft 365</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46603_2621938_2624496"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Device Management dashboard that provides admins with aggregated device insights, which enables them to identify health patterns related to performance degradation, policy conflicts, login choices etc., so that they can assist in support and helpdesk scenarios.</descrip></descripGrp><ntig><termGrp><term id="2621938">Device Health</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2624496">Состојба на уредите</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46604_2685859_2689443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Device Management portal that provides admins with a guided workflow experience to help them adopt a faster update cadence by reducing the number of tests necessary to validate apps, drivers, add-ins, and macros.</descrip></descripGrp><ntig><termGrp><term id="2685859">Desktop Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2689443">Аналитика на работна површина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46617_2623853_2626104"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move an email into a user's inbox from quarantine.</descrip></descripGrp><ntig><termGrp><term id="2623853">release</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2626104">отстапува</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46618_2623854_2626103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cyber attack where an intruder engages with the targeted system to gather information about vulnerabilities or steal login information.</descrip></descripGrp><ntig><termGrp><term id="2623854">reconnaissance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2626103">извидување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46620_2623856_2624501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack where an attacker attempts to log in into all accounts across a specific domain using only one password, thus avoiding being locked out of any one account.</descrip></descripGrp><ntig><termGrp><term id="2623856">password spray attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2624501">напад со распрснување лозинка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNo