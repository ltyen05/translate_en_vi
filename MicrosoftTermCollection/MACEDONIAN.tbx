pe="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3007319">распоред со 12 копчиња</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52938_3007292_3007550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard layout for Japanese characters that places keys in a grid with 5 rows, making it easier for Japanese speakers to find a specific Hiragana character.</descrip></descripGrp><ntig><termGrp><term id="3007292">50-on layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3007550">распоред со 50 копчиња</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52939_3007385_3010893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To capture text, graphics, and any associated annotations by using Snipping Tool.</descrip></descripGrp><ntig><termGrp><term id="3007385">snip</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3010893">отсечи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52942_3007396_3010905"><langSet xml:lang="en-US"><descripGrp><des