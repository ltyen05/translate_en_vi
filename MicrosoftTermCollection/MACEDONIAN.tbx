cache</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943396">Кеш на веб-дел</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29305_1507086_1523190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An element in a Web Parts page that defines a provider-consumer data relationship between two Web Parts. When a Web Parts page is rendered, data provided by one Web Part can affect how and what is rendered by the other Web Part.</descrip></descripGrp><ntig><termGrp><term id="1507086">Web Part connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523190">врска помеѓу веб-делови</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29306_1507087_1943397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A GUID that identifies a Web Part.</descrip></descripGrp><ntig><termGrp><term id="1507087">Web Part identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943397">Идентификатор за веб-дел</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29307_1507088_1523191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A configurable characteristic of a Web Part that determines the behavior of the Web Part.</descrip></descripGrp><ntig><termGrp><term id="1507088">Web Part property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523191">Својство на веб-делот</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29308_1507089_1943398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique 16-byte value that is assigned to each Web Part type.</descrip></descripGrp><ntig><termGrp><term id="1507089">Web Part type identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943398">Идентификатор за тип на веб-дел</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29309_1507090_1943399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that identifies a Web Part zone on a Web Parts page.</descrip></descripGrp><ntig><termGrp><term id="1507090">Web Part zone identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943399">Идентификатор за зона на веб-дел</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSp