а со поддршка во облак</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49804_2816520_2820510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected experience that is optional, more precisely, it is not covered by the organization's license with Microsoft, but is instead licensed directly to the user.</descrip></descripGrp><ntig><termGrp><term id="2816520">optional connected experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2820510">поврзано искуство по избор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49805_2816521_2820504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Measures of service quality of a network as seen by the customer.</descrip></descripGrp><ntig><termGrp><term id="2816521">network performance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2820504">изведба на мрежа</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49806_2816522_2820402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft Teams that assesses the Office 365 tenant environment and identifies the most common co