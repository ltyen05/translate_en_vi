langSet></termEntry><termEntry id="49414_2800990_2807617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Defender ATP capability designed to identify, assess, and remediate endpoint weaknesses.</descrip></descripGrp><ntig><termGrp><term id="2800990">threat and vulnerability management</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2807617">Управување со закани и ранливи места</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49414_2874473_2807617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Defender ATP capability designed to identify, assess, and remediate endpoint weaknesses.</descrip></descripGrp><ntig><termGrp><term id="2874473">vulnerability management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2807617">Управување со закани и ранливи места</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49415_2800994_2807605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Defender ATP capability that monitors behaviors, applies machine learning, and security analytics to spot attacks; it provides SecOps rich tools to investigate and respond to threats on endpoints.</descrip></descripGrp><ntig><termGrp><term id="2800994">EDR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2807605">откривање и одговор на крајни точки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49415_2806615_2807605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Defender ATP capability that monitors behaviors, applies machine learning, and security analytics to spot attacks; it provides SecOps rich tools to investigate and respond to threats on endpoints.</descrip></descripGrp><ntig><termGrp><term id="2806615">endpoint detection and response</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2807605">откривање и одговор на крајни точки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4947_345313_443062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make easier; to eliminate unnecessary steps.</descrip></descripGrp><ntig><termGrp><term id="345313">streamline</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="443062">рационализирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49471_2801993_2803890"><langSet xml:la