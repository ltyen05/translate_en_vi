ech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2775359">насочи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20084_694548_1832251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A current attempt by a second party to establish communication with a user.</descrip></descripGrp><ntig><termGrp><term id="694548">incoming call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832251">дојдовен повик</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20087_694562_1832248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To take action to not answer a call. The call goes to voice mail if that service is available.</descrip></descripGrp><ntig><termGrp><term id="694562">ignore</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832248">игнорира</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20091_694566_1832169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person who is calling another person or place.</descrip></descripGrp><ntig><termGrp><term id="694566">caller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832169">повикувач</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20093_694568_1982623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To accept an incoming telephone call.</descrip></descripGrp><ntig><termGrp><term id="694568">answer</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1982623">одговори</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20099_694715_1372523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To execute a program.</descrip></descripGrp><ntig><termGrp><term id="694715">run</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372523">изврши</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20104_694766_1977306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A picture made by combining a series of photos into one large picture to provide a complete view of an area or location that cannot fit in a single shot.</descrip></descripGrp><ntig><termGrp><term id="694766">panoramic photo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1977306">панорама</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20104_694768_1977306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A picture made by combining a series of photos into one large picture to provide a complete view of an area or location that cannot fit in a single shot.</descrip></descripGrp><ntig><termGrp><term id="694768">panorama</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1977306">панорама</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2012_357288_443114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical control used to display text.</descrip></descripGrp><ntig><termGrp><term id="357288">label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="443114">етикета</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20125_700660_2305832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Meeting an organization's various obligations, which may arise from laws, regulations, rules, and many other legal instruments, such as court judgments, litigation, and even contracts. Specific and important examples of these obligations include the Sarbanes-Oxley Act (SOX) and the California Law on Notice of Security Breach, formerly known as SB-1386. These regulatory obligations may be created by many sources, such as national and local governments and from industry-specific oversight groups, such as the Payment Card Industry Data Security Standards.</descrip></descripGrp><ntig><termGrp><term id="700660">compliance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305832">усогласеност</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20126_700661_2305833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Person responsible for ensuring that an organization complies with the various regulations and standards that are imposed by government and other regulatory bodies.</descrip></descripGrp><ntig><termGrp><term id="700661">compliance officer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305833">лице одговорно за усогласеноста</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20127_700662_1372524"><l