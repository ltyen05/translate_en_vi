d="33568_1802884_1832180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A description for music or videos stored in the cloud that users may access from their phone. Used for Xbox Music and any other potential cloud-based media services.</descrip></descripGrp><ntig><termGrp><term id="1802884">cloud collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832180">колекција во облак</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33569_1802886_1832190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of data the user can download/upload through the carrier's network each month without being billed additional charges.</descrip></descripGrp><ntig><termGrp><term id="1802886">data limit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832190">лимит на податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33570_2164314_2181078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-loaded app that allows users to better monitor and manage their data usage on their phone or PC. It can notify users when they are close to their cellular data limit and delay some data-intensive tasks until the phone or PC is connected to Wi-Fi.</descrip></descripGrp><ntig><termGrp><term id="2164314">Data usage</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2181078">Употреба на податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33571_1802888_1832199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button label to note that the user does not like a suggestion in Local Scout.</descrip></descripGrp><ntig><termGrp><term id="1802888">dislike</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832199">не ми се допаѓа</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33576_1803504_1832213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default room name in the Rooms feature of the People Hub. Based on the concept of the "family room" in many homes, in which family and guests gather for group activities.</descrip></descripGrp><ntig><termGrp><term id="1803504">Family Room</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832213">Семејна соба</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33577_1803505_1832348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A place on the phone where families (or other close-knit groups) can stay in touch. Rooms take the form of a panorama that lives in the People Hub. The panorama includes a family chat card, a shared calendar, a shared photo album, and a shared notebook. Users ask others to join their Room via an SMS invite.</descrip></descripGrp><ntig><termGrp><term id="1803505">room</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832348">соба</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33578_1803510_1832214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An NFC-enabled card (like a credit card) that users can use for payments or other transactions even when the phone is locked.</descrip></descripGrp><ntig><termGrp><term id="1803510">fast card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832214">брза исплата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33579_1803511_1832222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flash mode used to set off the flash automatically according to the ambient light conditions.</descrip></descripGrp><ntig><termGrp><term id="1803511">flash auto</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832222">блиц-автоматски</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33580_1803512_1832223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flash mode when the phone's built-in camera flash is set to off.</descrip></descripGrp><ntig><termGrp><term id="1803512">flash off</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832223">блиц-исклучен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33581_1803513_1832224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flash mode when the phone's built-in camera flash is set to on.</descrip></descripGrp><ntig><termGrp><term id="1803513">flash on</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832224">блиц-вклучен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33582_1803514_1832228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera on the front of an electronic device (such as a smartphone), which faces the user. This allows the user to video chat with another person also using a front-facing device. It may also be used to take videos and pictures.</descrip></descripGrp><ntig><termGrp><term id="1803514">front</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832228">предна</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33583_1803517_2058608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype To Go number that is used like a calling card, that allows a user to enter a number manually and dial any phone number.</descrip></descripGrp><ntig><termGrp><term id="1803517">Access number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058608">Број за пристап</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33584_1803518_1832233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text message thread between a group of people (usually more than 2). It allows you to keep all the replies from people in one thread, so that you can see the whole conversation.</descrip></descripGrp><ntig><termGrp><term id="1803518">group text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832233">Групна СМС/MMS порака</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33585_1803519_1832237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that provides easy access to Help and how-to content as well as helpful tips for users.</descrip></descripGrp><ntig><termGrp><term id="1803519">Help+Tips</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832237">Помош+Совети</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33586_1803521_2058682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product that enables a user to call mobile phones and landlines from a mobile phone or landline via Skype.</descrip></descripGrp><ntig><termGrp><term id="1803521">Skype To Go number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058682">Број Skype To Go</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33587_1803522_1832253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An APN (Access Point Name) that determines the cellular data networks to which a phone can connect. It includes information about what kind of connection, security, and type of IP address the phone should use for the Internet connection.</descrip></descripGrp><ntig><termGrp><term id="1803522">Internet APN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832253">Пристапна точка за интернет</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33588_1803523_1832282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The APN (Access Point Name) a phone can use to send MMS messages (text messages with multimedia files attached).</descrip></descripGrp><ntig><termGrp><term id="1803523">MMS APN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832282">пристапна точка за MMS</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33589_1803524_1832255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The company or organization that issued the user the card they're adding to their wallet. For example, an issuer could be a bank.</descrip></descripGrp><ntig><termGrp><term id="1803524">issuer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832255">издавач</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33591_1803526_1832256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The title of the screen prompting the user to sign in to his existing Microsoft account or to create a Microsoft account. By using the Microsoft account, Windows Phone will keep the user's important information and belongings synchronized in one place, helping keep the user's life organized and harmonious.</descrip></descripGrp><ntig><termGrp><term id="1803526">Keep your life in sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832256">Синхронизирајте си го животот</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33593_1803746_1832259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that helps parents provide their children with controlled access to their phones. In Kid's Corner, kids can only use the apps, games, and other content that parents select.</descrip></descripGrp><ntig><termGrp><term id="1803746">Kid's Corner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832259">Детско катче</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33594_1803747_1832260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">List of the top players in a game or other competition on Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="1803747">leaderboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832260">табла на водачи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33594_3144583_1832260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">List of the top players in a game or other competition on Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="3144583">Xbox leaderboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832260">табла на водачи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33595_1803748_1832261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A first or third-party application that works with the Windows Phone camera to offer additional features and functionality for users taking and editing pictures.</descrip></descripGrp><ntig><termGrp><term id="1803748">lens</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832261">фото-алатки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33596_1803750_1832275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A relationship of being a member of an organization, such as a gym or club.</descrip></descripGrp><ntig><termGrp><term id="1803750">membership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832275">членство</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33597_1803751_1832277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business or organization that has provided a coupon that can be used at their store.</descrip></descripGrp><ntig><termGrp><term id="1803751">merchant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832277">трговец</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33598_1803752_1832283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server that stores MMS message content sent from phones on a mobile operator's network.</descrip></descripGrp><ntig><termGrp><term id="1803752">MMSC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832283">MMSC</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeec