rm><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442915">десна аглеста заграда</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14905_318751_442914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &gt; character.</descrip></descripGrp><ntig><termGrp><term id="318751">GREATER-THAN SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442914">знакот поголемо од</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14905_318751_442915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &gt; character.</descrip></descripGrp><ntig><termGrp><term id="318751">GREATER-THAN SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442915">десна аглеста заграда</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14906_397175_2305600"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database for storing mailboxes in Exchange Server. The mailbox database manages the data in mailboxes, tracks deleted messages and mailbox sizes, and assists in message transfers. A mailbox database is stored as an Exchange database (.edb) file.</descrip></descripGrp><ntig><termGrp><term id="397175">mailbox database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305600">база со податоци на поштенско сандаче</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14908_2254367_2058689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agreement in which a customer prepays for periodic or regular services.</descrip></descripGrp><ntig><termGrp><term id="2254367">in-app subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058689">претплата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14908_2254367_2256963"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agreement in which a customer prepays for periodic or regular services.</descrip></descripGrp><ntig><termGrp><term id="2254367">in-app subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2256963">претплата во апликација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14908_233136_2058689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agreement in which a customer prepays for periodic or regular services.</descrip></descripGrp><ntig><termGrp><term id="233136">subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058689">претплата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14908_233136_2256963"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agreement in which a customer prepays for periodic or regular services.</descrip></descripGrp><ntig><termGrp><term id="233136">subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2256963">претплата во апликација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14913_184047_1095992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An approach to restricting permission for a given document, workbook, presentation, or message. The policy defines which Office features are available, which information can be accessed, and what level of editing is allowed.</descrip></descripGrp><ntig><termGrp><term id="184047">permission policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1095992">правила за дозволи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14915_35293_441421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The , character.</descrip></descripGrp><ntig><termGrp><term id="35293">comma</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441421">запирка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14916_293189_1371811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The title of instructions for setting up and preparing the device for first use.</descrip></descripGrp><ntig><termGrp><term id="293189">Getting Started</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371811">Воведување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14922_397187_1868224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snapshot of information from an address book that has been downloaded so that an Outlook user can access it while disconnected from the server. It contains the properties of a user, such as email addresses, that Outlook requires to send an email message and display information about the sender.</descrip></descripGrp><ntig><termGrp><term id="397187">offline address book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868224">адресар без интернет</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14922_397187_2305643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snapshot of information from an address book that has been downloaded so that an Outlook user can access it while disconnected from the server. It contains the properties of a user, such as email addresses, that Outlook requires to send an email message and display information about the sender.</descrip></descripGrp><ntig><termGrp><term id="397187">offline address book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305643">OAB</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14922_397188_1868224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snapshot of information from an address book that has been downloaded so that an Outlook user can access it while disconnected from the server. It contains the properties of a user, such as email addresses, that Outlook requires to send an email message and display information about the sender.</descrip></descripGrp><ntig><termGrp><term id="397188">OAB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868224">адресар без интернет</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14922_397188_2305643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snapshot of information from an address book that has been downloaded so that an Outlook user can access it while disconnected from the server. It contains the properties of a user, such as email addresses, that Outlook requires to send an email message and display information about the sender.</descrip></descripGrp><ntig><termGrp><term id="397188">OAB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305643">OAB</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14924_149902_1372459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that retrieves data stored on your intranet or the Internet.</descrip></descripGrp><ntig><termGrp><term id="149902">Web query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372459">Веб-прашалник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14931_397193_2305644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The method by which the offline address book (OAB) can be accessed by users when they are working remotely or over a dial-up connection. To distribute the OAB, administrators can use Web-based distribution, public folder distribution, or both. Public folder distribution is required for Outlook 2003 or earlier clients.</descrip></descripGrp><ntig><termGrp><term id="397193">offline address book distribution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305644">Дистрибуција на OAB</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14931_397193_2305648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The method by which the offline address book (OAB) can be accessed by users when they are working remotely or over a dial-up connection. To distribute the OAB, administrators can use Web-based distribution, public folder distribution, or both. Public folder distribution is required for Outlook 2003 or earlier clients.</descrip></descripGrp><ntig><termGrp><term id="397193">offline address book distribution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305648">дистрибуција на локален именик</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14931_397194_2305644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The method by which the offline address book (OAB) can be accessed by users when they are working remotely or over a dial-up connection. To distribute the OAB, administrators can use Web-based distribution, public folder distribution, or both. Public folder distribution is required for Outlook 2003 or earlier clients.</descrip></descripGrp><ntig><termGrp><term id="397194">OAB distribution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305644">Дистрибуција на OAB</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14931_397194_2305648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The method by which the offline address book (OAB) can be accessed by users when they are working remotely or over a dial-up connection. To distribute the OAB, administrators can use Web-based distribution, public folder distribution, or both. Public folder distribution is required for Outlook 2003 or earlier clients.</descrip></descripGrp><ntig><termGrp><term id="397194">OAB distribution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305648">дистрибуција на локален именик</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14938_18094_1859326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined or free-form figure — such as a line, oval, cube, flowchart symbol, banner, or free-form scribble — that the user can insert into a document and then customize.</descrip></descripGrp><ntig><termGrp><term id="18094">AutoShape</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1859326">Автоматска форма</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14943_134986_1868026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The position of a point with reference to the x-axis, defined in conjunction with the y- and z-coordinates.</descrip></descripGrp><ntig><termGrp><term id="134986">x-coordinate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868026">координата х</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14944_262698_442619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computer graphics, a display method in which a viewing window on the screen scans horizontally or vertically, like a camera, to bring offscreen extensions of the current image smoothly into view.</descrip></descripGrp><ntig><termGrp><term id="262698">pan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442619">панорамски приказ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14944_779138_442619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computer graphics, a display method in which a viewing window on the screen scans horizontally or vertically, like a camera, to bring offscreen extensions of the current image smoothly into view.</descrip></descripGrp><ntig><termGrp><term id="779138">panning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442619">панорамски приказ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14948_245218_442550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common point of entry for spyware guarded by an agent. Examples of checkpoints include Startup Folder, dial up connections, Wi-Fi connections, Internet Safe Sites, Winsock Layered Service Providers, Windows Messenger Service, and SPAM Zombie prevention.</descrip></descripGrp><ntig><termGrp><term id="245218">checkpoint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442550">контролен пункт</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14953_38284_441444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric or string value that is not calculated and, therefore, does not change.</descrip></descripGrp><ntig><termGrp><term id="38284">constant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441444">константа</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14954_78795_441750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enlarge a window to its largest size by double-clicking the title bar, clicking the Maximize button (at the right of the title bar), or by pressing ALT+SPACEBAR and then pressing X.</descrip></descripGrp><ntig><termGrp><term id="78795">maximize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441750">максимизирај</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14962_397223_2305422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined security group that provides specific permissions to allow role members to manage Exchange configuration data. Exchange 2007 provides the following four administrator roles: Exchange Recipient Administrators, Exchange Organization Administrators, Exchange Server Administrators, and Exchange View-Only Administrators.</descrip></descripGrp><ntig><termGrp><term id="397223">administrator role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305422">улога на администратор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14963_3046991_3048379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used to control a video game. For example, a joystick, mouse, or gamepad.</descrip></descripGrp><ntig><termGrp><term id="3046991">controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3048379">контролер</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14963_57667_3048379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used to control a video game. For example, a joystick, mouse, or gamepad.</descrip></descripGrp><ntig><termGrp><term id="57667">game controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3048379">контролер</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14964_265316_1372460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an operator that can hold an arbitrary number of arguments, or to a function that can hold an arbitrary number of operators.</descrip></descripGrp><ntig><termGrp><term id="265316">n-ary</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372460">произволен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14964_265317_1372460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an operator that can hold an arbitrary number of arguments, or to a function that can hold an arbitrary number of operators.</descrip></descripGrp><ntig><termGrp><term id="265317">nary</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372460">произволен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14967_1057522_1372461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Capable of being retrieved (read), printed or copied but not changed (written) or saved.</descrip></descripGrp><ntig><termGrp><term id="1057522">RO</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372461">само за читање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14967_98978_1372461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Capable of being retrieved (read), printed or copied but not changed (written) or saved.</descrip></descripGrp><ntig><termGrp><term id="98978">read-only</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372461">само за читање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14968_592384_1989359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An apartment that consists of one or more threads.</descrip></descripGrp><ntig><termGrp><term id="592384">MTA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1989359">МТА</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14968_592384_1989896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An apartment that consists of one or more threads.</descrip></descripGrp><ntig><termGrp><term id="592384">MTA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1989896">апартман со повеќе нишки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14968_82756_1989359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An apartment that consists of one or more threads.</descrip></descripGrp><ntig><termGrp><term id="82756">multithreaded apartment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1989359">МТА</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14968_82756_1989896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An apartment that consists of one or more threads.</descrip></descripGrp><ntig><termGrp><term id="82756">multithreaded apartment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1989896">апартман со повеќе нишки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14970_237382_1868204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Functions used to extract and display OLAP data (sets and values).</descrip></descripGrp><ntig><termGrp><term id="237382">Excel Cube Functions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868204">Функции Cube на Excel</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14974_84430_441787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On a local area network (LAN), a drive that other computers on the network can connect to. A network drive allows people to access shared files and folders.</descrip></descripGrp><ntig><termGrp><term id="84430">network drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441787">мрежен диск</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14984_141508_1868057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type consisting of a sequence of named values given in a particular order.</descrip></descripGrp><ntig><termGrp><term id="141508">enumerated data type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868057">нумериран тип на податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14984_2676681_1868057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type consisting of a sequence of named values given in a particular order.</descrip></descripGrp><ntig><termGrp><term id="2676681">enum type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868057">нумериран тип на податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14990_10614_441244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An on-screen box, in a graphical user interface, that is used to deliver a message or warning.</descrip></descripGrp><ntig><termGrp><term id="10614">alert box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441244">поле за предупредување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14992_129955_2638451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A simulated 3-D environment that a user can experience and manipulate as if it were physical. The user sees the environment on display screens, possibly mounted in a special pair of goggles. Special input devices, such as gloves or suits fitted with motion sensors, detect the user's actions.</descrip></descripGrp><ntig><termGrp><term id="129955">virtual reality</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2638451">VR</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14992_685431_2638451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A simulated 3-D environment that a user can experience and manipulate as if it were physical. The user sees the environment on display screens, possibly mounted in a special pair of goggles. Special input devices, such as gloves or suits fitted with motion sensors, detect the user's actions.</descrip></descripGrp><ntig><termGrp><term id="685431">VR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2638451">VR</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14999_397227_1465535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hidden section of an email message. From the time a message is first created, information about it is added to the message header, including technical details, such as who created the message and the software used to compose it.</descrip></descripGrp><ntig><termGrp><term id="397227">P2 header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1465535">заглавие на пораката</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14999_397227_1868225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hidden section of an email message. From the time a message is first created, information about it is added to the message header, including technical details, such as who created the message and the software used to compose it.</descrip></descripGrp><ntig><termGrp><term id="397227">P2 header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868225">Заглавие P2</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14999_80016_1465535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hidden section of an email message. From the time a message is first created, information about it is added to the message header, including technical details, such as who created the message and the software used to compose it.</descrip></descripGrp><ntig><termGrp><term id="80016">message header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1465535">заглавие на пораката</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14999_80016_1868225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hidden section of an email message. From the time a message is first created, information about it is added to the message header, including technical details, such as who created the message and the software used to compose it.</descrip></descripGrp><ntig><termGrp><term id="80016">message header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868225">Заглавие P2</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15_2161198_2305614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical grouping of managed folders. When a managed folder mailbox policy is applied to a user’s mailbox, all the managed folders that are linked to the policy are deployed in a single operation, thereby making the deployment of messaging records management (MRM) easier.</descrip></descripGrp><ntig><termGrp><term id="2161198">UM mailbox policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305614">политика на поштенско сандаче со управувани папки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15_397203_2305614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical grouping of managed folders. When a managed folder mailbox policy is applied to a user’s mailbox, all the managed folders that are linked to the policy are deployed in a single operation, thereby making the deployment of messaging records management (MRM) easier.</descrip></descripGrp><ntig><termGrp><term id="397203">managed folder mailbox policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305614">политика на поштенско сандаче со управувани папки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1500_7883_441225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an entity such as the device, program, file, record or portion of the screen that is currently operational or subject to command operations.</descrip></descripGrp><ntig><termGrp><term id="7883">active</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441225">активен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15015_184144_442318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The title for a dialog that specifies how a signature line should be signed, including instructions for signers.</descrip></descripGrp><ntig><termGrp><term id="184144">Signature Setup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442318">Signature Setup</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15022_319430_442963"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having a frequency in the electromagnetic spectrum in the range just below that of red light.</descrip></descripGrp><ntig><termGrp><term id="319430">infrared</term><termNote type="partOfSpeech">Adjectiv