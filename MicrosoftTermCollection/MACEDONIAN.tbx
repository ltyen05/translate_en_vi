Grp><term id="2312659">New and rising games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2161109">Нови и во тренд игри</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33606_1803761_1832296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An external device that interacts with an NFC-enabled phone. These devices exchange data, such as contact details or secure payment information, with NFC-enabled phones through contactless communication.</descrip></descripGrp><ntig><termGrp><term id="1803761">NFC reader</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832296">NFC-читач</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33607_1803831_1832297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An exchange of information between two devices using NFC, or near field communication. Using NFC transactions, a person can use their phone to make payments in a store or as a bus pass.</descrip></descripGrp><ntig><termGrp><term id="1803831">NFC transaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832297">NFC трансакција</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33608_1803832_1832303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data limit plan where users purchase upfront a quota of data for a given time. For instance, pre-paid 500MB which expire in 6 months.</descrip></descripGrp><ntig><termGrp><term id="1803832">One time</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832303">еднократно</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33609_1803833_1832308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To navigate through screens or menus at a controlled rate, performed by putting your finger(s) on and keeping contact with the phone's touch screen while moving it around.</descrip></descripGrp><ntig><termGrp><term id="1803833">pan</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1832308">помести</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33610_1803834_2058632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The policy that states the rules of acceptable use, determined by Skype.</descrip></descripGrp><ntig><termGrp><term id="1803834">Fair Usage Policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058632">Правила за користење</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33610_1803834_2058633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The policy that states the rules of acceptable use, determined by Skype.</descrip></descripGrp><ntig><termGrp><term id="1803834">Fair Usage Policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058633">ФУП</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33610_1803835_2058632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The policy that states the rules of acceptable use, determined by Skype.</descrip></descripGrp><ntig><termGrp><term id="1803835">FUP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058632">Правила за користење</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33610_1803835_2058633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The policy that states the rules of acceptable use, determined by Skype.</descrip></descripGrp><ntig><termGrp><term id="1803835">FUP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058633">ФУП</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33611_1805602_2058619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that allows users to purchase Skype Credit for their Skype account.</descrip></descripGrp><ntig><termGrp><term id="1805602">Buy Skype Credit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058619">Купи кредит на Skype</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33611_1805602_2720016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that allows users to purchase Skype Credit for their Skype account.</descrip></descripGrp><ntig><termGrp><term id="1805602">Buy Skype Credit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2720016">Кредит на Skype</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="