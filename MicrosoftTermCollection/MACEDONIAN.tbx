p><term id="1274287">seed number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868330">семе</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19381_658409_1868330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An initial value used to generate pseudorandom numbers.</descrip></descripGrp><ntig><termGrp><term id="658409">seed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868330">семе</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19382_658448_1953771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of one element to see or refer to another. For one element to send a message to another element, the latter must be visible to the former.</descrip></descripGrp><ntig><termGrp><term id="658448">visibility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1953771">видливост</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19402_658527_1868331"><langSet xml:lang="en-US"><descripGrp><de