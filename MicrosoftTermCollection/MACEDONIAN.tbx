ote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49787_2816024_2819604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An office organization system which involves multiple workers using a single physical work station or surface during different time periods.</descrip></descripGrp><ntig><termGrp><term id="2816024">hot-desking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2819604">користење заедничко биро</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49788_2816025_2819609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that protects against harmful links (URLs) in incoming emails.</descrip></descripGrp><ntig><termGrp><term id="2816025">URL threat protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2819609">заштита од штетни УРЛ-адреси</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49789_2816026_2819607"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Sample content used to train a classifier.</descrip></descripGrp><ntig><termGrp><term id="2816026">seed content</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2819607">почетна содржина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49794_2816264_2820497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To factor a number means to break it up into numbers that can be multiplied together to get the original number. EXAMPLES: 6 = 3 x 2 so, factors of 6 are 3 and 2; 9 = 3 x 3 so, factors of 9 are 3 and 3.</descrip></descripGrp><ntig><termGrp><term id="2816264">factor</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2820497">разложи на множители</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49799_2816513_2820409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bot in Office 365 Advisor for Teams that assists in the deployment of Microsoft Teams by providing guidance and resources to team members during roll out.</descrip></descripGrp><ntig><termGrp><term id="2816513">Advisor bot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2820409">Робот советник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49799_2816513_2820412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bot in Office 365 Advisor for Teams that assists in the deployment of Microsoft Teams by providing guidance and resources to team members during roll out.</descrip></descripGrp><ntig><termGrp><term id="2816513">Advisor bot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2820412">Робот советник за Teams</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49799_2816514_2820409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bot in Office 365 Advisor for Teams that assists in the deployment of Microsoft Teams by providing guidance and resources to team members during roll out.</descrip></descripGrp><ntig><termGrp><term id="2816514">Advisor for Teams bot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2820409">Робот советник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49799_2816514_2820412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bot in Office 365 Advisor for Teams that assists in the deployment of Microsoft Teams by providing guidance and resources to team members during roll out.</descrip></descripGrp><ntig><termGrp><term id="2816514">Advisor for Teams bot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termG