Grp><ntig><termGrp><term id="1636619">newsfeed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868645">навестување за содржина на вести</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24102_3145080_1523047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feed that provides users with information, notifications and updates based on people, documents, and tags they are following.</descrip></descripGrp><ntig><termGrp><term id="3145080">Xbox activity feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523047">активности за навестување на содржина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24102_3145080_1868645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feed that provides users with information, notifications and updates based on people, documents, and tags they are following.</descrip></descripGrp><ntig><termGrp><term id="3145080">Xbox activity feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868645">навестување за содржина на вести</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><ter