ch">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1522864">ограничувања на локацијата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9320_318777_441558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The – character, based on the width of an uppercase N and used primarily as a connecting element, especially with numbers.</descrip></descripGrp><ntig><termGrp><term id="318777">EN DASH</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441558">средна црта</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9320_318777_442945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The – character, based on the width of an uppercase N and used primarily as a connecting element, especially with numbers.</descrip></descripGrp><ntig><termGrp><term id="318777">EN DASH</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442945">знакот минус</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9320_319135_441558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">