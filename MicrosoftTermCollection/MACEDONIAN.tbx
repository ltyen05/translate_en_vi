un</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2367392">квалитативно ажурирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41776_2377731_2379857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A screen capture that you can write on, save, and share as an image. ​​​</descrip></descripGrp><ntig><termGrp><term id="2377731">screen sketch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2379857">скица на екранот</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41777_2364788_2367388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to send and receive SMS and MMS messages on a Windows device with no cellular data connection, such as a PC, using a Windows phone as the transport.</descrip></descripGrp><ntig><termGrp><term id="2364788">Messaging everywhere</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2367388">Размена на пораки насекаде</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41778_2364915_2367390"><langSet x