lang="en-US"><descripGrp><descrip type="definition">A list that identifies which assemblies and types are allowed to run on Web Parts pages in a server farm. The list is stored in the web.config file for the server farm.</descrip></descripGrp><ntig><termGrp><term id="1508557">SafeControl list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868527">Список SafeControl</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29455_1508759_1868528"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure whose value is calculated at run time by using an expression.</descrip></descripGrp><ntig><termGrp><term id="1508759">calculated measure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868528">пресметана мерка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29458_1508805_1868529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high resolution, tag-based graphics format, based on the Tagged Image File Format (TIFF) used for digital graphics.</descrip></descripGrp><ntig><termGrp><term id="1508805">Microsoft Office Document Imaging Format</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868529">Формат за слики во документи 