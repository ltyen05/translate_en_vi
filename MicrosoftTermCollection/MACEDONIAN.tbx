h</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31064_1588678_2329706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make content such as data, applications, etc. available online.</descrip></descripGrp><ntig><termGrp><term id="1588678">publish</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2329706">објави</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3108_307458_2305772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows documents to be converted to HTML and displayed in a Web browser when a viewing application is not available.</descrip></descripGrp><ntig><termGrp><term id="307458">WebReady Document Viewing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305772">Преглед на документ преку веб</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31082_1592184_1643970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A networking feature that lets one computer directly place information into the memory of another computer.</descrip></descripGrp><ntig><termGrp><term id="1592184">Remote