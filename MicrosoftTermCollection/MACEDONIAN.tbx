tting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943211">поставка на пребарување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26552_1275970_1523186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part available to end users that displays the most frequently viewed content and search queries.</descrip></descripGrp><ntig><termGrp><term id="1275970">Web Analytics Web Part</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523186">Веб-дел за Web Analytics</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26554_1276172_1868501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The window that contains the user's workbook of tabbed sheets.</descrip></descripGrp><ntig><termGrp><term id="1276172">workbook window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868501">прозорец на работна книга</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26555_1276173_1465519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A prewritten formula that simplifies the process of entering calculations and enables the user to use formulas that might be difficult to build from scratch.</descrip></descripGrp><ntig><termGrp><term id="1276173">function</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1465519">функција</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26558_1276179_2048991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of Human Interaction Proof challenge, which plays an audio file decipherable only by a person. The audio file might seem faint or mixed with background voices and noise. This is intentional to ensure a person, not an automated program, completes the HIP challenge.</descrip></descripGrp><ntig><termGrp><term id="1276179">audio challenge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2048991">аудиопредизвик</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26565_1276491_1523176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part that displays all items that belong to a given tag.</descrip></descripGrp><ntig><termGrp><term id="1276491">Tagged Items</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523176">Означени ставки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26571_1276626_1465520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range of cells in a worksheet that has been formatted as a table and can be managed independently from the data in other rows and columns on the worksheet.</descrip></descripGrp><ntig><termGrp><term id="1276626">Excel table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1465520">Excel-табела</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26581_1278354_1868502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A typographical unit of measure that is equal in width to the point size of a particular font. For many fonts, this is equal to the width of a capital N, from which the en space takes its name.</descrip></descripGrp><ntig><termGrp><term id="1278354">en space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868502">средно празно место</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26585_1280041_2305664"><langSet xml:lang="en-US"><descripGrp><des