02035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Teams channel that's created for a subset of people in the team.</descrip></descripGrp><ntig><termGrp><term id="3001106">private channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3002035">приватен канал</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52816_3001107_3002057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Teams channel that has the same membership list as the team itself (not a private or shared channel).</descrip></descripGrp><ntig><termGrp><term id="3001107">standard channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3002057">стандарден канал</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52817_3001108_3002015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint site that's created for a private channel or shared channel.</descrip></descripGrp><ntig><termGrp><term id="3001108">channel site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3002015">веб-локација на каналот</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine<