ntig><termGrp><term id="1612562">Business Intelligence Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868563">Центар за деловно информирање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31683_1612565_1644139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An API for AtomPub and syndication.</descrip></descripGrp><ntig><termGrp><term id="1612565">Web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1644139">Веб</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31688_1612737_1643709"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that a developer provides in an app for consumers to buy from within the app through an in-app purchase transaction.</descrip></descripGrp><ntig><termGrp><term id="1612737">in-app offer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1643709">понуда во апликација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31689_1612739_1643714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transaction performed by a consumer from within the context of an app to buy additional features for that app.</descrip></descripGrp><ntig><termGrp><term id="1612739">in-app purchase</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1643714">купување од апликација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3169_232421_1868178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of shortcuts to folders that can be displayed in the Shortcuts pane.</descrip></descripGrp><ntig><termGrp><term id="232421">shortcut group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868178">група со кратенки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31692_1612750_1643797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Applications in Windows Store are distributed with user-based licensing model. Windows runtime and application model will only allow applications that are for user-based license as well as signed by Windows Store to be installed/run on Windows 8.</descrip></descripGrp><ntig><termGrp><term id="1612750">Microsoft License Terms for Consumers</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><la