ype="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="807_22891_441320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of starting or resetting a computer or a device. When first turned on (cold boot) or reset (warm boot), the computer runs the software that loads and starts the computer's operating system, which prepares it for use.</descrip></descripGrp><ntig><termGrp><term id="22891">bootstrap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441320">подигање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="807_730299_1372288"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of starting or resetting a computer or a device. When first turned on (cold boot) or reset (warm boot), the computer runs the software that loads and starts the computer's operating system, which prepares it for use.</descrip></descripGrp><ntig><termGrp><term id="730299">startup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372288">стартување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="807_730299_441320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of starting or resetting a computer or a device. When first turned on (cold boot) or reset (warm boot), the computer runs the software that loads and starts the computer's operating system, which prepares it for use.</descrip></descripGrp><ntig><termGrp><term id="730299">startup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441320">подигање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="808_264640_442640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fraction that is written on a downward angle: the diagonal fraction bar is placed down and to the right of the numerator, and the denominator is slightly down and to the right of the fraction bar.</descrip></descripGrp><ntig><termGrp><term id="264640">skewed fraction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442640">закосена равенка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8081_319170_442958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The § character.</descrip></descripGrp><ntig><termGrp><term id="319170">SECTION SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442958">знак за секција</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8081_319171_442958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The § character.</descrip></descripGrp><ntig><termGrp><term id="319171">section mark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442958">знак за секција</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8085_262737_1522836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication protocol that provides a mechanism for mutual authentication between a client and a server, or between one server and another, before a network connection is opened between them.</descrip></descripGrp><ntig><termGrp><term id="262737">Kerberos</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1522836">Автентикација Кербер</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8085_262737_2744223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication protocol that provides a mechanism for mutual authentication between a client and a server, or between one server and another, before a network connection is opened between them.</descrip></descripGrp><ntig><termGrp><term id="262737">Kerberos</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2744223">Кербер</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8085_636858_1522836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication protocol that provides a mechanism for mutual authentication between a client and a server, or between one server and another, before a network connection is opened between them.</descrip></descripGrp><ntig><termGrp><term id="636858">Kerberos authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1522836">Автентикација Кербер</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8085_636858_2744223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication protocol that provides a mechanism for mutual authentication between a client and a server, or between one server and another, before a network connection is opened between them.</descrip></descripGrp><ntig><termGrp><term id="636858">Kerberos authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2744223">Кербер</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8090_360150_443146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ActiveX Database Objects (ADO) object used to contain a result set. It also exhibits cursor behavior depending on the recordset properties set by an application. ADO recordsets are mapped to OLE DB rowsets.</descrip></descripGrp><ntig><termGrp><term id="360150">recordset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="443146">збирка записи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8095_117241_1868010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To send something in for consideration.</descrip></descripGrp><ntig><termGrp><term id="117241">submit</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868010">поднеси</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8099_265320_1096047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder where a collection of PowerPoint slides is shared.</descrip></descripGrp><ntig><termGrp><term id="265320">Slide Library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1096047">Библиотека со слајдови</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8102_42162_1465425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short horizontal line used as a punctuation mark.</descrip></descripGrp><ntig><termGrp><term id="42162">dash</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1465425">цртичка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8115_66527_1372387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain controller that holds the infrastructure operations master role in Active Directory. The infrastructure master updates the group-to-user reference whenever group memberships change and replicates these changes across the domain. At any time, the infrastructure master role can be assigned to only one domain controller in each domain.</descrip></descripGrp><ntig><termGrp><term id="66527">infrastructure master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372387">главен за инфраструктура</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8120_375742_2305546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that provides a programming interface for accessing Microsoft Exchange data through the Client Access server role by using Web services.</descrip></descripGrp><ntig><termGrp><term id="375742">Exchange Web Services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305546">Веб-услуги на Exchangeе</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8123_234529_442465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic that indicates follow-up action is required, or otherwise identifies an important item.</descrip></descripGrp><ntig><termGrp><term id="234529">flag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442465">знаменце</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8125_359995_1371590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that uses a minimum amount of data to display the general layout of a report.</descrip></descripGrp><ntig><termGrp><term id="359995">Layout Preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371590">Преглед на распоредот</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termN