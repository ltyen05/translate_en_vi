nt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868533">константа на условен компајлер</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29465_1508813_1868534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Naskh script that enriches the display of Arabic text. This script uses object linking and embedding (OLE) to create and add objects to a document.</descrip></descripGrp><ntig><termGrp><term id="1508813">DecoType Naskh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868534">Фонт DecoType Naskh</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29466_1508814_1868535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Ruq'ah script that enriches the display of Arabic text. This script uses object linking and embedding (OLE) to create and add objects to a document.</descrip></descripGrp><ntig><termGrp><term id="1508814">DecoType Ruq'ah</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868535">Фонт DecoType Ruq'ah</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gr