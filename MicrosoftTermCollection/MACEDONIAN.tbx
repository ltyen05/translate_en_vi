rp><descrip type="definition">The Sway card that allows users to create a hierarchical document structure with a heading within a particular section of a Sway.</descrip></descripGrp><ntig><termGrp><term id="2267306">Heading</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2352839">Наслов</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38986_2267308_2352833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that differentiates selected content based on said content and the current Design.</descrip></descripGrp><ntig><termGrp><term id="2267308">Accent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2352833">Акцент</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38994_2267490_2428541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected set of episodes or events that run under the same title, usually within the course of one year.</descrip></descripGrp><ntig><termGrp><term id="2267490">season</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2428541">сезона</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote typ