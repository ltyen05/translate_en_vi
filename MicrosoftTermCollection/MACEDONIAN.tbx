nced eDiscovery feature that allows users to run Analyze specifically for near-duplicates, email threads and themes and export the results.</descrip></descripGrp><ntig><termGrp><term id="2685277">Express analysis</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2687086">Експресна анализа</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47701_2685278_2687124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query string, generated on the client side, that includes all the information required to authenticate a service-level shared access signature (SAS).</descrip></descripGrp><ntig><termGrp><term id="2685278">SAS token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2687124">токен за ПСП</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47702_2685279_2687119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container where Office 365 Advanced eDiscovery sorts documents based on how long they should be retained.</descrip></descripGrp><ntig><termGrp><term id="2685279">retention bucket</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2687119">корпа за задржување</term><termNote type="geographicalUsage">MKD</termN