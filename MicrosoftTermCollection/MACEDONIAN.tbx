="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50899_2876395_2877701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A characteristic that helps a machine-learned model recognize a particular concept that is a hint that the algorithm can use, but not a hard rule.</descrip></descripGrp><ntig><termGrp><term id="2876395">explanation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2877701">објаснување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5090_115534_441951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special control added to a window, typically adjacent to the scroll bar, that allows a user to split a window or adjust a window split.</descrip></descripGrp><ntig><termGrp><term id="115534">split box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441951">разделна рамка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50900_2876396_2877709"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that manages the classification and hierarchical relationships between items such as words, labels, or tags in a system, which includes user-generated and system-generated classifications.</descrip></descripGrp><ntig><termGrp><term id="2876396">taxonomy service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2877709">услуга за таксономија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50903_2876995_2877903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Teams for Education, an activity by which a teacher can assign work to students within a class team.</descrip></descripGrp><ntig><termGrp><term id="2876995">assignment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2877903">доделување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50915_2877863_2877986"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To provide notification of a problem, bug, crash, violation, etc. via a form submission.</descrip></descripGrp><ntig><termGrp><term id="2877863">report</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2877986">пријавете</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50926_2878203_2878312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Business solution designed for small businesses and powered by Microsoft 365 and Windows 10, with device management and security features.</descrip></descripGrp><ntig><termGrp><term id="2878203">Microsoft 365 Small Business Premium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2878312">Microsoft 365 Small Business Premium</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50963_2879286_2879850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An inspection of devices, mailboxes, and other types of entities performed automatically in response to various detections, after which remediation actions might be taken on malicious and suspicious items found during the investigation.</descrip></descripGrp><ntig><termGrp><term id="2879286">automated investigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2879850">автоматизирана истрага</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50964_2879287_2879860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A threat remediation mechanism that automatically applies various actions, such as file quarantine or deletion of persistence mechanism in the registry, based on the results of a corresponding automated investigation.</descrip></descripGrp><ntig><termGrp><term id="2879287">automatic remediation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2879860">автоматско поправање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50965_2879288_2879864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query-based proactive threat hunting capability that provides flexible options for locating undetected breach activity as well as network assets that require attention.</descrip></descripGrp><ntig><termGrp><term id="2879288">advanced hunting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2879864">напреден лов</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50966_2879289_2879852"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository of reports about emerging threats, including specific incidents and campaigns, threat techniques, and vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="2879289">threat analytics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2879852">аналитика на закани</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50967_2879290_2879856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A malware detonation service that customers can use to submit suspicious files for automated analysis.</descrip></descripGrp><ntig><termGrp><term id="2879290">deep analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2879856">длабинска анализа</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5099_26714_2081411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of establishing predictable behavior in a device.</descrip></descripGrp><ntig><termGrp><term id="26714">calibration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2081411">калибрација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50990_2880077_2880305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability for Game Pass titles to be streamed through the Game Pass app via the user's mobile phone.</descrip></descripGrp><ntig><termGrp><term id="2880077">Cloud enabled</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2880305">овозможено за облак</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neu