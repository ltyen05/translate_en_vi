Луѓе</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31752_1618539_1643856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A picture-based sign-in method that authenticates a user by checking gestures made on a picture of the user's own choosing.</descrip></descripGrp><ntig><termGrp><term id="1618539">picture password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1643856">лозинка со слика</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31776_1621224_1644024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move an object, such as a window or an app, into a locked position on the screen.</descrip></descripGrp><ntig><termGrp><term id="1621224">snap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1644024">заклучи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31783_1623953_1868574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that identifies a possible question or requested action in an email message and enables the user to take action on it from within the message.</descrip></descripGrp><ntig><termGrp><term id="1623953">Action Items</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868574">Ставки за дејствување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31784_1623954_1868575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that alerts the user before an email message is sent if it detects that an attachment may have been omitted from the message.</descrip></descripGrp><ntig><termGrp><term id="1623954">Attachment Reminder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868575">Потсетник за прилог</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31785_1623955_1868576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list or library that is shared between site collections.</descrip></descripGrp><ntig><termGrp><term id="1623955">catalog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868576">каталог</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31786_1623956_1868577"