ammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1465486">блесок</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19488_685377_1465486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect that applies a halo of color around the perimeter of an object.</descrip></descripGrp><ntig><termGrp><term id="685377">glow effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1465486">блесок</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19488_685378_1465486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect that applies a halo of color around the perimeter of an object.</descrip></descripGrp><ntig><termGrp><term id="685378">glow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1465486">блесок</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19508_660023_1372515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To display an object.</descrip></descripGrp><ntig><termGrp><term id="660023">show</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372515">прикажи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1951_169268_1868118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A log backup taken from a possibly damaged database to capture the log that has not yet been backed up. A tail-log backup is taken after a failure in order to prevent work loss.</descrip></descripGrp><ntig><termGrp><term id="169268">tail-log backup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868118">резервна копија за дневник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19515_660033_2998745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The gradient of a curve at a point. You can modify a curve that is part of a path object by using the control handles that represent the tangent of the curve.</descrip></descripGrp><ntig><termGrp><term id="660033">tangent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2998745">тангента</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19526_660055_2418336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To release objects that have been combined together as a single object.</descrip></descripGrp><ntig><termGrp><term id="660055">ungroup</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2418336">разгрупирај</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19538_660183_1953743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that stores an image as graphical objects (lines, circles, polygons) rather than as pixels. Metafiles preserve an image more accurately than pixels when the image is resized.</descrip></descripGrp><ntig><termGrp><term id="660183">metafile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1953743">метадатотека</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19542_660559_1953707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page that you can assign to another page to create multiple layers in a drawing.</descrip></descripGrp><ntig><termGrp><term id="660559">background page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1953707">заднина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19542_660560_1953707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page that you can assign to another page to create multiple layers in a drawing.</descrip></descripGrp><ntig><termGrp><term id="660560">background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1953707">заднина</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1958_184137_1465403"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that allows users to digitally sign a form or document.</descrip></descripGrp><ntig><termGrp><term id="184137">signature line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1465403">линија за потпис</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19686_670514_1371858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The size of the finished page of a printed publication, after trimming.</descrip></descripGrp><ntig><termGrp><term id="670514">page size</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371858">големина на страницата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19687_670515_1372516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The size of the sheet of paper on which you print the publication, before trimming.</descrip></descripGrp><ntig><termGrp><term id="670515">paper size</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372516">големина на хартија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19689_670553_1372517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A word or string of characters in a formula that represents a cell, range of cells, formula, or constant value.</descrip></descripGrp><ntig><termGrp><term id="670553">defined name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372517">дефинирано име</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19690_670554_1372518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A name for an Excel table, which is a collection of data about a particular subject that is stored in records (rows) and fields (columns).</descrip></descripGrp><ntig><termGrp><term id="670554">table name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372518">име на табелата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19695_671377_1868332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A display mode that shows as much content as possible by hiding elements such as navigation and toolbars.</descrip></descripGrp><ntig><termGrp><term id="671377">full-screen mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868332">режим за цел екран</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="197_93813_441862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation where the long dimension of a rectangular area (for example, screen, photo, or paper) is vertical.​</descrip></descripGrp><ntig><termGrp><term id="93813">portrait orientation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441862">портретна ориентација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="197_93813_441863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation where the long dimension of a rectangular area (for example, screen, photo, or paper) is vertical.​</descrip></descripGrp><ntig><termGrp><term id="93813">portrait orientation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441863">портрет</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="197_93814_441862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation where the long dimension of a rectangular area (for example, screen, photo, or paper) is vertical.​</descrip></descripGrp><ntig><termGrp><term id="93814">portrait</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441862">портретна ориентација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="197_93814_441863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation where the long dimension of a rectangular area (for example, screen, photo, or paper) is vertical.​</descrip></descripGrp><ntig><termGrp><term id="93814">portrait</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441863">портрет</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19722_673385_3071867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of light emitted onto a film or image sensor.</descrip></descripGrp><ntig><termGrp><term id="673385">exposure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3071867">експозиција</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19723_673395_1372519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control on most digital cameras that lets you control the under -or over- exposure of the image.</descrip></descripGrp><ntig><termGrp><term id="673395">exposure bias</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372519">компензација на експозицијата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19723_686810_1372519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control on most digital cameras that lets you control the under -or over- exposure of the image.</descrip></descripGrp><ntig><termGrp><term id="686810">exposure bias compensation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372519">компензација на експозицијата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19723_686811_1372519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control on most digital cameras that lets you control the under -or over- exposure of the image.</descrip></descripGrp><ntig><termGrp><term id="686811">exposure compensation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372519">компензација на експозицијата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19729_1309629_1868797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When a ribbon is divided into multiple views, any one of the views. Every tab contains functionally related commands and other controls that are organized in groups. Typically, ribbon tabs are labeled.</descrip></descripGrp><ntig><termGrp><term id="1309629">ribbon tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868797">картичка со ленти</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1975_73133_441696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A designation used to conduct sorting or searching operations.</descrip></descripGrp><ntig><termGrp><term id="73133">keyword</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441696">клучен збор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19767_674770_2775361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rating unit, e.g. assigning a "one-star rating" to an image.</descrip></descripGrp><ntig><termGrp><term id="674770">star</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2775361">ѕвездичка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1978_45320_1371400"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enter numbers on a device, such as telephone or mobile, in order to make a phone call.</descrip></descripGrp><ntig><termGrp><term id="45320">dial</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371400">избирај</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19780_2466458_2468835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The audio effect ​that creates the perception that there are many more sources of sound then are currently present. This is a well-known and industry term for the technique of creating a surround sound experience for users listening to audio with regular stereo headphones.</descrip></descripGrp><ntig><termGrp><term id="2466458">virtual surround sound</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2468835">виртуелен опкружувачки звук</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19780_682693_2468835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The audio effect ​that creates the perception that there are many more sources of sound then are currently present. This is a well-known and industry term for the technique of creating a surround sound experience for users listening to audio with regular stereo headphones.</descrip></descripGrp><ntig><termGrp><term id="682693">virtual surround</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2468835">виртуелен опкружувачки звук</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1979_63495_441636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic symbol used on the user interface to assist with navigation.</descrip></descripGrp><ntig><termGrp><term id="63495">icon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441636">икона</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19792_685384_1868334"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect that applies to the exterior border around each character of your text or shape.</descrip></descripGrp><ntig><termGrp><term id="685384">outline effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868334">ефект на контура</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19793_685388_1372520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect that applies to the appearance of the interior of an enclosed text character or other shape.</descrip></descripGrp><ntig><termGrp><term id="685388">fill effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372520">ефект на пополнување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="198_112365_1371339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any combination of keys that must be pressed simultaneously.</descrip></descripGrp><ntig><termGrp><term id="112365">shortcut key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371339">комбинација на копчиња</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="198_112365_441933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any combination of keys that must be pressed simultaneously.</descrip></descripGrp><ntig><termGrp><term id="112365">shortcut key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441933">копче за брз пристап</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="198_318149_1371339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any combination of keys that must be pressed simultaneously.</descrip></descripGrp><ntig><termGrp><term id="318149">key combination</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371339">комбинација на копчиња</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="198_318149_441933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any combination of keys that must be pressed simultaneously.</descrip></descripGrp><ntig><termGrp><term id="318149">key combination</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441933">копче за брз пристап</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19800_685897_1372521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains the data that a program will process and store in a destination file.</descrip></descripGrp><ntig><termGrp><term id="685897">source file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372521">изворна датотека</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19806_2908028_2305470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System that associates a computer's true (canonical) name with any alias names also used by the computer. Some domain registrars use CNAME records to redirect or redelegate domain names.</descrip></descripGrp><ntig><termGrp><term id="2908028">CNAME</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305470">запис за CNAME</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19806_686253_2305470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System that associates a computer's true (canonical) name with any alias names also used by the computer. Some domain registrars use CNAME records to redirect or redelegate domain names.</descrip></descripGrp><ntig><termGrp><term id="686253">canonical name record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305470">запис за CNAME</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19806_686254_2305470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System that associates a computer's true (canonical) name with any alias names also used by the computer. Some domain registrars use CNAME records to redirect or redelegate domain names.</descrip></descripGrp><ntig><termGrp><term id="686254">CNAME record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305470">запис за CNAME</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19810_686305_2305519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The owner of the customer relationship with customers who buy second-level domains. There may be many registrars for a single top-level domain. Registrars maintain detailed customer information in their databases, such as the customer's contact address, telephone number, and email address. Customers usually manage their second-level domains at the registrar's Web site, and the registrar updates the registry database when necessary (for example, when a customer renews a domain name).</descrip></descripGrp><ntig><termGrp><term id="686305">domain name registrar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305519">регистар со имиња на домени</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19828_686821_2305640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System (DNS) specifying how Internet email should be routed using the Simple Mail Transfer Protocol (SMTP). Each MX record contains a preference and a host name, so that the collection of MX records for a given domain name point to the servers that should receive email for that domain, and their priority relative to each other.</descrip></descripGrp><ntig><termGrp><term id="686821">mail exchange record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305640">Запис на MX</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19828_686822_2305640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System (DNS) specifying how Internet email should be routed using the Simple Mail Transfer Protocol (SMTP). Each MX record contains a preference and a host name, so that the collection of MX records for a given domain name point to the servers that should receive email for that domain, and their priority relative to each other.</descrip></descripGrp><ntig><termGrp><term id="686822">MX record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305640">Запис на MX</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19838_687152_1868336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The distance between the camera’s lens and the image plane.</descrip></descripGrp><ntig><termGrp><term id="687152">focal length</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868336">фокусно растојание</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1989_48436_1371401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of storage that is formatted with a file system and has an identifier to access it.</descrip></descripGrp><ntig><termGrp><term id="48436">drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371401">податочна единица</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1992_108620_441917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that searches for key words in documents, databases, Internet content or other files.</descrip></descripGrp><ntig><termGrp><term id="108620">search engine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441917">пребарувач</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19941_690680_2775293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To grant a person or entity the right to use a software product, as described in the terms of the license agreement.</descrip></descripGrp><ntig><termGrp><term id="690680">license</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2775293">лиценцира</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19945_690967_1868338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that 