un</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371687">ФАТ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11314_53259_441575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file system used by MS-DOS and Microsoft Windows operating systems to organize and manage files.</descrip></descripGrp><ntig><termGrp><term id="53259">file allocation table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441575">табела за адресирање датотеки</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11318_232416_1371688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that includes the email addresses of mailing lists for which you want to be a recipient. Messages sent to such a mailing list and received by you will not be treated as junk email.</descrip></descripGrp><ntig><termGrp><term id="232416">Safe Recipients List</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371688">Список на безбедни примачи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11319_168226_1372419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security feature that monitors programs on a computer to determine if they use system memory safely.</descrip></descripGrp><ntig><termGrp><term id="168226">Data Execution Prevention</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372419">Спречување на извршување несигурни програми</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11319_168226_1372420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security feature that monitors programs on a computer to determine if they use system memory safely.</descrip></descripGrp><ntig><termGrp><term id="168226">Data Execution Prevention</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372420">ДЕП</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11319_168227_1372419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security feature that monitors programs on a computer to determine if they use system memory safely.</descrip></descripGrp><ntig><termGrp><term id="168227">DEP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372419">Спречување на извршување несигурни програми</term><termNote type="geograp