ion">An action or task in a sequence that is related to a built-in or user-defined business process.</descrip></descripGrp><ntig><termGrp><term id="1507106">workflow task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523200">задача на работниот тек</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29325_1507107_1943410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that stores the sequence of actions or tasks for a business process.</descrip></descripGrp><ntig><termGrp><term id="1507107">workflow task list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943410">список со задачи на работен тек</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29326_1507108_1943411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart image that is embedded in a worksheet or chart sheet.</descrip></descripGrp><ntig><termGrp><term id="1507108">worksheet image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943411">слика на работен лист</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29327_1507109_1943412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that is associated with a worksheet.</descrip></descripGrp><ntig><termGrp><term id="1507109">worksheet object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943412">објект на работен лист</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29328_1507110_1943413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An abstract description of an action that is supported by a WSDL service, as specified in WSDL.</descrip></descripGrp><ntig><termGrp><term id="1507110">WSDL operation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943413">WSDL-операција</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29329_1507111_1943414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A named set of abstract operations that is supported by one or more endpoints, as specified in WSDL.</descrip></descripGrp><ntig><termGrp><term id="1507111">WSDL port type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943414">Тип на порта WSDL</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29330_1507112_1943415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that is native to an application and is made available for use in formulas.</descrip></descripGrp><ntig><termGrp><term id="1507112">built-in function</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943415">вградена функција</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29331_1507113_1523060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special SharePoint site where an administrator can manage all sites and servers in a farm that is running Microsoft® SharePoint® Products and Technologies.</descrip></descripGrp><ntig><termGrp><term id="1507113">Central Administration site</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523060">Централна администраторска локација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29332_1507114_1943416"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of keyword consumers.</descrip></descripGrp><ntig><termGrp><term id="1507114">keyword consumer group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943416">група со корисници на клучен збор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29333_1507115_1943417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of information that is stored in a log file for a transaction. Log levels can be represented by numbers or by words from the most to the least verbose.</descrip></descripGrp><ntig><termGrp><term id="1507115">log level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943417">ниво на дневник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29334_1507116_1523160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A complete set of conditions that are used to generate search results, including query text, sort order, and ranking parameters.</descrip></descripGrp><ntig><termGrp><term id="1507116">search query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523160">прашалник за пребарување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29335_1507117_1943418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A record of information about user searches, such as search terms and time of access.</descrip></descripGrp><ntig><termGrp><term id="1507117">search query log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943418">дневник за прашалници на пребарување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29336_1507118_1943419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that is generated from query log information. For example, a search query log report might include the number of queries that were executed every day over the past thirty days.</descrip></descripGrp><ntig><termGrp><term id="1507118">search query log report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943419">извештај од дневник за прашалници на пребарување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29337_1507119_1943420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user search security filter that specifies group and user permissions for a specific FAST Search user. FAST Search Authorization (FSA) filters out inappropriate search results by intersecting the user’s query with the user's search security filter, and checking each document’s access control list to determine if the user has permission to view that document. The user search security filter is FSA's primary means of enforcing document-level security ("security trimming"), which helps to ensure that search results display only documents that the user has permissions to read.</descrip></descripGrp><ntig><termGrp><term id="1507119">user search security filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943420">филтер за безбедност на корисничко пребарување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29338_1507120_1943421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The condition of a Web Part and the Web Part chrome surrounding it. Possible values are zero (0) for normal state or one (1) for minimized state.</descrip></descripGrp><ntig><termGrp><term id="1507120">Web Part chrome state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943421">Состојба на хром за веб-дел</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29339_1507121_1943422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A default group of users on a SharePoint site. By default, the Visitors group is assigned the Read permission level.</descrip></descripGrp><ntig><termGrp><term id="1507121">Visitors group</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943422">Група на посетители</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2934_141001_1095922"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that stores discussion text and information about the location of the file being discussed.</descrip></descripGrp><ntig><termGrp><term id="141001">discussion server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1095922">сервер за дискусија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2939_7912_1867956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The selected cell in which data is entered when you begin typing. Only one cell is active at a time. The active cell is bounded by a heavy border.</descrip></descripGrp><ntig><termGrp><term id="7912">active cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1867956">активна ќелија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2939_7912_1867957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The selected cell in which data is entered when you begin typing. Only one cell is active at a time. The active cell is bounded by a heavy border.</descrip></descripGrp><ntig><termGrp><term id="7912">active cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1867957">тековна ќелија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2939_7913_1867956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The selected cell in which data is entered when you begin typing. Only one cell is active at a time. The active cell is bounded by a heavy border.</descrip></descripGrp><ntig><termGrp><term id="7913">current cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1867956">активна ќелија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2939_7913_1867957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The selected cell in which data is entered when you begin typing. Only one cell is active at a time. The active cell is bounded by a heavy border.</descrip></descripGrp><ntig><termGrp><term id="7913">current cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1867957">тековна ќелија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2940_179726_442296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of a scroll bar that allows the information to be scrolled by defined increments when the user clicks it. The direction of the arrow indicates the direction in which the information scrolls.</descrip></descripGrp><ntig><termGrp><term id="179726">scroll arrow button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442296">копче со стрелка за лизгање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2940_179726_442297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of a scroll bar that allows the information to be scrolled by defined increments when the user clicks it. The direction of the arrow indicates the direction in which the information scrolls.</descrip></descripGrp><ntig><termGrp><term id="179726">scroll arrow button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442297">стрелка за лизгање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2940_179727_442296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of a scroll bar that allows the information to be scrolled by defined increments when the user clicks it. The direction of the arrow indicates the direction in which the information scrolls.</descrip></descripGrp><ntig><termGrp><term id="179727">scroll arrow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442296">копче со стрелка за лизгање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2940_179727_442297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of a scroll bar that allows the information to be scrolled by defined increments when the user clicks it. The direction of the arrow indicates the direction in which the information scrolls.</descrip></descripGrp><ntig><termGrp><term id="179727">scroll arrow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442297">стрелка за лизгање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29408_1507601_1943427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that represents data on two axes, x and y, and displays chart objects in flat graphical formatting.</descrip></descripGrp><ntig><termGrp><term id="1507601">2-D chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943427">2Д графикон</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29409_1507603_1943428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory on an index server or a query server where all files are stored for the purpose of creating a full-text index catalog or performing queries on a full-text index catalog.</descrip></descripGrp><ntig><termGrp><term id="1507603">application directory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943428">директориум за апликации</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29410_1507604_1943429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that uniquely identifies a view definition for a list.</descrip></descripGrp><ntig><termGrp><term id="1507604">base view identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943429">идентификатор на основен приказ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29411_1507605_1943430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The binary file formats that are used to save Microsoft® Office Excel® workbooks.</descrip>