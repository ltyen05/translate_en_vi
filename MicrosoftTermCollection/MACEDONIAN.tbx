</ntig></langSet></termEntry><termEntry id="56091_3153897_3153942"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An input surface where users enter their requests for Copilot in natural language. It is the user’s interaction point with the system.</descrip></descripGrp><ntig><termGrp><term id="3153897">prompt bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3153942">лента за прашања</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56092_3153898_3154997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides real-time exploration of a machine's operational information, spanning from hardware specifications, such as memory usage, to software configuration, including installed applications, registry keys, and networking settings.</descrip></descripGrp><ntig><termGrp><term id="3153898">device query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3154997">прашалник за уред</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56093_3153899_3154875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows organizations to selectively scan and protect historical older data using the latest enhanced advanced classifiers, to comprehensively identify and protect their sensitive corporate intellectual property and PII.</descrip></descripGrp><ntig><termGrp><term id="3153899">data scan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3154875">скенирање на податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56094_3153900_3154879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables a customer’s Entra ID admin to approve access to identity data in their tenant.</descrip></descripGrp><ntig><termGrp><term id="3153900">customer lockbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3154879">безбедно сандаче за клиентот</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56095_3153903_3154116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Edge feature that enables users to perform complex tasks such as more accurate calculations, coding, data analysis, visualization, math and more.</descrip></descripGrp><ntig><termGrp><term id="3153903">code interpreter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3154116">интерпретатор на кодови</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalN