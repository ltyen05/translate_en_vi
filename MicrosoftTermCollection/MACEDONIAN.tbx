contact list.</descrip></descripGrp><ntig><termGrp><term id="1673106">video mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1680923">видеопошта</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32403_1673106_1680924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short video sent as an email message to someone in the contact list.</descrip></descripGrp><ntig><termGrp><term id="1673106">video mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1680924">видеопорака</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32403_1673107_1680923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short video sent as an email message to someone in the contact list.</descrip></descripGrp><ntig><termGrp><term id="1673107">video message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1680923">видеопошта</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32403_1673107_1680924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short video sent as an email message to someone in the contact list.</descrip></descripGrp><ntig><termGrp><term id="1673107">video message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1680924">видеопорака</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32405_1673865_1678904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique that increases sharpness and fidelity by compensating for some effects that camera movement has on images in videos.</descrip></descripGrp><ntig><termGrp><term id="1673865">stabilization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1678904">стабилизација на сликата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32405_1673865_1679048"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique that increases sharpness and fidelity by compensating for some effects that camera movement has on images in videos.</descrip></descripGrp><ntig><termGrp><term id="1673865">stabilization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1679048">стабилизација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32405_1674922_1678904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique that increases sharpness and fidelity by compensating for some effects that camera movement has on images in videos.</descrip></descripGrp><ntig><termGrp><term id="1674922">image stabilization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1678904">стабилизација на сликата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32405_1674922_1679048"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique that increases sharpness and fidelity by compensating for some effects that camera movement has on images in videos.</descrip></descripGrp><ntig><termGrp><term id="1674922">image stabilization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1679048">стабилизација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32406_1673920_1678906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that enables users to communicate and collaborate with people online and access their conversations, photos, documents, contacts, appointments, settings, and services across PC, phone, and other devices.</descrip></descripGrp><ntig><termGrp><term id="1673920">Live</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1678906">Live</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32415_1676150_1868742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user action that is counted and analyzed by the recommendations algorithm in the Analytics Service.</descrip></descripGrp><ntig><termGrp><term id="1676150">usage event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868742">настан за користење</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32417_1676974_1868743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A metadata navigation control that enables users to limit the items displayed in a list or library to those that match selected values.</descrip></descripGrp><ntig><termGrp><term id="1676974">Key Filters</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868743">Клучни филтри</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntr