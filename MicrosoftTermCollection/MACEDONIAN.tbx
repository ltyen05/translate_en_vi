termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943403">идентификатор за тип на работна ставка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29313_1507095_1523196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains a byte stream representation of a workbook.</descrip></descripGrp><ntig><termGrp><term id="1507095">workbook file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1523196">датотека на работната книга</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29314_1507096_1943404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that is associated with a workbook.</descrip></descripGrp><ntig><termGrp><term id="1507096">workbook object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943404">објект на работна книга</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29315_1507097_1523197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single cell that is designated t