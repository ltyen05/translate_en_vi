 type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44551_2506500_2512947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A copy of a repository.</descrip></descripGrp><ntig><termGrp><term id="2506500">fork</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2512947">копија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44551_2506500_2512960"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A copy of a repository.</descrip></descripGrp><ntig><termGrp><term id="2506500">fork</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2512960">копија на склад</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44551_2506501_2512947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A copy of a repository.</descrip></descripGrp><ntig><termGrp><term id="2506501">repository fork</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2512947">копија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</te