x</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2606365">поштенско сандаче за eDiscovery</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25782_2603788_2305508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system mailbox in which copies of the mailbox search results are stored.</descrip></descripGrp><ntig><termGrp><term id="2603788">discovery system mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305508">поштенско сандаче за откривање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25782_2603788_2606365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system mailbox in which copies of the mailbox search results are stored.</descrip></descripGrp><ntig><termGrp><term id="2603788">discovery system mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2606365">поштенско сандаче за eDiscovery</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25782_2604808_2305508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system mailbox in which copies of the mailbox search results are stored.</descrip></descripGrp><ntig><termGrp><term id="2604808">eDiscovery mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305508">поштенско сандаче за откривање</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25782_2604808_2606365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system mailbox in which copies of the mailbox search results are stored.</descrip></descripGrp><ntig><termGrp><term id="2604808">eDiscovery mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2606365">поштенско сандаче за eDiscovery</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25783_1216620_2305580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of IP addresses that are in a gateway servers list or internal mail servers list of IP addresses that should not be treated as spam.</descrip></descripGrp><ntig><termGrp><term id="1216620">IP safelist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305580">Безбеден список со ИП-адреси</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25783_1216620_2305707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of IP addresses that are in a gateway servers list or internal mail servers list of IP addresses that should not be treated as spam.</descrip></descripGrp><ntig><termGrp><term id="1216620">IP safelist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305707">безбеден список</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25783_1216842_2305580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of IP addresses that are in a gateway servers list or internal mail servers list of IP addresses that should not be treated as spam.</descrip></descripGrp><ntig><termGrp><term id="1216842">safelist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305580">Безбеден список со ИП-адреси</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25783_1216842_2305707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of IP addresses that are in a gateway servers list or internal mail servers list of IP addresses that should not be treated as spam.</descrip></descripGrp><ntig><termGrp><term id="1216842">safelist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305707">безбеден список</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25784_1216621_2305699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The individual entry on a management role. Role entries provide access to cmdlets, scripts, and other special permissions that let users perform a specific task. A role entry is often a single cmdlet and the parameters that members of a role group can run when the role is assigned to the role group.</descrip></descripGrp><ntig><termGrp><term id="1216621">role entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305699">запис на улога</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25785_1216622_2305702"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The scope of influence or impact of a role assignment. The scope defines what objects a role group member can manage. In Outlook Live, there is the recipient scope and the configuration scope.</descrip></descripGrp><ntig><termGrp><term id="1216622">role scope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305702">опсег на група</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25786_1216623_2305701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of an administrator role group, which is a universal security group with administrative rights assigned to it. The roles assigned to the role group are applied to each member who is added to the role group. This grants each user all the permissions allowed by the roles assigned to the role group.</descrip></descripGrp><ntig><termGrp><term id="1216623">role group member</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305701">член на група со улоги</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25787_1216679_1373929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the Microsoft service agreement.</descrip></descripGrp><ntig><termGrp><term id="1216679">Terms of use</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1373929">Услови на користење</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25798_1216733_1373930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the personal page where users can store information (such as personal interests) and links (such as to friends and photos).</descrip></descripGrp><ntig><termGrp><term id="1216733">Profile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1373930">Профил</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2580_141226_442138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shaded outline that appears behind an object or text and creates the illusion of depth.</descrip></descripGrp><ntig><termGrp><term id="141226">drop shadow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442138">паѓачка сенка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2580_141226_442742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shaded outline that appears behind an object or text and creates the illusion of depth.</descrip></descripGrp><ntig><termGrp><term id="141226">drop shadow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442742">сенка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntr