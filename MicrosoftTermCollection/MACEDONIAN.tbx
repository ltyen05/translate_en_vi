ctronic coupon that can be bought from selected retail outlets to top up Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1810831">Skype voucher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058683">ваучер на Skype</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33708_1811255_2058686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A free internet call between two or more Skype users.</descrip></descripGrp><ntig><termGrp><term id="1811255">Skype-to-Skype call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2058686">Повик од Skype на Skype</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3371_142397_1372319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data-entry field on a page. A site visitor supplies information in a field either by typing text or by selecting a field.</descrip></descripGrp><ntig><termGrp><term id="142397">form field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1372319">поле на формулар</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammatica