icates that a user has assigned this contact to the Blocked Contacts privacy relationship.</descrip></descripGrp><ntig><termGrp><term id="1447396">Blocked</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2720039">Блокиран</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27772_1448163_2654484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Rules by which one must agree to abide by in order to use a service. The accompanying Microsoft software includes computer software and may include associated media, printed materials, “online” or electronic documentation, and Internet-based services for use with a Microsoft software product (collectively, the “ADD-IN SOFTWARE”).</descrip></descripGrp><ntig><termGrp><term id="1448163">terms of service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2654484">услови на услугата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27793_1464067_1868519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combined schedule of a number of people or resources.</descrip></descripGrp><ntig><termGrp><term id="1464067">group schedule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868519