 xml:lang="mk"><ntig><termGrp><term id="2775197">Услуги за компоненти</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1217_3131_1371377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An overlapped window used for dialog boxes, message boxes, and other temporary windows that appear outside an application's primary window.</descrip></descripGrp><ntig><termGrp><term id="3131">pop-up window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371377">скок-прозорец</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12171_151583_442213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process in which a consumer enters information, such as an email address, to acquire a license.</descrip></descripGrp><ntig><termGrp><term id="151583">registration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442213">регистрација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12172_2037680_2406818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of trojan that provides remote access to a computer.</descrip></descripGrp><ntig><termGrp><term id="2037680">remote access trojan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2406818">тројанец за далечински пристап</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12173_252122_1868206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A combination of table formatting options identified by a style name.</descrip></descripGrp><ntig><termGrp><term id="252122">table style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868206">стил на табела</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12174_71139_441678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Repeated execution of one or more statements or instructions. Statements or instructions so executed are said to be in a loop.</descrip></descripGrp><ntig><termGrp><term id="71139">iteration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441678">повторување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12175_11516_2305426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text string that appears in place of an image when a Web page is loading, when graphics are not being displayed, or when users pause on the image itself with their mouse.</descrip></descripGrp><ntig><termGrp><term id="11516">alt text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305426">алтернативен текст</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12175_749381_2305426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text string that appears in place of an image when a Web page is loading, when graphics are not being displayed, or when users pause on the image itself with their mouse.</descrip></descripGrp><ntig><termGrp><term id="749381">alternative text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2305426">алтернативен текст</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12180_237293_1868201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to access Outlook data over the Internet without a VPN connection.</descrip></descripGrp><ntig><termGrp><term id="237293">Outlook Anywhere</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868201">Outlook насе