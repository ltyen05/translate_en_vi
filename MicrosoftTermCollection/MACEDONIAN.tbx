pe="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52779_2997865_2999327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 11 that is based on Windows 11 Pro and optimized for Education customers and can be pre-installed on EDU devices.</descrip></descripGrp><ntig><termGrp><term id="2997865">Windows 11 Pro Education</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2999327">Windows 11 Pro Education</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52780_2997866_2999320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 11 targeting enterprise customers.</descrip></descripGrp><ntig><termGrp><term id="2997866">Windows 11 Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2999320">Windows 11 Enterprise</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52781_2997867_2999314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of the Windows 11 operating system that is available through a subscription targeting commercial customers.</descrip></descripGrp><ntig><termGrp><term id="2997867">Windows 11 Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2999314">Windows 11 Business</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52782_2997868_2999330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of the Windows 11 operating system that has been specifically optimized for workstations.</descrip></descripGrp><ntig><termGrp><term id="2997868">Windows 11 Pro for Workstations</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2999330">Windows 11 Pro for Workstations</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52783_2997869_2999325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of the Windows 11 operating system that targets business customers and comes pre-installed on devices.</descrip></descripGrp><ntig><termGrp><term id="2997869">Windows 11 Pro</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2999325">Windows 11 Pro</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52784_2997870_2999322"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of the Windows 11 operating system that targets consumers.</descrip></descripGrp><ntig><termGrp><term id="2997870">Windows 11 Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2999322">Windows 11 Home</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52785_2997871_2999310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version 11 of the Windows operating system.</descrip></descripGrp><ntig><termGrp><term id="2997871">Windows 11</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2999310">Windows 11</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52786_2998899_2999685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Costa Rican national holiday celebrated on December 1 to commemorate the day in 1948 on which then-President José Figueres Ferrer abolished the armed forces following the end of the Costa Rican Civil War.</descrip></descripGrp><ntig><termGrp><term id="2998899">Abolition of the Army</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2999685">Ден на расформирањето на армијата</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52787_2998900_2999686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The audio-centric user experience that enables Teams customers to catch up on communications, events, and activities when getting back online and to stay connected with work while being distracted from everyday chores.</descrip></descripGrp><ntig><termGrp><term id="2998900">Catch Me Up</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2999686">Информирај ме</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52788_2999688_3000003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Expressed in terms of a power of e; or, characterized by a rate of change that is proportional to the value of the varying quantity.</descrip></descripGrp><ntig><termGrp><term id="2999688">exponential</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3000003">експоненцијално</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52789_2999689_3000002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of a complex number, the number with a real part and an imaginary part equal in magnitude but opposite in sign; for example, if a and b are real, then the complex conjugate of a+bi is equal to a-bi.</descrip></descripGrp><ntig><termGrp><term id="2999689">complex conjugate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3000002">комплексна конјугација</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5279_95225_1371508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of 25 letters and numbers. To activate some software, you must enter a product key during the activation process.</descrip></descripGrp><ntig><termGrp><term id="95225">product key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371508">клуч за производ</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52790_2999690_3000004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mathematical object that can be interpreted as an area or a generalization of an area.</descrip></descripGrp><ntig><termGrp><term id="2999690">integral</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3000004">интеграл</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52793_3000145_3000303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person's default space in the Mesh app for HoloLens, private and only accessible by its owner.</descrip></descripGrp><ntig><termGrp><term id="3000145">home space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3000303">почетен простор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52794_3000146_3000286"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A space in which multiple people connect and collaborate together in the Mesh app for HoloLens.</descrip></descripGrp><ntig><termGrp><term id="3000146">collaborative space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3000286">простор за соработка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52795_3000147_3000314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location in mixed reality that persists, contains content (models, ink, images, etc), supports real-time presence of the members of the space, and can be bound to one (or more) locations in the real world.</descrip></descripGrp><ntig><termGrp><term id="3000147">space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet 