ip></descripGrp><ntig><termGrp><term id="3285">service pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441188">СП</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="476_3286_441187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tested, cumulative set of all hotfixes, security updates, critical updates and updates, as well as additional fixes for problems found internally since the release of the product. Service packs may also contain a limited number of customer requested design changes or features, and contain all fixes since the previous service pack or RTM.</descrip></descripGrp><ntig><termGrp><term id="3286">SP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441187">сервисен пакет</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="476_3286_441188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tested, cumulative set of all hotfixes, security updates, critical updates and updates, as well as additional fixes for problems found internally since the release of the product. Service packs may also contain a limited number of customer requested design changes or features, and contain all fixes since the previous service pack or RTM.</descrip></descripGrp><ntig><termGrp><term id="3286">SP</term><termNote type="partOfSpeech">Noun</termNote><ter