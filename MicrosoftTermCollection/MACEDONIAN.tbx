="mk"><ntig><termGrp><term id="2738486">испушта</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48379_2735259_2739252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyword that admins can add to a bookmark such that if it is used in a query, only that specific bookmark will display.</descrip></descripGrp><ntig><termGrp><term id="2735259">reserved keyword</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2739252">резервиран клучен збор</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48388_2735720_2739244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view that allows users to hunt for security threats by reviewing suspicious email and accounts and by searching devices for harmful content.</descrip></descripGrp><ntig><termGrp><term id="2735720">Hunting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2739244">Лов</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48389_2735730_2737995"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rectangular UI element on a dashboard that contains a report, alerts, and/or related actions and that can be moved or customized by the user.</descrip></descripGrp><ntig><termGrp><term id="2735730">card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2737995">картичка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48390_2735736_2739248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view contains a set of cards that contain information on security and compliance trends and that track the protection status of an organization’s identities, data, devices, apps, and infrastructure.</descrip></descripGrp><ntig><termGrp><term id="2735736">Monitoring &amp; reports</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2739248">Надзор и извештаи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48405_2736256_2740637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that initiates a proactive search for security threats.</descrip></descripGrp><ntig><termGrp><term id="2736256">Start hunting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2740637">Започни лов</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48406_2736257_2740615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The card that allows users to hunt for email related activities that put users and data at risk, and take action against the threats.</descrip></descripGrp><ntig><termGrp><term id="2736257">Email &amp; data</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2740615">Е-пошта и податоци</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48407_2736262_2740614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The card that allows users to hunt for activity that poses a security threat across devices using customizable queries.</descrip></descripGrp><ntig><termGrp><term id="2736262">Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2740614">Уреди</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48408_2736263_2740617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The card that allows users to hunt for suspicious account activity on your network.</descrip></descripGrp><ntig><termGrp><term id="2736263">Identity</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2740617">Идентитет</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48409_2736264_2740634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view that allows users to create policies and set up alerts regarding device usage, activities, security, data governance, and device management.</descrip></descripGrp><ntig><termGrp><term id="2736264">Policies</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2740634">Политики</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4841_174077_1943056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who is a member of the Domain Admins group. Domain administrators can create, delete, and manage all objects that reside within the domain in which they are administrators. They can also assign and reset passwords and delegate administrative authority for network resources to other trusted users.</descrip></descripGrp><ntig><termGrp><term id="174077">domain administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1943056">администратор на домен</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48417_2736689_2775168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person that sets up a collaboration session.</descrip></descripGrp><ntig><termGrp><term id="2736689">collaboration session host</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2775168">домаќин</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48417_2736690_2775168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person that sets up a collaboration session.</descrip></descripGrp><ntig><termGrp><term id="2736690">host</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2775168">домаќин</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48421_2736697_2740620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view in the Microsoft 365 security center and the Microsoft 365 compliance center where users can create and publish sensitivity and retention labels.</descrip></descripGrp><ntig><termGrp><term id="2736697">Labels</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2740620">Етикети</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48422_2736698_2740619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The  view in the Microsoft 365 security center and the Microsoft 365 compliance center where users can create and publish sensitivity and retention label policies.</descrip></descripGrp><ntig><termGrp><term id="2736698">Label policies</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2740619">Правила за етикети</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48423_2736699_2740635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view in the Microsoft 365 security center and the Microsoft 365 compliance center where users can view sensitive info types and their associated information.</descrip></descripGrp><ntig><termGrp><term id="2736699">Sensitivity info types</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2740635">Видови на осетливи информации</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48424_2736700_2740618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view in the Microsoft 365 security center and the Microsoft 365 compliance center where users can find information on how retention and sensitivity labels are being used to classify, retain, and protect their organization's content in the cloud.</descrip></descripGrp><ntig><termGrp><term id="2736700">Label analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2740618">Аналитика на етикети</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48425_2736701_2740633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view in the Microsoft 365 compliance center and the Microsoft 365 security center that allows admins to manage who in their organization has access to Microsoft 365 security center and is able to view content and perform tasks.</descrip></descripGrp><ntig><termGrp><term id="2736701">Permissions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2740633">Дозволи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48426_2736702_2740611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view in the Microsoft 365 security center and Microsoft 365 compliance center that displays alerts and their related information.</descrip></descripGrp><ntig><termGrp><term id="2736702">Alerts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2740611">Предупредувања</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48427_2736703_2740624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view in the Microsoft security center and the Microsoft 365 compliance center that provides easy access to additional resources to help manage security and compliance across an organization.</descrip></descripGrp><ntig><termGrp><term id="2736703">More resources</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2740624">Повеќе ресурси</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4843_112339_441932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A link to any item accessible on your computer or on a network, such as a program or application, file, folder, disk drive, printer, or another computer.</descrip></descripGrp><ntig><termGrp><term id="112339">shortcut</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441932">брз пристап</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4843_1276176_441932"><langSe