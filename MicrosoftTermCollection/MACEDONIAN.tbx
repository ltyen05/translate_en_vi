1099_441834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A route through a structured collection of information, as in a database, a program, or files stored on disk.</descrip></descripGrp><ntig><termGrp><term id="91099">path</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="441834">патека</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13151_318116_1371745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To align text along the right margin.</descrip></descripGrp><ntig><termGrp><term id="318116">right align</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1371745">порамнување од десно</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13159_34845_1953716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in each row of a database table that stores the data value for some attribute of the object modeled by the table.</descrip></descripGrp><ntig><termGrp><term id="34845">column</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1953716">колона</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><te