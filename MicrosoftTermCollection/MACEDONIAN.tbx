43894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status of an item in source control that reflects one or more changes from a previous form. The greater the version number, the more recent the version.</descrip></descripGrp><ntig><termGrp><term id="720346">version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1543894">верзија</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2023_136809_442084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A link that specifies a full path to a resource, such that the destination of the link doesn’t change based on where it is linking from.</descrip></descripGrp><ntig><termGrp><term id="136809">absolute link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="442084">апсолутна врска</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20243_721657_1868340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A drop-down button that performs a default action and can also expand to a list of other possible actions.</descrip></descripGrp><ntig><termGrp><term id="721657">split button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868340">копче за поделба</term><termNote type=