ermNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2346259">PBX во облак</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40309_2710192_2713444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft technology for enabling call control and PBX capabilities in the Office 365 cloud with Skype for Business Online and Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="2710192">Office 365 Phone System</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2713444">Телефонски систем</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40310_2345004_2346994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that ensures that no one at Microsoft can access customer content to perform a service operation without the customer’s explicit approval.</descrip></descripGrp><ntig><termGrp><term id="2345004">Customer Lockbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2346994">Безбедно сандаче за клиентот</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40311_2429250_2591932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft service that shows users how they spend their work time, including time by categories like meetings, email, focus hours, and after hours work as well as network insights such as top collaborators and contacts with whom users may be losing touch.</descrip></descripGrp><ntig><termGrp><term id="2429250">Microsoft MyAnalytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2591932">Моја аналитика</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40311_2588076_2591932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft service that shows users how they spend their work time, including time by categories like meetings, email, focus hours, and after hours work as well as network insights such as top collaborators and contacts with whom users may be losing touch.</descrip></descripGrp><ntig><termGrp><term id="2588076">MyAnalytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2591932">Моја аналитика</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40312_2653175_2654486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook add-in that provides email statistics such as read percentages, number of forwards, and average reply time.</descrip></descripGrp><ntig><termGrp><term id="2653175">MyAnalytics Outlook add-in</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2654486">Додаток во Outlook за MyAnalytics</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40315_2345366_2346751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Universal Windows app that allows a person to add credit cards that can be used to pay for things with their phones using NFC. The app can also be used to save loyalty cards, coupons, boarding passes, and event tickets.</descrip></descripGrp><ntig><termGrp><term id="2345366">Microsoft Wallet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2346751">Паричник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40315_2354807_2346751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Universal Windows app that allows a person to add credit cards that can be used to pay for things with their phones using NFC. The app can also be used to save loyalty cards, coupons, boarding passes, and event tickets.</descrip></descripGrp><ntig><termGrp><term id="2354807">Wallet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2346751">Паричник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40340_2345583_2349926"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The functionality that translates the drawing speed of an object on a touch-screen device into thickness of the line on the screen--the higher the speed, the thicker the line.</descrip></descripGrp><ntig><termGrp><term id="2345583">Velocity Ink</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2349926">Брзо пишување</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40341_2345591_2346749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark a location on a map by interacting directly with the map, instead of searching for an address or place name.</descrip></descripGrp><ntig><termGrp><term id="2345591">drop a pin</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2346749">стави игличка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40342_2345592_2346752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location marker that users can manually add to a map, so they can see it on the map and get additional location info and directions.</descrip></descripGrp><ntig><termGrp><term id="2345592">pin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2346752">игличка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40343_2345593_2349918"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the owner of a collection of content.</descrip></descripGrp><ntig><termGrp><term id="2345593">curated by</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2349918">курирал</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40344_2345594_2349917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To collect content and present it together.</descrip></descripGrp><ntig><termGrp><term id="2345594">curate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="2349917">курира</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40345_2345596_2346754"><langSet xml:lang="en-US"><descripGrp><de