ote></termGrp></ntig></langSet></termEntry><termEntry id="55134_3126370_3126936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The acknowledgment of a contributor's services, typically a list of names, that is displayed at the end of a video.</descrip></descripGrp><ntig><termGrp><term id="3126370">end credit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3126936">шпица</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55134_3126370_3126947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The acknowledgment of a contributor's services, typically a list of names, that is displayed at the end of a video.</descrip></descripGrp><ntig><termGrp><term id="3126370">end credit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3126947">одјавна шпица</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5514_174436_1868122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who uses a computer that is not connected to a network. A local user is most likely someone using a computer at home.</descrip></descripGrp><ntig><termGrp><term id="174436">local user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868122">локален корисник</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5515_102469_1868000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication mechanism that allows computers to communicate with one another over a network. An RPC consists of a procedure identifier, parameters passed to the procedure, and a value returned to the caller (client computer) after the procedure has executed on the remote system (server computer).</descrip></descripGrp><ntig><termGrp><term id="102469">remote procedure call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868000">RPC</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5515_102470_1868000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication mechanism that allows computers to communicate with one another over a network. An RPC consists of a procedure identifier, parameters passed to the procedure, and a value returned to the caller (client computer) after the procedure has executed on the remote system (server computer).</descrip></descripGrp><ntig><termGrp><term id="102470">RPC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="1868000">RPC</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55151_3126498_3127030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI service which can identify information specified by a user in a set of files and pull matching information out of similar files automatically.</descrip></descripGrp><ntig><termGrp><term id="3126498">freeform document processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3127030">обработка на документи во слободна форма</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55152_3126499_3127041"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that can identify types of files and specific information in them after someone labels the files and provides explanations.</descrip></descripGrp><ntig><termGrp><term id="3126499">unstructured document processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3127041">обработка на неструктурирани документи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55153_3126500_3127042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of services that capture, transform, and process data from documents.</descrip></descripGrp><ntig><termGrp><term id="3126500">intelligent document processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3127042">обработка на интелигентни документи</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55154_3126501_3126968"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security solution designed to safeguard end-to-end communication and collaboration for organizations using Microsoft tools like Teams and Outlook.</descrip></descripGrp><ntig><termGrp><term id="3126501">Microsoft Defender for Collaboration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3126968">Defender за соработка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55154_3126501_3127043"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security solution designed to safeguard end-to-end communication and collaboration for organizations using Microsoft tools like Teams and Outlook.</descrip></descripGrp><ntig><termGrp><term id="3126501">Microsoft Defender for Collaboration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mk"><ntig><termGrp><term id="3127043">Microsoft Defender за соработка</term><termNote type="geographicalUsage">MKD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</t