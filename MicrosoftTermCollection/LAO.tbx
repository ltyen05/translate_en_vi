242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view in the Microsoft 365 compliance center and the Microsoft 365 security center that allows admins to manage who in their organization has access to Microsoft 365 security center and is able to view content and perform tasks.</descrip></descripGrp><ntig><termGrp><term id="2736701">Permissions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2746242">ສິດອະນຸຍາດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48426_2736702_2746224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view in the Microsoft 365 security center and Microsoft 365 compliance center that displays alerts and their related information.</descrip></descripGrp><ntig><termGrp><term id="2736702">Alerts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2746224">ການເຕືອນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48427_2736703_2746239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view in the Microsoft security center and the Microsoft 365 compliance center that provides easy access to additional resources to help manage security and compliance across an organization.</descrip></descripGrp><ntig><termGrp><term id="2736703">More resources</term><termNote type="partO