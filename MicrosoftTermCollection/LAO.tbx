rmNote></termGrp></ntig></langSet></termEntry><termEntry id="26000_1256411_3183304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft program designed to provide a consistent experience for Microsoft partners to obtain real-world customer feedback on Microsoft pre-release products.</descrip></descripGrp><ntig><termGrp><term id="1256411">TAP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3183304">Technology Adoption Program</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26004_1256406_2162933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short summary of the contents of a document that gives the reader a quick overview of its topic and purpose.</descrip></descripGrp><ntig><termGrp><term id="1256406">abstract</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162933">ບົດ​ຄັດ​ຫຍໍ້</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26050_1262328_2803248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To merge information from multiple places into one.</descrip></descripGrp><ntig><termGrp><term id="1262328">consolidate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2803248">ຮວມເຂົ້າກັນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26073_1262378_2163341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that incorporates elements of social networking into the Outlook experience. It provides relevant contextual information about the people whom users interact with in Outlook, based on local data (email and calendar items) and social activity (news feeds and status updates).</descrip></descripGrp><ntig><termGrp><term id="1262378">Outlook Social Connector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163341">OSC</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26073_1262378_2302316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that incorporates elements of social networking into the Outlook experience. It provides relevant contextual information about the people whom users interact with in Outlook, based on local data (email and calendar items) and social activity (news feeds and status updates).</descrip></descripGrp><ntig><termGrp><term id="1262378">Outlook Social Connector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302316">Outlook Social Connector</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26073_1262401_2163341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that incorporates elements of social networking into the Outlook experience. It provides relevant contextual information about the people whom users interact with in Outlook, based on local data (email and calendar items) and social activity (news feeds and status updates).</descrip></descripGrp><ntig><termGrp><term id="1262401">OSC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163341">OSC</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26073_1262401_2302316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that incorporates elements of social networking into the Outlook experience. It provides relevant contextual information about the people whom users interact with in Outlook, based on local data (email and calendar items) and social activity (news feeds and status updates).</descrip></descripGrp><ntig><termGrp><term id="1262401">OSC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302316">Outlook Social Connector</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26074_1262379_2302338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pane in Outlook that displays a selected contact along with relevant information (photos, status messages or feeds, calendar items, etc.) from Outlook and other networks.</descrip></descripGrp><ntig><termGrp><term id="1262379">People Pane</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302338">ແຖບລາຍຊື່ຜູ້ຕິດຕໍ່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26075_1262380_2301997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that displays a profile photo of everyone who is part of an email thread or calendar item.</descrip></descripGrp><ntig><termGrp><term id="1262380">Gallery View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301997">ມຸມມອງຫ້ອງສະໝຸດພາບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2608_30533_2162891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of characters that have some relationship in common.</descrip></descripGrp><ntig><termGrp><term id="30533">character set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162891">ຊຸດ​ຕົວ​ອັກ​ສອນ</term><te