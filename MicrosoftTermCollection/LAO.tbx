grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42829_2428723_2431591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The task pane (in Office and other programs) where users can view a translation of other content and control the settings for that translation.</descrip></descripGrp><ntig><termGrp><term id="2428723">Translator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2431591">ຕົວແປພາສາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42832_2429234_2433703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word feature that supports the use of LaTeX math equations.​​</descrip></descripGrp><ntig><termGrp><term id="2429234">LaTeX Equations</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2433703">ສົມຜົນ LaTeX</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42833_2429242_2433704"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SharePoint feature that allows users to post news articles to a team site or a group, so that those articles show up on the homepage and News page of the site or group.</descrip></descripGrp><ntig><termGrp><term id="2429242">News</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber"