p><ntig><termGrp><term id="3175662">survey</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3176150">ການສໍາຫຼວດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56494_3181099_3181142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft AI-powered assistant that allows users to browse the web with both simple and complex questions.</descrip></descripGrp><ntig><termGrp><term id="3181099">Microsoft Copilot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3181142">Microsoft Copilot</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56495_3177416_3177687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image filter that adds cool (blue tints) to the image by slightly decreasing the temperature and increasing the contrast.</descrip></descripGrp><ntig><termGrp><term id="3177416">punch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3177687">ພັນຊ໌</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56496_3177417_3177689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that changes the layout and/or shape of text on canvas.</descrip></descripGrp><ntig><termGrp><term id="3177417">transform</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3177689">ການແປງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56497_3177422_3177686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To arrange objects within a canvas, bring to front/forward, send to back/backward.</descrip></descripGrp><ntig><termGrp><term id="3177422">position</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3177686">ຈັດຕໍາແໜ່ງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56498_3177423_3177688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to edit content in the transcript and view the changes applied to their video/audio accordingly​.</descrip></descripGrp><ntig><termGrp><term id="3177423">transcript editing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3177688">ການແກ້ໄຂການຖອດຄວາມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Nou