calUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24057_1098418_2302568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of statistics that indicates the degree to which a service meets performance, usage, and other demands for the service.</descrip></descripGrp><ntig><termGrp><term id="1098418">service quality metrics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302568">ມາດຕາວັດຄຸນນະພາບບໍລິການ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2407_73729_2179454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, the order and sequence of input and output.</descrip></descripGrp><ntig><termGrp><term id="73729">layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179454">ແຜນຜັງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2407_73729_465322"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, the order and sequence of input and output.</descrip></descripGrp><ntig><termGrp><term id="73729">layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp><