_2163599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An address that uniquely identifies a location on the Internet. A URL is usually preceded by http://, as in http://www.microsoft.com. A URL can contain more detail, such as the name of a page of hypertext, often with the file name extension .html or .htm.</descrip></descripGrp><ntig><termGrp><term id="125493">web address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163599">URL</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14889_87410_2162522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that supports the OLE protocol for object linking and embedding.</descrip></descripGrp><ntig><termGrp><term id="87410">OLE object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162522">ວັດ​ຖຸ OLE</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14893_397167_2793735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filtering list that is used by the Connection Filter agent in Exchange Server 2007. IP addresses on the IP Allow list are considered "safe" and are exempted from processing by other anti-spam agents.</descrip></descripGrp><ntig><termGrp><term id="397167">IP Allow list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singul