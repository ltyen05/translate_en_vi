rmNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2786069">SUBARRAY</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49163_2785251_2785846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that fixes spelling errors and typos.</descrip></descripGrp><ntig><termGrp><term id="2785251">autocorrect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2785846">ແກ້ໄຂອັດຕະໂນມັດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49164_2785276_2785848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The window displays that displays all of the classes of references and components added to the current project as well as the methods, properties, and events of those classes.</descrip></descripGrp><ntig><termGrp><term id="2785276">Object Browser</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2785848">ອອບເຈັກບຣາວເຊີ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49170_2785561_2789424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A body of proof that is to be presented in a legal proceeding to convince a judge or jury of alleged facts in a case.</descrip></descripGrp><ntig><termGrp><term id="2785561">evidence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2789424">ຫຼັກຖານ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49171_2785562_2789427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of documents that a user has grouped together as evidence in a data investigation.</descrip></descripGrp><ntig><termGrp><term id="2785562">evidence set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2789427">ຊຸດຫຼັກຖານ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49172_2785564_2789429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that allows users to send encrypted email messages to any recipient on the Internet and that provides admins with the ability to apply multiple custom email templates, as well as the ability to expire and revoke encrypted emails accessed through the Office 365 web portal.</descrip></descripGrp><ntig><termGrp><term id="2785564">Office 365 Advanced Message Encryption</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></lan