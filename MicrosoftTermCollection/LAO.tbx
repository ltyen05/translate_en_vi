<termEntry id="31800_2686115_2302093"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of learning that addresses a portion of the content for a class and may include assignments, materials, and other lessons.</descrip></descripGrp><ntig><termGrp><term id="2686115">unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302093">ບົດຮຽນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31801_1624315_2302102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A layout that is updated in real time as an object on the page is moved, resized, or rotated, enabling the user to preview the end result before the action is completed.</descrip></descripGrp><ntig><termGrp><term id="1624315">live layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302102">ໂຄງຮ່າງແບບສົດໆ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31802_1624316_2302113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that turns on change tracking and lets you set a password to prevent unauthorized users from turning it off.</descrip></descripGrp><ntig><termGrp><term id="1624316">Lock Tracking</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><te