">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2526598">ການປ້ອງກັນຊອບແວຮ້າຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44799_2520749_2526595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer file format designed to store three-dimensional data that are described as a collection of polygons.</descrip></descripGrp><ntig><termGrp><term id="2520749">PLY</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2526595">PLY</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="448_93293_465471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An input device used to control an on-screen cursor for such actions as "pressing" on-screen buttons in dialog boxes, choosing menu items, and selecting ranges of cells in spreadsheets or groups of words in a document.</descrip></descripGrp><ntig><termGrp><term id="93293">pointing device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465471">ອຸປະກອນຊີ້ຕຳແໜ່ງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44800_2520756_2526594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An open file format created as a simple way to import and export geometry from different 3D applications.</descrip></descripGrp><ntig><termGrp><term id="2520756">OBJ</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2526594">OBJ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44803_2521100_2674034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The framework that consists of a web part and a page that provides full support for client-side SharePoint development, easy integration with SharePoint data, and support for open source tooling so that developers can use their preferred tools and technologies.</descrip></descripGrp><ntig><termGrp><term id="2521100">SharePoint Framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2674034">SPFx</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44803_2673786_2674034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The framework that consists of a web part and a page that provides full support for client-side SharePoint development, easy integration with SharePoint data, and support for open source tooling so that developers can use their preferred tools and technologies.</descrip></descripGrp><ntig><termGrp><term id="2673786">SPFx</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2674034">SPFx</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44804_2521102_2523000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of benefits provided to developers for creating software on a particular platform after they register for membership, and which may include access to software and information not available to people who have not registered.</descrip></descripGrp><ntig><termGrp><term id="2521102">developer program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2523000">ໂປຣແກຣມນັກພັດທະນາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44805_2521104_2523002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The developer program for Microsoft Office that provides members access to trainings and office hours with Microsoft engineers, plus chances to win tickets to events.</descrip></descripGrp><ntig><termGrp><term id="2521104">Microsoft Office Developer Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2523002">ໂປຣແກຣມນັກພັດທະນາ Microsoft Office</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44809_2521577_2523978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel add-in that finds functions needed to transform and format data when the user gives it examples of the desired output.</descrip></descripGrp><ntig><termGrp><term id="2521577">Transform Data by Example</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2523978">Transform Data by Example</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44810_2521581_2525916"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A membership where admittance is based on rules, making it easy for administrators to manage large groups.</descrip></descripGrp><ntig><termGrp><term id="2521581">dynamic membership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2525916">ການເປັນສະມາຊິກໄດນາມິກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44811_2521582_2525915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group where membership is maintained by a set of rules created by an administrator.</descrip></descripGrp><ntig><termGrp><term id="2521582">dynamic group</term><termNot