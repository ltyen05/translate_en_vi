termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162948">ເຊ​ລ​ໃກ້​ຄຽງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29098_1506441_2162974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text or number that identifies the categories or the scaling of an axis. The axis label usually appears below or to the left of the axis.</descrip></descripGrp><ntig><termGrp><term id="1506441">axis label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162974">ປ້າຍ​ໝາຍ​ແກນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29106_1506637_2163058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A region within a page layout that is populated dynamically with the value of the publishing page field to which it is bound.</descrip></descripGrp><ntig><termGrp><term id="1506637">content placeholder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163058">ເຄື່ອງ​ໝາຍ​ກຳ​ກັບ​ເນື້ອ​ໃນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2912_132835_2302762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search for data in a table or field using placeholders (such as * or ?).</descrip></descripGrp><ntig><termGrp><term id="132835">wildcard search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302762">ການຊອກຫາດ້ວຍໂຕອັກສອນໂຕແທນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29124_1506666_2163078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The authenticated user during processing operations in a front-end Web server and a back-end database server.</descrip></descripGrp><ntig><termGrp><term id="1506666">current user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163078">ຜູ້​ໃຊ້​ປະ​ຈຸ​ບັນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29132_1506687_3145840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sort order in which text strings are arranged in reverse alphabetical order, numerical values are arranged from largest to smallest, and dates and times are arranged from newest to oldest.</descrip></descripGrp><ntig><termGrp><term id="1506687">descending order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3145840">Z ຫາ A</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29132_3145165_3145840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sort order in which text strings are arranged in reverse alphabetical order, numerical values are arranged from largest to smallest, and dates and times are arranged from newest to oldest.</descrip></descripGrp><ntig><termGrp><term id="3145165">Z to A</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3145840">Z ຫາ A</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29136_1506697_2163142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference to a cell, range, defined name, or other object in another worksheet or workbook.</descrip></descripGrp><ntig><termGrp><term id="1506697">external reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163142">ການ​ອ້າງ​ອີງ​ທາງນອກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29137_1506700_2163143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A workbook, other than the active workbook, that is on disk or in memory and to which a dependency is implied or intended.</descrip></descripGrp><ntig><termGrp><term id="1506700">external workbook</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163143">ປຶ້ມ​ຕາ​ຕະ​ລາງ​ທາງນອກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29146_1636440_2302466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A source that returns a set of search results for a given search query. The source can be a search service in the local server farm or another server farm, or another search engine that is compliant with the OpenSearch protocol.</descrip></descripGrp><ntig><termGrp><term id="1636440">result source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302466">ແຫລ່ງທີ່ມີຂອງຜົນການຊອກຫາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29149_1506722_2308197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container for items that are deleted. Items in this container are visible to users with the appropriate permissions and to site collection administrators.</descrip></descripGrp><ntig><termGrp><term id="1506722">first-stage Recycle Bin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2308197">ກະຕ່າຂີ້ເຫຍື້ອຊັ້ນທຳອິດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29157_1506741_2163209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column that does not appear in a worksheet view because its width is set to zero (0). A column can be hidden if an outline is collapsed.</descrip></descripGrp><ntig><termGrp><term id="1506741">hidden column</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163209">ຖັນ​ເຊື່ອງ​ໄວ້</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29158_1506742_2163210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A row that does not appear in a worksheet view because its height is set to zero (0). A row can be hidden if a user is filtering or if an outline is collapsed.</descrip></descripGrp><ntig><termGrp><term id="1506742">hidden row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163210">ແຖວ​ເຊື່ອງ​ໄວ້</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29160_1506744_2163217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formatting setting that specifies how content is positioned within the horizontal space of a cell, object, or page. Content can be aligned along the left or right edge, or distributed evenly across the horizontal space.</descrip></descripGrp><ntig><termGrp><term id="1506744">horizontal alignment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163217">ການ​ຈັດ​ຕາມ​ລວງ​ຂວາງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29172_1506757_2163257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition of a paragraph that specifies which numbering system and indentation to use, relative to other paragraphs in a bulleted or numbered list.</descrip></descripGrp><ntig><termGrp><term id="1506757">list level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163257">ລະ​ດັບ​ລາຍ​ການ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29193_1644672_2302219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part that renders named objects or named items in a workbook, such as tables, charts, slicers or a named range of cells.</descrip></descripGrp><ntig><termGrp><term id="1644672">named item view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302219">ມຸມມອງລາຍການທີ່ຕັ້ງຊື່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29197_1506783_2163310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form that allows for the creation of a list item.</descrip></descripGrp><ntig><termGrp><term id="1506783">new form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163310">ແບບ​ຟອມ​ໃໝ່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29211_1506797_2163377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user interface element that displays a list of all PivotTable® fields. A PivotTable field list can be used to populate a PivotTable report and to manipulate the fields.</descrip></descripGrp><ntig><termGrp><term id="1506797">PivotTable field list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163377">ລາຍ​ການ​ບ່ອນ​ປ້ອນ​ຂໍ້​ມູນ PivotTable</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29229_1506817_2163407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A result for a given query, which contains the title and URL of the item, and can also contain other managed properties and a hit-highlighted summary.</descrip></descripGrp><ntig><termGrp><term id="1506817">query result</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNot