/Statistical Excel function that returns the confidence interval for a population mean.</descrip></descripGrp><ntig><termGrp><term id="2955536">CONFIDENCE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2970826">CONFIDENCE</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52325_2955537_2970827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Statistical Excel function that returns the confidence interval for a population mean.</descrip></descripGrp><ntig><termGrp><term id="2955537">CONFIDENCE.NORM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2970827">CONFIDENCE.NORM</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52326_2955538_2970828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Statistical Excel function that returns the confidence interval for a population mean, using a Student's t distribution.</descrip></descripGrp><ntig><termGrp><term id="2955538">CONFIDENCE.T</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2970828">CONFIDENCE.T</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammati