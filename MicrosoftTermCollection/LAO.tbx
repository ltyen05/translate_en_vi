rent program or process to another program or process that the parent causes to run.</descrip></descripGrp><ntig><termGrp><term id="1098902">inheritance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2687198">ການຮັບຊ່ວງຕໍ່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24125_1098903_2149431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that an administrator, parent, or guardian can view showing children's or family members' online activity.</descrip></descripGrp><ntig><termGrp><term id="1098903">activity report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149431">ລາຍ​ງານ​ກິດ​ຈະ​ກຳ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24131_1098934_2149435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Content for mature audiences.</descrip></descripGrp><ntig><termGrp><term id="1098934">adult content</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149435">ເນື້ອ​ໃນ​ສຳ​ລັບ​ຜູ້​ໃຫຍ່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig