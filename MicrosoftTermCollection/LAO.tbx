te type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51979_2929085_2929128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Part of the Microsoft Viva family of employee experience offerings, it is a central hub for learning where people can discover, share, assign, and learn from best-in-class content libraries across the organization—including LinkedIn Learning, Microsoft Learn, third-party content providers, and an organization’s own custom content—to help teams and individuals to make learning a natural part of their day.</descrip></descripGrp><ntig><termGrp><term id="2929085">Learning</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2929128">Learning</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51981_2926576_2927099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to convert the image to text with screenshare during a Microsoft Teams meeting (the ability for meeting attendees to digitize and interact with text and URLs on the Teams meeting stage).</descrip></descripGrp><ntig><termGrp><term id="2926576">screen share scanner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2927099">ຕົວສະແກນການແບ່ງປັນໜ້າຈໍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51982_2926577_2927094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Teams service that simplifies the communications services acquisition and adoption process for business customers, providing the option to provision/deprovision phone numbers and (eventually) acquire/obtain capabilities from certified Carriers, all through the Teams Admin Center.</descrip></descripGrp><ntig><termGrp><term id="2926577">Operator Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2927094">ເຊື່ອມຕໍ່ຜູ້ປະຕິບັດງານ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51983_2926579_2927087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tab in Microsoft Teams that allows the user to create, manage, and share approval requests such as stakeholder authorizations, customer signatures, or manager acknowledgements.</descrip></descripGrp><ntig><termGrp><term id="2926579">Approvals</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2927087">ການອະນຸມັດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51984_2926583_2927089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Teams, the way to present in which only the shared content itself is shown.</descrip></descripGrp><ntig><termGrp><term id="2926583">Content only</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2927089">ເນື້ອຫາເທົ່ານັ້ນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51985_2926584_2927101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Teams, option in Presenter Mode in which the shared content is shown as a background to the video of the presenter.</descrip></descripGrp><ntig><termGrp><term id="2926584">Standout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2927101">ເນື້ອຫາໂດດເດັ່ນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51986_2926585_2927093"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The preview version of the Learning app in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="2926585">Learning (Preview)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2927093">ກໍາລັງຮຽນຮູ້ (ຕົວຢ່າງ)</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51987_2926606_2927091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state of work in which one is able to focus completely on a task without distraction.</descrip></descripGrp><ntig><termGrp><term id="2926606">deep work</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2927091">ການເຮັດວຽກແບບມີສະມາທິ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52001_2928689_2928857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security feature that helps users identify a sign-in option to verify a supplemental signal in the background while they provide their credentials.</descrip></descripGrp><ntig><termGrp><term id="2928689">additional factor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2928857">ປັດໃຈເພີ່ມເຕີມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52002_2928699_2928859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Edge feature that helps users solve math problems and shows them the step-by-step solution.</descrip></descripGrp><ntig><termGrp><term id="2928699">Math Solver</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2928859">ຕົວແກ້ບັນຫາຄະນິດສາດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52003_2928705_2928858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The browsing mode within Microsoft Edge that is dedicated for kids, containing kid-friendly and age-appropriate content with safety guardrails.</descrip></descripGrp><ntig><termGrp><term id="2928705">Kids Mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2928858">ໂໝດເດັກນ້ອຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52004_2928726_2928862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature package of web-dependent Windows experiences that is serviced/deployed through the Microsoft Store.</descrip></descripGrp><ntig><termGrp><term id="2928726">Windows Web Experience Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2928862">ຊຸດປະສົບການເວັບໄຊ Windows</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52005_2929086_2929126"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Bookings user with an admin role.</descrip></descripGrp><ntig><termGrp><term id="2929086">Bookings admin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2929126">ຜູ້ເບິ່ງແຍງ Bookings</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52006_2929515_2929595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Server file sharing feature that allows users to set caps on the portion of network capacity taken up by traffic using the SMB protocol.</descrip></descripGrp><ntig><termGrp><term id="2929515">SMB bandwidth limit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2929595">ການຈໍາກັດແບນວິດ SMB</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52008_2929517_2929596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows feature that uses hardware virtualization to create and isolate a secure region of memory from the normal operating system which can be used to host security solutions.</descrip></descripGrp><ntig><termGrp><term id="2929517">virtualization-based security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2929596">VBS</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52008_2929517_2929597"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows feature that uses hardware virtualization to create and isolate a secure region of memory from the normal operating system which can be used to host security solutions.</descrip></descripGrp><ntig><termGrp><term id="2929517">virtualization-based security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2929597">ຄວາມປອດໄພຜ່ານການເຮັດໃຫ້ສະເໝືອນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52008_2929518_2929596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows feature that uses hardware virtualization to create and isolate a secure region of memory from the normal operating system which can be used to host security solutions.</descrip></descripGrp><ntig><termGrp><term id="2929518">VBS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2929596">VBS</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52008_2929518_2929597"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows feature that uses hardware virtualization to create and isolate a secure region of memory from the normal operating system which can be used to host security solutions.</descrip></descripGrp><ntig><termGrp><term id="2929518">VBS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2929597">ຄວາມປອດໄພຜ່ານການເຮັດໃຫ້ສະເໝືອນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52010_2929644_2929877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To respond to an invitation and indicate whether or not you plan to attend the event that the invitation is for.</descrip></descripGrp><ntig><termGrp><term id="2929644">RSVP</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2929877">ກະລຸນາຕອບກັບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5202_335537_2302506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual folder that displays items based on specified search criteria.</descrip></descripGrp><ntig><termGrp><term id="335537">search folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302506">ຊອກຫາໂຟນເດີ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52029_2929967_2930145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer security mechanism that consists of a second stack that “shadows” the call stack to enforce integrity on return addresses.</descrip></descripGrp><ntig><termGrp><term id="2929967">shadow stack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2930145">ສະແຕັກເງົາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52030_2929997_2930345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Project Server that a customer can run on-premises, for which Microsoft will provide ongoing support and updates for as long as the subscription is current/valid.</descrip></descripGrp><ntig><termGrp><term id="2929997">Project Server Subscription Edition</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2930345">ສະບັບສະໝັກໃຊ້ Project Server</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52031_2929998_2930332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Office perpetual for Commercial that includes the traditional suite of classic apps such as Word, Excel, PowerPoint, and other apps, sold as a one-time purchase, without any major feature updates.</descrip></descripGrp><ntig><termGrp><term id="2929998">Office LTSC</term><termNote type="partOfSpeech">ProperNoun</termNo