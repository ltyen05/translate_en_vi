 updates on progress.</descrip></descripGrp><ntig><termGrp><term id="2393978">Microsoft Planner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2517849">Planner</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40619_2357847_2366948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The drop-down menu that gives users the option of filtering messages in their inbox by “Unread” or “Flagged” items.</descrip></descripGrp><ntig><termGrp><term id="2357847">Quick Filters for message list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2366948">ກັ່ນຕອງດ່ວນສຳລັບລາຍຊື່ຂໍ້ຄວາມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40620_2357848_2360105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that gives users the option of filtering messages in their inbox by “Unread” or “Flagged” items.</descrip></descripGrp><ntig><termGrp><term id="2357848">Quick Filters</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2360105">ກັ່ນຕອງດ່ວນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40621_2357849_2360104"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to tag emails by using # followed by a keyword within the message and that enables users to view all emails tagged with that keyword in their email account.</descrip></descripGrp><ntig><termGrp><term id="2357849">Hashtags</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2360104">ແຮຊແທັກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40632_2358041_2360266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category of apps or games that are selected based on downloads, usage, and revenue over a 7-day period and ranks them according to those metrics.</descrip></descripGrp><ntig><termGrp><term id="2358041">Most popular</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2360266">ຍອດນິຍົມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40633_2358042_2360265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category for items that are in the top 1000 items based on sales.</descrip></descripGrp><ntig><termGrp><term id="2358042">Best selling</term><termNote type="partOfSpeech">ProperNoun</termNote