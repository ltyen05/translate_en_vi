 type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3010441">ໂໝດເຕັມໜ້າຈໍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21431_777465_3010441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to capture the entire screen, similar to pressing PRINT SCREEN.</descrip></descripGrp><ntig><termGrp><term id="777465">Full-screen Snip</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3010441">ໂໝດເຕັມໜ້າຈໍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21438_3007380_3010442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to draw a precise line, or rectangle, around an object that you want to capture.</descrip></descripGrp><ntig><termGrp><term id="3007380">Rectangle mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3010442">ໂໝດສີ່ແຈສາກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21438_777472_3010442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to