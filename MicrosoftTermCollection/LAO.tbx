id="14901_152051_465833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The points where playback of a file or clip begins and ends. There are two trim points: start trim point and end trim point.</descrip></descripGrp><ntig><termGrp><term id="152051">trim points</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465833">ຈຸດຕັດຕໍ່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14905_318357_466530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &gt; character.</descrip></descripGrp><ntig><termGrp><term id="318357">greater than sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466530">ເຄື່ອງໝາຍໃຫຍ່ກວ່າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14905_318422_466530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &gt; character.</descrip></descripGrp><ntig><termGrp><term id="318422">right angle bracket</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466530">ເຄື່ອງໝາຍໃຫຍ່ກວ່າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14905_318751_466530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &gt; character.</descrip></descripGrp><ntig><termGrp><term id="318751">GREATER-THAN SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466530">ເຄື່ອງໝາຍໃຫຍ່ກວ່າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14906_397175_2302132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database for storing mailboxes in Exchange Server. The mailbox database manages the data in mailboxes, tracks deleted messages and mailbox sizes, and assists in message transfers. A mailbox database is stored as an Exchange database (.edb) file.</descrip></descripGrp><ntig><termGrp><term id="397175">mailbox database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302132">ຖານຂໍ້ມູນກ່ອງອີເມວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14908_2254367_2163534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agreement in which a customer prepays for periodic or regular services.</descrip></descripGrp><ntig><termGrp><term id="2254367">in-app subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><ter