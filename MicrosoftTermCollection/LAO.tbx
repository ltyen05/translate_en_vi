gSet></termEntry><termEntry id="14661_132278_2302756"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web hosting and Internet service provider who manages the Web server hardware and software required to make a Web site available on the Internet.</descrip></descripGrp><ntig><termGrp><term id="132278">web presence provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302756">ຜູ້ໃຫ້ບໍລິການສະຖານະເວັບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14661_1508998_2302756"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web hosting and Internet service provider who manages the Web server hardware and software required to make a Web site available on the Internet.</descrip></descripGrp><ntig><termGrp><term id="1508998">WPP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302756">ຜູ້ໃຫ້ບໍລິການສະຖານະເວັບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14677_258947_466182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Multimedia content in software, on CD-ROM, or on a Web site that purports to educate the user as well as entertain.</descrip></descripGrp><ntig><termGrp><term id="258947">edutainment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></la