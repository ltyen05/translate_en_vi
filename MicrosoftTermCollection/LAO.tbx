n who can change settings for apps, services, users, subscriptions, and/or devices.</descrip></descripGrp><ntig><termGrp><term id="746527">administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149632">ຜູ້​ຄວບ​ຄຸມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20734_746528_2149633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft account that manages a subscription.</descrip></descripGrp><ntig><termGrp><term id="746528">administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149633">ຜູ້​ຄວບ​ຄຸມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20735_746529_2149517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The computers that share a OneCare subscription.</descrip></descripGrp><ntig><termGrp><term id="746529">OneCare circle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149517">ວົງ​ມົນ OneCare</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20740_2589732_2149634"><l