"grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52732_2956710_2963612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To multiply on the left by one element and on the right by its inverse.</descrip></descripGrp><ntig><termGrp><term id="2956710">conjugate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2963612">ຮວມເປັນຄູ່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52733_2956711_2963635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Denoting different kinds of mutual relation, often with reference to the substitution of reciprocals for given quantities.</descrip></descripGrp><ntig><termGrp><term id="2956711">reciprocal</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2963635">ເລກປີ້ນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52734_2956714_2963626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To subject to the operation of finding the integral of a function.</descrip></descripGrp><ntig><termGrp><term id="2956714">Integrate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2963626">ຮວມເຂົ້າ</term><termNote type="geograp