<langSet xml:lang="lo"><ntig><termGrp><term id="2951621">LTSC</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40477_2733045_2953912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The servicing option in which new feature upgrades are available for installation after first published by Microsoft, enabling long-term deployment of selected releases in low-change configurations. The minimum length of servicing lifetime is approximately 10 years.</descrip></descripGrp><ntig><termGrp><term id="2733045">LTSC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2953912">ຊ່ອງບໍລິການໄລຍະຍາວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40497_2352186_2354007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature set that integrates data protection at the platform level so as to protect corporate data against inadvertent disclosure to unauthorized users and public services through email, social media and public cloud. It includes encryption of enterprise data when it enters the device or is created on the device, such that data stays protected against disclosure to applications and endpoints outside enterprise control.</descrip></descripGrp><ntig><termGrp><term id="2352186">Enterprise data protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2354007">ການປົກປ້ອງຂໍ້ມູນລະດັບອົງການ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40497_2352186_2354734"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature set that integrates data protection at the platform level so as to protect corporate data against inadvertent disclosure to unauthorized users and public services through email, social media and public cloud. It includes encryption of enterprise data when it enters the device or is created on the device, such that data stays protected against disclosure to applications and endpoints outside enterprise control.</descrip></descripGrp><ntig><termGrp><term id="2352186">Enterprise data protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2354734">EDP</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40497_2352186_2414071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature set that integrates data protection at the platform level so as to protect corporate data against inadvertent disclosure to unauthorized users and public services through email, social media and public cloud. It includes encryption of enterprise data when it enters the device or is created on the device, such that data stays protected against disclosure to applications and endpoints outside enterprise control.</descrip></descripGrp><ntig><termGrp><term id="2352186">Enterprise data protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2414071">ການປົກປ້ອງຂໍ້ມູນ Windows</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40497_2352187_2354007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature set that integrates data protection at the platform level so as to protect corporate data against inadvertent disclosure to unauthorized users and public services through email, social media and public cloud. It includes encryption of enterprise data when it enters the device or is created on the device, such that data stays protected against disclosure to applications and endpoints outside enterprise control.</descrip></descripGrp><ntig><termGrp><term id="2352187">EDP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2354007">ການປົກປ້ອງຂໍ້ມູນລະດັບອົງການ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40497_2352187_2354734"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature set that integrates data protection at the platform level so as to protect corporate data against inadvertent disclosure to unauthorized users and public services through email, social media and public cloud. It includes encryption of enterprise data when it enters the device or is created on the device, such that data stays protected against disclosure to applications and endpoints outside enterprise control.</descrip></descripGrp><ntig><termGrp><term id="2352187">EDP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2354734">EDP</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40497_2352187_2414071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature set that integrates data protection at the platform level so as to protect corporate data against inadvertent disclosure to unauthorized users and public services through email, social media and public cloud. It includes encryption of enterprise data when it enters the device or is created on the device, such that data stays protected against disclosure to applications and endpoints outside enterprise control.</descrip></descripGrp><ntig><termGrp><term id="2352187">EDP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2414071">ການປົກປ້ອງຂໍ້ມູນ Windows</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40497_2405212_2354007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature set that integrates data protection at the platform level so as to protect corporate data against inadvertent disclosure to unauthorized users and public services through email, social media and public cloud. It includes encryption of enterprise data when it ente