ech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56209_3160600_3160967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The personalized, scrollable feed of Teams channel content that helps you catch up on posts from people, topics, and channels.</descrip></descripGrp><ntig><termGrp><term id="3160600">Discover</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3160967">ຄົ້ນພົບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56209_3160600_3160968"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The personalized, scrollable feed of Teams channel content that helps you catch up on posts from people, topics, and channels.</descrip></descripGrp><ntig><termGrp><term id="3160600">Discover</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3160968">ຟີດຄົ້ນພົບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56210_3160601_3160974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams app that allows users to create, view, and edit contacts.</descrip></descripGrp><ntig><termGrp><term id="3160601">People</term><termNote type="partOfSpeech">ProperNoun</termNo