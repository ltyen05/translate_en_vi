19"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pane in normal view in which you type notes that you want to accompany a slide. You print these notes as notes pages or have them display when you save a presentation as a Web page.</descrip></descripGrp><ntig><termGrp><term id="232529">notes pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163319">ຖາດ​ບັນ​ທຶກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10982_117719_2179690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The activities and actions performed by customer service representatives to assist customers.</descrip></descripGrp><ntig><termGrp><term id="117719">support</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179690">ການຮອງຮັບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10982_117719_465584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The activities and actions performed by customer service representatives to assist customers.</descrip></descripGrp><ntig><termGrp><term id="117719">support</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465584">ການສະໜັບສະໜູນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10984_47577_2114850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Internet and other networks, the highest subdivision of a domain name in a network address, which identifies the type of entity owning the address (for example, .com for commercial users or .edu for educational institutions) or the geographical location of the address (for example, .fr for France or .sg for Singapore). The domain is the last part of the address (for example, www.acm.org).</descrip></descripGrp><ntig><termGrp><term id="47577">domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114850">ໂດເມນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10984_47577_2302685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Internet and other networks, the highest subdivision of a domain name in a network address, which identifies the type of entity owning the address (for example, .com for commercial users or .edu for educational institutions) or the geographical location of the address (for example, .fr for France or .sg for Singapore). The domain is the last part of the address (for example, www.acm.org).</descrip></descripGrp><ntig><termGrp><term id="47577">domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302685">top-level domain</term><termNote type="geographicalUs