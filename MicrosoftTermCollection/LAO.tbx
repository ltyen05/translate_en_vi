mEntry><termEntry id="10362_103575_2302459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change the size of an element on the screen.</descrip></descripGrp><ntig><termGrp><term id="103575">resize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302459">ປ່ຽນຂະໜາດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10367_129177_2179757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display of information from a given perspective or location.</descrip></descripGrp><ntig><termGrp><term id="129177">view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179757">ມຸມມອງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10367_129177_465646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display of information from a given perspective or location.</descrip></descripGrp><ntig><termGrp><term id="129177">view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465646">ທີວທັດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10368_228771_2302565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account that is intended to be used to run a service. A service account has privileges beyond those provided when a service is run as part of the system, such as the ability to connect over the network to another computer.</descrip></descripGrp><ntig><termGrp><term id="228771">service account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302565">ບັນຊີບໍລິການ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10380_156547_2780792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document describing a company's position on privacy, detailing what information it collects, with whom the data is shared, and how users can control the use of their personal information.</descrip></descripGrp><ntig><termGrp><term id="156547">privacy statement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2780792">ຖະແຫຼງການຄວາມເປັນສ່ວນຕົວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10396_158410_2179158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to, being, or characteristic of something that is not dependent on timing. Each application or command runs in the specified order, but the specified item does not wait for any previously started processes to finish before an application or command runs.</descrip></descripGrp><ntig><termGrp><term id="158410">asynchronous</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179158">ບໍ່ປະສານເວລາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10396_158410_465864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to, being, or characteristic of something that is not dependent on timing. Each application or command runs in the specified order, but the specified item does not wait for any previously started processes to finish before an application or command runs.</descrip></descripGrp><ntig><termGrp><term id="158410">asynchronous</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465864">ການຖ່າຍໂອນຂໍ້ມູນໄດ້ສອງຟາກຕ່າງເວລາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10396_2479304_2179158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to, being, or characteristic of something that is not dependent on timing. Each application or command runs in the specified order, but the specified item does not wait for any previously started processes to finish before an application or command runs.</descrip></descripGrp><ntig><termGrp><term id="2479304">async</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179158">ບໍ່ປະສານເວລາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10396_2479304_465864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to, being, or characteristic of something that is not dependent on timing. Each application or command runs in the specified order, but the specified item does not wait for any previously started processes to finish before an application or command runs.</descrip></descripGrp><ntig><termGrp><term id="2479304">async</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465864">ການຖ່າຍໂອນຂໍ້ມູນໄດ້ສອງຟາກຕ່າງເວລາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10398_307432_2162920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The policy tool that gives authors control over how recipients use the documents and emails they send.</descrip></descripGrp><ntig><termGrp><term id="307432">Information Rights Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162920">ການ​ຄຸ້ມ​ຄອງ​ສິດ​ຂໍ້​ມູນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10398_307472_2162920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The policy tool that gives authors control over how recipients use the documents and emails they send.</descrip></descripGrp><ntig><termGrp><term id="307472">IRM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162920">ການ​ຄຸ້ມ​ຄອງ​ສິດ​ຂໍ້​ມູນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="104_234833_2179796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An organizational feature of Windows that displays a panel on the side of the desktop with shortcuts to mini-applications, also known as gadgets. The examples of such gadgets are local weather, a photo slideshow, a dictionary, news headlines, and a Windows Media Player control.</descrip></descripGrp><ntig><termGrp><term id="234833">Windows Sidebar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179796">Windows Sidebar</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="104_234833_466109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An organizational feature of Windows that displays a panel on the side of the desktop with shortcuts to mini-applications, also known as gadgets. The examples of such gadgets are local weather, a photo slideshow, a dictionary, news headlines, and a Windows Media Player control.</descrip></descripGrp><ntig><termGrp><term id="234833">Windows Sidebar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466109">ແຖບຂ້າງ ວິນໂດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1040_378778_2302645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A parameter that does not take an argument.</descrip></descripGrp><ntig><termGrp><term id="378778">switch parameter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302645">ສະລັບພາຣາມິເຕີ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10402_146400_2163379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text or some other element used in an application as an indicator that the user should enter in his or her own text.</descrip></descripGrp><ntig><termGrp><term id="146400">placeholder text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163379">ຂໍ້​ຄວາມ​ເຄື່ອງ​ໝາຍ​ຄົງ​ທີ່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10410_397225_2301830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text that is added to email messages in transport to provide information that supports the sending organization's compliance policies, warnings about unknown or unverified email senders, or other information as determined by the sending organization. Exchange Server 2007 allows the administrator to use transport rules to target disclaimers based on specific criteria.</descrip></descripGrp><ntig><termGrp><term id="397225">disclaimer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301830">ຂໍ້ຄວາມປະຕິເສດຄວາມຮັບຜິດຊອບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10414_270278_466304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that separates the numerator and denominator of a fraction.</descrip></descripGrp><ntig><termGrp><term id="270278">fraction bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466304">ແຖບເສດສ່ວນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10421_210482_2302655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small space on the To-Do Bar where the user can input tasks directly. The default label reads "Type a new task".</descrip></descripGrp><ntig><termGrp><term id="210482">task input panel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302655">ແຜງປ້ອນເຂົ້າວຽກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_318356_465331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp><ntig><termGrp><term id="318356">left angle bracket</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465331">ເຄື່ອງໝາຍໜ້ອຍກວ່າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_318356_466529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp><ntig><termGrp><term id="318356">left angle bracket</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466529">ເຄື່ອງໝາຍນ້ອຍກວ່າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_318750_465331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp><ntig><termGrp><term id="318750">LESS-THAN SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465331">ເຄື່ອງໝາຍໜ້ອຍກວ່າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_318750_466529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp><ntig><termGrp><term id="318750">LESS-THAN SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466529">ເຄື່ອງໝາຍນ້ອຍກວ່າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_74325_465331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp><ntig><termGrp><term id="74325">less than sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465331">ເຄື່ອງໝາຍໜ້ອຍກວ່າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_74325_466529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp><ntig><termGrp><term id="74325">less than sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466529">ເຄື່ອງໝາຍນ້ອຍກວ່າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10423_232516_466050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data from a table, form, query, view, or stored procedure, displayed in a row-and-column format.</descrip></descripGrp><ntig><termGrp><term id="232516">datasheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466050">ແຜ່ນຖານຂໍ້ມູນຕາຕະລາງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10425_77712_2302176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A highspeed network that can carry voice, data, and images at up to 200 Mbps or faster over distances of up to 75 km. Based on the network architecture, the transmission speed can be higher for shorter distances. A MAN, which can include one or more LANs as well as telecommunications equipment such as microwave and satellite relay stations, is smaller than a wide area network but generally operates at a higher speed.</descrip></descripGrp><ntig><termGrp><term id="77712">MAN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302176">ເຄືອຂ່າຍລະດັບເມືອງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10425_77713_2302176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A highspeed network that can carry voice, data, and images at up to 200 Mbps or faster over distances of up to 75 km. Based on the network architecture, the transmission speed can be higher for shorter distances. A MAN, which can include one or more LANs as well as telecommunications equipment such as microwave and satellite relay stations, is smaller than a wide area network but generally operates at a higher speed.</descrip></descripGrp><ntig><termGrp><term id="77713">metropolitan area network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302176">ເຄືອຂ່າຍລະດັບເມືອງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10431_232847_2302433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that is designed for reading documents on a computer screen. The document is resized to fit the screen and most toolbars are removed, but commands are available for navigating, commenting, and looking up words.</descrip></descripGrp><ntig><termGrp><term id="232847">reading layout view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302433">ມຸມມອງໂຄງຮ່າງການອ່ານ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10436_415517_2441276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Editor feature that gives users feedback on how easy it is for a reader to understand a written text based on information such as average sentence length and average word length.</descrip></descripGrp><ntig><termGrp><term id="415517">Readability Statistics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2441276">ສະຖິຕິການອ່ານເຂົ້າໃຈງ່າຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10437_168488_2163386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optional Live Meeting tool that allows users to create Live Meeting slides and add a presenter photo as part of a Microsoft PowerPoint file.</descrip></descripGrp><ntig><termGrp><term id="168488">PowerPoint add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163386">PowerPoint ເພີ່ມ​ໃສ່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10443_294444_466323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of chart that compares the aggregate values of a number of data series.</descrip></descripGrp><ntig><termGrp><term id="294444">radar chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466323">ແຜນສະແດງແບບໃຍແມງມູມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10444_139402_465729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A design template that also contains text suggestions on each slide. You replace the text suggestions with the text that you want. A content template contains a slide master and an optional title master.</descrip></descripGrp><ntig><termGrp><term id="139402">content template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465729">ເນື້ອໃນທີ່ເປັນຕົວແບບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1045_137287_2162950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text displayed by Web browsers during image downloads for users who have graphics turned off, and for users who rely on screen-reading software to convert graphics on the screen to spoken words.</descrip></descripGrp><ntig><termGrp><term id="137287">alternative text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162950">ຂໍ້​ຄວາມ ALT</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1045_137287_465707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text displayed by Web browsers during image downloads for users who have graphics turned off, and for users who rely on screen-reading software to convert graphics on the screen to spoken words.</descrip></descripGrp><ntig><termGrp><term id="137287">alternative text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465707">ຂໍ້ຄວາມທີ່ໃຊ້ແທນກັນໄດ້</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1045_765697_2162950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text displayed by Web browsers during image downloads for users who have graphics turned off, and for users who rely on screen-reading software to convert graphics on the screen to spoken words.</descrip></descripGrp><ntig><termGrp><term id="765697">ALT text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162950">ຂໍ້​ຄວາມ ALT</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1045_765697_465707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text displayed by Web browsers during image downloads for users who have graphics turned off, and for users who rely on screen-reading software to convert graphics on the screen to spoken words.</descrip></descripGrp><ntig><termGrp><term id="765697">ALT text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465707">ຂໍ້ຄວາມທີ່ໃຊ້ແທນກັນໄດ້</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10451_16349_464893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Relating to frequencies within the range of perception by the human ear - from about 15 to 20,000 hertz (cycles per second).</descrip></descripGrp><ntig><termGrp><term id="16349">audio</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="464893">ລະບົບສຽງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10452_107217_3041655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In color management, the purity of a color's hue, moving from gray to the pure color.</descrip></descripGrp><ntig><termGrp><term id="107217">saturation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3041655">ຄວາມເຂັ້ມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10459_116136_2216933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of markup in markup languages. A start tag is the starting element of a tag pair which contains metainformation about some part of the text.</descrip></descripGrp><ntig><termGrp><term id="116136">start tag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2216933">ແທັກ​ເລີ່ມ​ຕົ້ນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1048_188097_465947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Anything owned or controlled by a business, tangible or intangible, that has monetary value and was acquired at a measurable cost.</descrip></descripGrp><ntig><termGrp><term id="188097">asset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465947">ຊັບສິນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10482_236960_2179546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that opens Sync Center.</descrip></descripGrp><ntig><termGrp><term id="236960">Open Sync Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179546">ເປີດສູນການຊິງຄ໌</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun