="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163397">ບ່ອນ​ປ້ອນ​ຂໍ້​ມູນ​ຄຸນ​ສົມ​ບັດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7204_2066257_2149541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification for sharing items, such as calendars, documents or folders, with others.</descrip></descripGrp><ntig><termGrp><term id="2066257">invitation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149541">ການ​ແຊ​ຣ໌​ຄຳ​ເຊີນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7204_2066257_2149706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification for sharing items, such as calendars, documents or folders, with others.</descrip></descripGrp><ntig><termGrp><term id="2066257">invitation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149706">ການ​ເຊີນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7204_234808_2149541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification for sharing items, such as calendars, documents or folders,