>NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3075120">Microsoft Defender</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43467_3073145_3075204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Security product experience for protecting Windows devices and users from malware and other threats.</descrip></descripGrp><ntig><termGrp><term id="3073145">Defender</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3075204">Defender</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43468_2721513_2722524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that helps to isolate enterprise-defined untrusted sites based on a list of trusted web sites, cloud resources and internal networks defined by an enterprise administrator. Everything not on that list is considered untrusted.</descrip></descripGrp><ntig><termGrp><term id="2721513">Application Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2722524">Application Guard</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43468_2795831_2722524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that helps to isolate enterprise-defined untrusted sites based on a list of trusted web sites, cloud resources and internal networks defined by an enterprise administrator. Everything not on that list is considered untrusted.</descrip></descripGrp><ntig><termGrp><term id="2795831">Microsoft Defender Application Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2722524">Application Guard</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4349_58489_2162809"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an entire entity such as document, file, or program rather than to a restricted segment of it.</descrip></descripGrp><ntig><termGrp><term id="58489">global</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162809">ທົ່ວ​ໄປ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43506_2462246_2466893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mixed-reality shell experience, in which content can be placed and used in virtual (or, in the case of HoloLens, real) surroundings.</descrip></descripGrp><ntig><termGrp><term id="2462246">mixed world</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2466893">:ໂລກປະສົມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43511_2462585_2746249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directed acyclic graph in Apache Storm that defines how data flows between spouts and bolts.</descrip></descripGrp><ntig><termGrp><term id="2462585">topology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2746249">ໂທໂພໂລຈີ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4353_151854_2235140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of delivering digital media across a network in a continuous flow. The digital media is played by client software as it is received.</descrip></descripGrp><ntig><termGrp><term id="151854">streaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2235140">ການ​ສະ​ຕີມ​ມີ​ເດຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4353_2227182_2235140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of delivering digital media across a network in a continuous flow. The digital media is played by client software as it is received.</descrip></descripGrp><ntig><termGrp><term id="2227182">media streaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2235140">ການ​ສະ​ຕີມ​ມີ​ເດຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43568_2463950_2528379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Microsoft Classroom targeted at faculty members.</descrip></descripGrp><ntig><termGrp><term id="2463950">Microsoft Classroom for faculty</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2528379">Microsoft Classroom ສຳລັບຄະນະ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43569_2463966_2528380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Microsoft Classroom targeted at university students.</descrip></descripGrp><ntig><termGrp><term id="2463966">Microsoft Classroom for students</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2528380">Microsoft Classroom ສຳລັບນັກຮຽນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43582_2464277_2926651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app destination for solutions that extend the capabilities of the technology you already own.</descrip></descripGrp><ntig><termGrp><term id="2464277">Microsoft AppSource</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2926651">Microsoft AppSource</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43582_2464281_2926651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app destination for solutions that extend the capabilities of the technology you already own.</descrip></descripGrp><ntig><termGrp><term id="2464281">AppSource</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2926651">Microsoft AppSource</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43593_2464340_2466318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Office 365 that is for the European market.</descrip></descripGrp><ntig><termGrp><term id="2464340">Microsoft Office 365 Germany</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2466318">Microsoft Office 365 Germany</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43597_2464345_2776150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure that is used to create a digital transaction ledger that, instead of resting with a single provider, is shared among a distributed network of computers. The result is a more open, transparent, and publicly verifiable system for digital transactions.</descrip></descripGrp><ntig><termGrp><term id="2464345">blockchain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2776150">blockchain</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43608_2464387_2466892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI screen that appears in the Network flyout when a paid Wi-Fi hotspot is in range and paid Wi-Fi plans are available from Windows Store. A customer can then tap Connect with a data plan to open the Paid Wi-Fi &amp; Cellular app, choose a paid Wi-Fi data plan that’s offered from Windows Store, and then buy a plan using the payment information that’s stored in their Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2464387">Connect with a data plan</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2466892">ເຊື່ອມຕໍ່ກັບແຜນຂໍ້ມູນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4362_153205_465838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-speed Internet connection. Broadband connections are typically 256 kilobytes per second (KBps) or faster.</descrip></descripGrp><ntig><termGrp><term id="153205">broadband connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465838">ການເຊື່ອມຕໍ່ແບບຄວາມໄວສູງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43627_2465102_2470760"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any very simple computer program that outputs or displays the words "Hello World" in some form to the user. Such a program is often created as an example, to introduce the basic syntax of a programming language to students or others new to that language.</descrip></descripGrp><ntig><termGrp><term id="2465102">Hello World</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2470760">ສະບາຍດີຊາວໂລກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43628_2781062_2782405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for OneDrive for Business that includes Office Online and that is available through the User purchase subscription program.</descrip></descripGrp><ntig><termGrp><term id="2781062">OneDrive for Business with Office on the web (user purchased)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2782405">OneDrive ສຳລັບທຸລະກິດພ້ອມກັບ Office ຢູ່ເວັບ (ຜູ້ໃຊ້ຊື້)</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43630_2816015_2834540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for the Office suite, email, instant messaging, HD video conferencing, 1 TB personal file storage and sharing, advanced security, analytics and PSTN conferencing targeted at government organizations. It includes all the features of Office 365 Government Community G3 plus unified communications with Skype for Business Server, advanced eDiscovery with predictive coding and text analytics, Exchange Online Advanced Threat Protection, personal and organizational analytics, Audio Conferencing, and other services.</descrip></descripGrp><ntig><termGrp><term id="2816015">Office 365 Government G5</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2834540">Office 365 ລັດຖະບານ G5</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></term