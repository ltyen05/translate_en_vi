່ເລກລະຫັດອິນເຕີເນັດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="892_725809_2179424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A binary number that uniquely identifies a host (computer) connected to the Internet to other Internet hosts, for the purposes of communication through the transfer of packets.</descrip></descripGrp><ntig><termGrp><term id="725809">Internet Protocol address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179424">ທີ່ຢູ່ IP</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="892_725809_464784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A binary number that uniquely identifies a host (computer) connected to the Internet to other Internet hosts, for the purposes of communication through the transfer of packets.</descrip></descripGrp><ntig><termGrp><term id="725809">Internet Protocol address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="464784">ທີ່ຢູ່ເລກລະຫັດອິນເຕີເນັດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8922_34048_465021"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A startup process that begins with turning on the computer's power. Typically, a cold boot involves some basic hardware checking by the system, after which the operating system is loaded from disk into memory.</descrip></descripGrp><ntig><termGrp><term id="34048">cold boot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465021">ເລີ່ມຕົ້ນລະບົບຈາກໂປຣແກຣມພາຍໃນເຄື່ອງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8922_34049_465021"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A startup process that begins with turning on the computer's power. Typically, a cold boot involves some basic hardware checking by the system, after which the operating system is loaded from disk into memory.</descrip></descripGrp><ntig><termGrp><term id="34049">cold start</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465021">ເລີ່ມຕົ້ນລະບົບຈາກໂປຣແກຣມພາຍໃນເຄື່ອງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8924_112244_2179659"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The command interpreter that is used to pass commands to the operating system.</descrip></descripGrp><ntig><termGrp><term id="112244">shell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179659">ເຊລ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8924_112244_465546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The command interpreter that is used to pass commands to the operating system.</descrip></descripGrp><ntig><termGrp><term id="112244">shell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465546">ແຊວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8929_81571_465382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device on which images generated by the computer's video adapter are displayed.</descrip></descripGrp><ntig><termGrp><term id="81571">monitor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465382">ໜ້າຈໍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8937_61873_2114916"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of the user's actions within a program, such as commands entered in an operating system shell, menus passed through using Gopher, or links followed using a Web browser.</descrip></descripGrp><ntig><termGrp><term id="61873">history</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114916">ປະຫວັດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8945_117177_465583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An index entry that falls under a more general heading. For example, the index entry "planets" could have the subentries "Mars" and "Venus."</descrip></descripGrp><ntig><termGrp><term id="117177">subentry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465583">ບັນຈຸເປັນລາຍຍ່ອຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8949_140209_2162861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Related data points that are plotted in a chart. Each data series in a chart has a unique color or pattern and is represented in the chart legend. You can plot one or more data series in a chart. Pie charts have only one data series.</descrip></descripGrp><ntig><termGrp><term id="140209">data series</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162861">ຊຸດ​ຂໍ້​ມູນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8949_1508235_2162861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Related data points that are plotted in a chart. Each data series in a chart has a unique color or pattern and is represented in the chart legend. You can plot one or more data series in a chart. Pie charts have only one data series.</descrip></descripGrp><ntig><termGrp><term id="1508235">series</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162861">ຊຸດ​ຂໍ້​ມູນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8960_545680_2163352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of a document as it will appear on the printed page.</descrip></descripGrp><ntig><termGrp><term id="545680">page layout view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163352">ມຸມມອງ​ແຜນ​ຜັງ​ໜ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8960_545691_2163352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of a document as it will appear on the printed page.</descrip></descripGrp><ntig><termGrp><term id="545691">print layout view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163352">ມຸມມອງ​ແຜນ​ຜັງ​ໜ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8961_318125_466499"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Colors that are directly next to each other on the color wheel. Each color has two analogous colors (one on each side of it).</descrip></descripGrp><ntig><termGrp><term id="318125">analogous colors</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466499">ສີເຊື່ອມຕໍ່ກັນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8983_61675_2302236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fixed-disk file system that organizes the disk into volumes, rather than partitions and logical drives. HPFS supports long, mixed-case filenames and extended attributes, and implements several levels of caching, for improved operating-system performance. The IBM OS/2 operating system supports HPFS.</descrip></descripGrp><ntig><termGrp><term id="61675">high performance file system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302236">HPFS</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8983_61676_2302236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fixed-disk file system that organizes the disk into volumes, rather than partitions and logical drives. HPFS supports long, mixed-case filenames and extended attributes, and implements several levels of caching, for improved operating-system performance. The IBM OS/2 operating system supports HPFS.</descrip></descripGrp><ntig><termGrp><term id="61676">high-performance file system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302236">HPFS</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8983_61677_2302236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fixed-disk file system that organizes the disk into volumes, rather than partitions and logical drives. HPFS supports long, mixed-case filenames and extended attributes, and implements several levels of caching, for improved operating-system performance. The IBM OS/2 operating system supports HPFS.</descrip></descripGrp><ntig><termGrp><term id="61677">HPFS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302236">HPFS</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9001_1058104_2301853"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disk directory in which an SMTP service can deposit incoming mail messages.</descrip></descripGrp><ntig><termGrp><term id="1058104">e-mail drop folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301853">ໄດເຣັກທໍຣີຂໍ້ຄສາມເຂົ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9001_1058111_2301853"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disk directory in which an SMTP service can deposit incoming mail messages.</descrip></descripGrp><ntig><termGrp><term id="1058111">drop folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301853">ໄດເຣັກທໍຣີຂໍ້ຄສາມເຂົ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9001_396929_2301853"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disk directory in which an SMTP service can deposit incoming mail messages.</descrip></descripGrp><ntig><termGrp><term id="396929">drop directory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301853">ໄດເຣັກທໍຣີຂໍ້ຄສາມເຂົ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9010_347945_466715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group in the data source that can occur more than once. Controls such as repeating sections and repeating tables are bound to repeating groups.</descrip></descripGrp><ntig><termGrp><term id="347945">repeating group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466715">ກຸ່ມການເຮັດຊໍ້າຄືນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9025_253693_2163094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type that stores a signed, exact numeric value described as the number of digits appearing before and after the decimal point, with a maximum of 29 total digits. All possible digits cannot be represented if you are using the maximum number of digits.</descrip></descripGrp><ntig><termGrp><term id="253693">Decimal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163094">ທົດ​ສະ​ນິ​ຍົມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9026_44196_2179267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of rewriting parts of a file to contiguous sectors on a hard disk to increase the speed of access and retrieval.</descrip></descripGrp><ntig><termGrp><term id="44196">defragmentation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179267">ການຫຼຸດການແຕກກະຈາຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9026_44196_465102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of rewriting parts of a file to contiguous sectors on a hard disk to increase the speed of access and retrieval.</descrip></descripGrp><ntig><termGrp><term id="44196">defragmentation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465102">ຈັດລຽງຂໍ້ມູນໃນດິສ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9028_143088_465765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The blank area between two or more columns of text or between two facing pages in a publication.</descrip></descripGrp><ntig><termGrp><term id="143088">gutter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465765">ຮ່ອງຕາຕະລາງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9030_146463_2163382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a 2-D chart, the area bounded by the axes, including all data series. In a 3-D chart, the area bounded by the axes, including the data series, category names, tick-mark labels, and axis titles.</descrip></descripGrp><ntig><termGrp><term id="146463">plot area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163382">ພື້ນ​ທີ່​ແຕ້ມ​ຈຸດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9035_13104_464875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small piece of code that can be transported over the Internet and executed on the recipient's machine. The term is especially used to refer to such programs as they are embedded in line as objects in HTML documents on the World Wide Web.</descrip></descripGrp><ntig><termGrp><term id="13104">applet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="464875">ສ່ວນຂອງລະຫັດສົ່ງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9040_2624999_2632589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to visualize, navigate, and customize the view of files with an XPS document format.</descrip></descripGrp><ntig><termGrp><term id="2624999">Windows XPS Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2632589