together, will lock a device down so that it can only run trusted applications.​​​</descrip></descripGrp><ntig><termGrp><term id="2795844">Microsoft Defender Device Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2329541">Device Guard</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40083_2329248_2336129"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of Windows Store for Business where admins can sign policies and catalogs of approved software, including LOB apps, using enterprise-specific signing certificates.​</descrip></descripGrp><ntig><termGrp><term id="2329248">Device Guard signing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2336129">ການເຊັນ Device Guard</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40084_2329249_2336131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category of fonts that make it easier for people with dyslexia to read.​</descrip></descripGrp><ntig><termGrp><term id="2329249">Fluent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2336131">Fluent</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun<