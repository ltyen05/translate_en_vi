ripGrp><ntig><termGrp><term id="3031670">rich search ad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3031888">ໂຄສະນາໃນຜົນການຊອກຫາທີ່ມີຮູບ ແລະ ວິດີໂອ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53219_3031672_3031884"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combined search and audience advertising marketplace made up of Bing, MSN, Outlook, Edge, and partner sites.</descrip></descripGrp><ntig><termGrp><term id="3031672">Microsoft Search Network</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3031884">ເຄືອຂ່າຍການຊອກຫາ Microsoft</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53220_3031831_3032426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy template that helps detect cross-country or cross-region data transfers, identify the amount and types of personal data being transferred, and take actions to remediate risks, such as applying additional encryption or restricting access for the data being transferred.</descrip></descripGrp><ntig><termGrp><term id="3031831">cross-border transfers</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3032426">ການໂອນຂ້າມພົມແດນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53221_3031832_3032425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transfer of personal data across a geographic border (such as country or regional borders).</descrip></descripGrp><ntig><termGrp><term id="3031832">cross-border transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3032425">ການໂອນຂ້າມພົມແດນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53222_3031833_3032430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy template that helps detect personal data with external, excessive, and idle access and trigger remediation actions including sending notifications to the data or site owners to remove unnecessary accesses.</descrip></descripGrp><ntig><termGrp><term id="3031833">data overexposure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3032430">ການເປີດເຜີຍຂໍ້ມູນຫຼາຍເກີນໄປ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53223_3031834_3032428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy template that helps detect personal data that has not been used for more than 90 days and trigger remediation actions, including sending notifications to data owners to apply retention labels or disposing of the information immediately.</descrip></descripGrp><ntig><termGrp><term id="3031834">data minimization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3032428">ການຫຼຸດຈໍານວນຂໍ້ມູນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53224_3031835_3032424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The metered service that enables licensed M365 commercial, consumer, and education users to use Office Online to view, edit, and coauthor documents stored on cloud storage providers other than SharePoint or OneDrive.</descrip></descripGrp><ntig><termGrp><term id="3031835">Coauthoring</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3032424">ການຮ່ວມແຕ່ງເອກະສານ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53225_3053615_3053690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cross-industry experience app in Microsoft Teams that provides seamless scheduling, analytics, and premium experiences for business-to-customer meetings, bringing together current virtual appointment experiences into one single entry point.</descrip></descripGrp><ntig><termGrp><term id="3053615">Virtual Appointments</term><termNote type="partOfSpeech">Prop