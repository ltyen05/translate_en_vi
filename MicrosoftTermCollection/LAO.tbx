ications.</descrip></descripGrp><ntig><termGrp><term id="31752">class identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301683">class identifier</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15239_74270_2163248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key that accompanies a graphic and explains how information is presented.</descrip></descripGrp><ntig><termGrp><term id="74270">legend</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163248">ເຄື່ອງ​ໝາຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15242_123603_2765098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A version of a product that can be used for a limited period of time for purposes of evaluation.</descrip></descripGrp><ntig><termGrp><term id="123603">trial version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2765098">ການທົດລອງໃຊ້</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15242_1490934_2765098"><langSet xml:l