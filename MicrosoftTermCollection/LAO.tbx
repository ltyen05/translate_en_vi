ote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3115259">ການຮັກສາຄວາມປອດໄພລະດັບແຖວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44765_2520275_3115259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables customers to control access to rows in a database table based on the characteristics of the user executing a query (e.g., group membership or execution context).</descrip></descripGrp><ntig><termGrp><term id="2520275">RLS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3115259">ການຮັກສາຄວາມປອດໄພລະດັບແຖວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44765_3114827_3115259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables customers to control access to rows in a database table based on the characteristics of the user executing a query (e.g., group membership or execution context).</descrip></descripGrp><ntig><termGrp><term id="3114827">row-level security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3115259">ການຮັກສາຄວາມປອດໄພລະດັບແຖວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammatic