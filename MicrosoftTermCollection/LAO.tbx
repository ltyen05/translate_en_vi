ບສູດຄຳວນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11229_231980_2302653"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Query window that displays the tables in a query. Each table displays the fields from which you can retrieve data.</descrip></descripGrp><ntig><termGrp><term id="231980">table pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302653">ແຖບຕາຕາລາງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11232_231971_2162516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a PivotTable report, the summarized data calculated from the data fields of a source list or table.</descrip></descripGrp><ntig><termGrp><term id="231971">PivotTable data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162516">ຂໍ້ມູນ PivotTable</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11239_90209_2163356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The request by a user's browser for a Web page. The number of requests to view a page can indicate the frequency with which an ad is viewed.</descrip></descrip