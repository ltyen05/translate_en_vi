</ntig></langSet></termEntry><termEntry id="42470_2462549_2465871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 service for small businesses that includes customizable Web-based booking pages where customers can book appointments for services and that sends out email confirmations, reminders, updates, and cancelation notices to customers and employees.</descrip></descripGrp><ntig><termGrp><term id="2462549">Bookings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2465871">Bookings</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42473_2407877_2411482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PowerPoint characteristic that enables Windows to auto-scale edit mode based on per-monitor DPI but gives PowerPoint control over slide show rendering so that Windows does not auto-scale it.</descrip></descripGrp><ntig><termGrp><term id="2407877">Mixed DPI mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2411482">ໂໝດ DPI ປະສົມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42474_2407904_2411480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word menu option that invokes Focus mode.</descrip></descripGrp><ntig><termGrp><term id="2407904">Focus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2411480">ໂຟກັສ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42480_2407917_2793737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository where private keys, certificates and symmetric keys can be stored.</descrip></descripGrp><ntig><termGrp><term id="2407917">keystore</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2793737">ກະແຈຮ້ານຄ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42480_2793217_2793737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository where private keys, certificates and symmetric keys can be stored.</descrip></descripGrp><ntig><termGrp><term id="2793217">key store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2793737">ກະແຈຮ້ານຄ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42482_2407975_2412711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a digital signature to additions and updates made 