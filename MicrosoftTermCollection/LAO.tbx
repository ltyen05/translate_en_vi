53_2842118_2848110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An industry collaboration program that aims to bring organizations in cybersecurity and in other industries together to change the game against malware.</descrip></descripGrp><ntig><termGrp><term id="2842118">Coordinated Malware Eradication</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2848110">Coordinated Malware Eradication</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50253_2842119_2848109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An industry collaboration program that aims to bring organizations in cybersecurity and in other industries together to change the game against malware.</descrip></descripGrp><ntig><termGrp><term id="2842119">CME</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2848109">CME</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50253_2842119_2848110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An industry collaboration program that aims to bring organizations in cybersecurity and in other industries together to change the game against malware.</descrip></descripGrp><ntig><termGrp><term id="2842119">CME</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2848110">Coordinated Malware Eradication</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50256_2842122_2842676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An industry group where technology companies with mature security response processes come together to solve cross-industry problems and advance security across the ecosystem. (Microsoft was a founding member.)</descrip></descripGrp><ntig><termGrp><term id="2842122">Industry Consortium for the Advancement of Security on the Internet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2842676">Industry Consortium for the Advancement of Security on the Internet</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50268_2843747_2849061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Zero Trust access policy that limits user access with Just-In-Time and Just-Enough Access (JIT/JEA) risk-based adaptive polices and data protection to protect both data and productivity</descrip></descripGrp><ntig><termGrp><term id="2843747">least privileged access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2849061">ການເຂົ້າເຖິງແບບມີສິດໜ້ອຍລົງ</term><termNote type="geographicalUsage">LAO</termNote><termNote 