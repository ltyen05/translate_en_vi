><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2347343">ກະເປົາເງິນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40353_2346147_2349907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel worksheet function using nested if functions that test conditions in order and if passed, the result is returned.</descrip></descripGrp><ntig><termGrp><term id="2346147">IFS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2349907">IFS</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40371_2346698_2349911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A smaller activity within a task.</descrip></descripGrp><ntig><termGrp><term id="2346698">subtask</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2349911">ວຽກຍ່ອຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40392_2347434_2350208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart, resembling a funnel, that displays values as