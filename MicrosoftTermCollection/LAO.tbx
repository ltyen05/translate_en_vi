ular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465797">ແຜນຜັງແບບປີລະມິດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="726_116752_2120603"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Digital media that is delivered in a continuous flow across a network.</descrip></descripGrp><ntig><termGrp><term id="116752">stream</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2120603">ການສະຕຣີມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="726_116752_465579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Digital media that is delivered in a continuous flow across a network.</descrip></descripGrp><ntig><termGrp><term id="116752">stream</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465579">ກະແສຂໍ້ມູນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7260_307399_466396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pigment ink/cartridge used in digital printing which provides resistance to water, fading and smudging, thus producing photographic prints with uniform gloss cov