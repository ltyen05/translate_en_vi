/term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2115215">ວິດີໂອ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33656_1805892_2115216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone call that includes a video component, where you can see the person that you're talking to (and they can see you).</descrip></descripGrp><ntig><termGrp><term id="1805892">video call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2115216">ໂທວິດີໂອ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33656_2060301_2115215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone call that includes a video component, where you can see the person that you're talking to (and they can see you).</descrip></descripGrp><ntig><termGrp><term id="2060301">video</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2115215">ວິດີໂອ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33656_2060301_2115216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone call that includes a video component, where you can see the person that you're talking to (and they can see you).</descrip></descripGrp><ntig><termGrp><term id="2060301">video</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2115216">ໂທວິດີໂອ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33658_1805894_2115230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software usually on a mobile operator’s network that converts desktop webpages to a mobile format. Helpful for older phone models that can’t render the full desktop page.</descrip></descripGrp><ntig><termGrp><term id="1805894">WAP gateway</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2115230">ເກດເວ WAP</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3366_1177_464752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of converting readable data (plaintext) into a coded form (ciphertext) to prevent it from being read by an unauthorized party.</descrip></descripGrp><ntig><termGrp><term id="1177">encryption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="464752">ການໃສ່ລະຫັດ</term><termNote type="geogra