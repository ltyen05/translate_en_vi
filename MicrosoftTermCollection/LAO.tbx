"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A clickable UI element designed to look like a tab on a file folder. It allows you to navigate between multiple applications, files, pages, or websites, all available within a single window.​</descrip></descripGrp><ntig><termGrp><term id="150156">tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465823">ເລື່ອນໄປແຖວນອນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7065_1092501_2765094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proportion of the maximum capacity of a communication circuit that is in use.</descrip></descripGrp><ntig><termGrp><term id="1092501">line load</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2765094">ໂຫຼດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7065_75712_2765094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proportion of the maximum capacity of a communication circuit that is in use.</descrip></descripGrp><ntig><termGrp><term id="75712">load</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2765094">ໂຫຼດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNot