rammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2288629">ການ​ສະ​ແດງ​ຜົນ​ໄວ​ເລ​ສ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3411_236981_2179291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An icon in Windows Vista Control Panel that opens a dialog allowing user to change display options including screen resolution, refresh rate, color depth, and orientation.</descrip></descripGrp><ntig><termGrp><term id="236981">Display Properties</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179291">ຄຸນສົມບັດສະແດງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3411_236981_466139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An icon in Windows Vista Control Panel that opens a dialog allowing user to change display options including screen resolution, refresh rate, color depth, and orientation.</descrip></descripGrp><ntig><termGrp><term id="236981">Display Properties</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466139">ສະແດງກ່ຽວກັບຄຸນສົມບັດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></