ip></descripGrp><ntig><termGrp><term id="2067372">Word Flow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2115246">ກະແສຄໍາເວົ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35745_2067373_2115247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard feature that enables user to slide the finger from letter key to the next letter key in the word.</descrip></descripGrp><ntig><termGrp><term id="2067373">Word Flow with shape writing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2115247">ກະແສຄໍາເວົ້າພ້ອມການຂຽນເປັນຮູບຮ່າງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35748_2067375_2114818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device, connected to a USB charging cable, for charging the phone battery.</descrip></descripGrp><ntig><termGrp><term id="2067375">charger</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114818">ເຄື່ອງສາກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termE