erm><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162892">ການ​ອ້າງ​ອີງ​ເຊ​ລ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5731_155920_2302457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of preventing a denial of service attack by limiting the number of requests that can be made to a system.</descrip></descripGrp><ntig><termGrp><term id="155920">throttling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302457">ການຄວບຄຸມປະລິມານຄຳຮ້ອງຂໍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5731_1645777_2302457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of preventing a denial of service attack by limiting the number of requests that can be made to a system.</descrip></descripGrp><ntig><termGrp><term id="1645777">request throttling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302457">ການຄວບຄຸມປະລິມານຄຳຮ້ອງຂໍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5738_44359_465104"><langSet xml:lang="en-