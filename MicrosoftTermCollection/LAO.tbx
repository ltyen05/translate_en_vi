Note><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49898_2821559_2824833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email cluster containing email messages that have similar sender and content attributes.</descrip></descripGrp><ntig><termGrp><term id="2821559">similarity cluster</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2824833">ກຸ່ມທີ່ຄ້າຍກັນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49899_2821564_2824829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email cluster containing email messages that contain the same indicator entity (file hash or URL) as another email.</descrip></descripGrp><ntig><termGrp><term id="2821564">indicator cluster</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2824829">ກຸ່ມຕົວຊີ້</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49917_2823673_2826373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual display mode in the user interface of some Office applications, such as OneNote and Outlook, that uses a dark background.</descrip></descripGrp><ntig><termGrp><term id="2823673">Dark Mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></nti