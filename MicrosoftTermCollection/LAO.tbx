ngSet></termEntry><termEntry id="38594_2244477_2381483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that allows users to choose a color and font for their sway.</descrip></descripGrp><ntig><termGrp><term id="2244477">Style</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2381483">ຮູບແບບສີສັນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38595_2244478_2380988"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway panel that provides users with all the Style and Structure options.</descrip></descripGrp><ntig><termGrp><term id="2244478">Design panel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2380988">ແຜງການອອກແບບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38597_2244480_2381109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Sway card that takes a set of cards and creates a group out of them with a particular visualization pattern.</descrip></descripGrp><ntig><termGrp><term id="2244480">group card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2381109">ບັດກຸ່ມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="pa