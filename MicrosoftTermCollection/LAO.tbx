>NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21535_777724_2149516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instant message that is transmitted while the sender or recipient is offline.</descrip></descripGrp><ntig><termGrp><term id="777724">offline instant message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149516">ຂໍ້​ຄວາມ​ດ່ວນອອ​ຟ​ລາຍນ໌</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21541_777731_2149521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ID that allows someone to sign in to a non-Microsoft website that uses the Microsoft Account service.</descrip></descripGrp><ntig><termGrp><term id="777731">Partner ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149521">ID ຫຸ້ນ​ສ່ວນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21543_777733_2149589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The helper program that can store sign-in information for multiple Windows Live IDs.</descrip></descripGrp><ntig><termGrp><term id="777733">Windows Live Sign-in Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149589">ຕົວ​ຊ່ວຍ​ລົງ​ຊື່​ເຂົ້າ​ໃຊ້ Windows Live</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21545_777735_2163399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that offers improved security by loading a document in a read-only view, rather than in the full editor, for scenarios that pose a greater potential security risk.</descrip></descripGrp><ntig><termGrp><term id="777735">Protected View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163399">ມຸມມອງ​ຖືກ​ປົກ​ປ້ອງ​ໄວ້</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21546_777736_2302381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A package containing everything you need to show one or many PowerPoint presentations on another computer. This package can be saved to a folder or burned to a CD.</descrip></descripGrp><ntig><termGrp><term id="777736">presentation package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302381">ແພັກເກດພຣີເຊັນເທເຊິນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21548_777738_2149566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file, similar to a video clip, that contains a short audio segment that a user records to send to a contact. The clip appears in the contact's conversation window and plays automatically.</descrip></descripGrp><ntig><termGrp><term id="777738">voice clip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149566">ຄ​ລິບ​ສຽງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21549_777739_2302701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to indicate that a document is trusted, and therefore can be opened without security notifications, so long as the file path and creation time of the document remain unchanged.</descrip></descripGrp><ntig><termGrp><term id="777739">Trusted Documents</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302701">ເອກະສານທີ່ເຊື່ອຖືໄດ້</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21550_777740_2115233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that displays someone's recent activity on Windows Store apps such as Messaging and Facebook.</descrip></descripGrp><ntig><termGrp><term id="777740">what's new</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2115233">ສິ່ງໃໝ່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21551_777741_2149652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The contact picture label that indicates someone has been invited to do something, but has not responded yet.</descrip></descripGrp><ntig><termGrp><term id="777741">Invited</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149652">ເຊີນ​ແລ້ວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21553_777744_2149653"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the webpage where a user manages photos and albums.</descrip></descripGrp><ntig><termGrp><term id="777744">Photos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149653">ຮູບຖ່າຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21554_777746_2149654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the main landing/start page on Windows Live.</descrip></descripGrp><ntig><termGrp><term id="777746">Home</term><termNote type="partOfSpeech">ProperNou