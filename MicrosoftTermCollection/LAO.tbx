<descripGrp><descrip type="definition">The set of services designed to help evaluate organizations' environments, develop customized Microsoft SharePoint deployment plans, and that is part of software assurance coverage.</descrip></descripGrp><ntig><termGrp><term id="1673938">SDPS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2726383">SDPS</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28405_1673938_2726384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of services designed to help evaluate organizations' environments, develop customized Microsoft SharePoint deployment plans, and that is part of software assurance coverage.</descrip></descripGrp><ntig><termGrp><term id="1673938">SDPS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2726384">ບໍລິການການວາງແຜນການນຳໃຊ້ SharePoint</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28406_1484854_2726374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Software Assurance benefit delivered by Microsoft Certified Partner that consists of one to fifteen days of planning the deployment of Microsoft Office Software for a specific organization.</descrip></descripGrp><ntig><termGrp><term id="1484854">Microsoft Desktop Deployment Planning Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2726374">ບໍລິການການວາງແຜນການນຳໃຊ້ເດັສທັອບ Microsoft</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28426_1486692_2688590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that represents a service at the Key Distribution Center (KDC). The service principal has a name and an associated key. A subclass of principal, a service principal generally does not correspond to a human user of the system, but rather to an automated service providing a resource, such as a file server.</descrip></descripGrp><ntig><termGrp><term id="1486692">service principal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2688590">ຄວາມສຳຄັນບໍລິການ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2846_297003_2720406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trojan that captures and/or transmits passwords to an attacker.</descrip></descripGrp><ntig><termGrp><term id="297003">password stealer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2720406">ຕົວລັກລະຫັດຜ່ານ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2846_297003_466343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trojan that captures and/or transmits passwords to an attacker.</descrip></descripGrp><ntig><termGrp><term id="297003">password stealer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466343">ຜູ້ລັກລະຫັດຜ່ານ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28462_1488403_2302100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows the preservation of items in user mailboxes and the protection of the items from deletion by users or automated processes.</descrip></descripGrp><ntig><termGrp><term id="1488403">Litigation Hold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302100">ການພັກເອກະສານເພື່ອການດຳເນີນການ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28619_1489914_2114788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a request for payment.</descrip></descripGrp><ntig><termGrp><term id="1489914">billing</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114788">ການສົ່ງບິນ​ເກັບ​ເງິນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2865_19878_464916"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The special identification code printed as a set of vertical bars of differing widths on books, grocery products, and other merchandise. Used for rapid, error-free input in such facilities as libraries, hospitals, and grocery stores, bar codes represent binary information that can be read by an optical scanner. The coding can include numbers, letters, or a combination of the two; some codes include built-in error checking and can be read in either direction.</descrip></descripGrp><ntig><termGrp><term id="19878">bar code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="464916">ລະຫັດບາໂຄດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2865_237346_464916"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The special identification code printed as a set of vertical bars of differing widths on books, grocery products, and other merchandise. Used for rapid, error-free input in such facilities as libraries, hospitals, and grocery stores, bar codes represent binary information that can be read by an optical scanner. The coding can include numbers, letters, or a combination of the two; some codes include built-in error checking and can be read in either direction.</descrip></descripGrp><ntig><termGrp><term id="237346">barcode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="464916">ລະຫັດບາໂຄດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28664_1490062_2302189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An offer from Microsoft Office 365 designed for small businesses (fewer than 25 users) and professionals that need anywhere access to email and documents with Office Web Apps.</descrip></descripGrp><ntig><termGrp><term id="1490062">Microsoft Office 365 (Plan P1)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302189">Microsoft Office 365 (Plan P1)</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28666_1490065_2302187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An offer from Microsoft Office 365 designed for people in your business without a dedicated PC that need occasional access to web email and international sites.</descrip></descripGrp><ntig><termGrp><term id="1490065">Microsoft Office 365 (Plan K1)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302187">Microsoft Office 365 (Plan K1)</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28667_1490066_2302188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An offer from Microsoft Office 365 designed for people in your business without a dedicated PC that need occasional access to web email and internal sites.</descrip></descripGrp><ntig><termGrp><term id="1490066">Microsoft Office 365 (Plan K2)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302188">Microsoft Office 365 (Plan K2)</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28669_1490071_2302184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An offer from Microsoft Office 365 designed for businesses that need communication and collaboration tools accessible from PCs, the web, and mobile devices.</descrip></descripGrp><ntig><termGrp><term id="1490071">Microsoft Office 365 (Plan E1)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302184">Microsoft Office 365 (Plan E1)</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28671_1490073_2302185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An offer from Microsoft Office 365 designed for businesses that need full productivity, communications, and collaboration tools with the Office suite, including Office Web Apps.</descrip></descripGrp><ntig><termGrp><term id="1490073">Microsoft Office 365 (Plan E3)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302185">Microsoft Office 365 (Plan E3)</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28673_1490075_2302186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An offer from Microsoft Office 365 designed for businesses that need full productivity, communication, and collaboration tools with the Office suite, including Office Web Apps and on-premises server rights to information protection and enterprise voice capabilities.</descrip></descripGrp><ntig><termGrp><term id="1490075">Microsoft Office 365 (Plan E4)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302186">Microsoft Office 365 (Plan E4)</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28691_1490094_2855676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer from Microsoft Office 365 that provides a unified communications plan with advanced capabilities, including enterprise instant messaging, presence, and online meetings with audio and video conferencing and multiparty data sharing.</descrip></descripGrp><ntig><termGrp><term id="1490094">Lync Online (Plan 2)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2855676">Lync Online (Plan 2)</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28719_1491626_2855662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An act that has an effect in a system.</descrip></descripGrp><ntig><termGrp><term id="1491626">action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2855662">ຄຳສັ່ງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28720_1491627_2488867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A definite magnitude of currency, a quantity of currency, or an indefinite magnitude of an uncountable substance or quality.</descrip></descripGrp><ntig><termGrp><term id="1491627">amount</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2488867">ຈຳນວນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2874_12683_2179119"><langSet xml:lang="en-US"><descripGrp><descrip type="de