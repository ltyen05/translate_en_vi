k</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465700">ການເຊື່ອມຕໍ່ທີ່ແນ່ນອນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20243_721657_2163510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A drop-down button that performs a default action and can also expand to a list of other possible actions.</descrip></descripGrp><ntig><termGrp><term id="721657">split button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163510">ປຸ່ມ​ແຍກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2025_93650_2302536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The POP protocol that is used to retrieve email and that supports download-and-delete from a remote mailbox.</descrip></descripGrp><ntig><termGrp><term id="93650">POP3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302536">POP3</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2025_93650_2302538"><langSet xml:lang="en-US"><descripGrp><descrip type