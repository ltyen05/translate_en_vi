29141">unblock</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2330139">ປົດບລັອກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40040_2329142_2330138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text message sent to an electronic device to notify the receiver of something because the receiver has requested notification or accepted an offer to be notified about something.</descrip></descripGrp><ntig><termGrp><term id="2329142">SMS alert</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2330138">ການແຈ້ງເຕືອນ SMS</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40041_2329143_2330137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype call hosted by one user where lots of other users can join and participate in</descrip></descripGrp><ntig><termGrp><term id="2329143">Skypecast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2330137">Skypecast</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40043_2329145_2330135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that can be installed on any mobile or landline in any supported country. It provides users with numbers that let them call friends, family and colleagues abroad from any mobile or landline while avoiding international calling charges.</descrip></descripGrp><ntig><termGrp><term id="2329145">Skype to Go</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2330135">Skype to Go</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40044_2329146_2330134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web-based meeting scheduling and management tool. With Skype for Business Web Scheduler, you can create new meetings, change your existing meetings, and send invitations using your favorite email program.</descrip></descripGrp><ntig><termGrp><term id="2329146">Skype for Business Web Scheduler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2330134">Skype for Business Web Scheduler</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40045_2329147_2330133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An add-on for Skype for Business Online that provides phone capabilities.</descrip></descripGrp><ntig><termGrp><term id="2329147">Skype for Business Online Phone Add-on</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2330133">Skype for Business Online Phone Add-on</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40046_2329148_2330132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Skype for Business app for use on mobile devices</descrip></descripGrp><ntig><termGrp><term id="2329148">Skype for Business Mobile app</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2330132">ແອັບ Skype for Business Mobile</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40047_2329149_2330131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Skype for Business client for Windows Phone</descrip></descripGrp><ntig><termGrp><term id="2329149">Skype for Business for Windows Phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2330131">Skype for Business for Windows Phone</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40048_2329150_2330130"><langSe