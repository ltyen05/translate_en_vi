ip type="definition">The warning that Excel displays when a function cannot be executed because configuration or user settings block certain functionality, such as accessing data over the internet.</descrip></descripGrp><ntig><termGrp><term id="2485701">#BLOCKED!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2487868">#ບລັອກແລ້ວ!</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44245_2485904_2489042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A website that customers can go to for help with Microsoft products.</descrip></descripGrp><ntig><termGrp><term id="2485904">Microsoft Support</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2489042">ການຊ່ວຍເຫຼືອ Microsoft</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4425_232401_2301992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Calendar, time status and user defined labels are indicated by colors and patterns.</descrip></descripGrp><ntig><termGrp><term id="232401">free/busy time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301992">ເວລາ ຫວ່າງ/ບໍ່ຫວ່າງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech"