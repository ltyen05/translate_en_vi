="156634">pop-up item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149525">ລາຍ​ການ​ປັອບ​ອັບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8749_156635_2149525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A new instance of the browser that occurs in the foreground of an html environment. Pop-up items include pop-up ads, pop-up forms, and other graphical browser-based items.</descrip></descripGrp><ntig><termGrp><term id="156635">pop-up</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149525">ລາຍ​ການ​ປັອບ​ອັບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8751_418607_2149616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prevent another user from initiating a conversation and from viewing your presence or other information, such as your personal information.</descrip></descripGrp><ntig><termGrp><term id="418607">block</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149616">ບ​ລັອກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8757_558600_2149620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The list of answers to a search request that match the search criteria specified by the user.</descrip></descripGrp><ntig><termGrp><term id="558600">search results</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149620">ຜົນ​ໄດ້​ຮັບ​ການ​ຊອກ​ຫາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8777_24948_464947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list in which each item or block of text is preceded by a bullet.</descrip></descripGrp><ntig><termGrp><term id="24948">bulleted list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="464947">ລາຍການເຄື່ອງໝາຍຫຍໍ້ໜ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8780_100131_465506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The temporary storage place on Windows where deleted files are transferred and remain until manually emptied and files are permanently deleted, which allows users to retrieve files until that point.</descrip></descripGrp><ntig><termGrp><term id="100131">Recycle Bin</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><t