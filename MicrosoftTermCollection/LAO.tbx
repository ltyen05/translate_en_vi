65684"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A primary document used in Excel to store and work with data. A worksheet consists of cells that are organized into columns and rows; a worksheet is always stored in a workbook.</descrip></descripGrp><ntig><termGrp><term id="134416">worksheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465684">ໜ້າຕາຕະລາງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5834_87984_465429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specific action carried out by a computer in the process of executing a program.</descrip></descripGrp><ntig><termGrp><term id="87984">operation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465429">ການດຳເນີນງານ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5835_138731_2301707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism provided by the common language runtime whereby managed code is granted permissions by security policy and these permissions are enforced, helping to limit the operations that the code will be allowed to perform.</descrip></descripGrp><ntig><termGrp><term id="138731">code access security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet