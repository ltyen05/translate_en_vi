ch">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="464996">ຊີໂອເອ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28144_1468763_2488870"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business transaction or an agreement, especially one that is mutually beneficial.</descrip></descripGrp><ntig><termGrp><term id="1468763">deal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2488870">ຂໍ້ສະເໜີ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2815_1421_2301974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security solution that segregates one portion of a network from another portion, allowing only authorized network traffic to pass through according to traffic filtering rules.</descrip></descripGrp><ntig><termGrp><term id="1421">firewall</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301974">ໄຟຣ໌ວໍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2815_362568_2301974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security solution that segregates one portion of a network from another portion, allowing only authorized network traffic to pass through according to traffic filtering rules.</descrip></descripGrp><ntig><termGrp><term id="362568">security-edge gateway</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301974">ໄຟຣ໌ວໍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2820_206426_465951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Presentation Foundation, an event routing strategy where the event instance moves down the element tree (starting at the root of the visual tree and ending with the source). The names of events that use this routing strategy are prefixed with the word "Preview". These events have the same signature as their counterparts that use the bubbling event routing strategy.</descrip></descripGrp><ntig><termGrp><term id="206426">tunneling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465951">ເສັ້ນທາງໃຕ້ພື້ນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28204_1475084_2163597"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The upper limit in a permitted range of values.</descrip></descripGrp><ntig><termGrp><term id="1475084">upper bound</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163597">ຂີດ​ຈຳ​ກັດ​ດ້ານ​ເທິງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2824_2685641_2687205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A listing of keywords and associated data that point to the location of more comprehensive information, such as files and records on a disk or record keys in a database.</descrip></descripGrp><ntig><termGrp><term id="2685641">search index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2687205">ດັດຊະນີການຊອກຫາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2824_2685641_465267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A listing of keywords and associated data that point to the location of more comprehensive information, such as files and records on a disk or record keys in a database.</descrip></descripGrp><ntig><termGrp><term id="2685641">search index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465267">ດັດຊະນີ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2824_65752_2