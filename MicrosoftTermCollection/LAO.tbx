US"><descripGrp><descrip type="definition">A token that is automatically used when an AI action is taken by a user, through Copilot, Designer, Paint, Windows or other services. Some features may require more than one credit.</descrip></descripGrp><ntig><termGrp><term id="3187524">AI credit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3187687">ເຄຣດິດ AI</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56488_3187524_3187690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A token that is automatically used when an AI action is taken by a user, through Copilot, Designer, Paint, Windows or other services. Some features may require more than one credit.</descrip></descripGrp><ntig><termGrp><term id="3187524">AI credit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3187690">ເຄຣດິດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5649_140798_2301814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that displays all rows, or records, from the underlying record source.</descrip></descripGrp><ntig><termGrp><term id="140798">detail field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301814">ຊ່ອງຂໍ້ມູນລາຍລ