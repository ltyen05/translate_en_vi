ken words.</descrip></descripGrp><ntig><termGrp><term id="2632939">text to speech</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2416663">ການປ່ຽນຂໍ້ຄວາມເປັນສຽງເວົ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42565_2410900_2416662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office feature that enables text-to-speech in OneNote, Outlook, PowerPoint, and Word.</descrip></descripGrp><ntig><termGrp><term id="2410900">Speak</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2416662">ການເວົ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42566_2410901_2416664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ink that is shown while the user is drawing with a stylus before the stylus has been lifted up.</descrip></descripGrp><ntig><termGrp><term id="2410901">wet ink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2416664">ໝຶກປຽກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEn