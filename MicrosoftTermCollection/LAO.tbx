p type="definition">The amount of data the user can download/upload through the carrier's network each month without being billed additional charges.</descrip></descripGrp><ntig><termGrp><term id="1802886">data limit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114837">ຂີດຈໍາກັດຂໍ້ມູນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33570_2164314_2216939"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-loaded app that allows users to better monitor and manage their data usage on their phone or PC. It can notify users when they are close to their cellular data limit and delay some data-intensive tasks until the phone or PC is connected to Wi-Fi.</descrip></descripGrp><ntig><termGrp><term id="2164314">Data usage</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2216939">ການ​ໃຊ້​ຂໍ້​ມູນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33571_1802888_2114848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button label to note that the user does not like a suggestion in Local Scout.</descrip></descripGrp><ntig><termGrp><term id="1802888">dislike</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114848">ບໍ່ຖືກໃຈ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33576_1803504_2114874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default room name in the Rooms feature of the People Hub. Based on the concept of the "family room" in many homes, in which family and guests gather for group activities.</descrip></descripGrp><ntig><termGrp><term id="1803504">Family Room</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114874">ຫ້ອງຄອບຄົວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33577_1803505_2115087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A place on the phone where families (or other close-knit groups) can stay in touch. Rooms take the form of a panorama that lives in the People Hub. The panorama includes a family chat card, a shared calendar, a shared photo album, and a shared notebook. Users ask others to join their Room via an SMS invite.</descrip></descripGrp><ntig><termGrp><term id="1803505">room</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2115087">ຫ້ອງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33578_1803510_2114875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An NFC-enabled card (like a credit card) that users can use for payments or other transactions even when the phone is locked.</descrip></descripGrp><ntig><termGrp><term id="1803510">fast card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114875">ບັດດ່ວນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33579_1803511_2114887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flash mode used to set off the flash automatically according to the ambient light conditions.</descrip></descripGrp><ntig><termGrp><term id="1803511">flash auto</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114887">ແຝຼັດອັດຕະໂນມັດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33580_1803512_2114888"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flash mode when the phone's built-in camera flash is set to off.</descrip></descripGrp><ntig><termGrp><term id="1803512">flash off</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114888">ແຝຼັດມອດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33581_1803513_2114889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flash mode when the phone's built-in camera flash is set to on.</descrip></descripGrp><ntig><termGrp><term id="1803513">flash on</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114889">ແຝຼັດເປີດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33582_1803514_2114895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera on the front of an electronic device (such as a smartphone), which faces the user. This allows the user to video chat with another person also using a front-facing device. It may also be used to take videos and pictures.</descrip></descripGrp><ntig><termGrp><term id="1803514">front</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114895">ດ້ານໜ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33584_1803518_2114906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text message thread between a group of people (usually more than 2). It allows you to keep all the replies from people in one thread, so that you can see the whole conversation.</descrip></descripGrp><ntig><termGrp><term id="1803518">group text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114906">ຂໍ້ຄວາມກຸ່ມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33585_1803519_2309884"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that provides easy access to Help and how-to content as well as helpful tips for users.</descrip></descripGrp><ntig><termGrp><term id="1803519">Help+Tips</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2309884">ວິທີໃຊ້+ເຄັດລັບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33587_1803522_2114936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An APN (Access Point Name) that determines the cellular data networks to which a phone can connect. It includes information about what kind of connection, security, and type of IP address the phone should use for the Internet connection.</descrip></descripGrp><ntig><termGrp><term id="1803522">Internet APN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114936">APN ອິນເຕີເນັດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33588_1803523_2114983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The APN (Access Point Name) a phone can use to send MMS messages (text messages with multimedia files attached).</descrip></descripGrp><ntig><termGrp><term id="1803523">MMS APN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114983">MMS APN</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33589_1803524_2114939"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The company or organization that issued the user the card they're adding to their wallet. For example, an issuer could be a bank.</descrip></descripGrp><ntig><termGrp><term id="1803524">issuer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114939">ຜູ້ອອກໃຫ້</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33591_1803526_2114940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The title of the screen prompting the user to sign in to his existing Microsoft account or to create a Microsoft account. By using the Microsoft account, Windows Phone will keep the user's important information and belongings synchronized in one place, helping keep the user's life organized and harmonious.</descrip></descripGrp><ntig><termGrp><term id="1803526">Keep your life in sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114940">ຮັກສາຂໍ້ມູນ ແລະອຸປະກອນຂອງທ່ານຢູ່ໃນການຊິງຄ໌</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33593_1803746_2114945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that helps parents provide their children with controlled access to their phones. In Kid's Corner, kids can only use the apps, games, and other content that parents select.</descrip></descripGrp><ntig><termGrp><term id="1803746">Kid's Corner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114945">ມຸມເດັກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33594_1803747_2114946"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">List of the top players in a game or other competition on Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="1803747">leaderboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114946">ກະດານຜູ້ນໍາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33594_3144583_2114946"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">List of the top players in a game or other competition on Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="3144583">Xbox leaderboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114946">ກະດານຜູ້ນໍາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33595_1803748_2114947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A first or third-party application that works with the Windows Phone camera to offer additional features and functionality for users taking and editing pictures.</descrip></descripGrp><ntig><termGrp><term id="1803748">lens</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114947">ເລນສ໌</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33596_1803750_2114971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A relationship of being a member of an organization, such as a gym or club.</descrip></descripGrp><ntig><termGrp><term id="1803750">membership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet 