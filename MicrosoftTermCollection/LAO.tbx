maticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465466">ຕົວຫຼິ້ນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13576_308346_466418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Another site promoted by the host site.</descrip></descripGrp><ntig><termGrp><term id="308346">sponsored site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466418">ອຸປະຖໍາທີ່ຕັ້ງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13577_109632_2163470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portion of an on-screen file that has been marked as subject to user action.</descrip></descripGrp><ntig><termGrp><term id="109632">selection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163470">ການ​ເລືອກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13587_25017_2487474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To combine products for sale as a lot. Frequently, operating system software and some widely used applications are bundled with a computer system for sale.</descrip></descripGrp><ntig><termGrp><term id="25017">bundle</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2487474">ຂາຍສ່ວນຕ່າງຮວມເຂົ້າດ້ວຍກັນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13592_25636_464952"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The surface of a button where text or an image (typically indicating the button's function) may be displayed.</descrip></descripGrp><ntig><termGrp><term id="25636">button face</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="464952">ໜ້າປຸ່ມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13594_503136_2728447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The presence status that indicates a user hasn't used his/her mouse, keyboard, computer, mobile phone, or communications device for a specified time.</descrip></descripGrp><ntig><termGrp><term id="503136">Inactive</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2728447">ບໍ່ໃຊ້ງານ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNot