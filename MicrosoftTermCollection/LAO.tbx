e type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2599903">ການພິສູດຢືນຢັນລູກຂ່າຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1716_84183_2179526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer hardware component providing access to a network.</descrip></descripGrp><ntig><termGrp><term id="84183">network adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179526">ຕົວປັບຕໍ່ເຄືອຂ່າຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1716_84183_465401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer hardware component providing access to a network.</descrip></descripGrp><ntig><termGrp><term id="84183">network adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465401">ຄາດເຄືອຂ່າຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17168_639983_2115077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To continue a process or service that has been paused.</descrip></descripGrp><ntig><termGrp><term id="639983">resume</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2115077">ດຳເນີນຕໍ່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17184_640166_2115075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To set an entity, such as a feature, configuration, or object, back to its defaults.</descrip></descripGrp><ntig><termGrp><term id="640166">reset</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2115075">ຕັ້ງຄ່າຄືນໃໝ່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17191_640175_2746921"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identifier that is given to a customer record to indicate that the customer is the same as a corresponding customer record in another company that shares the same directory ID.</descrip></descripGrp><ntig><termGrp><term id="640175">directory ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2746921">ໄອດີໄດເຣັກທໍຣີ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1730_36286_2301723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of search conditions that is used to find data. Comparison criteria can be a series of characters that you want to match, such as "Northwind Traders," or an expression, such as "&gt;300."</descrip></descripGrp><ntig><termGrp><term id="36286">comparison criteria</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301723">ເກນການປຽບທຽບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17311_640433_2149621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The navigation button used to complete and close a wizard.</descrip></descripGrp><ntig><termGrp><term id="640433">Finish</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149621">ສຳ​ເລັດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17312_640434_3144659"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A navigation button used to return to a page from which the user has navigated away via the web browser Back command.</descrip></descripGrp><ntig><termGrp><term id="640434">Forward</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3144659">ໄປທາງໜ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17321_640444_2855671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who does not have a user account or who does not provide a password.</descrip></descripGrp><ntig><termGrp><term id="640444">guest</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2855671">ແຂກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1735_41913_465088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove part of a document, usually placing it temporarily in memory so that the cut portion can be inserted (pasted) elsewhere.</descrip></descripGrp><ntig><termGrp><term id="41913">cut</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465088">ຕັດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17387_641212_2302754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container with a set of properties that can be configured to control the organization and format of Web Parts on a Web Part Page.</descrip></descripGrp><ntig><termGrp><term id="641212">Web Part zone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302754">ໂຊນ Web Part</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1739_149687_2736638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula that checks whether a given value is valid for a particular field.</descrip></descripGrp><ntig><termGrp><term id="149687">validation formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2736638">ສູດຄຳນວນການກວດສອບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="174_138672_2725380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hierarchical organization of media clips that users can create, import, add additional clips collections to, move, or copy clips from one collection into it.</descrip></descripGrp><ntig><termGrp><term id="138672">clip collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2725380">ຄໍເລັກຊັນຄລິບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1740_231978_2302634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For automatic subtotals and worksheet outlines, all rows or columns that summarize detail data. Summary data usually is adjacent to and below the detail data.</descrip></descripGrp><ntig><termGrp><term id="231978">summary data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302634">ຂໍ້ມູນສະຫຼຸບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1741_128742_2590823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Teleconferencing in which video images are transmitted among the various geographically separated participants in a meeting.</descrip></descripGrp><ntig><termGrp><term id="128742">video conferencing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2590823">ການປະຊຸມວິດີໂອ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17419_645117_2163059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of reusable settings that describes the shared attributes and behaviors of a list item, a document, or a folder.</descrip></descripGrp><ntig><termGrp><term id="645117">content type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163059">ປະ​ເພດ​ເນື້ອ​ໃນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun