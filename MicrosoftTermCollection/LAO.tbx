m a library of professional stock assets that is integrated in the Clipchamp video editor for use in editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060422">stock video</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3071603">ວິດີໂອຈາກຄັງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53737_3060423_3071598"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio clip from a library of professional stock assets that is integrated in the Clipchamp video editor for use in editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060423">stock audio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3071598">ສຽງຈາກຄັງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53738_3060424_3071601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image/photo from a library of professional stock assets that is integrated in the Clipchamp video editor for use in editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060424">stock image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3071601">ຮູບຈາກຄັງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53739_3060425_3067081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of visual elements such as animated clips, GIFs, images, colored backgrounds or overlays that are used in video editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060425">graphics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3067081">ກຣາບຟິກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53740_3060426_3071597"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An animated or still image such as a cartoon figure that can be inserted in video editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060426">sticker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3071597">ສະຕິກເກີ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53741_3060427_3069638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of an aspect ratio preset in Clipchamp that lets users create videos that have the correct height and width to be uploaded as videos on popular social media platforms.</descrip></descripGrp><ntig><termGrp><term id="3060427">Social</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3069638">ໂຊຊ້ຽວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53742_3060428_3064029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video editing transition effect used to move from one video clip to another.</descrip></descripGrp><ntig><termGrp><term id="3060428">fade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3064029">ຈາງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53743_3060429_3067070"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Clipchamp, to break assets on the timeline of a video editing project into multiple smaller segments.</descrip></descripGrp><ntig><termGrp><term id="3060429">cut</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3067070">ຕັດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53744_3060430_3067074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transition effect placed at the beginning of a video clip that gradually increases the visibility of the image or the sound of an audio track.</descrip></descripGrp><ntig><termGrp><term id="3060430">fade in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3067074">ຈາງເຂົ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53744_3060431_3067074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transition effect placed at the beginning of a video clip that gradually increases the visibility of the image or the sound of an audio track.</descrip></descripGrp><ntig><termGrp><term id="3060431">fade-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3067074">ຈາງເຂົ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53745_3060432_3067075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transition effect placed at the end of a video clip that gradually decreases the visibility of the image or the sound of an audio track.</descrip></descripGrp><ntig><termGrp><term id="3060432">fade out</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3067075">ຈາງອອກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</