Grp><descrip type="definition">The Office 365 Security &amp; Compliance Center feature that allows admins to manage mobile device access to company data, manage data loss, helps them protect the company from inbound and outbound malicious software and spam, and that helps them determine if senders are maliciously spoofing accounts from their domain.</descrip></descripGrp><ntig><termGrp><term id="2701271">Threat management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2703291">ການຈັດການໄພຄຸກຄາມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47930_2701275_2703289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email whose purpose is to scam users, steal their data, or take control of their devices.</descrip></descripGrp><ntig><termGrp><term id="2701275">malicious mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2703289">ອີເມວທີ່ເປັນອັນຕະລາຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47932_2701277_2703292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Security &amp; Compliance Center feature that allows admins to track ongoing security problems and campaigns as well as general trends and queries.</descrip></descripGrp><ntig><termGrp><term id="2701277">Threat tracker</term><termNote type="partOfS