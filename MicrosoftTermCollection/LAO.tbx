r">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465173">ບັນຈຸໂປຣແກຣມນ້ອຍເຂົ້າໃນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6202_70557_465293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reverse something or change it to its opposite.</descrip></descripGrp><ntig><termGrp><term id="70557">invert</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465293">ການສັບປ່ຽນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6208_147957_2302472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that can show formatting and graphics, such as an embedded object, and not just text.</descrip></descripGrp><ntig><termGrp><term id="147957">rich text field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302472">ຊ່ອງຂໍ້ມູນ rich text</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="621_121364_2179713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of object within a process that runs program instructions. Using multiple threads allows concurrent operations within a process and enables one process to run different parts of its program on different processors simultaneously. A thread has its own set of registers, its own kernel stack, a thread environment block, and a user stack in the address space of its process.</descrip></descripGrp><ntig><termGrp><term id="121364">thread</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179713">ສາຍໂຍງໄຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="621_121364_465609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of object within a process that runs program instructions. Using multiple threads allows concurrent operations within a process and enables one process to run different parts of its program on different processors simultaneously. A thread has its own set of registers, its own kernel stack, a thread environment block, and a user stack in the address space of its process.</descrip></descripGrp><ntig><termGrp><term id="121364">thread</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465609">ສອດຕໍ່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6223_307422_2301819"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A password or a passcode that the users set on their device such as smartphones.</descrip></descripGrp><ntig><termGrp><term id="307422">device password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301819">ລະຫັດຜ່ານອຸປະກອນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6224_144653_2162561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A placeholder for text or pictures that you insert into your document.</descrip></descripGrp><ntig><termGrp><term id="144653">merge field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162561">ລວມ​ຫ້ອງ​ເຂົ້າ​ກັນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6231_144677_2163277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single cell that is created by combining two or more selected cells. The cell reference for a merged cell is the upper-left cell in the original selected range.</descrip></descripGrp><ntig><termGrp><term id="144677">merged cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163277">ເຊ​ລ​ລວມ​ກັນ​ແລ້ວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6232_141181_2179307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area upon which users can draw multiple shapes, such that the shapes can be moved and resized as a unit.</descrip></descripGrp><ntig><termGrp><term id="141181">drawing canvas</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179307">ແຜ່ນໃຊ້ແຕ້ມຮູບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6232_141181_465752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area upon which users can draw multiple shapes, such that the shapes can be moved and resized as a unit.</descrip></descripGrp><ntig><termGrp><term id="141181">drawing canvas</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465752">ເຄື່ອງມືແຕ້ມຮູບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6239_264786_2162512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view for delivering a presentation that provides the presenter with additional options for viewing and controlling its delivery.</descrip></descripGrp><ntig><termGrp><term id="264786">Presenter View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162512">ມຸມມອງ​ຜູ້​ນຳ​ສະ​ເໜີ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6240_30724_2179250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of payment card where the supplier is paid by the card issuer. The card holder then pays the card issuer.</descrip></descripGrp><ntig><termGrp><term id="30724">credit card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179250">ບັດເຄຣດິດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6240_30724_465003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of payment card where the supplier is paid by the card issuer. The card holder then pays the card issuer.</descrip></descripGrp><ntig><termGrp><term id="30724">credit card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465003">ບັດສິນເຊື່ອ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6247_318716_2120570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of compositions or memorabilia of a specific type or for a particular purpose, such as audio recordings, photographs, or documents.</descrip></descripGrp><ntig><termGrp><term id="318716">album</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2120570">ອາລະບໍາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6247_318716_466538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of compositions or memorabilia of a specific type or for a particular purpose, such as audio recordings, photographs, or documents.</descrip></descripGrp><ntig><termGrp><term id="318716">album</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466538">ຊຸດເພງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6250_105621_465518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A return to a previous stable condition, as when the contents of a hard disk are restored from a backup after a destructive hard disk error.</descrip></descripGrp><ntig><termGrp><term id="105621">rollback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465518">ມ້ວນຄືນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="626_61316_465237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Not visible to the user.</descrip></descripGrp><ntig><termGrp><term id="61316">hidden</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465237">ເຊື່ອງໄວ້ໄດ້</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6270_380992_2163264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A version that is ready for a larger group to see or that has changed significantly since the previous major version.</descrip></descripGrp><ntig><termGrp><term id="380992">major version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163264">ລຸ້ນ​ໃຫຍ່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6273_145441_2163331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of software that provides access to a particular type of OLAP database. This software can include a data source driver and other client software that is necessary to connect to a database.</descrip></descripGrp><ntig><termGrp><term id="145441">OLAP provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163331">ຜູ້​ໃຫ້​ບໍ​ລິ​ການ OLAP</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6279_26739_2120580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To attempt to establish a voice conversation with another person or other people from a phone, computer, or mobile device.</descrip></descripGrp><ntig><termGrp><term id="26739">call</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2120580">ໂທ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6279_26739_464964"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To attempt to establish a voice conversation with another person or other people from a phone, computer, or mobile device.</descrip></descripGrp><ntig><termGrp><term id="26739">call</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="464964">ເອີ້ນຫາເພື່ອເຊື່ອມຕໍ່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6282_139056_465723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Colors that are opposite each other on the color wheel, such as yellow and blue.</descrip></descripGrp><ntig><termGrp><term id="139056">complementary colors</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465723">ການປະສົມສີຕ່າງໆ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6287_89072_2162521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Worksheet data in which rows or columns of detail data are grouped so that you can create summary reports. The outline can summarize either an entire worksheet or a selected portion of it.</descrip></descripGrp><ntig><termGrp><term id="89072">outline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162521">ເຄົ້າ​ໂຄງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6288_307448_2302500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Outlook and Outlook Web Access feature that automatically suggests the best meeting times for a given a group of attendees, allowing users to schedule people and resources quickly and efficiently.</descrip></descripGrp><ntig><termGrp><term id="307448">Scheduling Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302500">ຜູ້ຊ່ວຍ​ກຳນົດ​ເວລາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="