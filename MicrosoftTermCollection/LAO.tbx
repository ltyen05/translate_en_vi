"><descripGrp><descrip type="definition">A packet of bytes meant to transfer a small amount of data between programs.</descrip></descripGrp><ntig><termGrp><term id="2506548">token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2512859">ໂທເຄັນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44561_2506549_2512861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An opaque token provided by Microsoft Graph to a notification URL that needs to be provided back to Microsoft Graph in order to validate ownership of the notification URL.</descrip></descripGrp><ntig><termGrp><term id="2506549">validation token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2512861">ໂທເຄັນການຢັ້ງຢືນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44562_2506550_2512845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A querying functionality that enables applications to discover newly created, updated, or deleted entities without performing a full read of the target resource with every request.</descrip></descripGrp><ntig><termGrp><term id="2506550">delta query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2512845">ເດລຕາຄິວຣີ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44563_2506551_2512844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string on the end of the path in a GET request (“/delta”) that triggers delta query.</descrip></descripGrp><ntig><termGrp><term id="2506551">delta function</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2512844">ຟັງຊັນເດລຕາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44564_2506552_2512843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A complete set of data returned for a resource from a delta query GET request.</descrip></descripGrp><ntig><termGrp><term id="2506552">delta feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2512843">ເດລຕາຟີດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44565_2506553_2512858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An opaque token returned in a delta query GET response which encodes the point in time of the last data provided to the client.</descrip></descripGrp><ntig><termGrp><term id="2506553">state token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2512858">ໂທເຄັນສະຖານະ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44567_2506560_2512847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of data about a resource that contains complex values, generally indicating behaviors or capabilities of an item.</descrip></descripGrp><ntig><termGrp><term id="2506560">facet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2512847">ຫຼ່ຽມມຸມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44568_2506562_2512846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of data related to Outlook MAPI properties not already exposed in the Microsoft Graph API metadata.</descrip></descripGrp><ntig><termGrp><term id="2506562">extended property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2512846">ຄຸນສົມບັດສ່ວນຂະຫຍາຍອອກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44569_2506611_2513148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that enables Wi-Fi devices to connect directly, without a router or other mechanism, making it simpler to do things like print, share, sync, and display.​</descrip></descripGrp><ntig><termGrp><term id="2506611">Wi-Fi Direct</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2513148">Wi-Fi Direct</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44586_2506886_2513139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that enables members of a Language community to provide translation and language-related feedback about features. The app is currently available only for Windows Desktop.</descrip></descripGrp><ntig><termGrp><term id="2506886">Language Community app</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2513139">ແອັບຊຸມຊົນດ້ານພາສາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44587_2506888_2513140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request to gather and send language feedback using quests in Feedback Hub and the Language Community app.​</descrip></descripGrp><ntig><termGrp><term id="2506888">language quest</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2513140">ຄຳຂໍດ້ານພາສາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4459_148656_2162424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The slide that stores information about the design template applied, including font styles, placeholder sizes and positions, background design, and color schemes.</descrip></descripGrp><ntig><termGrp><term id="148656">slide master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162424">ແມ່​ແບບ​ສະ​ໄລ​ດ໌</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44608_2573054_2578452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of the expanded view of the profile card that contains LinkedIn profile information.</descrip></descripGrp><ntig><termGrp><term id="2573054">LinkedIn profile in Microsoft</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2578452">ໂປຣໄຟລ໌ LinkedIn ໃນ Microsoft</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44611_2509173_2515057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to compose and save a message as a template, and then reuse it when they want to.</descrip></descripGrp><ntig><termGrp><term id="2509173">Email templates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2515057">ແມ່ແບບອີເມວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4462_72367_2179433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The core of layered architecture that manages the most basic operations of the operating system and the computer's processor. The kernel schedules different blocks of executing code, called threads, for the processor to keep it as busy as possible and coordinates multiple processors to optimize performance. The kernel also synchronizes activities among Executive-level subcomponents, such as I/O Manager and Process Manager, and handles hardware exceptions and other hardware-dependent functions. The kernel works closely with the hardware abstraction layer.</descrip></descripGrp><ntig><termGrp><term id="72367">kernel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179433">ແກນກາງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4462_72367_465302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The core of layered architecture that manages the most basic operations of the operating system and the computer's processor. The kernel schedules different blocks of executing code, called threads, for the processor to keep it as busy as possible and coordinates multiple processors to optimize performance. The kernel also synchronizes activities among Executive-level subcomponents, such as I/O Manager and Process Manager, and handles hardware exceptions and other hardware-dependent functions. The kernel works closely with the hardware abstraction layer.</descrip></descripGrp><ntig><termGrp><term id="72367">kernel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465302">ແກ່ນສານ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44639_2512914_2730963"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack in which attackers attempt to increase existing privileges and use them multiple times in order to eventually gain full control over the victim’s environment.</descrip></descripGrp><ntig><termGrp><term id="2512914">privilege escalation attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2730963">ການໂຈມຕີເພື່ອເພີ່ມລະດັບສິດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44646_2897501_2897618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that helps protect your enterprise hybrid environments from multiple types of advanced targeted cyber attacks and insider threats.</descrip></descripGrp><ntig><termGrp><term id="2897501">Microsoft Defender for Identity</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2897618">Microsoft Defender ສໍາລັບເອກະລັກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44647_2513424_2519175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To take an existing story in the Photos app and generate a new version of that story with edits to content, style, music, and other options.​</descrip></descripGrp><ntig><termGrp><term id="2513424">remix</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2519175">remix</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44648_2513444_2519176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Groove Music app, a graphical display that changes colors and shapes on the screen in response to the music that is playing. The user can choose from several different visualizers, which each look different.</descrip></descripGrp><ntig><termGrp><term id="2513444">visualizer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2519176">ຕົວປັບພາບ</term><termNote type="geographicalUsage">LAO</termNot