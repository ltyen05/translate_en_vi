y that enables a user to see updates made by another user in a document while that user is typing the updates.</descrip></descripGrp><ntig><termGrp><term id="2569041">real-time typing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2569803">ການພິມແບບສົດໆ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45560_2569041_2569805"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The functionality that enables a user to see updates made by another user in a document while that user is typing the updates.</descrip></descripGrp><ntig><termGrp><term id="2569041">real-time typing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2569805">RTT</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45560_2569042_2569803"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The functionality that enables a user to see updates made by another user in a document while that user is typing the updates.</descrip></descripGrp><ntig><termGrp><term id="2569042">RTT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2569803">ການພິມແບບສົດໆ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelect