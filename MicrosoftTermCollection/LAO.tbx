 hold an arbitrary number of operators.</descrip></descripGrp><ntig><termGrp><term id="265317">nary</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302220">n-ary</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14967_1057522_2163421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Capable of being retrieved (read), printed or copied but not changed (written) or saved.</descrip></descripGrp><ntig><termGrp><term id="1057522">RO</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163421">ອ່ານ​ເທົ່າ​ນັ້ນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14967_98978_2163421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Capable of being retrieved (read), printed or copied but not changed (written) or saved.</descrip></descripGrp><ntig><termGrp><term id="98978">read-only</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163421">ອ່ານ​ເທົ່າ​ນັ້ນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></te