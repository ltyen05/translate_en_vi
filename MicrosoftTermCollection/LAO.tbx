 that is tailored to business needs.</descrip></descripGrp><ntig><termGrp><term id="2626303">business-class email</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2632053">ອີເມວຊັ້ນທຸລະກິດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46676_2626303_2650446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A paid email service that is tailored to business needs.</descrip></descripGrp><ntig><termGrp><term id="2626303">business-class email</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2650446">ອີເມວທຸລະກິດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46676_2649138_2632053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A paid email service that is tailored to business needs.</descrip></descripGrp><ntig><termGrp><term id="2649138">business email</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2632053">ອີເມວຊັ້ນທຸລະກິດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46676_2649138_2650446