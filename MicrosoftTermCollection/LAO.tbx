a task pane where users can research papers by typing queries to get information such as sources, citations, quotes, and images.</descrip></descripGrp><ntig><termGrp><term id="2413500">Researcher</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2420877">ຕົວຄົ້ນຄວ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42608_2413506_2420878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office feature that allows users type queries and find information, sources, citations, quotes, and images, without leaving the application that they are using.</descrip></descripGrp><ntig><termGrp><term id="2413506">Researcher</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2420878">ຕົວຄົ້ນຄວ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42614_2414369_2417515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">T​o quickly return to an app, website, or document you were using earlier.</descrip></descripGrp><ntig><termGrp><term id="2414369">jump back</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2417515">ໂດດກັບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42615_2414370_2417516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of documents, apps, and websites that, in one click, allows you to pick up your work exactly where you left it earlier, on any device connected with the same Microsoft account.​​</descrip></descripGrp><ntig><termGrp><term id="2414370">jump group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2417516">ໂດດເປັນກຸ່ມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42616_2414371_2417514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To quickly jump to a document or application on another device that is connected to the same Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2414371">jump</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2417514">ໂດດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42617_2414373_2417517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets customers reset their network settings back to the Windows defaults.</descrip></descripGrp><ntig><termGrp><term id="2414373">network reset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2417517">ການ​ຕັ້ງ​ຄ່າ​ເຄື​ອຂ່າຍຄືນ​ໃໝ່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42639_2414859_2417518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that contains a customizable and extensible collection of ink-related features for Universal Windows apps. By default, the toolbar may include buttons for drawing, erasing, highlighting, setting ink color and stroke thickness, and displaying a ruler.</descrip></descripGrp><ntig><termGrp><term id="2414859">Windows Ink toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2417518">ແຖບເຄື່ອງມື Windows Ink</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42642_2414869_2530650"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move the camera forward or backwards, to zoom in and out the 3D object.</descrip></descripGrp><ntig><termGrp><term id="2414869">zoom</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2530650">ຊູມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42643_2415081_2489710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 app that allows users to submit timesheets and report progress on tasks tracked in Project Online.</descrip></descripGrp><ntig><termGrp><term id="2415081">Office 365 Project Time Reporter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2489710">Office 365 Project Time Reporter</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42643_2415081_2489711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 app that allows users to submit timesheets and report progress on tasks tracked in Project Online.</descrip></descripGrp><ntig><termGrp><term id="2415081">Office 365 Project Time Reporter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2489711">Time Reporter</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42643_2415082_2489710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 app that allows users to submit timesheets and report progress on tasks tracked in Project Online.</descrip></descripGrp><ntig><termGrp><term id="2415082">Time Reporter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2489710">Office 365 Project Time Reporter</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42643_2415082_2489711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 app that allows users to submit timesheets and report progress on tasks tracked in Project Online.</descrip></descripGrp><ntig><termGrp><term id="2415082">Time Reporter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2489711">Time Reporter</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42644_2415086_2489712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Project Time Reporter view that allows user to manage and record how they spend their personal and work time during a given week.</descrip></descripGrp><ntig><termGrp><term id="2415086">Timesheet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2489712">Timesheet</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42645_2415869_2420875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The context menu that pops up when text is selected in the Researcher panel giving the option of adding the selected text only or adding the selected text and a citation for the text.</descrip></descripGrp><ntig><termGrp><term id="2415869">Add Cite</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2420875">ເພີ່ມການອ້າງອີງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4265_101189_2179616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database repository for information about a computer's configuration. The registry contains information that Windows continually references during operation, such as: profiles for each user; the programs installed on the computer and the types of documents that each can create; property settings for folders and program icons; what hardware exists on the system; which ports are being used. The registry is organized hierarchically as a tree, and it is made up of keys and their subkeys, hives, and entries.</descrip></descripGrp><ntig><termGrp><term id="101189">registry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179616">ສໍານັກທະບຽນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4265_101189_465510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database repository for information about a computer's configuration. The registry contains information that Windows continually references during operation, such as: profiles for each user; the programs installed on the computer and the types of documents that each can create; property settings for folders and program icons; what hardware exists on the system; which ports are being used. The registry is organized hierarchically as a tree, and it is made up of keys and their subkeys, hives, and entries.</descrip></descripGrp><ntig><termGrp><term id="101189">registry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465510">ການລົງທະບຽນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4265_1167347_2179616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database repository for information about a computer's configuration. The registry contains information that Windows continually references during operation, such as: profiles for each user; the programs installed on the computer and the types of documents that each can create; property settings for folders and program icons; what hardware exists on the system; which ports are being used. The registry is organized hierarchically as a tree, and it is made up of keys and their subkeys, hives, and entries.</descrip></descripGrp><ntig><termGrp><term id="1167347">system registry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179616">ສໍານັກທະບຽນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4265_1167347_465510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database repository for information about a computer's configuration. The registry contains information that Windows continually references during operation, such as: profiles for each user; the programs installed on the computer and the types of documents that each can create; property settings for folders and program icons; what hardware exists on the system; which ports are being used. The registry is organized hierarchically as a tree, and it is made up of keys and their subkeys, hives, and entries.</descrip></descripGrp><ntig><termGrp><term id="1167347">system registry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465510">ການລົງທະບຽນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42654_2417345_2419179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool for erasing markings on a 2D surface.</descrip></descripGrp><ntig><termGrp><term id="2417345">eraser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2419179">ຢາງລຶບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42660_2418366_2425158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that puts together a PowerPoint or Sway outline based on the user's query, giving him or her a set of options to choose from, as well as advice on what can be included in the presentation or the sway.</descrip></descripGrp><ntig><termGrp><term id="2418366">QuickStarter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2425158">ການເລີ່ມຕົ້ນດ່ວນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42661_2418994_2421709"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device, such as a PC, some tablets, a 2-in-1, or an All-in-one, that uses the traditional Win32 app model and typically make use of COM or .NET runtime.</descrip></descripGrp><ntig><termGrp><term id="2418994">desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2421709">ເດັສທັອບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42661_2418994_2421710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device, such as a PC, some tablets, a 2-in-1, or an All-in-one, that uses the traditional Win32 app model and typically make use of COM or .NET runtime.</descrip></descripGrp><ntig><termGrp><term id="2418994">desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2421710">ອຸປະກອນເດັສທັອບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42661_2419397_2421709"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device, such as a PC, some tablets, a 2-in-1, or an All-in-one, that uses the traditional Win32 app model and typically make use of COM or .NET runtime.</descrip></descripGrp><ntig><termGrp><term id="2419397">desktop device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2421709">ເດັສທັອບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42661_2419397_2421710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device, such as a PC, some tablets, a 2-in-1, or an All-in-one, that uses the traditional Win32 app model and typically make use of COM or .NET runtime.</descrip></descripGrp><ntig><termGrp><term id="2419397">desktop device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2421710">ອຸປະກອນເດັສທັອບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42664_2419020_2421712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business rule that provides explicit, mandatory criteria to use when making a decision or taking action.</descrip></descripGrp><ntig><termGrp><term id="2419020">policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2421712">ນະໂຍບາຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42683_2420215_2423937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function which looks in a particular column of a table for a column lookup value and in a particular row for a row lookup value, and when both are found, returns the value in the cell at the intersection of the row and column.</descrip></descripGrp><ntig><termGrp><term id="2420215">VHLOOKUP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2423937">VHLOOKUP</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42684_2420713_2423935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft To-do feature that allows users to choose different backgrounds and that gives them the choice of paying for additional background options.</descrip></descripGrp><ntig><termGrp><term id="2420713">Theme</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term i