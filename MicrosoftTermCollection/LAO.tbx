ed for accessibility and compatibility with the widest array of browsers and operating systems.</descrip></descripGrp><ntig><termGrp><term id="2656621">Outlook Web App Light</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2657670">ເວັບແອັບ Outlook ແບບໄວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6846_14902_3145832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The arrangement of a sequence of items from lowest to highest, such as from 1 to 10 or from A to Z. The rules for determining ascending order in a particular application can be very complicated: capital letters before lowercase letters, extended ASCII characters in ASCII order, and so on.</descrip></descripGrp><ntig><termGrp><term id="14902">ascending order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3145832">A ຫາ Z</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6846_3144701_3145832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The arrangement of a sequence of items from lowest to highest, such as from 1 to 10 or from A to Z. The rules for determining ascending order in a particular application can be very complicated: capital letters before lowercase letters, extended ASCII characters in ASCII order, and so on.</descrip></descripGrp><ntig><termGrp><term id