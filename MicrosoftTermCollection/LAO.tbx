tig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179119">AA</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2874_1508824_2301594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software technique for smoothing the jagged appearance of curved or diagonal lines caused by poor resolution on a display screen by adjusting the brightness or color of surrounding pixels.</descrip></descripGrp><ntig><termGrp><term id="1508824">anti aliasing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301594">ການເຮັດຂອບມົນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2874_1508824_464871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software technique for smoothing the jagged appearance of curved or diagonal lines caused by poor resolution on a display screen by adjusting the brightness or color of surrounding pixels.</descrip></descripGrp><ntig><termGrp><term id="1508824">anti aliasing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="464871">ການປັບຄວາມລະອຽດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2874_1508824_464873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software technique for smoothing the jagged appearance of curved or diagonal lines caused by poor resolution on a display screen by adjusting the brightness or color of surrounding pixels.</descrip></descripGrp><ntig><termGrp><term id="1508824">anti aliasing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="464873">ເອເອ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28773_1496239_2301573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The stage during the email migration when the migration service is actively provisioning new cloud-based mailboxes.</descrip></descripGrp><ntig><termGrp><term id="1496239">active mailbox migration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301573">ການໂອນກ່ອງອີເມວທີ່ໃຊ້ໄດ້</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28774_1496240_2301578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An auditing record that records any action, based on a Windows PowerShell cmdlet, performed by an administrator. This can help the administrator troubleshoot configuration issues or identify the cause of security- or compliance-related problems.</descrip></descripGrp><ntig><termGrp><term id="1496240">administrator audit log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301578">ບັນທຶກການກວດສອບຜູ້ເບິ່ງແຍງລະບົບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28777_1496243_2301775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email migration process that provisions new cloud-based mailboxes and then migrates mailbox data to the cloud.</descrip></descripGrp><ntig><termGrp><term id="1496243">cutover migration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301775">ການຍົກຍ້າຍແບບປ່ຽນໃໝ່ໝົດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28778_1496244_2301921"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of message journaling in which the original unaltered message is included as an attachment in the journal report.</descrip></descripGrp><ntig><termGrp><term id="1496244">envelope journaling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301921">ລະບົບບັນທຶກແບບແນບຂໍ້ຄວາມຕົ້ນສະບັບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28779_1496245_2302009"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template applied to the distribution group names in your Microsoft Exchange organization. Specifically, you can specify that a prefix, a suffix, or both be applied to all distribution group names. You can also block certain words from being used in the names.</descrip></descripGrp><ntig><termGrp><term id="1496245">group naming policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302009">ນະໂຍບາຍການຕັ້ງຊື່ກຸ່ມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28780_1496246_2302047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In email migration, the stage when the mailboxes in the on-premises Exchange organization and the corresponding cloud-based mailboxes are synchronized every 24 hours, after the initial synchronization. This means that any new messages sent to the mailboxes on the Exchange server are copied to the corresponding cloud-based mailboxes. Incremental synchronization continues until the administrator completes the overall migration.</descrip></descripGrp><ntig><termGrp><term id="1496246">incremental synchronization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302047">ການຊິ້ງຂໍ້ມູນຕໍ່ເນື່ອງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28781_1496247_2302078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The message that is generated when a message matches a journal rule. The body of the journal report contains information from the original message such as the sender email address, message subject, message-ID, and recipient email addresses. The journal report also includes the original unaltered message as an attachment.</descrip></descripGrp><ntig><termGrp><term id="1496247">journal report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302078">ລາຍງານບັນທຶກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28782_1496248_2302079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Exchange rule that is used to record the email messages sent to or from specific recipients.</descrip></descripGrp><ntig><termGrp><term id="1496248">journal rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302079">ເງື່ອນໄຂການເຮັດບັນທຶກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28784_1496250_2302615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of email migration that migrates a subset of on-premises mailboxes to the cloud. This type of migration allows the admin to maintain coexistence between their on-premises and cloud-based email organizations.</descrip></descripGrp><ntig><termGrp><term id="1496250">staged migration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302615">ການໂອນຍ້າຍແບບກຳນົດລຳດັບຊັ້ນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28785_1496251_2301796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of saving only one copy of duplicate items in the search results</descrip></descripGrp><ntig><termGrp><term id="1496251">deduplication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301796">ການກຳຈັດຂໍ້ມູນຊໍ້າກັນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28786_1496252_2302038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique user identifier that must not change for the user over the lifetime of the user being in the system.</descrip></descripGrp><ntig><termGrp><term id="1496252">immutable ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302038">ID ຄົງທີ່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2879_237829_2741171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An alpha-numeric identifier for a marketing campaign that is distinct from its name.</descrip></descripGrp><ntig><termGrp><term id="237829">campaign code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2741171">ລະຫັດແຄມເປນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28805_1496323_2682291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A systematic organization of classes.</descrip></descripGrp><ntig><termGrp><term id="1496323">classification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2682291">ປະເພດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28817_3128889_3128935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The site program for Microsoft partners.</descrip></descripGrp><ntig><termGrp><term id="3128889">Microsoft AI Cloud Partner Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3128935">Microsoft AI Cloud Partner Program</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2886_135771_2741182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UNIX-based document search and retrieval system used to query WAIS libraries for indexed files that match keywords and that can be used on individual websites as a search engine.</descrip></descripGrp><ntig><termGrp><term id="135771">WAIS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2741182">WAIS</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2886_135771_2741183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UNIX-based document search and retrieval system used to query WAIS libraries for indexed files that match keywords and that can be used on individual websites as a search engine.</descrip></descripGrp><ntig><termGrp><term id="135771">WAIS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2741183">Wide Area Information Server</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2886_135773_2741182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UNIX-based document search and retrieval system used to query WAIS libraries for indexed files that match keywords and that can be used on individual websites as a search engine.</descrip></descripGrp><ntig><termGrp><term id="135773">Wide Area Information Server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2741182">WAIS</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2886_135773_2741183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UNIX-based document search and retrieval system used to query WAIS libraries for indexed files that match keywords and that can be used on individual websites as a search engine.</descrip></descripGrp><ntig><termGrp><term id="135773">Wide Area Information Server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2741183">Wide Area Information Server</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2889_30927_2179217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive controls often found in graphical user interfaces used to enable or disable one or more features or options from a set.</descrip></descripGrp><ntig><termGrp><term id="30927">check box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179217">ຫ້ອງໝາຍຕິກເອົາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSe