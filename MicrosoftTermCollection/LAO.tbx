13054_144059_2162732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control on a form, that repeats as needed, into which users can enter text. The control can be formatted as a bulleted, numbered, or plain list.</descrip></descripGrp><ntig><termGrp><term id="144059">list control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162732">ການ​ຄວບ​ຄຸມ​ລາຍ​ການ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13056_262545_466216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The appearance of the Start menu and the taskbar after the glass visual style has been applied to customize the color, intensity, and opacity of window borders.</descrip></descripGrp><ntig><termGrp><term id="262545">glassiness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466216">ຄວາມໃສແບບແວ່ນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1306_88948_2179550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder that stores messages that have been created but not yet sent.</descrip></descripGrp><ntig><termGrp><term id="88948">outbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179550">ກ່ອງສົ່ງອອກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1306_88948_465438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder that stores messages that have been created but not yet sent.</descrip></descripGrp><ntig><termGrp><term id="88948">outbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465438">ຕູ້ຈົດໝາຍສົ່ງອອກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13067_138300_2301674"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An icon that designates a change made by a reviewer to a presentation.</descrip></descripGrp><ntig><termGrp><term id="138300">change marker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301674">ບ່ອນໝາຍການປ່ຽນແປງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1307_319132_2179625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to text that is aligned along the right margin.</descrip></descripGrp><ntig><termGrp><term id="319132">right-aligned</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:l