ote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302514">ການນຳທາງຈາກການຊອກຫາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32226_1641038_2302278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables subscription customers to launch Office rich client applications online from a computer on which those applications are not already installed.</descrip></descripGrp><ntig><termGrp><term id="1641038">Office on Demand</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302278">Office on Demand</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32228_1641040_2302419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to edit SharePoint list content directly without opening an edit window.</descrip></descripGrp><ntig><termGrp><term id="1641040">Quick Edit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302419">ແກ້ໄຂດ່ວນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32230_1641042_2302664"><langSe