</termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179531">ຈົດໝາຍຂ່າວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2215_295551_466331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report containing news or information, can be printed or distributed electronically.</descrip></descripGrp><ntig><termGrp><term id="295551">newsletter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466331">ໃບຂ່າວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2216_143575_2302058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A discussion comment that is associated with a particular paragraph, image or table.</descrip></descripGrp><ntig><termGrp><term id="143575">inline discussion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302058">ການສົນທະນາແບບໃນແຖວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22169_1029910_2385936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A new type of domain account designed to provide applications such as SQL Server or Exchange with automatic password management and simplified service principal name (SPN) management.</descrip></descripGrp><ntig><termGrp><term id="1029910">managed service account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2385936">MSA</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22169_2381365_2385936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A new type of domain account designed to provide applications such as SQL Server or Exchange with automatic password management and simplified service principal name (SPN) management.</descrip></descripGrp><ntig><termGrp><term id="2381365">MSA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2385936">MSA</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2218_210899_2162966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type that will provide support for storing binary files within an Access database. More similar to the SharePoint concept of attachments than the current OLE object fields in Access. The data will be stored as a raw blob within the database.</descrip></descripGrp><ntig><termGrp><term id="210899">Attachment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162966">ໄຟ​ລ໌​ຄັດ​ຕິດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22183_1030868_2235139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Institute of Electrical and Electronics Engineers (IEEE) 802.11 wireless network in which Service Set Identifier (SSID) suppression is enabled.</descrip></descripGrp><ntig><termGrp><term id="1030868">non-broadcast network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2235139">ເຄືອ​ຂ່າຍ​ເຊື່ອງ​ໄວ້</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22183_1030869_2235139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Institute of Electrical and Electronics Engineers (IEEE) 802.11 wireless network in which Service Set Identifier (SSID) suppression is enabled.</descrip></descripGrp><ntig><termGrp><term id="1030869">hidden network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2235139">ເຄືອ​ຂ່າຍ​ເຊື່ອງ​ໄວ້</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22185_1030897_2281142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that prevents Internet Explorer from storing data about your browsing session. This helps prevent anyone else who might be using your computer from seeing where you visited and what you looked at on the Web.</descrip></descripGrp><ntig><termGrp><term id="1030897">InPrivate Browsing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2281142">ການ​ທ່ອງ​ເບິ່ງ InPrivate</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22190_1031206_2301671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of IIS authentication in which IIS accepts client-certificates used to prove the client's identity. Using this form of authentication, IIS can optionally map a client certificate to a Windows user account by using an internal mapping table or Active Directory.</descrip></descripGrp><ntig><termGrp><term id="1031206">certificate authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301671">ການຢືນຢັນບຮັບຮອງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22232_1032127_2149534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image and color combination designed to personalize a display window that is viewable to other people. For example, in Windows Live Messenger, someone can choose from a set of available scenes, or upload their own background image. They can also use a default color suggestion, or specify their own color. Someone's personalization is displayed in the main Messenger window (visible to themselves) and also in the main conversation window (visible to others).</descrip></descripGrp><ntig><termGrp><term id="1032127">scene</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149534">ສາກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22235_1032173_2149655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link group that includes links to the About Hotmail webpage, the What's New webpage, and so on.</descrip></descripGrp><ntig><termGrp><term id="1032173">About</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149655">ກ່ຽວ​ກັບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22236_1032191_2149480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contact that someone has tagged in Messenger to appear in the group of "favorite contacts" that appears at the top of the Messenger display window.</descrip></descripGrp><ntig><termGrp><term id="1032191">favorite contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149480">ລາຍ​ຊື່​ຕິດ​ຕໍ່​ທີ່​ມັກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22237_1032194_2149582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API that defines a set of web services which can programmatically access the Windows Live Contacts Address Book database.</descrip></descripGrp><ntig><termGrp><term id="1032194">Windows Live Contacts API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149582">Windows Live Contacts API</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22238_1032196_2149583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Live service for event planning and invitations.</descrip></descripGrp><ntig><termGrp><term id="1032196">Windows Live Events</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149583">Windows Live Events</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22239_1032199_2149584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Windows Live services optimized for use on mobile devices running Windows Mobile.</descrip></descripGrp><ntig><termGrp><term id="1032199">Windows Live for Windows Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149584">Windows Live ສຳ​ລັບ Windows Mobile</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22240_1032201_2149656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Live webpage that displays security and safety-related activities.</descrip></descripGrp><ntig><termGrp><term id="1032201">Safety</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149656">ຄວາມ​ປອດ​ໄພ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22242_1032204_2149587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The OneCare software designed to run on supported servers.</descrip></descripGrp><ntig><termGrp><term id="1032204">Windows Live OneCare for Server</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149587">Windows Live OneCare ສຳ​ລັບ​ເຊີບ​ເວີ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22243_1032209_2149657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link that appears above an incomplete content set and leads to the full list of items. For example, when a content module displays items 1–6, a "View all" link in line with the module label leads to a webpage that lists all items. The items that are available in preview are redundantly available in the list of all items, which may be paginated.</descrip></descripGrp><ntig><termGrp><term id="1032209">View all</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149657">ເບິ່ງ​ທັງ​ໝົດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22244_1034315_2149658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A favorite saved as a .url file in someone's "Shared favorites" folder.</descrip></descripGrp><ntig><termGrp><term id="1034315">shared favorite</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149658">ລາຍ​ການ​ທີ່​ມັກ​ແຊ​ຣ໌​ແລ້ວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22245_1034323_2149660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The image that appears in the conversation window.</descrip></descripGrp><ntig><termGrp><term id="1034323">background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149660">ພື້ນ​ຫຼັງ​</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22246_1034324_2149661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of feedback left by someone viewing content on a site.</descrip></descripGrp><ntig><termGrp><term id="1034324">comment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2149661">ຄຳ​ຄິດ​ເຫັນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22271_1034864_2302577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to digitally alter a picture to increase or decrease the sharpness of focus.</descrip></descripGrp><ntig><termGrp><term id="1034864">Sharpen and Soften</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302577">ການເຮັດໃຫ້ຄົມຊັດຂຶ້ນ ແລະນຸ້ມລົງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="223_321307_2179421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A signal sent by a device to get the attention of the processor when the device is ready to accept or send information.</descrip></descripGrp><ntig><termGrp><