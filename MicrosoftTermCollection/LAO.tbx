1766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The selected cell in which data is entered when you begin typing. Only one cell is active at a time. The active cell is bounded by a heavy border.</descrip></descripGrp><ntig><termGrp><term id="7913">current cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301766">ຕາລາງປັດຈຸບັນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2940_179726_465912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of a scroll bar that allows the information to be scrolled by defined increments when the user clicks it. The direction of the arrow indicates the direction in which the information scrolls.</descrip></descripGrp><ntig><termGrp><term id="179726">scroll arrow button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465912">ປຸ່ມລູກສອນເລື່ອນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2940_179726_465913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of a scroll bar that allows the information to be scrolled by defined increments when the user clicks it. The direction of the arrow indicates the direction in which the information scrolls.</descrip></descripGrp><ntig><termGrp><term id="179726">scroll arrow button</term><termNote type="partOfSpeech">Noun</termNot