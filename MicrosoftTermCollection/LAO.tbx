 xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for apps that are in the top 1000 items based on sales.</descrip></descripGrp><ntig><termGrp><term id="2375034">Best selling apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2380366">ແອັບຂາຍດີທີ່ສຸດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41951_2375035_2380370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for apps that are selected based on downloads, usage, and revenue over a 7-day period and ranks them according to those metrics.</descrip></descripGrp><ntig><termGrp><term id="2375035">Most popular apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2380370">ແອັບຍອດນິຍົມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41952_2375036_2380371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for games that are selected based on downloads, usage, and revenue over a 7-day period and ranks them according to those metrics.</descrip></descripGrp><ntig><termGrp><term id="2375036">Most popular games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2380371">ເກມຍອດນິຍົມ</term><t