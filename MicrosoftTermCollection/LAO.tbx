A type of Office Graph node that represents actual entities in the Office Graph, such as a person or a document.</descrip></descripGrp><ntig><termGrp><term id="2277948">entity node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2322911">ຈຸດເຊື່ອມຕໍ່ເອນທິທີ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39271_2277949_2322924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of Office Graph node that represents a relationship between two or more nodes with their own set of properties in the Office Graph.</descrip></descripGrp><ntig><termGrp><term id="2277949">relationship node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2322924">ຈຸດເຊື່ອມຕໍ່ຄວາມສຳພັນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39272_2277950_2322910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of relationship node that represents an action performed by a person entity in the Office Graph.</descrip></descripGrp><ntig><termGrp><term id="2277950">action node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2322910">ຈຸດເຊື່ອມຕໍ່ຄຳສັ່ງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</ter