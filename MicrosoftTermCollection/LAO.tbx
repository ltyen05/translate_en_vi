descrip type="definition">In the Microsoft WOSA (Windows Open System Architecture) structure, an interface providing a common language for Windows applications to gain access to a database on a network.</descrip></descripGrp><ntig><termGrp><term id="86776">Open Database Connectivity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163324">ODBC</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5877_144194_2302111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name used to represent the same computer on which a TCP/IP message originates. If you access a server-based web site by using http://localhost, the request does not actually go out to the Internet.</descrip></descripGrp><ntig><termGrp><term id="144194">localhost</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302111">localhost</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5890_211335_2336134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application available in an enterprise to help with particular business and process needs, such as payroll, resource planning, supply chain management, and accounting.</descrip></descripGrp><ntig><termGrp><term id="211335">line-of-business application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></