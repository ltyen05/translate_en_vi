rect the errors.</descrip></descripGrp><ntig><termGrp><term id="2457781">Capitalization of March and May</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2463169">ຕົວພິມໃຫຍ່ຂອງເດືອນມີນາ ແລະ ພຶດສະພາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43398_2457782_2463172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of words that co-occur more frequently, in a particular language, than would happen by chance.</descrip></descripGrp><ntig><termGrp><term id="2457782">collocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2463172">ໂຄໂລເຄຊັນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43399_2457783_2463177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A modification of a word to express different grammatical categories.</descrip></descripGrp><ntig><termGrp><term id="2457783">inflection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2463177">ການຜັນຄຳ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig