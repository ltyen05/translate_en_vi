_1177001_2301670"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email program originally introduced by cc:mail, Inc., and currently produced by the Lotus Development Corporation. Lotus cc:Mail runs on multiple networking platforms and the Internet and is closely integrated with Lotus Notes collaborative software.</descrip></descripGrp><ntig><termGrp><term id="1177001">cc:Mail</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301670">cc:Mail</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25542_1177001_2302119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email program originally introduced by cc:mail, Inc., and currently produced by the Lotus Development Corporation. Lotus cc:Mail runs on multiple networking platforms and the Internet and is closely integrated with Lotus Notes collaborative software.</descrip></descripGrp><ntig><termGrp><term id="1177001">cc:Mail</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302119">Lotus cc:Mail</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25575_1177084_2301613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A legal doctrine that is intended to protect the confidentiality of communications between an attorney and his or her client. The underlying rationale is that by assuring confidential communications, lawyers and their clients will feel free to discuss sensitive legal matters thoroughly.</descrip></descripGrp><ntig><termGrp><term id="1177084">attorney-client privilege</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301613">ສິດທິທະນາຍຄວາມ/ລູກຄວາມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25576_1177085_2301566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that corresponds to the "Then" part of a rule (If-Then) and is used to specify what is to be done when a condition evaluates as true.</descrip></descripGrp><ntig><termGrp><term id="1177085">action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301566">ຄຳສັ່ງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25577_1177086_2301635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specific word or phrase that is specified on the basis of an organization's messaging policy and used in keyword filtering (content filtering) to identify and prevent unwanted email messages from being delivered to users in the organization.</descrip></descripGrp><ntig><termGrp><term id="1177086">bad word</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301635">ຄຳຫຍາບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25578_1177087_2302564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The runspace on the datacenter (host) server, which contains the commands used by the remote user in a client-side session.</descrip></descripGrp><ntig><termGrp><term id="1177087">server-side session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302564">ເຊດຊັນຝັ່ງເຊີບເວີ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25579_1177088_2301695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows PowerShell session on a user's local computer, which has the basic Windows PowerShell commands available to it.</descrip></descripGrp><ntig><termGrp><term id="1177088">client-side session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301695">ເຊດຊັນ client-side</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25582_1177091_2301572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mailbox that has been accessed at least once in the last 30 days.</descrip></descripGrp><ntig><termGrp><term id="1177091">active mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301572">ກ່ອງອີເມວທີ່ໃຊ້ໄດ້</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25583_1177092_2301733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory, database, file, or other data repository that is typically offsite and that needs to be accessed remotely.</descrip></descripGrp><ntig><termGrp><term id="1177092">connected data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301733">ແຫລ່ງຂໍ້ມູນທີ່ເຊື່ອມຕໍ່ແລ້ວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1177093_2301898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1177093">Outlook Live Management Agent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301898">ELMA</term><termNote type="geographicalUsage">LAO</termNote><termNote type="p