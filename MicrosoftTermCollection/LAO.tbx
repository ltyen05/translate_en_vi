angSet></termEntry><termEntry id="2490_339962_466666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reusable magnetic storage medium. The floppy disk used today is the rigid 3.5-inch microfloppy that holds 1.44 MB. It is called floppy because the first varieties were housed in bendable jackets.</descrip></descripGrp><ntig><termGrp><term id="339962">disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466666">ແຜ່ນດິສ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24903_1165764_2302452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that isolates the foreground portion of an image and make the background transparent.</descrip></descripGrp><ntig><termGrp><term id="1165764">Remove Background</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302452">ລຶບຮູບພາບພື້ນຫຼັງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24913_1165825_2301732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets users receive and send mail from other email accounts in Outlook Web App. They can add and delete those accounts, check their account synchronization status, and manage email from those accounts in their Inbox using Inbox rules.</descrip></descripGrp><ntig><termGrp><term id="1165825">Connected Accounts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301732">ບັນຊີທີ່ເຊື່ອມຕໍ່ແລ້ວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24914_1165826_2302019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bubble that appears when a user clicks in a field or on a control in the user interface. The Help bubble contains information that helps the user know what to do.</descrip></descripGrp><ntig><termGrp><term id="1165826">Help bubble</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302019">ຂໍ້ຄວາມວິທີນຳໃຊ້</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24915_1165827_2302042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule that is defined by an end-user using Outlook or Outlook Web App. When a message that meets the conditions of the rule is sent or received, the rule triggers an action that is performed automatically.</descrip></descripGrp><ntig><termGrp><term id="1165827">Inbox rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302042">ເງື່ອນໄຂອິນບັອກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24917_1165829_2302203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A company that provides text messaging services.</descrip></descripGrp><ntig><termGrp><term id="1165829">mobile service provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302203">ຜູ້ໃຫ້ບໍລິການມືຖື</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24919_1165832_2163299"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slider control where the maximum and minimum values of the range can be modified.</descrip></descripGrp><ntig><termGrp><term id="1165832">multi-stop slider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163299">ຕົວ​ເລື່ອນ​ຫຼາຍ​ບ່ອນ​ຢຸດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2492_397154_2301929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that resides in a folder that uses an event sink. The item provides the store with information that includes what events will trigger the sink, the name of the sink, and options such as restrictions for when the event will fire.</descrip></descripGrp><ntig><termGrp><term id="397154">event registration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301929">ການບັນທຶກເຫດການ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24928_1165905_2163410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that contains galleries where the user can create, store, and find reusable pieces of content, including AutoText, document properties, fields and building blocks.</descrip></descripGrp><ntig><termGrp><term id="1165905">Quick Parts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163410">ພາກ​ສ່ວນ​ດ່ວນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24931_1165919_2163440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To set again with a different value.</descrip></descripGrp><ntig><termGrp><term id="1165919">reset</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163440">ຕັ້ງ​ຄືນ​ໃໝ່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24935_1165946_2163441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To obtain a new password when the old one is forgotten or expired.</descrip></descripGrp><ntig><termGrp><term id="1165946">reset</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163441">ຕັ້ງ​ຄືນ​ໃໝ່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2495_47034_2301838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fully qualified unique name, used to identify an object in a directory, that specifies the complete path to the object through the hierarchy of directory containers.</descrip></descripGrp><ntig><termGrp><term id="47034">distinguished name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301838">ຊື່ທີ່ບໍ່ຊໍ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24958_1166045_2322569"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The automatic measurement and transmission of data from remote sources by wired or wireless communication means. Telemetry technology is used in a wide variety of applications.</descrip></descripGrp><ntig><termGrp><term id="1166045">telemetry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2322569">ການວັດແທກ ແລະສົ່ງຂໍ້ມູນທາງໄກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24966_1166067_2302109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intermediary between a software publisher and a certification authority (CA). The local registration authority can, for example, verify a publisher's credentials before sending them to the CA.</descrip></descripGrp><ntig><termGrp><term id="1166067">local registration authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302109">ຜູ້ກວດສອບການລົງທະບຽນພາຍໃນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24966_1166067_2302120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intermediary between a software publisher and a certification authority (CA). The local registration authority can, for example, verify a publisher's credentials before sending them to the CA.</descrip></descripGrp><ntig><termGrp><term id="1166067">local registration authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302120">LRA</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24966_1166080_2302109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intermediary between a software publisher and a certification authority (CA). The local registration authority can, for example, verify a publisher's credentials before sending them to the CA.</descrip></descripGrp><ntig><termGrp><term id="1166080">LRA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302109">ຜູ້ກວດສອບການລົງທະບຽນພາຍໃນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24966_1166080_2302120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intermediary between a software publisher and a certification authority (CA). The local registration authority can, for example, verify a publisher's credentials before sending them to the CA.</descrip></descripGrp><ntig><termGrp><term id="1166080">LRA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302120">LRA</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24972_1166075_2632052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To track changes in data as required.</descrip></descripGrp><ntig><termGrp><term id="1166075">audit</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2632052">ກວດສອບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24987_1166123_2302780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A defined point in a workflow that is entered when specified conditions are met.</descrip></descripGrp><ntig><termGrp><term id="1166123">workflow stage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302780">ລຳດັບຊັ້ນຂັ້ນຕອນການເຮັດວຽກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25_42999_465095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In communications, the portion of a Data Terminal Equipment (DTE) device that sends data.</descrip></descripGrp><ntig><termGrp><term id="42999">data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465095">ແຫຼ່ງຂໍ້ມູນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2500_81423_2302204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who reviews content in certain online newsgroups, mailing lists, and forums in order to decide if they are appropriate or not, editing or deleting the ones that aren’t prior to them being they are made public.</descrip></descripGrp><ntig><termGrp><term id="81423">moderator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302204">ຜູ້ເບິ່ງແຍງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25004_1167216_2263650"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that uses speech recognition to enable you to interact with your computer or other devices by voice. You can dictate documents and emails in mainstream applications, and use voice commands to start and switch between applications, control the operating system and even fill out forms on the web.</descrip></descripGrp><ntig><termGrp><term id="1167216">Windows Speech Recognition</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2263650">Windows ການ​ຈົດ​ຈຳ​ສຽງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25008_1765219_2115193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text-based post on Twitter.</descrip></descripGrp><ntig><termGrp><term id="1765219">Tweet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2115193">ທະວີດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25008_2060482_2115193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text-based post on Twitter.</descrip></descripGrp><ntig><termGrp><term id="2060482">tweet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2115193">ທະວີດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2502_179897_2179560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A node with subordinate node(s), called children.</descrip></descripGrp><ntig><termGrp><term id="179897">parent node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179560">ສະຖານີເຊື່ອມໂຍງເຄົ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2502_179897_465914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A node with subordinate node(s), called children.</descrip></descripGrp><ntig><termGrp><term id="179897">parent node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465914">ຈອມເຄົ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry