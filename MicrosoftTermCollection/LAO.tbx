am that is used to show areas of overlap between and among elements.</descrip></descripGrp><ntig><termGrp><term id="149770">Venn diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465819">ແຜນຜັງຊ້ອນກັນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11795_147980_2163454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to keyboard settings, document views, user interface objects, languages, etc. for which text is displayed in a right-to-left direction.</descrip></descripGrp><ntig><termGrp><term id="147980">right-to-left</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163454">RTL</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11795_147980_465802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to keyboard settings, document views, user interface objects, languages, etc. for which text is displayed in a right-to-left direction.</descrip></descripGrp><ntig><termGrp><term id="147980">right-to-left</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465802">ຂວາຫາຊ້າຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Adjective</termNote><te