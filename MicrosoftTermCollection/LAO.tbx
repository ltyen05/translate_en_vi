gular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2162955">ຂົງ​ເຂດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12556_568110_2163025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A classification for grouping content by user-defined criteria such as page contents, file types, or a similar distinction.</descrip></descripGrp><ntig><termGrp><term id="568110">category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2163025">ໝວດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12557_269335_2179694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A problem that prevents sync from completing. Sync errors are typically caused by problems with the device, network folder, or other computer you are trying to sync with.</descrip></descripGrp><ntig><termGrp><term id="269335">sync error</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179694">ຄວາມຂັດຂ້ອງການຊິງຄ໌</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12557_269335_466291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A problem that prevents sync from completing. Sync errors are typically caused by problems with the device, network folder, or other computer you are trying to sync with.</descrip></descripGrp><ntig><termGrp><term id="269335">sync error</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466291">ຄວາມຜິດພາດການຖ່າຍໂອນຂໍ້ມູນສອງຝາກຄືກັນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12560_257510_2771400"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identifier used by two APPC logical units (LUs) to validate security when a session is activated. The security key performs a function similar to that of a password, but at the LU-LU session level rather than at the TP-conversation level.</descrip></descripGrp><ntig><termGrp><term id="257510">security key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2771400">ກະແຈຄວາມປອດໄພ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12562_232859_2302770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stand-alone, dynamic-link library that, when loaded, can add custom commands that extend the functionality of Microsoft Word. Commands and functions in a loaded WLL are also available to Microsoft Visual Basic projects.</descrip></descripGrp><ntig><termGrp><term id="232859">Word Add-in Library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302770">WLL</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12562_232859_2302771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stand-alone, dynamic-link library that, when loaded, can add custom commands that extend the functionality of Microsoft Word. Commands and functions in a loaded WLL are also available to Microsoft Visual Basic projects.</descrip></descripGrp><ntig><termGrp><term id="232859">Word Add-in Library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302771">ໄລບຣາຣີສ່ວນເສີມ Word</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12562_232860_2302770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stand-alone, dynamic-link library that, when loaded, can add custom commands that extend the functionality of Microsoft Word. Commands and functions in a loaded WLL are also available to Microsoft Visual Basic projects.</descrip></descripGrp><ntig><termGrp><term id="232860">WLL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302770">WLL</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected