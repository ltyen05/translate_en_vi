inition">A categorization of search results.</descrip></descripGrp><ntig><termGrp><term id="2816702">search vertical</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2818026">ລວງຕັ້ງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49817_2816704_2818009"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data protection requirement specified by compliance, security, privacy, and data protection standards, regulations, and laws.</descrip></descripGrp><ntig><termGrp><term id="2816704">control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2818009">ການຄວບຄຸມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49829_2817521_2819972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Exchange Server test that verifies the Active Manager client/server processes on DAG (Database Availability Group) members and on the Client Access Server that perform lookups in Active Directory and Active Manager to determine where a user's mailbox database is active.</descrip></descripGrp><ntig><termGrp><term id="2817521">Server Locator Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2819972">ບໍລິການລະບຸສະຖານທີ່ເຊີບເວີ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49831_2817533_2819961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of conditions, implemented through the Data Validation function in Excel, that restricts the permissible content of a cell.</descrip></descripGrp><ntig><termGrp><term id="2817533">data validation rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2819961">ກົດການກວດສອບຂໍ້ມູນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49832_2817535_2819970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user's perception about the usability and effectiveness of the search function.</descrip></descripGrp><ntig><termGrp><term id="2817535">search experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2819970">ປະສົບການໃນການຊອກຫາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49833_2817538_2819973"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way of expressing a software design, usually in an abstract language such as UML.</descrip></descripGrp><ntig><termGrp><term id="2817538">software model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2819973">ໂມເດວຊອບແວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49834_2817540_2819963"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Without using your hands.</descrip></descripGrp><ntig><termGrp><term id="2817540">hands-free</term><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2819963">ໂດຍບໍ່ຕ້ອງໃຊ້ມື</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49836_2817549_2819964"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that are automatically acquired through advanced application technologies (smart sensors, intelligent transducers, electronic gadgets, equipment with advanced functionalities, etc.), systematically processed, and are presented in a meaningful form for active sharing, further assessments, and following interpretations</descrip></descripGrp><ntig><termGrp><term id="2817549">intelligent data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2819964">ຂໍ້ມູນອັດສະລິຍະ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49850_2819348_2823482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that allows users to configure a filter list to use metadata tree view hierarchies and set filter controls to improve navigation and filtering of the list items.</descrip></descripGrp><ntig><termGrp><term id="2819348">metadata navigation filtering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823482">ການກັ່ນຕອງ ແລະ ການນຳທາງເມຕາເດຕາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49850_2819348_2823483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that allows users to configure a filter list to use metadata tree view hierarchies and set filter controls to improve navigation and filtering of the list items.</descrip></descripGrp><ntig><termGrp><term id="2819348">metadata navigation filtering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823483">ຕົວກັ່ນຕອງການນຳທາງເມຕາເດຕາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49850_2819349_2823482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that allows users to configure a filter list to use metadata tree view hierarchies and set filter controls to improve navigation and filtering of the list items.</descrip></descripGrp><ntig><termGrp><term id="2819349">metadata navigation and filtering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823482">ການກັ່ນຕອງ ແລະ ການນຳທາງເມຕາເດຕາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49850_2819349_2823483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that allows users to configure a filter list to use metadata tree view hierarchies and set filter controls to improve navigation and filtering of the list items.</descrip></descripGrp><ntig><termGrp><term id="2819349">metadata navigation and filtering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823483">ຕົວກັ່ນຕອງການນຳທາງເມຕາເດຕາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49851_2819360_2823481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that enables users to dynamically filter and find content in lists and libraries by using a navigation hierarchy tree control to apply different metadata-based filters to the view.</descrip></descripGrp><ntig><termGrp><term id="2819360">metadata navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823481">ການນຳທາງເມຕາເດຕາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49852_2819372_2823503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The type of web part, for example, Search box web part or Content Editor web part.</descrip></descripGrp><ntig><termGrp><term id="2819372">webpart type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823503">ປະເພດ webpart</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49853_2819381_2823466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The execution of arbitrary commands or code on a target machine or in a target process.</descrip></descripGrp><ntig><termGrp><term id="2819381">arbitrary code execution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823466">ACE</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49853_2819381_2823469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The execution of arbitrary commands or code on a target machine or in a target process.</descrip></descripGrp><ntig><termGrp><term id="2819381">arbitrary code execution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823469">Arbitrary code execution</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49853_2819385_2823466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The execution of arbitrary commands or code on a target machine or in a target process.</descrip></descripGrp><ntig><termGrp><term id="2819385">ACE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823466">ACE</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49853_2819385_2823469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The execution of arbitrary commands or code on a target machine or in a target process.</descrip></descripGrp><ntig><termGrp><term id="2819385">ACE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823469">Arbitrary code execution</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49854_2819397_2823477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">a set of entities and the relationships between the entities</descrip></descripGrp><ntig><termGrp><term id="2819397">entity schema</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823477">ແຜນຜັງເອນທິທີ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49855_2819402_2823489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In OAuth authentication, a token that is used by the Consumer to ask the User to authorize access to the Protected Resources. The User-authorized Request Token is exchanged for an Access Token, MUST only be used once, and MUST NOT be used for any other purpose. It is RECOMMENDED that Request Tokens have a limited lifetime.</descrip></descripGrp><ntig><termGrp><term id="2819402">request token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823489">ໂທເຄັນຮ້ອງຂໍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49856_2819416_2823497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common cache source that can be accessed by multiple processes and machines.</descrip></descripGrp><ntig><termGrp><term id="2819416">shared cache</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823497">ແຄດທີ່ແບ່ງປັນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49857_2819428_2823494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of users based on Azure AD attributes (such as location or department), or shared resources such as SharePoint sites. For example, you can have the segment "corporate advisory" and have "corporate advisory users" and "corporate advisory sites." In some cases, users in one segment may not be allowed to discover or communicate with users in another segment.</descrip></descripGrp><ntig><termGrp><term id="2819428">segment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823494">ກຸ່ມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49858_2819429_2823502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in M365 admin center, which provides data, insights and recommendations related to optimization of devices, software, and other technology in your organization.</descrip></descripGrp><ntig><termGrp><term id="2819429">technology experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823502">ປະສົບການເທັກໂນໂລຢີ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49858_2831275_2823502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in M365 admin center, which provides data, insights and recommendations related to optimization of devices, software, and other technology in your organization.</descrip></descripGrp><ntig><termGrp><term id="2831275">Technology experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823502">ປະສົບການເທັກໂນໂລຢີ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49859_2819431_2823487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">MMD device profile that provides local administrator privileges for users who need more control of their issued devices.</descrip></descripGrp><ntig><termGrp><term id="2819431">Privileged access device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823487">ໂປຣໄຟລ໌ອຸປະກອນການເຂົ້າເຖິງສິດທິພິເສດ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4986_37166_2746227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device capable of processing information, storing data, and producing a desired result based on instructions provided.</descrip></descripGrp><ntig><termGrp><term id="37166">computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2746227">ຄອມພິວເຕີ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49860_2819434_2823486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The MMD device profile that offers the greatest power to the local user (ability to install apps, etc.). Intended for use typically by developers, field engineers, etc.</descrip></descripGrp><ntig><termGrp><term id="2819434">Power user device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823486">ໂປຣໄຟລ໌ອຸປະກອນຜູ້ໃຊ້ສະມັດຖະນະສູງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49861_2819436_2823495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The MMD device profile that is more &amp;quot;locked down&amp;quot; to preserve the security of sensitive data. Intended for handling sensitive data such as medical records.</descrip></descripGrp><ntig><termGrp><term id="2819436">Sensitive data device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823495">ໂປຣໄຟລ໌ອຸປະກອນຂໍ້ມູນລະອຽດອ່ອນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49862_2819437_2823498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The MMD device profile that has the most balance of user privileges and data security--expected to be the most common profile and used by typical information workers.</descrip></descripGrp><ntig><termGrp><term id="2819437">Standard device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823498">ໂປຣໄຟລ໌ອຸປະກອນມາດຕະຖານ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49863_2911838_2911864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft Managed Desktop device profile optimized for use by frontline workers. Limited power for the user; intended for scenarios with multiple users sharing the same device, such as at a nurses' station. Likely to be operating under the F1 license.</descrip></descripGrp><ntig><termGrp><term id="2911838">frontline device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2911864">ໂປຣໄຟລ໌ອຸປະກອນຂອງແນວໜ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49864_2819441_2823480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the proposed MMD device profiles. This would support a single app without requiring a user sign in.</descrip></descripGrp><ntig><termGrp><term id="2819441">Kiosk device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823480">ໂປຣໄຟລ໌ອຸປະກອນຄີອອສ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49865_2819443_2823476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in Microsoft 365, which includes insights and recommendations about usage of Microsoft 365 products that are related to employee productivity, engagement, wellbeing, and related concepts.</descrip></descripGrp><ntig><termGrp><term id="2819443">employee experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823476">ປະສົບການພະນັກງານ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49865_2831277_2823476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in Microsoft 365, which includes insights and recommendations about usage of Microsoft 365 products that are related to employee productivity, engagement, wellbeing, and related concepts.</descrip></descripGrp><ntig><termGrp><term id="2831277">Employee experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823476">ປະສົບການພະນັກງານ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49866_2819444_2823493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of Microsoft-recommended configuration settings along with an explanation of their security impact. These settings are based on feedback from Microsoft security engineering teams, product groups, partners, and customers.</descrip></descripGrp><ntig><termGrp><term id="2819444">security baseline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823493">ເສັ້ນຖານຄວາມປອດໄພ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49867_2819445_2823501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that the customer defines, which represents a goal.</descrip></descripGrp><ntig><termGrp><term id="2819445">target</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2823501">ເປົ້າໝາຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49868_2819447_2823467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft 365 scores, a recommendation based on data 