calNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44664_2514606_2518232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API which uses people’s calendars and other constraints to find a good time for those people to meet.</descrip></descripGrp><ntig><termGrp><term id="2514606">Find Meeting Times API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2518232">API ຊອກຫາເວລາປະຊຸມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44665_2514607_2518236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API which surfaces functionality to create, get, update, and delete a user’s tasks.</descrip></descripGrp><ntig><termGrp><term id="2514607">Tasks API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2518236">API ໜ້າວຽກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44666_2514608_2518235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API which surfaces functionality to manipulate and send messages, attachments, events, and folders.</descrip></descripGrp><ntig><termGrp><term id="2514608">Office 365 Mail API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:la