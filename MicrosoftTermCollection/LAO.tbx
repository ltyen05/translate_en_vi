Speech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302303">ໂອເປີເຣຊັນ ມາສເຕີ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="922_1177130_465050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process for removing redundant data from a digital media file or stream to reduce its size or the bandwidth used.</descrip></descripGrp><ntig><termGrp><term id="1177130">data compaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465050">ການຫຍໍ້ລົງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="922_37103_465050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process for removing redundant data from a digital media file or stream to reduce its size or the bandwidth used.</descrip></descripGrp><ntig><termGrp><term id="37103">compression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465050">ການຫຍໍ້ລົງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9221_141157_2301850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fundamental data type that holds double-precision floating-point numbers. It's stored as a 64-bit number ranging in value from approximately -1.797E308 to -4.940E-324 (negative), from 4.94E-324 to 1.797E308 (positive), and 0.</descrip></descripGrp><ntig><termGrp><term id="141157">Double data type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301850">ປະເພດຂໍ້ມູນສອງເທົ່າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9225_25521_2114798"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the state of a phone line when it is in use.</descrip></descripGrp><ntig><termGrp><term id="25521">busy</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2114798">ບໍ່ຫວ່າງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9238_116710_465578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A precompiled collection of SQL statements and optional control-of-flow statements stored under a name and processed as a unit. They are stored in an SQL database and can be run with one call from an application.</descrip></descripGrp><ntig><termGrp><term id="116710">stored procedure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465578">ຂັ້ນຕອນການເກັບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9239_145825_2302325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A worksheet view that displays the areas to be printed and the locations of page breaks. The area to be printed is displayed in white, automatic page breaks appear as dashed lines, and manual page breaks appear as solid lines.</descrip></descripGrp><ntig><termGrp><term id="145825">page break preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302325">ໂຕຢ່າງຈຸດແບ່ງໜ້າ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9242_143427_465767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that stores hyperlink addresses.</descrip></descripGrp><ntig><termGrp><term id="143427">hyperlink field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="465767">ຂົງເຂດສຳພັນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9248_268851_2179266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Files that are used to help detect harmful or unwanted software and to prevent it from installing or running on your computer.</descrip></descripGrp><ntig><termGrp><term id="268851">definitions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2179266">ນິຍາມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9248_268851_466280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Files that are used to help detect harmful or unwanted software and to prevent it from installing or running on your computer.</descrip></descripGrp><ntig><termGrp><term id="268851">definitions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466280">ຄໍານິຍາມ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9255_298014_466366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button on the message toolbar that compares the names in the To, Cc, and Bcc boxes against the names in the Address Book and against those contact folders that you've specified as Outlook Address Books.</descrip></descripGrp><ntig><termGrp><term id="298014">Check Names</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="466366">ກວດຊື່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGende