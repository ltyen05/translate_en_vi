="40655_2361528_2474795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application that lets users sync files from OneDrive for Business or Microsoft SharePoint to their local computer.</descrip></descripGrp><ntig><termGrp><term id="2361528">OneDrive sync client</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2474795">ລູກຂ່າຍການຊິ້ງຂໍ້ມູນ OneDrive</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40657_2358714_2364147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that use a map and colors to reflect characteristics specific to a particular geographical location.</descrip></descripGrp><ntig><termGrp><term id="2358714">map chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2364147">ແຜນວາດແຜນທີ່</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40677_2359171_2364149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool that allows users to import Evernote notes into OneNote.</descrip></descripGrp><ntig><termGrp><term id="2359171">OneNote Importer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2364149">ຕົວນຳເຂົ້າ OneNote</term><termNote type="geographic