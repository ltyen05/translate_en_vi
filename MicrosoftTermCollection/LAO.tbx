rp><descrip type="definition">The Microsoft 365 compliance center view that allows users to define policies that capture email, Teams channels and chats, and 3rd-party communications in their organization so it can be examined by reviewers to see if it is compliant with the organization's policies.</descrip></descripGrp><ntig><termGrp><term id="2738464">Supervision</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2743044">ການເບິ່ງແຍງກວດກາ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48468_2738468_2743038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 compliance center view that allows users to search, investigate, and take action on data-related incidents such as a data breach, data spillage, or needing to search for and purge messages that contain a harmful attachment.</descrip></descripGrp><ntig><termGrp><term id="2738468">Data investigations</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2743038">ການສືບສວນຂໍ້ມູນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48469_2738471_2743039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 compliance center view that allows users to respond to a data subject request and create data subject request cases.</descrip></descripGrp><nti