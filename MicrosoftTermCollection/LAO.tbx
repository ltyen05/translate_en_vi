Note type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2664392">ຖ້ຽວບິນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39214_2328190_2664392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specific package that is made available to a selected set of end users. Often used to validate functionality or behavior before the product official release.</descrip></descripGrp><ntig><termGrp><term id="2328190">package flight</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2664392">ຖ້ຽວບິນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39229_2277489_2300835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Structure and Style choice for a sway that is initially made by the user, which Sway will remember and intelligently implement based upon content, prior behavior, and abstract expressions of intent.</descrip></descripGrp><ntig><termGrp><term id="2277489">design lever</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2300835">ໂຕເລືອກການອອກແບບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected<