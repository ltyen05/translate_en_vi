><descrip type="definition">The usually pretrial disclosure of pertinent facts or documents by one or both parties to a legal action or proceeding.</descrip></descripGrp><ntig><termGrp><term id="702321">discovery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301891">ການສະແດງຂໍ້ເທັດຈິງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20134_702321_2302241"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The usually pretrial disclosure of pertinent facts or documents by one or both parties to a legal action or proceeding.</descrip></descripGrp><ntig><termGrp><term id="702321">discovery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302241">ການສະແດງຂໍ້ເທັດຈິງທາງກົດໝາຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20136_702323_2302142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Extra information displayed to a user while they are composing an email message. MailTips are displayed in an InfoBar, similar to the banner that appears saying "This message has not been sent." MailTips reveal anything that might be unexpected about the delivery or audience of the message, such as recipient validity or Out of Office status or whether the message might not be delivered.</descrip></descripGrp><ntig><termGrp><term id="702323">MailTip</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302142">MailTip</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20139_702327_2302133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that automatically populates multiple mailbox properties when a mailbox is created in the service. A mailbox plan also assigns default permissions to the corresponding user account.</descrip></descripGrp><ntig><termGrp><term id="702327">mailbox plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302133">ແຜນການກ່ອງອີເມວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20140_702751_2302360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of shapes arranged in a tree structure that helps analyze and summarize data in a visual, easy-to-understand format. It starts out as a single shape, called a top node, that contains information imported from a worksheet, table, view, or cube.</descrip></descripGrp><ntig><termGrp><term id="702751">PivotDiagram</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302360">ໄດອາແກຣມ Pivot</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20141_703430_2216926"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy that specifies the length of time during which items such as data, documents, builds, and releases are to be retained.</descrip></descripGrp><ntig><termGrp><term id="703430">retention policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2216926">ນະ​ໂຍ​ບາຍ​ວ່າ​ດ້ວຍ​ການ​ເກັບ​ອັກ​ໄດ້</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20143_703432_2302567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of Exchange features, organization-wide resource limits, and permissions that are automatically configured or applied when a new hosted organization is provisioned in the service.</descrip></descripGrp><ntig><termGrp><term id="703432">service plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302567">ແຜນບໍລິການ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20149_704965_2301970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of data such as numbers, number and text combinations, dates, or time periods, based on an established pattern 