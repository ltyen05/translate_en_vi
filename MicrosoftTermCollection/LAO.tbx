rounding area.</descrip></descripGrp><ntig><termGrp><term id="1629244">Local Scout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2161313">ນາຍທາງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31971_1629244_2161314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature accessed from Search or Maps that displays things to see and do, shopping, and restaurants in a user's current location and the surrounding area.</descrip></descripGrp><ntig><termGrp><term id="1629244">Local Scout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2161314">ນາຍທາງທ້ອງຖິ່ນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31971_2058971_2161313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature accessed from Search or Maps that displays things to see and do, shopping, and restaurants in a user's current location and the surrounding area.</descrip></descripGrp><ntig><termGrp><term id="2058971">scout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2161313">ນາຍທາງ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">N