</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48650_2753556_2757314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A means of marketing that uses one or more digital signage device and that targets a specific audience.</descrip></descripGrp><ntig><termGrp><term id="2753556">digital signage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2757314">ການເຊັນດິຈິຕອນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48651_3030415_3030577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The latest generation of the Windows Console, designed with fundamental concepts familiar to developers around the world, and updating the Windows Command Line experience with modern paradigms and a fresh, new user interface.</descrip></descripGrp><ntig><termGrp><term id="3030415">Terminal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="3030577">ເທີມີນໍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48675_2753774_2757317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A means of spreading multiple incoming calls to a single telephone number, to multiple lines.</descrip></descripGrp><ntig><termGrp><term id="2753774">line hunting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSel