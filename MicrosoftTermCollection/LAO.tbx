">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302216">ບັນຊີຂອງຂ້ອຍ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32269_1644697_2302280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Click-to-Run feature that enables two versions of Office to exist on the same computer to provide a seamless transition for users in supported scenarios.</descrip></descripGrp><ntig><termGrp><term id="1644697">Office Side-by-Side</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2302280">Office ໄຊດ໌-ບາຍ-ໄຊດ໌</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32270_1645770_2301596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint document library that administrators can use to distribute apps for Office and SharePoint to their end users.</descrip></descripGrp><ntig><termGrp><term id="1645770">App Catalog</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2301596">ແຄັດຕາລັອກແອັບ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32271_1645771_2301861"><langSet xml:lang="en-US"><de