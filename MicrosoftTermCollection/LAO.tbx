eature that provides a dedicated cache solution that complements Delivery Optimization distributed peer-to-peer system.</descrip></descripGrp><ntig><termGrp><term id="2815101">Connected Cache</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2838033">ແຄດທີ່ເຊື່ອມຕໍ່ແລ້ວ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49754_2815537_2815824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Microsoft 365 that includes business services—email, file storage and sharing, Office Online, meetings and IM, and more. Office applications not included.</descrip></descripGrp><ntig><termGrp><term id="2815537">Office 365 E1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2815824">Office 365 E1</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49755_2815538_2815845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Microsoft 365 that includes Skype for Business integrations with telephone system, Office 365 Advanced Threat Protection, Customer Lockbox,Power BI Pro, as well as both the Microsoft Office desktop apps and the online versions. It includes all the features of ProPlus and Office 365 E1 plus security and compliance tools, such as legal hold, data loss prevention, and more.</descrip></descripGrp><ntig><termGrp><term id="2815538">Office 365 E3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2815845">Office 365 E3</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49756_2815539_2815866"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Microsoft 365 that includes Skype for Business integrations with telephone system, Office 365 Advanced Threat Protection, Customer Lockbox,Power BI Pro, as well as both the Microsoft Office desktop apps and the online versions. It includes all the features of Office 365 E3 plus advanced security, analytics, and voice capabilities.</descrip></descripGrp><ntig><termGrp><term id="2815539">Office 365 E5</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2815866">Office 365 E5</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49764_2815600_2818330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of user account attributes, segments, "block" and/or "allow" policies, and policy application definitions that together establish information barriers within an organization.</descrip></descripGrp><ntig><termGrp><term id="2815600">information barrier policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2818330">ນະໂຍບາຍການກັ້ນຂໍ້ມູນ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49768_2815606_2816433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An IT tool which enables business users to collect signals from their products and services and gain actionable insights into their customers’ usage and experiences.</descrip></descripGrp><ntig><termGrp><term id="2815606">telemetry collection service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2816433">ບໍລິການການເກັບກຳການວັດແທກ ແລະ ສົ່ງຂໍ້ມູນທາງໄກ</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49780_2816016_2817418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software tool that enables business users to collect signals from their products and services and gain actionable insights into their customers’ usage and experiences.</descrip></descripGrp><ntig><termGrp><term id="2816016">Product Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="lo"><ntig><termGrp><term id="2817418">Product Insights</term><termNote type="geographicalUsage">LAO</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id