ch">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523520">област</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12556_568110_1796369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A classification for grouping content by user-defined criteria such as page contents, file types, or a similar distinction.</descrip></descripGrp><ntig><termGrp><term id="568110">category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1796369">категорија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12557_269335_1504130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A problem that prevents sync from completing. Sync errors are typically caused by problems with the device, network folder, or other computer you are trying to sync with.</descrip></descripGrp><ntig><termGrp><term id="269335">sync error</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504130">грешка при синхронизовању</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12560_257510_2772248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identifier used by two APPC logical units (LUs) to validate security when a session is activated. The security key performs a function similar to that of a password, but at the LU-LU session level rather than at the TP-conversation level.</descrip></descripGrp><ntig><termGrp><term id="257510">security key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2772248">безбедносни кључ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12562_232859_1916856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stand-alone, dynamic-link library that, when loaded, can add custom commands that extend the functionality of Microsoft Word. Commands and functions in a loaded WLL are also available to Microsoft Visual Basic projects.</descrip></descripGrp><ntig><termGrp><term id="232859">Word Add-in Library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916856">Библиотека Word додатака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12562_232859_1916857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stand-alone, dynamic-link library that, when loaded, can add custom commands that extend the functionality of Microsoft Word. Commands and functions in a loaded WLL are also available to Microsoft Visual Basic projects.</descrip></descripGrp><ntig><termGrp><term id="232859">Word Add-in Library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916857">WLL</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12562_232859_2527688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stand-alone, dynamic-link library that, when loaded, can add custom commands that extend the functionality of Microsoft Word. Commands and functions in a loaded WLL are also available to Microsoft Visual Basic projects.</descrip></descripGrp><ntig><termGrp><term id="232859">Word Add-in Library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527688">Библиотека програмских додатака за Word</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12562_232860_1916856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stand-alone, dynamic-link library that, when loaded, can add custom commands that extend the functionality of Microsoft Word. Commands and functions in a loaded WLL are also available to Microsoft Visual Basic projects.</descrip></descripGrp><ntig><termGrp><term id="232860">WLL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916856">Библиотека Word додатака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12562_232860_1916857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stand-alone, dynamic-link library that, when loaded, can add custom commands that extend the functionality of Microsoft Word. Commands and functions in a loaded WLL are also available to Microsoft Visual Basic projects.</descrip></descripGrp><ntig><termGrp><term id="232860">WLL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916857">WLL</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12562_232860_2527688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stand-alone, dynamic-link library that, when loaded, can add custom commands that extend the functionality of Microsoft Word. Commands and functions in a loaded WLL are also available to Microsoft Visual Basic projects.</descrip></descripGrp><ntig><termGrp><term id="232860">WLL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527688">Библиотека програмских додатака за Word</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12571_306405_1504131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter effect in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="306405">Sepia Tone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504131">Смеђи ефекат на слици</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12578_58758_1504132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button on the address bar that enables the user to navigate to the specified location (such as a folder path or web address).</descrip></descripGrp><ntig><termGrp><term id="58758">Go</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504132">Кренути</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12582_2246_2541407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of integrated tools for developing software. The tools are generally run from one user interface and consist of a compiler, an editor, and a debugger, among others.</descrip></descripGrp><ntig><termGrp><term id="2246">IDE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541407">IDE</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12582_2246_2541408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of integrated tools for developing software. The tools are generally run from one user interface and consist of a compiler, an editor, and a debugger, among others.</descrip></descripGrp><ntig><termGrp><term id="2246">IDE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541408">интегрисано развојно окружење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12582_2247_2541407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of integrated tools for developing software. The tools are generally run from one user interface and consist of a compiler, an editor, and a debugger, among others.</descrip></descripGrp><ntig><termGrp><term id="2247">integrated development environment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541407">IDE</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12582_2247_2541408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of integrated tools for developing software. The tools are generally run from one user interface and consist of a compiler, an editor, and a debugger, among others.</descrip></descripGrp><ntig><termGrp><term id="2247">integrated development environment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541408">интегрисано развојно окружење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12587_361173_1523510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An update process that uses an analysis of historical information accumulated over all previous updates to determine which documents are likely to have changed. Only this content is accessed during the crawl.</descrip></descripGrp><ntig><termGrp><term id="361173">adaptive update</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523510">прилагодљиво ажурирање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12592_77991_1504133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person whose work or profession is management.</descrip></descripGrp><ntig><termGrp><term id="77991">manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504133">менаџер</t