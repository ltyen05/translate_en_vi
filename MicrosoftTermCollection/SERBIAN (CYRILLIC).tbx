termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24103_1098535_2542264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event whose handler runs in a different processing thread from the action that raised the event. The event handler and the action are processed simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1098535">asynchronous event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542264">асинхрони догађај</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24104_1098536_2542265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event whose handler runs in the same processing thread as the action that raised the event. The action cannot continue until processing is complete for the event handler.</descrip></descripGrp><ntig><termGrp><term id="1098536">synchronous event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542265">синхрони догађај</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24106_1098539_1917119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A synchronous event whose handler runs completely before the action that raised the event starts.</descrip></descripGrp><ntig><termGrp><term id="1098539">before event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917119">претходни догађај</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24106_1098539_2542266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A synchronous event whose handler runs completely before the action that raised the event starts.</descrip></descripGrp><ntig><termGrp><term id="1098539">before event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542266">догађај пре акције</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24106_1098540_1917119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A synchronous event whose handler runs completely before the action that raised the event starts.</descrip></descripGrp><ntig><termGrp><term id="1098540">pre-event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917119">претходни догађај</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24106_1098540_2542266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A synchronous event whose handler runs completely before the action that raised the event starts.</descrip></descripGrp><ntig><termGrp><term id="1098540">pre-event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542266">догађај пре акције</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24107_1098541_2542267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mapping between file name extensions and HTTP request handlers that enables Web hosting applications to determine which handler responds to requests for specific types of files.</descrip></descripGrp><ntig><termGrp><term id="1098541">application map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542267">мапа апликације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24108_1098542_1475174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A script-based applet that is stored as a favorite or bookmark in a web browser, or is accessed through a hyperlink on a webpage.</descrip></descripGrp><ntig><termGrp><term id="1098542">bookmarklet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1475174">активни обележивач</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24109_1098543_2542268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of associating a feature with a site definition, without modifying the site definition itself or using code routines. The associated feature is added automatically to new sites that are based on that site definition.</descrip></descripGrp><ntig><termGrp><term id="1098543">feature stapling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542268">повезивање функција</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24109_1275537_2542268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of associating a feature with a site definition, without modifying the site definition itself or using code routines. The associated feature is added automatically to new sites that are based on that site definition.</descrip></descripGrp><ntig><termGrp><term id="1275537">stapling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542268">повезивање функција</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24110_1098544_2542269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of statistics that indicates the degree to which a computer, server farm, or server cluster meets security, capacity, performance, usage, and other demands.</descrip></descripGrp><ntig><termGrp><term id="1098544">health status</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542269">статус ваљаности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24118_1098831_2528043"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The configuration of resources available to the user. Environment refers to the hardware and the operating system running on it. For example, Windows and Macintosh are called windowing environments because they are based on screen regions called windows.</descrip></descripGrp><ntig><termGrp><term id="1098831">environment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2528043">радно окружење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24118_1098832_2528043"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The configuration of resources available to the user. Environment refers to the hardware and the operating system running on it. For example, Windows and Macintosh are called windowing environments because they are based on screen regions called windows.</descrip></descripGrp><ntig><termGrp><term id="1098832">operating environment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2528043">радно окружење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24121_1098843_2249822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A candidate key that is not designated as the primary key and is used to uniquely identify records in a database table.</descrip></descripGrp><ntig><termGrp><term id="1098843">alternate key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2249822">Алтернативни кључ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24124_1098902_2685936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transfer of certain properties, such as open files, from a parent program or process to another program or process that the parent causes to run.</descrip></descripGrp><ntig><termGrp><term id="1098902">inheritance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2685936">наслеђивање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24137_1098949_1131347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI link text for sending a link to a page.</descrip></descripGrp><ntig><termGrp><term id="1098949">Send a link</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1131347">Пошаљи везу</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24138_1098950_1131348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the form where a user can report violations of the terms of use. Contextually, it's understood that the abuse in question is poor conduct, such as obscene language or threats.</descrip></descripGrp><ntig><termGrp><term id="1098950">Report Abuse</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1131348">Пријава злоупотребе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24139_1098951_1131349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Rules that explain how someone should behave while using a service or product.</descrip></descripGrp><ntig><termGrp><term id="1098951">code of conduct</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1131349">правила понашања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2414_4707_2142047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tested, cumulative set of hotfixes, security updates, critical updates, and updates packaged together for easy deployment. A rollup generally targets a specific area, such as security, or component of a product, such as Microsoft Internet Information Services (IIS).</descrip></descripGrp><ntig><termGrp><term id="4707">update rollup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2142047">збирна исправка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24142_1098959_1131352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code that grants rights to an individual, for example to use a system or access stored data.</descrip></descripGrp><ntig><termGrp><term id="1098959">authorization code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1131352">код за ауторизацију</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24145_1103189_1356316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An available button for Windows Live Toolbar that highlights, in color, search words on the search results page. It also highlights the search words on the websites included in the search results.</descrip></descripGrp><ntig><termGrp><term id="1103189">Highlight Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356316">Приказивање истакнутих ставки</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24171_1755527_1761088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web portal from which each company’s service administrator can manage user accounts and settings for each of the Office 365 services to which they subscribe.</descrip></descripGrp><ntig><termGrp><term id="1755527">Office 365 admin center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1761088">Office 365 центар администрације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24192_1112946_2571818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control on a page or master page that can be replaced with another control or content.</descrip></descripGrp><ntig><termGrp><term id="1112946">delegate control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2571818">делегирана контрола</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24193_1112947_2571819"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that can be used to set the properties for and to manipulate Web Parts on a Web Parts page.</descrip></descripGrp><ntig><termGrp><term id="1112947">Editor Part</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2571819">Уређивач веб сегмената</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24194_1112948_2542270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A relationship in which a feature is activated automatically when another feature is activated or a feature must be activated manually before another feature can be activated.</descrip></descripGrp><ntig><termGrp><term id="1112948">feature activation dependency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542270">зависност активирања функција</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24196_1115313_2776662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program or program module that adds functionality to or extends the effectiveness of a program.</descrip></descripGrp><ntig><termGrp><term id="1115313">extension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2776662">проширење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24197_1115314_1523625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text-based, data interchange format that is used to transmit structured data, typically in Ajax Web applications.</descrip></descripGrp><ntig><termGrp><term id="1115314">JavaScript Object Notation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523625">JSON</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24197_1115314_2513089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text-based, data interchange format that is used to transmit structured data, typically in Ajax Web applications.</descrip></descripGrp><ntig><termGrp><term id="1115314">JavaScript Object Notation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2513089">JavaScript Object Notation</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24197_1115315_1523625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text-based, data interchange format that is used to transmit structured data, typically in Ajax Web applications.</descrip></descripGrp><ntig><termGrp><term id="1115315">JSON</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523625">JSON</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24197_1115315_2513089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text-based, data interchange format that is used to transmit structured data, typically in Ajax Web applications.</descrip></descripGrp><ntig><termGrp><term id="1115315">JSON</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2513089">JavaScript Object Notation</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24198_1115316_2542271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operation that requires more resources than are allowed by a threshold, based on the number of items or amount of information that is processed during the operation.</descrip></descripGrp><ntig><termGrp><term id="1115316">privileged task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542271">привилеговани задатак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="242_184035_1523668"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special storage location of templatized pages for performance enhancement.</descrip></descripGrp><ntig><termGrp><term id="184035">page output cache</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523668">кеш излазног садржаја странице</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2420_308318_1503005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date after which information or a resource is no longer valid.</descrip></descripGrp><ntig><termGrp><term id="308318">expiration date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503005">крајњи датум важења</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2420_308318_765591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date after which information or a resource is no longer valid.</descrip></descripGrp><ntig><termGrp><term id="308318">expiration date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="765591">датум истека важења</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24202_1115320_1917120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process, thread, or set of related processes or threads that requires significant system resources or time, or requires exclusive access to large amounts of data.</descrip></descripGrp><ntig><termGrp><term id="1115320">resource-intensive task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917120">ресурсно захтјеван задатак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24202_1115320_2542272"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process, thread, or set of related processes or threads that requires significant system resources or time, or requires exclusive access to large amounts of data.</descrip></descripGrp><ntig><termGrp><term id="1115320">resource-intensive task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542272">захтеван задатак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24205_1115323_2542273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extensible programming model and components that can be used to design and implement custom applications for common business processes, such as document approval. Components include version control, tracking, and reporting.</descrip></descripGrp><ntig><termGrp><term id="1115323">workflow foundation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542273">основа тока посла</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24206_1115324_1523543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The object that is used to initiate any actions with the client-side object model. It is the primary entry point for the client object model, and the primary object for coordinating requests against corresponding objects in a site collection.</descrip></descripGrp><ntig><termGrp><term id="1115324">client context</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523543">контекст клијента</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24207_1115325_2542274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software component that can be used to connect to a data source, and index and include data from that source in search results.</descrip></descripGrp><ntig><termGrp><term id="1115325">connector framework</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542274">радни оквир конектора</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24208_1115326_2542275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server-side code routine that is called when a feature is activated, deactivated, installed, uninstalled, or upgraded on a computer, server farm, or server cluster.</descrip></descripGrp><ntig><termGrp><term id="1115326">feature event receiver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542275">пријемник догађаја функције</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24209_1115327_2542276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statistic that indicates the degree to which a computer, server farm, or server cluster meets a specific demand for that configuration. It also indicates which log information to copy to a central location for review.</descrip></descripGrp><ntig><termGrp><term id="1115327">health tracking indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542276">индикатор праћења исправности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24210_1115328_2542277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A content type that inherits settings from a base content type that was designed for any type of SharePoint list item.</descrip></descripGrp><ntig><termGrp><term id="1115328">item-based content type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542277">тип садржаја заснован на ставци</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24211_1115329_2542278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A content type that inherits settings from a base content type that was designed for document libraries.</descrip></descripGrp><ntig><termGrp><term id="1115329">document-based content type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542278">тип садржаја заснован на документу</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24212_1119987_1523703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom solution that can be deployed to a site by a site collection administrator, without approval from the farm administrator. Without that approval, the solution has full access to the immediate site and restricted access to system resources and other sites.</descrip></descripGrp><ntig><termGrp><term id="1119987">sandboxed solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523703">решење заштићено Sandbox окружењем</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24212_1119987_1917124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom solution that can be deployed to a site by a site collection administrator, without approval from the farm administrator. Without that approval, the solution has full access to the immediate site and restricted access to system resources and other sites.</descrip></descripGrp><ntig><termGrp><term id="1119987">sandboxed solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917124">рјешење заштићено Sandbox окружењем</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24213_1115331_1523624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A persistent container that defines and stores instructions for a job to be run on a server, server farm, or server cluster. To run, a job must have an associated job definition, and a definition must be associated with a service or a Web application.</descrip></descripGrp><ntig><termGrp><term id="1115331">job definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523624">дефиниција задатка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24214_1115332_2542279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dedicated, administrator-level user account that performs scheduled administrative tasks.</descrip></descripGrp><ntig><termGrp><term id="1115332">timer account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542279">налог са тајмером</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24215_1115333_1523744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compressed file that can be deployed to a server farm or a site. It can contain assemblies, resource files, site and feature definitions, templates, code access security policies, and Web Parts.</descrip></descripGrp><ntig><termGrp><term id="1115333">solution package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523744">пакет решења</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24216_1115334_1917121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom keyword or description and shortcut to a Web page or item on a SharePoint site or the Internet. All of these tags can be viewed, managed, and shared by using My Site.</descrip></descripGrp><ntig><termGrp><term id="1115334">social tag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917121">друштвена ознака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24217_1115335_1917122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of features that can be used to store and share comments, shortcuts, descriptions, and other information about Web pages and items on a SharePoint site or the Internet.</descrip></descripGrp><ntig><termGrp><term id="1115335">social data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917122">друштвени подаци</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24218_1115336_2542281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reserved time for performing administrative tasks on a computer, server farm, or server cluster.</descrip></descripGrp><ntig><termGrp><term id="1115336">service window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542281">интервал услуге</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24219_1115337_2542282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An administrative setting that limits the number of query results for SharePoint lists, sites, and site collections that contain a large number of items.</descrip></descripGrp><ntig><termGrp><term id="1115337">query-size threshold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542282">гранична вредност величине упита</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24220_1115338_2542283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reserved time for performing large, resource-intensive queries for a computer, server farm, or server cluster.</descrip></descripGrp><ntig><termGrp><term id="1115338">query window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542283">интервал упита</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24221_1115339_1523627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solution package that contains only a DLL that stores localized versions of strings in another solution package. After a language pack is deployed to a site, users can display the corresponding user interface in that language.</descrip></descripGrp><ntig><termGrp><term id="1115339">language pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523627">језички пакет</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24222_1115340_1523660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area for storing comments about a Web page. A note board can appear on a Web page or in a separate dialog box. The notes can be viewed, managed, and shared by using My Site.</descrip></descripGrp><ntig><termGrp><term id="1115340">note board</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523660">табла са белешкама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24223_1115341_1523640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft SQL Server, MSDE, or WMSDE database that stores health monitoring and usage data temporarily, and can be used for reporting and diagnostics.</descrip></descripGrp><ntig><termGrp><term id="1115341">logging database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523640">база података за вођење евиденције</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24224_1115342_1917123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statistic that indicates the degree to which a computer, server farm, or server cluster meets usage demands for that configuration.</descrip></descripGrp><ntig><termGrp><term id="1115342">quality-of-service indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917123">индикатор квалитета услуге</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24225_1115347_2360786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A block of cells selected for similar treatment in a spreadsheet. A range of cells can extend across a row, down a column, or over a combination of the two, but all cells in the range must be contiguous, sharing at least one common border.</descrip></descripGrp><ntig><termGrp><term id="1115347">range</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2360786">опсег</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24245_1117153_2509139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An installation package that the user downloads from http://download.live.com/?mkt=en-us.</descrip></descripGrp><ntig><termGrp><term id="1117153">download</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2509139">преузимање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24246_1117154_1356317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The software that installs the Windows Live software someone selects on the installation webpage.</descrip></descripGrp><ntig><termGrp><term id="1117154">Windows Live installer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356317">инсталациони програм за Windows Live</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24247_1117155_1167486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The main landing or start page on Windows Live.</descrip></descripGrp><ntig><termGrp><term id="1117155">Windows Live Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1167486">Windows Live матична страница</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24249_1117156_1356318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that enables a user to make a call to a phone, as opposed to calling another computer or using a webcam.</descrip></descripGrp><ntig><termGrp><term id="1117156">phone call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356318">телефонски позив</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2425_34681_1503006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined set of harmonized colors that you can apply to text and objects. Text and objects with an applied scheme color will change automatically when you switch to a new color scheme or modify the current color scheme.</descrip></descripGrp><ntig><termGrp><term id="34681">color scheme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503006">схема боја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2425_34681_2527353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined set of harmonized colors that you can apply to text and objects. Text and objects with an applied scheme color will change automatically when you switch to a new color scheme or modify the current color scheme.</descrip></descripGrp><ntig><termGrp><term id="34681">color scheme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527353">шема боја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24254_1117166_2776638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that connects networks using the same communications protocols so that information can be passed from one to the other.</descrip></descripGrp><ntig><termGrp><term id="1117166">bridge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2776638">мост</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24257_1119094_1361765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Silverlight, a feature that enables applications to use external library assemblies retrieved from the server or from the local browser cache.</descrip></descripGrp><ntig><termGrp><term id="1119094">application library caching</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1361765">кеширање библиотека апликација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24259_1119096_1361763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Silverlight, classes that extend the application model by providing services that can participate in the application life cycle.</descrip></descripGrp><ntig><termGrp><term id="1119096">application extension services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1361763">услуге за проширење апликације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24260_1119097_1361784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Silverlight, a feature that enables communication between two Silverlight-based applications running on the same computer.</descrip></descripGrp><ntig><termGrp><term id="1119097">local messaging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1361784">локална размена порука</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24264_1119102_1361786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to, or characteristic of, a Silverlight-based application that a user installs from a Web page and runs outside the browser.</descrip></descripGrp><ntig><termGrp><term id="1119102">out-of-browser</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1361786">ван прегледача</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24287_1119142_1356319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button next to a search box that someone clicks to search for something.</descrip></descripGrp><ntig><termGrp><term id="1119142">Search button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356319">дугме „Претражи“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24287_1119142_1652480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button next to a search box that someone clicks to search for something.</descrip></descripGrp><ntig><termGrp><term id="1119142">Search button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1652480">Дугме за претраживање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24288_1119143_1356320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that displays a thumbnail preview next to each search result. Pointing to the preview enlarges it.</descrip></descripGrp><ntig><termGrp><term id="1119143">search preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356320">преглед претраге</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24289_1119158_2141939"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view to which a set of conditions have been applied to reduce the total number of displayed objects.</descrip></descripGrp><ntig><termGrp><term id="1119158">filtered view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"