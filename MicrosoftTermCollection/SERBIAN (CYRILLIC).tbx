><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37316_2114593_2138100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The folder above the current folder in the folder hierarchy. For example, C:\Shares is the parent folder of C:\Shares\public.</descrip></descripGrp><ntig><termGrp><term id="2114593">parent folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2138100">надређена фасцикла</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37317_2114594_2180605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location of a user's profile on the local drive, for example C:\Users\jason. The user profile could be a local profile, which is stored on a single computer, or a roaming user profile, which is synchronized with a file server so that multiple PCs can use the same profile settings.</descrip></descripGrp><ntig><termGrp><term id="2114594">profile path</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2180605">путања до профила</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37318_2114595_2138102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reduction of performance.</descrip></descripGrp><ntig><termGrp><term id="2114595">performance degradation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2138102">погоршање перформанси</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37324_2116468_2123842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft service that provides fonts on demand to Microsoft applications, eliminating the need for any fonts to be shipped with those applications.</descrip></descripGrp><ntig><termGrp><term id="2116468">Microsoft Fonts Online</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2123842">Microsoft Fonts Online</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37324_2116468_2170039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft service that provides fonts on demand to Microsoft applications, eliminating the need for any fonts to be shipped with those applications.</descrip></descripGrp><ntig><termGrp><term id="2116468">Microsoft Fonts Online</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2170039">Microsoft фонтови на мрежи</term><termNote type="geographicalUsage">SRB, BIH</termNot