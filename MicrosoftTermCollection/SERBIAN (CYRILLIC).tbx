Note></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083110">Microsoft Defender – управљање стањем безбедности у облаку</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54040_3080863_3083121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The product that provides context-aware cloud posture management with agentless vulnerability scanning, and attack paths analysis built on top of a new intelligent cloud security graph.</descrip></descripGrp><ntig><termGrp><term id="3080863">Defender CSPM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083121">Defender CSPM</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54040_3080863_3083418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The product that provides context-aware cloud posture management with agentless vulnerability scanning, and attack paths analysis built on top of a new intelligent cloud security graph.</descrip></descripGrp><ntig><termGrp><term id="3080863">Defender CSPM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083418">Microsoft Defender – управљање стањем безбједности у облаку</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54045_3080956_3083147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Purview Information Protection that can automatically label files that have previously been auto-classified with the appropriate classification and sensitivity label.</descrip></descripGrp><ntig><termGrp><term id="3080956">scanner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083147">анализатор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54046_3080957_3083133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies the first period in the calculation.</descrip></descripGrp><ntig><termGrp><term id="3080957">start_period</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083133">почетни_период</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54047_3080958_3083123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies the last period in the calculation.</descrip></descripGrp><ntig><termGrp><term id="3080958">end_period</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083123">завршни_период</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54048_3080959_3083140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies the first, or starting date of a given period.</descrip></descripGrp><ntig><termGrp><term id="3080959">start_date</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083140">датум_почетка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54049_3080960_3083122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies the last, or ending, date of the period.</descrip></descripGrp><ntig><termGrp><term id="3080960">end_date</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083122">датум_завршетка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5405_77118_1503391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of keystrokes and instructions recorded and saved as a key combination (such as CTRL + X) or file name. When the macro is used, all of the recorded steps are performed automatically. Macros save time by replacing a series of frequently performed steps with a simple key combination or name.</descrip></descripGrp><ntig><termGrp><term id="77118">macro</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503391">макронаредба</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5405_77118_2527398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of keystrokes and instructions recorded and saved as a key combination (such as CTRL + X) or file name. When the macro is used, all of the recorded steps are performed automatically. Macros save time by replacing a series of frequently performed steps with a simple key combination or name.</descrip></descripGrp><ntig><termGrp><term id="77118">macro</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527398">макро</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54050_3080961_3083119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in the DATEVALUE Excel function that represents a date in an Excel date format, or a reference to a cell that contains text that represents a date in an Excel date format.</descrip></descripGrp><ntig><termGrp><term id="3080961">date_text</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083119">текст_датума</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54051_3080962_3083142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies a number in the date-time code used by Excel.</descrip></descripGrp><ntig><termGrp><term id="3080962">serial_number</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083142">серијски_број</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54052_3082099_3083393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability in Dynamics 365 Customer Service that schedules resources for service activity. It considers the availability of employees, facilities, and equipment to plan schedules accordingly. It also helps customer service organizations with improved service quality by preventing over-scheduling. It is built on top of Universal Resource Scheduling (URS).</descrip></descripGrp><ntig><termGrp><term id="3082099">Dynamics 365 Core Service Scheduling</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083393">Dynamics 365 основно планирање услуге</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54053_3082100_3083392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app module that help employees create cases for their problems and interact with agents through the commenting feature. The app enables also searching the knowledge base for solutions pertaining to their problems.</descrip></descripGrp><ntig><termGrp><term id="3082100">Customer Service Team Member</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083392">Члан тима за корисничку службу</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54054_3082101_3083396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to search various knowledge sources, e.g. a knowledge base.</descrip></descripGrp><ntig><termGrp><term id="3082101">knowledge search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083396">претрага базе знања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54055_3082102_3083391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The insight in Dynamics 365 Sales Conversation Intelligence. This insight shows the number of calls where the negative customer sentiments are more than average.</descrip></descripGrp><ntig><termGrp><term id="3082102">Customer sentiment</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083391">Расположење клијената</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54056_3082103_3083400"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The insight in Dynamics 365 Sales Conversation Intelligence. This insight shows the tracked keywords that are defined in the application and that customers use the most during the sales calls. Conversation intelligence highlights these tracked keywords in this insight.</descrip></descripGrp><ntig><termGrp><term id="3082103">Tracked keywords</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083400">Праћене кључне речи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54057_3082104_3083399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The insight in Dynamics 365 Sales Conversation Intelligence. This insight shows the defined competitors' names that customers use most and are trending upwards during the sales calls. Conversation intelligence highlights these competitors in this section.</descrip></descripGrp><ntig><termGrp><term id="3082104">Tracked competitors</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083399">Праћени конкуренти</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54058_3082105_3083397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The insight in Dynamics 365 Sales Conversation Intelligence. This insight helps to discover new products, brands, and organizations that customers are speaking about in sales calls, which they never spoke of in previous calls. These products, brands, and organizations are not defined in the application (tracked keywords and competitors), and the application uses Microsoft Bing's knowledge repository to identify the products, brands, and organizations to display.</descrip></descripGrp><ntig><termGrp><term id="3082105">Other brands and organizations</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083397">Остали брендови и организације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54059_3082106_3083394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intelligent chat bot that can answer frequently asked questions, created by the Employee FAQ template. If an answer cannot be provided, it automatically collects requests and notifies human experts in Microsoft Teams channel. Then experts can chat directly with employees on Teams, in order to resolve the request.</descrip></descripGrp><ntig><termGrp><term id="3082106">FAQ bot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083394">робот за најчешћа питања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54060_3082107_3083395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A multi-disciplinary team of developers, users, and business leaders that use their specific disciplines and expertise to help build a product that aligns to one common goal. By combining the team’s knowledge with the latest technology, fusion teams can deliver products and solutions faster and more efficiently.</descrip></descripGrp><ntig><termGrp><term id="3082107">fusion team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083395">фузиони тим</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54062_3083270_3084472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Clock app which helps users minimize distractions by turning on Do Not Disturb and silencing icon flashing and badge notifications for apps in the taskbar.</descrip></descripGrp><ntig><termGrp><term id="3083270">focus session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3084472">сесија за фокусирање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54063_3083390_3085395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Defender for Business add-on that delivers the same level of protection for both clients and servers within a single admin experience, helping users to protect all endpoints in one location.</descrip></descripGrp><ntig><termGrp><term id="3083390">Microsoft Defender for Business servers</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3085395">Microsoft Defender за посао – сервери</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54066_3083517_3084473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical recording studio that creates holographic video—holograms of dynamic people and performances.</descrip></descripGrp><ntig><termGrp><term id="3083517">mixed reality capture studio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3084473">студио за креирање мешовите реалности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54066_3083517_3084730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical recording studio that creates holographic video—holograms of dynamic people and performances.</descrip></descripGrp><ntig><termGrp><term id="3083517">mixed reality capture studio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3084730">студио за креирање мјешовите реалности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54069_3083575_3084475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video that can be viewed as a flat video from any given viewpoint but exists volumetrically in 3D space, offering viewers a more immersive experience.</descrip></descripGrp><ntig><termGrp><term id="3083575">volumetric video</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3084475">волуметријски видео</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54071_3083658_3084477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The prefix displayed on a badge indicating the search result originates from the Web.</descrip></descripGrp><ntig><termGrp><term id="3083658">Web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3084477">Веб</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54072_3083695_3085394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 offer for one person that includes 100 GB of cloud storage with advanced file and photo protection, secure, ad-free Outlook email and calendar, and Web and mobile versions of Word, Excel, and PowerPoint.</descrip></descripGrp><ntig><termGrp><term id="3083695">Microsoft 365 Basic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3085394">Microsoft 365 Basic</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54073_3083696_3085396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft cloud-based security service commercial offer, which provides configuration, protection, and detection capabilities.</descrip></descripGrp><ntig><termGrp><term id="3083696">Microsoft Defender for Office 365 Plan 1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3085396">Microsoft Defender за Office 365 Plan 1</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54073_3190849_3085396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft cloud-based security service commercial offer, which provides configuration, protection, and detection capabilities.</descrip></descripGrp><ntig><termGrp><term id="3190849">Microsoft Defender for Office 365 (Plan 1)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3085396">Microsoft Defender за Office 365 Plan 1</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54074_3083702_3085409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of insights within Microsoft Viva Insights that helps users prioritize wellbeing with actionable recommendations, such as reserving time for focused work, taking regular breaks, and practicing mindfulness.</descrip></descripGrp><ntig><termGrp><term id="3083702">personal insights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3085409">лични увиди</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54075_3083703_3085393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of insights within Microsoft Viva Insights that gives managers visibility into their team’s collaboration patterns, which are leading indicators that ladder up to overall wellbeing.</descrip></descripGrp><ntig><termGrp><term id="3083703">manager insights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3085393">увиди за менаџере</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54076_3083704_3085392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of insights within Microsoft Viva Insights that provides business leaders with a snapshot into how their organization is performing, including company-wide outcomes and leading indicators for each outcome.</descrip></descripGrp><ntig><termGrp><term id="3083704">leader insights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3085392">увиди за водитеље</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54077_3083705_3085389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Viva feature that functions as a hub for employees to ask questions, find solutions, discover knowledge, and help coworkers.</descrip></descripGrp><ntig><termGrp><term id="3083705">Answers</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3085389">Одговори</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54078_3083710_3085410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies the value that is redeemed per $100 face value.</descrip></descripGrp><ntig><termGrp><term id="3083710">redemption</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3085410">искоришћавање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54079_3083711_3085391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in Excel DOLLARDE function that specifies a number expressed as an integer part and a fraction part, separated by a decimal symbol.</descrip></descripGrp><ntig><termGrp><term id="3083711">fractional_dollar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3085391">долар_у_разломцима</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54080_3083712_3085390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies a decimal number.</descrip></descripG