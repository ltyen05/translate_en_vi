ripGrp><ntig><termGrp><term id="2332081">Safety Tips</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2341461">Савети о безбедности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40126_2332083_2341460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows administrators to inform email senders that they may be about to violate one of the data loss prevention policies.</descrip></descripGrp><ntig><termGrp><term id="2332083">Policy Tips</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2341460">Савети у вези са смерницама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40128_2332337_2593862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A DNS server that has been configured to return non-routable addresses in response to DNS queries, preventing the use of a domain name.</descrip></descripGrp><ntig><termGrp><term id="2332337">sinkhole</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2593862">синкхол</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40162_2333642_2341457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI element that gives a user a view of the important email, as presorted by the Focused Inbox feature.</descrip></descripGrp><ntig><termGrp><term id="2333642">Focused</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2341457">У фокусу</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40163_2333645_2341459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The email management approach developed by productivity expert Merlin Mann so that zero time is spent thinking about email without any of the five actions he identified.</descrip></descripGrp><ntig><termGrp><term id="2333645">Inbox Zero</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2341459">Ефикасно поштанско сандуче</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4017_397157_406448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A storage platform that provides a single repository for managing multiple types of unstructured information in one infrastructure. The Exchange store combines the features and functionality of the file system, the Web, and a collaboration server (such as Microsoft Exchange) through a single, URL-addressable location for storing, accessing, and managing information, as well as building and running applications. The Exchange store is also known as the Web Storage System.</descrip></descripGrp><ntig><termGrp><term id="397157">Exchange store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406448">Exchange складиште</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40226_2339682_2345331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that lets users draw someone's attention to an email message or calendar item by adding the @ symbol followed by the person's name to the body of the message or item. When this happens, the person will be notified automatically that they were mentioned.</descrip></descripGrp><ntig><termGrp><term id="2339682">Mentions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2345331">Помињања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40226_2339682_2678203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that lets users draw someone's attention to an email message or calendar item by adding the @ symbol followed by the person's name to the body of the message or item. When this happens, the person will be notified automatically that they were mentioned.</descrip></descripGrp><ntig><termGrp><term id="2339682">Mentions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2678203">@помињања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40226_2677038_2345331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that lets users draw someone's attention to an email message or calendar item by adding the @ symbol followed by the person's name to the body of the message or item. When this happens, the person will be notified automatically that they were mentioned.</descrip></descripGrp><ntig><termGrp><term id="2677038">@mentions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2345331">Помињања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40226_2677038_2678203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that lets users draw someone's attention to an email message or calendar item by adding the @ symbol followed by the person's name to the body of the message or item. When this happens, the person will be notified automatically that they were mentioned.</descrip></descripGrp><ntig><termGrp><term id="2677038">@mentions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2678203">@помињања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40227_2339683_2345332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The slide transition in PowerPoint that smoothly animates objects across slides.</descrip></descripGrp><ntig><termGrp><term id="2339683">Morph</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2345332">Морф</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40228_2339819_2710549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An algorithm that identifies an author's intention in a social post, for example, the intent to purchase or the intent to complain.</descrip></descripGrp><ntig><termGrp><term id="2339819">intention analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2710549">анализа намере</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40230_2339821_2710532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Social Engagement that shows details, such as the number of followers and latest posts, and analysis about a specific author's public profile on a social network.</descrip></descripGrp><ntig><termGrp><term id="2339821">Author Details</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2710532">детаљи о аутору</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40231_2339822_2710569"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Social Engagement that shows the connections or relations of an author on Twitter to a social profile in Social Engagement.</descrip></descripGrp><ntig><termGrp><term id="2339822">Relationships</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2710569">односи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40232_2339823_2710540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of public RSS and ATOM feeds that extend the coverage of the default data sources in Social Engagement.</descrip></descripGrp><ntig><termGrp><term id="2339823">custom source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2710540">прилагођени извор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40233_2339918_2710534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule that processes a defined data set of social posts with a specified set of actions.</descrip></descripGrp><ntig><termGrp><term id="2339918">automation rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2710534">правило аутоматизације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40236_2340522_2417292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature to protect sensitive data stored in Azure SQL Database or SQL Server databases, allowing clients to encrypt this data inside client applications and never reveal the encryption keys to the database engine, thus providing a separation between those who own the data and those who manage it.</descrip></descripGrp><ntig><termGrp><term id="2340522">Always Encrypted</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2417292">Always Encrypted</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40237_2340528_2341696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SSIS component that allows the OLE DB Provider for SSIS to consume output of an SSIS package as a tabular result set by creating a linked server that uses the OLE DB Provider for SSIS and then running a SQL query on the linked server to display data returned by the SSIS package.</descrip></descripGrp><ntig><termGrp><term id="2340528">Data Streaming Destination</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2341696">Одредиште протока података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40238_2340529_2341705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that extracts log messages collected from different sources and writes them into a single file.</descrip></descripGrp><ntig><termGrp><term id="2340529">direct log consumer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2341705">директни потрошач порука евиденције</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40238_2600603_2341705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that extracts log messages collected from different sources and writes them into a single file.</descrip></descripGrp><ntig><termGrp><term id="2600603">DLC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammati