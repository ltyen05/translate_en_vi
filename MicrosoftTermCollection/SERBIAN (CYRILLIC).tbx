ity pane.</descrip></descripGrp><ntig><termGrp><term id="3079261">full case form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3079428">пуни образац за предмет</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54018_3079262_3079429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form that allows agents to create a case using a side pane during live customer interaction. They can take notes and add attachments, without losing the ability to interact with the customer and copy/paste contextual information right into the case.</descrip></descripGrp><ntig><termGrp><term id="3079262">quick case form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3079429">брзи образац за предмет</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54020_3079376_3080627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Teams Premium feature that allows users to access meeting information and includes AI-driven capabilities.</descrip></descripGrp><ntig><termGrp><term id="3079376">intelligent recap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3080627">интелигентни подсетник</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54020_3079376_3080664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Teams Premium feature that allows users to access meeting information and includes AI-driven capabilities.</descrip></descripGrp><ntig><termGrp><term id="3079376">intelligent recap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3080664">интелигентни подсјетник</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54021_3079377_3080645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Teams Premium feature that allows IT admins to create custom meeting types/templates for their organization.</descrip></descripGrp><ntig><termGrp><term id="3079377">meeting guides</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3080645">водичи за састанке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54022_3079520_3080594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of premium meeting protection capabilities in Teams Premium, to better contrast with basic meeting protections.</descrip></descripGrp