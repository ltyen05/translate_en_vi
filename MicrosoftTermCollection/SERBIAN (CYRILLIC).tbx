1739">делта функција</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44564_2506552_2511736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A complete set of data returned for a resource from a delta query GET request.</descrip></descripGrp><ntig><termGrp><term id="2506552">delta feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2511736">делта feed</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44565_2506553_2511768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An opaque token returned in a delta query GET response which encodes the point in time of the last data provided to the client.</descrip></descripGrp><ntig><termGrp><term id="2506553">state token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2511768">токен стања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44567_2506560_2511749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of data about a resource that contains complex values, generally indicating behaviors or capabilities of an item.</descrip></descripGrp><ntig><te