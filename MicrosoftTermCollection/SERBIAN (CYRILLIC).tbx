</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50519_2860771_2861914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of machine learning capabilities that enable users to create models that process structured and unstructured documents to extract information, and classify and automatically tag content.</descrip></descripGrp><ntig><termGrp><term id="2860771">content understanding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2861914">разумевање садржаја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50521_2860780_2861034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Shadow Stack security feature that prevents a class of vulnerabilities known as Return-Oriented Programming (ROP) and requires hardware in order to work.</descrip></descripGrp><ntig><termGrp><term id="2860780">hardware-enforced stack protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2861034">хардверска заштита стека</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50521_2860780_3020419"><langSet xml:lang="en-US"><descripGrp><de