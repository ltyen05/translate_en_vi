pGrp><descrip type="definition">Of or relating to communications systems in which the medium of transmission (such as a wire or fiber-optic cable) carries multiple messages at a time, each message modulated on its own carrier frequency by a modem.</descrip></descripGrp><ntig><termGrp><term id="23913">broadband</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504244">широкопојасни</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13926_299909_1504245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows technology that collects data when the system crashes or stops responding and sends it to Microsoft.</descrip></descripGrp><ntig><termGrp><term id="299909">Windows Error Reporting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504245">извјештавање о грешкама система Windows</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13926_558472_1504245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows technology that collects data when the system crashes or stops responding and sends it to Microsoft.</descrip></descripGrp><ntig><termGrp><term id="558472">WER</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSe