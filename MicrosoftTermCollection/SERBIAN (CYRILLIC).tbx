></ntig></langSet></termEntry><termEntry id="1337_297179_1502886"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of trojan that causes systems equipped with modems to dial phone numbers without the consent of the user. In most cases, the phone numbers dialed are premium rate numbers which result in unexpected charges on the affected user's phone bill.</descrip></descripGrp><ntig><termGrp><term id="297179">dialer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502886">тип вируса који успоставља недозвољене конекције</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13370_33049_1504195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To end an application's relationship with an open file so that the application will no longer be able to access the file without opening it again.</descrip></descripGrp><ntig><termGrp><term id="33049">close</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504195">затворити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13370_33049_2776647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To end an application's relationship with an open file so that the application will no longer be able to access the file without opening it again.</descrip></descripGrp><ntig><termGrp><term id="33049">close</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2776647">затворити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13372_413712_1504196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbol that is displayed beside a paragraph in outline view. You can use the symbol to display or hide subordinate levels of text and to reorganize text quickly.</descrip></descripGrp><ntig><termGrp><term id="413712">outline symbol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504196">симбол на маргини</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13372_413712_2527768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbol that is displayed beside a paragraph in outline view. You can use the symbol to display or hide subordinate levels of text and to reorganize text quickly.</descrip></descripGrp><ntig><termGrp><term id="413712">outline symbol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527768">симбол структуре</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13374_359204_1504197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A complete Web site stored in a named subdirectory of the top-level Web site.</descrip></descripGrp><ntig><termGrp><term id="359204">subsite</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504197">подстраница</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13382_178479_2541873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unit or sale price of the product, multiplied by the adjusted percentage. This is displayed in the local currency (that is, the currency of your installed locale).</descrip></descripGrp><ntig><termGrp><term id="178479">adjusted price</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541873">коригована цена</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13396_2037690_1504198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proxy server installed by a trojan on a machine providing what appears to be an uninterrupted Internet connection while allowing unauthorized access to an affected machine.</descrip></descripGrp><ntig><termGrp><term id="2037690">trojan proxy server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504198">trojan proxy server</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1340_74525_1502887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The right of a person or entity to use software in a particular way, as described in the terms of the license agreement. Copyright law also limits how a person may use the software. A person needs a license agreement for each software program they use.</descrip></descripGrp><ntig><termGrp><term id="74525">license</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502887">лиценца</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13402_41397_1504199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbol selected to designate a specific currency.</descrip></descripGrp><ntig><termGrp><term id="41397">currency symbol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504199">знак валуте</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13405_94512_1504200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One or more fields that uniquely identify each record in a table.</descrip></descripGrp><ntig><termGrp><term id="94512">primary key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504200">примарни кључ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13405_94512_2421875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One or more fields that uniquely identify each record in a table.</descrip></descripGrp><ntig><termGrp><term id="94512">primary key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2421875">примарни кључ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13407_121010_1916631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The way text is displayed in a document, how it behaves and breaks according to settings.</descrip></descripGrp><ntig><termGrp><term id="121010">text flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916631">ток текста</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13408_299899_1504201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Words or phrases that convey hatred or contempt or is intended to intimidate or cause harm to a group of people based on race, religion, ethnic origin, sexual orientation or disability.</descrip></descripGrp><ntig><termGrp><term id="299899">hate speech</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504201">говор мржње</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13422_35424_2541460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In VBA, a resource in which toolbars, shortcut menus, and menu bars and their menus have been combined into a single functionality. Command bars can be one of three types: menu bar, toolbar, or pop-up menu.</descrip></descripGrp><ntig><termGrp><term id="35424">command bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541460">командна трака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13432_13039_1504202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action query that adds the records in a query's result set to the end of an existing table.</descrip></descripGrp><ntig><termGrp><term id="13039">append query</term><termNote type="p