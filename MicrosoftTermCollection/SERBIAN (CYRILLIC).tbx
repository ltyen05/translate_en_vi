rmEntry><termEntry id="20995_762983_1051351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version that uses checkboxes and does not include a reading pane. It is recommneded for users with a slow internet connection.</descrip></descripGrp><ntig><termGrp><term id="762983">classic version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051351">класична верзија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20998_763011_1051368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of colors and background images that lets users change the appearance of Windows Live pages. The theme is common to all pages, except for group, event, and space pages, which may each have their own theme.</descrip></descripGrp><ntig><termGrp><term id="763011">theme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051368">тема</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20999_763132_1051365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To copy something from a computer to a location online, such as a photo album or a blog post.</descrip></descripGrp><ntig><termGrp><term id="763132">publish</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051365">објавити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20999_763132_1527833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To copy something from a computer to a location online, such as a photo album or a blog post.</descrip></descripGrp><ntig><termGrp><term id="763132">publish</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1527833">објави</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21000_763151_1527830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Parental consent for a child to use a service, view a website, or communicate with a person.</descrip></descripGrp><ntig><termGrp><term id="763151">permission</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1527830">дозвола</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21001_763161_1051361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A content element a user can add to their space.</descrip></descripGrp><ntig><termGrp><term id="763161">module</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051361">модул</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21003_763869_1504612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout type that includes layouts designed to show nonsequential information.</descrip></descripGrp><ntig><termGrp><term id="763869">List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504612">списак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21003_763869_2527897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout type that includes layouts designed to show nonsequential information.</descrip></descripGrp><ntig><termGrp><term id="763869">List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527897">Листа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21004_763870_1504613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout type that includes layouts designed to show steps in a process or timeline.</descrip></descripGrp><ntig><termGrp><term id="763870">Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504613">процес</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21004_763870_2527898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout type that includes layouts designed to show steps in a process or timeline.</descrip></descripGrp><ntig><termGrp><term id="763870">Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527898">Процес</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21005_763871_1504614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout type that includes layouts designed to show a continual process.</descrip></descripGrp><ntig><termGrp><term id="763871">Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504614">круг</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21005_763871_2527899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout type that includes layouts designed to show a continual process.</descrip></descripGrp><ntig><termGrp><term id="763871">Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527899">Циклус</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21006_763872_1988672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout type that includes layouts designed to show a hierarchical structure, such as an organization chart, or a decision tree.</descrip></descripGrp><ntig><termGrp><term id="763872">Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1988672">Хијерархија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21007_763873_1917027"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout type that includes layouts designed to illustrate connections.</descrip></descripGrp><ntig><termGrp><term id="763873">Relationship</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917027">Однос</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21008_763874_1504615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout type that includes layouts designed to show how parts relate to a whole.</descrip></descripGrp><ntig><termGrp><term id="763874">Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504615">матрица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21008_763874_2527902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout type that includes layouts designed to show how parts relate to a whole.</descrip></descripGrp><ntig><termGrp><term id="763874">Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527902">Матрица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21009_763875_1917028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout type that includes layouts designed to show proportional relationships with the largest component on the top or bottom.</descrip></descripGrp><ntig><termGrp><term id="763875">Pyramid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917028">Пирамида</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21010_763876_1051360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The overall design of a page or content set, including text elements, controls, and graphics.</descrip></descripGrp><ntig><termGrp><term id="763876">layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051360">распоред</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21011_763877_1051353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A post, comments, and responses made within a conversation space, such as a message board, help board, community, newsgroup, or blog. These exchanges are usually publicly viewable. Participation may require credentials, such as a Windows Live ID.</descrip></descripGrp><ntig><termGrp><term id="763877">discussion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051353">дискусија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21012_1135481_1167168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The descriptive information about a user that is shown to other users. This editable information is separate from the registration information they provide to establish their Windows Live account. This separation allows users to disclose or conceal personal information as they choose.</descrip></descripGrp><ntig><termGrp><term id="1135481">Windows Live Profile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1167168">Windows Live профил</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21012_1135481_1527832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The descriptive information about a user that is shown to other users. This editable information is separate from the registration information they provide to establish their Windows Live account. This separation allows users to disclose or conceal personal information as they choose.</descrip></descripGrp><ntig><termGrp><term id="1135481">Windows Live Profile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1527832">профил</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21012_763878_1167168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The descriptive information about a user that is shown to other users. This editable information is separate from the registration information they provide to establish their Windows Live account. This separation allows users to disclose or conceal personal information as they choose.</descrip></descripGrp><ntig><termGrp><term id="763878">profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1167168">Windows Live профил</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21012_763878_1527832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The descriptive information about a user that is shown to other users. This editable information is separate from the registration information they provide to establish their Windows Live account. This separation allows users to disclose or conceal personal information as they choose.</descrip></descripGrp><ntig><termGrp><term id="763878">profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1527832">профил</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21013_763879_1051366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An answer that only the user knows for a specific question. The answer is used to confirm someone's identity if they forget their password.</descrip></descripGrp><ntig><termGrp><term id="763879">secret answer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051366">тајни одговор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21014_763880_1051355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security type that helps prevent unauthorized persons from discerning that a user is going to the Windows Live sign-in page. Otherwise, an unauthorized person might be able to intercept and manipulate the code on the sign-in page, which could result in user information being transmitted to an unauthorized website.</descrip></descripGrp><ntig><termGrp><term id="763880">enhanced security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051355">побољшана безбедност</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21015_2392175_1051349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email address to which password reset information can be sent if a customer forgets the password portion of their Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2392175">alternate email address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051349">алтернативна е-адреса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21015_2392175_3104824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email address to which password reset information can be sent if a customer forgets the password portion of their Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2392175">alternate email address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3104824">алтернативна е-пошта</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21015_3103949_1051349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email address to which password reset information can be sent if a customer forgets the password portion of their Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="3103949">alternate email</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051349">алтернативна е-адреса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21015_3103949_3104824"><langSet xml: