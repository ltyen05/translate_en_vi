rm><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32531_1684427_2665325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of pages in the virtual address space of the process that are currently resident in physical memory.</descrip></descripGrp><ntig><termGrp><term id="1684427">working set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2665325">радни скуп</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32547_1684489_2542359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom MAPI message store provider that is “wrapped” around the underlying PST provider to tailor it to specific business needs. It relies on the underlying PST provider to handle most data storage and retrieval functions.</descrip></descripGrp><ntig><termGrp><term id="1684489">Wrapped PST provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542359">Wrapped PST добављач</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3255_148778_2527591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar that contains buttons that allow users to perform some of the most common tasks in a Microsoft Office program, such as opening, saving, and printing files.</descrip></descripGrp><ntig><termGrp><term id="148778">Standard toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527591">стандардна трака са алаткама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32556_1686879_1749160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that validates, signs, and stores boot information in the Trusted Platform Module chip to verify the integrity of the PC.</descrip></descripGrp><ntig><termGrp><term id="1686879">Measured Boot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1749160">Контролисано покретање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32556_1686879_1753466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that validates, signs, and stores boot information in the Trusted Platform Module chip to verify the integrity of the PC.</descrip></descripGrp><ntig><termGrp><term id="1686879">Measured Boot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1753466">Мерено покретање<