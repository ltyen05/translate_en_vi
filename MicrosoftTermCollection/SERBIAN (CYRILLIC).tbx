Speech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27498_1378793_1724836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software or web service that provides an anonymous proxy designed to make user identity untraceable.</descrip></descripGrp><ntig><termGrp><term id="1378793">anonymizer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1724836">модул за анонимност</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27506_1379247_1527822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The checkbox customers select to include their lists in the updates that they share about themselves. This text links to Spaces.</descrip></descripGrp><ntig><termGrp><term id="1379247">Lists</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1527822">Спискови</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27507_1379249_2509147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The checkbox customers select to include changes to their friends in the updates that they share about themselves.</descrip></descripGrp><ntig><termGrp><term id="1379249">Network</term><termNote type="partOfSpeech">ProperNoun</ter