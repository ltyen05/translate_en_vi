roperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54285_3095200_3095578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The free global learning event on Data, Analytics and AI for data professionals that features a keynote session and more than 200 breakout sessions delivered by Azure Data engineering, partner organizations, and community leaders.</descrip></descripGrp><ntig><termGrp><term id="3095200">DPS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3095578">DPS</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54286_3095420_3096394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code or configuration vulnerability within Microsoft 365 tenants, Microsoft cloud service tenants, or cloud service infrastructure that could cause wide-spread compromise of services, denial-of-service, or sensitive information disclosure.</descrip></descripGrp><ntig><termGrp><term id="3095420">cloud critical vulnerability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3096394">критична рањивост у облаку</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54287_3095421_3096396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A loss or potential loss of confidentiality via the unauthorized or accidental disclosure or transfer of sensitive or classified information to an unclassified information system.</descrip></descripGrp><ntig><termGrp><term id="3095421">information spillage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3096396">цурење информација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54288_3095422_3096397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action performed to inspect, neutralize, contain, or eradicate a threat entity or a compromised entity.</descrip></descripGrp><ntig><termGrp><term id="3095422">response action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3096397">радња одговора</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54289_3095423_3096395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service wherein a provider delivers tailored instructions that aid in the performance of response actions; also used to refer to the set of provided instructions.</descrip></descripGrp><ntig><termGrp><term id="3095423">guided response</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig