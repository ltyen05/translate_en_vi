707138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyword or description used to identify groups of related items.</descrip></descripGrp><ntig><termGrp><term id="234513">category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="707138">категорија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5712_131978_1725940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software program used to display webpages and to navigate the Internet.</descrip></descripGrp><ntig><termGrp><term id="131978">Web browser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1725940">прегледач</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5712_131978_2253310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software program used to display webpages and to navigate the Internet.</descrip></descripGrp><ntig><termGrp><term id="131978">Web browser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2253310">веб прегледач</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5712_131979_1725940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software program used to display webpages and to navigate the Internet.</descrip></descripGrp><ntig><termGrp><term id="131979">browser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1725940">прегледач</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5712_131979_2253310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software program used to display webpages and to navigate the Internet.</descrip></descripGrp><ntig><termGrp><term id="131979">browser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2253310">веб прегледач</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5712_1362689_1725940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software program used to display webpages and to navigate the Internet.</descrip></descripGrp><ntig><termGrp><term id="1362689">web browser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1725940">прегледач</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5712_1362689_2253310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software program used to display webpages and to navigate the Internet.</descrip></descripGrp><ntig><termGrp><term id="1362689">web browser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2253310">веб прегледач</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5719_27856_1136382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directive to an email program to send a complete copy of a given piece of mail to another individual. The use of cc mail addressing, as opposed to directly addressing the mail to a person, generally implies that the recipient is not required to take any action; the message is for informational purposes only. In a cc directive, the fact that this recipient received the mail is printed in the mail header and is thus known to all other recipients.</descrip></descripGrp><ntig><termGrp><term id="27856">carbon copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1136382">Cc</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5719_27856_1503419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directive to an email program to send a complete copy of a given piece of mail to another individual. The use of cc mail addressing, as opposed to directly addressing the mail to a person, generally implies that the recipient is not required to take any action; the message is for informational purposes only. In a cc directive, the fact that this recipient received the mail is printed in the mail header and is thus known to all other recipients.</descrip></descripGrp><ntig><termGrp><term id="27856">carbon copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503419">копија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5719_27857_1136382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directive to an email program to send a complete copy of a given piece of mail to another individual. The use of cc mail addressing, as opposed to directly addressing the mail to a person, generally implies that the recipient is not required to take any action; the message is for informational purposes only. In a cc directive, the fact that this recipient received the mail is printed in the mail header and is thus known to all other recipients.</descrip></descripGrp><ntig><termGrp><term id="27857">cc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1136382">Cc</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5719_27857_1503419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directive to an email program to send a complete copy of a given piece of mail to another individual. The use of cc mail addressing, as opposed to directly addressing the mail to a person, generally implies that the recipient is not required to take any action; the message is for informational purposes only. In a cc directive, the fact that this recipient received the mail is printed in the mail header and is thus known to all other recipients.</descrip></descripGrp><ntig><termGrp><term id="27857">cc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503419">копија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5719_27858_1136382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directive to an email program to send a complete copy of a given piece of mail to another individual. The use of cc mail addressing, as opposed to directly addressing the mail to a person, generally implies that the recipient is not required to take any action; the message is for informational purposes only. In a cc directive, the fact that this recipient received the mail is printed in the mail header and is thus known to all other recipients.</descrip></descripGrp><ntig><termGrp><term id="27858">courtesy copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1136382">Cc</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5719_27858_1503419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directive to an email program to send a complete copy of a given piece of mail to another individual. The use of cc mail addressing, as opposed to directly addressing the mail to a person, generally implies that the recipient is not required to take any action; the message is for informational purposes only. In a cc directive, the fact that this recipient received the mail is printed in the mail header and is thus known to all other recipients.</descrip></descripGrp><ntig><termGrp><term id="27858">courtesy copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503419">копија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5725_295557_1503421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a process that is performed by a person, rather than automated.</descrip></descripGrp><ntig><termGrp><term id="295557">manual</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503421">ручно</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5726_269749_2097765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A state in which users fill out forms when working offline.</descrip></descripGrp><ntig><termGrp><term id="269749">offline mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2097765">режим рада ван мреже</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5728_25995_1503423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that enables a broadband connection to the Internet by using cable television infrastructure. Access speeds vary greatly, with a maximum throughput of 10 megabits per second (Mbps).</descrip></descripGrp><ntig><termGrp><term id="25995">cable modem</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503423">кабловски модем</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="573_231958_1502793"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of coordinates that a cell occupies on a worksheet. For example, the reference of the cell that appears at the intersection of column B and row 3 is B3.</descrip></descripGrp><ntig><termGrp><term id="231958">cell reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><nti