try><termEntry id="34720_2817523_2014289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advanced feature that enables a user to apply filters on properties such as people, folder, and attachments.</descrip></descripGrp><ntig><termGrp><term id="2817523">refiner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2014289">прецизније претраживање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34721_2002417_2014288"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that automatically corrects searches for misspellings, alternative spellings or other input that would otherwise reduce the number or quality of the results.</descrip></descripGrp><ntig><termGrp><term id="2002417">Search Prediction</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2014288">Предвиђање при претрази</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34723_2002419_2014273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables a user to search for events in the Calendar using keywords, and use filters to refine the search.</descrip></descripGrp><ntig><termGrp><term id="2002419">Calendar Event Search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2014273">Претраживање догађаја из календара</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34726_2002422_2014280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables group owners to change their group's image and colors for a better representation.</descrip></descripGrp><ntig><termGrp><term id="2002422">group theming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2014280">визуелни идентитет групе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34728_2002424_2014284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that appears on the nav bar to accommodate additional links that cannot be displayed due to a low screen resolution or small size of the browser window. The More menu is represented on the nav bar as an ellipsis.</descrip></descripGrp><ntig><termGrp><term id="2002424">More menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2014284">мени „Још“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34730_2003267_2014291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that enables a user to interact with tasks in a SharePoint list. A user can quickly move tasks between status categories to keep the list up to date.</descrip></descripGrp><ntig><termGrp><term id="2003267">TaskBoard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2014291">Табла са задацима</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34731_2004703_2014287"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables a user to search for another user's or group's calendar and pin it to their calendar list.</descrip></descripGrp><ntig><termGrp><term id="2004703">search and pin calendars</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2014287">претраживање и качење календара</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34734_2009037_2014275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The workspace at the bottom of the application that displays alerts and notifications.</descrip></descripGrp><ntig><termGrp><term id="2009037">desktop app bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2014275">трака апликација за стоне рачунаре</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34735_2009421_2014283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The workspace along the bottom edge of the screen that enables the user to access Office 365 services or sign out.</descrip></descripGrp><ntig><termGrp><term id="2009421">mobile app bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2014283">трака апликација за мобилне уређаје</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34739_2012681_2014285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to compose or reply to a message without leaving the context of the conversation.</descrip></descripGrp><ntig><termGrp><term id="2012681">Quick Compose</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2014285">Брзо састављање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34741_2012702_2521509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows organizations to comply with legal discovery requirements by searching and holding relevant content from mailboxes, Skype for Business, and SharePoint Online websites, documents and file shares.</descrip></descripGrp><ntig><termGrp><term id="2012702">In-Place eDiscovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2521509">Е-откривање оригинала</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34748_2012910_2014290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office feature that creates a view where users can see the content that has been shared with them.</descrip></descripGrp><ntig><termGrp><term id="2012910">Shared with Me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2014290">Дељено са мном</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34749_2012913_2014282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows a preview of a webpage or YouTube video. The preview will show a photo, title, and description of the webpage or video.</descrip></descripGrp><ntig><termGrp><term id="2012913">Inline Previews</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2014282">Уграђени прегледи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34750_2012915_2014274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that opens the current document’s table of contents in a pane. Users can pin the pane to the document, and when they scroll through the document, the table of contents dynamically highlights the section they are in.</descrip></descripGrp><ntig><termGrp><term id="2012915">Contents</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2014274">Садржај</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34751_2012916_2014277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI element that enables the user to locate text and go to locations where the text occurs in a document.</descrip></descripGrp><ntig><termGrp><term id="2012916">Find</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2014277">Проналажење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34754_2013078_2014286"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of multiple authors, who are editing a shared document, to simultaneously see text and formatting changes made by co-authors as they add them.</descrip></descripGrp><ntig><termGrp><term id="2013078">Real-time Co-authoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2014286">коауторство у реалном времену</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34755_2013123_2014293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that creates new and improved mobile browser views. Documents are displayed as big touchable tiles on the screen. Users can view their own documents, shared documents, or ones they follow. They can open documents or share the URL of a document with other users. Additionally, users can navigate to Mail, Calendar, People, and Sites to view sites that they follow and those promoted by their site administrator.</descrip></descripGrp><ntig><termGrp><term id="2013123">Touch Design</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2014293">Дизајн предвиђен за додир</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34756_2013318_2017086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app for the Windows Store designed for small groups of SharePoint users to enable them to perform basic tasks, such as provide access to team document libraries, site feeds, and project tasks.</descrip></descripGrp><ntig><termGrp><term id="2013318">Sites app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2017086">апликација „Локације“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34756_2013318_2018589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app for the Windows Store designed for small groups of SharePoint users to enable them to perform basic tasks, such as provide access to team document libraries, site feeds, and project tasks.</descrip></descripGrp><ntig><termGrp><term id="2013318">Sites app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2018589">Апликације Локације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34758_2013323_2776812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transfer of customer data from one system to another.</descrip></descripGrp><ntig><termGrp><term id="2013323">migration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2776812">миграција</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34759_2013324_2591354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product that provides additional functionality when used with a prerequisite underlying base product.</descrip></descripGrp><ntig><termGrp><term id="2013324">add-on</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2591354">додатак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34761_2013325_2015823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that is only available when a device is connected to the Internet so that the file’s data uses little space in the device’s storage.</descrip></descripGrp><ntig><termGrp><term id="2013325">smart file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2015823">паметна датотека</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34761_2013325_2016350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that is only available when a device is connected to the Internet so that the file’s data uses little space in the device’s storage.</descrip></descripGrp><ntig><termGrp><term id="2013325">smart file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2016350">паметни фајл</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34764_2013405_2920490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Video communication with another player on Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="2013405">video chat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920490">видео ћаскање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34765_2013409_2918481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The console power cable that runs from the wall (power) to the power supply cord.</descrip></descripGrp><ntig><termGrp><term id="2013409">AC power cord</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918481">кабл за напајање наизменичном струјом</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34766_2013410_2919205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A player who has subscribed to Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="2013410">member</term><termNote ty