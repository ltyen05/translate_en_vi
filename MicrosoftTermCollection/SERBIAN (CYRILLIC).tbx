r</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54253_3093359_3093889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The paid Microsoft Teams offer with additional features that enables premium capabilities for additional meeting scenarios, including Virtual appointments and webinars.</descrip></descripGrp><ntig><termGrp><term id="3093359">Microsoft Teams Premium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3093889">Microsoft Teams Premium</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54253_3093359_3093890"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The paid Microsoft Teams offer with additional features that enables premium capabilities for additional meeting scenarios, including Virtual appointments and webinars.</descrip></descripGrp><ntig><termGrp><term id="3093359">Microsoft Teams Premium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3093890">Teams Premium</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54253_3093360_3093889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The paid Microsoft Teams offer with additional features that enables premium capabilities for additional meeting scenarios, including Virtual appointments and webinars.</descrip></descripGrp><ntig><termGrp><term id="3093360">Teams Premium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3093889">Microsoft Teams Premium</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54253_3093360_3093890"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The paid Microsoft Teams offer with additional features that enables premium capabilities for additional meeting scenarios, including Virtual appointments and webinars.</descrip></descripGrp><ntig><termGrp><term id="3093360">Teams Premium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3093890">Teams Premium</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54254_3093361_3093887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The website where Microsoft shares security engineering practices that are used to build and operate highly secure apps and services.</descrip></descripGrp><ntig><termGrp><term id="3093361">Security Engineering Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3093887">Портал за безбедносни инжењеринг</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNo