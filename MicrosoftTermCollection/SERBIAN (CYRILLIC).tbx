><descripGrp><descrip type="definition">A combination of a digital certificate and a public and private encryption key set.</descrip></descripGrp><ntig><termGrp><term id="140884">Digital ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541763">дигитални ID</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1415_64659_1502900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The processes involved in the capture, storage, display, and printing of graphical images.</descrip></descripGrp><ntig><termGrp><term id="64659">imaging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502900">обрада слике</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14155_233476_609638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of artificially delaying server responses for specific SMTP communication patterns that indicate high volumes of spam or other unwelcome email messages. The intent is to slow down the communication process for such email traffic so that the cost of sending spam increases for the person or organization who is sending the email.</descrip></descripGrp><ntig><termGrp><term id="233476">tarpitting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="609638">успоравање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14158_335536_2542066"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option, found on the Business Contact Manager menu, in the Database Tools selection, that enables the user to share all information in a database.</descrip></descripGrp><ntig><termGrp><term id="335536">Share Database</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542066">Дељење базе података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14165_232496_2373015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transaction that can be included on an invoice and charged to a customer.</descrip></descripGrp><ntig><termGrp><term id="232496">chargeable transaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2373015">трансакција за наплату</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14171_28508_2629793"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A detailed description of the processes specific customers engage in when selecting product solutions and technologies for deployment in response to business or technological challenges.</descrip></descripGrp><ntig><termGrp><term id="28508">case study</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2629793">студија случаја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14178_1511499_2208909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of text entered by a user that is displayed to contacts.</descrip></descripGrp><ntig><termGrp><term id="1511499">personal note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2208909">напомена</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14178_1511499_2767120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of text entered by a user that is displayed to contacts.</descrip></descripGrp><ntig><termGrp><term id="1511499">personal note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2767120">лична напомена</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14178_502941_2208909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of text entered by a user that is displayed to contacts.</descrip></descripGrp><ntig><termGrp><term id="502941">note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2208909">напомена</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14178_502941_2767120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of text entered by a user that is displayed to contacts.</descrip></descripGrp><ntig><termGrp><term id="502941">note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2767120">лична напомена</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14189_233405_1504269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The list or table that's used to create a PivotTable or PivotChart report. Source data can be taken from an Excel list or range, an external database or cube, or another PivotTable report.</descrip></descripGrp><ntig><termGrp><term id="233405">source data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504269">изворни подаци</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14194_45889_1504270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a digital signature to a macro or file.</descrip></descripGrp><ntig><termGrp><term id="45889">digitally sign</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504270">дигитално потписати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14195_67346_1504271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A peripheral device whose purpose is to allow the user to provide input to a computer system. Examples of input devices are keyboards, mice, joysticks, and styluses.</descrip></descripGrp><ntig><termGrp><term id="67346">input device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504271">улазни уређај</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14199_12503_1985806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A non-validated user who is not recognized by the server, and who can only access published folders and address lists.</descrip></descripGrp><ntig><termGrp><term id="12503">anonymous user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1985806">анонимни корисник</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14200_117651_1504272"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One character (or more) that is slightly higher than other text on a line, such as a footnote reference mark.</descrip></descripGrp><ntig><termGrp><term id="117651">superscript</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504272">суперскрипт</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14200_117651_2527446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One character (or more) that is slightly higher than other text on a line, such as a footnote reference mark.</descrip></descripGrp><ntig><termGrp><term id="117651">superscript</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527446">експонентни текст</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14205_397185_406547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The X.400 term for a messaging system, which is a product that enables electronic communication over a network.</descrip></descripGrp><ntig><termGrp><term id="397185">message transfer system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406547">MTS</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14205_397185_406548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The X.400 term for a messaging system, which is a product that enables electronic communication over a network.</descrip></descripGrp><ntig><termGrp><term id="397185">message transfer system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406548">систем за пренос порука</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14205_397186_406547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The X.400 term for a messaging system, which is a product that enables electronic communication over a network.</descrip></descripGrp><ntig><termGrp><term id="397186">MTS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406547">MTS</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14205_397186_406548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The X.400 term for a messaging system, which is a product that enables electronic communication over a network.</descrip></descripGrp><ntig><termGrp><term id="397186">MTS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406548">систем за пренос порука</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1421_145137_2541800"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network type that a computer is connected to that automatically sets the appropriate firewall settings for the location.</descrip></descripGrp><ntig><termGrp><term id="145137">network location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541800">мрежна локација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14210_2307008_2772242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of reducing the probability and/or impact of a risk to an acceptable level.</descrip></descripGrp><ntig><termGrp><term id="2307008">mitigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2772242">смањење ризика</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14210_252102_2772242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of reducing the probability and/or impact of a risk to an acceptable level.</descrip></descripGrp><ntig><termGrp><term id="252102">risk mitigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2772242">смањење ризика</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14211_213519_2638199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An order for a SKU that is currently not available for delivery.</descrip></descripGrp><ntig><termGrp><term id="213519">pre-order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2638199">претпоруџбина</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14216_397178_406528"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of recipients that are created to expedite the mass emailing of messages and other information. When email is sent to a mail-enabled universal distribution group, all members of that list receive a copy of the message. Mail-enabled universal distribution groups cannot be used to assign permissions.</descrip></descripGrp><ntig><termGrp><term id="397178">mail-enabled universal distribution group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406528">поштанска универзална група за дистрибуцију</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14219_310257_1504273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows technology that protects OS resources (files, folders registry keys) and prevents applications and administrators from making changes to a computer's resources in an arbitrary way.</descrip></descripGrp><ntig><termGrp><term id="310257">System Protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504273">заштита система</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14232_231970_1916816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that provides interactive analysis of data, like a PivotTable report. You can change views of data, see different levels of detail, or reorganize the chart layout by dragging fields and by showing or hiding items in fields.</descrip></descripGrp><ntig><termGrp><term id="231970">PivotChart report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916816">PivotChart извјештај</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14232_231970_2529531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that provides interactive analysis of data, like a PivotTable report. You can change views of data, see different levels of detail, or reorganize the chart layout by dragging fields and by showing or hiding items in fields.</descrip></descripGrp><ntig><termGrp><term id="231970">PivotChart report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2529531">извештај изведеног графикона</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14233_180154_2541933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person who created the database, and has full control, including granting access permissions or deleting records. When a database has been restored, then the person who restored it becomes the owner.</descrip></descripGrp><ntig><termGrp><term id="180154">database owner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541933">власник базе података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14237_169312_2776814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database that functions as a backup of a primary database, receiving copies of every change to the primary database, and that can take over traffic if the primary database becomes unavailable.</descrip></descripGrp><ntig><termGrp><term id="169312">mirror database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2776814">пресликана база података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14238_2822_1504274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A memory measurement unit that is equal to 1 million bytes.</descrip></descripGrp><ntig><termGrp><term id="2822">MB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504274">MB</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14238_2822_1504275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A memory measurement unit that is equal to 1 million bytes.</descrip></descripGrp><ntig><termGrp><term id="2822">MB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504275">мегабајт</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14238_2823_1504274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A memory measurement unit that is equal to 1 million bytes.</descrip></descripGrp><ntig><termGrp><term id="2823">megabyte</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504274">MB</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14238_2823_1504275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A memory measurement unit that is equal to 1 million bytes.</descrip></descripGrp><ntig><termGrp><term id="2823">megabyte</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504275">мегабајт</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1424_61809_1131266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To emphasize displayed characters, as by displaying them in reverse video (light on dark rather than dark on light, and vice versa) or against a colored background.</descrip></descripGrp><ntig><termGrp><term id="61809">highlight</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1131266">маркирати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1424_61809_1502901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To emphasize displayed characters, as by displaying them in reverse video (light on dark rather than dark on light, and vice versa) or against a colored background.</descrip></descripGrp><ntig><termGrp><term id="61809">highlight</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502901">истакнути</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14241_45676_1504276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computing, a characteristic of data that is represented as binary digits (zeros and ones).</descrip></descripGrp><ntig><termGrp><term id="45676">digital</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504276">дигитално</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14244_115576_406599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a transmission appear to come from a user other than the user who performed the action.</descrip></descripGrp><ntig><termGrp><term id="115576">spoof</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406599">преварити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14246_343618_1504277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagramming capability that shows charts in three dimensions.</descrip></descripGrp><ntig><termGrp><term id="343618">3-D effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504277">3-D ефекaт</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14246_343618_2527751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagramming capability that shows charts in three dimensions.</descrip></descripGrp><ntig><termGrp><term id="343618">3-D effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527751">3-D ефекат</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14256_72076_1504278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To adjust horizontal spacing so that text is aligned evenly along both the left and right margins. Justifying text creates a smooth edge on both sides.</descrip></descripGrp><ntig><termGrp><term id="72076">justify</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504278">поравнати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14261_343632_2527753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The colors that are specific to a particular company or product.</descrip></descripGrp><ntig><termGrp><term id="343632">brand colors</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527753">боје бренда</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14263_136894_1523507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The required information provided in order to authorize access to the enterprise application.</descrip></descripGrp><ntig><termGrp><term id="136894">account information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523507">информације о налогу</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14264_95799_2541531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The nonsecret half of a cryptographic key pair that is used with a public key algorithm. Public keys are typically used when encrypting a session key, verifying a digital signature, or encrypting data that can be decrypted with the corresponding private key.</descrip></descripGrp><ntig><termGrp><term id="95799">public key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541531">јавни кључ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14269_49251_1504279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A change made to content, such as a file, document, or post.</descrip></descripGrp><ntig><termGrp><term id="49251">edit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504279">уређивање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14280_231981_1916826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that saves display information about open workbooks, so that you can later resume work with the same window sizes, print areas, screen magnification, and display settings.</descrip></descripGrp><ntig><termGrp><term id="231981">workspace file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916826">фајл радног простора</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14280_231981_2527654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that saves display information about open workbooks, so that you can later resume work with the same window sizes, print areas, screen magnification, and display settings.</descrip></descripGrp><ntig><termGrp><term id="231981">workspace file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527654">датотека радног простора</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14289_251895_2209017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request to an Internet site that asks for content to be retrieved.</descrip></descripGrp><ntig><termGrp><term id="251895">HTTP request</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singu