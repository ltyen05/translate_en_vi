>Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504344">поље за претраживање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14856_370913_1796420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a cascading style sheet style definition (or style rule), the HTML element linked to a particular set of style properties and values.</descrip></descripGrp><ntig><termGrp><term id="370913">selector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1796420">бирач</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14857_144518_2527547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that represents commonly used information, such as "First Name." If a data source contains a "First Name" field or variation, such as "FName," the data source field automatically maps to the corresponding mapped data field.</descrip></descripGrp><ntig><termGrp><term id="144518">mapped data field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527547">мапирано поље података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14866_396930_406473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distribution group that uses recipient filters and conditions to derive its membership at the time the message is sent.</descrip></descripGrp><ntig><termGrp><term id="396930">dynamic distribution group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406473">динамичка група за дистрибуцију</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14871_397149_406508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Exchange Server 2007 and 2010 server role that provides anti-spam and antivirus protection and applies messaging security policies to messages in transport between organizations by using a series of agents that act on messages as they are processed by the message transport components. This server role is deployed in the perimeter network outside the Active Directory directory service forest. Computers that have the Edge Transport server role installed handle all Internet-facing mail flow and provide Simple Mail Transfer Protocol (SMTP) relay and smart host services for the Exchange organization.</descrip></descripGrp><ntig><termGrp><term id="397149">Edge Transport server role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406508">улога сервера „Рубни пренос“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14874_287209_2732458"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of Internet protocol that does not contain any link-layer header before it.</descrip></descripGrp><ntig><termGrp><term id="287209">raw IP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2732458">raw IP</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14874_287210_2732458"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of Internet protocol that does not contain any link-layer header before it.</descrip></descripGrp><ntig><termGrp><term id="287210">low-level IP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2732458">raw IP</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14879_137887_2541735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The extent to which a picture runs off the printed page.</descrip></descripGrp><ntig><termGrp><term id="137887">bleed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541735">прекорачење маргине</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14881_1507602_1523505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An alphanumeric convention for referencing the location of cells in a worksheet. The column is represented by a letter (A through IV, for a total of 256 columns) and the row is represented by a number (1 through 65536).</descrip></descripGrp><ntig><termGrp><term id="1507602">A1</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523505">A1</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14881_461707_1523505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An alphanumeric convention for referencing the location of cells in a worksheet. The column is represented by a letter (A through IV, for a total of 256 columns) and the row is represented by a number (1 through 65536).</descrip></descripGrp><ntig><termGrp><term id="461707">A1 notation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523505">A1</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14881_461708_1523505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An alphanumeric convention for referencing the location of cells in a worksheet. The column is represented by a letter (A through IV, for a total of 256 columns) and the row is represented by a number (1 through 65536).</descrip></descripGrp><ntig><termGrp><term id="461708">A1 reference style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523505">A1</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14885_397156_406577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Exchange 2007 graphical user interface (GUI) from which administrators can perform tasks to configure and manage Exchange servers. The Exchange Management Console is based on Windows Microsoft Management Console (MMC) 3.0.</descrip></descripGrp><ntig><termGrp><term id="397156">Exchange Management Console</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406577">Exchange Management Console</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14886_321129_1504345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that helps improve the recognition of a user's touch flicks by a process in which the user's touch flicks are analyzed.</descrip></descripGrp><ntig><termGrp><term id="321129">touch training</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504345">Подешавање интерфејса осјетљивог на додир</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14888_125490_1504346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An address that uniquely identifies a location on the Internet. A URL is usually preceded by http://, as in http://www.microsoft.com. A URL can contain more detail, such as the name of a page of hypertext, often with the file name extension .html or .htm.</descrip></descripGrp><ntig><termGrp><term id="125490">Uniform Resource Locator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504346">URL</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14888_125490_1523772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An address that uniquely identifies a location on the Internet. A URL is usually preceded by http://, as in http://www.microsoft.com. A URL can contain more detail, such as the name of a page of hypertext, often with the file name extension .html or .htm.</descrip></descripGrp><ntig><termGrp><term id="125490">Uniform Resource Locator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523772">URL адреса</term><termNote type="geographicalUsa