">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2209059">токен</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10154_2592099_2209059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cryptographically signed data unit that transfers authentication and authorization information, based on a credential.</descrip></descripGrp><ntig><termGrp><term id="2592099">auth token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2209059">токен</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10161_17417_2411904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To grant a person, computer process, or device access to certain information, services or functionality.</descrip></descripGrp><ntig><termGrp><term id="17417">authorize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2411904">овластити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10179_143328_1916703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar marked off in units of measure (such as inches) that is displayed across the top of the document window.</descrip></descripGrp><ntig><termGrp><term id="143328">horizontal ruler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916703">хоризонтални линијар</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10179_143328_2527535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar marked off in units of measure (such as inches) that is displayed across the top of the document window.</descrip></descripGrp><ntig><termGrp><term id="143328">horizontal ruler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527535">хоризонтални лењир</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1018_32207_1502846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To press and release a mouse button once without moving the mouse, usually to select or deselect an item or to activate a program or program feature.</descrip></descripGrp><ntig><termGrp><term id="32207">click</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502846">кликнути</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="part