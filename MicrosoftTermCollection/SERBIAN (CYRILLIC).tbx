:lang="en-US"><descripGrp><descrip type="definition">A server-side component that encapsulates user interface and related functionality.</descrip></descripGrp><ntig><termGrp><term id="1507082">Web control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523784">веб контрола</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29303_1507083_1523785"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual comment that is added within a Web discussion.</descrip></descripGrp><ntig><termGrp><term id="1507083">Web discussion comment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523785">коментар у веб дискусији</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29305_1507086_1523787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An element in a Web Parts page that defines a provider-consumer data relationship between two Web Parts. When a Web Parts page is rendered, data provided by one Web Part can affect how and what is rendered by the other Web Part.</descrip></descripGrp><ntig><termGrp><term id="1507086">Web Part connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523787">веза веб сегмента</