9166_2785281_2790102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The situation in which customers or subscribers stop doing business with a company.</descrip></descripGrp><ntig><termGrp><term id="2785281">customer churn</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2790102">губитак клијената</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49170_2785561_2787551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A body of proof that is to be presented in a legal proceeding to convince a judge or jury of alleged facts in a case.</descrip></descripGrp><ntig><termGrp><term id="2785561">evidence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2787551">доказ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49171_2785562_2787555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of documents that a user has grouped together as evidence in a data investigation.</descrip></descripGrp><ntig><termGrp><term id="2785562">evidence set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2787555">скуп доказа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49172_2785564_2787557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that allows users to send encrypted email messages to any recipient on the Internet and that provides admins with the ability to apply multiple custom email templates, as well as the ability to expire and revoke encrypted emails accessed through the Office 365 web portal.</descrip></descripGrp><ntig><termGrp><term id="2785564">Office 365 Advanced Message Encryption</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2787557">Office 365 напредно шифровање података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49173_2785565_2787547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An independent public authority that supervises the application and adherence of GDPR and that has investigative and corrective authority.</descrip></descripGrp><ntig><termGrp><term id="2785565">Data Protection Authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2787547">ауторитет за заштиту података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49173_2785565_2787549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An independent public authority that supervises the application and adherence of GDPR and that has investigative and corrective authority.</descrip></descripGrp><ntig><termGrp><term id="2785565">Data Protection Authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2787549">DPA</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49173_2785566_2787547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An independent public authority that supervises the application and adherence of GDPR and that has investigative and corrective authority.</descrip></descripGrp><ntig><termGrp><term id="2785566">DPA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2787547">ауторитет за заштиту података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49173_2785566_2787549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An independent public authority that supervises the application and adherence of GDPR and that has investigative and corrective authority.</descrip></descripGrp><ntig><termGrp><term id="2785566">DPA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2787549">DPA</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49174_2785592_2790099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A PowerApps app that is designed and built from a canvas in your application, without having to write any code.</descrip></descripGrp><ntig><termGrp><term id="2785592">canvas app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2790099">апликација са подлогом</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49175_2785666_2787556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of researching the cause and scope of a potential problem (e.g. case, alert, incident) and determining its severity.</descrip></descripGrp><ntig><termGrp><term id="2785666">investigation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2787556">испитивање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49176_2785667_2787550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network node that network traffic passes through to reach nodes outside of the network.</descrip></descripGrp><ntig><termGrp><term id="2785667">egress point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2787550">тачка излаза</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49177_2785668_2787546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 tool that allows admins to search for sensitive, malicious, or misplaced data across Office 365, investigate what happened, and take the appropriate actions to remediate the spillage.</descrip></descripGrp><ntig><termGrp><term id="2785668">Data Investigations (Preview)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2787546">Испитивања података (верзија за преглед)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49178_2785669_2787548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transfer of sensitive data to an unauthorized entity.</descrip></descripGrp><ntig><termGrp><term id="2785669">data spillage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2787548">расипање података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49178_2785670_2787548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transfer of sensitive data to an unauthorized entity.</descrip></descripGrp><ntig><termGrp><term id="2785670">data spill</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2787548">расипање података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49179_2785671_2787545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An investigation into a potential data spill.</descrip></descripGrp><ntig><termGrp><term id="2785671">data investigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2787545">испитивање података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4918_234579_1503319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gallery for text and graphics, such as a standard contract clause, that can be used multiple times in one or more documents. Each selection of text or graphics is recorded as an AutoText entry and assigned a unique name. It is visible in Quick Parts and the Building Blocks Organizer.</descrip></descripGrp><ntig><termGrp><term id="234579">AutoText</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503319">готов текст</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4918_234579_2527694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gallery for text and graphics, such as a standard contract clause, that can be used multiple times in one or more documents. Each selection of text or graphics is recorded as an AutoText entry and assigned a unique name. It is visible in Quick Parts and the Building Blocks Organizer.</descrip></descripGrp><ntig><termGrp><term id="234579">AutoText</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527694">аутоматски текст</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49180_2785672_2787558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Data Investigations tab where admins can add and manage the people that they identified as persons of interest during an investigation.</descrip></descripGrp><ntig><termGrp><term id="2785672">People of interest</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2787558">Релевантне особе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49181_2785680_2790125"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A PowerApps app that is designed by adding and configuring the components you need (such as dashboards, views, charts, and forms) using the app designer, without requiring any coding.</descrip></descripGrp><ntig><termGrp><term id="2785680">model-driven app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2790125">апликација заснована на моделу</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49182_2785684_2787559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Data Investigations tab where admins can create searches to find the Office 365 for data that they want to remediate.</descrip></descripGrp><ntig><termGrp><term id="2785684">Searches</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2787559">Претраге</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49183_2785727_2787552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document that potentially contains sensitive, malicious, or misplaced data and that is identified in the process of searching for such data.</descrip></descripGrp><ntig><term