</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53699_3056901_3057548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The list of publicly disclosed computer security flaws in a software, firmware, hardware, or service component resulting from a weakness that can be exploited.</descrip></descripGrp><ntig><termGrp><term id="3056901">CVE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3057548">CVE</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5371_82027_1503385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft computer operating system with a command-line interface that is used to control many internal computer functions, such as running programs and organizing and maintaining files.</descrip></descripGrp><ntig><termGrp><term id="82027">MS-DOS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503385">Microsoft Disk Operating System</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5371_82028_1503385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft computer operating system with a command-line interface that is used to control many internal computer functions, such as running programs and organizing and maintaining files.</descrip></descripGrp><ntig><termGrp><term id="82028">MS-DOS operating system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503385">Microsoft Disk Operating System</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5371_82029_1503385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft computer operating system with a command-line interface that is used to control many internal computer functions, such as running programs and organizing and maintaining files.</descrip></descripGrp><ntig><termGrp><term id="82029">Microsoft Disk Operating System</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503385">Microsoft Disk Operating System</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53713_3057907_3058811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of attack that involves sending text messages disguised as trustworthy communications from well-known businesses. The name is a combination of the words “SMS” and “phishing”.</descrip></descripGrp><ntig><termGrp><term id="3057907">smishing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3058811">smishing</term><