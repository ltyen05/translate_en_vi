ed, ensure that entered data goes to the right places.</descrip></descripGrp><ntig><termGrp><term id="1790270">dialog sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2528114">лист дијалога</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33511_1791359_1971739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables you to search for a specific message using basic information, such as the sender, recipient, date, and message ID, to obtain the status of that message.</descrip></descripGrp><ntig><termGrp><term id="1791359">Message Trace</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1971739">Праћење порука</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33513_1791361_1971736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tab within the Exchange Administration Center (EAC) that contains anti-virus/anti spam, and data loss protection.</descrip></descripGrp><ntig><termGrp><term id="1791361">Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1971736">Заштита</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">