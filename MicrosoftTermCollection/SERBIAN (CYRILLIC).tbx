ographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13180_268863_1504174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method computers use to send and receive email messages. It allows you to access email without downloading it to your computer or device.</descrip></descripGrp><ntig><termGrp><term id="268863">IMAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504174">Internet Message Access Protocol</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13180_268863_2542030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method computers use to send and receive email messages. It allows you to access email without downloading it to your computer or device.</descrip></descripGrp><ntig><termGrp><term id="268863">IMAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542030">IMAP</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13181_232398_1916829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Exchange mailbox that allocates a specific number of connections. The resource serves as a virtual room for your onli