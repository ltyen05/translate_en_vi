te><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11543_346954_1504026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The high definition optical disc format which uses a smaller focus blue-violet 405 nm laser allowing higher precision and storage density. A competitor to Blu-ray Disc.</descrip></descripGrp><ntig><termGrp><term id="346954">HD movie</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504026">HD DVD</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11543_346954_2181245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The high definition optical disc format which uses a smaller focus blue-violet 405 nm laser allowing higher precision and storage density. A competitor to Blu-ray Disc.</descrip></descripGrp><ntig><termGrp><term id="346954">HD movie</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2181245">HD</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11548_128495_2541587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video adapter that supports 640 x 480 pixels color resolution. VGA is the video display standard for boot devices under Windows operating systems and provides medium-resolution text and graphics.</descrip></descripGrp><ntig><termGrp><term id="128495">VGA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541587">VGA</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11548_128496_2541587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video adapter that supports 640 x 480 pixels color resolution. VGA is the video display standard for boot devices under Windows operating systems and provides medium-resolution text and graphics.</descrip></descripGrp><ntig><termGrp><term id="128496">video graphics adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541587">VGA</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11548_128497_2541587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video adapter that supports 640 x 480 pixels color resolution. VGA is the video display standard for boot devices under Windows operating systems and provides medium-resolution text and graphics.</descrip></descripGrp><ntig><termGrp><term id="128497">video graphics array</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541587">VGA</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11552_178997_2541925"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A linear representation of activities shown in chronological order, such as the activities that lead up to a sale.</descrip></descripGrp><ntig><termGrp><term id="178997">timeline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541925">временска оса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11554_131428_2541713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file format in which Windows stores sounds as waveforms. Such files have the extension .wav. Depending on the sampling frequency, on whether the sound is monaural or stereo, and on whether 8 or 16 bits are used for each sample, one minute of sound can occupy as little as 644 kilobytes or as much as 27 megabytes of storage.</descrip></descripGrp><ntig><termGrp><term id="131428">WAV</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541713">WAV</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11554_674771_2541713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file format in which Windows stores sounds as waveforms. Such files have the extension .wav. Depending on the sampling frequency, on whether the sound is monaural or stereo, and on whether 8 or 16 bits are used for each sample, one minute of sound can occupy as little as 644 kilobytes or as much as 27 megabytes of storage.</descrip></descripGrp><ntig><termGrp><term id="674771">WAVE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541713">WAV</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11558_181384_1985750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that displays information about an object in the interface.</descrip></descripGrp><ntig><termGrp><term id="181384">properties page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1985750">страница са својствима</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11563_109159_406452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure that contains security information associated with a protected object. Security descriptors include information about who owns the object, who can access it and in what way, and what types of access are audited.</descrip></descripGrp><ntig><termGrp><term id="109159">security descriptor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406452">опис безбедности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11564_235069_1504027"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows for ease of creating a new or expanding an existing wireless network. This setup can be done automatically using a USB flash driver or manually through a Wireless Network Setup wizard.</descrip></descripGrp><ntig><termGrp><term id="235069">Windows Connect Now</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504027">Windows Connect Now</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11567_216558_1504028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To arrange to receive a product or use a service regularly.</descrip></descripGrp><ntig><termGrp><term id="216558">subscribe</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504028">претплатити се</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11568_397198_406441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mailbox server that is installed in a Windows failover cluster. A clustered mailbox server is used in both cluster continuous replication (CCR) and single copy cluster (SCC) configurations. A clustered mailbox server was called an Exchange Virtual Server in previous versions of Exchange Server.</descrip></descripGrp><ntig><termGrp><term id="397198">clustered mailbox server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406441">сервер поштанског сандучета у кластеру</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11576_358360_361401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of components and services that enable voice, fax, and email messages to be stored in a user's single mailbox. Users can also access their Microsoft Exchange Server 2007 mailbox from a telephone or a computer.</descrip></descripGrp><ntig><termGrp><term id="358360">Unified Messaging server role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="361401">улога сервера „Обједињена размена података“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11591_431903_1796354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a record, file, or other data available in the system.</descrip></descripGrp><ntig><termGrp><term id="431903">activate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1796354">активирати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1160_30078_2712355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computers, the linking of two or more entities so that they are dependent upon one another for operation.</descrip></descripGrp><ntig><termGrp><term id="30078">chaining</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2712355">ланчано повезивање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11608_75547_1504029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that separates items in a list.</descrip></descripGrp><ntig><termGrp><term id="75547">list separator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504029">знак за раздвајање у списку</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11620_1499793_2208766"><langSet xml:lang="en-US"><descripGrp><descr