за управљање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22525_1047896_2521292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of devising and implementing a strategy for finding a solution or for transforming a less desirable condition into a more desirable one.</descrip></descripGrp><ntig><termGrp><term id="1047896">problem solving</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2521292">решавање проблема</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22536_1047907_1504723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides one-click filtering controls that make it easy to narrow down the portion of a data set that's being looked at.</descrip></descripGrp><ntig><termGrp><term id="1047907">Slicers</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504723">приказивач слојева</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22536_1047907_2528013"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides one-click filtering controls that make it easy to narrow down the portion of a data set that's being looked at.</descrip></descripGrp><ntig><termGrp><term id="1047907">Slicers</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2528013">Маказе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22541_1047912_1944763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A miniature chart that can be inserted into text or embedded within a cell on a worksheet to illustrate highs, lows, and trends in your data.</descrip></descripGrp><ntig><termGrp><term id="1047912">sparkline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1944763">мини-графикон</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22543_1047914_1504725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Outlook Calendar view in which each calendar is listed vertically (not side-by-side). This view is optimized for viewing a schedule for a group and scheduling a meeting for a group.</descrip></descripGrp><ntig><termGrp><term id="1047914">Schedule View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504725">преглед активности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22543_1047914_2542254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Outlook Calendar view in which each calendar is listed vertically (not side-by-side). This view is optimized for viewing a schedule for a group and scheduling a meeting for a group.</descrip></descripGrp><ntig><termGrp><term id="1047914">Schedule View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542254">Приказ у виду распореда</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22545_1047918_1504726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that converts each slide in a presentation into a single image and rebuilds a new, compressed PPT presentation that can easily be shared, but not edited.</descrip></descripGrp><ntig><termGrp><term id="1047918">Picture Presentation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504726">приказивање слике</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22545_1047918_2528015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that converts each slide in a presentation into a single image and rebuilds a new, compressed PPT presentation that can easily be shared, but not edited.</descrip></descripGrp><ntig><termGrp><term id="1047918">Picture Presentation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2528015">Презентација слика</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22561_1048326_1385150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A viewer that allows users to display Excel workbooks on a phone’s browser. A file is rendered as an HTML page with sufficient fidelity to convey important data or charts and illustrations.</descrip></descripGrp><ntig><termGrp><term id="1048326">Excel Mobile Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1385150">Мобилни приказивач за Excel</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22561_1048326_1954409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A viewer that allows users to display Excel workbooks on a phone’s browser. A file is rendered as an HTML page with sufficient fidelity to convey important data or charts and illustrations.</descrip></descripGrp><ntig><termGrp><term id="1048326">Excel Mobile Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1954409">Excel Mobile Viewer</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22562_1048367_1385200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A viewer that allows users to display Word documents on a phone’s browser. A file is rendered as an HTML page with sufficient fidelity to convey text and images on a small screen.</descrip></descripGrp><ntig><termGrp><term id="1048367">Word Mobile Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1385200">Мобилни приказивач за Word</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22562_1048367_1954410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A viewer that allows users to display Word documents on a phone’s browser. A file is rendered as an HTML page with sufficient fidelity to convey text and images on a small screen.</descrip></descripGrp><ntig><termGrp><term id="1048367">Word Mobile Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1954410">Word Mobile Viewer</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22564_1048412_2528016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that automates the task of positioning images and combining them with text in documents. It produces attractive, editable designs that highlight photos and accompanying text and make it easy for novices to produce compelling, high quality photo layouts.</descrip></descripGrp><ntig><termGrp><term id="1048412">SmartArt graphic Picture Layout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2528016">SmartArt графика</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22564_1048412_2528032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that automates the task of positioning images and combining them with text in documents. It produces attractive, editable designs that highlight photos and accompanying text and make it easy for novices to produce compelling, high quality photo layouts.</descrip></descripGrp><ntig><termGrp><term id="1048412">SmartArt graphic Picture Layout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2528032">Распоред слика SmartArt графике</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22564_1086975_2528016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that automates the task of positioning images and combining them with text in documents. It produces attractive, editable designs that highlight photos and accompanying text and make it easy for novices to produce compelling, high quality photo layouts.</descrip></descripGrp><ntig><termGrp><term id="1086975">SmartArt Picture Layout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2528016">SmartArt графика</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22564_1086975_2528032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that automates the task of positioning images and combining them with text in documents. It produces attractive, editable designs that highlight photos and accompanying text and make it easy for novices to produce compelling, high quality photo layouts.</descrip></descripGrp><ntig><termGrp><term id="1086975">SmartArt Picture Layout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2528032">Распоред слика SmartArt графике</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2257_183896_1502987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to compact or collapse rows when viewing several levels of data.</descrip></descripGrp><ntig><termGrp><term id="183896">compact row axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502987">оса компактног реда</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2257_183896_2527608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to compact or collapse rows when viewing several levels of data.</descrip></descripGrp><ntig><termGrp><term id="183896">compact row axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527608">оса компактних редова</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22595_1050253_1504727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Media Player (WMP) specific feature that allows you to use the Internet to access music, pictures and videos available on your home network. The feature must be activated on at least two computers in order to work.</descrip></descripGrp><ntig><termGrp><term id="1050253">remote media connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504727">веза са удаљеним медијима</term><termNo