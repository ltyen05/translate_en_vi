472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section in the service desk that displays a view of the tiles. Each tile contains the name of the queue or view and the number of records.</descrip></descripGrp><ntig><termGrp><term id="2290515">Tiles</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2339472">Плочице</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39441_2290516_2339462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section in the service desk that display a data stream from a Queue or a View.</descrip></descripGrp><ntig><termGrp><term id="2290516">Streams</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2339462">Токови</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39442_2290517_2339443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The concept of the Service Desk application in that CSRs can interact with it, and it is tailored to the service personas and the tasks that they perform.</descrip></descripGrp><ntig><termGrp><term id="2290517">interactive experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="23394