aticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54663_3103946_3104279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Security kit that includes infographics, videos, and an email to help users protect identities, devices, and data, safeguard from phishing and other scams, manage passwords efficiently and keep software up to date.</descrip></descripGrp><ntig><termGrp><term id="3103946">Be Cyber Smart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3104279">Безбедност на интернету</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54663_3103946_3104823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Security kit that includes infographics, videos, and an email to help users protect identities, devices, and data, safeguard from phishing and other scams, manage passwords efficiently and keep software up to date.</descrip></descripGrp><ntig><termGrp><term id="3103946">Be Cyber Smart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3104823">Безбједност на интернету</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54664_3103947_3104285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Jargon or popular language for the use of multiple cloud computing and storage services in a single heterogeneous architecture.</descrip></descripGrp><ntig><termGrp><term id="3103947">multicloud</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3104285">окружење са више облака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54665_3103948_3104286"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows customers to cryptographically tie tokens to the device a user originally signed in from.</descrip></descripGrp><ntig><termGrp><term id="3103948">token protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3104286">заштита токена</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54666_3104302_3104356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability that quickly captures detailed steps for each process in your organization to help you better understand the opportunities to streamline your workflows. Process advisor includes both task mining and process mining capabilities.</descrip></descripGrp><ntig><termGrp><term id="3104302">process advisor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3104356">Саветник за процесе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54667_3104366_3105553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container-like module that is used to organize the information or modules on a page by providing a collapsible drawer-like capability. An accordion module can be used on any page.</descrip></descripGrp><ntig><termGrp><term id="3104366">accordion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3105553">хармоника</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54668_3104367_3105554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Commerce module that is used to display and link to loyalty program information.</descrip></descripGrp><ntig><termGrp><term id="3104367">Account loyalty</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3105554">Лојалност пословног контакта</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54669_3104368_3105555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A module that provides product information needed to make a purchase decision and allows the user to add the items to cart.</descrip></descripGrp><ntig><termGrp><term id="3104368">buy box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3105555">оквир за куповину</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5467_375735_380326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism that helps reduce the volume of antivirus scanning that is required across an organization by stamping messages that have been scanned for viruses with metadata that indicates the version of the antivirus software that performed the scan and the result of that scan. This metadata, or "stamp," travels securely with the message as it is routed through different email servers within the organization and is used to determine whether subsequent additional virus scanning on the message can be bypassed.</descrip></descripGrp><ntig><termGrp><term id="375735">antivirus stamping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="380326">жигосање за одбрану од вируса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54670_3104369_3105556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code-free style change that overrides any Dynamics 365 Commerce module's Cascading Style Sheets (CSS).</descrip></descripGrp><ntig><termGrp><term id="3104369">CSS override</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3105556">замена CSS својства</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54671_3104370_3105558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programmatically determined marker in your published pages that allows screen-reader users to understand where they are currently located in the webpage.</descrip></descripGrp><ntig><termGrp><term id="3104370">landmark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3105558">оријентир</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54672_3104371_3105559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card that entitles the card holder to participate in the loyalty programs that are assigned to the card.</descrip></descripGrp><ntig><termGrp><term id="3104371">loyalty card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3105559">картица лојалности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54673_3104372_3105561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned systematically to a new call center channel. Because call centers are created as operating units, users can link the call center channel to various Commerce features, such as assortments, catalogs, and specific modes of delivery.</descrip></descripGrp><ntig><termGrp><term id="3104372">operating unit number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3105561">број оперативне јединице</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54673_3104372_3105563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned systematically to a new call center channel. Because call centers are created as operating units, users can link the call center channel to various Commerce features, such as assortments, catalogs, and specific modes of delivery.</descrip></descripGrp><ntig><termGrp><term id="3104372">operating unit number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3105563">OUN</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54673_3104389_3105561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned systematically to a new call center channel. Because call centers are created as operating units, users can link the call center channel to various Commerce features, such as assortments, catalogs, and specific modes of delivery.</descrip></descripGrp><ntig><termGrp><term id="3104389">OUN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3105561">број оперативне јединице</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54673_3104389_3105563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned systematically to a new call center channel. Because call centers are created as operating units, users can link the call center channel to various Commerce features, such as assortments, catalogs, and specific modes of delivery.</descrip></descripGrp><ntig><termGrp><term id="3104389">OUN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3105563">OUN</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54674_3104373_3105562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that can be created and used to quickly place repeat orders.</descrip></descripGrp><ntig><termGrp><term id="3104373">order template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3105562">предложак поруџбине</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54675_3104374_3105564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extension that facilitates communication between Commerce (and associated components) and a payment service.</descrip></descripGrp><ntig><termGrp><term id="3104374">payment connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3105564">конектор за плаћања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54676_3104375_3105565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page that provides detailed information about a product, and lets customers select product options such as a size, style, and color. A PDP should showcase all the product information that a customer requires to make a purchase decision.</descrip></descripGrp><ntig><termGrp><term id="3104375">PDP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3105565">страница са детаљима о производу</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54677_3104376_3105566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of rules that are joined by AND conditions. Users can also create multiple rule blocks that have OR conditions between them.</descrip></descripGrp><ntig><termGrp><term id="3104376">rule block</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3105566">блок правила</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54678_3104377_3105567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A profile that can be set up to manage identity management settings for site user logins.</descrip></descripGrp><ntig><termGrp><term id="3104377">site authentication profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3105567">профил за потврду идентитета на локацији</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54679_3104378_3105568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolset that enables users to build templates, select themes, and select and configure modules for a website without writing any code.</descrip></descripGrp><ntig><termGrp><term id="3104378">site builder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3105568">алатка за израду локација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54680_3104379_3105569"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A module that lets users browse across multiple sites by providing an easy way to switch between sites and select their preferred shopping site when a business has different sites across markets, regions, and locales.</descrip></descripGrp><ntig><termGrp><term id="3104379">site picker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3105569">бирач локација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54681_3104380_3105570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programming element that lets a screen reader pass over navigation elements and ads on a Web site and go directly to the desired content.</descrip></descripGrp><ntig><termGrp><term id="3104380">skip link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3105570">веза за прескакање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54682_3104381_3105571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A module that is used to add space between sections on your page to allow for different layout and design options.</descrip></descripGrp><ntig><termGrp><term id="3104381">spacer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3105571">регулатор размака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54683_3104548_3106096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The add-on service made available as a Microsoft Dataverse solution that adds the ability to replicate Dataverse data to a Microsoft Azure SQL Database store in a customer-owned Microsoft Azure subscription.</descrip></descripGrp><ntig><termGrp><term id="3104548">Data Export</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3106096">извоз података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54684_3104549_3106097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The asynchronous service that executes long-running operations independent of the main Microsoft Dataverse core operation.</descrip></descripGrp><ntig><termGrp><term id="3104549">Dynamics 365 Async Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3106097">Dynamics 365 асинхрона услуга</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54684_3104549_3106098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The asynchronous service that executes long-running operations independent of the main Microsoft Dataverse core operation.</descrip></descripGrp><ntig><termGrp><term id="3104549">Dynamics 365 Async Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3106098">Dynamics 365 услуга асинхроне обраде</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54684_3104558_3106097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The asynchronous service that executes long-running operations independent of the main Microsoft Dataverse core operation.</descrip></descripGrp><ntig><termGrp><term id="3104558">Dynamics 365 Asynchronous Processing Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3106097">Dynamics 365 асинхрона услуга</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54684_3104558_3106098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The asynchronous service that executes long-running operations independent of the main Microsoft Dataverse core operation.</descrip></descripGrp><ntig><termGrp><term id="3104558">Dynamics 365 Asynchronous Processing Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3106098">Dynamics 365 услуга асинхроне обраде</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54685_3104550_3106099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The event website that provides an online resource where people can read about your event and its speakers, create an account, register for the event, purchase passes, view their session schedule, and more.</descrip></descripGrp><ntig><termGrp><term id="3104550">Event Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3106099">портал догађаја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54686_3104551_3106100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that enables continuous replication of Common Data Service entity data to Azure Data Lake, which can then be used to run analytics, such as Power BI reporting, machine learning, data warehousing, or other downstream integration purposes. It simplifies the technical and administrative complexity of operationalizing entities for analytics and managing schema and data.</descrip></descripGrp><ntig><termGrp><term id="3104551">Export to Data Lake</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3106100">извоз у језеро података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54687_3104552_3106101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The component that is used to display the SharePoint documents in Microsoft Dynamics 365.</descrip></descripGrp><ntig><termGrp><term id="3104552">Microsoft Dynamics 365 List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3106101">Microsoft Dynamics 365 листа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54688_3104553_3106102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables professional developers to build code components that can be used across model-driven and canvas apps. Code components are reusable, metadata-driven, and solution-aware, so they can be easily packaged and moved across organizations to support multiple form factors.</descrip></descripGrp><ntig><termGrp><term id="3104553">Power Apps component framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3106102">Power Apps component framework</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54689_3104554_3106103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power BI feature that allows users to easily embed interactive Power BI content in blog posts, websites, emails, or social media. They can also easily edit, update, refresh, or stop sharing their published visuals.</descrip></descripGrp><ntig><termGrp><term id="3104554">Publish to Web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3106103">објављивање на вебу</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5469_177200_1503396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message sent to the user or administrator of a system where the recipient may be a human or an automated notification manager.</descrip></descripGrp><ntig><termGrp><term id="177200">notification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503396">обавјештење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5469_177200_2344010"><langSet xml:lang="en-US"><descripG