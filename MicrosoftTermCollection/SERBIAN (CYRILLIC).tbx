y id="39313_2281893_2282411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft technology that allows customers to protect their data by encrypting and managing access rights in document authoring, email, and publishing.</descrip></descripGrp><ntig><termGrp><term id="2281893">Active Directory Rights Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2282411">AADRM</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39313_2281893_2282412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft technology that allows customers to protect their data by encrypting and managing access rights in document authoring, email, and publishing.</descrip></descripGrp><ntig><termGrp><term id="2281893">Active Directory Rights Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2282412">Active Directory Rights Management</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39314_2281949_2710531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual element on the Social Engagement Activity map, which allows the user to draw a rectangular area on a map and see only posts in that area.</descrip></descripGrp><ntig><termGrp><term id="2281949">area filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2710531">филтер области</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39316_2281950_2710547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Settings area in Social Engagement where admins set the values that apply to all users of the solution by default.</descrip></descripGrp><ntig><termGrp><term id="2281950">Global Settings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2710547">Општа подешавања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39319_2281951_2710529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of artificial intelligence (AI) that provides computers with the ability to learn without being explicitly programmed. Adaptive learning algorithms search through data to look for patterns. )</descrip></descripGrp><ntig><termGrp><term id="2281951">adaptive learning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2710529">прилагодљиво учење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3932_92898_1503191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of media selected by a user from a gallery, library or list.</descrip></descripGrp><ntig><termGrp><term id="92898">playlist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503191">списак извођења</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3932_92898_2160425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of media selected by a user from a gallery, library or list.</descrip></descripGrp><ntig><termGrp><term id="92898">playlist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2160425">листа садржаја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39320_2281967_2710564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The source (URL) of a specific post, for example, https://twitter.com/sch4tzsucher/status/620151956514951168.</descrip></descripGrp><ntig><termGrp><term id="2281967">post URL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2710564">URL објаве</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39321_2281968_2710536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sentiment algorithm maintained by the Social Engagement team. If adaptive learning for sentiment calculation is disabled for an organization's solution, the base model annotates sentiment values to posts for the supported languages. The base model is language-specific and can be updated periodically.</descrip></descripGrp><ntig><termGrp><term id="2281968">base model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2710536">основни модел</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39322_2282722_2285195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The add-in for PowerPoint that makes it easy to author lessons with audio and video narration, real-time inking, screen recordings, quizzes and polls.</descrip></descripGrp><ntig><termGrp><term id="2282722">Office Mix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2285195">Office Mix</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39323_2282723_2285194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Content produced by Office Mix.</descrip></descripGrp><ntig><termGrp><term id="2282723">mix</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2285194">микс</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39323_2282723_2289645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Content produced by Office Mix.</descrip></descripGrp><ntig><termGrp><term id="2282723">mix</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2289645">садржај додатка Office Mix</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39324_2282726_2285196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Office Mobile that runs on Windows.</descrip></descripGrp><ntig><termGrp><term id="2282726">Office Mobile for Windows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2285196">Office Mobile за Windows</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39327_2283118_2755429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrator role that can read and manage compliance configuration and reports in Azure Active Directory and Office 365.</descrip></descripGrp><ntig><termGrp><term id="2283118">Compliance administrator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2755429">Администратор усаглашености</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39330_2283616_2284904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The plug-in that delivers additional functionality to the Photos app on Windows devices.</descrip></descripGrp><ntig><termGrp><term id="2283616">Microsoft Photos Plug-in</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2284904">Додатна компонента за Microsoft фотографије</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39330_2283616_2286035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The plug-in that delivers additional functionality to the Photos app on Windows devices.</descrip></descripGrp><ntig><termGrp><term id="2283616">Microsoft Photos Plug-in</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><term