pGrp><ntig><termGrp><term id="773435">full crawl</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523604">потпуно пописивање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14541_773435_1523605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A crawl that scans a content source in its entirety and refreshes the index to reflect new, changed or deleted content, as well as existing, unchanged content.</descrip></descripGrp><ntig><termGrp><term id="773435">full crawl</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523605">потпуно ажурирање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14543_231973_1916819"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Office Web Component that allows you to create a structure similar to an Excel PivotTable report. Users can view the PivotTable list in a Web browser and change its layout in a manner similar to an Excel PivotTable report.</descrip></descripGrp><ntig><termGrp><term id="231973">PivotTable list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916819">PivotTable списак</term><termNote type="geographicalUsage">SRB, BIH</termN