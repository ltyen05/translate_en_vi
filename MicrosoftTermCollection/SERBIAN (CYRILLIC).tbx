id="2926576">screen share scanner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2926876">скенер за дијељење екрана</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51981_2926576_2926877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to convert the image to text with screenshare during a Microsoft Teams meeting (the ability for meeting attendees to digitize and interact with text and URLs on the Teams meeting stage).</descrip></descripGrp><ntig><termGrp><term id="2926576">screen share scanner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2926877">скенер за дељење екрана</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51982_2926577_2926878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Teams service that simplifies the communications services acquisition and adoption process for business customers, providing the option to provision/deprovision phone numbers and (eventually) acquire/obtain capabilities from certified Carriers, all through the Teams Admin Center.</descrip></descripGrp><ntig><termGrp><term id="2926577">Operator Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="s