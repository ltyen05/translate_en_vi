ammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="706952">жељене поставке комуникације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19341_652981_706954"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a video to a blog entry by entering the embed code for the video.</descrip></descripGrp><ntig><termGrp><term id="652981">embed a video</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="706954">уградити видео запис</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19342_652982_706955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of HTML code that adds an object, such as a video, to an HTML page.</descrip></descripGrp><ntig><termGrp><term id="652982">embed code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="706955">код за уградњу</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19343_652983_706956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI element that links to a text box where the user can enter the e