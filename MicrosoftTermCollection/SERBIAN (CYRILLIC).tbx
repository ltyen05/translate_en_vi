term id="2918506">Уређивач аватара</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46540_2619582_2920652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox Live feature allowing the user to create and customize their avatars as well as purchase new avatar items like clothes, accessories and more.</descrip></descripGrp><ntig><termGrp><term id="2619582">Xbox Avatar Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920652">Xbox уређивач аватара</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46540_2619583_2918506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox Live feature allowing the user to create and customize their avatars as well as purchase new avatar items like clothes, accessories and more.</descrip></descripGrp><ntig><termGrp><term id="2619583">Avatar Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918506">Уређивач аватара</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46540_2619583_2920652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox Live feature allowing the user to create and customize their avatars as well as purchase new avatar items like clothes, accessories and more.</descrip></descripGrp><ntig><termGrp><term id="2619583">Avatar Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920652">Xbox уређивач аватара</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46542_2619590_2918554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The auto chat moderation tool in Mixer that looks at the context of messages people are sending and “snipes” content the user finds inappropriate before it hits their channel. Users can preview messages removed, and report inaccuracies.</descrip></descripGrp><ntig><termGrp><term id="2619590">Catbot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918554">Catbot</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46550_2619604_2645125"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-release version of an offering for select customers instead of all customers.</descrip></descripGrp><ntig><termGrp><term id="2619604">private preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2645125">приватно прелиминарно издање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46554_2671644_2673147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that analyzes clients' usage, provides recommendations on how to configure features in a way that reduces the attack surface without interrupting critical workflows, and that provides supporting data on feature usage and security risk.</descrip></descripGrp><ntig><termGrp><term id="2671644">Security Policy Advisor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2673147">Саветник за безбедносне смернице</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46554_2671644_2767026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that analyzes clients' usage, provides recommendations on how to configure features in a way that reduces the attack surface without interrupting critical workflows, and that provides supporting data on feature usage and security risk.</descrip></descripGrp><ntig><termGrp><term id="2671644">Security Policy Advisor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2767026">SPA</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammati