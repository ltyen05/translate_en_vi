roperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3134378">PharmacyChecker</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26773_1355136_3134379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trusted industry standard in online pharmacy verification. Established in 2003, the PharmacyChecker Verification Program helps protect consumers by ensuring that the prescription drugs they order come from qualified online pharmacies.</descrip></descripGrp><ntig><termGrp><term id="1355136">PharmacyChecker</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3134379">PharmacyChecker</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26782_1355242_2785226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A primary SharePoint Server management plan that identifies what is considered a record, what category the record belong to, where the records are stored, record retention period, and who manages the record.</descrip></descripGrp><ntig><termGrp><term id="1355242">file plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2785226">план датотека</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26784_1355244_1917196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of formatting options (Quick Styles) that are designed to be used together.</descrip></descripGrp><ntig><termGrp><term id="1355244">Quick Style set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917196">Скуп брзих стилова</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26786_1355342_2074058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove the ability of a network object to access server resources.</descrip></descripGrp><ntig><termGrp><term id="1355342">deactivate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2074058">деактивирати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26786_2283119_2074058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove the ability of a network object to access server resources.</descrip></descripGrp><ntig><termGrp><term id="2283119">unelevate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:la