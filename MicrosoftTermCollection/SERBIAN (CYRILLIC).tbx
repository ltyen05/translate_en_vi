3_74069_2525273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of outer join in which all rows from the left-most table in the JOIN clause are included. When rows in the left table are not matched by rows in the right table, all result set columns that come from the right table are assigned a value of NULL.</descrip></descripGrp><ntig><termGrp><term id="74069">left outer join</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2525273">лево спољно</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1446_46257_1502903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object in a filesystem that contains files and other directories.</descrip></descripGrp><ntig><termGrp><term id="46257">directory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502903">директориј</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1446_46257_2172574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object in a filesystem that contains files and other directories.</descrip></descripGrp><ntig><termGrp><term id="46257">directory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2172574">директоријум</term><t