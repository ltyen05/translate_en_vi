oun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2315658">бочни навигатор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39594_2306413_2315599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A smaller version of a calendar.</descrip></descripGrp><ntig><termGrp><term id="2306413">mini calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2315599">мини-календар</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39599_2306886_2513083"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A parallel version of a repository contained within the repository, but not affecting the primary (live) version, thus allowing developers to work freely without disrupting the live version.</descrip></descripGrp><ntig><termGrp><term id="2306886">branch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2513083">грана</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39618_2306966_2638197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual indication to inform the user of recent events.</descrip></descripGrp><ntig><termGrp><term id="2306966">user notification badge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2638197">беџ обавештења</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39618_2635506_2638197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual indication to inform the user of recent events.</descrip></descripGrp><ntig><termGrp><term id="2635506">notification badge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2638197">беџ обавештења</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39619_2307116_2311502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online meeting for Skype for Business, the professional meetings and communications app formerly known as Lync. Skype Meetings enable participants to use audio, video, IM, screen sharing and other features</descrip></descripGrp><ntig><termGrp><term id="2307116">Skype Meeting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2311502">Skype састанак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3962_3044409_1503197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog that requires the user to take some action before the focus can switch to another form or dialog box. Dialog boxes and messages are usually modal.</descrip></descripGrp><ntig><termGrp><term id="3044409">modal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503197">модални дијалог</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3962_81228_1503197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog that requires the user to take some action before the focus can switch to another form or dialog box. Dialog boxes and messages are usually modal.</descrip></descripGrp><ntig><termGrp><term id="81228">modal dialog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503197">модални дијалог</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3966_294271_2542035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal request to hire an employee to fill a specific position within the organization.</descrip></descripGrp><ntig><termGrp><term id="294271">hiring requisition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542035">захтев за запослење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3967_93870_1503198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To submit content to an online forum for others to see.</descrip></descripGrp><ntig><termGrp><term id="93870">post</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503198">послати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39686_2307925_2468687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cross-disciplinary software development practice where operations and development engineers participate jointly in the complete service life cycle, from design through the development process to production support. Communication, collaboration, integration, automation, and measurement cooperation between developers and other information-technology (IT) professionals is encouraged and expected.</descrip></descripGrp><ntig><termGrp><term id="2307925">DevOps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2468687">DevOps</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39692_2308052_2309486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark or piece of information that you can add to a map, save, and share with others.</descrip></descripGrp><ntig><termGrp><term id="2308052">note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2309486">белешка мапе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39692_2308052_2309487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark or piece of information that you can add to a map, save, and share with others.</descrip></descripGrp><ntig><termGrp><term id="2308052">note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2309487">белешка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39692_2308052_2309490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark or piece of information that you can add to a map, save, and share with others.</descrip></descripGrp><ntig><termGrp><term id="2308052">note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-C