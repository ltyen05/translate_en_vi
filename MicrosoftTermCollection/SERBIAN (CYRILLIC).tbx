etermines the default font for the Normal cell style.</descrip></descripGrp><ntig><termGrp><term id="652187">standard font</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504536">стандардни фонт</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19218_652190_2542133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snapshot of information, often from another document or program, that is not linked to the document or program in which the information was created.</descrip></descripGrp><ntig><termGrp><term id="652190">static picture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542133">статична слика</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19219_652191_1504537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A date that you set [rather than the current date] for reporting the time, cost, or performance condition of a project.</descrip></descripGrp><ntig><termGrp><term id="652191">status date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504537">датум статуса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19221_652193_1504538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A description of the status of a member's project work and related work.</descrip></descripGrp><ntig><termGrp><term id="652193">status report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504538">извјештај о стању</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19221_652193_2542134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A description of the status of a member's project work and related work.</descrip></descripGrp><ntig><termGrp><term id="652193">status report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542134">извештај о статусу</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19223_652195_2542135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of an operator to determine whether one string is greater than or equal to another string. Use the Option Compare statement to specify binary (case sensitive) or text (non-case sensitive) comparison.</descrip></descripGrp><ntig><termGrp><term id="652195">string comparison</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542135">поређење ниски</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19229_652201_1504539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task that is made up of subtasks and summarizes those subtasks. Use outlining to create summary tasks. Project automatically determines summary task information [such as duration and cost] by using information from the subtasks.</descrip></descripGrp><ntig><termGrp><term id="652201">summary task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504539">резиме задатка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19231_652203_1523753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of a sample of data or opinions, considered to be representative of a whole.</descrip></descripGrp><ntig><termGrp><term id="652203">survey</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523753">анкета</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19232_652204_1504540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An horizontal or vertical line that divides a diagram into partitions and which is used to arrange related parts of a process.</descrip></descripGrp><ntig><termGrp><term id="652204">swimlane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504540">плутајућа трака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19234_652206_1796427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any application or process that you want to model. Examples of systems include a computer game, a process for assembling microchips, and a library information system.</descrip></descripGrp><ntig><termGrp><term id="652206">system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1796427">систем</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19245_652217_2542136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customizable Web site with features that help a team work together. The default site has pages for document libraries, announcements, and team events. Only members, specified by the site creator, can use the site.</descrip></descripGrp><ntig><termGrp><term id="652217">team Web site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542136">веб сајт за тимски рад</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19250_652222_1916999"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of a set of major and minor fonts that is applied to a file. Theme fonts, theme colors, and theme effects compose a theme.</descrip></descripGrp><ntig><termGrp><term id="652222">theme font</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916999">тематски фонт</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19250_652222_2527858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of a set of major and minor fonts that is applied to a file. Theme fonts, theme colors, and theme effects compose a theme.</descrip></descripGrp><ntig><termGrp><term id="652222">theme font</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527858">фонт теме</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19251_652223_1917000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of pane that presents the current scanned document as one or more small images.</descrip></descripGrp><ntig><termGrp><term id="652223">thumbnail pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917000">окно с минијатурама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19251_652223_2527859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of pane that presents the current scanned document as one or more small images.</descrip></descripGrp><ntig><termGrp><term id="652223">thumbnail pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527859">окно са сличицама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19254_652226_2527860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time period indicator at the top of the Gantt views, the Resource Graph view, the Task Usage view, and the Resource Usage view. You can customize it to show up to three tiers that can display various time units: top, middle, and bottom.</descrip></descripGrp><ntig><termGrp><term id="652226">timescale</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527860">временска скала</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19257_652229_1523764"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default, top-level site provided by a Web server or virtual server. To gain access to the top-level Web site, you supply the URL of the server without specifying a page name or subsite.</descrip></descripGrp><ntig><termGrp><term id="652229">top-level Web site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523764">Веб локација највишег нивоа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19257_652229_2296905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default, top-level site provided by a Web server or virtual server. To gain access to the top-level Web site, you supply the URL of the server without specifying a page name or subsite.</descrip></descripGrp><ntig><termGrp><term id="652229">top-level Web site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2296905">веб сајт највишег нивоа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19258_652230_1917001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special row in a list or table that provides a selection of aggregate functions useful for working with numerical data.</descrip></descripGrp><ntig><termGrp><term id="652230">total row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917001">ред збира</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19258_652230_2527861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special row in a list or table that provides a selection of aggregate functions useful for working with numerical data.</descrip></descripGrp><ntig><termGrp><term id="652230">total row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527861">ред са збиром</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19258_760167_1917001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special row in a list or table that provides a selection of aggregate functions useful for working with numerical data.</descrip></descripGrp><ntig><termGrp><term id="760167">totals row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917001">ред збира</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19258_760167_2527861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special row in a list or table that provides a selection of aggregate functions useful for working with numerical data.</descrip></descripGrp><ntig><termGrp><term id="760167">totals row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527861">ред са збиром</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19261_652233_1917002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An arrow that shows the relationship between the active cell and its related cells. Tracer arrows are blue when pointing from a cell that provides data to another cell, and red if a cell contains an error value, such as #DIV/0!.</descrip></descripGrp><ntig><termGrp><term id="652233">tracer arrow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917002">стрелица праћења</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19261_652233_2527862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An arrow that shows the relationship between the active cell and its related cells. Tracer arrows are blue when pointing from a cell that provides data to another cell, and red if a cell contains an error value, such as #DIV/0!.</descrip></descripGrp><ntig><termGrp><term id="652233">tracer arrow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527862">стрелица за праћење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19264_652236_1917003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Optional text for a trendline, including either the regression equation or the R-squared value, or both. A trendline label can be formatted and moved; it cannot be sized.</descrip></descripGrp><ntig><termGrp><term id="652236">trendline label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917003">ознака линије тренда</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19264_652236_2527863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Optional text for a trendline, including either the regression equation or the R-squared value, or both. A trendline label can be formatted and moved; it cannot be sized.</descrip></descripGrp><ntig><termGrp><term id="652236">trendline label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527863">ознака на линији тренда</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19265_652237_1504542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder or file path on your computer or a location on your intranet from which it is safe to run code. Default trusted locations include the Templates, Addins, and Startup folders, and you can specify your own trusted locations.</descrip></descripGrp><ntig><termGrp><term id="652237">trusted location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504542">безбједна локација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19265_652237_1523765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder or file path on your computer or a location on your intranet from which it is safe to run code. Default trusted locations include the Templates, Addins, and Startup folders, and you can specify your own trusted locations.</descrip></descripGrp><ntig><termGrp><term id="652237">trusted location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523765">поуздана локација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19266_652238_1917004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of software publisher certificates used to digitally sign code, such as macros. Because you explicitly trust the software publishers, their code is allowed to run on your computer without needing to prompt for permission.</descrip></descripGrp><ntig><termGrp><term id="652238">trusted publisher store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917004">складиште поузданих издавача</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19268_652240_1523768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A permission setting for using a list, library, or site that is different from the permission settings of its parent site.</descrip></descripGrp><ntig><termGrp><term id="652240">unique permission</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523768">јединствена дозвола</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19271_652243_1504543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The percentage of a work resource’s time that is assigned to a task.</descrip></descripGrp><ntig><termGrp><term id="652243">unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504543">јединице</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19271_652243_2406107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The percentage of a work resource’s time that is assigned to a task.</descrip></descripGrp><ntig><termGrp><term id="652243">unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2406107">јединица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19273_652245_1917005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In line charts with multiple data series, bars that indicate the difference between data points in the first and last series.</descrip></descripGrp><ntig><termGrp><term id="652245">up-down bars</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917005">растуће/опадајуће стрелице</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19273_652245_2527864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In line c