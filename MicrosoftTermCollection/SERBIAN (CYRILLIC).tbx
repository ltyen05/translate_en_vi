65_3050629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of blocking external tenants from establishing connections into your tenant (inbound isolation) as well as blocking your tenant from establishing connections to external tenants (outbound isolation).</descrip></descripGrp><ntig><termGrp><term id="3049265">tenant isolation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3050629">изолација закупца</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53575_3049266_3050630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The prebuilt AI model that extracts all text in photos and PDF documents.</descrip></descripGrp><ntig><termGrp><term id="3049266">Text recognition</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3050630">Препознавање текста</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53576_3049267_3050631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Power Platform environment that supports short-term testing needs and is automatically cleaned up after a short period of time.</descrip></descripGrp><ntig><termGrp><term id="3049267">trial environment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xm