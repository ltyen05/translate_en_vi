><descripGrp><descrip type="definition">An image editing feature that allows a user to isolate the foreground portion of an image and make the background transparent.</descrip></descripGrp><ntig><termGrp><term id="767148">Background Removal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527908">Уклањање позадине</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21203_767149_1944736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that removes narrations and laser pointer gestures or timings from a presentation or from a specific slide.</descrip></descripGrp><ntig><termGrp><term id="767149">Clear Recordings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1944736">Избрисати снимљено</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21203_767149_2527909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that removes narrations and laser pointer gestures or timings from a presentation or from a specific slide.</descrip></descripGrp><ntig><termGrp><term id="767149">Clear Recordings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527909">Очисти с