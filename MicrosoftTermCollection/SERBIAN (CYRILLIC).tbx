p><descrip type="definition">A set of telephone extensions that are organized into a group, over which the Private Branch eXchange (PBX) "hunts" to find an available extension. A hunt group is used to direct calls to identically-capable endpoints or to an application, such as voice mail.</descrip></descripGrp><ntig><termGrp><term id="233478">hunt group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="609633">циљана група</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3012_306435_1985616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Technology that allows machines to recognize and respond to human voice commands.</descrip></descripGrp><ntig><termGrp><term id="306435">Automatic Speech Recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1985616">Аутоматско препознавање говора</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3012_306435_406519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Technology that allows machines to recognize and respond to human voice commands.</descrip></descripGrp><ntig><termGrp><term id="306435">Automatic Speech Recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="40