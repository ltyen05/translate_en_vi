><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14919_335541_2542071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button, found on the Report toolbar, that enables the user to customize a report.</descrip></descripGrp><ntig><termGrp><term id="335541">Modify Report</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542071">Измени извештај</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14922_397187_406468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snapshot of information from an address book that has been downloaded so that an Outlook user can access it while disconnected from the server. It contains the properties of a user, such as email addresses, that Outlook requires to send an email message and display information about the sender.</descrip></descripGrp><ntig><termGrp><term id="397187">offline address book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406468">ванмрежни адресар</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14922_397187_406469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snapshot of information from an address book that has been downloaded so that an Outlook user can access it while disconnected from the server. It contains the properties of a user, such as email addresses, that Outlook requires to send an email message and display information about the sender.</descrip></descripGrp><ntig><termGrp><term id="397187">offline address book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406469">OAB</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14922_397188_406468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snapshot of information from an address book that has been downloaded so that an Outlook user can access it while disconnected from the server. It contains the properties of a user, such as email addresses, that Outlook requires to send an email message and display information about the sender.</descrip></descripGrp><ntig><termGrp><term id="397188">OAB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406468">ванмрежни адресар</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14922_397188_406469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snapshot of information from an address book that has been downloaded so that an Outlook user can access it while disconnected from the server. It contains the properties of a user, such as email addresses, that Outlook requires to send an email message and display information about the sender.</descrip></descripGrp><ntig><termGrp><term id="397188">OAB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406469">OAB</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14924_149902_1944766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that retrieves data stored on your intranet or the Internet.</descrip></descripGrp><ntig><termGrp><term id="149902">Web query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1944766">Веб упит</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14924_149902_2527599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that retrieves data stored on your intranet or the Internet.</descrip></descripGrp><ntig><termGrp><term id="149902">Web query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527599">веб упит</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14926_6_2432662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To terminate abruptly, often used in reference to a program or procedure in progress.</descrip></descripGrp><ntig><termGrp><term id="6">abort</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2432662">одустати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14931_397193_406489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The method by which the offline address book (OAB) can be accessed by users when they are working remotely or over a dial-up connection. To distribute the OAB, administrators can use Web-based distribution, public folder distribution, or both. Public folder distribution is required for Outlook 2003 or earlier clients.</descrip></descripGrp><ntig><termGrp><term id="397193">offline address book distribution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406489">дистрибуција OAB-а</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14931_397193_406490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The method by which the offline address book (OAB) can be accessed by users when they are working remotely or over a dial-up connection. To distribute the OAB, administrators can use Web-based distribution, public folder distribution, or both. Public folder distribution is required for Outlook 2003 or earlier clients.</descrip></descripGrp><ntig><termGrp><term id="397193">offline address book distribution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406490">дистрибуција ванмрежног адресара</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14931_397194_406489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The method by which the offline address book (OAB) can be accessed by users when they are working remotely or over a dial-up connection. To distribute the OAB, administrators can use Web-based distribution, public folder distribution, or both. Public folder distribution is required for Outlook 2003 or earlier clients.</descrip></descripGrp><ntig><termGrp><term id="397194">OAB distribution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406489">дистрибуција OAB-а</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14931_397194_406490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The method by which the offline address book (OAB) can be accessed by users when they are working remotely or over a dial-up connection. To distribute the OAB, administrators can use Web-based distribution, public folder distribution, or both. Public folder distribution is required for Outlook 2003 or earlier clients.</descrip></descripGrp><ntig><termGrp><term id="397194">OAB distribution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406490">дистрибуција ванмрежног адресара</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14937_397209_406433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical grouping of well-connected Exchange servers between which no connector is required for message transfer.</descrip></descripGrp><ntig><termGrp><term id="397209">routing group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406433">група за усмеравање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14938_18094_1504351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined or free-form figure — such as a line, oval, cube, flowchart symbol, banner, or free-form scribble — that the user can insert into a document and then customize.</descrip></descripGrp><ntig><termGrp><term id="18094">AutoShape</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504351">Готов облик</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14943_134986_1916644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The position of a point with reference to the x-axis, defined in conjunction with the y- and z-coordinates.</descrip></descripGrp><ntig><termGrp><term id="134986">x-coordinate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916644">координата x</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14943_134986_2527469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The position of a point with reference to the x-axis, defined in conjunction with the y- and z-coordinates.</descrip></descripGrp><ntig><termGrp><term id="134986">x-coordinate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527469">x-координата</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14944_262698_1504352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computer graphics, a display method in which a viewing window on the screen scans horizontally or vertically, like a camera, to bring offscreen extensions of the current image smoothly into view.</descrip></descripGrp><ntig><termGrp><term id="262698">pan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504352">панорамски приказ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14944_779138_1504352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computer graphics, a display method in which a viewing window on the screen scans horizontally or vertically, like a camera, to bring offscreen extensions of the current image smoothly into view.</descrip></descripGrp><ntig><termGrp><term id="779138">panning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504352">панорамски приказ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14948_245218_1504353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common point of entry for spyware guarded by an agent. Examples of checkpoints include Startup Folder, dial up connections, Wi-Fi connections, Internet Safe Sites, Winsock Layered Service Providers, Windows Messenger Service, and SPAM Zombie prevention.</descrip></descripGrp><ntig><termGrp><term id="245218">checkpoint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504353">тачка прегледа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14949_397216_406569"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of mailbox stores and public folder stores that share a set of transaction log files. Exchange manages each storage group with a separate server process.</descrip></descripGrp><ntig><termGrp><term id="397216">storage group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406569">група складишта</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14953_38284_1504354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric or string value that is not calculated and, therefore, does not change.</descrip></descripGrp><ntig><termGrp><term id="38284">constant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504354">константа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14954_78795_1504355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enlarge a window to its largest size by double-clicking the title bar, clicking the Maximize button (at the right of the title bar), or by pressing ALT+SPACEBAR and then pressing X.</descrip></descripGrp><ntig><termGrp><term id="78795">maximize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504355">максимизирати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14962_397223_406558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined security group that provides specific permissions to allow role members to manage Exchange configuration data. Exchange 2007 provides the following four administrator roles: Exchange Recipient Administrators, Exchange Organization Administrators, Exchange Server Administrators, and Exchange View-Only Administrators.</descrip></descripGrp><ntig><termGrp><term id="397223">administrator role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406558">улога администратора</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14963_3046991_3048559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used to control a video game. For example, a joystick, mouse, or gamepad.</descrip></descripGrp><ntig><termGrp><term id="3046991">controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3048559">управљач</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine<