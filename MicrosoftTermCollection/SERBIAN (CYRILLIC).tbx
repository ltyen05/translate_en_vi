ographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34524_1993214_2009687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 20-digit number used to identify a Central Bank of Russian Federation account needed to facilitate international transactions.</descrip></descripGrp><ntig><termGrp><term id="1993214">beneficiary correspondent account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2009687">кореспондентски рачун примаоца</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34526_1993216_2009688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 10-12 digit number used to identify individual and organizational taxpayers in the Russian Federation receiving funds through an international transaction.</descrip></descripGrp><ntig><termGrp><term id="1993216">beneficiary INN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2009688">INN примаоца</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34527_1993217_2009689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numerical code used in combination with a beneficiary INN to identify and categorize a 