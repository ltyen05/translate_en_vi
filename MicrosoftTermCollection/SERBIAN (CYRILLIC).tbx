ipGrp><ntig><termGrp><term id="269327">RDP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503720">RDP</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8595_269327_3001089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The proprietary protocol to provide remote display and input capabilities over network connections for Windows-based applications between two computers.</descrip></descripGrp><ntig><termGrp><term id="269327">RDP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3001089">Remote Desktop Protocol</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8600_37568_1503721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of an action or operation that takes place based on whether or not a certain condition is true.</descrip></descripGrp><ntig><termGrp><term id="37568">conditional</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503721">условно</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8609_2856023_2575692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any of a family of processes that software developers use to minimize risk by developing applications incrementally, over a series of short iterations. In this model, real-time communications, such as in person conversations and telephone calls, are preferred over written documentation; the primary measure of progress is working software, instead of hours spent, tasks completed, documents reviewed, or phases signed-off; stakeholders are expected to collaborate, instead of negotiating; and planning happens continuously in order to respond to change.</descrip></descripGrp><ntig><termGrp><term id="2856023">Agile methodology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2575692">агилна методологија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8609_2856023_2576457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any of a family of processes that software developers use to minimize risk by developing applications incrementally, over a series of short iterations. In this model, real-time communications, such as in person conversations and telephone calls, are preferred over written documentation; the primary measure of progress is working software, instead of hours spent, tasks completed, documents reviewed, or phases signed-off; stakeholders are expected to collaborate, instead of negotiating; and planning happens continuously in order to respond to change.</descrip></descripGrp><ntig><termGrp><term id="2856023">Agile methodology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2576457">Агилни метод</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8609_2856023_2856328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any of a family of processes that software developers use to minimize risk by developing applications incrementally, over a series of short iterations. In this model, real-time communications, such as in person conversations and telephone calls, are preferred over written documentation; the primary measure of progress is working software, instead of hours spent, tasks completed, documents reviewed, or phases signed-off; stakeholders are expected to collaborate, instead of negotiating; and planning happens continuously in order to respond to change.</descrip></descripGrp><ntig><termGrp><term id="2856023">Agile methodology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2856328">Агилна методологија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8609_460694_2575692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any of a family of processes that software developers use to minimize risk by developing applications incrementally, over a series of short iterations. In this model, real-time communications, such as in person conversations and telephone calls, are preferred over written documentation; the primary measure of progress is working software, instead of hours spent, tasks completed, documents reviewed, or phases signed-off; stakeholders are expected to collaborate, instead of negotiating; and planning happens continuously in order to respond to change.</descrip></descripGrp><ntig><termGrp><term id="460694">Agile method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2575692">агилна методологија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8609_460694_2576457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any of a family of processes that software developers use to minimize risk by developing applications incrementally, over a series of short iterations. In this model, real-time communications, such as in person conversations and telephone calls, are preferred over written documentation; the primary measure of progress is working software, instead of hours spent, tasks completed, documents reviewed, or phases signed-off; stakeholders are expected to collaborate, instead of negotiating; and planning happens continuously in order to respond to change.</descrip></descripGrp><ntig><termGrp><term id="460694">Agile method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2576457">Агилни метод</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8609_460694_2856328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any of a family of processes that software developers use to minimize risk by developing applications incrementally, over a series of short iterations. In this model, real-time communications, such as in person conversations and telephone calls, are preferred over written documentation; the primary measure of progress is working software, instead of hours spent, tasks completed, documents reviewed, or phases signed-off; stakeholders are expected to collaborate, instead of negotiating; and planning happens continuously in order to respond to change.</descrip></descripGrp><ntig><termGrp><term id="460694">Agile method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2856328">Агилна методологија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8612_173657_1985656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Application software that gathers data from the user, prepares it for the server, and issues a request to the server. The client presents data received from the server to the user through its own user interface.</descrip></descripGrp><ntig><termGrp><term id="173657">client application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1985656">клијентска апликација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8614_358362_361381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item in the Exchange store that represents an appointment, a meeting, a meeting request, or an event. It can identify the place, resources, recurrence, and attendees involved at a discrete time.</descrip></descripGrp><ntig><termGrp><term id="358362">calendar item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="361381">календарска ставка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="862_1098947_1523783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software program that uses Hypertext Transfer Protocol (HTTP) for its core communication protocol and that delivers Web-based information to the user in the Hypertext Markup Language (HTML) language.</descrip></descripGrp><ntig><termGrp><term id="1098947">web-based application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523783">Веб апликација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="862_1098947_1686032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software program that uses Hypertext Transfer Protocol (HTTP) for its core communication protocol and that delivers Web-based information to the user in the Hypertext Markup Language (HTML) language.</descrip></descripGrp><ntig><termGrp><term id="1098947">web-based application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1686032">веб апликација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="862_131917_1523783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software program that uses Hypertext Transfer Protocol (HTTP) for its core communication protocol and that delivers Web-based information to the user in the Hypertext Markup Language (HTML) language.</descrip></descripGrp><ntig><termGrp><term id="131917">Web application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523783">Веб апликација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="862_131917_1686032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software program that uses Hypertext Transfer Protocol (HTTP) for its core communication protocol and that delivers Web-based information to the user in the Hypertext Markup Language (HTML) language.</descrip></descripGrp><ntig><termGrp><term id="131917">Web application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term 