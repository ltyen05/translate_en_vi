raphicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54539_3099039_3099523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The holiday that commemorates the birthday of His Majesty King Charles III.</descrip></descripGrp><ntig><termGrp><term id="3099039">King’s Birthday</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3099523">Краљев рођендан</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54540_3099040_3099522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The holiday that commemorates the crowning of His Majesty King Charles III.</descrip></descripGrp><ntig><termGrp><term id="3099040">Coronation Day for King Charles III</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3099522">Дан крунисања краља Чарлса Трећег</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54541_3099042_3102389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows leaders to encourage open dialog and feedback across communities and teams through news, Ask Me Anything (AMA) events, surveys, and more in Viva Engage.</descrip></descripGrp><ntig><termGrp><term id="3099042">Leadership Corner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3102389">Кутак за водитеље</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54542_3099043_3102387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of metrics available to Viva suite licensed customers that allows users to gain a deeper understanding of engagement and trends happening across Viva Engage.</descrip></descripGrp><ntig><termGrp><term id="3099043">Advanced Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3102387">Напредна аналитика</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54543_3099094_3099444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI model that lets users read and save information from standard documents such as invoices or tax documents. When they automate this process, they can save valuable time by reviewing, extracting, organizing, and saving the data automatically by using Power Automate and Power Apps.</descrip></descripGrp><ntig><termGrp><term id="3099094">document processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3099444">обрада докумената</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54544_3099095_3099445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A machine that allows users to build, test, and run attended and unattended desktop flows without providing or setting up any physical machines.</descrip></descripGrp><ntig><termGrp><term id="3099095">hosted machine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3099445">хостовани рачунар</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54545_3099096_3099446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category name for connectors that are submitted and maintained by external connector developers and are published to the Power Platform for use directly from within the product. Independent publishers do not own the underlying service behind their connector.</descrip></descripGrp><ntig><termGrp><term id="3099096">independent publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3099446">независни издавач</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termE