ip></descripGrp><ntig><termGrp><term id="2857356">guest access link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2859022">веза за дељење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50475_2857362_2858991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The shared sense of belonging that builds cohesion within a defined team, helping teammates to work as one.</descrip></descripGrp><ntig><termGrp><term id="2857362">collective identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2858991">колективни идентитет</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50476_2857364_2859026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to take into account not just yourself and your teammates, but also the context that surrounds you.</descrip></descripGrp><ntig><termGrp><term id="2857364">situational awareness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2859026">свест о ситуацији</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50477_2857366_2858988"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to sense the emotions of others and recognize the impact that one’s actions may have on others.</descrip></descripGrp><ntig><termGrp><term id="2857366">co-awareness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2858988">свест о другима</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50478_2857368_2858993"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The productive force that emerges when a team harnesses their differences, as a result of nurturing and balancing the other key team dynamics: team purpose, collective identity, awareness, inclusion, trust and vulnerability.</descrip></descripGrp><ntig><termGrp><term id="2857368">constructive tension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2858993">конструктивна напетост</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50479_2857369_2858986"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The joint understanding of self and others that enables teams to navigate interpersonal dynamics and foster team cohesion.</descrip></descripGrp><ntig><termGrp><term id="2857369">awareness and inclusion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2858986">свест и укључивање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50480_2857376_2858983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">UI label for inserting an Anyone link.</descrip></descripGrp><ntig><termGrp><term id="2857376">Anyone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2858983">Било ко</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50481_2857401_2859009"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Partner web app or add-in that integrates with Microsoft Graph and Microsoft productivity apps, workflows, and data across devices.</descrip></descripGrp><ntig><termGrp><term id="2857401">integrated apps</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2859009">интегрисане апликације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50485_2857873_2859791"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limit on the number of resour