 type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53693_3056864_3057533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that launches the ink editing experience in Word, allowing the users to edit documents with ink gestures.</descrip></descripGrp><ntig><termGrp><term id="3056864">Action Pen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3057533">Акциона оловка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53694_3056893_3057571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operational setup designed to meet both the physical and technological needs of a business and its workers.</descrip></descripGrp><ntig><termGrp><term id="3056893">modern workplace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3057571">савремено радно место</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53694_3056893_3057601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operational setup designed to meet both the physical and technological needs of a business and its workers.</descrip></descripGrp><ntig><termGrp><term id="3056893">modern workplace</term><termNote type="partOfSpeech">Noun</termNote><termN