></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504690">re-image</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21994_782341_1504691"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An easy-to-use troubleshooter that helps find and fix program compatibility issues.</descrip></descripGrp><ntig><termGrp><term id="782341">Program Compatibility troubleshooter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504691">алат за поправке компатибилности програма</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21996_782344_1504692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small pop-up window that informs users of a non-critical problem or special condition in a control.</descrip></descripGrp><ntig><termGrp><term id="782344">balloon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504692">балон</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="220_31883_1502750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A module that can contain the definition for a new object where each instance of a class creates a new object and procedures defined in the module become properties and methods of the object.</descrip></descripGrp><ntig><termGrp><term id="31883">class module</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502750">модул класе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22013_782377_2701435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portion of memory or auxiliary storage that contains the data used by a program.</descrip></descripGrp><ntig><termGrp><term id="782377">data segment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2701435">сегмент података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22015_782379_2629818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer (usually quite powerful) that is used solely as a network server.</descrip></descripGrp><ntig><termGrp><term id="782379">dedicated server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2629818">наменски сервер</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender