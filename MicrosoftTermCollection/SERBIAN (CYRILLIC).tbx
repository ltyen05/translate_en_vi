Note><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824347">извршавање произвољног кода</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49853_2819385_2824343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The execution of arbitrary commands or code on a target machine or in a target process.</descrip></descripGrp><ntig><termGrp><term id="2819385">ACE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824343">ACE</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49853_2819385_2824347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The execution of arbitrary commands or code on a target machine or in a target process.</descrip></descripGrp><ntig><termGrp><term id="2819385">ACE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824347">извршавање произвољног кода</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49854_2819397_2824356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">a set of entities and the relationships between the entities</descrip></descripGrp><ntig><termGrp><term id="2819397">entity schema</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824356">шема ентитета</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49855_2819402_2824369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In OAuth authentication, a token that is used by the Consumer to ask the User to authorize access to the Protected Resources. The User-authorized Request Token is exchanged for an Access Token, MUST only be used once, and MUST NOT be used for any other purpose. It is RECOMMENDED that Request Tokens have a limited lifetime.</descrip></descripGrp><ntig><termGrp><term id="2819402">request token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824369">токен захтева</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49856_2819416_2824377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common cache source that can be accessed by multiple processes and machines.</descrip></descripGrp><ntig><termGrp><term id="2819416">shared cache</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824377">дељени кеш</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49857_2819428_2824374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of users based on Azure AD attributes (such as location or department), or shared resources such as SharePoint sites. For example, you can have the segment "corporate advisory" and have "corporate advisory users" and "corporate advisory sites." In some cases, users in one segment may not be allowed to discover or communicate with users in another segment.</descrip></descripGrp><ntig><termGrp><term id="2819428">segment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824374">сегмент</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49858_2819429_2824384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in M365 admin center, which provides data, insights and recommendations related to optimization of devices, software, and other technology in your organization.</descrip></descripGrp><ntig><termGrp><term id="2819429">technology experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824384">искуство са технологијом</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49858_2819429_2834848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in M365 admin center, which provides data, insights and recommendations related to optimization of devices, software, and other technology in your organization.</descrip></descripGrp><ntig><termGrp><term id="2819429">technology experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2834848">Искуство са технологијом</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49858_2831275_2824384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in M365 admin center, which provides data, insights and recommendations related to optimization of devices, software, and other technology in your organization.</descrip></descripGrp><ntig><termGrp><term id="2831275">Technology experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824384">искуство са технологијом</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49858_2831275_2834848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in M365 admin center, which provides data, insights and recommendations related to optimization of devices, software, and other technology in your organization.</descrip></descripGrp><ntig><termGrp><term id="2831275">Technology experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2834848">Искуство са технологијом</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49859_2819431_2824366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">MMD device profile that provides local administrator privileges for users who need more control of their issued devices.</descrip></descripGrp><ntig><termGrp><term id="2819431">Privileged access device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824366">профил уређаја „Привилеговани приступ“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4986_37166_2740103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device capable of processing information, storing data, and producing a desired result based on instructions provided.</descrip></descripGrp><ntig><termGrp><term id="37166">computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2740103">рачунар</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49860_2819434_2824365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The MMD device profile that offers the greatest power to the local user (ability to install apps, etc.). Intended for use typically by developers, field engineers, etc.</descrip></descripGrp><ntig><termGrp><term id="2819434">Power user device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824365">профил уређаја „Искусни корисник“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49861_2819436_2824375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The MMD device profile that is more &amp;quot;locked down&amp;quot; to preserve the security of sensitive data. Intended for handling sensitive data such as medical records.</descrip></descripGrp><ntig><termGrp><term id="2819436">Sensitive data device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824375">профил уређаја „Осетљиви подаци“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49862_2819437_2824378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The MMD device profile that has the most balance of user privileges and data security--expected to be the most common profile and used by typical information workers.</descrip></descripGrp><ntig><termGrp><term id="2819437">Standard device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824378">профил уређаја „Стандардни“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49863_2911838_2912095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft Managed Desktop device profile optimized for use by frontline workers. Limited power for the user; intended for scenarios with multiple users sharing the same device, such as at a nurses' station. Likely to be operating under the F1 license.</descrip></descripGrp><ntig><termGrp><term id="2911838">frontline device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2912095">профил уређаја за раднике с прве линије</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49863_2911838_2912468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft Managed Desktop device profile optimized for use by frontline workers. Limited power for the user; intended for scenarios with multiple users sharing the same device, such as at a nurses' station. Likely to be operating under the F1 license.</descrip></descripGrp><ntig><termGrp><term id="2911838">frontline device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2912468">профил уређаја за прву интеракцију са клијентима</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49864_2819441_2824359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the proposed MMD device profiles. This would support a single app without requiring a user sign in.</descrip></descripGrp><ntig><termGrp><term id="2819441">Kiosk device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824359">профил уређаја „Терминал“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49865_2819443_2824354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in Microsoft 365, which includes insights and recommendations about usage of Microsoft 365 products that are related to employee productivity, engagement, wellbeing, and related concepts.</descrip></descripGrp><ntig><termGrp><term id="2819443">employee experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824354">искуство запослених</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49865_2819443_2834846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in Microsoft 365, which includes insights and recommendations about usage of Microsoft 365 products that are related to employee productivity, engagement, wellbeing, and related concepts.</descrip></descripGrp><ntig><termGrp><term id="2819443">employee experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2834846">Искуство запослених</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49865_2831277_2824354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in Microsoft 365, which includes insights and recommendations about usage of Microsoft 365 products that are related to employee productivity, engagement, wellbeing, and related concepts.</descrip></descripGrp><ntig><termGrp><term id="2831277">Employee experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824354">искуство запослених</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49865_2831277_2834846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in Microsoft 365, which includes insights and recommendations about usage of Microsoft 365 products that are related to employee productivity, engagement, wellbeing, and related concepts.</descrip></descripGrp><ntig><termGrp><term id="2831277">Employee experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2834846">Искуство запослених</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49866_2819444_2824373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of Microsoft-recommended configuration settings along with an explanation of their security impact. These settings are based on feedback from Microsoft security engineering teams, product groups, partners, and customers.</descrip></descripGrp><ntig><termGrp><term id="2819444">security baseline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824373">безбедносна основа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49867_2819445_2824383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that the customer defines, which represents a goal.</descrip></descripGrp><ntig><termGrp><term id="2819445">target</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824383">циљ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49868_2819447_2824344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft 365 scores, a recommendation based on data from your organization, which, if completed, results directly or indirectly in points earned to improve your score. This can be a direct action like changing a setting, or an indirect action like providing training to users that encourages them to use a feature more.</descrip></descripGrp><ntig><termGrp><term id="2819447">action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824344">радња</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49868_2819447_2824358"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft 365 scores, a recommendation based on data from your organization, which, if completed, results directly or indirectly in points earned to improve your score. This can be a direct action like changing a setting, or an indirect action like providing training to users that encourages them to use a feature more.</descrip></descripGrp><ntig><termGrp><term id="2819447">action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824358">ра