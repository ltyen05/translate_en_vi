 xml:lang="en-US"><descripGrp><descrip type="definition">An individual who designs and develops software.</descrip></descripGrp><ntig><termGrp><term id="1088811">developer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2208806">пројектант</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23692_1088842_2751622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of test cases and their associated test configuration information and the iteration when it is planned to run these tests.</descrip></descripGrp><ntig><termGrp><term id="1088842">test plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2751622">план провере ваљаности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23692_2749693_2751622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of test cases and their associated test configuration information and the iteration when it is planned to run these tests.</descrip></descripGrp><ntig><termGrp><term id="2749693">validation plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2751622">план провере ваљаности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23700_1088861_2266148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A link between two nodes on a tree or graph data structure.</descrip></descripGrp><ntig><termGrp><term id="1088861">edge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2266148">грана</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2371_34076_2527351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A link established upon a request for data. Once the request is filled, the link is broken. The next time data is required, a link from the client to the server must be reestablished. In a client/server architecture, cold links are useful when the linked item consists of a large amount of data. Dynamic Data Exchange (DDE), used in applications such as Microsoft Excel, uses cold links for data exchange.</descrip></descripGrp><ntig><termGrp><term id="34076">cold link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527351">хладна веза</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23710_1088878_2339438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The size, shape, and configuration of a piece of computer hardware.</descrip></descripGrp><ntig><termGrp><term id="1088878">form factor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2339438">фактор обрасца</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23714_1088883_1523779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables low-impact upgrades by allowing users or administrators to have more control over when the UI transitions from one version to the next.</descrip></descripGrp><ntig><termGrp><term id="1088883">visual upgrade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523779">визуелна надоградња</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23717_1088887_1917116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of conditional formatting that is configured within Microsoft SQL Server Analysis Services.</descrip></descripGrp><ntig><termGrp><term id="1088887">data source formatting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917116">обликовање OLAP сервера</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNot