:lang="en-US"><descripGrp><descrip type="definition">A node that makes cached data available to clients needing to retrieve the data.</descrip></descripGrp><ntig><termGrp><term id="1043701">peer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504718">peer</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22360_1043932_1375855"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To apply a skin to an existing user interface.</descrip></descripGrp><ntig><termGrp><term id="1043932">skin</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1375855">применити маску</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22362_1043933_1523528"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of maintaining backup files and putting them back onto the source medium if necessary.</descrip></descripGrp><ntig><termGrp><term id="1043933">backup and restore</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523528">прављење резервне копије и враћање у претходно стање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Not