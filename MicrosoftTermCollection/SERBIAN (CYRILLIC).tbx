><termGrp><term id="245224">Real-time protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3028058">заштита у реалном времену</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16037_3027999_3028058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature available in various security products that continuously detects and blocks attacks and potentially malicious objects, providing uninterrupted protection.</descrip></descripGrp><ntig><termGrp><term id="3027999">real-time protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3028058">заштита у реалном времену</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16063_2481712_1504457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware device, or a logical partition of it, that reads data from and writes data to hard disks.</descrip></descripGrp><ntig><termGrp><term id="2481712">HDD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504457">погонска јединица тврдог диска</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNot