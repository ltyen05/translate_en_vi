lected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7570_140476_2541760"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The .pst data file used as the main delivery location for your email messages.</descrip></descripGrp><ntig><termGrp><term id="140476">default data file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541760">подразумевана датотека са подацима</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7581_237287_1916863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows creation of mathematical formulas in documents, including the insertion of mathematical symbols inside designated "math zones" which perform automatic formatting to convert fractions, etc.</descrip></descripGrp><ntig><termGrp><term id="237287">Equation Builder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916863">Креатор једначина</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7581_237287_2527699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows creation of mathematical formulas in documents, including the insertion of mathematical symbols inside designated "math zones" which perform automatic formatting to convert fractions, etc.</descrip></descripGrp><ntig><termGrp><term id="237287">Equation Builder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527699">Израда једначина</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7584_130154_1503624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portion of unique computer code contained in a virus. Antivirus programs search for known virus signatures to identify infected programs and files.</descrip></descripGrp><ntig><termGrp><term id="130154">virus signature</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503624">потпис вируса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7590_375744_380299"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets a Microsoft Outlook user who has a Microsoft Exchange email account work offline, either by choice or due to a connection problem. A copy of the user's mailbox is stored on their computer and is frequently updated from the mail server. Any changes that are made while a connection to the server is not available are synchronized automatically when a connection becomes available.</descrip></descripGrp><ntig><termGrp><term id="375744">Cached Exchange Mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="380299">Кеширани Exchange режим</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7593_147682_1916743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a formula, the address of a cell based on the relative position of the cell that contains the formula and the cell referred to. If you copy the formula, the reference automatically adjusts.</descrip></descripGrp><ntig><termGrp><term id="147682">relative reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916743">релативна референца</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7593_147682_1916918"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a formula, the address of a cell based on the relative position of the cell that contains the formula and the cell referred to. If you copy the formula, the reference automatically adjusts.</descrip></descripGrp><ntig><termGrp><term id="147682">relative reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916918">релативна референца ћелије</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7593_461709_1916743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a formula, the address of a cell based on the relative position of the cell that contains the formula and the cell referred to. If you copy the formula, the reference automatically adjusts.</descrip></descripGrp><ntig><termGrp><term id="461709">relative cell reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916743">релативна референца</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7593_461709_1916918"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a formula, the address of a cell based on the relative position of the cell that contains the formula and the cell referred to. If you copy the formula, the reference automatically adjusts.</descrip></descripGrp><ntig><termGrp><term id="461709">relative cell reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916918">релативна референца ћелије</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="76_39968_1502728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of protecting the rights of an originator of a creative work, such as a text, a piece of music, a painting, or a computer program, through law.</descrip></descripGrp><ntig><termGrp><term id="39968">copyright</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502728">ауторско право</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7603_148245_1916748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual representation of a script on a Web page that you open in a Microsoft Office program.</descrip></descripGrp><ntig><termGrp><term id="148245">script anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916748">сидро скрипте</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7604_137569_1916651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an organization chart, a shape that is placed below and connected to any other shape with an elbow connector. This shape is placed above any additional subordinate shapes for the particular superior shape it is attached to.</descrip></descripGrp><ntig><termGrp><term id="137569">assistant shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916651">помоћни облик</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7604_1509002_1916651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an organization chart, a shape that is placed below and connected to any other shape with an elbow connector. This shape is placed above any additional subordinate shapes for the particular superior shape it is attached to.</descrip></descripGrp><ntig><termGrp><term id="1509002">assistant box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916651">помоћни облик</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7612_47524_1503625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In windowing environments, such as the Apple Macintosh and Microsoft Windows, an on-screen window (enclosed work area) in which the user can create, view, or work on a document.</descrip></descripGrp><ntig><termGrp><term id="47524">document window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503625">прозор документа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7614_178927_2541915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The exchange of products or services for money.</descrip></descripGrp><ntig><termGrp><term id="178927">sale</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541915">продаја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7628_144937_1916720"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows multiple design templates to be applied to a single presentation.</descrip></descripGrp><ntig><termGrp><term id="144937">multiple masters</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916720">вишеструки предлошци</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7628_144937_2527555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows multiple design templates to be applied to a single presentation.</descrip></descripGrp><ntig><termGrp><term id="144937">multiple masters</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527555">вишеструки мастери</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7631_134267_1503626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a spreadsheet program, a file containing a number of related worksheets.</descrip></descripGrp><ntig><termGrp><term id="134267">workbook</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503626">радна свеска</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7638_398504_2818883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stored record of the audio and video components of a meeting or session.</descrip></descripGrp><ntig><termGrp><term id="398504">recording</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2818883">снимак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7638_398504_2819753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stored record of the audio and video components of a meeting or session.</descrip></descripGrp><ntig><termGrp><term id="398504">recording</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2819753">снимање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7641_50797_1503627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To programmatically disguise content to hide its substance.</descrip></descripGrp><ntig><termGrp><term id="50797">encrypt</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503627">шифровати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7641_764958_1503627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To programmatically disguise content to hide its substance.</descrip></descripGrp><ntig><termGrp><term id="764958">encipher</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503627">шифровати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7642_217268_1683408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fixed-size result that is obtained by applying a one-way mathematical function (sometimes called a hash algorithm) to an arbitrary amount of data. If there is a change in the input data, the hash changes. The hash can be used in many operations, including authentication and digital signing.</descrip></descripGrp><ntig><termGrp><term id="217268">hash code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term i