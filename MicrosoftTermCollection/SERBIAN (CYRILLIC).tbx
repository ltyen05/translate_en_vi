finition">A placeholder for text or pictures that you insert into your document.</descrip></descripGrp><ntig><termGrp><term id="144653">merge field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503482">поље спајања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6224_144653_2527549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A placeholder for text or pictures that you insert into your document.</descrip></descripGrp><ntig><termGrp><term id="144653">merge field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527549">поље за обједињавање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6231_144677_1944749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single cell that is created by combining two or more selected cells. The cell reference for a merged cell is the upper-left cell in the original selected range.</descrip></descripGrp><ntig><termGrp><term id="144677">merged cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1944749">обједињена ћелија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">