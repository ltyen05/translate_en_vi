 type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53621_3052240_3052310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The error in Excel that is shown when the user uses an incorrect range operator in a formula or when they use a space character between range references to specify an intersection of two ranges that don't intersect.</descrip></descripGrp><ntig><termGrp><term id="3052240">#NULL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3052310">#NULL</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53621_3052240_3052311"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The error in Excel that is shown when the user uses an incorrect range operator in a formula or when they use a space character between range references to specify an intersection of two ranges that don't intersect.</descrip></descripGrp><ntig><termGrp><term id="3052240">#NULL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3052311">#NULL</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53646_3053620_3053907"><langSet xml:lang="en-US"><descripGrp><descri