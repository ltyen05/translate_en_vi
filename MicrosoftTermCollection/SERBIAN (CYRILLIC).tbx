">Опсег</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33966_1961354_2142044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On the Business Rules editor form, the column that displays whether the business rule is the primary rule, or a participating one.</descrip></descripGrp><ntig><termGrp><term id="1961354">Type</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2142044">тип</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33967_1961355_2142030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On the Business Rules editor dialog box, the column that lists whether a business rule is activated or deactivated.</descrip></descripGrp><ntig><termGrp><term id="1961355">State</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2142030">Статус</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33969_1961560_2141965"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search field that allows the user to search across multiple entities such as contacts, accounts, and l