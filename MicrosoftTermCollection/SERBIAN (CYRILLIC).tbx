, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44243_2485701_2487424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The warning that Excel displays when a function cannot be executed because configuration or user settings block certain functionality, such as accessing data over the internet.</descrip></descripGrp><ntig><termGrp><term id="2485701">#BLOCKED!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2487424">#БЛОКИРАНО!</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44245_2485904_2487289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A website that customers can go to for help with Microsoft products.</descrip></descripGrp><ntig><termGrp><term id="2485904">Microsoft Support</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2487289">Microsoft подршка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4425_232401_1916830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Calendar, time status and user defined labels are indicated by colors and patterns.</descrip></descripGrp><ntig><termGrp><term id