146857_1502997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Row or column labels that are printed at the top of or on the left side of every page on a printed worksheet.</descrip></descripGrp><ntig><termGrp><term id="146857">print titles</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502997">штампање наслова</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2333_146857_2527576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Row or column labels that are printed at the top of or on the left side of every page on a printed worksheet.</descrip></descripGrp><ntig><termGrp><term id="146857">print titles</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527576">наслови за штампање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23331_1073321_1504743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slide show mode that displays content in a manageable window that can be resized and features navigation buttons. This mode is optimized for reviewing presentations, allowing users to get the full experience, complete with animations and media, while performing other tasks, such as taking notes.</descrip></descripGrp><ntig><termGrp><term id="1073321">Reading View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504743">приказ за читање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23331_1073321_2528025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slide show mode that displays content in a manageable window that can be resized and features navigation buttons. This mode is optimized for reviewing presentations, allowing users to get the full experience, complete with animations and media, while performing other tasks, such as taking notes.</descrip></descripGrp><ntig><termGrp><term id="1073321">Reading View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2528025">Приказ за читање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23333_1087526_1944747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to easily add links to content within other content (e.g. pages, sections, section groups) and provides quick navigation through these links. The feature operates in the same manner that links work in wikis.</descrip></descripGrp><ntig><termGrp><term id="1087526">linking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1944747">повезивање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23334_1073349_1504745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that highlights new or changed content in a shared notebook that the user has not yet read.</descrip></descripGrp><ntig><termGrp><term id="1073349">Unread Changes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504745">непрочитане измјене</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23334_1073349_2528026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that highlights new or changed content in a shared notebook that the user has not yet read.</descrip></descripGrp><ntig><termGrp><term id="1073349">Unread Changes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2528026">Непрочитане промене</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23335_1073356_1504746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-level linear representation of a project schedule that can be easily formatted, annotated, and copied and pasted from Project into other Office applications.</descrip></descripGrp><ntig><termGrp><term id="1073356">timeline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504746">временски низ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23336_1073640_1504747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that identifies the author of unread new or changed content in a shared notebook.</descrip></descripGrp><ntig><termGrp><term id="1073640">Author Marks</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504747">ознака аутора</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23336_1073640_2528027"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that identifies the author of unread new or changed content in a shared notebook.</descrip></descripGrp><ntig><termGrp><term id="1073640">Author Marks</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2528027">Ознаке аутора</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23347_1074772_1669451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task pane that helps form designers to build and manage custom business rules for use in their forms.</descrip></descripGrp><ntig><termGrp><term id="1074772">Rules Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1669451">Управљач правилима</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23348_1074773_1504749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-defined table style that allows users to change the look and feel of a form.</descrip></descripGrp><ntig><termGrp><term id="1074773">layout style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504749">приказ стила</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23349_1074775_1504750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows form designers to select from a gallery of pre-built rules to make their forms dynamic.</descrip></descripGrp><ntig><termGrp><term id="1074775">Quick Rules</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504750">Брзи управљачи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23351_1074778_1504751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-defined layout that users can select for their InfoPath form sections. Options include single column, two-column, three-column, and four-column layouts.</descrip></descripGrp><ntig><termGrp><term id="1074778">section layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504751">приказ секције</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23352_1216614_1504752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An environment in the InfoPath client that enables users to fill out forms (as opposed to designing them). It must be used if the forms to be filled out are not browser-compatible.</descrip></descripGrp><ntig><termGrp><term id="1216614">InfoPath Filler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504752">InfoPath Filler</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23352_1216691_1504752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An environment in the InfoPath client that enables users to fill out forms (as opposed to designing them). It must be used if the forms to be filled out are not browser-compatible.</descrip></descripGrp><ntig><termGrp><term id="1216691">Microsoft InfoPath Filler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504752">InfoPath Filler</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23355_1074783_1523539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part that implements Web chart controls to visually display information in a variety of chart types in SharePoint.</descrip></descripGrp><ntig><termGrp><term id="1074783">Chart Web Part</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523539">Веб сегмент графикона</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23358_1074794_1788710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of processors commonly used for low-powered hardware, such as tablets and other mobile devices. These small, high-performance 32-bit RISC-based microprocessors are licensed to various semiconductor manufacturers by designer ARM Limited.</descrip></descripGrp><ntig><termGrp><term id="1074794">ARM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1788710">ARM</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23361_1074891_2074053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of hardware (touchscreen or touchpad) and software elements that provides a way to control programs by touching multiple points on the screen simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1074891">multi-touch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2074053">вишеструки додир</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23361_1074891_2078423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of hardware (touchscreen or touchpad) and software elements that provides a way to control programs by touching multiple points on the screen simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1074891">multi-touch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2078423">вишеструки додир</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="234_237832_1502754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object created using drawing tools or commands.</descrip></descripGrp><ntig><termGrp><term id="237832">shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502754">облик</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23402_1078950_2920507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that includes systems, services, and standards for the interactive delivery of streaming video to multimedia clients such as digital set-top boxes.</descrip></descripGrp><ntig><termGrp><term id="1078950">video on demand</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920507">VOD</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23402_1078952_2920507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that includes systems, services, and standards for the interactive delivery of streaming video to multimedia clients such as digital set-top boxes.</descrip></descripGrp><ntig><termGrp><term id="1078952">VOD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920507">VOD</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23409_1080633_2528029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A simple encryption scheme using the "exclusive-or" concept, in which a decision is based on only one of two conditions being met. Using a provided key, XOR encryption performs an exclusive-or process on each byte of data to be encrypted. Because XOR encryption is not a strong security tool used alone, it is typically used as an additional level of security for Internet transmission of sensitive information.</descrip></descripGrp><ntig><termGrp><term id="1080633">XOR encryption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2528029">XOR шифровање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23409_1080634_2528029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A simple encryption scheme using the "exclusive-or" concept, in which a decision is based on only one of two conditions being met. Using a provided key, XOR encryption performs an exclusive-or process on each byte of data to be encrypted. Because XOR encryption is not a strong security tool used alone, it is typically used as an additional level of security for Internet transmission of sensitive information.</descrip></descripGrp><ntig><termGrp><term id="1080634">Exclusive-OR encryption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2528029">XOR шифровање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2342_138389_1916658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The entire chart and all its elements.</descrip></descripGrp><ntig><termGrp><term id="138389">chart area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916658">подручје графикона</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2342_138389_2527487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The entire chart and all its elements.</descrip></descripGrp><ntig><termGrp><term id="138389">chart area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527487">поље графикона</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23423_1081688_1375662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows 9x, Windows NT, and Windows 2000, a handle to a Registry key in which configuration information is stored. Each key leads to sub-keys containing configuration information that, in earlier versions of Windows, was stored in .ini files. For example, the handle key HKEY_CURRENT_USERControl Panel leads to the subkey for the Windows Desktop.</descrip></descripGrp><ntig><termGrp><term id="1081688">HKEY</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1375662">HKEY</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23423_1081689_1375662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows 9x, Windows NT, and Windows 2000, a handle to a Registry key in which configuration information is stored. Each key leads to sub-keys containing configuration information that, in earlier versions of Windows, was stored in .ini files. For example, the handle key HKEY_CURRENT_USERControl Panel leads to the subkey for the Windows Desktop.</descrip></descripGrp><ntig><termGrp><term id="1081689">hkey handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1375662">HKEY</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2343_210468_1523691"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web service exposed by the web front-end that allows a client program to execute queries.</descrip></descripGrp><ntig><termGrp><term id="210468">Query Service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523691">Услуга упита</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23436_1081889_2856337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A drawing that is meant to show how something works; it generally includes the relations between parts.</descrip></descripGrp><ntig><termGrp><term id="1081889">diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2856337">Дијаграм</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2344_21520_1502998"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of essential software routines that test computer hardware at startup, start the operating system, and support the transfer of information between hardware devices. The BIOS is stored in read-only memory (ROM) so that it can be run when the computer is turned on. Although critical to performance, the BIOS is usually invisible to computer users.</descrip></descripGrp><ntig><termGrp><term id="21520">BIOS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502998">BIOS</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2344_21520_1502999"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of essential software routines that test computer hardware at startup, start the operating system, and support the transfer of information between hardware devices. The BIOS is stored in read-only memory (ROM) so that it can be run when the computer is turned on. Although critical to performance, the BIOS is usually invisible to computer users.</descrip></descripGrp><ntig><termGrp><term id="21520">BIOS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502999">основни систем улаза/излаза</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2344_21521_1502998"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of essential software routines that test computer hardware at startup, start the operating system, and support the transfer of information between hardware devices. The BIOS is stored in read-only memory (ROM) so that it can be run when the computer is turned on. Although critical to performance, the BIOS is usually invisible to computer users.</descrip></descripGrp><ntig><termGrp><term id="21521">basic input/output system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502998">BIOS</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2344_21521_1502999"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of essential software routines that test computer hardware at startup, start the operating system, and support the transfer of information between hardware devices. The BIOS is stored in read-only memory (ROM) so that it can be run when the computer is turned on. Although critical to performance, the BIOS is usually invisible to computer users.</descrip></descripGrp><ntig><termGrp><term id="21521">basic input/output system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502999">основни систем улаза/излаза</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23449_1082184_2528030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A relational database system capable of handling queries more complex than those handled by standard relational databases, through multidimensional access to data (viewing the data by several different criteria), intensive calculation capability, and specialized indexing techniques.</descrip></descripGrp><ntig><termGrp><term id="1082184">OLAP database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2528030">OLAP база података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2346_15363_2740102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To link one entity to another for a specific purpose.</descrip></descripGrp><ntig><termGrp><term id="15363">assign</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2740102">доделити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23462_1082215_1504753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The street address or geographical coordinates of a user, and (by way of extensions) of the user’s computer or devices.</descrip></descripGrp><ntig><termGrp><term id="1082215">location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504753">локација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23469_1082336_2745847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character used in synchronous (timed) communications that enables the sending and receiving devices to maintain the same timing.</descrip></descripGrp><ntig><termGrp><term id="1082336">SYN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2745847">SYN</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23469_1082337_2745847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character used in synchronous (timed) communications that enables the sending and receiving devices to maintain the same timing.</descrip></descripGrp><ntig><termGrp><term id="1082337">synchronous idle character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2745847">SYN</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23478_1082601_2521298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solid-state circuit component, usually with three leads, in which a voltage or a current controls the flow of another current. The transistor can serve many functions, including those of amplifier, switch, and oscillator, and is a fundamental component of almost all modern electronics.</descrip></descripGrp><ntig><termGrp><term id="1082601">transistor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2521298">транзистор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23478_1082602_2521298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solid-state circuit component, usually with three leads, in which a voltage or a current controls the flow of another current. The transistor can serve many functions, including those of amplifier, switch, and oscillator, and is a fundamental component of almost all modern electronics.</descrip></descripGrp><ntig><termGrp><term id="1082602">transfer resistor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2521298">транзистор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2349_178836_2541905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tabulation of goods and services that one purchases or sells, or offers for purchase or sale.</descrip></descripGrp><ntig><termGrp><term id="178836">Product and Service Items list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541905">списак ставки производа и услуга</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23513_1086437_1944734"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To save the user's work on a continuous basis, so that it is not necessary to save manually.</descrip></descripGrp><ntig><termGrp><term id="1086437">automatically save</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1944734">аутоматски