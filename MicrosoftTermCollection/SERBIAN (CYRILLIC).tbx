68663">точкић миша</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16213_534934_2168663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hard plastic disc on a mouse that is perpendicular to the mouse surface. It is normally located between the left and right mouse buttons and is used for scrolling.</descrip></descripGrp><ntig><termGrp><term id="534934">scroll wheel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2168663">точкић миша</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16217_180167_2541935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To arrange or associate one or more resources.</descrip></descripGrp><ntig><termGrp><term id="180167">group</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541935">груписати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1622_234771_1502914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to Microsoft software which is published by Microsoft, properly licensed, and fully supported by Microsoft or a trusted partner.</descrip></descri