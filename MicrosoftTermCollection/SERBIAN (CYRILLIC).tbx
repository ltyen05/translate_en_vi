p><term id="110172">separator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2701455">знак за раздвајање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10189_722343_1796421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that separates groups of controls (on a surface) or commands (on a menu).</descrip></descripGrp><ntig><termGrp><term id="722343">separator bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1796421">сепаратор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10189_722343_2701455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that separates groups of controls (on a surface) or commands (on a menu).</descrip></descripGrp><ntig><termGrp><term id="722343">separator bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2701455">знак за раздвајање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1019_36322_1502847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree to which a computer, an attached device, a data file, or a program can work with or understand the same commands, formats, or language as another. True compatibility means that any operational differences are invisible to people and programs alike.</descrip></descripGrp><ntig><termGrp><term id="36322">compatibility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502847">компатибилност</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10190_122191_1503879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A command button used in a toolbar (or status bar).</descrip></descripGrp><ntig><termGrp><term id="122191">toolbar button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503879">дугме на алатној траци</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="102_554892_2456539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unsupported, prerelease software version intended to make the latest working build of a particular product available to developers.</descrip></descripGrp><ntig><termGrp><term id="554892">Community Technology Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><nt