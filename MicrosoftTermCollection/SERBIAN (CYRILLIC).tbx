p><term id="2839224">Microsoft Dynamics 365 за таблете</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50178_2837903_2839225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud-based service that extends the power of Dynamics 365 for Customer Service to enable customers to instantly connect and engage with their customers via newly introduced channels: live chat and SMS.</descrip></descripGrp><ntig><termGrp><term id="2837903">Omnichannel Engagement Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2839225">чвориште за ангажовање више канала</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50179_2837904_2839226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The add-in to Dynamics 365 Customer Service apps that extends the power of Dynamics 365 Customer Service to enable organizations to instantly connect and engage with their customers via channels like live chat and texting.</descrip></descripGrp><ntig><termGrp><term id="2837904">Omnichannel for Customer Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2839226">Више канала за Customer Service</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50180_2837905_2839228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool that helps new customers get started with setting up Dynamics 365 Business Central. It creates and helps apply configuration packages using a toolset designed to speed up deployment times, improve quality of implementation, introduce a repeatable approach to implementations, and enable productivity by automating and simplifying recurring tasks.</descrip></descripGrp><ntig><termGrp><term id="2837905">RapidStart Services Implementer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2839228">RapidStart Services алатка за примену</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50181_2837906_2839229"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The add-on capability for the Dynamics 365 Field Service application that enables users to automatically schedule work orders for the most appropriate resources, by optimizing bookings for the shortest travel time, available work hours, and many other constraints.</descrip></descripGrp><ntig><termGrp><term id="2837906">Resource Scheduling Optimization</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2839229">Resource Scheduling Optimization</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50182_2837907_2839230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that enable in-store activities by field sales personnel including: site visit planning, activity lists, checklists and surveys.</descrip></descripGrp><ntig><termGrp><term id="2837907">Retail Sales Execution</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2839230">извршавање у малопродаји</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50183_2837908_2839231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Dynamics 365 AI for Market Insights app that provides audience insights from interactions on Bing search.</descrip></descripGrp><ntig><termGrp><term id="2837908">Search Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2839231">увиди у претрагу</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50184_2837909_2839232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service offered by Microsoft Social Engagement app that provides the ability to identify, compute, and project queries related to publicly available documents and posts.</descrip></descripGrp><ntig><termGrp><term id="2837909">Social Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2839232">аналитика друштвених медија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50185_2837910_2839233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service offered by Microsoft Social Engagement app that provides the ability to listen to and monitor publicly available social communications across public and managed networks administered by third parties.</descrip></descripGrp><ntig><termGrp><term id="2837910">Social Media Monitoring</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2839233">надгледање друштвених медија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50187_2838775_2841710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An approach to machine translation that uses an artificial neural network to predict the likelihood of a sequence of words, typically modeling entire sentences in a single integrated model.</descrip></descripGrp><ntig><termGrp><term id="2838775">neural machine translation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2841710">неуронски машински превод<