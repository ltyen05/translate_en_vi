Note type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2017_139881_1916676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field in the row or column area that contains custom groups as its items.</descrip></descripGrp><ntig><termGrp><term id="139881">custom group field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916676">прилагођено поље групе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20178_717322_767501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A navigation bar item that links to billing-related information.</descrip></descripGrp><ntig><termGrp><term id="717322">Billing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="767501">Наплата</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20189_718449_2160430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Hyper-V that allows a running virtual machine to be managed remotely through an interactive session.</descrip></descripGrp><ntig><termGrp><term id="718449">Virtual Machine Connection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:l