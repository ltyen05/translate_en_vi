er">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47243_2660321_2662080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SVG filter that displaces the geometry of an image.</descrip></descripGrp><ntig><termGrp><term id="2660321">Displacement Map</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2662080">Померена геометрија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47244_2660322_2662082"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SVG filter that layers an offset copy of an image on top of another so that the images can be layered.</descrip></descripGrp><ntig><termGrp><term id="2660322">Offset</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2662082">Помак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47245_2660323_2662085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SVG filter that creates a bright spot of lighting in the image, creating a stark contrast between the lit and unlit parts.</descrip></descripGrp><ntig><termGrp><term id="2660323">Specular Light</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp