2557420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of people who uses or shares a common language or dialect and contributes to language-related activities for Windows features.</descrip></descripGrp><ntig><termGrp><term id="2515527">Language Community</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2557420">Језичка заједница</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44672_2515529_2557421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section in the Feedback Hub app where users can organize language-related activities for their Language community.</descrip></descripGrp><ntig><termGrp><term id="2515529">Language Community tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2557421">картица „Језичка заједница“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44676_2515692_2517714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that generates Office 365 reports using SharePoint on-premises diagnostic and usage logs so that administrators can manage their infrastructure more efficiently.</descrip></descripGrp><ntig><termGrp><term id="2515692">SharePoint Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2517714">SharePoint Insights</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44683_2515738_2518622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A voltage regulator that uses an alternating electrical current to provide a continuously variable output voltage.</descrip></descripGrp><ntig><termGrp><term id="2515738">induction voltage regulator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2518622">индукциони регулатор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44683_2515738_2518623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A voltage regulator that uses an alternating electrical current to provide a continuously variable output voltage.</descrip></descripGrp><ntig><termGrp><term id="2515738">induction voltage regulator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2518623">индукциони регулатор напона</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44683_2515739_2518622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A voltage regulator that uses an alternating electrical current to provide a continuously variable output voltage.</descrip></descripGrp><ntig><termGrp><term id="2515739">induction regulator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2518622">индукциони регулатор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44683_2515739_2518623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A voltage regulator that uses an alternating electrical current to provide a continuously variable output voltage.</descrip></descripGrp><ntig><termGrp><term id="2515739">induction regulator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2518623">индукциони регулатор напона</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44685_2515779_2518624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A metal-oxide semiconductor field-effect transistor in which the conduction channel is formed by the movement of holes (electron "vacancies" created as electrons move from atom to atom) rather than electrons.</descrip></descripGrp><ntig><termGrp><term id="2515779">p-channel metal-oxide semiconductor field-effect transistor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote><