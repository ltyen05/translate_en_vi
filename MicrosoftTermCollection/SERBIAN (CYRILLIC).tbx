1723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Surface feature that helps to adjust your gaze on video calls and recordings so that you appear to be looking directly into the camera.</descrip></descripGrp><ntig><termGrp><term id="2911595">Eye Contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2911723">Контакт очима</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51865_2911595_2911977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Surface feature that helps to adjust your gaze on video calls and recordings so that you appear to be looking directly into the camera.</descrip></descripGrp><ntig><termGrp><term id="2911595">Eye Contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2911977">контакт очима</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51866_2911596_2911722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The FastTrack service that provides users with advisory and remediation services to support them as they migrate to Windows 10 and deploy their apps to Microsoft 365 Apps and the new Microsoft Edge.</descrip></descripGrp><ntig><termGrp><term id="2911596">App Assure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig><