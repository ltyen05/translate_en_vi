0625_1504713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software or device that helps control your home smart devices automatically.</descrip></descripGrp><ntig><termGrp><term id="1040625">home automation controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504713">контролор кућних програмираних уређаја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22313_1040630_1504714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An input device used chiefly for identification purposes that reads information that has been magnetically encoded, usually in two tracks, on a plastic card, such as a credit card or an employee badge.</descrip></descripGrp><ntig><termGrp><term id="1040630">card reader</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504714">читач картице</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22317_1040657_1504715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notebook that is smaller in size and lighter in weight than a full-sized notebook, while retaining the same functionality.</descrip></descripGrp><ntig><termGrp><term id="1040657">subnotebook</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></