nt Platform that allows users to track campaigns across the champion group to see their ranking from a global perspective.</descrip></descripGrp><ntig><termGrp><term id="3055644">Champion Leaderboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3056718">Ранг листа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53676_3055645_3056715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Champion Management Platform that allows users to track campaigns across the champion group to see their ranking from a global perspective.</descrip></descripGrp><ntig><termGrp><term id="3055645">Leaderboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3056715">Ранг листа шампиона</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53676_3055645_3056718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Champion Management Platform that allows users to track campaigns across the champion group to see their ranking from a global perspective.</descrip></descripGrp><ntig><termGrp><term id="3055645">Leaderboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3056718">Ранг листа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53677_3055646_3056717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Champion Management Platform that allows users to overlay a teamwork champion badge over a profile image for display across the Microsoft 365 solutions.</descrip></descripGrp><ntig><termGrp><term id="3055646">Digital Badge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3056717">Дигитални беџ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53678_3055647_3056722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Champion Management Platform that enables adoption themed tournaments for the entire organization to participate in.</descrip></descripGrp><ntig><termGrp><term id="3055647">Tournament of Teams</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3056722">Турнир тимова</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53679_3055653_3056719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The group of com