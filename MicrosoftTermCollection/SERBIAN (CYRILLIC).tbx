ermEntry><termEntry id="31663_1608239_1645086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Collected data about an app, such as analytics of download, usage, in-application transaction, customer ratings provided by the Windows Store developer portal. This type of information helps developers clearly understand how their applications are doing in the Windows market.</descrip></descripGrp><ntig><termGrp><term id="1608239">App Summary</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1645086">Резиме апликације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31664_1608240_1644441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Store service that enables end users to update apps one at a time or all at the same time for all apps purchased through the Windows Store.</descrip></descripGrp><ntig><termGrp><term id="1608240">App Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1644441">Ажурирање апликација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31668_1611161_1781138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The stage of an app in the certification process.</descrip></descripGrp><ntig><termGrp><term id="1611161">certification status</term><termNote type="partOfSpeec