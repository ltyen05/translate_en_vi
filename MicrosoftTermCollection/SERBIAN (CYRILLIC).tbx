angSet></termEntry><termEntry id="21442_777482_1669459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An abstract grouping of similar transition effects.</descrip></descripGrp><ntig><termGrp><term id="777482">transition style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1669459">стил прелаза</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21443_1133579_1504667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A full-page UI view that exposes file-level functionality in Office applications. This is a companion feature to the Office Ribbon and helps users discover and use the features that fall outside of the authoring features on the Ribbon.</descrip></descripGrp><ntig><termGrp><term id="1133579">Backstage view</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504667">Backstage преглед</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21443_1133579_1954411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A full-page UI view that exposes file-level functionality in Office applications. This is a companion feature to the Office Ribbon and helps users discover and use the features that fall outside of the authoring features on the Ribbon.</descrip></descripGrp><ntig><termGrp><term id="1133579">Backs