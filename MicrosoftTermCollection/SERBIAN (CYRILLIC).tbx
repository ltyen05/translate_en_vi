ripGrp><descrip type="definition">A small image that provides a visual indication of roles, contribution levels, achievements, affiliations, etc.</descrip></descripGrp><ntig><termGrp><term id="1354385">badge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1385145">беџ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26740_1354385_1652454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small image that provides a visual indication of roles, contribution levels, achievements, affiliations, etc.</descrip></descripGrp><ntig><termGrp><term id="1354385">badge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1652454">значка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26742_1354388_1356354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contact list designed for use within a form for selecting contacts. Users can click a contact to select it and may make multiple selections by using CTRL+click.</descrip></descripGrp><ntig><termGrp><term id="1354388">contact picker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356354">избор контаката</term><termNote type="geographicalUsage">SRB, BIH</termNote><ter