Cyrl"><ntig><termGrp><term id="3099450">емулатор терминала</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54549_3099100_3099451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An executable image file from a virtual machine, such as OS, CD, DVD and HDD.</descrip></descripGrp><ntig><termGrp><term id="3099100">VM image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3099451">слика виртуелне машине</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54550_3099235_3101197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ad format in PromoteIQ that generally ranks at the top of a retailer's website, and features images of products.</descrip></descripGrp><ntig><termGrp><term id="3099235">Product Listing Ad</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3101197">PLA</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54550_3099235_3101198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ad format in PromoteIQ that generally ranks at the top of a retailer's website, and features images of products.