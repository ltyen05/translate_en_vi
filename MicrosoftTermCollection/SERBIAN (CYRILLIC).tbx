rmNote></termGrp></ntig></langSet></termEntry><termEntry id="33843_1908770_1971631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limited-day trial for an Office 365 online subscription for businesses that need communication and collaboration tools accessible from PCs, the Web and mobile devices.</descrip></descripGrp><ntig><termGrp><term id="1908770">Office 365 Enterprise E1 Trial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1971631">Office 365 Enterprise E1 – пробна верзија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33844_1908771_1971632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 online subscription for businesses that need communication and collaboration tools and the ability to read and do lightweight editing of documents with the Office Web Apps.</descrip></descripGrp><ntig><termGrp><term id="1908771">Office 365 Enterprise E2</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1971632">Office 365 Enterprise E2</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33846_1908773_1971634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limited-day trial for an Office 365 online subscription for businesses that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Web Apps.</descrip></descripGrp><ntig><termGrp><term id="1908773">Office 365 Enterprise E3 Trial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1971634">Office 365 Enterprise E3 – пробна верзија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33847_1908774_1971644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 subscription for businesses that need productivity, communications and collaboration tools including the familiar desktop Office and compliance features like data loss prevention and archiving. Also includes Skype for Business Plus CAL, enabling customers to get Enterprise Voice on-premises.</descrip></descripGrp><ntig><termGrp><term id="1908774">Office 365 Enterprise E4</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1971644">Office 365 Enterprise E4</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33848_1908775_1971645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limited-day trial for an Office 365 online subscription for businesses that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Web Apps and on-premises server rights to information protection and enterprise voice capabilities.</descrip></descripGrp><ntig><termGrp><term id="1908775">Office 365 Enterprise E4 Trial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1971645">Office 365 Enterprise E4 – пробна верзија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33853_1908780_1971657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limited-day trial for an Office 365 online subscription for midsize businesses (fewer than 250 users) that need that need Office suite, email, instant messaging, document/content management, and web conferencing. Includes Microsoft Office for Windows, Mac, mobile, Office Web Apps and IT management capabilities.</descrip></descripGrp><ntig><termGrp><term id="1908780">Office 365 Midsize Business Trial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1971657">Office 365 Midsize Business – пробна верзија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33854_1908781_1971668"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limited-time trial for small businesses and professionals (fewer than 25 users) that need Office suite, email, instant messaging, document/content management, and web conferencing. Includes Microsoft Office for Windows, Mac, mobile and Office Web Apps. Simple setup and deployment.</descrip></descripGrp><ntig><termGrp><term id="1908781">Office 365 Small Business Premium Trial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1971668">Office 365 Small Business Premium – пробна верзија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33856_1908783_1971665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Office ProPlus Subscription for Students at K12 and Higher Education institutions.</descrip></descripGrp><ntig><termGrp><term id="1908783">Office 365 ProPlus A for Students</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1971665">Office 365 ProPlus A за студенте</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33857_1908784_1971663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Office ProPlus Subscription for Faculty and Staff at K12 and Higher Education institutions.</descrip></descripGrp><ntig><termGrp><term id="1908784">Office 365 ProPlus A for Faculty</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1971663">Office 365 ProPlus A за академске раднике</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Pro