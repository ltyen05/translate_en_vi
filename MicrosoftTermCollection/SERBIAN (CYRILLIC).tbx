rammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2884508">Well-Known Text</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51081_2884330_2884509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Open Geospatial Consortium (OGC) standard that is used to represent spatial data in a textual format.</descrip></descripGrp><ntig><termGrp><term id="2884330">WKT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2884509">WKT</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51084_2884366_2885082"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key that authorizes access to a particular LUIS app.</descrip></descripGrp><ntig><termGrp><term id="2884366">endpoint key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2885082">кључ за крајњу тачку</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51085_2884369_2885083"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the service to return a question together with an answer, allowing the creation of conversations with multiple turns.</descrip></descripGrp><ntig><termGrp><term id="2884369">follow-up prompt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2885083">додатни упит</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51086_2884373_2885088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chat bot conversation to answer a user question that can't be answered in a single turn, as the question needs to be refined to determine the correct answer.</descrip></descripGrp><ntig><termGrp><term id="2884373">multi-turn conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2885088">разговор са потпитањима</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51087_2884374_2885081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in QnA Maker that allows you to add pre-populated conversation data sets into your knowledge base to make your bot more conversational and engaging.</descrip></descripGrp><ntig><termGrp><term id="2884374">chit-chat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2885081">необавезан разговор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51088_2884375_2885092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a QnA Maker knowledge base, a question and its respective answer and all the information associated with that answer.</descrip></descripGrp><ntig><termGrp><term id="2884375">QnA pair</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2885092">пар питање–одговор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51088_2884376_2885092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a QnA Maker knowledge base, a question and its respective answer and all the information associated with that answer.</descrip></descripGrp><ntig><termGrp><term id="2884376">question-and-answer pair</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2885092">пар питање–одговор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51089_2884377_2885094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A question-and-answer service created using QnA Maker.</descrip></descripGrp><ntig><termGrp><term id="2884377">QnA service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2885094">услуга за питања и одговоре</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51091_2884447_2919581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A new technology introduced with Xbox Series X that identifies the user's Xbox console and delivers the best version of a game for that console, regardless of the console that the game was originally purchased for.</descrip></descripGrp><ntig><termGrp><term id="2884447">Smart Delivery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919581">Smart Delivery</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51091_2884447_2920836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A new technology introduced with Xbox Series X that identifies the user's Xbox console and delivers the best version of a game for that console, regardless of the console that the game was originally purchased for.</descrip></descripGrp><ntig><termGrp><term id="2884447">Smart Delivery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920836">Xbox Smart Delivery</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</t