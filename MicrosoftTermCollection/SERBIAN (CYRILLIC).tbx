Cyrl"><ntig><termGrp><term id="2685607">агрегат</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47582_2678644_2685608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To combine multiple entities and behaviors that can be treated as a cohesive unit.</descrip></descripGrp><ntig><termGrp><term id="2678644">aggregate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2685608">агрегирати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47589_2678875_2681396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data preparation artifact that ingests, transforms, integrates, and enriches big data by defining data source connections, ETL logic, refresh schedules, and more. In other words, a dataflow is a process that defines how the data should flow.</descrip></descripGrp><ntig><termGrp><term id="2678875">dataflow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2681396">ток података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47597_2679308_2680091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that searches a range or an array and returns an item corresponding to the first match, and if a match does not exist the closest match may optionally be returned.</descrip></descripGrp><ntig><termGrp><term id="2679308">XLOOKUP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2680091">XLOOKUP</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47598_2679309_2680092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that searches a range or an array and returns the index of the first match, and if a match does not exist the closest match may optionally be returned.</descrip></descripGrp><ntig><termGrp><term id="2679309">XMATCH</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2680092">XMATCH</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47599_2679310_2680089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that returns the position of the Nth occurrence of a text string within another text string.</descrip></descripGrp><ntig><termGrp><term id="2679310">FINDN</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2680089">FINDN</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="476_3285_1502787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tested, cumulative set of all hotfixes, security updates, critical updates and updates, as well as additional fixes for problems found internally since the release of the product. Service packs may also contain a limited number of customer requested design changes or features, and contain all fixes since the previous service pack or RTM.</descrip></descripGrp><ntig><termGrp><term id="3285">service pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502787">сервисни пакет</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="476_3285_1502788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tested, cumulative set of all hotfixes, security updates, critical updates and updates, as well as additional fixes for problems found internally since the release of the product. Service packs may also contain a limited number of customer requested design changes or features, and contain all fixes since the previous service pack or RTM.</descrip></descripGrp><ntig><termGrp><term id="3285">service pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502788">SP</term><termNote type="geographicalUsage">SRB, BIH</t