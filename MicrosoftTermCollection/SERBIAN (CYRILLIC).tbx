RB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44377_2499540_2501894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Chrome browser extension that allows users to easily view, attach, and share their OneDrive files to anyone with Gmail.</descrip></descripGrp><ntig><termGrp><term id="2499540">Project Copenhagen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2501894">Project Copenhagen</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44378_2499542_2501895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PowerPoint plugin that allows users to post their slides as images, videos, or albums on social media accounts, automatically upload them to OneDrive, and that shows any comments directly in PowerPoint.</descrip></descripGrp><ntig><termGrp><term id="2499542">Social Share</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2501895">Social Share</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44379_2499544_2501893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for Android that allows users to select links, text, and images, save it on their clipboard, and then put it somewhere universally accessible, such as Wunderlist, even from applications that don’t allow selection.</descrip></descripGrp><ntig><termGrp><term id="2499544">Clip Layer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2501893">Clip Layer</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44381_2499977_2501543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Project that includes only basic features such as templates, scheduling, and easy report creation.</descrip></descripGrp><ntig><termGrp><term id="2499977">Project Standard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2501543">Project Standard</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44383_2499978_2501542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The on-premises solution of Project that includes all the Project Standard features and that also includes the ability to call or message team members inside Project and to allocate tasks and resources via drag and drop.</descrip></descripGrp><ntig><termGrp><term id="2499978">Project Professional</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2501542">Project Professional</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44384_2499979_2501545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Visio that includes basic feature such as starter diagrams.</descrip></descripGrp><ntig><termGrp><term id="2499979">Visio Standard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2501545">Visio Standard</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44385_2499980_2501544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Visio that includes all the features of Visio Standard as well as the ability to link diagrams in real time to sources, review and edit other users' diagrams, and to edit and view diagrams at the same time as other users.</descrip></descripGrp><ntig><termGrp><term id="2499980">Visio Professional</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2501544">Visio Professional</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></ter