type="definition">An automated telephone information system that interacts with a caller through fixed voice menus and real-time data from databases.</descrip></descripGrp><ntig><termGrp><term id="694311">IVR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141949">IVR</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20068_694332_2741477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual waiting area where conference call invitees are held before the conference is activated.</descrip></descripGrp><ntig><termGrp><term id="694332">lobby</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2741477">хол</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20077_694377_2776841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To direct a call.</descrip></descripGrp><ntig><termGrp><term id="694377">route</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2776841">усмерити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20093_694568_1978060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To accept an incoming telephone call.</descrip></descripGrp><ntig><termGrp><term id="694568">answer</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1978060">одговорити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20099_694715_1504567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To execute a program.</descrip></descripGrp><ntig><termGrp><term id="694715">run</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504567">извршити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20103_694759_1356306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To combine a series of elements into an individual, larger one, such as a series of photos into one panoramic photo.</descrip></descripGrp><ntig><termGrp><term id="694759">stitch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356306">спојити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20104_694766_1356307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A picture made by combining a series of photos into one large picture to provide a complete view of an area or location that cannot fit in a single shot.</descrip></descripGrp><ntig><termGrp><term id="694766">panoramic photo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356307">панорама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20104_694768_1356307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A picture made by combining a series of photos into one large picture to provide a complete view of an area or location that cannot fit in a single shot.</descrip></descripGrp><ntig><termGrp><term id="694768">panorama</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356307">панорама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20106_694850_767506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The image or avatar someone adds to their profile to represent themselves.</descrip></descripGrp><ntig><termGrp><term id="694850">display picture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="767506">слика за приказ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20108_695050_2542233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style sheet (a .css file) attached to an HTML document that controls the formatting of tags on Web pages. The browser follows rules (a "cascading order") to determine precedence and resolve conflicts.</descrip></descripGrp><ntig><termGrp><term id="695050">cascading style sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542233">каскадни опис стила</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2012_357288_1502965"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical control used to display text.</descrip></descripGrp><ntig><termGrp><term id="357288">label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502965">ознака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20125_700660_1985664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Meeting an organization's various obligations, which may arise from laws, regulations, rules, and many other legal instruments, such as court judgments, litigation, and even contracts. Specific and important examples of these obligations include the Sarbanes-Oxley Act (SOX) and the California Law on Notice of Security Breach, formerly known as SB-1386. These regulatory obligations may be created by many sources, such as national and local governments and from industry-specific oversight groups, such as the Payment Card Industry Data Security Standards.</descrip></descripGrp><ntig><termGrp><term id="700660">compliance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1985664">усаглашеност</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20126_700661_1985665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Person responsible for ensuring that an organization complies with the various regulations and standards that are imposed by government and other regulatory bodies.</descrip></descripGrp><ntig><termGrp><term id="700661">compliance officer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1985665">службеник за област поштовања регулатива</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20127_700662_1356308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of communications (email, IM, text messaging, voice mail, and so on) between two or more participants.</descrip></descripGrp><ntig><termGrp><term id="700662">conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356308">разговори</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20127_700662_1504568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of communications (email, IM, text messaging, voice mail, and so on) between two or more participants.</descrip></descripGrp><ntig><termGrp><term id="700662">conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504568">конверзација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20129_1810820_1527849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short alphanumeric message that is sent between mobile phones or devices using the SMS protocol.</descrip></descripGrp><ntig><termGrp><term id="1810820">text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1527849">текстуална порука</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</