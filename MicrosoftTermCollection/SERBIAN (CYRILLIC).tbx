Usage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48585_2748571_2756051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The function browser that allows users to add AI-driven enrichment steps to their queries.</descrip></descripGrp><ntig><termGrp><term id="2748571">AI Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2756051">Увиди вештачке интелигенције</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48586_2748572_2757836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI element with a navigator-like experience that allows you to select functions and apply them to their base formula.</descrip></descripGrp><ntig><termGrp><term id="2748572">function browser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2757836">прегледач функција</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48588_2748848_2750443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change a message filter verdict and move an unread message after it has been deemed appropriate and delivered, as performed by ZAP.</descrip></descripGrp><ntig><ter