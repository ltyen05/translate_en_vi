<termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39256_2277617_2289654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pane that holds cross-suite experiences including global notifications, Skype for business conversations, a notification pane, the ​What's New container, and that stays open as long as the user keeps it open even across page navigation.</descrip></descripGrp><ntig><termGrp><term id="2277617">flex pane</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2289654">Прилагодљиво окно</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39262_2277731_2277812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power BI application that allows you create a collection of queries, data connections, and reports that can easily be shared with others.</descrip></descripGrp><ntig><termGrp><term id="2277731">Power BI Desktop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2277812">Power BI Desktop</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39267_2277931_2280397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to bookmark webpages and articles to read later.</descrip></descripGrp><ntig><termGrp><term id="2277931">reading list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2280397">листа за читање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39268_2277946_2315671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit in the Office Graph that represents a connection between one entity and another, or a relationship between entities.</descrip></descripGrp><ntig><termGrp><term id="2277946">Office Graph edge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2315671">Office Graph грана</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39269_2277947_2315675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit in the Office Graph that represents an entity, an action or a relationship between people, items, and people and items across Office 365.</descrip></descripGrp><ntig><termGrp><term id="2277947">Office Graph node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2315675">Office Graph чвор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39270_2277948_2315631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of Office Graph node that represents actual entities in the Office Graph, such as a person or a document.</descrip></descripGrp><ntig><termGrp><term id="2277948">entity node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2315631">чвор ентитета</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39271_2277949_2318318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of Office Graph node that represents a relationship between two or more nodes with their own set of properties in the Office Graph.</descrip></descripGrp><ntig><termGrp><term id="2277949">relationship node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2318318">чвор односа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39272_2277950_2315625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of relationship node that represents an action performed by a person entity in the Office Graph.</descrip></descripGrp><ntig><termGrp><term id="2277950">action node</term><termNote type="partOfSpeech">Noun</termNote><termNote