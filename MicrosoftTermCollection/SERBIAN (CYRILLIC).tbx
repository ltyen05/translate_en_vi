</langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918743">водич</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42783_2427900_2919359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The levers on the underside of the Xbox Elite Wireless Controller.</descrip></descripGrp><ntig><termGrp><term id="2427900">paddle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919359">лопатица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42784_2427902_2919525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An award for successful completion of a challenge.</descrip></descripGrp><ntig><termGrp><term id="2427902">reward</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919525">награда</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42785_2427908_2920104"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optional descriptive label in a Looking for Group post to help people have specific kinds of experiences in Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="2427908">tag</term><termNote type="partO