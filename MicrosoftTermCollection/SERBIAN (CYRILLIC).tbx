pe="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504664">освијетлити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21416_776728_1051303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of account that allows customers to use a limited set of Windows Live services without signing up for a new email address or providing an existing alternate one. The ID that is created can't be used to send or receive email. A customer with this account type can only reset their password if they subsequently add an alternate email address to their account.</descrip></descripGrp><ntig><termGrp><term id="776728">limited account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051303">ограничени налог</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21417_777441_1504665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that enables users to share pictures, music, videos, documents, and printers with other people on a home network.</descrip></descripGrp><ntig><termGrp><term id="777441">Windows HomeGroup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504665">кућна група</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21417_779020_1504665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that enables users to share pictures, music, videos, documents, and printers with other people on a home network.</descrip></descripGrp><ntig><termGrp><term id="779020">HomeGroup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504665">кућна група</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21430_3007378_3010883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to draw an irregular line, such as a circle or a triangle, around an object that you want to capture.</descrip></descripGrp><ntig><termGrp><term id="3007378">Free-form mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3010883">Режим слободног облика</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21430_777464_3010883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to draw an irregular line, such as a circle or a triangle, around an object that you want to capture.</descrip></descripGrp><ntig><termGrp><term id="777464">Free-form Snip</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3010883">Режим слободног облика</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21431_3007379_3010884"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to capture the entire screen, similar to pressing PRINT SCREEN.</descrip></descripGrp><ntig><termGrp><term id="3007379">Full-screen mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3010884">Режим целог екрана</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21431_777465_3010884"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to capture the entire screen, similar to pressing PRINT SCREEN.</descrip></descripGrp><ntig><termGrp><term id="777465">Full-screen Snip</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3010884">Режим целог екрана</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21438_3007380_3010886"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to draw a precise line, or rectangle, around an object that you want to capture.</descrip></descripGrp><ntig><termGrp><term id="3007380">Rectangle mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3010886">Режим правоугаоника</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21438_777472_3010886"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to draw a precise line, or rectangle, around an object that you want to capture.</descrip></descripGrp><ntig><termGrp><term id="777472">Rectangular Snip</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3010886">Режим правоугаоника</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21439_3007381_3010912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to select a window, such as a browser window or dialog box, that you want to capture.</descrip></descripGrp><ntig><termGrp><term id="3007381">Window mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig