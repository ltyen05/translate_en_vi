540">Група за заштиту клијената</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53689_3056785_3057534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A badge displayed on a profile image to identify a champion.</descrip></descripGrp><ntig><termGrp><term id="3056785">champion badge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3057534">беџ шампиона</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5369_34870_1503384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special symbol that breaks a column when inserted into a document. It ends the current column and starts the next column.</descrip></descripGrp><ntig><termGrp><term id="34870">column break</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503384">прекид колоне</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53690_3056787_3060771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, pertaining to a development method that uses a drag-and-drop approach and doesn’t require any coding knowledge.</descrip></descri