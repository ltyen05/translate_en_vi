_3060430_3067219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transition effect placed at the beginning of a video clip that gradually increases the visibility of the image or the sound of an audio track.</descrip></descripGrp><ntig><termGrp><term id="3060430">fade in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3067219">постепено појављивање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53744_3060431_3067219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transition effect placed at the beginning of a video clip that gradually increases the visibility of the image or the sound of an audio track.</descrip></descripGrp><ntig><termGrp><term id="3060431">fade-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3067219">постепено појављивање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53745_3060432_3067220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transition effect placed at the end of a video clip that gradually decreases the visibility of the image or the sound of an audio track.</descrip></descripGrp><ntig><termGrp><term id="3060432">fade out</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lan