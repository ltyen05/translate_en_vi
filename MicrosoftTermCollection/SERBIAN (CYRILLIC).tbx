scripGrp><descrip type="definition">To mark specific videos to ensure that they appear on the Microsoft Stream portal when users log in.</descrip></descripGrp><ntig><termGrp><term id="2862647">spotlight</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2863738">издвојити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50558_2862648_2863729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The page showing new and trending content within a Microsoft Stream group.</descrip></descripGrp><ntig><termGrp><term id="2862648">Highlights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2863729">Истакнути садржаји</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50559_2862649_2863739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of renewing one's energy over the course of a full night's sleep.</descrip></descripGrp><ntig><termGrp><term id="2862649">nightly recharge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2863739">ноћни опоравак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50560_2862871_2864022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the UI in which the user can store interface elements such as links to apps, folders, or messages in order to keep them in an easily accessible location.</descrip></descripGrp><ntig><termGrp><term id="2862871">dock</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2864022">панел са алаткама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50568_2863799_2864359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of topics connected through shared resources and contributors that combines AI with human moderation to help your organization learn about itself.</descrip></descripGrp><ntig><termGrp><term id="2863799">knowledge network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2864359">мрежа знања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50570_2864253_2866899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A growing catalog of cloud apps that are ranked and scored based on industry standards.</descrip></descripGrp><ntig><termGrp><term id="2864253">cloud app catalog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2866899">каталог апликација у облаку</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50571_2864257_2866901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A metric that measures the net adds of customers meeting specified criteria during a reporting period.</descrip></descripGrp><ntig><termGrp><term id="2864257">customer adds</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2866901">додати клијенти</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50572_2864258_2864536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A daily personalized email sent by Cortana to Office 365 users containing tasks and commitments made by the user, a summary of the user's meetings, and relevant documents for the user's day, all using information extracted from the user's Office 365 messages.</descrip></descripGrp><ntig><termGrp><term id="2864258">Cortana Briefing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2864536">Cortana сажети преглед</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50572_2864258_2864537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A daily personalized email sent by Cortana to Office 365 users containing tasks and commitments made by the user, a summary of the user's meetings, and relevant documents for the user's day, all using information extracted from the user's Office 365 messages.</descrip></descripGrp><ntig><termGrp><term id="2864258">Cortana Briefing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2864537">Cortana е-пошта са сажетим прегледом</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50572_2864259_2864536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A daily personalized email sent by Cortana to Office 365 users containing tasks and commitments made by the user, a summary of the user's meetings, and relevant documents for the user's day, all using information extracted from the user's Office 365 messages.</descrip></descripGrp><ntig><termGrp><term id="2864259">Cortana Briefing email</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2864536">Cortana сажети преглед</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50572_2864259_2864537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A daily personalized email sent by Cortana to Office 365 users containing tasks and commitments made by the user, a summary of the user's meetings, and relevant documents for the user's day, all using information extracted from the user's Office 365 messages.</descrip></descripGrp><ntig><termGrp><term id="2864259">Cortana Briefing email</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2864537">Cortana е-пошта са сажетим прегледом</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50578_2864897_2865430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that protects sensitive information on disk and makes it inaccessible to attackers when the device is locked using encryption keys that are temporarily wiped from the device and only made available when the device is unlocked.</descrip></descripGrp><ntig><termGrp><term id="2864897">personal information encryption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2865430">шифровање личних информација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50578_2864898_2865430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that protects sensitive information on disk and makes it inaccessible to attackers when the device is locked using encryption keys that are temporarily wiped from the device and only made available when the device is unlocked.</descrip></descripGrp><ntig><termGrp><term id="2864898">Data Protection under Lock</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2865430">шифровање личних информација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50578_2864899_2865430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that protects sensitive information on disk and makes it inaccessible to attackers when the device is locked using encryption keys that are temporarily wiped from the device and only made available when the device is unlocked.</descrip></descripGrp><ntig><termGrp><term id="2864899">DPL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2865430">шифровање личних информација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50579_2864948_2865431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option in Microsoft Photos that allows the user to adjust the brightest part of a photo to be either darker or brighter.</descrip></descripGrp><ntig><termGrp><term id="2864948">Highlights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><t