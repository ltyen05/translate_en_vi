rmNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1669420">интернет</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21098_766643_1692418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The worldwide collection of networks and gateways that use the TCP/IP suite of protocols to communicate with one another.</descrip></descripGrp><ntig><termGrp><term id="766643">mesh</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1692418">облак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21104_766799_1504623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of computing resources such as programs and virtual desktops that enable a user to accomplish a set of related tasks.</descrip></descripGrp><ntig><termGrp><term id="766799">workspace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504623">радни сто</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21106_766801_1504624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The entity that offers a remote workspace, typically the IT department of the user’s employer, a business partner or vendor, or less commonly, a commercial application service provider. The publisher may use a digital certificate to represent its identity and use it to sign the remote resource files (e.g. RDP files) and the workspace description (e.g. Web Service feed).</descrip></descripGrp><ntig><termGrp><term id="766801">publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504624">издавач</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2111_182603_765573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A potential customer for a product that is not yet qualified as a sales opportunity.</descrip></descripGrp><ntig><termGrp><term id="182603">lead</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="765573">потенцијални клијент</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2111_343661_765573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A potential customer for a product that is not yet qualified as a sales opportunity.</descrip></descripGrp><ntig><termGrp><term id="343661">sales lead</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="765573">потенцијални клијент</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2111_639053_765573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A potential customer for a product that is not yet qualified as a sales opportunity.</descrip></descripGrp><ntig><termGrp><term id="639053">customer lead</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="765573">потенцијални клијент</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21113_766809_1504625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Silent and unexpected process termination by the process itself or by another application.</descrip></descripGrp><ntig><termGrp><term id="766809">silent process exit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504625">тихо завршавање процеса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21114_766811_1504626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To shut down a core processor for power saving purpose.</descrip></descripGrp><ntig><termGrp><term id="766811">park</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504626">привремено гашење главног процесора</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21115_766812_1504627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reopen a core processor that had been parked for power saving purpose.</descrip></descripGrp><ntig><termGrp><term id="766812">unpark</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504627">паљење привремено угашеног главног процесора</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21116_766813_1504628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows Media Player that allows users to remove gaps between tracks that they burn to audio CDs.</descrip></descripGrp><ntig><termGrp><term id="766813">gapless CD burning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504628">снимање без паузи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21116_766816_1504628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows Media Player that allows users to remove gaps between tracks that they burn to audio CDs.</descrip></descripGrp><ntig><termGrp><term id="766816">gapless burning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504628">снимање без паузи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21117_766814_1504629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Existing in reference to the removal of silences or clicks between tracks when they are burnt to an audio CD or when they are played back from the CD.</descrip></descripGrp><ntig><termGrp><term id="766814">gapless</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504629">без паузи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21120_766842_1504630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifier made from four otherwise separate pieces of information. For example, a color can be specified by a black, yellow, magenta and cyan quad.</descrip></descripGrp><ntig><termGrp><term id="766842">quad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></te