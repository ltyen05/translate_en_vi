rmNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2528076">апстракт</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26007_1256417_1523662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cache that is used internally to optimize page rendering by storing properties of sites, page layouts, and pages. It reduces the amount of traffic between the Web server and a SQL database. This results in higher throughput of rendered pages, thereby increasing the number of pages that can be delivered to clients.</descrip></descripGrp><ntig><termGrp><term id="1256417">object cache</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523662">кеш објекта</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26032_1260271_1361783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Silverlight, an integrated set of types and methods that enable you to expose managed types to JavaScript and call JavaScript event handlers from managed types.</descrip></descripGrp><ntig><termGrp><term id="1260271">HTML Bridge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1361783">HTML мост</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26033_1260272_1361779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Silverlight, a technology that enables users to interactively view high-resolution images. With Deep Zoom, users can zoom in, zoom out, and pan images rapidly.</descrip></descripGrp><ntig><termGrp><term id="1260272">Deep Zoom</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1361779">технологија „Deep Zoom“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26034_1260273_1361788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Silverlight, an out-of-browser application to which a user grants elevated trust upon installation, providing greater access to the local system.</descrip></descripGrp><ntig><termGrp><term id="1260273">trusted application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1361788">поуздана апликација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26035_1260274_1361787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Silverlight, an in-browser application or an out-of-browser application that has not been granted elevated trust.</descrip></descripGrp><ntig><termGrp><term id="1260274">sandboxed application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1361787">апликација ограничене поузданости</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26036_1260275_1361781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Silverlight, a security level that gives out-of-browser applications greater access to the local system.</descrip></descripGrp><ntig><termGrp><term id="1260275">elevated trust</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1361781">поузданост са пуним привилегијама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26040_1261181_2745035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The running operation or execution of logic for the computing resources that your application runs on.</descrip></descripGrp><ntig><termGrp><term id="1261181">compute</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2745035">израчунавање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</te