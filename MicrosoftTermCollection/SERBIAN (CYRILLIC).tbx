"><descripGrp><descrip type="definition">A distinct chunk of text that is indicated by formatting such as indentation, numbering, or a new line.</descrip></descripGrp><ntig><termGrp><term id="90627">paragraph</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2529517">пасус</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1687_396923_406517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A non-delivery notification that is sent to an email sender when a message cannot be delivered to the intended recipient either temporarily or permanently.</descrip></descripGrp><ntig><termGrp><term id="396923">bounce message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406517">порука о неиспоручивању</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16877_625739_2141919"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account entry that typically increases liabilities, owners' equity, or income, and decreases assets or expenses.</descrip></descripGrp><ntig><termGrp><term id="625739">credit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141919">кредит</term><termNote type="geographicalUsage">SRB, BIH</termNote><t