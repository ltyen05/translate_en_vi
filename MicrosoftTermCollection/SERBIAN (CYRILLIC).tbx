ig><termGrp><term id="3019769">Sound Recorder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2160435">Windows диктафон</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37771_3019769_3020421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app used to record sounds with the device's microphone and to record phone calls.</descrip></descripGrp><ntig><termGrp><term id="3019769">Sound Recorder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3020421">Снимач звука</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37771_3019769_3020422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app used to record sounds with the device's microphone and to record phone calls.</descrip></descripGrp><ntig><termGrp><term id="3019769">Sound Recorder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3020422">Windows снимач звука</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37772_2157392_2249839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The behavior property of a Date and Time attribute where field values are displayed in the user’s local time.</descrip></descripGrp><ntig><termGrp><term id="2157392">User Local</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2249839">Локално време корисника</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37773_2157393_2249824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The behavior property of a Date and Time attribute where the date portion of the value is as specified in the UI and SDK and the time portion of the value is always 12:00 A.M.</descrip></descripGrp><ntig><termGrp><term id="2157393">Date Only</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2249824">Само датум</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37774_2157394_2249837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The behavior property of a Date and Time attribute where field values are displayed with no time zone conversion.</descrip></descripGrp><ntig><termGrp><term id="2157394">Time-Zone Independent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2249837">Независно од временске зоне</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37775_2157422_2160406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo that illustrates action by blending multiple frames of a short video to create a strobe effect in the resulting still image.</descrip></descripGrp><ntig><termGrp><term id="2157422">action shot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2160406">снимак акције</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37777_2157424_2160410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature for taking photos in low light, capturing both short and long exposure images. The user can dynamically blend the two exposures afterwards, as preferred</descrip></descripGrp><ntig><termGrp><term id="2157424">dynamic exposure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2160410">динамичка експозиција</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37778_2157425_2160411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode for taking photos that automatically captures images with and without flash. The user can choose the amount of flash in the photo after it has been taken.</descrip></descripGrp><ntig><termGrp><term id="2157425">dynamic flash</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2160411">динамички блиц</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37779_2157426_2160413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image file type in which a very short video is followed by a transition to a still image. The combination of video and still image captures the essence of the moment.</descrip></descripGrp><ntig><termGrp><term id="2157426">living image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2160413">Покретна слика</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37780_2157427_2160423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo that illustrates motion by blurring together multiple frames of a short video to create the effect of motion in the still image.</descrip></descripGrp><ntig><termGrp><term id="2157427">motion focus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2160423">ефекат кретања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37781_2157428_2160426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The top level view in File Explorer that shows the user's most frequently used and most recently used files and folders or folders pinned by the user for quick access.</descrip></descripGrp><ntig><termGrp><term id="2157428">Quick access</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2160426">Брзи приступ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37782_2157429_2160427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides unending stream of music based not on the user's library, but on an artist or song selected by the user.</descrip></descripGrp><ntig><termGrp><term id="2157429">Radio</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2160427">Радио</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37783_2157430_2160429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suggested content that is displayed on different surface areas in the operating system. Content can range from tips and tricks, a link to other content, an app, etc.</descrip></descripGrp><ntig><termGrp><term id="2157430">Suggestions for you</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2160429">Предлози за вас</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37784_2157431_2160412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interval of time that it takes to complete a circuit in a race or exercise course, which the user can record with a stopwatch.</descrip></descripGrp><ntig><termGrp><term id="2157431">lap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2160412">круг</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37785_2157432_2160428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The total amount of time up to a given point that the user marks while using the stopwatch. After marking a split, the stopwatch continues running in the background.</descrip></descripGrp><ntig><termGrp><term id="2157432">split</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2160428">међувреме</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37785_2157432_2177483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The total amount of time up to a given point that the user marks while using the stopwatch. After marking a split, the stopwatch continues running in the background.</descrip></descripGrp><ntig><termGrp><term id="2157432">split</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2177483">међувријеме</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37786_2157433_2160407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that enables app publishers to send ad requests to multiple ad networks to ensure that publishers can match the right ad networks to the right inventory and maximize the ad revenue.</descrip></descripGrp><ntig><termGrp><term id="2157433">ad mediation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2160407">медијација огласа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37787_2158519_2208748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ID that is given to an app developer by a software system supporting custom apps when the developer registers their app with the software system.</descrip></descripGrp><ntig><termGrp><term id="2158519">client ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2208748">ID клијента</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37788_2158520_2208784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solicitation of ideas or content from a large group of people, generally from an online community.</descrip></descripGrp><ntig><termGrp><term id="2158520">crowdsourcing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2208784">краудсорсинг</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37790_2158530_2208786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A daily summary of new messages posted by a group that a user belongs to.</descrip></descripGrp><ntig><termGrp><term id="2158530">daily digest</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2208786">дневни сажетак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37791_2158845_2208794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button in Yammer that allows a group administrator to deny access to a particular group of users that have requested access to that group.</descrip></descripGrp><ntig><termGrp><term id="2158845">Deny</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2208794">Одбиј</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37792_2158857_2208792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button in Yammer that allows a user to refuse a network invitation.</descrip></descripGrp><ntig><termGrp><term id="2158857">Decline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2208792">Одбиј</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37793_2158861_2208810"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Yammer feature that automatically synchronizes a company's directory with its Yammer network so that additions and deletions appear in Yammer.</descrip></descripGrp><ntig><termGrp><term id="2158861">Yammer Directory Sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNum