lang="en-US"><descripGrp><descrip type="definition">An attack in which attackers attempt to increase existing privileges and use them multiple times in order to eventually gain full control over the victim’s environment.</descrip></descripGrp><ntig><termGrp><term id="2512914">privilege escalation attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2731112">напад путем повећања привилегија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44646_2897501_3088167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that helps protect your enterprise hybrid environments from multiple types of advanced targeted cyber attacks and insider threats.</descrip></descripGrp><ntig><termGrp><term id="2897501">Microsoft Defender for Identity</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3088167">Microsoft Defender за идентитет</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44647_2513424_2518195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To take an existing story in the Photos app and generate a new version of that story with edits to content, style, music, and other options.​</descrip></descripGrp><ntig><termGrp><term id="2513424">remix</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber