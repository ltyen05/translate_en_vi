2_1725976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An assignment property that indicates whether grades for the assignment are numeric or non-numeric.</descrip></descripGrp><ntig><termGrp><term id="1698172">Grade Values</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1725976">Вредности оцена</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32741_1698172_1917433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An assignment property that indicates whether grades for the assignment are numeric or non-numeric.</descrip></descripGrp><ntig><termGrp><term id="1698172">Grade Values</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917433">Вриједност оцјена</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32747_1698384_1708184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remotely view, stream, or copy files stored on a PC running OneDrive from any other device.</descrip></descripGrp><ntig><termGrp><term id="1698384">fetch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1708184">дохватити</term><termNote type="geographicalUsage">SRB, BIH</termNote