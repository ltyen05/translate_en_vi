rack the protection status of an organization’s identities, data, devices, apps, and infrastructure.</descrip></descripGrp><ntig><termGrp><term id="2735736">Monitoring &amp; reports</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2738308">Надгледање и извештаји</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48405_2736256_2740139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that initiates a proactive search for security threats.</descrip></descripGrp><ntig><termGrp><term id="2736256">Start hunting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2740139">Започни потрагу за претњама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48405_2736256_2924950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that initiates a proactive search for security threats.</descrip></descripGrp><ntig><termGrp><term id="2736256">Start hunting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2924950">Започни потрагу за пријетњама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote