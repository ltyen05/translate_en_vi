 place using the Microsoft statistical machine translation system.</descrip></descripGrp><ntig><termGrp><term id="1508843">Bing Bar Translator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1787283">Преводилац Bing траке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29480_1508864_1917230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contiguous piece of text or string of characters sharing the same attributes. All characters in a run have the same directional properties.</descrip></descripGrp><ntig><termGrp><term id="1508864">run</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917230">низ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29480_1508864_2542356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contiguous piece of text or string of characters sharing the same attributes. All characters in a run have the same directional properties.</descrip></descripGrp><ntig><termGrp><term id="1508864">run</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542356">линија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><ter