lash memory, that provides nonvolatile storage with benefits of performance, reliability and power saving.</descrip></descripGrp><ntig><termGrp><term id="1042105">solid-state drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504717">SSD</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22319_1054003_1504717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A primary storage device based on solid-state memory, such as flash memory, that provides nonvolatile storage with benefits of performance, reliability and power saving.</descrip></descripGrp><ntig><termGrp><term id="1054003">SSD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504717">SSD</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22319_2611333_1504717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A primary storage device based on solid-state memory, such as flash memory, that provides nonvolatile storage with benefits of performance, reliability and power saving.</descrip></descripGrp><ntig><termGrp><term id="2611333">SSD disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504717">SSD</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22328_1042566_2749923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security attack that takes advantage of computer security holes for which no solution is yet available.</descrip></descripGrp><ntig><termGrp><term id="1042566">zero-day attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2749923">напад на нулти дан</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22328_1042568_2749923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security attack that takes advantage of computer security holes for which no solution is yet available.</descrip></descripGrp><ntig><termGrp><term id="1042568">zero day attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2749923">напад на нулти дан</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22328_2747277_2749923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security attack that takes advantage of computer security holes for which no solution is yet available.</descrip></descripGrp><ntig><termGrp><term id="2747277">0-day attack</t