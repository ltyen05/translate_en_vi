n">In an online forum, such as a newsgroup, a series of messages or articles in which replies to a message are nested directly under it instead of arranged in chronological or alphabetical order.</descrip></descripGrp><ntig><termGrp><term id="121418">threaded discussion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916633">разговор у нити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12363_121418_2541566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an online forum, such as a newsgroup, a series of messages or articles in which replies to a message are nested directly under it instead of arranged in chronological or alphabetical order.</descrip></descripGrp><ntig><termGrp><term id="121418">threaded discussion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541566">ток дискусије</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12363_648609_1916633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an online forum, such as a newsgroup, a series of messages or articles in which replies to a message are nested directly under it instead of arranged in chronological or alphabetical order.</descrip></descripGrp><ntig><termGrp><term id="648609">discussion thread</term><termNote type="partOfSpeech">Noun</termNote><termNote type