lang="en-US"><descripGrp><descrip type="definition">A modal, custom pop-up form that asks users for additional information or to display a message.</descrip></descripGrp><ntig><termGrp><term id="139790">custom dialog box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541753">прилагођени дијалог</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50087_2834936_2864877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that provides Microsoft Azure customers with a personalized view into carbon emissions data associated with Azure services.</descrip></descripGrp><ntig><termGrp><term id="2834936">Microsoft Sustainability Calculator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2864877">Microsoft Sustainability Calculator</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50089_2834942_2836266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Outlook for mobile that helps users listen, triage and reply to emails while on the go (such as when travelling in a car).</descrip></descripGrp><ntig><termGrp><term id="2834942">Play My Emails</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836266">Репродукуј моје е-поруке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50090_2834944_2836263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Excel for the web that enables users to create, run and record automated scripts in Excel and use them across platforms. By creating an Office Script, users can create background tasks that run automatically in the cloud and update their spreadsheet automatically, enabling information to continuously be up-to-date with no action required on the user's part. This helps users to run their businesses more efficiently anytime and anywhere - without needed coding knowledge.</descrip></descripGrp><ntig><termGrp><term id="2834944">Office Scripts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836263">Office скрипте</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50091_2834946_2836252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Set of audit features and capabilities offered within our Microsoft 365 E3 SKU. These include providing audit logs of high-level events to help compliance reporting needs and additional features from new non-Office 365 products such as Microsoft Defender Advanced Threat Protection.</descrip></descripGrp><ntig><termGrp><term id="2834946">Audit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836252">Надзор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50092_2834947_2836254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template within Advanced eDiscovery that enables compliance officers to monitor communications for certain roles within the organization, making it easier to meet regulatory requirements or internal policies.</descrip></descripGrp><ntig><termGrp><term id="2834947">Communication compliance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836254">Усаглашеност комуникације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50093_2834948_2836253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 feature that calls out a person’s most important to-dos and consolidates them in one convenient email to help the person better prepare for the day ahead (or specific part of the day/week depending on the settings for receiving email).</descrip></descripGrp><ntig><termGrp><term id="2834948">Briefing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836253">Брифинг</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50094_2834949_2836257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft Teams, a digital bulletin board where you can pin notes, ideas, and inspiration to share in your team space.</descrip></descripGrp><ntig><termGrp><term id="2834949">Corkboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836257">Плутана табла</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50095_2834950_2836264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that work across tenant (and hybrid) boundaries, including cross-tenant people search, cross-tenant identity and data migration and data migration to/from on-premises deployments.</descrip></descripGrp><ntig><termGrp><term id="2834950">Organization Relationships</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836264">Релације у организацији</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50096_2834951_2836260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An offering/program that gives end users the ability to get the full Microsoft Teams experience that their company may already have for other licensed users in their organization.</descrip></descripGrp><ntig><termGrp><term id="2834951">Microsoft Teams Exploratory</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836260">Microsoft Teams Exploratory</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50097_2834952_2836258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within the Microsoft 365 security portfolio that helps prevent inappropriate or accidental copying or sharing of sensitive information that lives on endpoints (i.e. devices, specifically Windows 10 devices).</descrip></descripGrp><ntig><termGrp><term id="2834952">Endpoint Data Loss Prevention</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836258">Спречавање губитка података крајње тачке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50098_2834953_2836272"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within Microsoft Outlook and Microsoft Teams that helps users quickly close the loop on an e-mail, either by sending a quick response or by taking a suggested action, such as scheduling a meeting, creating a task, sending a file etc.</descrip></descripGrp><ntig><termGrp><term id="2834953">Suggested Actions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836272">Предложене радње</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50098_2834953_2837284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within Microsoft Outlook and Microsoft Teams that helps users quickly close the loop on an e-mail, either by sending a quick response or by taking a suggested action, such as scheduling a meeting, creating a task, sending a file etc.</descrip></descripGrp><ntig><termGrp><term id="2834953">Suggested Actions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2837284">Предложене акције</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50099_2834954_2836262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device-based license of Office 365 that will allow commercial IT admins to assign an Office 365 ProPlus license to a device rather than to a user with an AAD identity. This solution provides a device-based subscription model that mirrors the user-based subscription model in ease of management and sign-in.</descrip></descripGrp><ntig><termGrp><term id="2834954">Office 365 ProPlus (device)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836262">Office 365 ProPlus (уређај)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="501_140730_1916681"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The range of cells that you select to hold the summarized data in a consolidation. The destination area can be on the same worksheet as the source data or on a different worksheet. A worksheet can contain only one consolidation.</descrip></descripGrp><ntig><termGrp><term id="140730">destination area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916681">одредишно подручје</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="501_140730_2527513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The range of cells that you select to hold the summarized data in a consolidation. The destination area can be on the same worksheet as the source data or on a different worksheet. A worksheet can contain only one consolidation.</descrip></descripGrp><ntig><termGrp><term id="140730">destination area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527513">одредишна област</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50100_2834955_2836268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within Microsoft Teams that helps a teacher make a Reading Assignment, lets the student record themselves reading, and then submit to the teacher for miscue analysis. Additionally, the computer will “listen” to the person read, and then gives computer generated “miscue analysis” feedback automatically to the teacher.</descrip></descripGrp><ntig><termGrp><term id="2834955">Reading Progress</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836268">Напредак у читању</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50101_2834956_2836270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of a podcast that will provide stories and advice from experts in the trenches, and give listeners access to the best of security analytics, security personalities, and security researchers.</descrip></descripGrp><ntig><termGrp><term id="2834956">Security Unlocked</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836270">Безбедност без тајни</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834957_2836251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834957">MSIX app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836251">придодавање апликације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834957_2836261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834957">MSIX app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836261">придодавање MSIX апликације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834957_2843729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834957">MSIX app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2843729">придодавање апликација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834957_2843733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834957">MSIX app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2843733">придодавање MSIX апликација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834958_2836251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834958">app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836251">придодавање апликације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834958_2836261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834958">app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836261">придодавање MSIX апликације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834958_2843729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834958">app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2843729">придодавање апликација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834958_2843733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834958">app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2843733">придодавање MSIX апликација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50103_2834961_2836259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service offering that enables enterprise customers to become the controller (GDPR) for Windows diagnostic data collected from devices enrolled under this service. With this service, data will be governed by Microsoft’s Online Services Terms, and stored in a high compliance boundary, separate from Windows diagnostic data that Microsoft collects as controller.</descrip></descripGrp><ntig><termGrp><term id="2834961">Enterprise Data Processor Service for Windows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836259">Enterprise Data Processor Service for Windows</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50104_2834962_2836271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability that enables users to quickly take a 1-3 minute video from their mobile device and share it to their online community platform with the press of a button.</descrip></descripGrp><ntig><termGrp><term id="2834962">short video</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836271">кратки видео</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50105_2834963_2836269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 feature that detects when a reply-all or conversation mail storm is brewing in your mail service and temporarily blocks subsequent reply-alls to the thread while issuing a bounce back message (NDR) to the sender who is attempting to reply all. After a "cool down" period (e.g. 2 to 4 hours), the feature will remove the block and allow emails on the thread again (some exceptions can be made during the cool down).</descrip></descripGrp><ntig><termGrp><term id="2834963">Reply-All Storm Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2836269">Заштита од масовног слања е-поште путем функције „Одговори свима“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50105_2834963_2837282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 feature that detects when a reply-all or conversation mail storm is brewing in your mail service and temporarily blocks subsequent reply-alls to the thread while issuing a bounce back message (NDR) to the sender who is attempting to reply all. After a "cool down" period (e.g. 2 to 4 hours), the feature will remove the block and allow emails on the thread again (some exceptions can be made during the cool down).</descrip></descripGrp><ntig><termGrp><term id="2834963">Reply-All Storm Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2837282">Заштита од олује код опције "Одговори свима"</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50106_2834964_2862158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The metric that measures invoiced Azure usage with adjustments for fraud and credit offers.</descrip></descripGrp><ntig><termGrp><term id="2834964">Azure Consumed Revenue</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2862158">ACR</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50106_2834964_2862161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The metric that measures invoiced Azure usage with adjustments for fraud and credit offers.</descrip></descripGrp><ntig><termGrp><term id="2834964">Azure Consumed Revenue</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2862161">приход од употребе услуге Azure</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50106_2834965_2862158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The metric that measures invoiced Azure usage with adjustments for fraud and credit offers.</descrip></descripGrp><ntig><termGrp><term id="2834965">ACR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2862158">ACR</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50106_2834965_2862161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The metric that measures invoiced Azure usage with adjustments for fraud and credit offers.</descrip></descripGrp><ntig><termGrp><term id="2834965">ACR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2862161">приход од употребе услуге Azure</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50107_2835154_2866902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Related to a sales strategy that enables cust