="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2757830">рационални број</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48689_2753982_2757834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who has access to their team's OneNote and libraries and who share an individual notebook with their staff leader.</descrip></descripGrp><ntig><termGrp><term id="2753982">staff member</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2757834">члан особља</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48691_2754031_2757877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request to get assistance with billing, subscription, technical or quota management issues.</descrip></descripGrp><ntig><termGrp><term id="2754031">support request</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2757877">захтев за подршку</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48692_2754091_2758737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical letter sent to a person requesting a number to verify that he/she resides in the same area where he/she would like to purchase a number.</descrip></descripGrp><ntig><termGrp><term id="2754091">verification letter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2758737">верификационо писмо</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48692_2754091_2766922"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical letter sent to a person requesting a number to verify that he/she resides in the same area where he/she would like to purchase a number.</descrip></descripGrp><ntig><termGrp><term id="2754091">verification letter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2766922">писмо за потврду</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48693_2754106_2764163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disabled user object that can be used to represent and assign resources within Azure, Office 365, and Skype.</descrip></descripGrp><ntig><termGrp><term id="2754106">resource account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2764163">налог ресурса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48693_2754106_2766945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disabled user object that can be used to represent and assign resources within Azure, Office 365, and Skype.</descrip></descripGrp><ntig><termGrp><term id="2754106">resource account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2766945">рачун ресурса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48694_2754396_2758732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kaizala chat feature that allows users to send confidential information in a one-to-one chat more securely by not allowing message content to be forwarded or copied, by blocking messages from showing up in notifications, and by automatically deleting them after they are read.</descrip></descripGrp><ntig><termGrp><term id="2754396">Secret Chat</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2758732">Тајно ћаскање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48694_2754396_2766921"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kaizala chat feature that allows users to send confidential information in a one-to-one chat more securely by not allowing message content to be forwarded or copied, by blocking messages from showing up in notifications, and by automatically deleting them after they are read.</descrip></descripGrp><ntig><termGrp><term id="2754396">Secret Chat</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2766921">Тајни разговор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48695_2754398_2758736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who has been invited by their group admin to download and join Kaizala, but who hasn't.</descrip></descripGrp><ntig><termGrp><term id="2754398">unregistered user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2758736">нерегистровани корисник</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48697_2754411_2758728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Diagnostic Data Viewer setting that allows users to view Office diagnostic data from a different machine.</descrip></descripGrp><ntig><termGrp><term id="2754411">Remote Office diagnostic data viewing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2758728">Даљинско приказивање дијагностичких података за Office</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48698_2754414_2758725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of diagnostic data that is collected and sent to Microsoft about Office client software being used on computers running Windows that is used to keep Office secure and up-to-date, detect, diagnose and remediate problems, as well as to make product improvements.</descrip></descripGrp><ntig><termGrp><term id="2754414">Office diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2758725">дијагностички подаци за Office</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48703_2754422_2758726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Diagnostic Data Viewer setting that allows users to see what Office diagnostic data is being collected.</descrip></descripGrp><ntig><termGrp><term id="2754422">Office diagnostic data viewing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2758726">Приказивање дијагностичких података за Office</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48704_2754423_2758724"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that consists of the IP address of the user's Windows machine and the port number that the DDV app is listening on.</descrip></descripGrp><ntig><termGrp><term id="2754423">Office connection string</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2758724">ниска за повезивање са системом Office</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48704_2754423_2766920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that consists of the IP address of the user's Windows machine and the port number that the DDV app is listening on.</descrip></descripGrp><ntig><termGrp><term id="2754423">Office connection string</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2766920">стринг за повезивање са системом Office</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48720_2754440_2758730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A minimum amount of diagnostic data necessary to help keep Office secure, up-to-date, and performing as expected on the device it’s installed on.</descrip></descripGrp><ntig><termGrp><term id="2754440">required diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2758730">обавезни дијагностички подаци</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48721_2754441_2758710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office experience that provides some of its essential functionality through the use of cloud-based services. Connected experiences are Office experiences that download online content for use in Office (such as templates, images or new fonts) and/or analyze Office content (such as to provide editing suggestions or design recommendations).</descrip></descripGrp><ntig><termGrp><term id="2754441">connected experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2758710">повезано искуство</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48722_2754443_2758707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected experience that is not included in Office 365 ProPlus.</descrip></descripGrp><ntig><termGrp><term id="2754443">additional optional connected experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2758707">додатно опционално повезано искуство</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48723_2754445_2758722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of data that enables the delivery of cloud-based connected experiences and that helps make those experiences secure and perform as expected.</descrip></descripGrp><ntig><termGrp><term id="2754445">necessary service data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2758722">неопходни подаци о услузи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48724_2754447_2758715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of necessary service data that consists of content users create using Office, such as text typed in a Word document.</descrip></descripGrp><ntig><termGrp><term id="2754447">customer content</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2758715">кориснички садржај</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48725_2754449_2758721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of necessary service data needed by a connected experience to perform its task, such as configuration information about the app.</descrip></descripGrp><ntig><termGrp><term id="2754449">functional data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2758721">функционални подаци</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48726_2754450_2758733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of necessary service data needed to keep the service secure, up to date, and performing as expected and is strictly related to a connected experience.</descrip></descripGrp><ntig><termGrp><term id="2754450">service diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2758733">дијагностички подаци услуге</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48727_2754452_2758720"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that needs to run and send data to Microsoft in order for Office to function properly.</descrip></descripGrp><ntig><termGrp><term id="2754452">essential service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2758720">базична услуга</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48738_2755769_2775871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a copy of a repository in a version control system.</descrip></descripGrp><ntig><termGrp><term id="2755769">clone</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2775871">клонирати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48739_2755816_2764151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to technology that is designed to be used without touch.</descrip></descripGrp><ntig><termGrp><term id="2755816">hands-free</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2764151">без употребе руку</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48739_2755816_2766944"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to technology that is designed to be used without touch.</descrip></descripGrp><ntig><termGrp><term id="2755816">hands-free</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2766944">без кориштења руку</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48741_2756423_2763625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of diagnostic data user can opt out of providing and that is used to make product improvements and provides enhanced information to help detect, diagnose, and remediate issues.</descrip></descripGrp><ntig><termGrp><term id="2756423">optional diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2763625">опционални дијагностички подаци</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48742_2756424_2763633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of optional diagnostic data that indicates installed products and their version, install and uninstall status, software add-ins and their settings, and installed products and version installation status and updates readiness.</descrip></descripGrp><ntig><termGrp><term id="2756424">software setup and inventory data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2763633">подаци о инсталацији и инвентару софтвера</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><te