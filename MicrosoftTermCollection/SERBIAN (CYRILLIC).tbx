ote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34303_1991413_2919414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An offline profile name.</descrip></descripGrp><ntig><termGrp><term id="1991413">profile name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919414">име профила</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34304_1991414_2918731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subset of a gamer's profile, the gamer card is a snapshot of the most essential data about a gamer.</descrip></descripGrp><ntig><termGrp><term id="1991414">gamer card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918731">картица играча</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34305_1991415_2918735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A player's cumulative achievement score. Can also be used in reference to the score earned for a single achievement.</descrip></descripGrp><ntig><termGrp><term id="1991415">gamerscore</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918735">оцена играча</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34306_1991416_2918783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An invitation to engage in an Xbox Live activity such as playing a game, joining a party, or chatting.</descrip></descripGrp><ntig><termGrp><term id="1991416">invite</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918783">позив</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34308_1991418_2919372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Picture/image associated with a gamer profile that only people on your friends list can see.</descrip></descripGrp><ntig><termGrp><term id="1991418">personal picture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919372">лична слика</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34309_1991419_2919386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Picture/image associated with a gamer profile that only people on your friends list can see.</descrip></descripGrp><ntig><termGrp><term id="1991419">picture message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919386">сликовна порука</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3431_90590_1503121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition in which paper is blocked in the printing path of a printer, scanner, photocopier or fax machine.</descrip></descripGrp><ntig><termGrp><term id="90590">paper jam</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503121">папир је заглављен</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3431_90590_2527421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition in which paper is blocked in the printing path of a printer, scanner, photocopier or fax machine.</descrip></descripGrp><ntig><termGrp><term id="90590">paper jam</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527421">заглављен папир</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34310_1991420_2919388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item, such as a movie, game, or app, that is fixed to a given area of the UI, so that it's always accessible in that area.</descrip></descripGrp><ntig><termGrp><term id="1991420">pin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919388">закачен садржај</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34311_1991421_2919390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Assessment of a recent player as either a preferred or avoided player.</descrip></descripGrp><ntig><termGrp><term id="1991421">player review</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919390">рецензија играча</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34312_1991422_2919398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person to whom a gamer has given a positive player review.</descrip></descripGrp><ntig><termGrp><term id="1991422">preferred player</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919398">жељени играч</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34313_1991423_2919402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Content that costs money to download.</descrip></descripGrp><ntig><termGrp><term id="1991423">premium content</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919402">премиум садржај</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34314_1991424_2919406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One-on-one chat, initiated from the Xbox Guide.</descrip></descripGrp><ntig><termGrp><term id="1991424">private chat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919406">приватно ћаскање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34315_1991425_2919490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An avatar accessory, such as a hand-held item or toy.</descrip></descripGrp><ntig><termGrp><term id="1991425">prop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919490">реквизит</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34316_1991426_2919408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live area that caters to players who want to game against the best.</descrip></descripGrp><ntig><termGrp><term id="1991426">pro zone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919408">зона за професионалце</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34317_1991427_2919517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live area that caters to players who take a more casual, laid-back approach to gaming.</descrip></descripGrp><ntig><termGrp><term id="1991427">recreation zone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919517">лежерна зона</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34318_1991428_2919520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A player's reputation, computed from the aggregation of all player reviews a player has received, represented in every gamer card as an icon.</descrip></descripGrp><ntig><termGrp><term id="1991428">rep</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919520">репутација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34319_1991429_2919521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message from the Xbox Live service that the player is required to read.</descrip></descripGrp><ntig><termGrp><term id="1991429">required message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919521">обавезна порука</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3432_16444_1503122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of expansion board on PC-compatible computers that allows the playback and recording of sound, such as from a WAV or MIDI file or a music CD-ROM. Most PCs sold at retail include a sound card.</descrip></descripGrp><ntig><termGrp><term id="16444">audio card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503122">звучна картица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3432_719743_1503122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of expansion board on PC-compatible computers that allows the playback and recording of sound, such as from a WAV or MIDI file or a music CD-ROM. Most PCs sold at retail include a sound card.</descrip></descripGrp><ntig><termGrp><term id="719743">audio board</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503122">звучна картица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3432_719744_1503122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of expansion board on PC-compatible computers that allows the playback and recording of sound, such as from a WAV or MIDI file or a music CD-ROM. Most PCs sold at retail include a sound card.</descrip></descripGrp><ntig><termGrp><term id="719744">sound card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503122">звучна картица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3432_719745_1503122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of expansion board on PC-compatible computers that allows the playback and recording of sound, such as from a WAV or MIDI file or a music CD-ROM. Most PCs sold at retail include a sound card.</descrip></descripGrp><ntig><termGrp><term id="719745">sound board</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503122">звучна картица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34320_1991430_2919561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A game session that is saved locally or to the cloud.</descrip></descripGrp><ntig><termGrp><term id="1991430">saved game</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919561">сачувана игра</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34321_1991431_2919576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To publish from Xbox Live to a social networking site.</descrip></descripGrp><ntig><termGrp><term id="1991431">share</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919576">делити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34322_1991432_2919595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that allows a player to