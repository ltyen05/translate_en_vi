Note><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11218_184819_1503974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection between the user's device and a server that provides access to the Internet, typically through an Internet service provider.</descrip></descripGrp><ntig><termGrp><term id="184819">Internet connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503974">интернетска веза</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11218_236993_1503974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection between the user's device and a server that provides access to the Internet, typically through an Internet service provider.</descrip></descripGrp><ntig><termGrp><term id="236993">web connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503974">интернетска веза</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11223_335602_1503975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A lightweight protocol designed to make the automated discovery, management, and configuration of iSCSI and Fiber Channel Protocol (FCP) devices on a TCP/IP network easier by providing a common mechanism for initiators and targets to discover one another and for handling zoning and authentication of both targets and initiators.</descrip></descripGrp><ntig><termGrp><term id="335602">Internet Storage Name Service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503975">Internet Storage Name Service</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11223_335605_1503975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A lightweight protocol designed to make the automated discovery, management, and configuration of iSCSI and Fiber Channel Protocol (FCP) devices on a TCP/IP network easier by providing a common mechanism for initiators and targets to discover one another and for handling zoning and authentication of both targets and initiators.</descrip></descripGrp><ntig><termGrp><term id="335605">iSNS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503975">Internet Storage Name Service</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11225_231967_1916814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that helps you create or edit a formula and also provides information about functions and their arguments.</descrip></descripGrp><ntig><termGrp><term id="231967">Formul