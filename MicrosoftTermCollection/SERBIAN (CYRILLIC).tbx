<langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated set of BI services which include Power BI, PowerApps, and Microsoft Flow.</descrip></descripGrp><ntig><termGrp><term id="2758212">Power Platform</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2763993">Microsoft Power Platform</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43798_2758212_2763995"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated set of BI services which include Power BI, PowerApps, and Microsoft Flow.</descrip></descripGrp><ntig><termGrp><term id="2758212">Power Platform</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2763995">Power Platform</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43799_2470927_2471660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The lightweight markup language with plain text formatting syntax designed to be converted to HTML and other formats and that is used to format readme files, write messages in online discussion forums, and create rich text using a plain text editor.</descrip></descripGrp><ntig><termGrp><term id="2470927">Markdown</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2471660">Markdown</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43800_2470929_2471661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word add-in that converts Markdown documents to Word format for editing and then converts the Word document back to Markdown format, using the Paragraph, Table, List, and Range objects.</descrip></descripGrp><ntig><termGrp><term id="2470929">Markdown editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2471661">Markdown editor</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43809_2471187_2499983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component type of the app designer that includes entities, dashboards, and business process flows.</descrip></descripGrp><ntig><termGrp><term id="2471187">artifact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2499983">артефакт</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4381_132217_1523794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person responsible for creating and maintaining a World Wide Web site. A webmaster is often responsible for responding to email, ensuring the site is operating properly, creating and updating Web pages, and maintaining the overall structure and design of the site.</descrip></descripGrp><ntig><termGrp><term id="132217">Web master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523794">Веб мастер</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4381_132218_1523794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person responsible for creating and maintaining a World Wide Web site. A webmaster is often responsible for responding to email, ensuring the site is operating properly, creating and updating Web pages, and maintaining the overall structure and design of the site.</descrip></descripGrp><ntig><termGrp><term id="132218">webmaster</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523794">Веб мастер</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4381_132219_1523794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person responsible for creating and maintaining a World Wide Web site. A webmaster is often responsible for responding to email, ensuring the site is operating properly, creating and updating Web pages, and maintaining the overall structure and design of the site.</descrip></descripGrp><ntig><termGrp><term id="132219">webmistress</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523794">Веб мастер</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43810_2471606_2499985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customizable area of an app, site map, or view designer where users can add or edit different components of a business app.</descrip></descripGrp><ntig><termGrp><term id="2471606">canvas</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2499985">подлога</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43811_2471609_2499981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stage in a business process flow that uses an automated process for gathering data.</descrip></descripGrp><ntig><termGrp><term id="2471609">action step</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2499981">корак радње</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43812_2471610_2499984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customized rule that applies form logic without users having to write code or create plug-ins. Users can create business rules to set or clear form field values, validate data and errors, and create business recommendations based on business intelligence.</descrip></descripGrp><ntig><termGrp><term id="2471610">business rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2499984">пословно правило</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43813_2471611_2476084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numerical summary of an organization's security posture based on system configurations, user behavior and other security related measurements that represents the extent to which an organization has adopted security controls in their Microsoft environment which can help offset the risk of being breached.</descrip></descripGrp><ntig><termGrp><term id="2471611">secure score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2476084">оцена безбедности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43814_2471613_2499986"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A format used to create an action card in the Relationship Assistant in Dynamics 365.</descrip></descripGrp><ntig><termGrp><term id="2471613">card form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2499986">образац картице</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43815_2471614_2499992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display window that shows users a variety of relevant data-driven insights and news from their contacts, watch list, leads, opportunities, accounts, and social media.</descrip></descripGrp><ntig><termGrp><term id="2471614">Insights pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2499992">окно Insights</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43816_2471615_2499982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive designer that simplifies the app building experience so users can create and customize their own business apps with charts, entities, dashboards, forms, views, and business processes.</descrip></descripGrp><ntig><termGrp><term id="2471615">app designer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2499982">дизајнер апликација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43817_2471616_2499994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive feature within the app designer that offers users a simplified way to design, edit, or customize how they view and access customer and business data.</descrip></descripGrp><ntig><termGrp><term id="2471616">view designer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2499994">дизајнер приказа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43820_2471849_2499989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of plug-ins registered on an external data provider to implement support for connecting virtual entities to external data.</descrip></descripGrp><ntig><termGrp><term id="2471849">entity data provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2499989">добављач података ентитета</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43821_2471850_2499990"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Connection information used by an external data provider for a virtual entity to retrieve and display external data.</descrip></descripGrp><ntig><termGrp><term id="2471850">entity data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2499990">извор података ентитета</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43822_2471851_2499987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stage in business process flow that uses user input to gather data.</descrip></descripGrp><ntig><termGrp><term id="2471851">data step</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2499987">корак података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43823_2471852_2499991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A representation of progress toward a sales goal: identify leads, qualify, develop, propose, and close.</descrip></descripGrp><ntig><termGrp><term id="2471852">funnel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2499991">ток продаје</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43827_2472567_2490850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A movie created in the Photos app, featuring a set of related pictures and videos combined with a soundtrack, transitions and other effects. This term can also be used to refer to the set of photos and videos included in the story. ​A story may be created automatically by the app, or manually by the user.</descrip></descripGrp><ntig><termGrp><term id="2472567">story</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2490850">прича</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4384_319144_1503246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The “ character.</descrip></descripGrp><ntig><termGrp><term id="319144">opening quotation mark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503246">отварајући наводници</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4384_319145_1503246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The “ character.</descrip></descripGrp><ntig><termGrp><term id="319145">opening curly quotation mark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503246">отварајући наводници</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4384_319146_1503246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The “ character.</descrip></descripGrp><ntig><termGrp><term id="319146">LEFT DOUBLE QUOTATION MARK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503246">отварајући наводници</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43852_2472602_2476080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer that includes Microsoft Project Professional, Project Server, and Project Web App that is also fully integrated with Power BI.</descrip></descripGrp><ntig><termGrp><term id="2472602">Microsoft Project &amp; Portfolio Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2476080">Microsoft Project &amp; Portfolio Management</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43852_2472602_2476083"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">T