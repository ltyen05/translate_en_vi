">Зомби</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44979_2531469_2536887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows feature for controlling the cursor, mouse clicks, text input, and communication with the movement of your eyes, using an on-screen keyboard and other software controls together with eye-tracking hardware​.</descrip></descripGrp><ntig><termGrp><term id="2531469">eye control</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2536887">контрола погледом</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44981_2531623_2920646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that presents data on who your players are and how they're engaging with Xbox features in your game. The reported statistics consider only the customers who are connected to Xbox Live, not all Xbox customers. The report only shows data if your game is published to Xbox or uses Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="2531623">Xbox analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920646">Xbox аналитика</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44982_2531624_2918508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to change their Xbox avatars, start fresh with brand new ones, or take pictures of their avatars to share with friends. Users can also export avatars as 3D models for 3D printing or for use in Paint 3D.</descrip></descripGrp><ntig><termGrp><term id="2531624">Xbox Avatars</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918508">Аватари</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44982_2531624_2920655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to change their Xbox avatars, start fresh with brand new ones, or take pictures of their avatars to share with friends. Users can also export avatars as 3D models for 3D printing or for use in Paint 3D.</descrip></descripGrp><ntig><termGrp><term id="2531624">Xbox Avatars</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920655">Xbox аватари</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44982_2531625_2918508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to change their Xbox avatars, start fresh with br