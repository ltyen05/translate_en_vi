inition">Microsoft presentation graphics software designed for use with handheld computing devices.</descrip></descripGrp><ntig><termGrp><term id="2282729">PowerPoint Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2289651">PowerPoint Mobile</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3422_331735_2285198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft presentation graphics software designed for use with handheld computing devices.</descrip></descripGrp><ntig><termGrp><term id="331735">Microsoft® Office PowerPoint® Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2285198">PowerPoint Mobile</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3422_331735_2289651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft presentation graphics software designed for use with handheld computing devices.</descrip></descripGrp><ntig><termGrp><term id="331735">Microsoft® Office PowerPoint® Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2289651">PowerPoint Mobile</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34220_1987601_2142031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email marketing plug-in that is required to be added to all commercial emails.</descrip></descripGrp><ntig><termGrp><term id="1987601">Subscription Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2142031">Центар за претплате</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34221_1987602_2142028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wizard that enables users to set up multiple records for sponsorship items, such as booths, signs, or banners, for an event quickly and easily.</descrip></descripGrp><ntig><termGrp><term id="1987602">Sponsorship Wizard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2142028">Чаробњак за спонзорства</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34222_1987603_2142005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of defining and subdividing a list of contacts into clearly identifiable parts or "segments" that may have similar needs, wants, or demands.</descrip></descripGrp><ntig><termGrp><term id="1987603">segmentation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2142005">сегментација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34223_1987604_2142057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that helps users compress (or expand) the duration of a job without having to update the start and due dates of every task in the workflow.</descrip></descripGrp><ntig><termGrp><term id="1987604">workflow compression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2142057">компримовање тока посла</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34224_1987605_2142050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of hours that a contact worked during a time period, that is, the sum of all hours on all time slips during the period.</descrip></descripGrp><ntig><termGrp><term id="1987605">utilization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2142050">укупна искоришћеност</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34225_1987606_2141987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of hours that the contact worked during a time period that are billable, that is, the sum of all hours on all time slips during the period that were billable.</descrip></descripGrp><ntig><termGrp><term id="1987606">realization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141987">реализација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34226_1987607_2142036"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area in the product that keeps track of how much time a project takes and allows you to analyze all the time that is spent working on a task or a project.</descrip></descripGrp><ntig><termGrp><term id="1987607">time slip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2142036">временски исечак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34227_1987608_2142022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The company that is associated with the MarketingPilot site.</descrip></descripGrp><ntig><termGrp><term id="1987608">site company</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2142022">компанија повезана са локацијом</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34228_1987609_2141922"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive visual representation of an organization's real-time data in one place, in an easy-to-read format that includes lists and charts. For example, you can drill down into a chart or filter a list.</descrip></descripGrp><ntig><termGrp><term id="1987609">dashboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141922">контролна табла</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34232_1987898_2142052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology for encoding low-bandwidth digital data bitstream in video signal, which enables broadcasters to encode information into TV commercials that can be detected by special machines but that cannot be seen by the human eye.</descrip></descripGrp><ntig><termGrp><term id="1987898">video encoded invisible light</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2142052">VEIL</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote typ