><termEntry id="33486_1785152_2388761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability provided to the user for using the provider’s applications running on the cloud.</descrip></descripGrp><ntig><termGrp><term id="1785152">SaaS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2388761">SaaS</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33487_1785150_2750320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud-computing model that allows users to develop, run, manage, and deploy applications within a cloud infrastructure, using supported technologies, without building and maintaining said infrastructure.</descrip></descripGrp><ntig><termGrp><term id="1785150">platform as a service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2750320">PaaS</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33487_1785150_2750437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud-computing model that allows users to develop, run, manage, and deploy applications within a cloud infrastructure, using supported technologies, without building and maintaining said infrastructure.</descrip></descripGrp><ntig><termGrp><term id="1785150">platform as a service</term><termNote type="partOfSpeech">Noun</termNote><termNo