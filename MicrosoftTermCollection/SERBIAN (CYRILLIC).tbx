on.</descrip></descripGrp><ntig><termGrp><term id="2816021">escalate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2818224">ескалирати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49786_2816022_2818226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An office desk being shared by multiple office workers on different shifts.</descrip></descripGrp><ntig><termGrp><term id="2816022">hot desk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2818226">заједнички радни сто</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49786_2816022_2827129"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An office desk being shared by multiple office workers on different shifts.</descrip></descripGrp><ntig><termGrp><term id="2816022">hot desk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2827129">ротирајући стол</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49787_2816023_2818227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An office organization system which involves multiple workers using a single physical work station or surface during different time periods.</descrip></descripGrp><ntig><termGrp><term id="2816023">hot desking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2818227">коришћење заједничких радних столова</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49787_2816024_2818227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An office organization system which involves multiple workers using a single physical work station or surface during different time periods.</descrip></descripGrp><ntig><termGrp><term id="2816024">hot-desking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2818227">коришћење заједничких радних столова</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49788_2816025_2818233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that protects against harmful links (URLs) in incoming emails.</descrip></descripGrp><ntig><termGrp><term id="2816025">URL threat protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2818233">заштита од штетних URL веза</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49789_2816026_2818229"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Sample content used to train a classifier.</descrip></descripGrp><ntig><termGrp><term id="2816026">seed content</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2818229">почетни садржај</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49790_2816032_2835067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that performs static analysis on custom configurations and coded components of Power Apps, seeking to identify contraventions to documented patterns/practices established to reduce complexity and improve performance, security and reliability of solutions built on the Power Apps platform.</descrip></descripGrp><ntig><termGrp><term id="2816032">Power Apps Checker</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2835067">Power Apps контролор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49794_2816264_2818872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To factor a number means to break it up into numbers that can be multiplied together to get the original number. EXAMPLES: 6 = 3 x 2 so, factors of 6 are 3 and 2; 9 = 3 x 3 so, factors of 9 are 3 and 3.</descrip></descripGrp><ntig><termGrp><term id="2816264">factor</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2818872">факторисати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49795_2816502_2818863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 offering for large nonprofits that includes email, Office desktop applications, cloud file-storage and sharing, web conferencing with IM, audio, HD video, and meeting broadcasts over the Internet to up to 10,000 people, a corporate social network, work-management tools, compliance solutions, data protection with DLP, advanced eDiscovery tools, analytics, advanced security, and other services.</descrip></descripGrp><ntig><termGrp><term id="2816502">Office 365 Nonprofit E5</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2818863">Office 365 Nonprofit E5</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49796_2816503_2817287"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 Education solution for small and mid-size schools.</descrip></descripGrp><ntig><termGrp><term id="2816503">Microsoft 365 A1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2817287">Microsoft 365 A1</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49797_2816504_2817330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 Education offering for mid-size to large schools. It includes all the features of A1 plus Office client applications, Minecraft, Delve, management and security features, and server and CAL benefits.</descrip></descripGrp><ntig><termGrp><term id="2816504">Microsoft 365 A3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2817330">Microsoft 365 A3</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49798_2816505_2817373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 Education offering for large schools. It includes all the features of A1 and A3 plus additional analytics and advanced security features.</descrip></descripGrp><ntig><termGrp><term id="2816505">Microsoft 365 A5</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2817373">Microsoft 365 A5</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49799_2816513_2818865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bot in Office 365 Advisor for Teams that assists in the deployment of Microsoft Teams by providing guidance and resources to team members during roll out.</descrip></descripGrp><ntig><termGrp><term id="2816513">Advisor bot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2818865">робот „Саветник“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49799_2816513_2818867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bot in Office 365 Advisor for Teams that assists in the deployment of Microsoft Teams by providing guidance and resources to team members during roll out.</descrip></descripGrp><ntig><termGrp><term id="2816513">Advisor bot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2818867">робот „Саветник за Teams“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49799_2816514_2818865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bot in Office 365 Advisor for Teams that assists in the deployment of Micro