ote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54251_3093357_3093885"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows Microsoft Teams admins to create new, custom meeting types for their organization.</descrip></descripGrp><ntig><termGrp><term id="3093357">meeting templates</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3093885">предложак за састанке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54252_3113363_3114346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The modern identity solution for securing access to customer, citizen and partner-facing apps and services.</descrip></descripGrp><ntig><termGrp><term id="3113363">Microsoft Entra External ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3114346">Microsoft Entra External ID</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54252_3113363_3185174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The modern identity solution for securing access to customer, citizen and partner-facing apps and services.</descrip