08792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of meeting applications that allows users to instantly invite others to join a meeting, e.g. by creating a URL for the meeting.</descrip></descripGrp><ntig><termGrp><term id="168404">Meet Now</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2808792">Састаните се сада</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7333_168404_2809680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of meeting applications that allows users to instantly invite others to join a meeting, e.g. by creating a URL for the meeting.</descrip></descripGrp><ntig><termGrp><term id="168404">Meet Now</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2809680">Брзи састанак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7344_375988_1503603"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text that does not fit within a text box. The text is hidden until it can be flowed into a new text box, or until the text box it overflows is resized to include it.</descrip></descripGrp><ntig><termGrp><term id="375988">overflow text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></la