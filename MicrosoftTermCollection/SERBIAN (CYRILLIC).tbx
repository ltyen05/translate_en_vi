ge or video so that there are no visible empty spaces horizontal or vertically.</descrip></descripGrp><ntig><termGrp><term id="3060435">fill</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3065109">попунити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53748_3060436_3070017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Clipchamp, to divide an asset on the video editing timeline into multiple parts.</descrip></descripGrp><ntig><termGrp><term id="3060436">split</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3070017">разделити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53748_3060436_3070075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Clipchamp, to divide an asset on the video editing timeline into multiple parts.</descrip></descripGrp><ntig><termGrp><term id="3060436">split</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3070075">раздијелити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53749_3060437_3067264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Clipchamp feature that places a smaller video/image on top of a larger video/image in a video editing project.</descrip></descripGrp><ntig><termGrp><term id="3060437">picture in picture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3067264">слика у слици</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53749_3060438_3067264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Clipchamp feature that places a smaller video/image on top of a larger video/image in a video editing project.</descrip></descripGrp><ntig><termGrp><term id="3060438">picture-in-picture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3067264">слика у слици</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53750_3060439_3065084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Clipchamp that increases or reduces the playback speed of a video or audio track.</descrip></descripGrp><ntig><termGrp><term id="3060439">Clip speed</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3065084">Брзина клипа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53751_3060440_3067251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of motion text title or graphic that covers the lower region of the video frame, often used in TV broadcasting.</descrip></descripGrp><ntig><termGrp><term id="3060440">lower third</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3067251">доња трећина</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53752_3060639_3061608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within Microsoft Teams that enables teachers to quickly create and review math assignments for their students.</descrip></descripGrp><ntig><termGrp><term id="3060639">Math Progress</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3061608">Напредак у математици</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53753_3060640_3061607"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within Microsoft Teams that provides students with real-time feedback, help