hich helps readers to consume relevant information faster.</descrip></descripGrp><ntig><termGrp><term id="3080853">summarization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083131">сажимање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54032_3080854_3083128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Editor that helps users make thoughtful decisions about the way a message is delivered in emails, chats, and documents.</descrip></descripGrp><ntig><termGrp><term id="3080854">tone suggestion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083128">предлог начина изражавања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54032_3080854_3083443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Editor that helps users make thoughtful decisions about the way a message is delivered in emails, chats, and documents.</descrip></descripGrp><ntig><termGrp><term id="3080854">tone suggestion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083443">приједлог начина изражавања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="pa