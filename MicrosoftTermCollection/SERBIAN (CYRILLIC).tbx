 stop using CA</descrip></descripGrp><ntig><termGrp><term id="2228709">decommission CA</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2232888">прекинути употребу CA</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38455_2228733_2232903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software program for detecting, isolating, and, when possibile, resolving errors in a Windows-based system.</descrip></descripGrp><ntig><termGrp><term id="2228733">FDI server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2232903">FDI сервер</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38456_2228738_2232912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool in Microsoft Visual Studio for creating Commerce Server applications as Web service projects.</descrip></descripGrp><ntig><termGrp><term id="2228738">Microsoft Commerce Server Projects for Microsoft Visual Studio</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2232912">Microsoft Commerce Server Projects за Microsoft Visual Studio</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><ter