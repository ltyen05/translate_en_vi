:lang="sr-Cyrl"><ntig><termGrp><term id="3020419">HSP</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50524_2861024_2862387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power Mixed Reality feature that allows users to place a 3D object of a specific size into the AR environment around them.</descrip></descripGrp><ntig><termGrp><term id="2861024">AR Cube</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2862387">AR коцка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50525_2861025_2862389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Combining nearby pins together to form one new cluster pin, usually with a number of pins provided, to indicate the density of locations for a certain zoom level on the map.</descrip></descripGrp><ntig><termGrp><term id="2861025">pin clustering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2862389">груписање прибадача</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50526_2861026_2862388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pins combined together on the map to form one new cluster pin, instead of showing a bunch of individual pins on top of each other, to indicate the density of locations for a certain zoom level.</descrip></descripGrp><ntig><termGrp><term id="2861026">cluster pin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2862388">груписане прибадаче</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50527_2861027_2862390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The function of tilting the pitch to the map relative to the horizon.</descrip></descripGrp><ntig><termGrp><term id="2861027">pitch control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2862390">контрола нагнутости</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50531_2861482_2866906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To extract data from another service.</descrip></descripGrp><ntig><termGrp><term id="2861482">scrape</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2866906">извући</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50536_2861588_2866903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft legal document that governs the customer’s use of the Online Services.</descrip></descripGrp><ntig><termGrp><term id="2861588">Online Services Terms</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2866903">Услови за Online услуге</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50539_2862041_2862830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web-hosted technology product such as file storage, webmail, search engines, and calendar management.</descrip></descripGrp><ntig><termGrp><term id="2862041">service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2862830">услуга</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50540_2862042_2862829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft web-hosted technology product such as Bing, MSN, OneDrive, Outlook.com, Devices, and Profile, all of which are accessed via a Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2862042">Microsoft Service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2862829">Microsoft услуга</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50541_2862043_2862831"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cryptographic algorithm used to create a hash value with 64 hexadecimal characters, or the hash value itself.</descrip></descripGrp><ntig><termGrp><term id="2862043">SHA-256</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2862831">SHA-256</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50543_2862396_2862658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The personalized information stream feature of Microsoft Launcher that includes news, events from the user's calendar, photos, notes, contacts, recently-launched apps, and more.</descrip></descripGrp><ntig><termGrp><term id="2862396">feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2862658">извор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50544_2862397_2862660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Launcher page consisting of a card that has been pinned to the Home screen providing a full-screen experience to card users with all filters and sorting preserved as of the moment the page was pinned.</descrip></descripGrp><ntig><termGrp><term id="2862397">pinned page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2862660">закачена страница</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50547_2862401_2862659"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Edge that notifies users whenever a password that they have saved through the browser has been identified as compromised.</descrip></descripGrp><ntig><termGrp><term id="2862401">Password Monitor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2862659">Надгледање лозинки</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50548_2862405_2862661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Edge feature that allows users to select, copy, and paste content that they find across the Web while maintaining the source site's formatting, spacing, and text so the copy looks like the original.</descrip></descripGrp><ntig><termGrp><term id="2862405">Smart copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</t