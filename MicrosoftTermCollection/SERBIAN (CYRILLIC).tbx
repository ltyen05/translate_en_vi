12">Dynamics 365 for phones</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2839218">Dynamics 365 за телефоне</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50176_2837912_2839223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 mobile app that allows users to access all the apps they need for their role in the Unified Interface on their mobile device.</descrip></descripGrp><ntig><termGrp><term id="2837912">Dynamics 365 for phones</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2839223">Microsoft Dynamics 365 за телефоне</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50177_2837902_2839221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 mobile app optimized for a larger tablet screen.</descrip></descripGrp><ntig><termGrp><term id="2837902">Microsoft Dynamics 365 for tablets</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2839221">Dynamics 365 за таблете</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote ty