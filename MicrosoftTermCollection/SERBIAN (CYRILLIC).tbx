tig><termGrp><term id="1523565">пописати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22021_782458_2521294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used on communications circuits that decreases distortion by amplifying or regenerating a signal so that it can be transmitted onward in its original strength and form. On a network, a repeater connects two networks or two network segments at the physical layer of the ISO/OSI reference model and regenerates the signal.</descrip></descripGrp><ntig><termGrp><term id="782458">repeater</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2521294">репетитор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22039_782585_1504693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that collects biometric data for a variety of applications.</descrip></descripGrp><ntig><termGrp><term id="782585">biometric sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504693">биометријски сензор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22039_782585_2918521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that collects biometric data for a variety of applications.</descrip></descripGrp><ntig><termGrp><term id="782585">biometric sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918521">биометрички сензор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22040_782586_1504694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sensor that uses ultrasound, infrared, heat or vibration stimuli to detect movement.</descrip></descripGrp><ntig><termGrp><term id="782586">motion sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504694">сензор покрета</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22041_782588_1504695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A biometric sensor that analyses your eye retina to recognize or authenticate identity.</descrip></descripGrp><ntig><termGrp><term id="782588">retinal scanner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504695">сензор мрежнице</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22042_782589_1504696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that can respond to an applied stimulus by generating an electrical signal.</descrip></descripGrp><ntig><termGrp><term id="782589">electrical sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504696">електрични сензор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22043_782590_1504697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that is used for mechanical measurement of force, scale, pressure, strain, etc.</descrip></descripGrp><ntig><termGrp><term id="782590">mechanical sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504697">механички сензор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22044_782669_1504698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that tracks environmental changes such as temperature, atmospheric pressure, humidity, wind speed and wind direction.</descrip></descripGrp><ntig><termGrp><term id="782669">environmental sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504698">сензор метеоролошких параметара</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22045_782671_1504699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of sensor that can determine without physical contact if an object/person is nearby, or can be used to measure the distance between the object/person and the sensor device.</descrip></descripGrp><ntig><termGrp><term id="782671">proximity sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504699">сензор за идентификацију присуства ствари и људи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22047_1053912_1504700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of sensor (such as a proximity sensor) that uses radio frequency identification (RFID) for a numerous purposes, such as identification of physical items, automatic log on, location of people, etc.</descrip></descripGrp><ntig><termGrp><term id="1053912">radio frequency identification sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504700">RFID сензор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22047_1053912_1504701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of sensor (such as a proximity sensor) that uses radio frequency identification (RFID) for a numerous purposes, such as identification of physical items, automatic log on, location of people, etc.</descrip></descripGrp><ntig><termGrp><term id="1053912">radio frequency identification sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504701">сензор радио-фреквенција за идентификацију</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22047_782676_1504700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of sensor (such as a proximity sensor) that uses radio frequency identification (RFID) for a numerous purposes, such as identification of physical items, automatic log on, location of people, etc.</descrip></descripGrp><ntig><termGrp><term id="782676">RFID sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504700">RFID сензор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22047_782676_1504701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of sensor (such as a proximity sensor) that uses radio frequency identification (RFID) for a numerous purposes, such as identification of physical items, automatic log on, location of people, etc.</descrip></descripGrp><ntig><termGrp><term id="782676">RFID sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504701">сензор радио-фреквенција за идентификацију</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22048_782677_1504702"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sensor that responds to a pre-defined amount of light.</descrip></descripGrp><ntig><termGrp><term id="782677">light sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504702">сензор свјетла</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2205_269322_1051417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Classified or identified according to color.</descrip></descripGrp><ntig><termGrp><term id="269322">color-coded</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051417">кодирано бојом</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22050_1700972_1756046"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Internet site that provides a collection of products and services developed by Microsoft partners for Microsoft Office users.</descrip></descripGrp><ntig><termGrp><term id="1700972">Downloads Marketplace</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1756046">Office продавница</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22050_1700974_1756046"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Internet site that provides a collection of products and services developed by Microsoft partners for Microsoft Office users.</descrip></descripGrp><ntig><termGrp><term id="1700974">Office Store</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1756046">Office продавница</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22050_782680_1756046"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Internet site that provides a collection of products and services developed by Microsoft partners for Microsoft Office users.</descrip></descripGrp><ntig><termGrp><term id="782680">Office Marketplace</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1756046">Office продавница</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22080_783138_1504703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove a Bluetooth link or connection between two Bluetooth–enabled devices.</descrip></descripGrp><ntig><termGrp><term id="783138">unpair</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504703">прекинути Bluetooth везу</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22085_783181_2521284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A circuit that alternates between two possible states when a pulse is received at the input. For example, if the output of a flip-flop is high and a pulse is received at the input, the output "flips" to low; a second input pulse "flops" the output back to high, and so on.</descrip></descripGrp><ntig><termGrp><term id="783181">flip-flop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2521284">флип-флоп</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22085_783216_2521284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A circuit that alternates between two possible states when a pulse is received at the input. For example, if the output of a flip-flop is high and a pulse is received at the input, the output "flips" to low; a second input pulse "flops" the output back to high, and so on.</descrip></descripGrp><ntig><termGrp><term id="783216">bistable multivibrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2521284">флип-флоп</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22087_783218_2521285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A circuit element that burns out or breaks when the current passing through it exceeds a certain level. A fuse protects a circuit from damage caused by excess current. It performs the same function as a circuit breaker, but it cannot be reset, so it must be replaced if it breaks. A fuse consists of a short length of wire of a specific composition and thickness; the thicker the wire, the more current it can pass before the wire melts and breaks the circuit.</descrip></descripGrp><ntig><termGrp><term id="783218">fuse</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2521285">осигурач</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2209_95057_1730162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user's right to perform a specific task, usually one that affects an entire computer system rather than a particular object. Privileges are assigned by administrators to individual users or groups of users as part of the security settings for the computer.</descrip></descripGrp><ntig><termGrp><term id="95057">privilege</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1730162">привилегија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22135_784819_1136383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view mode in Internet Explorer that determines whether content is rendered as if users were viewing it in a previous version of Internet Explorer.</descrip></descripGrp><ntig><termGrp><term id="784819">Compatibility View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1136383">Приказ компатибилности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22146_785482_2701436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portion of a machine language or assembly language instruction that specifies the type of instruction and the structure of the data on which it operates.</descrip></descripGrp><ntig><termGrp><term id="785482">operation code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2701436">код операције</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2215_295551_707168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report containing news or information, can be printed or distributed electronically.</descrip></descripGrp><ntig><termGrp><term id="295551">newsletter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="707168">билтен</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2216_143575_2541788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A discussion comment that is associated with a particular paragraph, image or table.</descrip></descripGrp><ntig><termGrp><term id="143575">inline discussion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541788">уметнута дискусија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2218_210899_1796358"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type that will provide support for storing binary files within an Access database. More similar to the SharePoint concept of attachments than the current OLE object fields in Access. The data will be stored as a raw blob within the database.</descrip></descripGrp><ntig><termGrp><term id="210899">Attachment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1796358">Прилог</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22183_1030868_2231726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Institute of Electrical and Electronics Engineers (IEEE) 802.11 wireless network in which Service Set Identifier (SSID) suppression is enabled.</descrip></descripGrp><ntig><termGrp><term id="1030868">non-broadcast network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2231726">скривена мрежа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22183_1030869_2231726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Institute of Electrical and Electronics Engineers (IEEE) 802.11 wireless network in which Service Set Identifier (SSID) suppression is enabled.</descrip></descripGrp><ntig><termGrp><term id="1030869">hidden network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2231726">скривена мрежа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22185_1030897_2280392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that prevents Internet Explorer from storing data about your browsing session. This helps prevent anyone else who might be using your computer from seeing where you visited and what you looked at on the Web.</descrip></descripGrp><ntig><termGrp><term id="1030897">InPrivate Browsing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2280392">InPrivate прегледање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22186_1081740_1136385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that blocks third-party web content that could potentially track someone's web activity.</descrip></descripGrp><ntig><termGrp><term id="1081740">InPrivate Filtering</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1136385">InPrivate филтрирање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22186_1081740_1954025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that blocks third-party web content that could potentially track someone's web activity.</descrip></descripGrp><ntig><termGrp><term id="1081740">InPrivate Filtering</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1954025">Заштита од праћења</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22186_1509231_1136385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that blocks third-party web content that could potentially track someone's web activity.</descrip></descripGrp><ntig><termGrp><term id="1509231">Tracking Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1136385">InPrivate филтрирање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22186_1509231_1954025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that blocks third-party web content that could potentially track someone's web activity.</descrip></descripGrp><ntig><termGrp><term id="1509231">Tracking Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1954025">Заштита од праћења</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22190_1031206_1985649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of IIS authentication in which IIS accepts client-certificates used to prove the client's identity. Using this form of authentication, IIS can optionally map a client certificate to a Windows user account by using an internal mapping table or Active Directory.</descrip></descripGrp><ntig><termGrp><term id="1031206">certificate authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1985649">потврда идентитета цертификата</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22193_1031378_1504704"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A command prompt that is run in a privileged administrator security context that allows actions that would normally be restricted. Without elevation, command prompts in Windows Client and Windows Server run in a restricted state.</descrip></descripGrp><ntig><termGrp><term id="1031378">elevated command prompt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504704">командни ред са пуним привилегијама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22202_1031390_2701437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The position at which a particular item can be found: either an addressed location or a uniquely identified location on a disk, tape, or similar medium.</descrip></descripGrp><ntig><termGrp><term id="1031390">storage location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2701437">мјесто похране</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22232_1032127_1051422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image and color combination designed to personalize a display window that is viewable to other people. For example, in Windows Live Messenger, someone can choose from a set of available scenes, or upload their own background image. They can also use a default color suggestion, or specify their own color. Someone's personalization is displayed in the main Messenger window (visible to themselves) and also in the main conversation window (visible to others).</descrip></descripGrp><ntig><termGrp><term id="1032127">scene</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051422">сцена</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22235_1032173_1131286"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link group that includes links to the About Hotmail webpage, the What's New webpage, and so on.</descrip></descripGrp><ntig><termGrp><term id="1032173">About</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1131286">Основни подаци</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22235_1032173_1527784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link group that includes links to the About Hotmail webpage, the What's New webpage, and so on.</descrip></descripGrp><ntig><termGrp><term id="1032173">About</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1527784">Информације о</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22236_1032191_1051419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contact that someone has tagged in Messenger to appear in the group of "favorite contacts" that appears at the top of the Messenger display window.</descrip></descripGrp><ntig><termGrp><term id="1032191">favorite contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051419">омиљени контакт</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22237_1032194_1051426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API that defines a set of web services which can programmatically access the Windows Live Contacts Address Book database.</descrip></descripGrp><ntig><termGrp><term id="1032194">Windows Live Contacts API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051426">Windows Live Contacts API</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22238_1032196_1051427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Live service for event planning and invitations.</descrip></descripGrp><ntig><termGrp><term id="1032196">Windows Live Events</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051427">Windows Live Events</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22239_1032199_1051428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Windows Live services optimized for use on mobile devices running Windows Mobile.</descrip></descripGrp><ntig><termGrp><term id="1032199">Windows Live for Windows Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051428">Windows Live for Windows Mobile</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22240_1032201_1051421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Live webpage that displays security and safety-related activities.</descrip></descripGrp><ntig><termGrp><term id="1032201">Safety</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051421">Безбедност</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22242_1032204_1051429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The OneCare software designed to run on supported servers.</descrip></descripGrp><ntig><termGrp><term id="1032204">Windows Live OneCare for Server</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051429">Windows Live OneCare for Server</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22243_1032209_1527865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link that appears above an incomplete content set and leads to the full list of items. For example, when a content module displays items 1–6, a "View all" link in line with the module label leads to a webpage that lists all items. The items that are available in preview are redundantly available in the list of all items, which may be paginated.</descrip></descripGrp><ntig><termGrp><term id="1032209">View all</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1527865">Прикажи све</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22244_1034315_1051423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A favorite saved as a .url file in someone's "Shared favorites" folder.</descrip></descripGrp><ntig><termGrp><term id="1034315">shared favorite</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051423">дељена омиљена локација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22245_1034323_1051415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The image that appears in the conversation window.</d