p></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3187018">Dev Diagnostics</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56594_3186541_3187017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, or pertaining to a computer program or process that requires high computational power and resources to perform its operations.</descrip></descripGrp><ntig><termGrp><term id="3186541">compute-intensive</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3187017">рачунарски интензиван</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56596_3186548_3187015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that leverages artificial intelligence (AI) and natural language processing (NLP) to enhance the clinical documentation process.</descrip></descripGrp><ntig><termGrp><term id="3186548">ambient clinical intelligence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3187015">ACI</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56596_3186548_3187016"><langSet xml:lang="en-US"><descripGrp><descri