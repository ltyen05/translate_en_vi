140">border</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503317">руб</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4908_23140_2527342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visible line around the edge of an object. For example, the four lines of a rectangle that comprise its border.</descrip></descripGrp><ntig><termGrp><term id="23140">border</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527342">ивица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49107_2778504_2784215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who monitors an organization's compliance for processing data subject information under GDPR.</descrip></descripGrp><ntig><termGrp><term id="2778504">data protection officer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2784215">службеник за заштиту података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49107_2778504_2784220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who monitors an organization's compliance for processing data subject information under GDPR.</descrip></descripGrp><ntig><termGrp><term id="2778504">data protection officer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2784220">DPO</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49107_2778505_2784215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who monitors an organization's compliance for processing data subject information under GDPR.</descrip></descripGrp><ntig><termGrp><term id="2778505">DPO</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2784215">службеник за заштиту података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49107_2778505_2784220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who monitors an organization's compliance for processing data subject information under GDPR.</descrip></descripGrp><ntig><termGrp><term id="2778505">DPO</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2784220">DPO</term><termNote type="geographicalUsage">SRB, BIH</termNot