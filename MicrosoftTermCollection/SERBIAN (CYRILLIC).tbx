">A type of metadata that can be discovered during a crawl and applied to one or more items. It can be mapped to a managed property.</descrip></descripGrp><ntig><termGrp><term id="1506663">crawled property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523570">пописано својство</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29124_1506666_1523571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The authenticated user during processing operations in a front-end Web server and a back-end database server.</descrip></descripGrp><ntig><termGrp><term id="1506666">current user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523571">тренутни корисник</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29125_1506668_1523573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part that is used to display items in a list.</descrip></descripGrp><ntig><termGrp><term id="1506668">Data View Web Part</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523573">Веб сегмент за приказ података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote>