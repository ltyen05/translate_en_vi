mNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3157552">Microsoft 365 F3 (без апликације Teams)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56179_3156857_3157544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of the Microsoft 365 Business Basic subscription offering for customers outside the EEA and Switzerland that does not include Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="3156857">Microsoft 365 Business Basic (no Teams)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3157544">Microsoft 365 Business Basic (без апликације Teams)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56180_3156858_3157547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of the Microsoft 365 Business Standard subscription offering for customers outside the EEA and Switzerland that does not include Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="3156858">Microsoft 365 Business Standard (no Teams)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3157547">Microsoft 365 Business Standard (без апликације Teams)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56181_3156859_3157546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of the Microsoft 365 Business Premium subscription offering for customers outside the EEA and Switzerland that does not include Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="3156859">Microsoft 365 Business Premium (no Teams)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3157546">Microsoft 365 Business Premium (без апликације Teams)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56182_3156860_3157536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The standalone Microsoft Teams offer for enterprise customers available outside the EEA and Switzerland.</descrip></descripGrp><ntig><termGrp><term id="3156860">Microsoft Teams Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3157536">Microsoft Teams Enterprise</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56183_3157895_3159570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A plugin that leverages Power Platform components like flows, connectors or prompts to define a specific business behavior which can be added to a copilot. The copilot will use the appropriate plugin able to address the questions of an end user in the application.</descrip></descripGrp><ntig><termGrp><term id="3157895">AI plugin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3159570">додатна компонента вештачке интелигенције</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56184_3157896_3159571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of the Power Automate Automation Kit that organizations can use to create and maintain automation assets, such as master data records, map resources and environments, and assign roles to employees.</descrip></descripGrp><ntig><termGrp><term id="3157896">automation center</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3159571">центар за аутоматизацију</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56185_3157897_3159572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power Automate feature that provides users with insights into how their hosted RPA capacity and process capacity are being used within their environment. It offers an overview of the environment-assigned capacities, details their usage and provides suggestions and insights for more efficient management of automations and the desktop infrastructure.</descrip></descripGrp><ntig><termGrp><term id="3157897">capacity utilization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3159572">искоришћеност капацитета</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56186_3157898_3159573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of data that is read from or written to the run history of the cloud flow.</descrip></descripGrp><ntig><termGrp><term id="3157898">content throughput</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3159573">проток садржаја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56187_3157899_3159574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A prompt that gives makers the freedom to instruct the GPT model to behave in a certain way or to perform a specific task. By carefully crafting a prompt, they can generate responses that suit their specific business needs. This transforms the GPT model into a flexible tool to accomplish various tasks.</descrip></descripGrp><ntig><termGrp><term id="3157899">custom prompt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3159574">прилагођени упит</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56188_3157900_3159575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A machine and machine group setting, which optimizes the machine-assignment logic of a run queue. When enabled, the extended queue prioritization is applied on machines with multi-session support.</descrip></descripGrp><ntig><termGrp><term id="3157900">extended queue prioritization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3159575">проширено одређивање приоритета реда</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56189_3157901_3159576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component used for communication between the Power Automate for desktop browser extension and the Power Automate for desktop application that allows running or creating flows involving web automation.</descrip></descripGrp><ntig><termGrp><term id="3157901">native message host</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3159576">хост основне поруке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56190_3157902_3159577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To insert a work queue item back into the work queue after it has been de-queued for processing.</descrip></descripGrp><ntig><termGrp><term id="3157902">requeue</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3159577">враћати у ред</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56191_3157903_3159578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shared capacity for Power Platform requests that can be used by service principal flows within the same tenant. When enabled, it allows a flow to use a higher number of Power Platform requests, scaling up to 10 million requests in 24 hours.</descrip></descripGrp><ntig><termGrp><term id="3157903">tenant pool</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3159578">група закупаца</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56192_3157904_3159579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bot that can be enabled by the Power Automate unattended RPA add-on to extend desktop-based automation. It runs autonomously and can be deployed on a local or remote desktop, or in a virtualized environment.</descrip></descripGrp><ntig><termGrp><term id="3157904">unattended bot</term><termNote type="