termEntry><termEntry id="4188_136987_1503217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a chart sheet or worksheet the active, or selected, sheet. The sheet that you activate determines which menu bar and toolbars are displayed.</descrip></descripGrp><ntig><termGrp><term id="136987">activate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503217">активирати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41880_2370579_2370951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A biometric authentication feature that that enables signing in to your device, apps, online services, and networks by face recognition.</descrip></descripGrp><ntig><termGrp><term id="2370579">Windows Hello face</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2370951">Windows Hello лице</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41881_2370580_2370952"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A biometric authentication feature that that enables signing in to your device, apps, online services, and networks by fingerprint recognition.</descrip></descripGrp><ntig><termGrp><term id="2370580">Windows Hello fingerprint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNot