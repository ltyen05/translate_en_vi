ticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45737_2578905_2813977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web service that helps you search for addresses, places, business listings by name or category, and other geographic information.</descrip></descripGrp><ntig><termGrp><term id="2578905">Search service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2813977">услуга претраге</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45789_2579453_2580133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The extension for Cortana that connects users to custom services and solutions. Skills can be invoked on Cortana to perform certain actions, such as checking the user’s bank balance, reading a bed time story, or booking a cab with Uber.</descrip></descripGrp><ntig><termGrp><term id="2579453">Cortana skill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2580133">Вештина помоћника Cortana</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45790_2579456_2580134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of policy settings that control updates for devices that use Windows 10. With these settings, information technology administrators decide when and which devices receive updates in their organization, and set different schedules for groups of devices. They can also pause updates for individual devices.</descrip></descripGrp><ntig><termGrp><term id="2579456">Windows Update for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2580134">Windows Update за предузећа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45792_2579483_2814696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A segment for which both static and dynamic profiles are combined.</descrip></descripGrp><ntig><termGrp><term id="2579483">compound segment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2814696">сложени сегмент</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45793_2579484_2814697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A segment that is refreshed automatically. Dynamic segments are defined by rules and their contents change over time.</descrip></descripGrp><ntig><termGrp><term id="2579484">dynamic segment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2814697">динамички сегмент</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45794_2579485_2814695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A result of a business initiative.</descrip></descripGrp><ntig><termGrp><term id="2579485">business outcome</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2814695">пословни резултати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45795_2579486_2814699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A classification that allows users to identify attribute profiles as A, B, or C for the prediction being generated and enables users to efficiently plan targeted follow-ups.</descrip></descripGrp><ntig><termGrp><term id="2579486">grade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2814699">класа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45796_2579487_2814701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A match that indicates the prediction policy was not able to map the different data sources to the same entity, but the likelihood the match is accurate and relevant is high.</descrip></descripGrp><ntig><termGrp><term id="2579487">inferred match</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2814701">подударање на основу изведеног закључка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45797_2579488_2814702"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card that displays information regarding the predictive matches for a given profile in a form similar to a visiting card, along with other insights.</descrip></descripGrp><ntig><termGrp><term id="2579488">info card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2814702">инфо-картица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45798_2579489_2814703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A representation of an event or activity of relevance to a business.</descrip></descripGrp><ntig><termGrp><term id="2579489">interaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2814703">интеракција</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45799_2579490_2814705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limit against which other match values can be compared. Only matches with a score equal to or higher than this limit value will be displayed.</descrip></descripGrp><ntig><termGrp><term id="2579490">match threshold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2814705">праг подударања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45800_2579491_2814706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifier of the user who owns the Azure instance.</descrip></descripGrp><ntig><termGrp><term id="2579491">owning user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2814706">корисник-власник</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45801_2579492_2814707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A forecast of a value from a machine learning model.</descrip></descripGrp><ntig><termGrp><term id="2579492">prediction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2814707">предвиђање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45802_2579493_2814708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attribute of a profile taken into account when generating predictions.</descrip></descripGrp><ntig><termGrp><term id="2579493">predictive grade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2814708">оцена на основу предвиђања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45803_2579494_2814709"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A match made from a combination of data from multiple sources. Data coming from various sources often uses different fields to uniquely identify records and contains different values.</descrip></descripGrp><ntig><termGrp><term id="2579494">predictive match</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2814709">подударање на основу предвиђања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45804_2579495_2814710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules defined by the user to obtain a list of potentially matching entities, of either profiles or interactions.</descrip></descripGrp><ntig