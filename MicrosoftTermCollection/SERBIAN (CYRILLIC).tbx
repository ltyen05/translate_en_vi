ng="en-US"><descripGrp><descrip type="definition">The window in which a user is currently working or directing input. An active window is typically at the top of the Z order and is distinguished by the color of its title bar.</descrip></descripGrp><ntig><termGrp><term id="8743">active window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504327">активни прозор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1469_307402_1502904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool which enables users to automatically perform routine tasks on a chosen computer by monitoring whatever criteria the users choose to initiate the tasks (referred to as triggers) and then executing the tasks when the criteria is met.</descrip></descripGrp><ntig><termGrp><term id="307402">Task Scheduler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502904">Алат за покретање програма</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14695_374338_1796429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field data type that can contain up to 255 characters or the number of characters specified by the Fieldsize property, whichever is less.</descrip></descripGrp><ntig><termGrp><term id="374338">Text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1796429">Текст</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14696_178829_2541904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that allows a user to add a new product to an Opportunity or the Product and Service Items list.</descrip></descripGrp><ntig><termGrp><term id="178829">Product and Service Items</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541904">Ставке производа и услуга</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14700_1176605_1504328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measure referring to the height of a printed character. A point equals 1/72 of an inch, or approximately 1/28 of a centimeter.</descrip></descripGrp><ntig><termGrp><term id="1176605">pt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504328">тачка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14700_93093_1504328"><langSet xml:lang="en-US"><descri