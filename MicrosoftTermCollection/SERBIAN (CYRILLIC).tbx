oun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541482">сервер датотека</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6952_552525_2778781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SVG effect that blurs an image as if it were in an out-of-focus lens.</descrip></descripGrp><ntig><termGrp><term id="552525">Gaussian Blur</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2778781">Гаусово замућење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6952_552525_2785707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SVG effect that blurs an image as if it were in an out-of-focus lens.</descrip></descripGrp><ntig><termGrp><term id="552525">Gaussian Blur</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2785707">Gaussian Blur</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6955_346953_1503561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A malfunction of a physical component 