><descripGrp><descrip type="definition">The Microsoft Intune add-on that allows IT administrators to elevate end-user permissions to perform specific administrative actions only when needed on their desktop computers.</descrip></descripGrp><ntig><termGrp><term id="3080861">Microsoft Intune Endpoint Privilege Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083126">Microsoft Intune – управљање привилегијама за крајњег корисника</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54040_3080862_3083110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The product that provides context-aware cloud posture management with agentless vulnerability scanning, and attack paths analysis built on top of a new intelligent cloud security graph.</descrip></descripGrp><ntig><termGrp><term id="3080862">Microsoft Defender Cloud Security Posture Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3083110">Microsoft Defender – управљање стањем безбедности у облаку</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54040_3080862_3083121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The product that provides context-aware cloud posture management with agentless vulnerability scanning, and attack paths analysis built on top of