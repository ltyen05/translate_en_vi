escrip type="definition">The API which surfaces functionality to create, get, update, and delete a user’s tasks.</descrip></descripGrp><ntig><termGrp><term id="2514607">Tasks API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2515718">API за задатке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44666_2514608_2515716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API which surfaces functionality to manipulate and send messages, attachments, events, and folders.</descrip></descripGrp><ntig><termGrp><term id="2514608">Office 365 Mail API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2515716">API за Office 365 пошту</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44668_2515502_2518191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The setting (toggle) on account.microsoft.com/family that, when switched on, requires children to get adult permission for the things they buy in the Windows and Xbox stores — except for what they get with gift cards or money in their Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2515502">Ask a parent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet