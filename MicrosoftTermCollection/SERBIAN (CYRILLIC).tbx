ure that a developer provides in an app for consumers to buy from within the app through an in-app purchase transaction.</descrip></descripGrp><ntig><termGrp><term id="1612737">in-app offer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1645235">понуда у апликацији</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31689_1612739_1645242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transaction performed by a consumer from within the context of an app to buy additional features for that app.</descrip></descripGrp><ntig><termGrp><term id="1612739">in-app purchase</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1645242">куповина из апликације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3169_232421_1916836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of shortcuts to folders that can be displayed in the Shortcuts pane.</descrip></descripGrp><ntig><termGrp><term id="232421">shortcut group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916836">пречица групе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3169_232421_2541981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of shortcuts to folders that can be displayed in the Shortcuts pane.</descrip></descripGrp><ntig><termGrp><term id="232421">shortcut group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541981">група пречица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31692_1612750_1644558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Applications in Windows Store are distributed with user-based licensing model. Windows runtime and application model will only allow applications that are for user-based license as well as signed by Windows Store to be installed/run on Windows 8.</descrip></descripGrp><ntig><termGrp><term id="1612750">Microsoft License Terms for Consumers</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1644558">Microsoftove лиценцне одредбе за кориснике</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31692_1612750_1645273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Applications in Windows Store are distributed with user-based licensing model. Windows runtime and application model will only allow applications that are for user-based license as well as signed by Windows Store to be installed/run on Windows 8.</descrip></descripGrp><ntig><termGrp><term id="1612750">Microsoft License Terms for Consumers</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1645273">Microsoft услови лиценцирања за потрошаче</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31693_1612753_1644554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows 8 all windows portal experiences support and persist Live ID logins streamlining the partner experience when working with multiple services and sites.</descrip></descripGrp><ntig><termGrp><term id="1612753">Microsoft account logins</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1644554">пријаве на Microsoft рачун</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31693_1612753_1645270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows 8 all windows portal experiences support and persist Live ID logins streamlining the partner experience when working with multiple services and sites.</descrip></descripGrp><ntig><termGrp><term id="1612753">Microsoft account logins</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></l