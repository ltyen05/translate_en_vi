фрацрвени сензор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34380_1991490_2919396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The component on the power supply cord that pulls the right amount of electricity from a wall outlet and converts the AC current to DC current.</descrip></descripGrp><ntig><termGrp><term id="1991490">power supply</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919396">напајање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34381_1991491_2919397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The console power supply cable that runs from the power supply to the console.</descrip></descripGrp><ntig><termGrp><term id="1991491">power supply cord</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919397">кабл за напајање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34382_1991492_2920548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="1991492">Xbox 360 console</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920548">Xbox 360 конзола</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34383_1991493_2920551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Replaceable cover for the front of the Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="1991493">Xbox 360 Faceplate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920551">Xbox 360 маска</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34384_1991494_2918480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The battery pack that powers the wireless controller. Accepts only AA batteries.</descrip></descripGrp><ntig><termGrp><term id="1991494">AA battery pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918480">АА батерије</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34385_1991495_2918502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Audio input on the controller.</descrip></descripGrp><ntig><termGrp><term id="1991495">audio jack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918502">улаз звучног сигнала</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34386_1991496_2918572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The port on the controller into which the play-charge cable is connected.</descrip></descripGrp><ntig><termGrp><term id="1991496">charge port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918572">порт за пуњење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34387_1991497_2918580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The action of pressing the stick downward.</descrip></descripGrp><ntig><termGrp><term id="1991497">click</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918580">клик</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34388_1991498_2918617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The wired controller cable.</descrip></descripGrp><ntig><termGrp><term id="1991498">controller cable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918617">кабл контролера</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34389_1991499_2918614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button on both the wireless controller and the console used to make a permanent attachment between the controller and console.</descrip></descripGrp><ntig><termGrp><term id="1991499">connect button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918614">дугме за повезивање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34390_1991500_2918644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Port on the controller to which peripherals, such as a headset, may be connected.</descrip></descripGrp><ntig><termGrp><term id="1991500">expansion port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918644">порт за проширење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</ter