><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44803_2521100_2673820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The framework that consists of a web part and a page that provides full support for client-side SharePoint development, easy integration with SharePoint data, and support for open source tooling so that developers can use their preferred tools and technologies.</descrip></descripGrp><ntig><termGrp><term id="2521100">SharePoint Framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2673820">SPFx</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44803_2673786_2525007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The framework that consists of a web part and a page that provides full support for client-side SharePoint development, easy integration with SharePoint data, and support for open source tooling so that developers can use their preferred tools and technologies.</descrip></descripGrp><ntig><termGrp><term id="2673786">SPFx</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2525007">SharePoint Framework</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></term