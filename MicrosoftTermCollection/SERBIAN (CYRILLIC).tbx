"2141884">Радна површина агента</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35275_2026504_2142037"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that can be put on a case form that displays a timer indicating how much time has elapsed, or how much time is left, for a service call.</descrip></descripGrp><ntig><termGrp><term id="2026504">timer control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2142037">контрола тајмера</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35277_2026514_2141972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that lets you combine one or more CRM solutions, data files, and custom code operations into one package that can be deployed by any CRM environment.</descrip></descripGrp><ntig><termGrp><term id="2026514">Package Deployer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141972">Package Deployer</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35304_2226109_2231866"><langSet xml:lang="en-US"><descripGrp><descrip ty