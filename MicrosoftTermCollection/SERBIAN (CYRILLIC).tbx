7837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The calculus rule that states that the integral of a sum of two functions is equal to the sum of their integrals.</descrip></descripGrp><ntig><termGrp><term id="2753972">Sum Rule</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2757837">правило збира у интеграцији</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48685_2753973_2757835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The calculus rule that states that the integral of a sum of two functions is equal to the sum of their integrals.</descrip></descripGrp><ntig><termGrp><term id="2753973">sum rule in integration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2757835">правило збира</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48685_2753973_2757837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The calculus rule that states that the integral of a sum of two functions is equal to the sum of their integrals.</descrip></descripGrp><ntig><termGrp><term id="2753973">sum rule in integration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><ter