e><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502810">клијент</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="728_484_1502811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity, such as a device or program, that connects to another entity over a network.</descrip></descripGrp><ntig><termGrp><term id="484">client computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502811">клијент рачунар</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7280_502936_1527799"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presence status the user can select, while signed in, to make it appear to other users that he or she is currently willing to be contacted.</descrip></descripGrp><ntig><termGrp><term id="502936">available</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1527799">доступан</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7286_226559_2919224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital micropayment and loyalty service that enables efficient micropayments and prepaid purchase for cash based consumers (including kids/teens, as well as emerging and developing markets), and provides a mechanism to directly reward loyal customers.</descrip></descripGrp><ntig><termGrp><term id="226559">Microsoft Points</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919224">Microsoft Points</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="729_235323_2373017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The branch of accounting concerned with identifying and evaluating the cost of producing a product.</descrip></descripGrp><ntig><termGrp><term id="235323">cost accounting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2373017">обрачун трошкова</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7290_60173_1503599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any token that a program can use to identify and access an object such as a device, a file, a window, or a dialog box.</descrip></descripGrp><ntig><termGrp><term id="60173">handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503599">показивач</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7291_31179_1725934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity used in catalogs to group a set of products together in a hierarchy. A child category is a subordinate of a parent category. For example, Music is a parent category, and Rock, Country, and Classical are child categories. You create parent and child categories to organize the products displayed on your site.</descrip></descripGrp><ntig><termGrp><term id="31179">child category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1725934">подређена категорија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7294_370776_2542086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based specification for the exchange, editing, and delivery of 2-D vector graphics on the Web. An application of XML (Extensible Markup Language), VML uses XML tags and Cascading Style Sheets to create and place vector graphics, such as circles and squares, in an XML or HTML document, such as a Web page. These graphics, which are rendered in the native operating system, can include color and are editable in a variety of graphics programs.</descrip></descripGrp><ntig><termGrp><term id="370776">Vector Markup Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542086">Vector Markup Language</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7294_370776_2542087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based specification for the exchange, editing, and delivery of 2-D vector graphics on the Web. An application of XML (Extensible Markup Language), VML uses XML tags and Cascading Style Sheets to create and place vector graphics, such as circles and squares, in an XML or HTML document, such as a Web page. These graphics, which are rendered in the native operating system, can include color and are editable in a variety of graphics programs.</descrip></descripGrp><ntig><termGrp><term id="370776">Vector Markup Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542087">VML</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7294_370777_2542086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based specification for the exchange, editing, and delivery of 2-D vector graphics on the Web. An application of XML (Extensible Markup Language), VML uses XML tags and Cascading Style Sheets to create and place vector graphics, such as circles and squares, in an XML or HTML document, such as a Web page. These graphics, which are rendered in the native operating system, can include color and are editable in a variety of graphics programs.</descrip></descripGrp><ntig><termGrp><term id="370777">VML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542086">Vector Markup Language</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7294_370777_2542087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based specification for the exchange, editing, and delivery of 2-D vector graphics on the Web. An application of XML (Extensible Markup Language), VML uses XML tags and Cascading Style Sheets to create and place vector graphics, such as circles and squares, in an XML or HTML document, such as a Web page. These graphics, which are rendered in the native operating system, can include color and are editable in a variety of graphics programs.</descrip></descripGrp><ntig><termGrp><term id="370777">VML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542087">VML</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7306_119668_1503600"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To touch an item once with the tablet pen and then lift the pen quickly.</descrip></descripGrp><ntig><termGrp><term id="119668">tap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503600">додирнути</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7309_116642_1503601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To retain a physical representation of (data or instructions) that enables them to be subsequently retrieved.</descrip></descripGrp><ntig><termGrp><term id="116642">store</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503601">похранити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="731_361193_1502812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove unused space from data tables.</descrip></descripGrp><ntig><termGrp><term id="361193">shrink</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502812">сабијање табела</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7315_126572_1503602"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who uses products such as devices, services, or applications.</descrip></descripGrp><ntig><termGrp><term id="126572">user</term><termNote type="partOfSpeech">Noun</termNote><termNo