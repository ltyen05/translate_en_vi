415567_1503352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action or occurrence to which a program might respond. Examples include state changes, data transfers, key presses, and mouse movements.</descrip></descripGrp><ntig><termGrp><term id="415567">program event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503352">догађај</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5129_415567_1778498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action or occurrence to which a program might respond. Examples include state changes, data transfers, key presses, and mouse movements.</descrip></descripGrp><ntig><termGrp><term id="415567">program event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1778498">програмски догађај</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5129_415567_406462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action or occurrence to which a program might respond. Examples include state changes, data transfers, key presses, and mouse movements.</descrip></descripGrp><ntig><termGrp><term id="415567">program event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><ter