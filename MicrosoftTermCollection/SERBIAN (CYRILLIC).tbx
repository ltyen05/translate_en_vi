ype="definition">The Excel business intelligence add-in focused on data discovery and access.</descrip></descripGrp><ntig><termGrp><term id="2000087">Power Query</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2013529">Power Query</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34696_2277616_2281730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel feature that allows users to plot geographic and temporal data visually, analyze that data in 3D, and create interactive tours to share with others.</descrip></descripGrp><ntig><termGrp><term id="2277616">3D Maps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2281730">3D Maps</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34699_2001863_2002284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The search feature for Windows 8.1 and beyond that enables a central search from the Start screen across the device used, the cloud, apps, and the web.</descrip></descripGrp><ntig><termGrp><term id="2001863">Bing Smart Search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2002284">Bing паметна претрага</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="347_186202_1523687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web site collection feature that creates all artifacts that must be present for the web-level publishing feature to function. These include item profiles, web parts, workflow definitions, workflow bindings, site templates, events, actions, etc.</descrip></descripGrp><ntig><termGrp><term id="186202">Publishing Resources</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523687">Објављивање ресурса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34715_2001978_2604237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The agreement between Microsoft Corporation and a client on the subscription of Online Services.</descrip></descripGrp><ntig><termGrp><term id="2001978">Microsoft Online Subscription Agreement</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2604237">Уговор о претплати на Microsoft услуге на мрежи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34715_2001979_2604237">