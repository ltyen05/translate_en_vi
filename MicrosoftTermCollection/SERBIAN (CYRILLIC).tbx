803_307427_406550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A protocol that makes it possible for users to sync their email, calendar, contact, and task data from Exchange Server to supporting devices.</descrip></descripGrp><ntig><termGrp><term id="307427">Exchange ActiveSync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406550">Exchange ActiveSync</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14807_397214_406598"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An occurrence of a particular message transport activity or phase through the SMTP and NNTP services.</descrip></descripGrp><ntig><termGrp><term id="397214">transport event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406598">догађај преноса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1481_211365_2411326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cross-Office feature that automatically recovers content if the user's program or computer malfunctions.</descrip></descripGrp><ntig><termGrp><term id="211365">Auto-recover</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2411326">Аутоматско с