ml:lang="sr-Cyrl"><ntig><termGrp><term id="2354224">Office 2016 Language Accessory Pack</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40512_2353387_2373038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solution that's installed in Microsoft Dynamics CRM that you can use to run a project, including allocating resources and checking availability, setting work hours, and booking resources.</descrip></descripGrp><ntig><termGrp><term id="2353387">project service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2373038">служба за управљање пројектом</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40513_2353388_2373024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A CRM solution that you can use to manage field service, including routing and scheduling, work process automation, customer and partner communications capabilities, and reporting and business intelligence.</descrip></descripGrp><ntig><termGrp><term id="2353388">field service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2373024">теренска служба</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40514_2353944_2354192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A methodology to query data residing in the computer’s random access memory.</descrip></descripGrp><ntig><termGrp><term id="2353944">in-memory analytics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2354192">аналитика у меморији</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40515_2353945_2354193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A memory-optimized database engine integrated into the SQL Server engine, optimized for OLTP workloads accessing memory resident data to achieve significant improvements in performance and reduction in processing time.</descrip></descripGrp><ntig><termGrp><term id="2353945">in-memory OLTP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2354193">OLTP у меморији</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40515_2599244_2354193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A memory-optimized database engine integrated into the SQL Server engine, optimized for OLTP workloads accessing memory resident data to achieve significant improvements in performance and reduction in processing time.</descrip></descripGrp><ntig><termGrp><term 