Speech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15930_299912_1504449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time that a OneNote page was created.</descrip></descripGrp><ntig><termGrp><term id="299912">page time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504449">вријеме странице</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15930_299912_2527736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time that a OneNote page was created.</descrip></descripGrp><ntig><termGrp><term id="299912">page time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527736">време креирања странице</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15934_323608_1355627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A navigational element, usually appearing at the top of a window, that displays, and allows users to change, their current location.</descrip></descripGrp><ntig><termGrp><term id="323608">breadcrumb bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cy