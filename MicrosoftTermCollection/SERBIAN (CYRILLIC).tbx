d="53215_3031667_3032805"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search ad that automatically target relevant search queries based on the content of your website, and is dynamically created to respond to these search queries.</descrip></descripGrp><ntig><termGrp><term id="3031667">dynamic search ad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3032805">DSA</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53215_3031667_3032807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search ad that automatically target relevant search queries based on the content of your website, and is dynamically created to respond to these search queries.</descrip></descripGrp><ntig><termGrp><term id="3031667">dynamic search ad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3032807">динамички оглас у резултатима претраге</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53215_3031668_3032805"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search ad that automatically target relevant search queries based on the content of your website, and is dynamically created to respond to these search queries.</descrip></descripGrp><ntig><termGrp><term id="3031668">DSA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3032805">DSA</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53215_3031668_3032807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search ad that automatically target relevant search queries based on the content of your website, and is dynamically created to respond to these search queries.</descrip></descripGrp><ntig><termGrp><term id="3031668">DSA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3032807">динамички оглас у резултатима претраге</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53216_3031669_3032813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search ad that allows you to set multiple ad headlines and ad descriptions within a single ad.</descrip></descripGrp><ntig><termGrp><term id="3031669">responsive search ad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3032813">одзивни оглас у резултатима претраге</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53217_3031670_3032814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search ad that contains images and videos.</descrip></descripGrp><ntig><termGrp><term id="3031670">rich search ad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3032814">обогаћен оглас у резултатима претраге</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53219_3031672_3032808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combined search and audience advertising marketplace made up of Bing, MSN, Outlook, Edge, and partner sites.</descrip></descripGrp><ntig><termGrp><term id="3031672">Microsoft Search Network</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3032808">Microsoft мрежа за претрагу</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53220_3031831_3033321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy template that helps detect cross-country or cross-region data transfers, identify the amount and types of personal data being transferred, and take actions to remediate risks, such as applying additional encryption or restricting access for the data being transferred.</descrip></descripGrp><ntig><termGrp><term id="3031831">cross-border transfers</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3033321">прекогранични преноси</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53221_3031832_3033320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transfer of personal data across a geographic border (such as country or regional borders).</descrip></descripGrp><ntig><termGrp><term id="3031832">cross-border transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3033320">прекогранични пренос</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53222_3031833_3033324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy template that helps detect personal data with external, excessive, and idle access and trigger remediation actions including sending notifications to the data or site owners to remove unnecessary accesses.</descrip></descripGrp><ntig><termGrp><term id="3031833">data overexposure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3033324">прекомерна изложеност података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53223_3031834_3033323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy template that helps detect personal data that has not been used for more than 90 days and trigger remediation actions, including sending notifications to data owners to apply retention labels or disposing of the information immediately.</descrip></descripGrp><ntig><termGrp><term id="3031834">data minimization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3033323">минимизација података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53224_3031835_3033318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The metered service that enables licensed M365 commercial, consumer, and education users to use Office Online to view, edit, and coauthor documents stored on cloud storage providers other than SharePoint or OneDrive.</descrip></descripGrp><ntig><termGrp><term id="3031835">Coauthoring</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3033318">Коауторство</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53225_3053615_3053912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cross-industry experience app in Microsoft Teams that provides seamless scheduling, analytics, and premium experiences for business-to-customer meetings, bringing together current virtual appointment experiences into one single entry point.</descrip></descripGrp><ntig><termGrp><term id="3053615">Virtual Appointments</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3053912">Виртуелни састанци</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53225_3153774_3053912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cross-industry experience app in Microsoft Teams that provides seamless scheduling, analytics, and premium experiences for business-to-customer meetings, bringing together current virtual appointment experiences into one single entry point.</descrip></descripGrp><ntig><termGrp><term id="3153774">Virtual Appts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3053912">Виртуелни састанци</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53226_3031837_3033336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The legacy version of School Data Sync.</descrip></descripGrp><ntig><termGrp><term id="3031837">School Data Sync (classic)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3033336">Синхронизација школских података (класично)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53227_3031838_3033331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The device marketplace in the Microsoft Teams Admin Center that drives discovery and adoption of Teams devices from Teams Admin Center marketplace.</descrip></descripGrp><ntig><termGrp><term id="3031838">Microsoft Teams device store</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3033331">Microsoft Teams продавница уређаја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53235_3033414_3034745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The simulator for ARDK head-mounted displays that runs on Windows PCs and requires a physical + connected Samsung phone.</descrip></descripGrp><ntig><termGrp><term id="3033414">ARDK Simulator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3034745">ARDK симулатор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53236_3033415_3034743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application for ARDK users that provides the software platform for ARDK features like hand tracking and eye tracking.</descrip></descripGrp><ntig><termGrp><term id="3033415">ARDK Platform</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3034743">ARDK платформа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53237_3033416_3034742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application for ARDK users that hosts the system UI, including the application launcher, dock, and task bar.</descrip></descripGrp><ntig><termGrp><term id="3033416">ARDK Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3034742">ARDK интерфејс</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53238_3033417_3034738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application for ARDK users to calibrate their eyes for the eye tracker.</descrip></descripGrp><ntig><termGrp><term id="3033417">ARDK Eye Calibration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3034738">ARDK калибрација очију</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53246_3033423_3034741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone application that allows users to submit feedback from their Samsung phone about a problem with their ARDK head-mounted display.</descrip></descripGrp><ntig><termGrp><term id="3033423">ARDK Feedback</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3034741">ARDK повратне информације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53247_3033521_3035204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UK bank holiday celebrated on June 3, 2022 to commemorate the 70th anniversary of Queen Elizabeth II's accession to the throne.</descrip></descripGrp><ntig><termGrp><term id="3033521">Platinum Jubilee Bank Holiday</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3035204">Платинасти јубилеј краљице Елизабете Друге</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53248_3033522_3033969"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The solution that enables enterprises to easily converge employees with relevant skills necessary to resolve complex cases. It is a structured approach to have a set of SMEs work together to bring a resolution to a complex customer issue.</descrip></descripGrp><ntig><termGrp><term id="3033522">Intelligent swarming</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3033969">Интелигентно ројење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53249_3033523_3033970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of bringing in a team of SMEs from across the organization and working with them to solve complex customer issues.</descrip></descripGrp><ntig><termGrp><term id="3033523">swarm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3033970">рој</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5325_145206_1503380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To minimize the duplication of information in a relational database through effective table design.</descrip></descripGrp><ntig><termGrp><term id="145206">normalize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503380">нормализовати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53251_3033532_3035202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Canadian holiday (colloquially known as Orange Shirt Day) celebrated on September 30 to recognize the legacy of the Canadian Indian residential school system.</descrip></descripGrp><ntig><termGrp><term id="3033532">National Day for Truth and Reconciliation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3035202">Национални дан истине и помирења</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53252_3033536_3035199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The US federal holiday celebrated on June 19 to commemorate the emancipation of African-American slaves, celebrated on the anniversary of June 19, 1865, the date of the announcement of General Order No. 3 by Union Army general Gordon Granger proclaiming freedom for slaves in Texas, the last state of the Confederacy with institutional slavery.</descrip></descripGrp><ntig><termGrp><term id="3033536">Juneteenth</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3035199">Дан ослобођења робова</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53254_3033546_3035200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The day on which the US holiday Juneteenth is celebrated if the official holiday itself falls on a weekend.</descrip></descripGrp><ntig><termGrp><term id="3033546">Juneteenth (Observed)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3035200">Дан ослобођења робова (обележава се)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53254_3033546_3035212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The day on which the US holiday Juneteenth is celebrated if the official holiday itself falls on a weekend.</descrip></descripGrp><ntig><termGrp><term id="3033546">Juneteenth (Observed)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3035212">Дан ослобођења робова (обиљежавани)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53255_3033556_3035198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in the Authenticator app and Edge that allows users to update their password on a website with one click.</descrip></descripGrp><ntig><termGrp><term id="3033556">easy update</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3035198">лако ажурирање</term><termNote t