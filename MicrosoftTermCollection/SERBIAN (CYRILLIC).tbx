442_2855884_2856331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Office applications, a small bar beneath the ribbon or in another location on the UI that shows messages.</descrip></descripGrp><ntig><termGrp><term id="2855884">business bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2856331">информативна трака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50443_2855885_2856332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Excel, a rectangular window that appears when the user clicks an icon in either a Stocks or Geography data cell and displays information that was retrieved from Bing or another source.</descrip></descripGrp><ntig><termGrp><term id="2855885">card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2856332">карта</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50444_2855886_2862171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In software release life cycle, the release phase date on which a product is released to the general product.</descrip></descripGrp><ntig><termGrp><term id="2855886">general availability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp>