elected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6263_88971_2529525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A join that includes all the rows from the joined tables that meet the search conditions, even rows from one table for which there is no matching row in the other join table.</descrip></descripGrp><ntig><termGrp><term id="88971">outer join</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2529525">спољно спајање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6270_380992_1523643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A version that is ready for a larger group to see or that has changed significantly since the previous major version.</descrip></descripGrp><ntig><termGrp><term id="380992">major version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523643">главна верзија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6271_92475_2462576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software infrastructure that defines and links together one or more stages of a business process, running them in sequence to complete a specific task. Each stage of a pipeline contains one or more pipeline components (COM objects) that can be configured to work with the unique requirements of the site.</descrip></descripGrp><ntig><termGrp><term id="92475">pipeline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2462576">pipeline</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6273_145441_1916726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of software that provides access to a particular type of OLAP database. This software can include a data source driver and other client software that is necessary to connect to a database.</descrip></descripGrp><ntig><termGrp><term id="145441">OLAP provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916726">OLAP давалац</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6273_145441_2527560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of software that provides access to a particular type of OLAP database. This software can include a data source driver and other client software that is necessary to connect to a database.</descrip></descripGrp><ntig><termGrp><term id="145441">OLAP provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527560">добављач OLAP услуга</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6279_26739_1503489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To attempt to establish a voice conversation with another person or other people from a phone, computer, or mobile device.</descrip></descripGrp><ntig><termGrp><term id="26739">call</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503489">позив</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6279_26739_2076264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To attempt to establish a voice conversation with another person or other people from a phone, computer, or mobile device.</descrip></descripGrp><ntig><termGrp><term id="26739">call</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2076264">позови</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6282_139056_1916665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Colors that are opposite each other on the color wheel, such as yellow and blue.</descrip></descripGrp><ntig><termGrp><term id="139056">complementa