ermNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2327823">Динамичка испорука е-поште</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40027_2326225_2332172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to collect Word, PowerPoint, Excel, Office Mix, and PDF documents as well as sways and publish them on the website, docs.com, where others can view, download or share them or comment on them.</descrip></descripGrp><ntig><termGrp><term id="2326225">Docs.com</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2332172">Docs.com</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40030_2327887_2638198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based interface that is included as part of specialized Windows devices and used by developers to manage device services remotely.</descrip></descripGrp><ntig><termGrp><term id="2327887">Windows Device Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2638198">Портал за уређаје</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote