elies on Edge Subscriptions. Also, Edge Subscription is the process that is required to establish an Edge Subscription for a given Edge Transport server.</descrip></descripGrp><ntig><termGrp><term id="397146">Edge Subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406464">претплата на сервер „Рубни пренос“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12626_1088729_1916629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having values separated from each other by tabs.</descrip></descripGrp><ntig><termGrp><term id="1088729">tab-delimited</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916629">разграничено табулатором</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12626_1088729_2527447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having values separated from each other by tabs.</descrip></descripGrp><ntig><termGrp><term id="1088729">tab-delimited</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527447">разграничен табулаторима</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="gramma