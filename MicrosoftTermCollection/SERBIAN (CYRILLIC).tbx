aphicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40435_2348758_2349099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The client agent that enables Power BI to connect to on-premises SQL Server Analysis Services instances and author interactive reports and dashboards based on role membership on that instance.</descrip></descripGrp><ntig><termGrp><term id="2348758">Power BI Analysis Services Connector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2349099">Power BI Analysis Services Connector</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40436_2349281_2352442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item showing hearts (number of likes) for a given chat message. The heart-feature refers to giving and removing hearts and is distinct from the Like-feature known from e.g. Facebook.</descrip></descripGrp><ntig><termGrp><term id="2349281">Show likes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2352442">приказати свиђања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40436_2349281_2352619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item showing hearts (number of likes) for a given chat message. The heart-feature refers to giving and removing hearts and is distinct from the Like-feature known from e.g. Facebook.</descrip></descripGrp><ntig><termGrp><term id="2349281">Show likes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2352619">Прикажи свиђања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40438_2349283_2352443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item connected the heart-feature, whereby a participant can remove a "heart" from a chat message, indicating that the participant does not like a chat message. The heart-feature refers to giving and removing hearts and is distinct from the Like-feature known from e.g. Facebook.</descrip></descripGrp><ntig><termGrp><term id="2349283">Unlike</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2352443">не свиђа ми се</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40438_2349283_2352620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item connected the heart-feature, whereby a participant can remove a "heart" from a chat message, indicating that the participant does not like a chat message.