740">sender policy framework</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="380320">SPF проширење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15488_375741_380320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extension of the SMTP protocol that prevents spammers from forging the From: fields in email messages by verifying that the IP address in the SMTP Received: header is authorized to send email for the sender's domain.</descrip></descripGrp><ntig><termGrp><term id="375741">SPF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="380320">SPF проширење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15490_2510_1504401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An unsolicited and typically unwelcome message, often commercial or political in nature, transmitted via the Internet as a mass mailing (sometimes as if from a fictitious user or domain) to a large number of recipients.</descrip></descripGrp><ntig><termGrp><term id="2510">junk e-mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504401">безвриједна e-пошта</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="pa