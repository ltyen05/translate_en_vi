 type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44337_2489996_2516086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A minimum number of points required for a KPI in gamification, below which no scores can be counted.</descrip></descripGrp><ntig><termGrp><term id="2489996">floor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2516086">доње ограничење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44338_2489997_2516088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A player who has the highest scores as represented on the leaderboard in gamification.</descrip></descripGrp><ntig><termGrp><term id="2489997">MVP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2516088">MVP</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44339_2489998_2516085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way to import data from Excel into CRM to track scores for a fantasy sales team.</descrip></descripGrp><ntig><termGrp><term id="2489998">Excel point scoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGr