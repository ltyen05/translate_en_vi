ogress UI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2093271">Кориснички интерфејс тока</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36834_2085430_2099977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that shows the progress of an operation.</descrip></descripGrp><ntig><termGrp><term id="2085430">Progress UI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2099977">Ток корисничког интерфејса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36835_2085431_2093270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recurring meeting that does not have a standard pattern of daily, weekly, monthly, etc.</descrip></descripGrp><ntig><termGrp><term id="2085431">custom repeat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2093270">обично понављање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36835_2085431_2099976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recurring meeting that does not have a standard pattern of daily, weekly, monthly, etc.</descrip></descripGrp><ntig><termGrp><term id="2085431">custom repeat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2099976">састанак који се понавља по неутврђеном обрасцу</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36836_2086047_2093267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The icon on the upper-left corner of the Office 365 suite. The icon is the entry point to all Office 365 services for which the user has a valid subscription, and to the Admin center (only if the user is an admin).</descrip></descripGrp><ntig><termGrp><term id="2086047">app launcher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2093267">покретање апликација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36836_2086047_2099973"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The icon on the upper-left corner of the Office 365 suite. The icon is the entry point to all Office 365 services for which the user has a valid subscription, and to the Admin center (only if the user is an admin).</descrip></descripGrp><ntig><termGrp><term id="2086047">app launcher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2099973">покретач апликација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36839_2086613_2749019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Australia East region, located in New South Wales, within the Azure region taxonomy.</descrip></descripGrp><ntig><termGrp><term id="2086613">AU East</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2749019">Аустралија – исток</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36839_2722799_2749019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Australia East region, located in New South Wales, within the Azure region taxonomy.</descrip></descripGrp><ntig><termGrp><term id="2722799">Australia East</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2749019">Аустралија – исток</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36868_2093283_2106682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component in Exchange 2013 that performs background tasks, such as mailbox database maintenance, mailbox processing, inference training, calendar repair, offline address book generation, and more.</descrip></descripGrp><ntig><termGrp><term id="2093283">Time-Based Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2106682">Помоћник за временски дефинисане задатке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36869_2093284_2106683"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component in Exchange 2013 that performs background tasks, such as mailbox database maintenance, mailbox processing, inference training, calendar repair, offline address book generation, and more.</descrip></descripGrp><ntig><termGrp><term id="2093284">Time-Based Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2106683">Помоћник за временски дефинисане задатке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36870_2093285_2106679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A time-based assistant (TBA) that parses emails and makes internal inferences based on them. Inferences are used to allow the system to gain insight into a user’s mailbox based on user patterns. Those inferences are then used to populate features for users, such as People View in Outlook Web App.</descrip></descripGrp><ntig><termGrp><term id="2093285">inference training</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2106679">обука у закључивању</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36871_2093286_2106680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that feeds data (such as mailbox messages) to the inference training assistant in batches. It controls performance by giving the inference training assistant a fixed amount of work to process at each interval.</descrip></descripGrp><ntig><termGrp><term id="2093286">inference training feeder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2106680">додавање података за обуку у закључивању</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36872_2093287_2106424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of OneNote for Android that allows you to create notes, audio notes, and picture notes right from your phone’s home screen.</descrip></descripGrp><ntig><termGrp><term id="2093287">widget</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2106424">виџет</term><t