type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56573_3185747_3187890"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that automatically renews subscription services before the term expiration date.</descrip></descripGrp><ntig><termGrp><term id="3185747">automatic renewal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3187890">аутоматско продужење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56573_3185762_3187889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that automatically renews subscription services before the term expiration date.</descrip></descripGrp><ntig><termGrp><term id="3185762">auto renewal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3187889">аутоматско продужење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56573_3185762_3187890"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that automatically renews subscription services before the term expiration date.</descrip></descripGrp><ntig><termGrp><term id="3185762">auto renewal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3187890">аутоматско продужење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56585_3186046_3186432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Carbon that derives from biological sources like plants, animals and microorganisms.</descrip></descripGrp><ntig><termGrp><term id="3186046">biogenic carbon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3186432">биогени угљеник</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56586_3186047_3186433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of measuring, tracking, and reporting the amount of carbon dioxide (CO2) and other greenhouse gases (GHGs) that an organization, project or activity emits or removes from the atmosphere.</descrip></descripGrp><ntig><termGrp><term id="3186047">carbon accounting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3186433">обрачунавање угљеника</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56587_3186048_3186434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fee that company charges itself for each unit of CO2 that it emits. It is market-based approach to drive environmental sustainability and promote a transition to a low-carbon economy.</descrip></descripGrp><ntig><termGrp><term id="3186048">carbon fee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3186434">накнада за емитовање угљеника</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56588_3186049_3186435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A guideline aimed at creating products, systems, and processes that minimize waste and make the most of resources by keeping materials in use for as long as possible.</descrip></descripGrp><ntig><termGrp><term id="3186049">circularity design principle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3186435">принцип дизајна циркуларности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56589_3186050_3186436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The functionality that helps organizations unify and streamline energy data to achieve their energy sustainability goals. It helps to unify, standardize, and streamline energy data collection and storage for organizations across generation, procurement, and end use into a single unified data model.</descrip></descripGrp><ntig><termGrp><term id="3186050">energy data model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3186436">модел података о енергији</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56590_3186051_3186437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of related emission factors.</descrip></descripGrp><ntig><termGrp><term id="3186051">factor library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3186437">библиотека фактора</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56591_3186052_3186438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that measures how much energy the emissions for one ton of a given gas absorb over a period of time, respective to the emissions of one ton of carbon dioxide (CO2).</descrip></descripGrp><ntig><termGrp><term id="3186052">GWP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3186438">GWP</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56592_3186053_3186439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process used to evaluate the environmental impacts associated with all stages of a product's life, from raw material extraction through materials processing, manufacturing, distribution, use, repair and maintenance, and disposal or recycling.</descrip></descripGrp><ntig><termGrp><term id="3186053">LCA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3186439">LCA</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56592_3186053_3186440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process used to evaluate the environmental impacts associated with all stages of a product's life, from raw material extraction through materials processing, manufacturing, distribution, use, repair and maintenance, and disposal or recycling.</descrip></descripGrp><ntig><termGrp><term id="3186053">LCA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3186440">процена животног циклуса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56592_3186056_3186439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process used to evaluate the environmental impacts associated with all stages of a 