_1513907_1503694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that appears in a newsgroup, public folder, or other forum, such as Facebook or Twitter, accessible by a number of individuals.</descrip></descripGrp><ntig><termGrp><term id="1513907">discussion entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503694">поставити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8290_1513907_1778494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that appears in a newsgroup, public folder, or other forum, such as Facebook or Twitter, accessible by a number of individuals.</descrip></descripGrp><ntig><termGrp><term id="1513907">discussion entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1778494">порука</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8290_1513907_2710543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that appears in a newsgroup, public folder, or other forum, such as Facebook or Twitter, accessible by a number of individuals.</descrip></descripGrp><ntig><termGrp><term id="1513907">discussion entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2710543">ставка у дискусији</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8290_1513907_2710631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that appears in a newsgroup, public folder, or other forum, such as Facebook or Twitter, accessible by a number of individuals.</descrip></descripGrp><ntig><termGrp><term id="1513907">discussion entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2710631">објава</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8291_182217_2621369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">User-defined text (descriptive or instructional including input masks and formatting rules) specific to a database or database object. The text is stored in the database as a property of the database or object.</descrip></descripGrp><ntig><termGrp><term id="182217">extended property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2621369">проширено својство</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8292_314061_1503695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The meaning of data as it is intended to be interpreted by people.</descrip></descripGrp><ntig><termGrp><term id="314061">info</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503695">информација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8292_314061_1516918"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The meaning of data as it is intended to be interpreted by people.</descrip></descripGrp><ntig><termGrp><term id="314061">info</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1516918">информације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8292_66163_1503695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The meaning of data as it is intended to be interpreted by people.</descrip></descripGrp><ntig><termGrp><term id="66163">information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503695">информација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8292_66163_1516918"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The meaning of data as it is intended to be interpreted by people.</descrip></descripGrp><ntig><termGrp><term id="66163">information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1516918">информације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="83_351289_1502730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any address type that the MS Mail postoffice does not have a gateway or access component installed for routing.</descrip></descripGrp><ntig><termGrp><term id="351289">foreign address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502730">страна адреса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8304_335528_2542060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information in a campaign that is intended to be communicated to marketing list members about the campaign. For example this content could be the dialog for a phone call or the body text of an email message.</descrip></descripGrp><ntig><termGrp><term id="335528">content</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542060">садржај</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="832_1176946_1502826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having two components, alternatives, or outcomes. The binary number system has 2 as its base, so values are expressed as combinations of two digits, 0 and 1. These two digits can represent the logical values true and false as well as numerals, and they can be represented in an electronic device by the two states on and off, recognized as two voltage levels. Therefore, the binary number system is at the heart of digital computing.</descrip></descripGrp><ntig><termGrp><term id="1176946">base 2</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502826">бинарно</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="832_21220_1502826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having two components, alternatives, or outcomes. The binary number system has 2 as its base, so values are expressed as combinations of two digits, 0 and 1. These two digits can represent the logical values true and false as well as numerals, and they can be represented in an electronic device by the two states on and off, recognized as two voltage levels. Therefore, the binary number system is at the heart of digital computing.</descrip></descripGrp><ntig><termGrp><term id="21220">binary</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502826">бинарно</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8320_346966_1503696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To safeguard a resource from attack or loss.</descrip></descripGrp><ntig><termGrp><term id="346966">protect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503696">заштитити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8323_306401_1503697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter effect in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="306401">Posterize</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503697">Постеризaција</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8327_240558_2542018"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A home page pane with links to online services, program-specific features, help topics, or other information.</descrip></descripGrp><ntig><termGrp><term id="240558">Spotlight</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542018">У жижи интересовања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8333_397163_406449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hierarchy of folders in the Exchange store very similar in structure to the standard file system. A single folder can contain child folders, which, in turn, can contain other child folders.</descrip></descripGrp><ntig><termGrp><term id="397163">folder tree</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406449">стабло фасцикли</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8354_178490_2541874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Similar to adjusted price, except it is not displayed in the local currency (that is, there is no currency associated with the price).</descrip></descripGrp><ntig><termGrp><term id="178490">adjusted price value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541874">вредност кориговане цене</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8356_116839_1503698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a formatting style in which characters are crossed out by horizontal line.</descrip></descripGrp><ntig><termGrp><term id="116839">strikethrough</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503698">прецртано</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8360_233481_609634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules that are applied to email messages. These rules govern how messages are processed and stored, based on a set of requirements. The requirements are typically based on regulatory requirements for an industry or geographic region.</descrip></descripGrp><ntig><termGrp><term id="233481">Message Policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="609634">Смернице порука</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8365_211347_3026237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical user-interface tool used to design and implement business processes.</descrip></descripGrp><ntig><termGrp><term id="211347">Orchestration Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3026237">Дизајнер оркестрације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8369_226552_1503699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that notifies a user when there is a change to posted content, workflow status, or when other user-defined criteria are met.</descrip></descripGrp><ntig><termGrp><term id="226552">alert</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503699">упозорење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8370_143265_1916701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of the last 10 files you jumped to in the current program session using hyperlinks.</descrip></descripGrp><ntig><termGrp><term id="143265">History list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916701">Списак историје</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8370_143265_2541786"><langSet xml:lang="en-US"><descripGrp><descrip