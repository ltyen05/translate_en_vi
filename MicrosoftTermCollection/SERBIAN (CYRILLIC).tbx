ll as extensive documentation to support their organizations deploy Insider builds.</descrip></descripGrp><ntig><termGrp><term id="2483525">Insider for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2570513">Инсајдер за предузећа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44196_2483525_2570534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extension to the Windows Insider Program to include engagement for enterprises and SMEs through dedicated forums, blogs and events, regular surveys with IT professionals, as well as extensive documentation to support their organizations deploy Insider builds.</descrip></descripGrp><ntig><termGrp><term id="2483525">Insider for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2570534">Програм Windows инсајдер за предузећа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44198_2484585_2489586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft lock screen app for Android that allows users to see messages, launch apps, use the camera and flashlight, check weather, see upcoming calendar events, and control music without unlocking the phone.</descrip></descripGrp><ntig><termGrp><term id="2484585">Next Lock Screen</term><termNote type="partOfS