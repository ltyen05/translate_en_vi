p></ntig></langSet></termEntry><termEntry id="34327_1991437_3005891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox online brand gaming and entertainment network.</descrip></descripGrp><ntig><termGrp><term id="1991437">Xbox Live</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3005891">Xbox мрежа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34327_3005788_2400632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox online brand gaming and entertainment network.</descrip></descripGrp><ntig><termGrp><term id="3005788">Xbox network</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2400632">Xbox Live</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34327_3005788_3005891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox online brand gaming and entertainment network.</descrip></descripGrp><ntig><termGrp><term id="3005788">Xbox network</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3005891">Xbox мрежа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34328_1991438_2918495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Games and other applications that are served and run directly from the Xbox Live service, typically with an additional fee to play.</descrip></descripGrp><ntig><termGrp><term id="1991438">Arcade</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918495">Arcade</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34329_1991439_2918778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Games that are created by the Xbox community and downloaded from the Xbox Live service, typically with a fee to play the full game.</descrip></descripGrp><ntig><termGrp><term id="1991439">Indie Games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918778">Игре из заједнице</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34330_1991440_2920768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of Xbox Live that caters to a particular style of gameplay. Four zones exist: pro, recreation, family, and underground.</descrip></descripGrp><ntig><termGrp><term id="1991440">Xbox Live Gamer Zone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920768">Зона за играче у услузи Xbox Live</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34331_1991441_2920779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of players on Xbox Live that can play games and chat together.</descrip></descripGrp><ntig><termGrp><term id="1991441">Xbox Live Party</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920779">Група у услузи Xbox Live</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34333_1991443_2920745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Brand name of the games offering from Xbox.</descrip></descripGrp><ntig><termGrp><term id="1991443">Xbox Games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920745">Xbox Games</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34335_1991445_2920838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for Windows 8, Windows Phone, and other portable devices that connects phones, PCs, and tablets with your Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="1991445">Xbox SmartGlass</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920838">Xbox SmartGlass</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34335_1991445_2920839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for Windows 8, Windows Phone, and other portable devices that connects phones, PCs, and tablets with your Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="1991445">Xbox SmartGlass</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920839">Xbox SmartGlass помоћник</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34335_2432221_2920838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for Windows 8, Windows Phone, and other portable devices that connects phones, PCs, and tablets with your Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="2432221">Xbox SmartGlass Companion</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920838">Xbox SmartGlass</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34335_2432221_2920839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for Windows 8, Windows Phone, and other portable devices that connects phones, PCs, and tablets with your Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="2432221">Xbox SmartGlass Companion</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920839">Xbox SmartGlass помоћник</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34337_1991447_2919209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live account.</descrip></descripGrp><ntig><termGrp><term id="1991447">membership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919209">чланство</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34338_1991448_2919363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Code used to restrict access, entered using a combination of controller button and trigger presses.</descrip></descripGrp><ntig><termGrp><term id="1991448">passcode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919363">кôд</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34339_1991449_2919570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live account security feature in which Xbox sends a one-time code to a customer's preference of contact options (email, text message, or phone), allowing them to return the code to verify their identity.</descrip></descripGrp><ntig><termGrp><term id="1991449">security check</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919570">безбедносна провера</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34340_1991450_2919518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a transaction in which Microsoft Points are exchanged.</descrip></descripGrp><ntig><termGrp><term id="1991450">redeem</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919518">искористити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34341_1991451_2919519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To extend an Xbox Live membership.</descrip></descripGrp><ntig><termGrp><term id="1991451">renew</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919519">обновити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34342_1991452_2920761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Membership code that is purchased or won through offers, contests, events, and so on.</descrip></descripGrp><ntig><termGrp><term id="1991452">Xbox Live code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920761">Xbox Live кôд</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34344_1991454_2920767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Basic level of Xbox Live membership.</descrip></descripGrp><ntig><termGrp><term id="1991454">Xbox Live Free membership</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920767">бесплатно чланство за Xbox Live</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34345_1991455_2919041"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The controller-free gaming experience from Xbox.</descrip></descripGrp><ntig><termGrp><term id="1991455">Kinect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919041">Kinect</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_1991456_2176555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="1991456">Kinect sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2176555">Kinect сензор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_1991456_2919046"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="1991456">Kinect sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919046">Kinect сензор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_1991456_2919571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="1991456">Kinect sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919571">сензор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_2013412_2176555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="2013412">sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2176555">Kinect сензор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_2013412_2919046"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="2013412">sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919046">Kinect сензор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_2013412_2919571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="2013412">sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919571">сензор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34347_1991457_2918503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The automatic angle adjustment function of the Kinect sensor.</descrip></descripGrp><ntig><termGrp><term id="1991457">auto-tilt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918503">аутоматски нагиб</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34348_1991458_2918625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The infrared camera component of the Kinect sensor.</descrip></descripGrp><ntig><termGrp><term id="1991458">depth sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918625">сензор дубине</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34349_1991459_2920500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The RGB camera component of the Kinect sensor.</descrip></descripGrp><ntig><termGrp><term id="1991459">video sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920500">видео сензор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34350_1991460_2918696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The entire area that the sensor can "see," including walls, furniture, and other obstructions.</descrip></descripGrp><ntig><termGrp><term id="1991460">field of view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918696">видно поље</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34351_1991461_2919389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area within the Kinect sensor's field of view is able to detect a person or in which a player moves.</descrip></descripGrp><ntig><termGrp><term id="1991461">play space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919389">простор за игру</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34352_1991462_2918690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Facial identification used by the sensor to recognize a player.</descrip></descripGrp><ntig><termGrp><term id="1991462">facial recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918690">препознавање лица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34353_1991463_2918740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A motion made by a player that's intended to be tracked by the sensor.</descrip></descripGrp><ntig><termGrp><term id="1991463">gesture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918740">гест</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34354_1991464_2918744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In-game gesture that invokes the Kinect Guide.</descrip></descripGrp><ntig><termGrp><term id="1991464">guide gesture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918744">гест вођења</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34355_1991465_2919044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Biometric recognition of a player by the system, through the use of the Kinect sensor and software.</descrip></descripGrp><ntig><termGrp><term id="1991465">Kinect ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919044">Kinect ID</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34356_1991466_2918745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual progress indicator that appears in the corner of the screen when a player performs the guide gesture. Because the icon is only visible when cued by the guide gesture, use only when necessary to specifically call out its functionality, as in an instructional demo, for example.</descrip></descripGrp><ntig><termGrp><term id="1991466">guide icon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918745">икона вођења</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34357_1991467_2918763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The icon that appears when a player is detected in the play space, prompting a wave to engage with Kinect. Once engaged, a hand pointer appears, which serves as a mechanism for navigation and object manipulation.</descrip></descripGrp><ntig><termGrp><term id="1991467">hand icon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918763">икона руке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34358_1991468_2919222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The icon that is present when the Kinect microphone is available to accept voice commands.</descrip></descripGrp><ntig><termGrp><term id="1991468">microphone icon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919222">икона микрофона</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34359_1991469_2919596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Spoken input that's intended to be received and interpreted by the sensor as input.</descrip></descripGrp><ntig><termGrp><term id="1991469">speech</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919596">говор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34360_1991470_2920110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The detection and following of a person's movements by the sensor.</descrip></descripGrp><ntig><termGrp><term id="1991470">tracking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920110">праћење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34361_1991471_2920510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Vocal input that's used by the sensor to identify a player.</descrip></descripGrp><ntig><termGrp><term id="1991471">voice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920510">глас</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34362_1991472_2920518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The panel that appears in the Xbox Dashboard when the Kinect sensor recognizes the voice command "Xbox".</descrip></descripGrp><ntig><termGrp><term id="1991472">voice bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920518">гласовна трака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34363_1991473_2920493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Video communication with another player on Xbox Live, using the Kinect sensor. Formerly video chat.</descrip></descripGrp><ntig><termGrp><term id="1991473">Video Kinect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2920493">Video Kinect</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34364_1991474_2919043"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect based guide that appears over a game and allows for social interactions (friends, invites, chat, etc.).</descrip></descripGrp><ntig><termGrp><term id="1991474">Kinect Guide</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919043">водич за Kinect</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34365_1991475_2919048"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect based troubleshooter that helps users with common problems related to the play space, lighting, speech/audio, setup, and hardware errors.</descrip></descripGrp><ntig><termGrp><term id="1991475">Kinect Tuner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919048">Kinect подешавање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34366_1991476_2918707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Disc used for playing games.</descrip></descripGrp><ntig><termGrp><term id="1991476">game disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918707">диск са игром</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34367_1991477_2918613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a permanent attachment between a wireless controller and the console.</descrip></descripGrp><ntig><termGrp><term id="1991477">connect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918613">повезати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34368_1991478_2918616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When in vertical orientation, the stabilizers at the bottom of the console.</descrip></descripGrp><ntig><termGrp><term id="1991478">console feet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918616">стабилизатори конзоле</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34369_1991479_2918618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the USB ports on the front of the console that support the controllers and other USB devices such as cameras and audio players.</descrip></descripGrp><ntig><termGrp><term id="1991479">controller port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918618">порт контролера</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34370_1991480_2918619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cover of a controller port on the console.</descrip></descripGrp><ntig><termGrp><term id="1991480">controller port cover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918619">поклопац порта контролера</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34371_1991481_2918627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The console disc drive.</descrip></descripGrp><ntig><termGrp><term id="1991481">disc drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918627">диск јединица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34372_1991482_2918628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The console disc tray.</descrip></descripGrp><ntig><termGrp><term id="1991482">disc tray</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918628">лежиште диска</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34373_1991483_2918639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The console disc tray eject button.</descrip></descripGrp><ntig><termGrp><term id="1991483">eject button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918639">дугме за избацивање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34374_1991484_2918640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Ethernet port on the back of the console.</descrip></descripGrp><ntig><termGrp><term id="1991484">Ethernet port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918640">Ethernet порт</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34375_1991485_2918764"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of the console where the hard drive is attached.</descrip></descripGrp><ntig><termGrp><term id="1991485">hard drive bay</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918764">лежиште чврстог диска</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34376_1991486_2918765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cover that protects the hard drive bay in the absence of an attached hard drive.</descrip></descripGrp><ntig><termGrp><term id="1991486">hard drive bay cover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918765">поклопац лежишта чврстог диска</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote 