umber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53611_3052168_3053008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Outlook that empowers individuals to set up personal appointment booking pages to eliminate the back-and-forth of scheduling 1:1 meetings while still maintaining control of their calendar.</descrip></descripGrp><ntig><termGrp><term id="3052168">Bookings with me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3053008">Bookings са мном</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53612_3052180_3053029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app in Microsoft Teams that allows organizations to create basic check-in forms for a range of processes (end of shift, store evaluations, recurring action items) based off out-of-the-box tools.</descrip></descripGrp><ntig><termGrp><term id="3052180">Updates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3053029">Новости</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53613_3052187_3053022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that connects business owners with payment providers in Microsoft Teams and helps them receive payments from customers while they register for 