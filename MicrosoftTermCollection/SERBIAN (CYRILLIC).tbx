ig></langSet></termEntry><termEntry id="29461_1508809_2542337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that enhances the functionality of Microsoft Office 2002 and your Web browser by extending the functionality of a Web server to provide publishing, collaboration, and document management capabilities.</descrip></descripGrp><ntig><termGrp><term id="1508809">Microsoft Office Server Extensions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542337">Проширења за Microsoft Office Server</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29462_1508810_1917221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar with buttons and options used to apply text formatting. To display the toolbar, point to Toolbars on the View menu, and then click Formatting.</descrip></descripGrp><ntig><termGrp><term id="1508810">Formatting toolbar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917221">Tрака са алaтима за форматирање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29462_1508810_2542338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar with buttons and options used to apply text formatting. To display the toolbar, point to Toolbars on the View menu, and then click Formatti