ig></langSet></termEntry><termEntry id="51488_2898927_2901570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft website that provides product and service information, a technical database, downloads, documentation, and online training as a benefit to Dynamics customers.</descrip></descripGrp><ntig><termGrp><term id="2898927">CustomerSource</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2901570">CustomerSource</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51491_2898943_2899187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows app that helps users assess the current state of their device on dimensions like battery life, storage, and updates and recommends ways to improve the device's performance or compare with the performance of a new PC.</descrip></descripGrp><ntig><termGrp><term id="2898943">Windows PC Health Check</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2899187">Провјера стања Windows рачунара</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51491_2898943_2899527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows app that helps users assess the current state of their device on dimensions like battery life, storage, and updates and recomm