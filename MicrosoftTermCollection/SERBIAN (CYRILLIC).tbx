2">случај управљања инсајдерским ризиком</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50335_2844769_2846881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In insider risk management, a template that allows administrators to automatically send email messages to employees when their activities generate a policy match and alert.</descrip></descripGrp><ntig><termGrp><term id="2844769">notice template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2846881">предложак за напомену</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50336_2844806_2846646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A validation of a partner’s capability to deliver high-fidelity services in a specific solution area. Advanced specializations are customer-facing labels displayed on a partner’s business profile in the Partner Directory, enabling partners to showcase their differentiated skills.</descrip></descripGrp><ntig><termGrp><term id="2844806">advanced specialization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2846646">напредна специјализација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50337_2844818_2846686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A validation of a partner’s broad technical capability in a Microsoft product or technology.</descrip></descripGrp><ntig><termGrp><term id="2844818">competency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2846686">компетенција</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50338_2844833_2846626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advanced specialization that provides a means for partners to showcase proven expertise and verifiable accreditation in adoption and change management services via Microsoft 365 Teams and Yammer.</descrip></descripGrp><ntig><termGrp><term id="2844833">Adoption and change management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2846626">Управљање усвајањем и променама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50339_2844838_2846776"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advanced specialization that provides a means for partners to showcase proven, verifiable expertise in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="2844838">Meetings and meeting rooms for Microsoft Teams</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2846776">Састанци и собе за састанке за Microsoft Teams</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50340_2844846_2846899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advanced specialization that allows partners to showcase proven expertise and Microsoft engineering approved methodologies for deploying Office 365.</descrip></descripGrp><ntig><termGrp><term id="2844846">teamwork deployment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2846899">тимска имплементација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50341_2844851_2846637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Teams add-on that will include features/capabilities such as priority notifications, targeting in chats, channels, and tasks (third-party, dynamic), and workflow driven escalations.</descrip></descripGrp><ntig><termGrp><term id="2844851">Advanced Collaboration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2846637">Напредна сарадња</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammatical