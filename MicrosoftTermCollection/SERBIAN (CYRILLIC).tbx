ackscatter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2691892">backscatter</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26653_1331120_1356327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instance that begins when someone signs into a web service or program.</descrip></descripGrp><ntig><termGrp><term id="1331120">session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356327">сесија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2668_237838_2542011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option under the Columns heading on the Report window that allows users to select columns that contain tracking information such as "Created By" and "Modified On".</descrip></descripGrp><ntig><termGrp><term id="237838">Tracking Columns</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542011">Колоне за праћење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26685_1346459_1356328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display name UI label used when there isn’t a display name value available, as when data can't be retrieved or someone hasn’t completely filled out their profile.</descrip></descripGrp><ntig><termGrp><term id="1346459">Someone on Windows Live</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356328">Непознати Windows Live корисник</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26685_1346459_1527843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display name UI label used when there isn’t a display name value available, as when data can't be retrieved or someone hasn’t completely filled out their profile.</descrip></descripGrp><ntig><termGrp><term id="1346459">Someone on Windows Live</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1527843">Неко</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26685_1380060_1356328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display name UI label used when there isn’t a display name value available, as when data can't be retrieved or someone hasn’t completely filled out their profile.</descrip></descripGrp><ntig><termGrp><term id="1380060">Someone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356328">Непознати Windows Live корисник</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26685_1380060_1527843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display name UI label used when there isn’t a display name value available, as when data can't be retrieved or someone hasn’t completely filled out their profile.</descrip></descripGrp><ntig><termGrp><term id="1380060">Someone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1527843">Неко</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26686_1346464_1356329"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The label for the Windows Live Devices task webpage where someone specifies a name and an icon for the computer that they plan to sync.</descrip></descripGrp><ntig><termGrp><term id="1346464">Personalize</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356329">Персонализација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26687_1346465_1356330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The group label for the links that provide one-click access to a subset of email messages based on specific criteria, such as flagged, containing photos, and from social networking services.</descrip></descripGrp><ntig><termGrp><term id="1346465">Quick views</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356330">Брзи прикази</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2669_153111_1503031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of bits transmitted every second, used as a measure of the speed at which a device, such as a modem, can transfer data.</descrip></descripGrp><ntig><termGrp><term id="153111">bits per second</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503031">бита у секунди</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2669_153111_1503032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of bits transmitted every second, used as a measure of the speed at which a device, such as a modem, can transfer data.</descrip></descripGrp><ntig><termGrp><term id="153111">bits per second</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503032">bps</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2669_153112_1503031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of bits transmitted every second, used as a measure of the speed at which a device, such as a modem, can transfer data.</descrip></descripGrp><ntig><termGrp><term id="153112">bps</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503031">бита у секунди</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2669_153112_1503032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of bits transmitted every second, used as a measure of the speed at which a device, such as a modem, can transfer data.</descrip></descripGrp><ntig><termGrp><term id="153112">bps</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503032">bps</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26690_1347061_1356331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for the Hotmail quick view that displays only the email messages that originate from a social networking service such as Facebook.</descrip></descripGrp><ntig><termGrp><term id="1347061">Social updates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356331">Новости са друштвених мрежа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26690_1347061_1998610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for the Hotmail quick view that displays only the email messages that originate from a social networking service such as Facebook.</descrip></descripGrp><ntig><termGrp><term id="1347061">Social updates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1998610">Ажурирања на друштвеној мрежи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26691_1347063_1356332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The spam-fighting program that Hotmail runs where actual customers classify email messages as "junk" or "not junk." Because the program is by invitation only, customers who participate are highly engaged. The Hotmail team reported in 2010 that more than half of the spam fighters participate daily. Invitations to the program are extended to a cross-section of customers who reflect the broad population of Hotmail customers in several dimensions, including age of account and country or region. Under the program, Hotmail resends an actual message that was addressed to the spam fighter. One message per day at the most is sent.</descrip></descripGrp><ntig><termGrp><term id="1347063">Spam Fighters program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356332">програм Spam Fighters</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26691_1354361_1356332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The spam-fighting program that Hotmail runs where actual customers classify email messages as "junk" or "not junk." Because the program is by invitation only, customers who participate are highly engaged. The Hotmail team reported in 2010 that more than half of the spam fighters participate daily. Invitations to the program are extended to a cross-section of customers who reflect the broad population of Hotmail customers in several dimensions, including age of account and country or region. Under the program, Hotmail resends an actual message that was addressed to the spam fighter. One message per day at the most is sent.</descrip></descripGrp><ntig><termGrp><term id="1354361">Feedback Loop program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356332">програм Spam Fighters</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26692_1347064_1356333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rating system for online games.</descrip></descripGrp><ntig><termGrp><term id="1347064">game rating system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356333">систем за оцењивање игара</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26696_1347068_1356334"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conversation that is displayed with other conversations in one window. The conversations are loaded into sections or tabs of the window, rather than in multiple windows.</descrip></descripGrp><ntig><termGrp><term id="1347068">tabbed conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356334">разговор приказан на картицама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26697_1347069_1356335"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The webpage subheading for the view in Messenger that displays the social activity of friends.</descrip></descripGrp><ntig><termGrp><term id="1347069">social</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356335">друштвени догађаји</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26698_1347070_1356336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label in Messenger for the aspect of the social view that displays prioritized recent social activity of friends.</descrip></descripGrp><ntig><termGrp><term id="1347070">highlights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356336">истакнути садржаји</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26699_1347071_1356337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email message that has image attachements, inline images, inline video, or an inline album.</descrip></descripGrp><ntig><termGrp><term id="1347071">photo e-mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356337">е-порука са фотографијама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2670_233117_2373025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of project in which the customer pays a predetermined amount for the entire project.</descrip></descripGrp><ntig><termGrp><term id="233117">fixed-price project</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2373025">пројекат са фиксном ценом</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2670_627844_2373025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of project in which the customer pays a predetermined amount for the entire project.</descrip></descripGrp><ntig><termGrp><term id="627844">fixed fee job</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2373025">пројекат са фиксном ценом</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26700_1347072_1356338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom-created layout of photos in an album.</descrip></descripGrp><ntig><termGrp><term id="1347072">arrangement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356338">распоред</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26702_1347074_1356339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets you work on your computer from a different computer.</descrip></descripGrp><ntig><termGrp><term id="1347074">remote connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356339">даљинска веза</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26703_1347075_1356340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tooltip that is displayed when hovering over a personal folder on the Manage Folders webpage.</descrip></descripGrp><ntig><termGrp><term id="1347075">Personal Folder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356340">Лична фасцикла</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26704_1347076_1356341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The webpage subheading for the list of synced folders.</descrip></descripGrp><ntig><termGrp><term id="1347076">Synced folders</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356341">Синхронизоване фасцикле</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26705_1347077_1356342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI element that allows users to set permissions for an item or content so that is not made available to anyone else, thus making it private.</descrip></descripGrp><ntig><termGrp><term id="1347077">Just me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356342">Само мени</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26706_1347078_1356343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for the social activity stream that Windows Live programmatically displays in a collection. Items listed may originate within a Windows Live program, service, or landing page (Messenger, OneDrive, Windows Live Photos), or in third-party activities people connect to their profiles, such as Facebook.</descrip></descripGrp><ntig><termGrp><term id="1347078">Messenger social</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356343">Messenger - друштвене активности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26706_1347078_1761371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for the social activity stream that Windows Live programmatically displays in a collection. Items listed may originate within a Windows Live program, service, or landing page (Messenger, OneDrive, Windows Live Photos), or in third-party activities people connect to their profiles, such as Facebook.</descrip></descripGrp><ntig><termGrp><term id="1347078">Messenger social</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1761371">Друштвена размјена порука</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26707_1347079_1356344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To manually edit and make adjustments to your photos.</descrip></descripGrp><ntig><termGrp><term id="1347079">fine tune</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356344">прецизно подесити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26708_1347080_1356345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A metadata tag that includes GPS latitude and longitude coordinates to specify a location. Geotags are typically used to find and organise photos and videos.</descrip></descripGrp><ntig><termGrp><term id="1347080">geotag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356345">географска ознака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26709_1347081_1356346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To present items within a set in no established order, as opposed to ordering items by name, by date taken, by size, etc., and typically used with audio and visual media, such as album song order or photo slide shows.</descrip></descripGrp><ntig><termGrp><term id="1347081">shuffle</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356346">насумично изабрати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26710_1347082_1356347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to share stories with others using their digital photos and photo management software.</descrip></descripGrp><ntig><termGrp><term id="1347082">storytelling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356347">препричавање догађаја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26711_1375309_1356348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Direct digital-to-digital conversion of one encoding to another. Converting is usually done to incompatible or obsolete data in order to convert it into a more suitable format.</descrip></descripGrp><ntig><termGrp><term id="1375309">converting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356348">конвертовање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26714_1347086_1356349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a personal touch to something.</descrip></descripGrp><ntig><termGrp><term id="1347086">personalize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356349">персонализовати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26718_1347107_1821523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The trend of completed and remaining work over a specified time period.</descrip></descripGrp><ntig><termGrp><term id="1347107">burndown</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1821523">преоптерећеност послом</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26719_1347108_1356350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that provides one-click access to a subset of email messages based on specific criteria, which include: flagged (messages that the customer has designated as requiring follow-up), photos (messages that contain photos), and social updates (messages that originate from a social networking service such as Facebook).</descrip></descripGrp><ntig><termGrp><term id="1347108">quick view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356350">брзи приказ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26720_1347110_1527815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The webpage subheading for the view in Messenger that displays someone's friends and contacts that aren't friends but that can be interacted with in Messenger (those are often legacy entries).</descrip></descripGrp><ntig><termGrp><term id="1347110">friends</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1527815">пријатељи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26729_1354363_1523610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specific reporting job that automatically checks for potential configuration, performance, and usage problems.</descrip></descripGrp><ntig><termGrp><term id="1354363">health rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523610">правило ваљаности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26731_1354365_1917194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An equation written using a stylus on a Tablet PC.</descrip></descripGrp><ntig><termGrp><term id="1354365">ink equation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917194">руком написана једначина</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26735_1354369_1989494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is meant to run on a desktop or laptop computer.</descrip></descripGrp><ntig><termGrp><term id="1354369">desktop application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1989494">десктоп програм<