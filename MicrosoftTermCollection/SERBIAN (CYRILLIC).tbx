ovides users with a time-limited passcode that will serve as strong credentials for a specific amount of time, making it easy for the end user to securely log on and be productive.</descrip></descripGrp><ntig><termGrp><term id="2878672">Temporary Access Pass</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2879507">Привремени кôд за приступ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50941_2878673_2879505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A time-limited passcode that will serve as strong credentials for a specific amount of time, making it easy for the end user to securely log on and be productive.</descrip></descripGrp><ntig><termGrp><term id="2878673">temporary access pass</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2879505">привремени кôд за приступ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50963_2879286_2879893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An inspection of devices, mailboxes, and other types of entities performed automatically in response to various detections, after which remediation actions might be taken on malicious and suspicious items found during the investigation.</descrip></descripGrp><ntig><termGrp><term id="2879286">automated investigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2879893">аутоматизовано испитивање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50964_2879287_2879894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A threat remediation mechanism that automatically applies various actions, such as file quarantine or deletion of persistence mechanism in the registry, based on the results of a corresponding automated investigation.</descrip></descripGrp><ntig><termGrp><term id="2879287">automatic remediation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2879894">аутоматски опоравак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50965_2879288_2879891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query-based proactive threat hunting capability that provides flexible options for locating undetected breach activity as well as network assets that require attention.</descrip></descripGrp><ntig><termGrp><term id="2879288">advanced hunting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2879891">напредна потрага за пријетњама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type