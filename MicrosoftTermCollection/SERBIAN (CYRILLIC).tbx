le in a manufacturing process.</descrip></descripGrp><ntig><termGrp><term id="2570262">Kanban</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2576462">Канбан</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45617_2572043_2576713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An average of the secure scores of organizations that have a similar number of Office 365 active seats.</descrip></descripGrp><ntig><termGrp><term id="2572043">active seat average score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2576713">просечна оцена безбедности активног места</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45618_2572044_2576744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of tools and dashboards in the Office 365 Security &amp; Compliance Center that monitors signals from sources, analyzes them based on a repository of threat intelligence, and presents data that allows decision makers and administrators to react to threats.</descrip></descripGrp><ntig><termGrp><term id="2572044">Office 365 Threat Intelligence</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2576744">Office 365 информације о претњама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45618_2572044_2576755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of tools and dashboards in the Office 365 Security &amp; Compliance Center that monitors signals from sources, analyzes them based on a repository of threat intelligence, and presents data that allows decision makers and administrators to react to threats.</descrip></descripGrp><ntig><termGrp><term id="2572044">Office 365 Threat Intelligence</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2576755">Информације о претњама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45618_2572936_2576744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of tools and dashboards in the Office 365 Security &amp; Compliance Center that monitors signals from sources, analyzes them based on a repository of threat intelligence, and presents data that allows decision makers and administrators to react to threats.</descrip></descripGrp><ntig><termGrp><term id="2572936">Threat Intelligence</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2576744">Office 365 информације о претњама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Prop