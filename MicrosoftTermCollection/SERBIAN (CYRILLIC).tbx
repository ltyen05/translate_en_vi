><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46530_2815604_2818225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft design language developed in 2017 that contains a set of UWP features and guidelines for creating UWP apps that perform beautifully across devices, inputs, and dimensions. The guidelines are divided into several categories: layout, style, controls, input and devices, and usability.</descrip></descripGrp><ntig><termGrp><term id="2815604">Fluent Design System</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2818225">систем Fluent Design</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46533_2619438_2620099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Windows Defender Security Center that helps protect devices running Windows 10 by checking web content that Microsoft Store apps use.​</descrip></descripGrp><ntig><termGrp><term id="2619438">App protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2620099">Заштита у апликацијама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46534_2619566_2620100