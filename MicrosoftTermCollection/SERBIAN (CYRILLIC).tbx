ion">A continuously supplied summary of activity.</descrip></descripGrp><ntig><termGrp><term id="3021180">feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3022311">feed о активностима</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53095_3021180_3022336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A continuously supplied summary of activity.</descrip></descripGrp><ntig><termGrp><term id="3021180">feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3022336">feed</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53096_3021181_3022333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program for Microsoft Teams that makes it easy for customers to trade in their aging unified communications devices in exchange for cash.</descrip></descripGrp><ntig><termGrp><term id="3021181">Device Trade-In</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3022333">Откуп уређаја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53097_3021182_3022337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The character within the Reflect app in Microsoft Teams that helps students learn about their emotions and expand their vocabulary to help them express how they feel as a critical part of Educational Insights, a tool that enables educators to track and connect student engagement, academic performance, and well-being data to develop a holistic understanding of how to best help students thrive.</descrip></descripGrp><ntig><termGrp><term id="3021182">Feelings Monster</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3022337">Емотивко</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53098_3021183_3022342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The starter plan for Microsoft Managed Desktop.</descrip></descripGrp><ntig><termGrp><term id="3021183">Microsoft Managed Desktop Plan 1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3022342">Microsoft Managed Desktop план 1</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53099_3021184_3022343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The premium plan for Microsoft Managed Desktop.</descrip></descripGrp><ntig><termGrp><term id="3021184">Microsoft Managed Desktop Plan 2</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3022343">Microsoft Managed Desktop план 2</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53100_3021185_3022331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Teams that enables the users to choose the spacing in their own chat with two settings, comfortable and compact.</descrip></descripGrp><ntig><termGrp><term id="3021185">chat density</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3022331">густина ћаскања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53101_3021186_3022350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A detailed manufacturing plant design, including the building, machinery, storage, and shipping and receiving facilities.</descrip></descripGrp><ntig><termGrp><term id="3021186">plant layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3022350">план постројења</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53102_3021187_3022351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram type that helps make quick work of designing and documenting a rack of network equipment. When purchasing equipment, rack diagrams can help you determine which equipment and racks to buy.</descrip></descripGrp><ntig><termGrp><term id="3021187">rack diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3022351">дијаграм полица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53103_3021188_3022312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical representation for specifying business processes in a business process model.</descrip></descripGrp><ntig><termGrp><term id="3021188">Business Process Model and Notation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3022312">BPMN</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53103_3021188_3022325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical representation for specifying business processes in a business process model.</descrip></descripGrp><ntig><termGrp><term id="3021188">Business Process Model and Notation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="gramma