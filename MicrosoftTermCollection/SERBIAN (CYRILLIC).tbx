">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43189_2446335_2450398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery feature that classifies files into unique files, duplicates and near-duplicates, finds and structures email threads, and that organizes documents into themes.</descrip></descripGrp><ntig><termGrp><term id="2446335">Analyze</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2450398">Анализа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43190_2446336_2450399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery feature that evaluates the richness of files.</descrip></descripGrp><ntig><termGrp><term id="2446336">Assessment</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2450399">Процена</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43191_2446337_2450421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of emails and attachments that belong together.</descrip></descripGrp><ntig><termGrp><term id="2446337">family</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">No