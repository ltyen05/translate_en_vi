49791"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in Microsoft Teams for Education that provides the user with at-a-glance data views to help them monitor their students' Teams activity, including overall digital engagement, assignment turn-in, communication activity, and grade distribution and trends.</descrip></descripGrp><ntig><termGrp><term id="2949265">Education Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2949791">Insights за образовање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51506_2899584_2899686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The video conferencing mode in Microsoft Teams in which participants' video feeds are combined on the screen in such a way as to give the participants the impression that they are all in the same physical space together.</descrip></descripGrp><ntig><termGrp><term id="2899584">Together mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2899686">Заједнички режим</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51507_2899585_2899683"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view in Microsoft Teams that allows the user to see up to 49 video feeds at once.</descrip></descripGrp><ntig><termGrp><term id="2899585">Large gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2899683">Велика галерија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51508_2899586_2899681"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view in Microsoft Teams that allows the user to see up to 9 video feeds at once.</descrip></descripGrp><ntig><termGrp><term id="2899586">Gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2899681">Галерија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51509_2899587_2899684"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A billing model wherein an associated payment method is charged automatically over set periods of time.</descrip></descripGrp><ntig><termGrp><term id="2899587">recurring billing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2899684">наплата која се понавља</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51509_2899587_2900484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A billing model wherein an associated payment method is charged automatically over set periods of time.</descrip></descripGrp><ntig><termGrp><term id="2899587">recurring billing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2900484">периодична наплата</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5151_228751_1503354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A real-time communication session between two or more users, which can involve IM, video, or audio.</descrip></descripGrp><ntig><termGrp><term id="228751">conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503354">конверзација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5151_228751_2208775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A real-time communication session between two or more users, which can involve IM, video, or audio.</descrip></descripGrp><ntig><termGrp><term id="228751">conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2208775">разговор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51510_2899588_2899685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of all-in-one dedicated Teams devices featuring an ambient touchscreen and a hands-free experience powered by Cortana that brings together the user's favorite Teams features: chat, meetings, calls, calendar, and files into a single device, promoting human connection in the remote workplace.</descrip></descripGrp><ntig><termGrp><term id="2899588">Teams display</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2899685">Teams екран</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51543_2900640_2900679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in Microsoft Teams that provides the user with analytics about teams that they are a member or owner of, including data about user and guest volume as well as messaging activity.</descrip></descripGrp><ntig><termGrp><term id="2900640">Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2900679">Увиди</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51557_2901206_2901384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The licensing model in which Power BI Premium features are licensed on a per user basis.</descrip></descripGrp><ntig><termGrp><term id="2901206">Premium per user</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2901384">Power BI Premium по кориснику</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51557_2901206_2901385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The licensing model in which Power BI Premium features are licensed on a per user basis.</descrip></descripGrp><ntig><termGrp><term id="2901206">Premium per user</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2901385">Premium по кориснику</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51557_2901207_2901384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The licensing model in which Power BI Premium features are licensed on a per user basis.</descrip></descripGrp><ntig><termGrp><term id="2901207">Power BI Premium per user</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2901384">Power BI Premium по кориснику</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51557_2901207_2901385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The licensing model in which Power BI Premium features are licensed on a per user basis.</descrip></descripGrp><ntig><termGrp><term id="2901207">Power BI Premium per user</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2901385">Premium по кориснику</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51563_2901221_2901249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A third-party device (such as a camera, headset, phone, or room accessory) that has been certified via the Microsoft device Certification Program to provide a compatible experience when used with specific Microsoft software.</descrip></descripGrp><ntig><termGrp><term id="2901221">certified device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2901249">цертификовани уређај</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51574_2901680_2901847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The journey a website visitor follows leading to a purchase.</descrip></descripGrp><ntig><termGrp><term id="2901680">conversion funnel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2901847">ток конверзије</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51578_2901804_2901863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Feature (either built into Windows or available as the Windows Lookup app) to allow users to select a word or group of words and look up more information, definition or translation.</descrip></descripGrp><ntig><termGrp><term id="2901804">Lookup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2901863">Претрага</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51578_2901804_2902090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Feature (either built into Windows or available as the Windows Lookup app) to allow users to select a word or group of words and look up more information, definition or translation.</descrip></descripGrp><ntig><termGrp><term id="2901804">Lookup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2902090">Проналажење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5158_154233_1503355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An industry-standard Internet tunneling protocol that provides encapsulation for sending Point-to-Point Protocol (PPP) frames across packet-oriented media. For IP networks, L2TP traffic is sent as User Datagram Protocol (UDP) messages. In Microsoft operating systems, L2TP is used in conjunction with Internet Protocol security (IPSec) as a virtual private network (VPN) technology to provide remote access or router-to-router VPN connections. L2TP is described in RFC 2661.</descrip></descripGrp><ntig><termGrp><term id="154233">Layer Two Tunneling Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503355">Layer Two Tunneling Protocol</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5158_154233_1503356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An industry-standard Internet tunneling protocol that provides encapsulation for sending Point-to-Point Protocol (PPP) frames across packet-oriented media. For IP networks, L2TP traffic is sent as User Datagram Protocol (UDP) messages. In Microsoft operating systems, L2TP is used in conjunction with Internet Protocol security (IPSec) as a virtual private network (VPN) technology to provide remote access or router-to-router VPN connections. L2TP is described in RFC 2661.</descrip></descripGrp><ntig><termGrp><term id="154233">Layer Two Tunneling Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503356">L2TP</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5158_318115_1503355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An industry-standard Internet tunneling protocol that provides encapsulation for sending Point-to-Point Protocol (PPP) frames across packet-oriented media. For IP networks, L2TP traffic is sent as User Datagram Protocol (UDP) messages. In Microsoft operating systems, L2TP is used in conjunction with Internet Protocol security (IPSec) as a virtual private network (VPN) technology to provide remote access or router-to-router VPN connections. L2TP is described in RFC 2661.</descrip></descripGrp><ntig><termGrp><term id="318115">L2TP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503355">Layer Two Tunneling Protocol</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5158_318115_1503356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An industry-standard Internet tunneling protocol that provides encapsulation for sending Point-to-Point Protocol (PPP) frames across packet-oriented media. For IP networks, L2TP traffic is sent as User Datagram Protocol (UDP) messages. In Microsoft operating systems, L2TP is used in conjunction with Internet Protocol security (IPSec) as a virtual private network (VPN) technology to provide remote access or router-to-router VPN connections. L2TP is described in RFC 2661.</descrip></descripGrp><ntig><termGrp><term id="318115">L2TP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503356">L2TP</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51586_2902141_2902284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style in Word that shows text with a dotted underline.</descrip></descripGrp><ntig><termGrp><term id="2902141">Smart Hyperlink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2902284">паметни хиперлинк</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51587_2902142_2902285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style in Word that shows text as blue with a blue underline.</descrip></descripGrp><ntig><termGrp><term id="2902142">SmartLink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2902285">SmartLink</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51589_2902145_2902280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conceptual container that allows a company administrator to restrict the users and groups that an admin can manage to only those in a specific department, region, or any segment that their organization defines.</descrip></descripGrp><ntig><termGrp><term id="2902145">administrative unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2902280">административна јединица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51589_2910377_2902280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conceptual container that allows a company administrator to restrict the users and groups that an admin can manage to only those in a specific department, region, or any segment that their organization defines.</descrip></descripGrp><ntig><termGrp><term id="2910377">AU</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2902280">административна јединица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51593_2902151_2902283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An isolated group within an organizational structure that has little to no interaction with other groups, often leading to a lack of collaboration and other negative outcomes.</descrip></descripGrp><ntig><termGrp><term id="2902151">silo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2902283">силос</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51606_2902290_2902634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone feature that allows the user to view, send, receive, and download SMS and MMS text messages.</descrip></descripGrp><ntig><termGrp><term id="2902290">Messages</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2902634">Поруке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51608_2902292_2902633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone feature that allows the user to make and receive calls.</descrip></descripGrp><ntig><termGrp><term id="2902292">Calls</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2902633">Позиви</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51609_2902293_2902635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone feature that allows the user to control notification settings.</descrip></descripGrp><ntig><termGrp><term id="2902293">Notifications</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2902635">Обавјештења</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51609_2902293_2902636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone feature that allows the user to control notification settings.</descrip></descripGrp><ntig><termGrp><term id="2902293">Notifications</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2902636">Обавештења</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51610_2902294_2902632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to access the apps installed on their phone or other mobile device.</descrip></descripGrp><ntig><termGrp><term id="2902294">Apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2902632">Апликације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51612_2902297_2906365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The vertical distance of a point or an object above or below a reference surface or datum. Generally, the reference surface is mean sea level.</descrip></descripGrp><ntig><termGrp><term id="2902297">elevation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2906365">надморска висина</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51615_2902485_2918552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color variation of Xbox Wireless Controllers; universally understood black color pigment, bold and reflecting little light.</descrip></descripGrp><ntig><termGrp><term id="2902485">Carbon Black</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918552">Carbon Black</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51616_2902486_2919579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color variation for Xbox Wireless Controllers; universally understood blue color pigment of a medium tone, and not as warm as cobalt blue.</descrip></descripGrp><ntig><termGrp><term id="2902486">Shock Blue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919579">Shock Blue</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51617_2902488_2919535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color variation for Xbox Wireless Controllers; universally understood white color pigment tying back to electronic robots, vibrant and with no off-tones.</descrip></descripGrp><ntig><termGrp><term id="2902488">Robot White</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2919535">Robot White</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5162_25316_1503357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that provides goods and/or services to others.</descrip></descripGrp><ntig><termGrp><term id="25316">business</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503357">пословно</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51640_2949264_3059854"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The on-premises implementation of the popular Azure 