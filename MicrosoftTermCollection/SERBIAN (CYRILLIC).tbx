rip type="definition">The mode that allows you to retrieve data and create reports from a tabular model by retrieving data and aggregates directly from a relational database system.</descrip></descripGrp><ntig><termGrp><term id="2646022">DirectQuery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2658920">DirectQuery</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46966_2646554_2649669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that returns TRUE if the value argument is a reference to an empty cell, otherwise it returns FALSE.</descrip></descripGrp><ntig><termGrp><term id="2646554">ISBLANK</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2649669">ISBLANK</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46968_2646636_2649673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that returns TRUE if the value argument is text, otherwise it returns FALSE.</descrip></descripGrp><ntig><termGrp><term id="2646636">ISTEXT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2649673">ISTEXT</term><termNote type="geographicalUsage">SRB,