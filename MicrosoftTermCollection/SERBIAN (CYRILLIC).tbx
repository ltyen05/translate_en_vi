ice.</descrip></descripGrp><ntig><termGrp><term id="2264866">App connector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2265250">Конектор апликација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38980_2267302_2270413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of REST APIs that allows app developers unified access to entities and relationships from Microsoft and Office 365 services.</descrip></descripGrp><ntig><termGrp><term id="2267302">Microsoft Graph</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2270413">Microsoft Graph</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38981_2267303_2270412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that figures out which part of an image is important, and then determines how to best fit the image within its current context and Design.</descrip></descripGrp><ntig><termGrp><term id="2267303">Focus Points</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2270412">Значајне тачке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNot