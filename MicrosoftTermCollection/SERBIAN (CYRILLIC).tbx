smoothing the jagged appearance of curved or diagonal lines caused by poor resolution on a display screen by adjusting the brightness or color of surrounding pixels.</descrip></descripGrp><ntig><termGrp><term id="1508824">anti aliasing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1725954">AA</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2874_1508824_1917226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software technique for smoothing the jagged appearance of curved or diagonal lines caused by poor resolution on a display screen by adjusting the brightness or color of surrounding pixels.</descrip></descripGrp><ntig><termGrp><term id="1508824">anti aliasing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917226">заглађивање назубљености</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2874_1508824_2527329"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software technique for smoothing the jagged appearance of curved or diagonal lines caused by poor resolution on a display screen by adjusting the brightness or color of surrounding pixels.</descrip></descripGrp><ntig><termGrp><term id="1508824">anti aliasing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527329">ублажавање назубљености</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28771_1495952_2013211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A required update for Microsoft Online Services that enables your computer’s sign-in functionality for multiple user IDs.</descrip></descripGrp><ntig><termGrp><term id="1495952">Microsoft Online Services Sign-In Assistant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2013211">Помоћник за пријаву на Microsoft Online Services</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28773_1496239_1778120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The stage during the email migration when the migration service is actively provisioning new cloud-based mailboxes.</descrip></descripGrp><ntig><termGrp><term id="1496239">active mailbox migration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1778120">активна миграција поштанског сандучета</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28774_1496240_1778136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An auditing record that records any action, based on a Windows PowerShell cmdlet, performed by an administrator. This can help the administrator troubleshoot configuration issues or identify the cause of security- or compliance-related problems.</descrip></descripGrp><ntig><termGrp><term id="1496240">administrator audit log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1778136">евиденција надзора администратора</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28775_1496241_1523654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Web-based team collaboration environment that provides the ability to create and access virtual workspaces for managing documents, discussions, lists, surveys and other important contextual information, such as team member status and presence.</descrip></descripGrp><ntig><termGrp><term id="1496241">Microsoft SharePoint Foundation 2010</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523654">Microsoft SharePoint Foundation 2010</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28777_1496243_1778299"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email migration process that provisions new cloud-based mailboxes and then migrates mailbox data to the cloud.</descrip></descripGrp><ntig><termGrp><term id="1496243">cutover migration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1778299">потпуна миграција</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28778_1496244_1778360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of message journaling in which the original unaltered message is included as an attachment in the journal report.</descrip></descripGrp><ntig><termGrp><term id="1496244">envelope journaling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1778360">евидентирање кошуљица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28779_1496245_1778384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template applied to the distribution group names in your Microsoft Exchange organization. Specifically, you can specify that a prefix, a suffix, or both be applied to all distribution group names. You can also block certain words from being used in the names.</descrip></descripGrp><ntig><termGrp><term id="1496245">group naming policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1778384">смернице за именовање групе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28780_1496246_1778411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In email migration, the stage when the mailboxes in the on-premises Exchange organization and the corresponding cloud-based mailboxes are synchronized every 24 hours, after the initial synchronization. This means that any new messages sent to the mailboxes on the Exchange server are copied to the corresponding cloud-based mailboxes. Incremental synchronization continues until the administrator completes the overall migration.</descrip></descripGrp><ntig><termGrp><term id="1496246">incremental synchronization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1778411">инкрементална синхронизација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28781_1496247_1778418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The message that is generated when a message matches a journal rule. The body of the journal report contains information from the original message such as the sender email address, message subject, message-ID, and recipient email addresses. The journal report also includes the original unaltered message as an attachment.</descrip></descripGrp><ntig><termGrp><term id="1496247">journal report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1778418">извештај дневника</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28782_1496248_1778427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Exchange rule that is used to record the email messages sent to or from specific recipients.</descrip></descripGrp><ntig><termGrp><term id="1496248">journal rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1778427">правило дневника</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28784_1496250_1778556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of email migration that migrates a subset of on-premises mailboxes to the cloud. This type of migration allows the admin to maintain coexistence between their on-premises and cloud-based email organizations.</descrip></descripGrp><ntig><termGrp><term id="1496250">staged migration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1778556">миграција по фазама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28785_1496251_1778316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of saving only one copy of duplicate items in the search results</descrip></descripGrp><ntig><termGrp><term id="1496251">deduplication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1778316">дедупликација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28786_1496252_1778402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique user identifier that must not change for the user over the lifetime of the user being in the system.</descrip></descripGrp><ntig><termGrp><term id="1496252">immutable ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1778402">непроменљиви ID</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28789_1496257_1787292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A part of the Bing search engine dedicated to online shopping.</descrip></descripGrp><ntig><termGrp><term id="1496257">Bing Shopping</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1787292">Bing куповина</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber"