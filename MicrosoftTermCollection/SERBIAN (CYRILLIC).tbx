</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53823_3062774_3065096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transition effect that is placed between two images or video clips in a video editing project to move from one item to the next.</descrip></descripGrp><ntig><termGrp><term id="3062774">Digital glitch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3065096">Дигитална грешка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53824_3062876_3067241"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transition effect that is placed between two images or video clips in a video editing project to move from one item to the next.</descrip></descripGrp><ntig><termGrp><term id="3062876">Liquid swirl</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3067241">Изливени вртлог</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53825_3062878_3067256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The preset motion title in Clipchamp that adds animated text elements in video editing projects.</descrip></descripGrp><ntig><termGrp><term id="3062878">Meme</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3067256">Мим</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53826_3062879_3067254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The preset motion title in Clipchamp that adds animated text elements in video editing projects.</descrip></descripGrp><ntig><termGrp><term id="3062879">Lower Third Split</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3067254">Подела у доњој трећини</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53826_3062879_3067397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The preset motion title in Clipchamp that adds animated text elements in video editing projects.</descrip></descripGrp><ntig><termGrp><term id="3062879">Lower Third Split</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3067397">Подјела у доњој трећини</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53828_3062995_3063044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The national holiday in New Zealand celebrated around the time of the winter solstice in mid-June, that marks the changing of the seasons and the beginning of the Māori New Year.</descrip></descripGrp><ntig><termGrp><term id="3062995">Matariki</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3063044">Матарики</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53829_3062996_3063042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows organizations to set up and run realistic cyberattacks and test their security policies and practices.</descrip></descripGrp><ntig><termGrp><term id="3062996">Attack simulation training</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3063042">Обука за симулацију напада</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53830_3063048_3063391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In contact card, a customer's email address or phone number.</descrip></descripGrp><ntig><termGrp><term id="3063048">contact point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3063391">тачка контакта</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53831_3063049_3063392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A design element that lets you establish a block of common content that you can reuse in multiple emails, forms, and/or pages. It is used to establish common headers, footers and other blocks of content that you would like to standardize across your communications.</descrip></descripGrp><ntig><termGrp><term id="3063049">content block</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3063392">блок садржаја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53832_3063050_3063394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A primary model in Dynamics 365 Marketing, which includes trigger-based customer journeys, custom triggers, and SMS and push notifications. It allows you to trigger customer journeys in real time based on the signals and rich profile data you collect from your customers, pick the right channel for each individual, and connect in the moments that matter.</descrip></descripGrp><ntig><termGrp><term id="3063050">real-time marketing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3063394">маркетинг у реалном времену</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53833_3063051_3063393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A primary model in Dynamics 365 Marketing, which provides email marketing, customer journeys, lead scoring, marketing pages, and social posting, allowing you to seamlessly connect your marketing and sales processes.</descrip></descripGrp><ntig><termGrp><term id="3063051">outbound marketing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3063393">излазни маркетинг</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53834_3063614_3065118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Teams that lets organizers manage questions and answers from attendees during a meeting or webinar.</descrip></descripGrp><ntig><termGrp><term id="3063614">Question and answer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3065118">Q&amp;A</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53834_3063614_3065120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Teams that lets organizers manage questions and answers from attendees during a meeting or webinar.</descrip></descripGrp><ntig><termGrp><term id="3063614">Question and answer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3065120">Питања и одговори</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53834_3063615_3065118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Teams that lets organizers manage questions and answers from attendees during a meeting or webinar.</descrip></descripGrp><ntig><termGrp><term id="3063615">Q&amp;A</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3065118">Q&amp;A</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53834_3063615_3065120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Teams that lets organizers manage questions and answers from attendees during a meeting or webinar.</descrip></descripGrp><ntig><termGrp><term id="3063615">Q&amp;A</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3065120">Питања и одговори</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53835_3063994_3065703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A language that uses hand gestures, facial expressions, and body postures for communication by and with deaf people.</descrip></descripGrp><ntig><termGrp><term id="3063994">sign language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3065703">знаковни језик</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53836_3063995_3065704"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Someone who uses sign language.</descrip></descripGrp><ntig><termGrp><term id="3063995">signer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3065704">корисник знаковног језика</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53837_3064385_3065705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service category that combines expert-trained technology with human-led services to help organizations achieve more secure, compliant, and productive outcomes.</descrip></descripGrp><ntig><termGrp><term id="3064385">Microsoft Security Experts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3065705">Microsoft стручњаци за безбедност</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53837_3064385_3065730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service category that combines expert-trained technology with human-led services to help organizations achieve more secure, compliant, and productive outcomes.</descrip></descripGrp><ntig><termGrp><term id="3064385">Microsoft Security Experts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3065730">Microsoft стручњаци за безбједност</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53841_3065532_3100022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark that appears in the user interface guiding the user through a product experience.</descrip></descripGrp><ntig><termGrp><term id="3065532">coachmark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3100022">инструктивна ознака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53842_3065533_3100023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A status of data that has been successfully imported into SCI, is available to be viewed, and ready for further analytics.</descrip></descripGrp><ntig><termGrp><term id="3065533">data availability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3100023">расположивост података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53843_3065534_3100024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that uses historical and contextual data to recommend what stock to replenish and when in order to match supply and demand while minimizing costs.</descrip></descripGrp><ntig><termGrp><term id="3065534">Intelligent Inventory</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3100024">Интелигентне залихе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53844_3065535_3100025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure of how goods are ordered and how availability is maintained for future customer demand.</descrip></descripGrp><ntig><termGrp><term id="3065535">inventory turnover rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3100025">стопа обрта инвентара</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53845_3065536_3100026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A catalog of powerful modules designed to provide a wide range of supply chain solutions.</descrip></descripGrp><ntig><termGrp><term id="3065536">module library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3100026">библиотека модула</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53846_3065537_3100027"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure of the supplier's ability to deliver goods on time and in full.</descrip></descripGrp><ntig><termGrp><term id="3065537">on time in full</term><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3100027">на време у целости</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53847_3065538_3100030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An imbalance of the amount of supplies with their demand in the market.</descrip></descripGrp><ntig><termGrp><term id="3065538">supply &amp; demand mismatch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3100030">неусклађеност понуде и потражње</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53848_3065539_3100034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure of potential shortfall or surplus in meeting customer demand.</descrip></descripGrp><ntig><termGrp><term id="3065539">supply coverage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3100034">покривеност снабдевања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53851_3065644_3066488"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A survey for customer service agents to check their satisfaction with their work.</descrip></descripGrp><ntig><termGrp><term id="3065644">ASAT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3066488">анкета о задовољству агента</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53851_3065644_3067392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A survey for customer service agents to check their satisfaction with their work.</descrip></descripGrp><ntig><termGrp><term id="3065644">ASAT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3067392">ASAT анкета</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53852_3065645_3066489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agent responsible for a particular case.</descrip></descripGrp><ntig><termGrp><term id="3065645">case manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3066489">менаџер предмета</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53853_3065646_3066490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Passing of a case within Dynamics or from one support system to another (e.g. from Dynamics to RAVE or Service Desk).</descrip></descripGrp><ntig><termGrp><term id="3065646">case transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3066490">пренос предмета</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termN