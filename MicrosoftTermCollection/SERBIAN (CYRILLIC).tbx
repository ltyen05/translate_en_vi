Grp><ntig><termGrp><term id="2042112">Starter Diagram</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2051904">Почетни дијаграм</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35592_2042112_2052774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A partially completed diagram that includes shapes and tips to help the user get started in Visio. A user can select from three diagrams at startup.</descrip></descripGrp><ntig><termGrp><term id="2042112">Starter Diagram</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2052774">Почетни дијаграм</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35606_2042664_2052759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that manages the ability to share various components of the Office 365 site (such as Outlook calendars, SharePoint sites, and Lync meetings) with visitors or external users.</descrip></descripGrp><ntig><termGrp><term id="2042664">External sharing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2052759">Спољно дељење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35607_2042666_2051902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that renders a PDF document as a single or series of pictures in a page.</descrip></descripGrp><ntig><termGrp><term id="2042666">PDF Render</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2051902">PDF рендеровање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35607_2042666_2052769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that renders a PDF document as a single or series of pictures in a page.</descrip></descripGrp><ntig><termGrp><term id="2042666">PDF Render</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2052769">PDF визуелизација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35608_2042671_2051903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables IT administrators to move Personal Folders files (.pst) to a mailbox in Office 365. A .pst file is a data file that stores your messages and other items on your computer.</descrip></descripGrp><ntig><termGrp><term id="2042671">PST import</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2051903">увоз PST фајлова</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35608_2042671_2052771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables IT administrators to move Personal Folders files (.pst) to a mailbox in Office 365. A .pst file is a data file that stores your messages and other items on your computer.</descrip></descripGrp><ntig><termGrp><term id="2042671">PST import</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2052771">PST увоз</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35609_2106333_2107172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription for nonprofit organizations that need communication and collaboration tools and the ability to read and do lightweight editing of documents with the Office Online.</descrip></descripGrp><ntig><termGrp><term id="2106333">Office 365 Nonprofit E1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2107172">Office 365 Nonprofit E1</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35610_2106334_2107173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription for nonprofit organizations ​that is the best plan for nonprofit organizations that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Online.</descrip></descripGrp><ntig><termGrp><term id="2106334">Office 365 Nonprofit E3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2107173">Office 365 Nonprofit E3</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35612_2042970_2141936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to select specific fields for an entity (record type) and specify how they should synchronize between CRM and Exchange, either in both ways or in one direction (from CRM to Exchange or from Exchange to CRM).</descrip></descripGrp><ntig><termGrp><term id="2042970">field-level synchronization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141936">синхронизација на нивоу поља</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35613_2043345_2141976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for the button on the app bar that affixes a tile to your Home screen.</descrip></descripGrp><ntig><termGrp><term id="2043345">Pin to Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141976">Закачи за почетни екран</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35614_2043468_2141955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An out-of-the-box attribute that can be exported, translated into a specified language, and then imported back into CRM.</descrip></descripGrp><ntig><termGrp><term id="2043468">localizable field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141955">поље које је могуће локализовати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35616_2043469_2141988"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Status shown for a task that is assigned in Outlook and tracked in CRM, where the task assignment is declined, and the assigner of the task reassigns the task back to himself or herself.</descrip></descripGrp><ntig><termGrp><term id="2043469">Reclaimed</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141988">Повраћено</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35617_2043470_2141905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In telecommunications, a callback occurs when the originator of a call is immediately called back in a second call as a response.</descrip></descripGrp><ntig><termGrp><term id="2043470">callback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141905">повратни позив</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35620_2043673_2142016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in document management where you can store your documents in SharePoint and access them from Microsoft Dynamics CRM.</descrip></descripGrp><ntig><termGrp><term id="2043673">server-based SharePoint integration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2142016">SharePoint интеграција која се заснива на серверу</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35621_2044156_2141983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A configuration file that defines how web browsers and other user agents can automatically choose the appropriate proxy server (access method) for fetching a given URL.</descrip></descripGrp><ntig><termGrp><term id="2044156">proxy auto-config file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141983">датотека за аутоматску конфигурацију proxy сервера</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35622_2044157_2142017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To perform synchronization between records in CRM and in email systems on the CRM server side (in the cloud, without dependency on the client being up and connected.</descrip></descripGrp><ntig><termGrp><term id="2044157">server-side synchronization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2142017">синхронизација на страни сервера</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35623_2044158_2141995"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A non-production, test instance that provides an isolated environment of Dynamics CRM to allow for testing of custom code, such as plug-ins.</descrip></descripGrp><ntig><termGrp><term id="2044158">sandbox instance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141995">инстанца sandbox окружења</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35628_2045176_2141993"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that displays a value based on a calculation of the values of itself and its child fields.</descrip></descripGrp><ntig><termGrp><term id="2045176">rollup field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141993">поље збирне вредности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35630_2045177_2141957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of software and services for provisioning and controlling access to internally developed and commercially available mobile apps used in business settings on mobile devices.</descrip></descripGrp><ntig><termGrp><term id="2045177">mobile application management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141957">MAM</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35630_2045177_2141963"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of software and services for provisioning and controlling access to internally developed and commercially available mobile apps used in business settings on mobile devices.</descrip></descripGrp><ntig><termGrp><term id="2045177">mobile application management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141963">управљање апликацијама за мобилне уређаје</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35630_2045178_2141957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of software and services for provisioning and controlling access to internally developed and commercially available mobile apps used in business settings on mobile devices.</descrip></descripGrp><ntig><termGrp><term id="2045178">MAM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141957">MAM</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35630_2045178_2141963"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of software and services for provisioning and controlling access to internally developed and commercially available mobile apps used in business settings on mobile devices.</descrip></descripGrp><ntig><termGrp><term id="2045178">MAM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141963">управљање апликацијама за мобилне уређаје</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35632_2045864_2048055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A HIP challenge that requires a user to view an image and then type a set of characters contained in that image.</descrip></descripGrp><ntig><termGrp><term id="2045864">visual challenge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2048055">визуелни задатак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35632_2045864_2050451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A HIP challenge that requires a user to view an image and then type a set of characters contained in that image.</descrip></descripGrp><ntig><termGrp><term id="2045864">visual challenge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2050451">визуелни тест</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35633_2045865_2048047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security task that a user must complete to verify they are a human and not a machine.</descrip></descripGrp><ntig><termGrp><term id="2045865">challenge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2048047">задатак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35633_2045865_2050447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security task that a user must complete to verify they are a human and not a machine.</descrip></descripGrp><ntig><termGrp><term id="2045865">challenge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2050447">тест</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35636_2277612_2281760"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 subscription service for nonprofit organizations (up to 5 PCs, Macs, or mobile devices) that includes Word, PowerPoint, Excel, Outlook, OneNote, Publisher, Access, and Lync.</descrip></descripGrp><ntig><termGrp><term id="2277612">Office 365 ProPlus for Nonprofits</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2281760">Office 365 ProPlus за непрофитне организације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35638_2106336_2107175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription that is the best plan for small and midsized nonprofit organizations that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Online.</descrip></descripGrp><ntig><termGrp><term id="2106336">Office 365 Nonprofit Business Premium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2107175">Office 365 Nonprofit Business Premium</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35639_2106335_2107174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription for small and midsized nonprofit organizations that need anywhere access to email and documents with Office Online.</descrip></descripGrp><ntig><termGrp><term id="2106335">Office 365 Nonprofit Business Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2107174">Office 365 Nonprofit Business Essentials</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumbe