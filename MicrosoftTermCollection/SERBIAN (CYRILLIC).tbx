ular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40069_2329171_2337820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person someone has established a mutual connection with</descrip></descripGrp><ntig><termGrp><term id="2329171">Friend</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2337820">Пријатељ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40070_2329172_2337819"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An electronic prepaid card that enables users to share Skype Credit with their contacts</descrip></descripGrp><ntig><termGrp><term id="2329172">eGift Card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2337819">е-поклон картица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40071_2329173_2337818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To refuse an invitation (such as to a meeting) or a request.</descrip></descripGrp><ntig><termGrp><term id="2329173">decline</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2337818">одбити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><te