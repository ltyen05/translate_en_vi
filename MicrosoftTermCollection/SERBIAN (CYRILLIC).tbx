y</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19339_1722536_2857654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Windows features that provides parents and individuals with the ability to customize key aspects of the online experience in order to protect their children and/or themselves.</descrip></descripGrp><ntig><termGrp><term id="1722536">Microsoft Family Safety</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2857654">Family Safety</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19339_652974_1728721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Windows features that provides parents and individuals with the ability to customize key aspects of the online experience in order to protect their children and/or themselves.</descrip></descripGrp><ntig><termGrp><term id="652974">Family Safety</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1728721">Microsoft Family Safety</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19339_652974_1729577"><lan