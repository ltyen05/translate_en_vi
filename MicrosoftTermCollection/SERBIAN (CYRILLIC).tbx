rm><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916666">програм за компресију</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10945_139125_2541744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software program that reduces a file's size for storage on a disk. If a compressed file is too large to fit onto a single disk, the compression utility copies it onto multiple disks.</descrip></descripGrp><ntig><termGrp><term id="139125">compression utility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541744">услужни програм за компримовање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10947_320488_1503941"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Erroneous or unrecognizable because of a flaw in reasoning or an error in input. Invalid results, for example, might occur if the logic in a program is faulty.</descrip></descripGrp><ntig><termGrp><term id="320488">not valid</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503941">неважеће</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelec