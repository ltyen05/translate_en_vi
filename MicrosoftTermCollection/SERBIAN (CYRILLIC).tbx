p><descrip type="definition">A DLL that manages pools of database connections for COM+ components that use the standard open database connectivity (ODBC) programming interfaces.</descrip></descripGrp><ntig><termGrp><term id="253811">ODBC resource dispenser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1725925">систем за припрему ODBC ресурса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9718_17587_1996637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Internet Explorer that remembers the information you have typed into the Address bar, web forms, or password fields, and which automatically fills in that information if you start to type the same thing again later.</descrip></descripGrp><ntig><termGrp><term id="17587">AutoComplete</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1996637">Аутоматско довршавање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9726_210054_2208788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of reports or other data that is arranged in a panel format on a single page, or series of pages, in a web browser or SharePoint site.</descrip></descripGrp><ntig><termGrp><term id="210054">dashboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2208788">контролна табла</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9726_210054_2696911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of reports or other data that is arranged in a panel format on a single page, or series of pages, in a web browser or SharePoint site.</descrip></descripGrp><ntig><termGrp><term id="210054">dashboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2696911">контролна табла</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9733_1981778_2622540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-released version of a product that is sent to customers and partners for evaluation and feedback.</descrip></descripGrp><ntig><termGrp><term id="1981778">technical preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2622540">технички преглед</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9733_694772_2622540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-released version of a product that is sent to customers and partners for evaluation and feedback.</descrip></descripGrp><ntig><termGrp><term id="694772">beta product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2622540">технички преглед</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9753_141881_1916692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text or graphics inserted in a document when Microsoft Word carries out a field's instructions. When you print the document or hide field codes, the field results replace the field codes.</descrip></descripGrp><ntig><termGrp><term id="141881">field results</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916692">резултати поља</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9756_371966_2527762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document presented to an individual or team in formal recognition of their effort or achievement.</descrip></descripGrp><ntig><termGrp><term id="371966">award certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527762">цертификат</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9767_319131_1503825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to text that is aligned along the left margin.</descrip></descripGrp><ntig><termGrp><term id="319131">left-aligned</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503825">лијево поравнато</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9768_652644_1523795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique name that identifies a user account to operating system. An account's user name must be unique among the other group names and user names within its own domain or workgroup.</descrip></descripGrp><ntig><termGrp><term id="652644">Windows user name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523795">корисничко име за Windows</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9775_142952_1916698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A drop-down list box control on a data access page that retrieves records from an underlying recordset based on the value you select from the list. On a grouped page, the control retrieves a specific group of records.</descrip></descripGrp><ntig><termGrp><term id="142952">group filter control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916698">контрола групног филтера</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9800_30472_1503827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In text-based computer graphics, a block of memory addresses that correspond to character spaces on a display screen. The memory allocated to each character space is used to hold the description of the character to be displayed in that space.</descrip></descripGrp><ntig><termGrp><term id="30472">character map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503827">мапа знакова</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9805_262641_1503828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A title animation in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="262641">Subtitle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503828">Поднаслов</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9818_178782_2541901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account status indicating that payments are late or not yet received.</descrip></descripGrp><ntig><termGrp><term id="178782">overdue</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541901">касни</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9820_2727454_1503830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory or folder made available to users over the network.</descrip></descripGrp><ntig><termGrp><term id="2727454">file share</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503830">заједничко</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9820_298002_1503830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory or folder made available to users over the network.</descrip></descripGrp><ntig><termGrp><term id="298002">share</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503830">заједничко</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9828_558613_2700396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who takes part in an online interaction such as conference call or meeting.</descrip></descripGrp><ntig><termGrp><term id="558613">participant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2700396">учесник</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9831_235026_1669461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of confirming that data passing into the system is correct and complies with predefined rules, definitions, or parameters.</descrip></descripGrp><ntig><termGrp><term id="235026">validation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1669461">провјера ваљаности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9839_503120_2370947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standardized service agreement between a user and a mobile operator that establishes data service details such as pricing, types of services, and bandwidth.</descrip></descripGrp><ntig><termGrp><term id="503120">data plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2370947">тарифни план</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9843_54256_2910486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of computer files on networks, wherein files are stored on a central computer or a server and are requested, reviewed, and modified by more than one individual. When a file is used with different programs or different computers, file sharing can require conversion to a mutually acceptable format. When a single file is shared by many people, access can be regulated through such means as password protection, security clearances, or file locking to prohibit changes to a file by more than one person at a time.</descrip></descripGrp><ntig><termGrp><term id="54256">file sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2910486">дијељење фајлова</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9843_54256_2911510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of computer files on networks, wherein files are stored on a central computer or a server and are requested, reviewed, and modified by more than one individual. When a file is used with different programs or different computers, file sharing can require conversion to a mutually acceptable format. When a single file is shared by many people, access can be regulated through such means as password protection, security clearances, or file locking to prohibit changes to a file by more than one person at a time.</descrip></descripGrp><ntig><termGrp><term id="54256">file sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2911510">дељење датотека</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9846_23701_2541438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A temporary suspension of program execution while in the development environment. In break mode, you can examine, debug, reset, step through, or continue program execution.</descrip></descripGrp><ntig><termGrp><term id="23701">break mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541438">режим привременог обустављања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9847_178880_2541909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The form used to store business information (e.g. open activities, activity history, linked records).</descrip></descripGrp><ntig><termGrp><term id="178880">record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541909">запис</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9849_20127_1503833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the printing and display of characters on the screen, an imaginary horizontal line with which the base of each character, excluding descenders, is aligned.</descrip></descripGrp><ntig><termGrp><term id="20127">base line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503833">основна линија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9849_20128_1503833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the printing and display of characters on the screen, an imaginary horizontal line with which the base of each character, excluding descenders, is aligned.</descrip></descripGrp><ntig><termGrp><term id="20128">baseline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503833">основна линија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="985_226537_1523556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection, storing, and sharing of information in a single system where many users can access it.</descrip></descripGrp><ntig><termGrp><term id="226537">content management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523556">управљање садржајем</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9856_307429_406520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of time that can elapse before the Exchange server asks a mobile device running Exchange ActiveSync to connect again.</descrip></descripGrp><ntig><termGrp><term id="307429">heartbeat interval</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406520">интервал сигнала за повезивање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9857_182634_2141958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subset of customer relationship management (CRM) that focuses on the definition, scheduling, segmentation and tracking of marketing campaigns.</descrip></descripGrp><ntig><termGrp><term id="182634">marketing automation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141958">тржишна аутоматизација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9865_145487_1503834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component database architecture that provides efficient network and Internet access to many types of data sources, including relational data, mail files, flat files, and spreadsheets. OLE DB comprises a specialized set of COM interfaces that expose data from a variety of data stores, both relational and nonrelational.</descrip></descripGrp><ntig><termGrp><term id="145487">OLE DB</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503834">OLE DB</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9865_145487_2442033"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component database architecture that provides efficient network and Internet access to many types of data sources, including relational data, mail files, flat files, and spreadsheets. OLE DB comprises a specialized set of COM interfaces that expose data from a variety of data stores, both relational and nonrelational.</descrip></descripGrp><ntig><termGrp><term id="145487">OLE DB</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2442033">OLEDB</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammatical