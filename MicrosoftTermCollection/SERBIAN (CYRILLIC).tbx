ote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33711_1814024_2076270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A path enabling one inbound or outbound call and is a means of having concurrent calls on PBX.</descrip></descripGrp><ntig><termGrp><term id="1814024">channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2076270">позивни канал</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33711_1814024_2076271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A path enabling one inbound or outbound call and is a means of having concurrent calls on PBX.</descrip></descripGrp><ntig><termGrp><term id="1814024">channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2076271">канал</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33712_1814027_2076320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables making and receiving Skype calls via a PBX system.</descrip></descripGrp><ntig><termGrp><term id="1814027">Skype Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</te