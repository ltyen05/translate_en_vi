><termEntry id="36977_2114176_2177592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app category that facilitates travel planning or navigation.</descrip></descripGrp><ntig><termGrp><term id="2114176">Travel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2177592">Путовања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3699_9325_1503161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifier that identifies a network node to other nodes on the network.</descrip></descripGrp><ntig><termGrp><term id="9325">address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503161">адреса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36992_2105990_2332304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft personal assistant.</descrip></descripGrp><ntig><termGrp><term id="2105990">Cortana</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2332304">Cortana</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37009_2106163_2172523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mapping of an attribute in one directory to an attribute in another directory so that values of the attribute in the first directory can flow to values of the attribute in the other.</descrip></descripGrp><ntig><termGrp><term id="2106163">Attribute flows</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2172523">Токови особина</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37010_2106169_2172567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An expression in some scripting language describing how a value is to be transformed in flowing from an attribute of an entry in one directory to an attribute of an entry in another.</descrip></descripGrp><ntig><termGrp><term id="2106169">Custom expression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2172567">Прилагођени израз</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37011_2106171_2172598"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A property of which the value for an entry in one directory can be expected to match the value of a given property of the corresponding entry in another directory.</descrip></descripGrp><ntig><termGrp><term id="2106171">Joining property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2172598">Својство за придруживање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37012_2106172_2172599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user experience by which a user is presumably able to easily configure an object of interest.</descrip></descripGrp><ntig><termGrp><term id="2106172">Quick Start</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2172599">Брзи старт</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37012_2618247_2172599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user experience by which a user is presumably able to easily configure an object of interest.</descrip></descripGrp><ntig><termGrp><term id="2618247">Quickstart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2172599">Брзи старт</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37013_2106173_2172617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Provisioning of users from a human resource management system into a directory</descrip></descripGrp><ntig><termGrp><term id="2106173">User Import</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2172617">Увоз корисника</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37014_2106175_2172621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The assignment of access privileges and system resources to users, frequently automated to reduce ongoing support costs and force compliance with security policies.</descrip></descripGrp><ntig><termGrp><term id="2106175">User Provisioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2172621">Додељивање привилегија кориснику</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37015_2106176_2172529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to automatically create user identities as well as maintain and remove user identities as status or roles change.</descrip></descripGrp><ntig><termGrp><term id="2106176">Automatic Provisioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2172529">Аутоматско додељивање привилегија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37016_2106177_2172616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of testing connectivity with a directory or application</descrip></descripGrp><ntig><termGrp><term id="2106177">Test connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2172616">Тестирање везе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37017_2844863_2107157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft 365 Apps for business (formerly Office 365 Business) is a small business-level subscription offering that includes Office applications (e.g., Outlook, Word, Excel, PowerPoint, Access (PC only), Publisher (PC only) and cloud file storage and sharing (OneDrive).</descrip></descripGrp><ntig><termGrp><term id="2844863">Microsoft 365 Apps for business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2107157">Office 365 Business</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37017_2844863_2846779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft 365 Apps for business (formerly Office 365 Business) is a small business-level subscription offering that includes Office applications (e.g., Outlook, Word, Excel, PowerPoint, Access (PC only), Publisher (PC only) and cloud file storage and sharing (OneDrive).</descrip></descripGrp><ntig><termGrp><term id="2844863">Microsoft 365 Apps for business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2846779">Microsoft 365 апликације за посао</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37017_2844863_2867856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft 365 Apps for business (formerly Office 365 Business) is a small business-level subscription offering that includes Office applications (e.g., Outlook, Word, Excel, PowerPoint, Access (PC only), Publisher (PC only) and cloud file storage and sharing (OneDrive).</descrip></descripGrp><ntig><termGrp><term id="2844863">Microsoft 365 Apps for business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2867856">Microsoft 365 апликације за посао</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3702_86681_1503163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of translating images of printed text into machine-encoded text.</descrip></descripGrp><ntig><termGrp><term id="86681">OCR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503163">оптичко препознавање знакова</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3702_86681_2541520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of translating images of printed text into machine-encoded text.</descrip></descripGrp><ntig><termGrp><term id="86681">OCR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541520">OCR</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3702_86682_1503163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of translating images of printed text into machine-encoded text.</descrip></descripGrp><ntig><termGrp><term id="86682">optical character recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503163">оптичко препознавање знакова</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3702_86682_2541520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of translating images of printed text into machine-encoded text.</descrip></descripGrp><ntig><termGrp><term id="86682">optical character recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541520">OCR</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37030_2106365_2107166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription for government organizations that need communication and collaboration tools and the ability to read and do lightweight editing of documents with the Office Online that is hosted in the commercial cloud environment.</descrip></descripGrp><ntig><termGrp><term id="2106365">Office 365 Enterprise E1 (Government Pricing)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2107166">Office 365 Enterprise E1 (цена за државне институције)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37031_2106366_2107167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription that is the best plan for government organizations that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Online, and that is hosted in the commercial cloud environment.</descrip></descripGrp><ntig><termGrp><term id="2106366">Office 365 Enterprise E3 (Government Pricing)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2107167">Office 365 Enterprise E3 (цена за државне институције)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37032_2106367_2107168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription, hosted in the commercial cloud environment, for government organizations that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Online and on-premises server rights to information protection and enterprise voice capabilities.</descrip></descripGrp><ntig><termGrp><term id="2106367">Office 365 Enterprise E4 (Government Pricing)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2107168">Office 365 Enterprise E4 (цена за државне институције)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37033_2816013_2107169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription, hosted in the Government Community Cloud environment, for government organizations that need communication and collaboration tools and the ability to read and do lightweight editing of documents with the Office Online. It includes all the features of Exchange Online Government Plan 1 plus cloud file storage and sharing, online meetings and instant messaging, HD videoconferencing, intranet and team sites, and other services.</descrip></descripGrp><ntig><termGrp><term id="2816013">Office 365 Government G1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2107169">Office 365 Government E1</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37033_2816013_2817881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription, hosted in the Government Community Cloud environment, for government organizations that need communication and collaboration tools and the ability to read and do lightweight editing of documents with the Office Online. It includes all the features of Exchange Online Government Plan 1 plus cloud file storage and sharing, online meetings and instant messaging, HD videoconferencing, intranet and team sites, and other services.</descrip></descripGrp><ntig><termGrp><term id="2816013">Office 365 Government G1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2817881">Office 365 Government G1</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37034_2816014_2107170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription, hosted in the Government Community Cloud environment, that is the best plan for government organizations that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Online. It includes all the features of Office 365 Government Community G1 plus Office desktop applications, personalized search and discovery, self-service business intelligence, enterprise management of apps, eDiscovery tools, hosted voicemail with auto-attendant capabilities, and other services.</descrip></descripGrp><ntig><termGrp><term id="2816014">Office 365 Government G3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2107170">Office 365 Government E3</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37034_2816014_2817884"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription, hosted in the Government Community Cloud environment, that is the best plan for government organizations that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Online. It includes all the features of Office 365 Government Community G1 plus Office desktop applications, personalized search and discovery, self-service business intelligence, enterprise management of apps, eDiscovery tools, hosted voicemail with auto-attendant capabilities, and other services.</descrip></descripGrp><ntig><termGrp><term id="2816014">Office 365 Government G3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</ter