ion">A type of XML mapping that links WordprocessingML content directly to the backing data in the custom XML part.</descrip></descripGrp><ntig><termGrp><term id="1632111">rich text XML mapping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1675786">XML мапирање обогаћеног текста</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32061_1632111_1917312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of XML mapping that links WordprocessingML content directly to the backing data in the custom XML part.</descrip></descripGrp><ntig><termGrp><term id="1632111">rich text XML mapping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917312">XML мапирање у обогаћеном тексту</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32062_1632112_1644663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A price that reflects a representative value in other currencies. The specific price of a price tier that is shown in one currency will be close to the corresponding price in another currency. Foreign exchange, differences in taxation policies, and other market factors influence the determination of a price tier’s price that is shown in another currency.</descrip></descripGrp><ntig><termGrp><term id="1632112">price tier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1644663">цјеновни ниво</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32062_1632112_1645326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A price that reflects a representative value in other currencies. The specific price of a price tier that is shown in one currency will be close to the corresponding price in another currency. Foreign exchange, differences in taxation policies, and other market factors influence the determination of a price tier’s price that is shown in another currency.</descrip></descripGrp><ntig><termGrp><term id="1632112">price tier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1645326">ценовни ниво</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32068_1634055_1675778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of system resources that are allowed to be used by a block of code. Usage that exceeds this amount results in an error.</descrip></descripGrp><ntig><termGrp><term id="1634055">resource budget</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1675778">буџет за ресурсе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="part