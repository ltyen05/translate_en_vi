7"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product or service that a company buys from a vendor and/or sells to a customer.</descrip></descripGrp><ntig><termGrp><term id="180190">item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541937">ставка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1205_397999_1767255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contract that restricts disclosure of confidential information or proprietary knowledge.</descrip></descripGrp><ntig><termGrp><term id="397999">NDA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1767255">NDA</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1205_397999_2688835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contract that restricts disclosure of confidential information or proprietary knowledge.</descrip></descripGrp><ntig><termGrp><term id="397999">NDA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2688835">уговор о неоткривању</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1205_85315_1767255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contract that restricts disclosure of confidential information or proprietary knowledge.</descrip></descripGrp><ntig><termGrp><term id="85315">non-disclosure agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1767255">NDA</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1205_85315_2688835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contract that restricts disclosure of confidential information or proprietary knowledge.</descrip></descripGrp><ntig><termGrp><term id="85315">non-disclosure agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2688835">уговор о неоткривању</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12055_235062_1504076"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wizard that helps the user to adjust their speakers for the best sound by running automatic calibration tests for levels, delay, and frequency response.</descrip></descripGrp><ntig><termGrp><term id="235062">Speaker Calibration wizard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504076">Стручњак за подешавање звучника</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12063_38186_2918615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In hardware, a coupler used to join cables or to join a cable to a device (for example, an RS-232-C connector used to join a modem cable to a computer). Most connector types are available in one of two genders--male or female. A male connector is characterized by one or more exposed pins; a female connector is characterized by one or more receptacles--sockets or jacks-- designed to accept the pins on the male connector.</descrip></descripGrp><ntig><termGrp><term id="38186">connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2918615">конектор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12068_27187_765558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marketing program designed to accomplish a specific result, such as introducing a new product or increasing market share.</descrip></descripGrp><ntig><termGrp><term id="27187">campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="765558">кампања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12068_27187_765622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marketing program designed to accomplish a specific result, such as introducing a new product or increasing market share.</descrip></descripGrp><ntig><termGrp><term id="27187">campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="765622">маркетиншка кампања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12068_335551_765558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marketing program designed to accomplish a specific result, such as introducing a new product or increasing market share.</descrip></descripGrp><ntig><termGrp><term id="335551">marketing campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="765558">кампања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12068_335551_765622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marketing program designed to accomplish a specific result, such as introducing a new product or increasing market share.</descrip></descripGrp><ntig><termGrp><term id="335551">marketing campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="765622">маркетиншка кампања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12069_150202_1504077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pairing of two or more actions that are performed together as a single action; the action succeeds or fails as a whole.</descrip></descripGrp><ntig><termGrp><term id="150202">transaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504077">трансакција</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12083_85887_2541517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity, such as a file, folder, shared folder, printer, or Active Directory object, described by a distinct, named set of attributes. For example, the attributes of a File object include its name, location, and size; the attributes of an Active Directory User object might include the user's first name, last name, and email address.</descrip></descripGrp><ntig><termGrp><term id="85887">object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541517">објекат</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12086_147324_2527579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A DDE channel used in a conversation between the destination application and a specific query (for example, Query1) in Query. To use a query channel, you must have already opened the query window using a system channel.</descrip></descripGrp><ntig><termGrp><term id="147324">query channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527579">канал упита</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12088_395290_2542095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that requires the user to supply information or close the dialog box before allowing the application to continue.</descrip></descripGrp><ntig><termGrp><term id="395290">modal dialog box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542095">модални дијалог</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12094_1049764_2701406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of servers that are in one location and that are networked together for the purpose of sharing workload.</descrip></descripGrp>