Set xml:lang="sr-Cyrl"><ntig><termGrp><term id="1761114">веб proxy</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33101_1757920_1761056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A JavaScript library available in apps for SharePoint to allow cross-domain client-level communication.</descrip></descripGrp><ntig><termGrp><term id="1757920">cross-domain library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1761056">међудоменска библиотека</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33102_1757921_1761054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An HTML and JavaScript based control that renders the top chrome, which is available to use in apps for SharePoint.</descrip></descripGrp><ntig><termGrp><term id="1757921">chrome control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1761054">контрола хрома</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33103_1758412_1774771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 3D geospatial and temporal visualization tool that enables users to map, explore, and interact with information across multiple dimensions, allowing them to draw new insights from large data sets.</descrip></descripGrp><ntig><termGrp><term id="1758412">GeoFlow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1774771">GeoFlow</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33105_1758865_1760829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Japanese kana characters that indicate the correct pronunciation, sorting, and grouping behavior of a word written in kanji.</descrip></descripGrp><ntig><termGrp><term id="1758865">Yomi</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1760829">yomi</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33106_1759158_1760827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides a progressive disclosure method that remains active only as long as the user holds (presses down) their finger on the touch surface.</descrip></descripGrp><ntig><termGrp><term id="1759158">Tap and Hold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1760827">Куцни и држи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33106_1759158_1760970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides a progressive disclosure method that remains active only as long as the user holds (presses down) their finger on the touch surface.</descrip></descripGrp><ntig><termGrp><term id="1759158">Tap and Hold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1760970">Прислони и држи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33109_1759220_1760825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The charm that provides access to the devices commands.</descrip></descripGrp><ntig><termGrp><term id="1759220">Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1760825">Уређаји</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33109_1759220_1760948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The charm that provides access to the devices commands.</descrip></descripGrp><ntig><termGrp><term id="1759220">Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1760948">Уређаји</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33111_1759222_1760828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware button that increases and decreases the sound volume.</descrip></descripGrp><ntig><termGrp><term id="1759222">volume control button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1760828">дугме за контролу јачине звука</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33112_1759223_1767513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label that indicates a screen or monitor that is attached to a PC and that content can be projected on to.</descrip></descripGrp><ntig><termGrp><term id="1759223">Second screen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1767513">Други екран</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33115_1760042_1764551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interface that enables a web application server (for example, Office Web Apps Server) to access and change files that are stored by a host server (such as SharePoint Server).</descrip></descripGrp><ntig><termGrp><term id="1760042">WOPI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1764551">WOPI</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33116_1760045_1761115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web application server, such as Office Web Apps Server, that uses WOPI and WOPI conventions to integrate with a host server, and is designed to view and edit files stored by the host.</descrip></descripGrp><ntig><termGrp><term id="1760045">WOPI application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1761115">WOPI апликација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33117_1760047_1761117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A host server, such as SharePoint Server, that uses WOPI to support file operations and provides a wrapper for the WOPI application UI.</descrip></descripGrp><ntig><termGrp><term id="1760047">WOPI host</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1761117">WOPI хост</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33118_1761200_1781139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that comes with a product key and DVD that allows users them to purchase Windows and activate their current copy of Windows from the client.</descrip></descripGrp><ntig><termGrp><term id="1761200">Get Genuine Windows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1781139">Get Genuine Windows</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3312_298013_1916891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number in the form a + bi, where a and b are real numbers and i = sqrt(-1) , so that bi is imaginary unless b = 0.</descrip></descripGrp><ntig><termGrp><term id="298013">complex number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916891">комплексни број</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3312_298013_2998715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number in the form a + bi, where a and b are real numbers and i = sqrt(-1) , so that bi is imaginary unless b = 0.</descrip></descripGrp><ntig><termGrp><term id="298013">complex number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2998715">комплексни број</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33142_1762245_1774784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint site to which an app is installed.</descrip></descripGrp><ntig><termGrp><term id="1762245">host web</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1774784">веб хоста</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33143_1762246_1774781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subweb site to which the SharePoint components of an app are deployed when the app is installed on a host web.</descrip></descripGrp><ntig><termGrp><term id="1762246">app web</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1774781">веб апликације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termG