 possible, so as to create as much continuous free space as possible.</descrip></descripGrp><ntig><termGrp><term id="36190">compaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541462">сажимање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12650_50986_1730118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference that follows the body text. An endnote consists of two linked parts: the note reference mark and the corresponding note text.</descrip></descripGrp><ntig><termGrp><term id="50986">endnote</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1730118">енднота</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12659_81864_1504137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined command for a single mouse click or a double mouse click, with or without a modifier key, that can be used to perform a task.</descrip></descripGrp><ntig><termGrp><term id="81864">mouse shortcut</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504137">пречица мишем</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGen