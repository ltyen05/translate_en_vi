.</descrip></descripGrp><ntig><termGrp><term id="1508820">MSDL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542345">Microsoft услуга преузимања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29470_1508820_2542346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard bulletin board system. It contains the Microsoft Software Library (MSL), technical articles, device drivers, Help files, and other support files you can download from Microsoft.</descrip></descripGrp><ntig><termGrp><term id="1508820">MSDL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542346">MSDL</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29472_1508822_2542347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style sheet that contains formatting rules, and that is referenced by an XML file to which the rules are applied. The standard set of rules for XML stylesheets is the Extensible Style Language (XSL).</descrip></descripGrp><ntig><termGrp><term id="1508822">XML stylesheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542347">XML опис стила</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29473_1508823_1917225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An administrative tool that examines a computer, server farm, or server cluster and provides statistics that indicate the degree to which the configuration meets expected demands.</descrip></descripGrp><ntig><termGrp><term id="1508823">health analyzer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917225">алат за анализу стања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29473_1508823_2542348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An administrative tool that examines a computer, server farm, or server cluster and provides statistics that indicate the degree to which the configuration meets expected demands.</descrip></descripGrp><ntig><termGrp><term id="1508823">health analyzer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542348">анализатор исправности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29474_1508825_1917227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom handler that calls and runs custom code during the creation process for a site.</descrip></descripGrp><ntig><termGrp><term id="1508825">site provisioning provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917227">управљач додјелом локације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29474_1508825_2542349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom handler that calls and runs custom code during the creation process for a site.</descrip></descripGrp><ntig><termGrp><term id="1508825">site provisioning provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542349">руковалац снабдевањем сајта</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29475_1508827_2542350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The representation of graphic objects such as lines, arcs, and squares by using geometrical formulas. By contrast, bitmapped graphics (also called raster graphics) are stored as a collection of pixels.</descrip></descripGrp><ntig><termGrp><term id="1508827">vector graphics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542350">векторска графика</term><termNote type="geographicalUsage">SRB, BIH<