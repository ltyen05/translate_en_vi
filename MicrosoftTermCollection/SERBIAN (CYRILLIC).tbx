>The app available within Microsoft 365, Microsoft Edge, and other apps that provides live updates related to Microsoft 365 activity such as document editing, email mentions, articles shared in Teams.</descrip></descripGrp><ntig><termGrp><term id="3103216">Microsoft Feed</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3103843">Microsoft Feed</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54660_3103217_3103837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API that provides Super Resolution (SR) support for D3D12 applications.</descrip></descripGrp><ntig><termGrp><term id="3103217">DirectSR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3103837">DirectSR</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54661_3103943_3104280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Teams app for EDU that functions as a learning management system (LMS) by allowing educators to create, organize, and reuse their course content over time and allowing students to find relevant learning resources in Teams.</descrip></descripGrp><ntig><termGrp><term id="3103943">Classwork</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3104280">Школски задаци</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54662_3103944_3104283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated security approach that covers the entire lifecycle of cloud-native applications by combining cloud security posture management (CSPM), cloud workload protection (CWP), cloud infrastructure entitlement management (CIEM), and cloud applications security broker (CASB).</descrip></descripGrp><ntig><termGrp><term id="3103944">Cloud-Native Application Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3104283">Заштита апликација у облаку</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54662_3103944_3104284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated security approach that covers the entire lifecycle of cloud-native applications by combining cloud security posture management (CSPM), cloud workload protection (CWP), cloud infrastructure entitlement management (CIEM), and cloud applications security broker (CASB).</descrip></descripGrp><ntig><termGrp><term id="3103944">Cloud-Native Application Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3104284">CNAPP</term><termNote type="geogr