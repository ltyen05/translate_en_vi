ayed on a device, or is in a computer program that you use to enter information in the context of a phone call.</descrip></descripGrp><ntig><termGrp><term id="1050744">dial pad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2257401">нумеричка тастатура</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22615_1050744_3188246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric keypad that is part of a device, is displayed on a device, or is in a computer program that you use to enter information in the context of a phone call.</descrip></descripGrp><ntig><termGrp><term id="1050744">dial pad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3188246">нумеричка тастатура</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22615_3188175_2257401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric keypad that is part of a device, is displayed on a device, or is in a computer program that you use to enter information in the context of a phone call.</descrip></descripGrp><ntig><termGrp><term id="3188175">dialpad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2257401">нумеричка тастатура</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22615_3188175_3188246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric keypad that is part of a device, is displayed on a device, or is in a computer program that you use to enter information in the context of a phone call.</descrip></descripGrp><ntig><termGrp><term id="3188175">dialpad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3188246">нумеричка тастатура</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22629_1052639_1361770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of creating a hyperlink to a specific page within a Web site or Web-based application instead of to the site’s home page.</descrip></descripGrp><ntig><termGrp><term id="1052639">deep linking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1361770">дубинско повезивање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22629_1052639_2578580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of creating a hyperlink to a specific page within a Web site or Web-based application instead of to the site’s home page.</descrip></descripGrp><ntig><termGrp><term id="1052639">deep linking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2578580">дубинско повезивање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22632_1052846_1917114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A traditional graphics plotter that uses pens to draw on paper. Pen plotters use one or more colored pens, either fiber-tipped pens or, for highest-quality output, drafting pens.</descrip></descripGrp><ntig><termGrp><term id="1052846">pen plotter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917114">плотер с оловком</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22632_1052846_2528017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A traditional graphics plotter that uses pens to draw on paper. Pen plotters use one or more colored pens, either fiber-tipped pens or, for highest-quality output, drafting pens.</descrip></descripGrp><ntig><termGrp><term id="1052846">pen plotter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2528017">плотер са пером</term><termNote type="geographicalUsage">SR