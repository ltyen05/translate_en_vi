termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2522495">положено</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14724_124184_2541573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cross-platform interface for acquiring electronic images that have been captured by scanners, digital cameras, and still-frame video capture boards.</descrip></descripGrp><ntig><termGrp><term id="124184">TWAIN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541573">TWAIN</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14726_110688_1504333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned to a specific inventory item to identify it and differentiate it from similar items with the same item number.</descrip></descripGrp><ntig><termGrp><term id="110688">serial number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504333">серијски број</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14727_168754_1796422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical network connection between two entities such as a user or computer, that has a defined lifetime and associated state, and that might involve multiple physical connections.</descrip></descripGrp><ntig><termGrp><term id="168754">session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1796422">сесија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14733_31389_1504334"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To pick a command or an option from within a graphical user interface, as by clicking a button in a dialog box or pulling down a menu and then releasing the mouse button on one of its options.</descrip></descripGrp><ntig><termGrp><term id="31389">choose</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504334">изабрати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14734_2631390_2677467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The duration of time for which the data should be available.</descrip></descripGrp><ntig><termGrp><term id="2631390">retention period</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2677467">период задржавања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14734_418816_2677467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The duration of time for which the data should be available.</descrip></descripGrp><ntig><termGrp><term id="418816">retention range</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2677467">период задржавања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14738_124210_1916637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measure used in typesetting and desktop publishing, equal to one-twentieth of a printer's point, or 1/1440th of an inch.</descrip></descripGrp><ntig><termGrp><term id="124210">twip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916637">twip</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14738_124210_2541574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measure used in typesetting and desktop publishing, equal to one-twentieth of a printer's point, or 1/1440th of an inch.</descrip></descripGrp><ntig><termGrp><term id="124210">twip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541574">твип</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14742_375721_380313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature available in Outlook 2007 and some mobile devices that automatically configures the clients for access to Exchange Server 2007. The client sends the user name and password information to the Exchange 2007 server. The Autodiscover Web service that is running on the Exchange Client Access server returns an XML file that contains configuration information, which is interpreted by the client. If the user is moved to a different server later, the client will automatically query the Autodiscover Web service again to update the client configuration.</descrip></descripGrp><ntig><termGrp><term id="375721">Autodiscover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="380313">Аутоматско откривање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14749_397189_406600"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process by which Exchange Server creates and updates the OAB. Administrators can define when the OAB generation process will run.</descrip></descripGrp><ntig><termGrp><term id="397189">offline address book generation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406600">генерисање ванмрежног адресара</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14749_397189_406601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process by which Exchange Server creates and updates the OAB. Administrators can define when the OAB generation process will run.</descrip></descripGrp><ntig><termGrp><term id="397189">offline address book generation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406601">генерисање OAB-а</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14749_397190_406600"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process by which Exchange Server creates and updates the OAB. Administrators can define when the OAB generation process will run.</descrip></descripGrp><ntig><termGrp><term id="397190">OAB generation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406600">генерисање ванмрежног адресара</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14749_397190_406601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process by which Exchange Server creates and updates the OAB. Administrators can define when the OAB generation process will run.</descrip></descripGrp><ntig><termGrp><term id="397190">OAB generation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406601">генерисање OAB-а</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14755_375732_380303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An SMTP namespace for which Microsoft an Exchange Server organization sends and receives email.</descrip></descripGrp><ntig><termGrp><term id="375732">accepted domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="380303">прихваћени домен</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14758_410849_609647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The characteristics or properties that define how a property is used and interpreted. The group of properties that forms a property definition is stored in a dictionary.</descrip></descripGrp><ntig><termGrp><term id="410849">property definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="609647">дефиниција својства</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14761_143306_2527534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web page editor command that inserts a horizontal line onto a Web page.</descrip></descripGrp><ntig><termGrp><term id="143306">Horizontal Line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527534">хоризонтална линија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14763_141747_1675406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that enables a user to sample the color of any pixel on a screen and apply that color to an object.</descrip></descripGrp><ntig><termGrp><term id="141747">eyedropper</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1675406">пипета</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14763_141747_1916690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that enables a user to sample the color of any pixel on a screen and apply that color to an object.</descrip></descripGrp><ntig><termGrp><term id="141747">eyedropper</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916690">узорковање боје капаљком</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14766_11020_1504336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To assign or reserve a portion of an element, such as a resource or a session, for a particular use or purpose.</descrip></descripGrp><ntig><termGrp><term id="11020">allocate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504336">додијелити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1477_149955_2541850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API that developers can use for creating applications that run on Windows 95 or later.</descrip></descripGrp><ntig><termGrp><term id="149955">Windows API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541850">Windows API</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14771_24810_2541441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Large-volume mail.</descrip></descripGrp><ntig><termGrp><term id="24810">bulk mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541441">масовна пошта</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14773_375990_1504337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page that contains the design and layout elements that you want to repeat on multiple pages in a publication. Using master pages for these common elements gives your publication a more consistent appearance.</descrip></descripGrp><ntig><termGrp><term id="375990">master page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504337">страницa матрица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14774_397165_406429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which an administrator can manually move a clustered mailbox server between nodes in a cluster. A handoff should only be performed by using the Move-ClusteredMailboxServer cmdlet in the Exchange Management Shell.</descrip></descripGrp><ntig><termGrp><term id="397165">handoff</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singul