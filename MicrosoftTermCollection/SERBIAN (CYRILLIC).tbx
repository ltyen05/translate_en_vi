house</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3113556">језеро података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53433_3177662_3178770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository of data in its original, untransformed state that also provides management tools used to clean, transform, and govern the data.</descrip></descripGrp><ntig><termGrp><term id="3177662">lakehouse</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3178770">језеро података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53435_3044723_3044788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows parents to manage their children's activities on Xbox consoles and enable gaming options that are right for their family, including screen time limitations, content restrictions, and friend requests.</descrip></descripGrp><ntig><termGrp><term id="3044723">Xbox Family Settings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3044788">Xbox Family Settings</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53435_3044723_3044789"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows parents to manage their children's activities on Xbox consoles and enable gaming options that are right for their family, including screen time limitations, content restrictions, and friend requests.</descrip></descripGrp><ntig><termGrp><term id="3044723">Xbox Family Settings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3044789">Xbox Family Settings</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53438_3045020_3045145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app within Teams that allows users to capture images and videos.</descrip></descripGrp><ntig><termGrp><term id="3045020">Camera</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3045145">Камера</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53441_3045240_3046032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The root folder in Windows Explorer that shows recently used items.</descrip></descripGrp><ntig><termGrp><term id="3045240">Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3046032">Почетак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53442_3045241_3046033"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Windows Enterprise E3 that automatically keeps Windows and Office software up to date on enrolled endpoints.</descrip></descripGrp><ntig><termGrp><term id="3045241">Windows Autopatch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3046033">Windows Autopatch</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53444_3045433_3045765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The RPA mode where the automation is executed when users are in front of their computers. This is suitable when they want to automate tasks and processes at an individual level. The automation is often triggered manually whenever the user wants to run it. The process might require human interaction or decisions between steps.</descrip></descripGrp><ntig><termGrp><term id="3045433">attended</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3045765">надгледано</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53445_3045434_3045766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of actions in a flow.</descrip></descripGrp><ntig><termGrp><term id="3045434">block of actions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3045766">блок радњи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53446_3045435_3045767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of enabling users to interact with web applications and components through UI elements. UI elements describe uniquely the web components that the action is going to handle.</descrip></descripGrp><ntig><termGrp><term id="3045435">browser automation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3045767">аутоматизација прегледача</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53447_3045436_3045768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The AI Builder component that allows users to detect business cards and extract their information.</descrip></descripGrp><ntig><termGrp><term id="3045436">Business card reader</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3045768">Читач визиткарти</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53448_3045437_3045769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flow that is being called by the parent flow.</descrip></descripGrp><ntig><termGrp><term id="3045437">child flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3045769">подређени ток</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53449_3045438_3045770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A qualified lead that can become an account, a contact or an opportunity.</descrip></descripGrp><ntig><termGrp><term id="3045438">converted lead</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3045770">конвертовани потенцијални клијент</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53450_3045439_3045771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that improves models by raising confidence scores in AI Builder. Documents can be flagged by users and sent back to the training wizard queue for retraining if they didn't yield sufficient confidence scores when analyzed by AI Builder.</descrip></descripGrp><ntig><termGrp><term id="3045439">feedback loop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3045771">петља повратних информација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53451_3045440_3045772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The prebuilt AI model in AI Builder that extracts key invoice data to help automate the processing of invoices.</descrip></descripGrp><ntig><termGrp><term id="3045440">Invoice processing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3045772">Обрада фактура</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53452_3045441_3045773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Desktop flow execution where automation is happening locally through the console on the user's machine, in an attended mode.</descrip></descripGrp><ntig><termGrp><term id="3045441">local attended</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3045773">локално надгледано</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53453_3045442_3045774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group that allows you to organize multiple machines together to help distribute your automation workload and optimize productivity.</descrip></descripGrp><ntig><termGrp><term id="3045442">machine group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3045774">група рачунара</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53454_3045443_3045775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power Automate app that allows you to connect your machine to the Power Automate cloud. It allows you to harness the full power of your robotic process automation (RPA).</descrip></descripGrp><ntig><termGrp><term id="3045443">machine-runtime app</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3045775">апликација за извршавање рачунара</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53455_3045444_3045776"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The custom AI model in AI Builder that can help expedite or automate business processes.</descrip></descripGrp><ntig><termGrp><term id="3045444">Object detection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3045776">Препознавање објеката</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53456_3045445_3045777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flow that calls another flow.</descrip></descripGrp><ntig><termGrp><term id="3045445">parent flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3045777">надређени ток</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53457_3045446_3045778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power Automate licensing plan that allows you to implement critical business processes with enough capacity to serve teams, departments, or the entire organization for an unlimited number of users.</descrip></descripGrp><ntig><termGrp><term id="3045446">per-flow plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3045778">план по току</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><t