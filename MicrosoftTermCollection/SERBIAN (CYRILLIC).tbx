ol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2846887">укупан број</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50287_2844103_2846583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of report in the Microsoft 365 admin center that shows usage activity in Office 365 services. Activity reports report on various functions or services such as email activity, active users, Office activations, etc.</descrip></descripGrp><ntig><termGrp><term id="2844103">activity report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2846583">извештај о активностима</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50288_2844104_2846594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Microsoft 365 admin center, a square area on the screen that opens an activity report, as an alternative to selecting the report from a drop-down menu.</descrip></descripGrp><ntig><termGrp><term id="2844104">activity widget</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2846594">виџет активности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="g