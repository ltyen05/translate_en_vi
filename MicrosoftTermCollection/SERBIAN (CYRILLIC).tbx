217_2893867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prevent a UI element such as an error, notification, button, or a visual feature such as line numbers or page margins, from appearing to the end user.</descrip></descripGrp><ntig><termGrp><term id="2892217">suppress</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2893867">спречити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51330_2893119_2893260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Implies that the artifact (object or activity) or some of its characteristics deviate from what is considered ‘normal’; typically a statistical outlier.</descrip></descripGrp><ntig><termGrp><term id="2893119">anomalous</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2893260">аномалан</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51331_2893120_2893265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number calculated to let the customer know how vulnerable devices in their organization are.</descrip></descripGrp><ntig><termGrp><term id="2893120">exposure score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2893265">резултат изложености</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51336_2893893_2906374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of tools that helps you create, reuse, and share Adaptive Cards.</descrip></descripGrp><ntig><termGrp><term id="2893893">templating</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2906374">алатке за предлошке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51338_2893964_2894006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft 365 Teams background effect that is limited only to uploading the user's own images.</descrip></descripGrp><ntig><termGrp><term id="2893964">custom background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2894006">прилагођена позадина</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51339_2893965_2894010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox Live matchmaking service that groups players based on user information and the request for any users who want to play together.</descrip></descripGrp><ntig><termG