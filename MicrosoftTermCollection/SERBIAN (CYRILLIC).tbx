S</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52363_2955575_2978840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Date and time Excel function that calculates the number of days between two dates based on a 360-day year.</descrip></descripGrp><ntig><termGrp><term id="2955575">DAYS360</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2978840">DAYS360</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52364_2955576_2978841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Financial Excel function that returns the depreciation of an asset for a specified period by using the fixed-declining balance method.</descrip></descripGrp><ntig><termGrp><term id="2955576">DB</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2978841">DB</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52365_2955577_2978842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Text Excel function that changes half-width (single-byte) English letters or katakana within a character string to full-width (double-byte) characters.</descrip></descripGrp><ntig><termGrp><term id="2955577">DBCS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2978842">DBCS</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52366_2955578_2978843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Database Excel function that counts the cells that contain numbers in a database.</descrip></descripGrp><ntig><termGrp><term id="2955578">DCOUNT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2978843">DCOUNT</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52367_2955579_2978844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Database Excel function that counts nonblank cells in a database.</descrip></descripGrp><ntig><termGrp><term id="2955579">DCOUNTA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2978844">DCOUNTA</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></