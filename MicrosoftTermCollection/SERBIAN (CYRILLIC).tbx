mNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1954408">Click-to-Run</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22364_1146100_1760721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A streaming technology that quickly installs Office over the Internet, internal networks, local file systems, or from offline media.</descrip></descripGrp><ntig><termGrp><term id="1146100">Click-to-Run technology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1760721">Кликни и покрени</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22364_1146100_1760722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A streaming technology that quickly installs Office over the Internet, internal networks, local file systems, or from offline media.</descrip></descripGrp><ntig><termGrp><term id="1146100">Click-to-Run technology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1760722">технологија „Кликни и покрени“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22364_1146100_1954408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A streaming technology that quickly installs Office over the Internet, internal networks, local file systems, or from offline media.</descrip></descripGrp><ntig><termGrp><term id="1146100">Click-to-Run technology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1954408">Click-to-Run</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22373_1043951_2701438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of adding a digital signature to source code and applications published on the Internet. Code signing is intended to provide a level of security and trust to Internet software distribution.</descrip></descripGrp><ntig><termGrp><term id="1043951">code signing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2701438">потписивање кода</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22377_1043959_2705331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of caching the pages of a Web site on geographically dispersed servers to enable faster delivery of Web pages. When a page is requested at a URL that is content-delivery enabled, the content-delivery network routes the user's request to a cache server closer to the user. Content delivery frequently is used for high-traffic Web sites or for specific high-traffic events.</descrip></descripGrp><ntig><termGrp><term id="1043959">content delivery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2705331">кеширање садржаја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22377_1177098_2705331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of caching the pages of a Web site on geographically dispersed servers to enable faster delivery of Web pages. When a page is requested at a URL that is content-delivery enabled, the content-delivery network routes the user's request to a cache server closer to the user. Content delivery frequently is used for high-traffic Web sites or for specific high-traffic events.</descrip></descripGrp><ntig><termGrp><term id="1177098">content caching</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2705331">кеширање садржаја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22377_1177099_2705331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of caching the pages of a Web site on geographically dispersed servers to enable faster delivery of Web pages. When a page is requested at a URL that is content-delivery enabled, the content-delivery network routes the user's request to a cache server closer to the user. Content delivery frequently is used for high-traffic Web sites or for specific high-traffic events.</descrip></descripGrp><ntig><termGrp><term id="1177099">content distribution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2705331">кеширање садржаја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22388_1044098_1356313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To apply a marker to content or items (like photos or text) to identify certain types of information.</descrip></descripGrp><ntig><termGrp><term id="1044098">tag</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1356313">означити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22419_1044455_1778233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authoritative source for an attribute value that can flow its value to other destination directories and systems.</descrip></descripGrp><ntig><termGrp><term id="1044455">attribute flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1778233">проток атрибута</term><termNote type="geographicalUsa