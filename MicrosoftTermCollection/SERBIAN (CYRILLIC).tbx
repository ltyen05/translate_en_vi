ider strings (such as 2674:gstmn) as distinct from numeric values (such as 470924).</descrip></descripGrp><ntig><termGrp><term id="116861">string</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541555">ниска</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47623_2680637_2681205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ribbon tab that provides users with options to change the look of the text throughout a document.</descrip></descripGrp><ntig><termGrp><term id="2680637">Design</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2681205">Дизајн</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47624_2680638_2681206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ribbon tab that provides users with options to change the page structure.</descrip></descripGrp><ntig><termGrp><term id="2680638">Layout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2681206">Распоред</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singu