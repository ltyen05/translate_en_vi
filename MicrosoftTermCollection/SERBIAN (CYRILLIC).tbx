/termEntry><termEntry id="7703_145418_1916725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The file on your hard disk that contains offline folders. The offline folder file has an .ost extension. You can create it automatically when you set up Outlook, or when you first make a folder available offline.</descrip></descripGrp><ntig><termGrp><term id="145418">offline folder file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916725">фајл ванмрежне фасцикле</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7703_145418_2541804"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The file on your hard disk that contains offline folders. The offline folder file has an .ost extension. You can create it automatically when you set up Outlook, or when you first make a folder available offline.</descrip></descripGrp><ntig><termGrp><term id="145418">offline folder file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541804">датотека ванмрежне фасцикле</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7712_130661_1503636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of storage on a hard disk. A volume is formatted by using a file system, such as NTFS, and has a drive letter assigned to it. A single hard disk can have multiple volumes. Some volumes can span multiple hard disks.</descrip></descripGrp><ntig><termGrp><term id="130661">volume</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503636">јачина звука</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7719_175788_1503637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle (often, a tall, thin rectangle) that appears on a rebar or command band. By touching and dragging a gripper bar with a stylus or mouse, a user can reposition or resize a rebar or command band.</descrip></descripGrp><ntig><termGrp><term id="175788">gripper bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503637">gripper</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7719_770797_1503637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle (often, a tall, thin rectangle) that appears on a rebar or command band. By touching and dragging a gripper bar with a stylus or mouse, a user can reposition or resize a rebar or command band.</descrip></descripGrp><ntig><termGrp><term id="770797">gripper</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503637">gripper</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7726_373353_1523737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of following a link from one Web site to a site or page on another server when crawling for content.</descrip></descripGrp><ntig><termGrp><term id="373353">site hop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523737">међукорак до локације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7738_50933_2120211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tag that closes an element: &lt;/&gt;. An end tag follows the syntax &lt;/Name&gt;, where Name matches the element name declared in the start tag.</descrip></descripGrp><ntig><termGrp><term id="50933">end tag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2120211">крајња ознака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="774_397170_406454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compliance-focused agent that is configured to journal email messages that are sent or received by departments or individuals in an Exchange Server 2007 organization, to and from recipients outside the organization, or both for use in the organization's email retention or archival strategy.</descrip></descripGrp><ntig><termGrp><term id="397170">journaling agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406454">агент евидентирања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7744_69104_1669421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Two or more network segments connected by routers.</descrip></descripGrp><ntig><termGrp><term id="69104">internet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1669421">интернет</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7744_69105_1669421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Two or more network segments connected by routers.</descrip></descripGrp><ntig><termGrp><term id="69105">internetwork</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1669421">интернет</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></term