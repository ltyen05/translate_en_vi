langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transfer of funds from one organization's bank account directly to another organization's bank account.</descrip></descripGrp><ntig><termGrp><term id="690296">bank wire transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="765674">банковни трансфер</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17042_639513_765656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To present prominently or highlight a project, product, scenario, etc.</descrip></descripGrp><ntig><termGrp><term id="639513">showcase</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="765656">истицати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17044_639515_765655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool in a class of Partner Portal tools, which presents prominently or highlights. For example, the Solution Showcase tool is meant to highlight partner business solutions.</descrip></descripGrp><ntig><termGrp><term id="639515">showcase</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="765655">алатка за истицање</term><termNote type="geographical