="definition">A website from Microsoft which provides updates (patches and fixes) for multiple Microsoft products in one place, including Windows operating system software and Windows-based hardware, Microsoft Office system, Microsoft SQL Server, and Microsoft Exchange Server.</descrip></descripGrp><ntig><termGrp><term id="464491">Microsoft Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1692966">Microsoft Update</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40423_2347704_2349702"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request for response based on the French, Répondez s’il vous plaît.</descrip></descripGrp><ntig><termGrp><term id="2347704">RSVP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2349702">потврда доласка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40423_2347704_2837283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request for response based on the French, Répondez s’il vous plaît.</descrip></descripGrp><ntig><termGrp><term id="2347704">RSVP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2837283">RSVP</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4043_3317_2436939"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name by which a client uniquely identifies an instance of a service. It is usually built from the DNS name of the host. The SPN is used in the process of mutual authentication between the client and the server hosting a particular service.</descrip></descripGrp><ntig><termGrp><term id="3317">service principal name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2436939">главно име услуге</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4043_3318_2436939"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name by which a client uniquely identifies an instance of a service. It is usually built from the DNS name of the host. The SPN is used in the process of mutual authentication between the client and the server hosting a particular service.</descrip></descripGrp><ntig><termGrp><term id="3318">SPN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2436939">главно име услуге</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40430_2347754_2348722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service plan offer covering domestic calls as part of the PSTN Calling service in Office 365.</descrip></descripGrp><ntig><termGrp><term id="2347754">Skype for Business PSTN Domestic Calling</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2348722">Skype за посао – домаћи PSTN позиви</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40431_2347755_2348724"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service plan offer covering international calls as part of the PSTN Calling service in Office 365.</descrip></descripGrp><ntig><termGrp><term id="2347755">Skype for Business PSTN International Calling</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2348724">Skype за посао – међународни PSTN позиви</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40432_2347756_2348720"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service plan offer covering domestic and international calls as part of the PSTN Calling service in Office 365.</descrip></descripGrp><ntig><termGrp><term id="2347756">Skype for Business PSTN Domestic and International Calling</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelec