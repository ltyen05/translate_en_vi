></termGrp></ntig></langSet></termEntry><termEntry id="44660_2514598_2515708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The website that allows developers to experiment with using OAuth2 with Outlook APIs.</descrip></descripGrp><ntig><termGrp><term id="2514598">OAuth Sandbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2515708">Sandbox окружење за OAuth</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44661_2514599_2515705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The website that allows developers to edit the JSON definition of an actionable message card and immediately see the rendered result.</descrip></descripGrp><ntig><termGrp><term id="2514599">Card Playground</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2515705">Тестирање картица</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44662_2514600_2515706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The website that allows developers to edit the JSON definition of a connector card and see the rendered result.</descrip></descripGrp><ntig><termGrp><term id="2514600">Connectors Sandbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet