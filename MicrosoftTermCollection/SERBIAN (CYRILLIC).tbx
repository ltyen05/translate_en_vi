aemons.</descrip></descripGrp><ntig><termGrp><term id="2722560">app permission</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2802144">дозвола за апликацију</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47629_2722560_2806000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A permission, consented by an administrator, which is used by applications that run without a signed-in user present, such as applications that run as background services or daemons.</descrip></descripGrp><ntig><termGrp><term id="2722560">app permission</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2806000">дозвола за апликацију</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47634_2680805_2681204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An algorithm trained through machine learning to determine the class of an input.</descrip></descripGrp><ntig><termGrp><term id="2680805">classifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2681204">класификатор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><te