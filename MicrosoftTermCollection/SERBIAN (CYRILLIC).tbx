authNZ activities.</descrip></descripGrp><ntig><termGrp><term id="2267577">assigned user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2268239">додељени корисник</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38999_2267578_2268230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act when an assigned user successfully receives the access rights of a privileged role.</descrip></descripGrp><ntig><termGrp><term id="2267578">activation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2268230">активирање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="390_18288_1502775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Referring to anything that is ready for immediate use by a user or application.</descrip></descripGrp><ntig><termGrp><term id="18288">available</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502775">доступно</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39000_2267579_2268238"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication or authorization gate that the an assigned user has to complete in order to activate a role.</descrip></descripGrp><ntig><termGrp><term id="2267579">activation gate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2268238">пролаз за активирање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39001_2267580_2268246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user, who administers all of the privileged access management systems and is able to define PIM roles, and candidates.</descrip></descripGrp><ntig><termGrp><term id="2267580">security administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2268246">администратор безбедности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39002_2267582_2268245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user, who can define the assigned users for a privileged role and gates for activation.</descrip></descripGrp><ntig><termGrp><term id="2267582">role owner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2268245">власник улоге</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39003_2267586_2268236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To withdraw from the role access rights and return back to the normal state of no access rights of this role.</descrip></descripGrp><ntig><termGrp><term id="2267586">deactivate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2268236">деактивирати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39011_2321515_2322805"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Music, a highly personalized form of auto-playlist (rules-based playlist) that is created by Microsoft for the customer, drawing music from the customer's music collection, and, if the customer has an active music pass, may also include songs from our music catalog.</descrip></descripGrp><ntig><termGrp><term id="2321515">mixtape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2322805">компилација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39012_2268334_2270704"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Cellular data t