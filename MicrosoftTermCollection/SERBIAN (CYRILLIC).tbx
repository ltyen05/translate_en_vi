cripGrp><descrip type="definition">The label for the webpage where customers can access existing and create new online Office files using Office Web Apps.</descrip></descripGrp><ntig><termGrp><term id="1484610">Office</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2509149">Office</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28354_1484614_1517192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disk directory entry that takes the place of a directory entry for a file but is actually a reference to a file in a different directory.</descrip></descripGrp><ntig><termGrp><term id="1484614">symbolic link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1517192">симболичка веза</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28354_1484628_1517192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disk directory entry that takes the place of a directory entry for a file but is actually a reference to a file in a different directory.</descrip></descripGrp><ntig><termGrp><term id="1484628">symlink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1517192">симболичка веза</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28354_1484629_1517192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disk directory entry that takes the place of a directory entry for a file but is actually a reference to a file in a different directory.</descrip></descripGrp><ntig><termGrp><term id="1484629">soft link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1517192">симболичка веза</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28358_1585472_1985690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection established between on-premises and cloud email systems that not only allows users to use email from either location with the same set of credentials, but provides a richer management experience.</descrip></descripGrp><ntig><termGrp><term id="1585472">Exchange hybrid deployment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1985690">Хибридна примена размене</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28405_1484852_2727356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of services designed to help evaluate organizations' environments, develop customized Microsoft SharePoint deployment plans, and that is part of software assurance coverage.</descrip></descripGrp><ntig><termGrp><term id="1484852">SharePoint Deployment Planning Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2727356">SDPS</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28405_1484852_2727357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of services designed to help evaluate organizations' environments, develop customized Microsoft SharePoint deployment plans, and that is part of software assurance coverage.</descrip></descripGrp><ntig><termGrp><term id="1484852">SharePoint Deployment Planning Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2727357">Услуге планирања SharePoint примене</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28405_1673938_2727356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of services designed to help evaluate organizations' environments, develop customized Microsoft SharePoint deployment plans, and that is part of software assurance coverage.</descrip></descripGrp><ntig><termGrp><term id="1673938">SDPS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2727356">SDPS</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28405_1673938_2727357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of services designed to help evaluate organizations' environments, develop customized Microsoft SharePoint deployment plans, and that is part of software assurance coverage.</descrip></descripGrp><ntig><termGrp><term id="1673938">SDPS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2727357">Услуге планирања SharePoint примене</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28406_1484854_2727346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Software Assurance benefit delivered by Microsoft Certified Partner that consists of one to fifteen days of planning the deployment of Microsoft Office Software for a specific organization.</descrip></descripGrp><ntig><termGrp><term id="1484854">Microsoft Desktop Deployment Planning Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2727346">Microsoft услуге планирања примене на рачунарима</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28426_1486692_2688845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that represents a service at the Key Distribution Center (KDC). The service principal has a name and an associated key. A subclass of principal, a service principal generally does not correspond to a human user of the system, but rather to an automated service providing a resource, such as a file server.</descrip></descripGrp><ntig><termGrp><term id="1486692">service principal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2688845">принципал услуге</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28434_1487371_1791693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2011 edition of Microsoft Office that runs on the Mac operating system.</descrip></descripGrp><ntig><termGrp><term id="1487371">Microsoft Office for Mac 2011</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1791693">Microsoft Office for Mac 2011</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28434_2170107_1791693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2011 edition of Micros