langSet></termEntry><termEntry id="22992_1056887_1504737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A real-time, physical action applied to an object, in which multiple contact points are used simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1056887">multi-touch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504737">вишедодирни</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2301_314116_1502994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount that is the difference between the sum of debit entries and the sum of credit entries entered into an account during a financial period.</descrip></descripGrp><ntig><termGrp><term id="314116">account balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502994">стање рачуна</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2301_314116_2208516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount that is the difference between the sum of debit entries and the sum of credit entries entered into an account during a financial period.</descrip></descripGrp><ntig><termGrp><term id="314116">account balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><