mNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504056">тастер ESC</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11873_94938_1504057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customer's right to control how and to what extent their personal information is collected and used and with whom it is shared.</descrip></descripGrp><ntig><termGrp><term id="94938">privacy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504057">приватност</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11884_123946_1778570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical relationship established between domains to allow pass-through authentication, in which a trusting domain honors the logon authentications of a trusted domain.</descrip></descripGrp><ntig><termGrp><term id="123946">trust relationship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1778570">однос поверења</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11886_1995807_2009355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identification number that is issued by a tax authority to indicate that a company is not required to pay sales tax.</descrip></descripGrp><ntig><termGrp><term id="1995807">exempt ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2009355">ID за ослобађање од плаћања пореза</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11886_235021_2009355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identification number that is issued by a tax authority to indicate that a company is not required to pay sales tax.</descrip></descripGrp><ntig><termGrp><term id="235021">tax exempt number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2009355">ID за ослобађање од плаћања пореза</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11893_299914_1504058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An IP address of the OneNote session that is being shared with other users.</descrip></descripGrp><ntig><termGrp><term id="299914">Shared Address Information</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504058">Информација дијељене адресе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11893_299914_2527738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An IP address of the OneNote session that is being shared with other users.</descrip></descripGrp><ntig><termGrp><term id="299914">Shared Address Information</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527738">Информације о дељеној адреси</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="119_360149_1502734"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An association established between common fields (columns) in two tables. A relationship can be one-to-one, many-to-many, or one-to-many.</descrip></descripGrp><ntig><termGrp><term id="360149">relationship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502734">Веза</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11900_211444_1504059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file and folder structure that contains the necessary files and/or configuration settings that control the preinstallation process and define the manufacturers' custom information.</descrip></descripGrp><ntig><termGrp><term id="211444">configuration set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504059">конфигурациони скуп</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11900_211445_1504059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file and folder structure that contains the necessary files and/or configuration settings that control the preinstallation process and define the manufacturers' custom information.</descrip></descripGrp><ntig><termGrp><term id="211445">config set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504059">конфигурациони скуп</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11902_262727_1504060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that identifies people using computers near you so that you can use features and programs that use peer-to-peer technology.</descrip></descripGrp><ntig><termGrp><term id="262727">People Near Me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504060">Људи око мене</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11914_39698_1504061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any device that changes electrical signals or computer data from one form to another. For example, an analog-to-digital converter translates analog signals to digital signals.</descrip></descripGrp><ntig><termGrp><term id="39698">converter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504061">претварач</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11919_251777_1504062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file containing information that the user either requires or will find informative and that might not have been included in the documentation. Readme files are placed on disk in plain-text form (without extraneous or program-specific characters) so that they can be read easily be a variety of word processing programs.</descrip></descripGrp><ntig><termGrp><term id="251777">readme file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504062">фајл Прочитај ме</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11919_251777_1504063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file containing information that the user either requires or will find informative and that might not have been included in the documentation. Readme files are placed on disk in plain-text form (without extraneous or program-specific characters) so that they can be read easily be a variety of word processing programs.</descrip></descripGrp><ntig><termGrp><term id="251777">readme file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504063">Прочитај ме</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11919_251778_1504062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file containing information that the user either requires or will find informative and that might not have been included in the documentation. Readme files are placed on disk in plain-text form (without extraneous or program-specific characters) so that they can be read easily be a variety of word processing programs.</descrip></descripGrp><ntig><termGrp><term id="251778">README</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504062">фајл Прочитај ме</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11919_251778_1504063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file containing information that the user either requires or will find informative and that might not have been included in the documentation. Readme files are placed on disk in plain-text form (without extraneous or program-specific characters) so that they can be read easily be a variety of word processing programs.</descrip></descripGrp><ntig><termGrp><term id="251778">README</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504063">Прочитај ме</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11936_23875_1504064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of light that is emitted by a computer monitor or picture displayed on the monitor.</descrip></descripGrp><ntig><termGrp><term id="23875">brightness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504064">освјетљење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11936_23875_3042228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of light that is emitted by a computer monitor or picture displayed on the monitor.</descrip></descripGrp><ntig><termGrp><term id="23875">brightness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3042228">осветљеност</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11940_298006_1916889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application that is used to open an attachment for Attachment Previewing.</descrip></descripGrp><ntig><termGrp><term id="298006">Attachment Previewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916889">Прегледач прилога</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11940_298006_2542040"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application that is used to open an attachment for Attachment Previewing.</descrip></descripGrp><ntig><termGrp><term id="298006">Attachment Previewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542040">Преглед прилога</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11947_65138_1504065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an environment capable of displaying multiple on-screen windows, any window other than the one currently being used for work. An inactive window can be partially or entirely hidden behind another window, and it remains inactive until the user selects it.</descrip></descripGrp><ntig><termGrp><term id="65138">inactive window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504065">неактиван прозор</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11950_145003_2541798"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An argument that has a name that is predefined in a field. Instead of providing values for arguments in the order expected by the syntax, you can use named arguments to assign values in any order.</descrip></descripGrp><ntig><termGrp><term id="145003">named argument</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541798">именовани аргумент</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11961_180264_2776664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trust relationship between two or more SIP domains that permits users in separate organizations to communicate in real time across network boundaries.</descrip></descripGrp><ntig><termGrp><term id="180264">federation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2776664">спољни приступ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11971_145371_2527559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An OLE data format that describes a linked object, identifying the class, document name, and name of an object. Each of these data items is a null-terminated string.</descrip></descripGrp><ntig><termGrp><term id="145371">ObjectLink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527559">ObjectLink</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11975_124844_2856345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The language developed by Grady Booch, Ivar Jacobson, and Jim Rumbaugh of Rational Software that can be used for specifying, building, and documenting software and non-software systems, such as business models.</descrip></descripGrp><ntig><termGrp><term id="124844">UML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2856345">Обједињени језик за моделовање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11975_124844_2856347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The language developed by Grady Booch, Ivar Jacobson, and Jim Rumbaugh of Rational Software that can be used for specifying, building, and documenting software and non-software systems, such as business models.</descrip></descripGrp><ntig><termGrp><term id="124844">UML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2856347">UML</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11975_124845_2856345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The language developed by Grady Booch, Ivar Jacobson, and Jim Rumbaugh of Rational Software that can be used for specifying, building, and documenting software and non-software systems, such as business models.</descrip></descripGrp><ntig><termGrp><term id="124845">Unified Modeling Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2856345">Обједињени језик за моделовање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11975_124845_2856347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The language developed by Grady Booch, Ivar Jacobson, and Jim Rumbaugh of Rational Software that can be used for specifying, building, and documenting software and non-software systems, such as business models.</descrip></descripGrp><ntig><termGrp><term id="124845">Unified Modeling Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2856347">UML</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11983_381857_1916901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email folder with associated retention, archive, or expiration policies that are applied to its contents. Organizations can facilitate policy enforcement by providing such folders for users to classify email messages.</descrip></descripGrp><ntig><termGrp><term id="381857">Managed E-mail Folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916901">Управљана фасцикла е-поште</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11983_381857_2542093"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email folder with associated retention, archive, or expiration policies that are applied to its contents. Organizations can facilitate policy enforcement by providing such folders for users to classify email messages.</descrip></descripGrp><ntig><termGrp><term id="381857">Managed E-mail Folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542093">Контролисана фасцикла е-поште</term><ter