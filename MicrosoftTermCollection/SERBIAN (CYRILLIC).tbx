><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11225_477232_2527643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that helps you create or edit a formula and also provides information about functions and their arguments.</descrip></descripGrp><ntig><termGrp><term id="477232">Formula Builder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527643">Палета за формуле</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11225_477232_2527774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that helps you create or edit a formula and also provides information about functions and their arguments.</descrip></descripGrp><ntig><termGrp><term id="477232">Formula Builder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527774">Писање формула</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11229_231980_1916825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Query window that displays the tables in a query. Each table displays the fields from which you can retri