ote></termGrp></ntig></langSet></termEntry><termEntry id="50853_2874472_2875643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The function in Teams for Educators by which teachers can return students' assignments to them.</descrip></descripGrp><ntig><termGrp><term id="2874472">return</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2875643">вратити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50854_2874474_2875642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extension of Microsoft Graph to expand the types of content sources that are available in your Microsoft 365 productivity apps and the broader Microsoft ecosystem.</descrip></descripGrp><ntig><termGrp><term id="2874474">Microsoft Graph content connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2875642">Microsoft Graph повезивање садржаја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50855_2874475_2875646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint site with a personalized view of relevant knowledge across your organization on which users with permission can see topics and knowledge managers can manage topics.</descrip></descripGrp><ntig><termGrp><term id="2874475">topic center</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2875646">центар са темама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50856_2874476_2875647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An immersive page that integrates comprehensive knowledge elements for a given topic such as experts, documents, and definitions.</descrip></descripGrp><ntig><termGrp><term id="2874476">topic page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2875647">страница са темом</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50857_2874477_2875645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual dialog that supplies summary knowledge for a topic in context across multiple Microsoft 365 apps.</descrip></descripGrp><ntig><termGrp><term id="2874477">topic card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2875645">картица са темом</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50859_2875666_2876080"><langSet xml:lang="en-US"><descripGrp><descr