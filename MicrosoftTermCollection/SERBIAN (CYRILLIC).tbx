try id="56115_3156316_3158396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to search the web with two search engines simultaneously.</descrip></descripGrp><ntig><termGrp><term id="3156316">dual search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3158396">двојна претрага</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56116_3156317_3158401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users in Edge to centralize all their active media in one place and lets them manage each audio and video playback, without having to navigate any tabs.</descrip></descripGrp><ntig><termGrp><term id="3156317">media control center</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3158401">центар за управљање медијима</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56117_3156318_3158395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Edge that allows users to highlight text within a PDF that’s in one language and translate the highlighted text to the language of their choosing within the side pane.</descrip></descripGrp><ntig><termGrp><term id="3156318">PDF translator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelec