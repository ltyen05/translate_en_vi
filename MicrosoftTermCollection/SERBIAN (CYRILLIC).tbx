cripGrp><descrip type="definition">The full-screen pane in Office Universal Apps that shows a list of previous versions of the file that is currently open, and that provides the ability to preview and create a copy of an older versions or restore the current document to an older version.</descrip></descripGrp><ntig><termGrp><term id="2146201">History</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2169213">Историја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37613_2147009_2151792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dimensions of circles in a bubble chart or a bubble map.</descrip></descripGrp><ntig><termGrp><term id="2147009">bubble size</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2151792">величина мехурића</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37614_2147014_2151795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way of testing a mathematical model by entering known or closely estimated inputs for past events into the model to see how well the output matches the known results.</descrip></descripGrp><ntig><termGrp><term id="2147014">hindcast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xm