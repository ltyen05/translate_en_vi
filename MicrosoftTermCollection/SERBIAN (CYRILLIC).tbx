"><descripGrp><descrip type="definition">A feature within Recall that highlights and analyzes text and images on screen and allows users to click and perform actions.</descrip></descripGrp><ntig><termGrp><term id="3187626">Click to Do</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3188359">Радња кликом</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56361_3170784_3171829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An organizational unit that represents the company group or division that is primarily responsible for winning the sale and managing the delivery of work and services to the customer.</descrip></descripGrp><ntig><termGrp><term id="3170784">contracting unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3171829">јединица за уговарање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56379_3170802_3171830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limit set on a specific cost, time, or resource that should not be surpassed during the execution or billing of a project.</descrip></descripGrp><ntig><termGrp><term id="3170802">not-to-exceed</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3171830">које не сме да се прекорачи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56389_3170812_3171831"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that stores the relation between two similar business transactions such as cost and related sales actuals or transaction reversals triggered by billing activities such as invoice confirmation or invoice corrections.</descrip></descripGrp><ntig><termGrp><term id="3170812">transaction connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3171831">веза између трансакција</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56391_3170950_3175855"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software-based trusted execution environment inside the address space of a host application. More technically, it is a Dynamic Link Library (DLL) loaded by a standard Windows application that secures secrets and sensitive operations in memory.</descrip></descripGrp><ntig><termGrp><term id="3170950">virtualization-based security enclave</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3175855">безбедносна енклава заснована на виртуелизацији</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote typ