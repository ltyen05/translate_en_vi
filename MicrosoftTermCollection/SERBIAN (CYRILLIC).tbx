et><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2020876">ниво батерије</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2405_236972_2021140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of battery power left on the system.</descrip></descripGrp><ntig><termGrp><term id="236972">battery charge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2021140">ниво батерије</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24051_1097914_2028262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To return to a stable condition after some error has occurred. A program recovers from an error by stabilizing itself and resuming execution of instructions without user intervention.</descrip></descripGrp><ntig><termGrp><term id="1097914">recover</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2028262">опоравити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24057_1098418_1917117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of statistics that indicates the degree to which a service meets performance, usage, and other demands for the service.</descrip></descripGrp><ntig><termGrp><term id="1098418">service quality metrics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1917117">мјерење квалитетa услуге</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24057_1098418_2542261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of statistics that indicates the degree to which a service meets performance, usage, and other demands for the service.</descrip></descripGrp><ntig><termGrp><term id="1098418">service quality metrics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542261">метрички подаци о квалитету услуга</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24059_1098419_2542262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules that defines security permissions for a collection of assemblies by associating attributes of those assemblies, such as location and signature, with a set of code access security permissions.</descrip></descripGrp><ntig><termGrp><term id="1098419">code access security (CAS) policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542262">CAS смернице</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24059_1098419_2542354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules that defines security permissions for a collection of assemblies by associating attributes of those assemblies, such as location and signature, with a set of code access security permissions.</descrip></descripGrp><ntig><termGrp><term id="1098419">code access security (CAS) policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542354">смернице за безбедност путем шифрованог приступа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24059_1098420_2542262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules that defines security permissions for a collection of assemblies by associating attributes of those assemblies, such as location and signature, with a set of code access security permissions.</descrip></descripGrp><ntig><termGrp><term id="1098420">CAS policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2542262">CAS смернице</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="