 automatically plays videos as the user scrolls.</descrip></descripGrp><ntig><termGrp><term id="2817590">Glance view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2821473">приказ „Брзи преглед“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49840_2817597_2821471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Flipgrid view that automatically plays videos as the user scrolls.</descrip></descripGrp><ntig><termGrp><term id="2817597">Glance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2821471">Брзи преглед</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49840_2817597_2821473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Flipgrid view that automatically plays videos as the user scrolls.</descrip></descripGrp><ntig><termGrp><term id="2817597">Glance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2821473">приказ „Брзи преглед“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49841_2817599_2821474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Flipgrid, a dedicated space shared by a teacher and his or her students, where teachers can pose questions, called "topics," and the students can post video responses that appear in a tiled grid display.</descrip></descripGrp><ntig><termGrp><term id="2817599">Grid</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2821474">Мрежа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49842_2817594_2821502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Flipgrid, one of a set of pre-defined visuals, symbols, including emojis, that users can select to indicate their reaction to a video, topic, or other input.</descrip></descripGrp><ntig><termGrp><term id="2817594">Reaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2821502">реакција</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49843_2817608_2821514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short message that an educator can add to a student's video to showcase the video.</descrip></descripGrp><ntig><termGrp><term id="2817608">Vibe</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2821514">Утисак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49844_2817623_2821464"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifier, part of the Flipgrid URL, that provides direct access to a Flipgrid resource (topic, video, etc.). For example: flipgrid.com/FLIPCODE</descrip></descripGrp><ntig><termGrp><term id="2817623">Flip Code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2821464">флип-код</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49846_2818592_2835069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location where administrators manage organization-level settings and integrations for Power Apps, Microsoft Power Automate, and Dynamics 365 apps.</descrip></descripGrp><ntig><termGrp><term id="2818592">Power Platform admin center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2835069">Power Platform центар администрације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49850_2819348_2824361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that allows users to configure a filter list to use metadata tree view hierarchies and set filter controls to improve navigation and filtering of the list items.</descrip></descripGrp><ntig><termGrp><term id="2819348">metadata navigation filtering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824361">навигација помоћу метаподатака и филтрирања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49850_2819348_2824362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that allows users to configure a filter list to use metadata tree view hierarchies and set filter controls to improve navigation and filtering of the list items.</descrip></descripGrp><ntig><termGrp><term id="2819348">metadata navigation filtering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824362">филтрирање на основу навигације помоћу метаподатака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49850_2819349_2824361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that allows users to configure a filter list to use metadata tree view hierarchies and set filter controls to improve navigation and filtering of the list items.</descrip></descripGrp><ntig><termGrp><term id="2819349">metadata navigation and filtering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824361">навигација помоћу метаподатака и филтрирања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49850_2819349_2824362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that allows users to configure a filter list to use metadata tree view hierarchies and set filter controls to improve navigation and filtering of the list items.</descrip></descripGrp><ntig><termGrp><term id="2819349">metadata navigation and filtering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824362">филтрирање на основу навигације помоћу метаподатака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49851_2819360_2824360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that enables users to dynamically filter and find content in lists and libraries by using a navigation hierarchy tree control to apply different metadata-based filters to the view.</descrip></descripGrp><ntig><termGrp><term id="2819360">metadata navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2824360">навигација помоћу метаподатака</term><termNote t