ion">The Office add-in that helps users learn how to use JavaScript APIs by allowing them to create and edit JavaScript, HTML, and CSS within Word, Excel, and PowerPoint, giving them references to libraries and data on the web, and allowing them to run the code and see the result in a task pane within the Office application.</descrip></descripGrp><ntig><termGrp><term id="2619828">Script Lab</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2623954">Script Lab</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46562_2619851_2623416"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Microsoft 365 services that features that deal with content analysis and enhancements.</descrip></descripGrp><ntig><termGrp><term id="2619851">Office Transformation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2623416">Office Transformation Service</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46567_2620199_2651047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Periodic updates performed to improve the reliability, performance, and security of an asset.</descrip></descripGrp><ntig><termGrp><term id="2620199">planned maintenance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="gram