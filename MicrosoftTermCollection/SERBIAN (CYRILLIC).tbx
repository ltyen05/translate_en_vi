type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141985">ценовна карта</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34214_1987595_2141925"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of dividing the day into several parts, during each of which a different type of radio programming or television programming appropriate for that time is aired.</descrip></descripGrp><ntig><termGrp><term id="1987595">daypart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141925">део дана</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34215_1987596_2141914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advertising or media item that  you create, such as a brochure, business card, letter, ad, webpage, poster, TV commercial, radio spot, poster, tent cards promotional item, point of purchase display, or shelf talker.</descrip></descripGrp><ntig><termGrp><term id="1987596">component</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141914">компонента</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34216_1987597_2141971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of components.</descrip></descripGrp><ntig><termGrp><term id="1987597">pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2141971">пакет</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34217_1987598_2142027"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of marketing testing by which a baseline control sample is compared to a variety of single-variable test samples to improve response rates.</descrip></descripGrp><ntig><termGrp><term id="1987598">split testing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2142027">сплит тестирање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34218_1987599_2141967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A plug-in that enables users to quickly insert an HTML tag into the body of an email message that, when clicked, adds the email address of the email recipient to the specified list.</descrip></descripGrp><ntig><termGrp><term id="1987599">One-click Subscribe</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></