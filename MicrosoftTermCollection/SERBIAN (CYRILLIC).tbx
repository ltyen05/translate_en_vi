_2315655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of going to different places on the Internet, on a particular Web site, in a database, etc. in order to find what you want.</descrip></descripGrp><ntig><termGrp><term id="2312652">navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2315655">навигација</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39856_2312654_2318316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to sort and display email based on predefined criteria.</descrip></descripGrp><ntig><termGrp><term id="2312654">Quick Filter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2318316">Брзи филтер</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39856_2312654_2358491"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to sort and display email based on predefined criteria.</descrip></descripGrp><ntig><termGrp><term id="2312654">Quick Filter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2358491">Брзи филтери за листу порука</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39856_2357846_2318316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to sort and display email based on predefined criteria.</descrip></descripGrp><ntig><termGrp><term id="2357846">Quick Filters for message list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2318316">Брзи филтер</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39856_2357846_2358491"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to sort and display email based on predefined criteria.</descrip></descripGrp><ntig><termGrp><term id="2357846">Quick Filters for message list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2358491">Брзи филтери за листу порука</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39857_2312655_2315642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that intelligently presorts email across all email accounts.</descrip></descripGrp><ntig><termGrp><term id="2312655">Focused Inbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2315642">Фокусирано пријемно сандуче</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39858_2312656_2315646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu selection that allows users to move emails from the focused inbox into the Other category.</descrip></descripGrp><ntig><termGrp><term id="2312656">Move to Non-Focused Inbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2315646">Премести у нефокусирано пријемно сандуче</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39858_2312656_2339702"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu selection that allows users to move emails from the focused inbox into the Other category.</descrip></descripGrp><ntig><termGrp><term id="2312656">Move to Non-Focused Inbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2339702">Премјести у нефокусирано пријемно сандуче</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39860_2314540_2862289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mechanism for message authentication that uses cryptographic hash functions.</descrip></descripGrp><ntig><termGrp><term id="2314540">HMAC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2862289">кôд за потврду веродостојности порука помоћу хеша</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39860_2838779_2862289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mechanism for message authentication that uses cryptographic hash functions.</descrip></descripGrp><ntig><termGrp><term id="2838779">Hash-based Message Authentication Code</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2862289">кôд за потврду веродостојности порука помоћу хеша</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39864_2322624_2325951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The wireless personal area network technology, launched in 2010 and marketed as Bluetooth Smart, used for transmitting data over distances as much as 100 meters. Cost and power consumption are low while maintaining a communication range similar to Bluetooth BR/EDR, the other widely-used version of Bluetooth</descrip></descripGrp><ntig><termGrp><term id="2322624">Bluetooth Smart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2325951">Bluetooth Smart</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39866_2315181_2318301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Bluetooth Low Energy device that sends static information, such as location or ID, to devices within its area.</descrip></descripGrp><ntig><termGrp><term id="2315181">beacon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2318301">одашиљач</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3987_141789_1916691"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A placeholder text that included the field character, field type, and instructions, and that that shows where specified information from a data source will appear such that the elements in a field that generate a field's result.</descrip></descripGrp><ntig><termGrp><term id="141789">field code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916691">кôд поља</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3987_141789_2541777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A placeholder text that included the field character, field type, and instructions, and that that shows where specified information from a data source will appear such that the elements in a field that generate a field's result.</descrip></descripGrp><ntig><termGrp><term id="141789">field code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541777">код поља</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39872_2315208_2644955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scoping container for a set of messaging entities.</descrip></descripGrp><ntig><termGrp><term id="2315208">namespace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2644955">простор за имена у услузи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39872_2465861_2644955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scoping container for a set of messaging entities.</descrip></descripGrp><ntig><termGrp><term id="2465861">service namespace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2644955">простор за имена у услузи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39875_2315585_2316205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that reports performance of transactions, informing about which interpreted stored procedures in the database will benefit from porting to use native compilation. After identifying theses procedures, this tool can be used to help migrate the interpreted stored procedure to native compilation. To find out more about natively compiled stored procedures, see: https://msdn.microsoft.com/en-gb/library/dn133184.aspx</descrip></descripGrp><ntig><termGrp><term id="2315585">Native Compilation Advisor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2316205">саветник за основно компајлирање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39877_2315966_2318326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature for maps of the interior of some public places, such as the businesses inside a mall, or the gates, businesses, and other services inside an airport.</descrip></descripGrp><ntig><termGrp><term id="2315966">venue map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2318326">мапа простора</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39878_2316274_2318315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of apps or services made available in an enterprise to help with particular business and process needs.</descrip></descripGrp><ntig><termGrp><term id="2316274">line-of-business</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2318315">област пословања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39878_2316274_2318317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of apps or services made available in an enterprise to help with particular business and process needs.</descrip></descripGrp><ntig><termGrp><term id="2316274">line-of-business</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2318317">ОП</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39878_2316275_2318315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of apps or services made available in an enterprise to help with particular business and process needs.</descrip></descripGrp><ntig><termGrp><term id="2316275">LOB</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2318315">област пословања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39878_2316275_2318317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of apps or services made available in an enterprise to help with particular business and process needs.</descrip></descripGrp><ntig><termGrp><term id="2316275">LOB</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2318317">ОП</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39880_2320100_2322802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for PC and Surface Hub that helps you connect a phone or PC to the Surface Hub display, or to another PC. On Surface Hub, it also allows you to switch between devices that are connected to the Surface Hub.​</descrip></descripGrp><ntig><termGrp><term id="2320100">Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2322802">Повезивање</te