efinition">An email message that contains a spam report for individual users who don't have access to quarantine or the junk email folder.</descrip></descripGrp><ntig><termGrp><term id="1791366">End-User Spam Notification</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1971748">Обавештење о безвредној пошти за крајње кориснике</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33519_1791367_1971735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Policies that are detailed enough to be applied to distribution groups, security groups, and individual users.</descrip></descripGrp><ntig><termGrp><term id="1791367">user-based policies</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1971735">корисничке смернице</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33520_1791368_2388595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of transport rules and classification logic that applies specific filtering based on specific regulatory requirements, for example, HIPAA (Health Insurance Portability and Accountability Act).</descrip></descripGrp><ntig><termGrp><term id="1791368">DLP policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:la