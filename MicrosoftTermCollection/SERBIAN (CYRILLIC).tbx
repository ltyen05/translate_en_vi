а графике</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42018_2376774_2380388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to apply visual transformations to a graphic, such as reflections, shadows, and glows.</descrip></descripGrp><ntig><termGrp><term id="2376774">Graphics Effects</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2380388">Ефекти графике</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42019_2376775_2380391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that applies an effect to the exterior border around each path of a user’s graphic.</descrip></descripGrp><ntig><termGrp><term id="2376775">Graphics Outline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2380391">Контура графике</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42020_2376839_2380364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 feature that allows users to connect online apps, tools, and services to their Groups so that all