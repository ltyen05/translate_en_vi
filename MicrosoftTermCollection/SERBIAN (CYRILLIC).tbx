rformed as part of developing the organizational strategy.</descrip></descripGrp><ntig><termGrp><term id="226546">strengths, weaknesses, opportunities, and threats analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2142032">SWOT анализа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13772_52156_1504229"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a type of access to data in a database that is shared over a network. When you open a database in exclusive mode, you prevent others from opening the database.</descrip></descripGrp><ntig><termGrp><term id="52156">exclusive</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504229">искључиво</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13776_5615_1504230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A supplemental program that can extend the capabilities of an application program.</descrip></descripGrp><ntig><termGrp><term id="5615">add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504230">додатак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNot