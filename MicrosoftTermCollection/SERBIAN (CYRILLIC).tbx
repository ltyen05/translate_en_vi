ype="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39074_2269904_2604232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that resides in persistent storage on physical media, in any digital format. This includes files on magnetic or optical media, archived data, and data backups.</descrip></descripGrp><ntig><termGrp><term id="2269904">data at rest</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2604232">подаци у мировању</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39077_2270185_2270813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The preview of Power BI Desktop, the dedicated report authoring tool for the Power BI service.</descrip></descripGrp><ntig><termGrp><term id="2270185">Power BI Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2270813">Power BI дизајнер</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39078_2270188_2351077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client agent that enables Power BI to connect to on-premises SQL Server Analysis Services instan