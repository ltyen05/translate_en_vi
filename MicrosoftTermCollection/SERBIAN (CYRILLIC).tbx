termNote></termGrp></ntig></langSet></termEntry><termEntry id="29116_1506651_1523566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of properties that provides information about the results of crawling a display URL. The information includes whether the crawl was successful, the content source to which the display URL belongs, and the level, message, time, and identifier for any errors that occur.</descrip></descripGrp><ntig><termGrp><term id="1506651">crawl log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523566">евиденција пописивања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29117_1506655_1523567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure that stores the list of items to crawl next.</descrip></descripGrp><ntig><termGrp><term id="1506655">crawl queue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523567">редослед пописивања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29118_1506657_1523568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state of a crawl operation.</descrip></descripGrp><ntig><termGrp><term id="1506657">crawl status</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></l