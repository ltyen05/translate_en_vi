ermGrp><term id="1503406">оцјена</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56078_3152915_3153343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The fourth day of the Islamic holiday that marks the end of Ramadan.</descrip></descripGrp><ntig><termGrp><term id="3152915">Eid al Fitr (4th Day)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3153343">Рамазански бајрам (4. дан)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56079_3152916_3153342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The fifth day  of the Islamic holiday that marks the end of Ramadan.</descrip></descripGrp><ntig><termGrp><term id="3152916">Eid al Fitr (5th Day)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3153342">Рамазански бајрам (5. дан)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56080_3152917_3153338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The second day of the two-day holiday that commemorates the formation of the United Arab Emirates.</descrip></descripGrp><ntig><termGrp><term id="3152917">National Day (2nd Day)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3153338">Дан државности (2. дан)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56081_3153497_3153536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within Dynamics 365 Supply Chain Management designed for companies engaged in international trade of goods. It helps them monitor and adhere to both internal policies and external regulations. The solution lets them express these rules, even complex ones, by using formulas that are similar to the formulas in Microsoft Excel. It guarantees that these rules are consistently followed during the entire sales and fulfillment procedure.</descrip></descripGrp><ntig><termGrp><term id="3153497">Export Control</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3153536">Контрола извоза</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56082_3153688_3153895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Microsoft Teams used in workplace and education contexts.</descrip></descripGrp><ntig><termGrp><term id="3153688">Microsoft Teams (work or school)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3153895">Microsoft Teams (посао или школа)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56082_3153688_3153896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Microsoft Teams used in workplace and education contexts.</descrip></descripGrp><ntig><termGrp><term id="3153688">Microsoft Teams (work or school)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3153896">Teams (посао или школа)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56082_3153689_3153895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Microsoft Teams used in workplace and education contexts.</descrip></descripGrp><ntig><termGrp><term id="3153689">Teams (work or school)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3153895">Microsoft Teams (посао или школа)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56082_3153689_3153896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Microsoft Teams used in workplace and education contexts.</descrip></descripGrp><ntig><termGrp><term id="3153689">Teams (work or school)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3153896">Teams (посао или школа)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56084_3153773_3154834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A prioritization technique used to communicate the importance and priority of various project requirements. The acronym is derived from the first letter of each of four prioritization categories: Must have, Should have, Could have, and Won’t have.</descrip></descripGrp><ntig><termGrp><term id="3153773">MoSCoW</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3154834">MoSCoW</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56085_3153841_3155842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft service offering that provides hands-on advisory services to help large enterprises embrace modern security capabilities and build security resilience.</descrip></descripGrp><ntig><termGrp><term id="3153841">Microsoft Security Enterprise Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><la