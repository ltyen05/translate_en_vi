ners.</descrip></descripGrp><ntig><termGrp><term id="1380158">transport protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2802730">протокол преноса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2755_550_1503042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chunk of data that a Web server sends to a browser, which in turn saves it and sends it back when accessing the Web server again.</descrip></descripGrp><ntig><termGrp><term id="550">cookie</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503042">колачић</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27555_1381690_1516932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A website or service that a customer can connect to in order to share what they've been doing on other websites, see their friends and their updates from other services in Windows Live, or share their Windows Live activity on other websites.</descrip></descripGrp><ntig><termGrp><term id="1381690">service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1516932">услуга</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termN