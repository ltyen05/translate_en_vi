ared content is shown as a background to the video of the presenter.</descrip></descripGrp><ntig><termGrp><term id="2926584">Standout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2926865">Истакнуто</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51986_2926585_2926862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The preview version of the Learning app in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="2926585">Learning (Preview)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2926862">Учење (преглед)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51986_2926585_2928069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The preview version of the Learning app in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="2926585">Learning (Preview)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2928069">Учење (верзија за преглед)</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></l