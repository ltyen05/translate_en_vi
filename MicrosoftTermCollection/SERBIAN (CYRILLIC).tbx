er">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56085_3153845_3155843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft service offering that provides hands-on advisory services to help large enterprises embrace modern security capabilities and build security resilience.</descrip></descripGrp><ntig><termGrp><term id="3153845">Enterprise Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3155843">Услуге за велика предузећа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56086_3153851_3154315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Copilot in the Edge browser that enables the user, when writing in the browser, to use generative AI to reword their written text.</descrip></descripGrp><ntig><termGrp><term id="3153851">inline compose</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3154315">састављање у линији</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56087_3153852_3154314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows IT Admins to enable their organization's branding assets from Entra onto profile-related UI for profiles signed in with an Entra ID account.</descrip></descripGrp><ntig><termGrp><term id="3153852">organization branding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3154314">брендирање организације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56088_3153853_3154313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that, based on a prompt entered by the user, creates custom images formatted as an Edge theme.</descrip></descripGrp><ntig><termGrp><term id="3153853">custom theme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3154313">прилагођена тема</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56089_3153855_3154317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user, when writing in the browser, to use generative AI to reword their written text.</descrip></descripGrp><ntig><termGrp><term id="3153855">rewrite</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3154317">парафразирање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56091_3153897_3154316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An input surface where users enter their requests for Copilot in natural language. It is the user’s interaction point with the system.</descrip></descripGrp><ntig><termGrp><term id="3153897">prompt bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3154316">трака за одзив</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56091_3153897_3154733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An input surface where users enter their requests for Copilot in natural language. It is the user’s interaction point with the system.</descrip></descripGrp><ntig><termGrp><term id="3153897">prompt bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3154733">трака за упит</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56092_3153898_3155846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides real-time exploration of a machine's operational information, spanning from hardware specifications, such as memory usage, to software configuration, including installed applications, registry keys, and networking settings.</descrip></descripGrp><ntig><termGrp><term id="3153898">device query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3155846">упит о уређају</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56093_3153899_3155845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows organizations to selectively scan and protect historical older data using the latest enhanced advanced classifiers, to comprehensively identify and protect their sensitive corporate intellectual property and PII.</descrip></descripGrp><ntig><termGrp><term id="3153899">data scan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3155845">скенирање датотека</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56094_3153900_3155844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables a customer’s Entra ID admin to approve access to identity data in their tenant.</descrip></descripGrp><ntig><termGrp><term id="3153900">customer lockbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3155844">lockbox клијента</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termE