th Microsoft.</descrip></descripGrp><ntig><termGrp><term id="310997">Windows Activation Client</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504140">програм за Windows активирање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12695_253689_1796373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-byte, fixed-point data type that is useful for calculations involving money or for fixed-point calculations in which accuracy is extremely important. The Currency data type is used to store numbers with up to 15 digits to the left of the decimal point and 4 digits to the right. The type-declaration character in Microsoft© Visual Basic© is an at sign (@). Currency can range from -922,337,203,685,477.5808 to 922,337,203,685,477.5807.</descrip></descripGrp><ntig><termGrp><term id="253689">Currency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1796373">Валута</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12695_374694_1796373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-byte, fixed-point data type that is useful for calculations involving money or for fixed-point calculations in which accuracy is extremely important. The Currency data type is used to store numbers with up to 15 digits to the left of the decimal point and 4 digits to the right. The type-declaration character in Microsoft© Visual Basic© is an at sign (@). Currency can range from -922,337,203,685,477.5808 to 922,337,203,685,477.5807.</descrip></descripGrp><ntig><termGrp><term id="374694">money</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1796373">Валута</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12708_179577_1504141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common drop-down menu that includes commands for file operations, such as Open, Save, and Print.</descrip></descripGrp><ntig><termGrp><term id="179577">File menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504141">мени Фајл</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12708_179577_2541928"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common drop-down menu that includes commands for file operations, such as Open, Save, and Print.</descrip></descripGrp><ntig><termGrp><term id="179577">File menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541928">мени „Датотека“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1271_397184_406466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information contained in an email message that is required to send and deliver a message between messaging servers by using SMTP protocol commands. The message envelope contains the sender email address and the recipient email address information. Recipients never see the message envelope, because it is not part of the message content, and it is discarded when the message reaches its destination. The X.400 messaging standard equivalent to the message envelope is called the "P1 header." The message envelope is often referred to as the "P1 header."</descrip></descripGrp><ntig><termGrp><term id="397184">message envelope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406466">P1 заглавље</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1271_397184_406467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information contained in an email message that is required to send and deliver a message between messaging servers by using SMTP protocol commands. The message envelope contains the sender email address and the recipient email address information. Recipients never see the message envelope, because it is not part of the message content, and it is discarded when the message reaches its destination. The X.400 messaging standard equivalent to the message envelope is called the "P1 header." The message envelope is often referred to as the "P1 header."</descrip></descripGrp><ntig><termGrp><term id="397184">message envelope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406467">кошуљица поруке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1271_397195_406466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information contained in an email message that is required to send and deliver a message between messaging servers by using SMTP protocol commands. The message envelope contains the sender email address and the recipient email address information. Recipients never see the message envelope, because it is not part of the message content, and it is discarded when the message reaches its destination. The X.400 messaging standard equivalent to the message envelope is called the "P1 header." The message envelope is often referred to as the "P1 header."</descrip></descripGrp><ntig><termGrp><term id="397195">P1 header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406466">P1 заглавље</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1271_397195_406467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information contained in an email message that is required to send and deliver a message between messaging servers by using SMTP protocol commands. The message envelope contains the sender email address and the recipient email address information. Recipients never see the message envelope, because it is not part of the message content, and it is discarded when the message reaches its destination. The X.400 messaging standard equivalent to the message envelope is called the "P1 header." The message envelope is often referred to as the "P1 header."</descrip></descripGrp><ntig><termGrp><term id="397195">P1 header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406467">кошуљица поруке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12711_2464298_2468698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scaled-down version of a product where a user can try out different features before buying it.</descrip></descripGrp><ntig><termGrp><term id="2464298">test drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2468698">верзија за пробу</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12716_2328432_2620309"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The type of enterprise in which businesses or organizations are engaged.</descrip></descripGrp><ntig><termGrp><term id="2328432">line of business</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2620309">област пословања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12724_32944_1778284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time to which a clock is set.</descrip></descripGrp><ntig><termGrp><term id="32944">clock setting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1778284">подешавање сата</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12728_237800_1788763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A point on the project schedule at which the project team assesses progress and quality, and reviews deviations in scope and specifications. A project may have many interim milestones for internal use only, which signal a transition within a phase and help divide large projects into workable pieces. External milestones or major milestones typically occur at the end of major phases of work and are associated with the completion of major deliverables. External milestones are the points where the team and customer review work to date and agree to proceed with the project, appear as a task with a duration of zero work units, and are exposed on customer reports.</descrip></descripGrp><ntig><termGrp><term id="237800">milestone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1788763">контролна тачка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12730_53477_1725506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form sent with a fax that provides information about the sender, e.g. the name, address, telephone number, and fax number.</descrip></descripGrp><ntig><termGrp><term id="53477">fax cover page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1725506">насловна страница факса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12730_53477_1916959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form sent with a fax that provides information about the sender, e.g. the name, address, telephone number, and fax number.</descrip></descripGrp><ntig><termGrp><term id="53477">fax cover page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916959">насловна страница</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12730_641197_1725506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form sent with a fax that provides information about the sender, e.g. the name, address, telephone number, and fax number.</descrip></descripGrp><ntig><termGrp><term id="641197">cover page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1725506">насловна страница факса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12730_641197_1916959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form sent with a fax that provides information about the sender, e.g. the name, address, telephone number, and fax number.</descrip></descripGrp><ntig><termGrp><term id="641197">cover page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916959">насловна страница</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12753_133562_1916642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 16-bit vector graphics format for Windows-compatible computers used mostly as a clip art format in word-processing documents.</descrip></descripGrp><ntig><termGrp><term id="133562">Windows Metafile Format</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916642">Windows метафајл формат</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGen