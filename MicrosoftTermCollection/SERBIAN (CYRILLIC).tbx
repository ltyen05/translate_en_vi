 type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44174_2482811_2500161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A planned event such as a trade show, seminar, or webinar.</descrip></descripGrp><ntig><termGrp><term id="2482811">marketing event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2500161">маркетиншки догађај</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44175_2482812_2500167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application infrastructure for Dynamics 365 apps that provides a consistent user experience across a variety of form factors - PCs, phones, and tablets.</descrip></descripGrp><ntig><termGrp><term id="2482812">Unified Interface</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2500167">обједињени интерфејс</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44176_2482813_2500157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of organizing a marketing event or the tools used to assist in this process.</descrip></descripGrp><ntig><termGrp><term id="2482813">event management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2500157">управљање догађајима</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44177_2482814_2500160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email message that contains promotional information, typically sent to many recipients at once. Contrasts with transactional email which describes a person-to-person message related to a business transaction. Marketing email typically includes opt-out features such as an unsubscribe link.</descrip></descripGrp><ntig><termGrp><term id="2482814">marketing email</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2500160">маркетиншка е-порука</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44178_2482815_2500159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of logical rules for adjusting the score of a lead being nurtured by a marketing campaign.</descrip></descripGrp><ntig><termGrp><term id="2482815">lead scoring model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2500159">модел за оцењивање потенцијалног клијента</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44179_2482820_2500164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display window that shows users a variety of relevant data-driven insights and news from their contacts' interactions on social media.</descrip></descripGrp><ntig><termGrp><term id="2482820">social pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2500164">окно за друштвене активности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44180_2482821_2500165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field where you enter information about a marketing campaign used to attract or generate a lead.</descrip></descripGrp><ntig><termGrp><term id="2482821">Source Campaign</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2500165">изворна кампања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4419_315149_1503248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value or condition that is not consistent with the true, specified, or expected value or condition.</descrip></descripGrp><ntig><termGrp><term id="315149">error</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503248">грешка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44190_2482906_2484918"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to put their contacts into groups in order to allocate time between those groups.</descrip></descripGrp><ntig><termGrp><term id="2482906">My important groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2484918">Моје важне групе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44192_2483085_2768184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer technology that identifies where human faces are present in a digital image or a video frame, without identifying any specific faces. This technology can be used to identify images or an area of one image that is relatively important because it contains a face (e.g. this might be used to auto-select the area to crop for a profile photo.)</descrip></descripGrp><ntig><termGrp><term id="2483085">face detection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2768184">откривање људи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44192_2766791_2768184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer technology that identifies where human faces are present in a digital image or a video frame, without identifying any specific faces. This technology can be used to identify images or an area of one image that is relatively important because it contains a face (e.g. this might be used to auto-select the area to crop for a profile photo.)</descrip></descripGrp><ntig><termGrp><term id="2766791">people detection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2768184">откривање људи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44194_2483156_2485870"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A socket allowing computer memory (RAM) to be inserted into the computer.</descrip></descripGrp><ntig><termGrp><term id="2483156">memory slot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2485870">меморијски слот</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44196_2483498_2570513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extension to the Windows Insider Program to include engagement for enter