_2716449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a software feature or programming object that is outdated and should not be used. A deprecated item is currently supported for backward compatibility, but it might become obsolete and unsupported in the future.</descrip></descripGrp><ntig><termGrp><term id="718937">deprecated</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2716449">застарео</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20202_719546_2765978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To stop displaying an application’s active window on screen while leaving the application running.</descrip></descripGrp><ntig><termGrp><term id="719546">hide</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2765978">сакрити</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20204_719701_2527889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique element of data within a field.</descrip></descripGrp><ntig><termGrp><term id="719701">item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527889">ставка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20222_719746_1977745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The window that displays solutions, projects, and files, as well as access to the commands that pertain to them.</descrip></descripGrp><ntig><termGrp><term id="719746">Solution Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1977745">Прегледач рјешења</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20222_719746_1978072"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The window that displays solutions, projects, and files, as well as access to the commands that pertain to them.</descrip></descripGrp><ntig><termGrp><term id="719746">Solution Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1978072">Истраживач решења</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2023_136809_2541723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A link that specifies a full path to a resource, such that the destination of the link doesn’t change based on where it is linking from.</de